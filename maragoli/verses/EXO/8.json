        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.25",
            "verseOrgIds": [
              "EXO.8.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa yavoola, “Sivunyala kuva vulahi kokora yaga mba, kigira vandu va Egebeti valavihilirizwa, ni visiuviliru vietu vie zinyama ku Yahova Nyasaye wiitu. Niiva kulatumikira zinyama yizi kuhaana visiuviliru nukuvihiliriza vandu va Egebeti, valakulasa na magina kukuzi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.26",
            "verseOrgIds": [
              "EXO.8.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gakuduukiraa kuzia ologendo lwa madiku gavaga mwigendanyama kuhaana visiuviliru ku Yahova Nyasaye wiitu, kuli yakulaga.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.27",
            "verseOrgIds": [
              "EXO.8.27"
            ]
          }
        }
      ]
    },
