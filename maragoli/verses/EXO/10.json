          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yahova yadinyia mwoyo gwu Mwami, na siyaavaleka vazie mba. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.27",
            "verseOrgIds": [
              "EXO.10.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yavolera Musa, “Tula imbiri wange! Utangola ndore ivi kandi mba! Lidiku liandikolola, ulakakuzi!”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.28",
            "verseOrgIds": [
              "EXO.10.28"
            ]
          }
        }
      ]
