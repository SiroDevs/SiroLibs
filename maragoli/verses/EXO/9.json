          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwu Mwami yalora agaali nigekoleki, yaazizagilira kokora uvwoni. Oyo harara na vatumikiri veve vadinyia mioyo jaavo kuli kazozo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.34",
            "verseOrgIds": [
              "EXO.9.34"
            ]
          }
