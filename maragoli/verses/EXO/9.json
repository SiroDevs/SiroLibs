          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Navuzwa uvuswage ningano siviononywa mba, kigira viali nivikikiri kokomera.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.32",
