          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikatani ni ishairi viadivizwa, kigira ishairi yaali niyumi; ni katani yaali nisivukaa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.31",
            "verseOrgIds": [
              "EXO.9.31"
