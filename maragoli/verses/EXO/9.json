              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi kuli Yahova yaali navooye maziambiri kuvitira ku Musa, Mwami siyaleka vandu va Isiraeli vazie mba.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.35",
