              "type": "text"
            }
          ]
        },
        {
          "text": "Zikilo ziatigala 30 zie feza Bezeleli yalomba zinzizi, vigumiliru vie zitiru kandi vikuniku viu kwigulu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.28",
            "verseOrgIds": [
