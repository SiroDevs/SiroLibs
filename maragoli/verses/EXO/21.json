        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.16",
            "verseOrgIds": [
              "EXO.21.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mundu woosi ulaama baba weve anoho mama weve kuduuka yiitwi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.17",
            "verseOrgIds": [
              "EXO.21.17"
            ]
          }
        }
