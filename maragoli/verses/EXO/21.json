          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mundu woosi uvugura mundu wundi kuzinguru kulwu kumuguliza anoho kumukola mutugwa weve, kuduuka yiitwi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.16",
            "verseOrgIds": [
              "EXO.21.16"
            ]
          }
        }
      ]
    },
