        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.14",
            "verseOrgIds": [
              "EXO.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mundu woosi uduyaa baba weve anoho mama weve kuduuka yiitwi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.15",
            "verseOrgIds": [
              "EXO.21.15"
            ]
          }
        }
