        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.15",
            "verseOrgIds": [
              "EXO.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
