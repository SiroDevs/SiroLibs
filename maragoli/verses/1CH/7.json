              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Heberi yaali na vayaayi vavaga: Jafuleti, Shomeri na Hozamu; nu mukaana mulala, Shua.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.32",
