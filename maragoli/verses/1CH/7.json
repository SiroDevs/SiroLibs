      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.24",
            "verseOrgIds": [
              "1CH.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Efuraimu yaali kandi nu muyaayi walangwa Refa, uwi kisukururwi chiche chaali kuli ndi: Reshefu, Tela, Tahani, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.25",
            "verseOrgIds": [
              "1CH.7.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ladani, Amihudi, Elishama, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.26",
            "verseOrgIds": [
              "1CH.7.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 7:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuni, na yivula Joshua.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.27",
            "verseOrgIds": [
              "1CH.7.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
