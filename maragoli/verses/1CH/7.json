          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shemida yaali na vayaayi vane: Ahiani, Shekemu, Liki na Aniamu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.19",
            "verseOrgIds": [
