          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Beza, Hodi, Shama, Shilisha, Izurami, na Beera.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.37",
            "verseOrgIds": [
