              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yivi nivio visukululwi via Asheri. Yaali na vayaayi vane: Imuna, Ishiva, Ishivi, na Beria; nu mukaana mulala, Sera.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.30",
