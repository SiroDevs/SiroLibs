          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Beria yaali na vayaayi vaviri, Heberi na Malikieli. (Malikieli yaali mutangizi wi lidaala linene lia Birizaizi)",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.31",
