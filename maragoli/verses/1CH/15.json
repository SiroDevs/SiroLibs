{
  "id": "1CH.15",
  "number": "15",
  "bookId": "1CH",
  "reference": "1 Zing'Inga 15",
  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "15",
