        "style": "s1"
      },
      "items": [
        {
          "text": "Vutima vwa Yahova ku Nineve",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NAM 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaga na makuva kigira Nineve, amalola gu muporofeti Nahumu kutura Elikoshi.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.1",
            "verseOrgIds": [
              "NAM.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NAM 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.10",
            "verseOrgIds": [
              "NAM.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NAM 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutura mu vandu va Nineve, yaza mundu mulala oveeye ni lilohiza liu vuchamu, alohizaa mu vwivisu kokora vudamanu ku Yahova. ",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.11",
            "verseOrgIds": [
              "NAM.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NAM 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaga nigo ga Yahova avoora ku vandu va Isiraeli. “Kali niiva vandu va Siria vaveeye ni zinguru kandi avanyingi ligali, valakadivizwi kandi valakagote. Avandu vange, ndaamulomba ni musaliraa, navuzwa sindakola ndio kandi mba. ",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.12",
            "verseOrgIds": [
              "NAM.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NAM 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kalunu ndaheriza zinguru zia vandu va Siria ku munyi, kandi ndatuliza ku munyi vuliduhu vwavo.”",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.13",
            "verseOrgIds": [
              "NAM.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NAM 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.13",
            "verseOrgIds": [
              "NAM.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NAM 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaga nigo ga Yahova amali kulaga kolondekana na vandu va Asiria. Sivalakave ni visukululwe vilizizagiliza lieta liavo mba. Ndakadivizi vifananyi viveeye mu matemberi ga vanyasaye vaavo. Nombaa kilindwa cha vandu va Siria; sivadukanaa komenya mba!",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.14",
            "verseOrgIds": [
              "NAM.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NAM 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.14",
            "verseOrgIds": [
              "NAM.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NAM 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Henza, mutumwa yaazaa kutura ku kiguru; aveeye na makuva malahi! Yaazaa kulandiza mirembe! Mulombe amasavo munyi avandu vi Ivuyuda, kunangwa muduuki ku twekiza lilagana lienyu na Nyasaye. Avandu vachamu sivalaza kwingilira kivala chiinyu kandi mba. Vosi vamali kudivizwa ligali!",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.15",
            "verseOrgIds": [
              "NAM.1.15"
            ]
          }
        }
      ]
    }
