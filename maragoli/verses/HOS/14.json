            "sid": "HOS 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yavo avaveeye novogeri gavadukiraa vamanyirizi vindu yivi, kandi vaviviki mu zing'anagani ziavo. Kigira zinzira zia Yahova ziveeye zinungi. Avandu vaveeye avoni valikigitara kandi valagwa. Avandu vaveeye avalungi valangenda kuzio.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.9",
            "verseOrgIds": [
              "HOS.14.9"
            ]
          }
        }
      ]
