          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vosi sivaveeye ni kihanwa chu kohonyia avalwaye, anoho cho komoloma mu zinimi zing'eni, kandi sivagirung'anyia zinimi vosi mba. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.30",
            "verseOrgIds": [
              "1CO.12.30"
            ]
          }
        },
        {
          "name": "verse",
