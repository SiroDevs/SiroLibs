              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vosi sivaveeye avatumwa, anoho avaporofeti, anoho avigizi, anoho avikihaanwa cho kokora vilolekizu mba. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.29",
            "verseOrgIds": [
              "1CO.12.29"
            ]
          }
        },
        {
