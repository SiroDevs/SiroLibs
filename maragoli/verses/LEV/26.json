              "LEV.26.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 26:27"
          },
          "items": [
            {
              "text": "27",
