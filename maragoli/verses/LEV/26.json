        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.45",
            "verseOrgIds": [
              "LEV.26.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LEV 26:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaga goosi gaveeye amalago gi miima ja Yahova yaaha Musa ku Kiguru cha Sinai kigira avandu va Isiraeli.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.46",
            "verseOrgIds": [
              "LEV.26.46"
            ]
          }
        }
      ]
