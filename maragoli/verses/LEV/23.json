              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.32",
            "verseOrgIds": [
              "LEV.23.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 23:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yahova yavolera Musa, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.33",
            "verseOrgIds": [
              "LEV.23.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 23:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "avolere avandu va Isiraeli, “Ku liduku lie likomi na gatano liu mweli gwa saba, lisavo liange lia madiri lilatanga ma lizizagiliri ku madiku saba. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.34",
            "verseOrgIds": [
              "LEV.23.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LEV 23:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lidiku liukutanga lia madiku yaga liveeye lie livugana ilitakatifu. Mutakola miyinzi ja vuli lidiku mba. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.35",
            "verseOrgIds": [
              "LEV.23.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LEV 23:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vuli lidiku, ku madiku saba mulaleeta kihanwa chukusambwa ku Inzi Yahova. Kulidiku lia munane muve nilivugana ilitakatifu, liveeye lidiku liukusigamira Inzi Yahova kandi simulakola muyinzi gwosi mba.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.36",
            "verseOrgIds": [
              "LEV.23.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LEV 23:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.36",
            "verseOrgIds": [
              "LEV.23.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LEV 23:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Yaga nigo masavo gi diini gamukuminyira Inzi Yahova mu livugana kandi koleta vihaanwa vie viukulia, vihaanwa viukusambwa, vihaanwa viu vuswage ivisiuviliru, kandi vihaanwa vie iwaini kuli genyekaa vuli lidiku. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.37",
            "verseOrgIds": [
              "LEV.23.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LEV 23:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amasavo yaga gaveeye gokomeeda ku masabato ga kazozo, kandi vihaanwa yivi viveeye viokomedaa ku vihaanwa via kazozo, vihaanwa vienyu viamuleetaa mulitwekiza liesuuha, kandi vihaanwa vienyu via muhaanaa nu mwoyo gwu vuyanzi ku Inzi Yahova.)",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.38",
            "verseOrgIds": [
              "LEV.23.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LEV 23:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.38",
            "verseOrgIds": [
              "LEV.23.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LEV 23:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwa muva m'mwakagesa milimi jenyu, mulava ni lisavo liange ku madiku saba, kutangira ku lidiku lie likomi na gatano liu mweli gwa saba. Lidiku liukutanga lilava lidiku ilitakatifu liokososa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.39",
            "verseOrgIds": [
              "LEV.23.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LEV 23:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku lidiku liukutanga, mulavugula malala ku makuyu malahi ligali kutura ku misaala jinyu; mulavuguli matu ga makindu, zisia zie misaala ja matu manyingi, ma mutange lisavo lie diini kuhaana luyali ku Inzi Yahova Nyasaye winyu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.40",
            "verseOrgIds": [
              "LEV.23.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LEV 23:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulava ni lisavo yili ku Inzi Yahova kulwa madiku saba, vuli muhiga. Mulagumira lilaga yili mu zing'inga ziosi ziza ku visukululwi vienyu. Mulava ni lilia yili mu mweli gwa saba. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.41",
            "verseOrgIds": [
              "LEV.23.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LEV 23:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avandu va Isiraeli valamenya mu madiri kulwa madiku saba, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.42",
            "verseOrgIds": [
              "LEV.23.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LEV 23:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "kunangwa visukululwi vienyu vaduuki kumanya ndi Inzi Yahova, ndaakola vandu va Isiraeli vamenye mu madiri lwa ndavaleta kutura Egebeti. Inzi mbeeye Yahova Nyasaye winyu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.43",
            "verseOrgIds": [
              "LEV.23.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LEV 23:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunangwa munzira yiyi, Musa yahaana ku avandu va Isiraeli malago gu kulinda masavo gidiini kuhaana luyali ku Yahova.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.44",
            "verseOrgIds": [
              "LEV.23.44"
            ]
          }
        }
      ]
    }
