          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.21",
            "verseOrgIds": [
              "LEV.23.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 23:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Lwa mugesa milimi jinyu, mutagesa vuswage voveeye ku zinzako zie milimi mba kandi mutilani kogesa vinywa viamavere vitigaye munyima mba.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.22",
            "verseOrgIds": [
              "LEV.23.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 23:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mulekere vadaka navageni. Yahova aveeye Nyasaye winyu.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.22",
            "verseOrgIds": [
              "LEV.23.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lisavo liu muhiga muhia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
