      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lisavo lia Madiri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 23:32"
          },
          "items": [
