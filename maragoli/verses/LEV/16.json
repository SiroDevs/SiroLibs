          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malago yaga galakolwa lulala vuli muhiga kutakasa avandu va Isiraeli kutura muvwoni vwavo vwosi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.34",
