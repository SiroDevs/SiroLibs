            "sid": "LEV 4:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alatuliza itinya yayo yoosi, kuli itinya yi vihaanwa vie mirembe. Alagisambira ku uvwali kunangwa lifunya mwayu gwayo guduuki kuyaanziza Yahova. Nandio, Musaalisi alahaana kisiuviriru kigira uvwoni vwu mundu uyu, kandi alasaamifwa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.31",
            "verseOrgIds": [
              "LEV.4.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
