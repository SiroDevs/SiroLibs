          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maku Petero yamuhira halovega, natanga kumugondokera, “Gatava ndio mba, Mwami! Nyasaye ataleka vindu yivi vikugwiri mba!”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.22",
            "verseOrgIds": [
              "MAT.16.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
