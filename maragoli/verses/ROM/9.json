{
  "id": "ROM.9",
  "number": "9",
  "bookId": "ROM",
  "reference": "Varumi 9",
  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "ROM 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ROM 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inzi mboraa agiligali; simbehaa mba. Kigira mbeeye wa Kristo, zing'anagani ziange niziamiifwa na Roho Mutakatifu, kandi zisuuviriza ndi simbehaa mba. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.1",
            "verseOrgIds": [
              "ROM.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ROM 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwa mboraa kuli vovereri vwange voveeye vonene, kandi kuli mbeeye nu vusaliri vutaveeye ne kegero mu mwoyo gwange kigira avandu vange, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.2",
            "verseOrgIds": [
              "ROM.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ROM 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndakayanzi Nyasaye yanaame kandi yanzavukanye kutura ku Kristo kigira avamwavo vange kandi aviiko vange. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.3",
            "verseOrgIds": [
              "ROM.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vaveeye avandu va Nyasaye; yatovola vave avana veve; naavavuulira uvukumi vwivwe. Yalomba lilagana lilie navo, kandi navaha Lilaga lilie; vaveeye ni lisigamira Nyasaye liageligali. Vanyoola lisuuvirizwa lia Nyasaye; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.4",
            "verseOrgIds": [
              "ROM.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "vaveeye visukululwi via vaguuga Vaheburaina vamanyikana na Kristo kuli mundu aveeye wi ihiiri yaavo. Nyasaye wamihaa ku vandu vosi, yizominywi mihiga ni mihiga! Amini.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.5",
            "verseOrgIds": [
              "ROM.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.5",
            "verseOrgIds": [
              "ROM.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simbolaa ndi lisuuvirizwa lia Nyasaye liavula kuduukizwa mba; kigira sivaveeye vandu va Isiraeli vosi avaveeye avandu vatovole va Nyasaye mba. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.6",
            "verseOrgIds": [
              "ROM.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anoho si viveeye visukululwi via Aburahamu viosi iviveeye vana vi ligali va Nyasaye mba. Nyasaye yavolera Aburahamu. “Kuvitira mu Isaka, ivi ulava ni visukululwi va ndaakusuuviriza.” ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.7",
            "verseOrgIds": [
              "ROM.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ROM 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agaveeye kovora ndi, sivaveeye yavo viivulwa ku lugano lwu muviri vaveeye vana va Nyasaye, navuzwa yavo viivulwa kolondekana ku lisuuvirizwa lia Nyasaye nivo vavalizwa kuli visukululwi vivie viagiligali. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.8",
            "verseOrgIds": [
              "ROM.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ROM 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lisuuvirizwa lia Nyasaye liali ndi: “Ndirana ku ivi ing'inga idukanaa, na Sara alanyoola umwana muyaayi.”",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.9",
            "verseOrgIds": [
              "ROM.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ROM 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.9",
            "verseOrgIds": [
              "ROM.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Si gaali yaga geng'ine, kigira avana va Rabeka vaviri vaali na baba mulala naye ni Isaka, guuga wiitu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.10",
            "verseOrgIds": [
              "ROM.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ROM 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kali niiva vaali nivakikiri kwivulwa kandi nivakikiri kokora vulahi anoho vudamanu vwulugano Iwosi, na kuduuka ovotovoli vwa Nyasaye vuzizagiliri, sigaveeye kigira imiyinzi ja makono gu mundu, navuzwa kigira ililangwa lilie. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.11",
            "verseOrgIds": [
              "ROM.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rabeka yavolerwa ndi, “Umunene alatumikira umukekeke.” ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.12",
            "verseOrgIds": [
              "ROM.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuli Mang'oda Matakatifu gavoora, “Inzi ndayaanza Yakobo, navuzwa ndaduunyira Esau.”",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.13",
            "verseOrgIds": [
              "ROM.9.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.13",
            "verseOrgIds": [
              "ROM.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunangwa kovoole ki? Nyasaye siaveeye nuvulungi? Sigaveeye ndio mba! ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.14",
            "verseOrgIds": [
              "ROM.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kigira yavolera Musa,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.15",
            "verseOrgIds": [
              "ROM.9.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Vutima kandi zimbavasi zia Nyasaye",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ROM 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.18",
            "verseOrgIds": [
              "ROM.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ROM 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulala ku munyi alandeeva, “Niiva gaveeye ndio, kigira ki Nyasaye yenyeleriza amahiolo mu vandu? Nivwaha unyala kuhingila uvulaliri vwa Nyasaye?” ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.19",
            "verseOrgIds": [
              "ROM.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ROM 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Navuzwa ligali ivi oveeye vwaha uluviliraa kwilanyira Nyasaye amativuli? Inyingu sinyala koteeva umulongi wayo, “Kigira ki wanomba kuli ndi?” ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.20",
            "verseOrgIds": [
              "ROM.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ROM 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kali ndio mundu olongaa zinyingu aveeye nu vulungi kutumikira lidohi kuli ayaanza, no kolonga zinyingu ziviri ku lidohi lilala liere; ndala ku litumika liu luyali, niyindi ku litumika lia kase.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.21",
            "verseOrgIds": [
              "ROM.9.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ROM 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.21",
            "verseOrgIds": [
              "ROM.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ROM 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malala meere gaveeye giligali ku aga Nyasaye akoli. Yenya kumanyia uvutima vwivwe, kandi kolomba zinguru zizie kumanyikana. Navuzwa yikuzira ligali kuyavo avaveeye viju viu vutima vwivwe, avaadukana kudivizwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.22",
            "verseOrgIds": [
              "ROM.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ROM 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yenya kandi kuvuula vukumi vwivwe vunyingi vwaviikwa ku kunyi avakoveeye viju viu vukumi vwivwe, yavo avavetegekiza vanyoore vukumi vwivwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.23",
            "verseOrgIds": [
              "ROM.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ROM 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunyi koveeye vandu vayalanga, sigaveeye kutura hagati ha Vayuda venyine, navuzwa kandi kutura mu vandu vi zihiiri. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.24",
            "verseOrgIds": [
              "ROM.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ROM 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaga nigo agaavoola mu kitabu cha Hosea:",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.25",
            "verseOrgIds": [
              "ROM.9.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lisaala lia Paolo ku Isiraeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ROM 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.29",
            "verseOrgIds": [
              "ROM.9.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ROM 9:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunangwa kovoole ki? Vandu vi zihiiri avaavura kwenyeleriza uvulungi vwa Nyasaye, vumali konyooleka kuvitira mu lisuuvira; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.30",
            "verseOrgIds": [
              "ROM.9.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ROM 9:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "lwa vandu va Nyasaye venyeleriza Lilaga liukuvakola vave vulungi na Nyasaye, sivalinyoola mba. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.31",
            "verseOrgIds": [
              "ROM.9.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ROM 9:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kigira ki? Kigira sivalonda lisuuvira mba, navuzwa valonda vikolwa viavo. Nandio vamali kwikigatira ku “Ligina liu kwikigitariza” ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.32",
            "verseOrgIds": [
              "ROM.9.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ROM 9:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "ilia Mang'oda Matakatifu gamolomaa kulio;",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.33",
            "verseOrgIds": [
              "ROM.9.33"
            ]
          }
        }
      ]
    }
  ],
