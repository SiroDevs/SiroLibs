          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwoyo gwumundu gwikuziraa kuvulwaye, navuzwa nivwaha unyala kwikuzira ku vudinyu vwumwoyo gumali kuvunika?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.14",
            "verseOrgIds": [
              "PRO.18.14"
            ]
          }
        }
      ]
    },
    {
