              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu alamenya kolondekana na makuyu kutura ku makuva goosi gavoora; aligutizwa na makuva geege.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.20",
