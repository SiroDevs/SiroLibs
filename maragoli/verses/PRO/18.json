          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kihanwa chu mundu kimwiguliraa viliango vinyingi kandi kimwimiliraa kuduuka imbiri wavandu avanene.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.16",
            "verseOrgIds": [
              "PRO.18.16"
            ]
