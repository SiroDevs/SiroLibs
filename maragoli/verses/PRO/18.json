          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uhulirizi kutanga, nukikiri kuhaana mativuli, na nutakoli ndio oveeye musiru kandi muzalirizi",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.13",
            "verseOrgIds": [
              "PRO.18.13"
            ]
          }
        }
