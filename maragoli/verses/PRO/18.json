          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu wukutanga komoloma mu kiyaalo alolekaa kovora agiligali kazozo, kuduuka lwumusigu weve atangaa kumuteeva mateeva.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.17",
            "verseOrgIds": [
              "PRO.18.17"
            ]
          }
