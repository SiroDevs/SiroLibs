          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avandu vatugi vaganagana ndi, vutugi vwavo vuvakingaa kuli lidigi litambi lie zinguru liakumberiza lidaala.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.11",
            "verseOrgIds": [
              "PRO.18.11"
            ]
          }
        }
