          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avulaho mundu unyala konyoora luyali, nategehizi, avandu vikirage vaveeye kunzira yu kudivizwa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.12",
            "verseOrgIds": [
              "PRO.18.12"
            ]
          }
        }
      ]
