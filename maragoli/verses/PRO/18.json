          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PRO 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niiva vandu vaviri vizingulu vahing'ana mu kiyaalo, likuba zikuura lilavukanya vosoolo vwavo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.18",
            "verseOrgIds": [
              "PRO.18.18"
            ]
          }
        }
