              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yahova adunyiraa vandu vaveeye ni zing'anagani zindamanu, navuzwa ayaanza yavo avakola malungi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.20",
