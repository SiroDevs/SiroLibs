              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avandu vachamu sivanyoola kindu mba navuzwa nokora agaveeye amalungi, ulanyora madanyi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.11.18",
            "verseOrgIds": [
