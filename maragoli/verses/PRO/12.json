        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.13",
            "verseOrgIds": [
              "PRO.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amadanyi googo galondekanaa na makuva googo govoora na gokolaa; ulanyora gaduukanaa niive.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.14",
            "verseOrgIds": [
              "PRO.12.14"
            ]
          }
        }
      ]
