              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu musiru okolaa kindu chu vusiru lwa kaviri, aveeye kuli imbwa yirana kulia maluki gayo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.11",
            "verseOrgIds": [
              "PRO.26.11"
            ]
