          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niiva ulahuliriza miigizu ma ove ni lienya kwiga, lidiku lilala ulava mugeri.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.20",
            "verseOrgIds": [
