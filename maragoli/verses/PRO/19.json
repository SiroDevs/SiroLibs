              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu mwigingiri gamuduukira ahevwe mageri, kunangwa vandu vatamanyi kindu choosi kuduuka vigi. Niiva oveeye mugeri uliga lwa wigizwa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.25",
