              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avandu vanyara kulohiza vindu viosi viavanyala, navuzwa lienya lia Yahova lizizaa kwekoleka.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.21",
