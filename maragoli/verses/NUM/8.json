        "style": "s1"
      },
      "items": [
        {
          "text": "Lilohiza lie Zitaya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
