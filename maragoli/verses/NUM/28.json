              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi kiloguramu ndala harara na vuli kememe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.29",
            "verseOrgIds": [
              "NUM.28.29"
