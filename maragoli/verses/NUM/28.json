            "sid": "NUM 28:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yahova yalaga Musa ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.1",
            "verseOrgIds": [
              "NUM.28.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 28:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuvolera vandu va Isiraeli koletera Nyasaye vihaanwa vie viukulia viu kumuyanziza ku ing'inga idukanaa kandi yatovolwa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.2",
            "verseOrgIds": [
              "NUM.28.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 28:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.2",
            "verseOrgIds": [
              "NUM.28.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 28:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yivi ni vihaanwa vie viukulia vienyeka viletelwe Yahova: Ku vihaanwa viu kusambwa vuli lidiku: vimeme vimigu viviri viu muhiga mulala vitaveeye ni mbala. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.3",
            "verseOrgIds": [
              "NUM.28.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vahane kememe chu kutanga mugambazuri na chakaviri hamugorova, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.4",
            "verseOrgIds": [
              "NUM.28.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 28:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "vuli kilala harara ne kihanwa chu vusie vwu vuswage kiloguramu indala vuzuganyiywimu na maguta malahi muzeituni lita ndala. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.5",
            "verseOrgIds": [
              "NUM.28.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 28:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kihanwa yiki cha vuli lidiku, chenyekaa kusambwa choosi, chatanga kuhaanwa ha kiguru cha Sinai kuli kihanwa chi viukulia viu mwayu mulahi gwu kuyaanziza Yahova. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.6",
            "verseOrgIds": [
              "NUM.28.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuli kihanwa chiwaini harara ne kememe kimigu chu kutanga, usunduli ku vwali ilita indala yiwaini. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.7",
            "verseOrgIds": [
              "NUM.28.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vahane kihanwa cha kaviri hamugorova kuli ukoli kihanwa cha mugambazuri harara ni kihanwa chiwaini. Yiki kandi ni kihanwa chi viukulia, kiveeye nu mwayu mulahi gwu kuyaanziza Yahova.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.8",
            "verseOrgIds": [
              "NUM.28.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kihanwa chi Lidiku lie Lisabato",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.8",
            "verseOrgIds": [
              "NUM.28.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 28:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku Lidiku lie Lisabato vahane vimeme vimigu 2 viu muhiga mulala vitaveeye ni mbala, vusie zikiloguramu ziviri vuzuganyiywimu na maguta ga muzeituni kuli kihanwa chu vuswage, kandi kihanwa chiwaini. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.9",
            "verseOrgIds": [
              "NUM.28.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kihanwa yiki chukusambwa chenyeka kuhaanwa vuli lidiku lie Lisabato komeeda ku kihanwa cha vuli lidiku harara ni kihanwa chiwaini.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.10",
            "verseOrgIds": [
              "NUM.28.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kihanwa che Lidiku Liukutanga ku Mweli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.10",
            "verseOrgIds": [
              "NUM.28.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 28:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Valeete ku Yahova kihanwa chu kusambwa vuli lidiku liu kutanga ku vuli mweli: Vimoli vigiriki viviri, limigu lilala, vimeme vimigu saba vio muhiga mulala, viosi vitaveeye nimbara ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.11",
            "verseOrgIds": [
              "NUM.28.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 28:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuli kihanwa chu vuswage vahane vusie vuzuganyiywi na maguta ga muzeituni: harara na vuli igiriki, zikiloguramu zivaga zio vusie; harara ni limigu, nizikiloguramu ziviri ziu vusie vunyuki vuzuganyiywi mu na maguta ga muzeituni, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.12",
            "verseOrgIds": [
              "NUM.28.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 28:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi harara ne kememe kimigu, vahane ikiloguramu indala yu vusie. Vihaanwa yivi viu kusambwa ni vihaanwa vie viukulia viu mwayu mulahi ligali gwu kuyaanziza Yahova. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.13",
            "verseOrgIds": [
              "NUM.28.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 28:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kihanwa chiwaini kidukanaa ni zilita ziviri ziewaini harara na vuli igiriki harara na vuli limigu vahane ilita ndala ninusu kandi vahane ilita indala harara na vuli kememe kimigu. Yaga ni malago gi kihanwa chu kusambwa ku lidiku liukutanga vuli mweli ku muhiga gwosi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.14",
            "verseOrgIds": [
              "NUM.28.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 28:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Komeeda ku kihanwa cha vuli lidiku, chu kusambwa harara ni kihanwa chiwaini, vahane kememe chimbuli kuli kihanwa chu vwoni.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.15",
            "verseOrgIds": [
              "NUM.28.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kihanwa ku lidiku liu kulia Mugadi Gutaveeyemu na Mamera",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 28:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.15",
            "verseOrgIds": [
              "NUM.28.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 28:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lidiku lia 14 ku mweli gwu kutanga, lilava lidiku lie lisavo lie Lipasaka liu kuhaana luyali ku Yahova. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.16",
            "verseOrgIds": [
              "NUM.28.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 28:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lidiku lia kumi na tano liu mweli gwene yigwo, lilava lidiku liu kutanga lisavo, na lilamala madiku saba. Mumadiku yaga, mulalia mugadi gutaveeye na mamera. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.17",
            "verseOrgIds": [
              "NUM.28.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 28:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku lidiku liu kutanga lisavo, muvugaane kusigamira Yahova, na vatakola miyinzi mba. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.18",
            "verseOrgIds": [
              "NUM.28.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 28:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muhaane kihanwa chu kusambwa kuli kihanwa che chukulia ku Yahova: Vimoli vigiriki viviri, limigu lilala, ne vimeme vimigu saba vio muhiga mulala, viosi vitaveeye ni mbala. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.19",
            "verseOrgIds": [
              "NUM.28.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 28:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muhaane kihanwa cheligali chu vuswage, uvusie vuzuganyiywi na maguta ga muzeituni: zikiloguramu zivaga harara na vuli igiriki, zikiloguramu ziviri harara na vuli limigu ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.20",
            "verseOrgIds": [
              "NUM.28.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 28:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi ikiloguramu indala na vuli kememe, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.21",
            "verseOrgIds": [
              "NUM.28.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 28:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi muhaane imburi ekole indala kuli kihanwa chu vwoni. Munzira yiyi, vakole mwima gwu kwitakasa kigira vandu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.22",
            "verseOrgIds": [
              "NUM.28.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 28:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muhaane vihaanwa yivi komeeda ku vihaanwa vio kusambwa via vuli mugamba. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.23",
            "verseOrgIds": [
              "NUM.28.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 28:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munzira ndala nzere, ku madiku saba, mulahaana ku Yahova kihanwa che viukulia kifunyaa mwayu gwu kumuyanziza. Vahane kihanwa yiki komeeda ku kihanwa chiu kusambwa cha vuli lidiku harara ni kihanwa chiwaini. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.24",
            "verseOrgIds": [
              "NUM.28.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 28:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muvugaane kusigamira Yahova ku lidiku lia saba na mutakola muyinzi mba.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.25",
            "verseOrgIds": [
              "NUM.28.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Vihaanwa vie Lisavo lio Kogesa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 28:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.25",
            "verseOrgIds": [
              "NUM.28.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 28:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku lidiku liukutanga lie lisavo lio kogesa, lwa muleete kihanwa chu vuswage vuhia ku Yahova, muvugaane harara kusigamira Yahova na mutakola miyinzi mba. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.26",
            "verseOrgIds": [
              "NUM.28.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 28:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muhaane kihanwa chu kusambwa kifunyaa mwayu mulahi ku Yahova: Vimoli vigiriki viviri, limigu lilala kandi vimeme saba viu muhiga mulala, viosi vitaveeye ni mbala. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.27",
            "verseOrgIds": [
              "NUM.28.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
