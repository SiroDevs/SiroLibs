              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi muhaane imburi ekole indala kuli kihanwa chu vwoni. Munzira yiyi mukore mwima gwu kwitakasa kigira vandu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.30",
            "verseOrgIds": [
              "NUM.28.30"
            ]
          }
        },
        {
