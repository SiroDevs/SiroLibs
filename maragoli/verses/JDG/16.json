            "verseOrgIds": [
              "JDG.16.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JDG 16:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avamwavo veve na vandu vinyumba ya baba weve vasulunguta ni vazia kuvugura umuviri gwigwe. Vamuleeta nivamuyavira hagati ha Zora na Eshitaoli mu kilindwa cha Manoa baba weve. Yamiha Isiraeli ku mihiga sirini.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.31",
            "verseOrgIds": [
              "JDG.16.31"
            ]
          }
        }
      ]
