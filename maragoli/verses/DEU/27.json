          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kandi avandu vosi valavoora, ‘Amini!’",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.15",
            "verseOrgIds": [
              "DEU.27.15"
            ]
          }
        }
