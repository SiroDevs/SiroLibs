          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘Alaamwe mundu olomba kifananyi chavazwa anoho kutulwa, ikindu keveeye chu kuvihiliriza ku Yahova, miyinzi ja makono gu musiza, na akisingirizi muvwivisu, akisigamiri’",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.15",
            "verseOrgIds": [
              "DEU.27.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
