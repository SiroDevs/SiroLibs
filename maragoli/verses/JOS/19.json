          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.50",
            "verseOrgIds": [
              "JOS.19.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "JOS 19:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musaalisi Elieza, Joshua muyaayi wa Nuni, na aviimiliri va vandu vi zihiiri zia Isiraeli vagavulana vidonye vie kivala yiki ku likuba ikura koteeva Yahova ha Shilo, ha vwingiliru vwi Lihema liukuvuganira mu na Yahova. Munzira yiyi, vamala ligavula kivala.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.51",
            "verseOrgIds": [
              "JOS.19.51"
            ]
