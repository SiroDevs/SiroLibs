            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikura ya saba yagwira vandu vi ihiiri ya Dani. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.40",
            "verseOrgIds": [
              "JOS.19.40"
            ]
          }
