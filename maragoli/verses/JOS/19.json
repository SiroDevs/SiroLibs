          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwa aviimiliri va vandu vi hiiri ya Isiraeli vamala ligavula kivala, vaaha Joshua muyaayi wa Nuni kedonye chi kivala kuli chiche. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.49",
            "verseOrgIds": [
              "JOS.19.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "JOS 19:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuli Yahova yaali nalagi, vamuha lidaala linene lia yateeva ahevwe: Timunazi Sera, mu kivala chivigulu cha Efuraimu. Yumbaka vuhia lidaala linene zana kandi namenya mu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.50",
            "verseOrgIds": [
              "JOS.19.50"
            ]
          }
        }
      ]
