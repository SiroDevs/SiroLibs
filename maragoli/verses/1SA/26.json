          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saolo yavolera Daudi, “Nyasaye akugasizi, mwana wange! Ivi ulanyora na ulava muguuti mu vindu viosi via okola!”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.25",
            "verseOrgIds": [
              "1SA.26.25"
