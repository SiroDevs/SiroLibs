          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samweli yavolera vandu yavo, “Uyu niyie musaza wa Yahova atovooye! Sihaveeye ho nu wundi hagati hiitu oveeye kuli uyu mba.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.10.24",
            "verseOrgIds": [
              "1SA.10.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1SA 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avandu vosi vahaanzuka nu mwoyo munene nivavoora, “Mwami ahindiri!”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.10.24",
            "verseOrgIds": [
              "1SA.10.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1SA 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.10.24",
            "verseOrgIds": [
              "1SA.10.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1SA 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samweli yiivalira avandu vosi agadukanaa vakolere mwami kandi miyinzi ju mwami adukanaa avakolere; ma kandi naagang'oda mu kitabu, icha yavika mu havundu hatakatifu. Maku Samweli yaasindukiza vandu, sa mulala kuzia yengo weve. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.10.25",
            "verseOrgIds": [
              "1SA.10.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1SA 10:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saolo yirana yengo weve mu lidaala lia Gibea. Avasaza valala vizingulu, ava Nyasaye yaali nadiiyi mioyo jaavo, vazia naye. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.10.26",
            "verseOrgIds": [
              "1SA.10.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1SA 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Navuzwa vandu valala avikivihiri vavoola, “Mundu uyu anyala kokokolera malahi ki?” Vachaaya Saolo kandi si vamuleetera ku kihanwa choosi mba. Navuzwa Saolo yakiring'ana.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.10.27",
            "verseOrgIds": [
              "1SA.10.27"
            ]
          }
        }
      ]
