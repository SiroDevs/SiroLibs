          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunangwa vumbakira Abisolomu lihema kwigulu kwinyumba yu vwami, kandi imbiri wa avandu vosi, Abisolomu yingira mu kandi naagona na vakali vaviika vababa weve.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.22",
            "verseOrgIds": [
