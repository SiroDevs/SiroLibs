          },
          "items": [
            {
              "text": "72",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uvwihaani vwa avandu vandi vosi vwali zikilo 168 zie zahabu, zikilo 140 zie ifeza kandi zinguvu zia vasaalisi 67.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.72",
