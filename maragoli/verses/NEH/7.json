          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yava nivo aviviliango via Avasaali aviranaa kutura mu lihaminywa.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.38",
            "verseOrgIds": [
              "NEH.7.38"
            ]
          }
