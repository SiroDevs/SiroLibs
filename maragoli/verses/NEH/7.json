          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "Visukululwi va vatumikiri va Solomoni aviranaa kutura mu lihaminywa:",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.56",
            "verseOrgIds": [
