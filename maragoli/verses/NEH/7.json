          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Viliango via vandu va Levi aviranaa kutura mu lihaminywa.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.42",
            "verseOrgIds": [
              "NEH.7.42"
