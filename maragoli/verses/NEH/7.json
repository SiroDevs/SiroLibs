          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aviviliango via avatumikiri vu mu Litembeli aviranaa kutura mu lihaminywa.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.45",
            "verseOrgIds": [
              "NEH.7.45"
            ]
          }
        }
