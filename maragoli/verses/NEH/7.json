          },
          "items": [
            {
              "text": "61",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yava nivo avaatura mu madaala Telimela, Telia Harisha, Kerubu, Adoni na Imeri, navuzwa sivali vanyara kumanyia ndi avizinyumba vaavo vaali visukululwi va Isiraeli mba: ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.61",
            "verseOrgIds": [
              "NEH.7.61"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "62",
            "style": "v",
            "sid": "NEH 7:62"
          },
          "items": [
            {
              "text": "62",
              "type": "text"
            }
          ]
        },
        {
          "text": "Visukululwi va Delaya, Tobia na Nekoda vaali 642.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.62",
            "verseOrgIds": [
              "NEH.7.62"
            ]
          }
        }
      ]
    },
    {
