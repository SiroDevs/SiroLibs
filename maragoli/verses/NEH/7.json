          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jeshua na Kadimieli, visukululwi va Hodavia 74.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.43",
            "verseOrgIds": [
              "NEH.7.43"
            ]
