          },
          "items": [
            {
              "text": "67",
              "type": "text"
            }
          ]
        },
        {
          "text": "komeeda ku vatumikiri vasaza na vatumikiri vakali 7,337; kandi vaali na aviimbi kandi 245, avasaza navakari. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.67",
            "verseOrgIds": [
              "NEH.7.67"
            ]
