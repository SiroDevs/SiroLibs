          },
          "items": [
            {
              "text": "71",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aviimiliri va avizinyumba valala vaahana mu livikiru kokonyana ni miyinzi yijo zikilo 168 zie izahabu, zikilo 1,400 zie ifeza. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.71",
            "verseOrgIds": [
              "NEH.7.71"
            ]
          }
        },
        {
          "name": "verse",
