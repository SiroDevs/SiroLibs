              "type": "text"
            },
            {
              "text": "Shiba:",
              "type": "text"
            },
            {
              "text": "Muluheburaina liveeye kovora, “Lilagana”.",
              "type": "text"
            }
          ]
        },
        {
          "text": ". Nindio lidaala linene lia Beerisheba lianyora lieta lialio.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.33",
            "verseOrgIds": [
              "GEN.26.33"
            ]
