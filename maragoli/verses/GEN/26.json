          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku lidiku yilio avatumikiri va Isaka vaza ni vamuvolera kigira kidaho cha vaali nivayavi. Vavoola, “Kunyi kumali konyoora mazi.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.32",
            "verseOrgIds": [
              "GEN.26.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 26:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunangwa Isaka yagulika kidaho yiki Shiba",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.33",
            "verseOrgIds": [
              "GEN.26.33"
            ]
          }
        },
        {
