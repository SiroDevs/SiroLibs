        {
          "text": "Lwa Esau yaali ni mihiga 40, yaleeta avakaana va Hiti vaviri, Judizi mukaana wa Beeri na Basemazi mukaana wa Eloni. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.34",
