          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yivi ni visukululwi via Shemu. Lwa Shemu yaali ni mihiga 100, mihiga giviri inyima wi migelera ja mazi, yivula mwana muyaayi walangwa Aripakishadi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.10",
            "verseOrgIds": [
              "GEN.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inyima wa yaali ni yakivula Aripakishadi, Shemu yamenya mihiga 500 ma niyiivura avana vandi avayaayi na vakana.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.11",
            "verseOrgIds": [
              "GEN.11.11"
            ]
          }
        }
      ]
