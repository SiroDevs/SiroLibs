              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lotoni yaali na vayaayi 2: Hori na Hemani. Timina yaali mbozo Lotoni.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.22",
