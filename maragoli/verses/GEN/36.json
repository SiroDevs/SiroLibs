              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yizi ni zihiiri kutura ku Oholibama mukaana wa Ana, mukali wa Esau: Jeushi, Jalamu na Kora. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.18",
            "verseOrgIds": [
              "GEN.36.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 36:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zihiiri yizi ziosi ziatula ku Esau.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.19",
            "verseOrgIds": [
              "GEN.36.19"
            ]
          }
        }
