              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yava na vayaayi va Seiri Muhori, avandu vamenya mu kivala cha Edomu: Ihiiri ya Lotani, ihiiri ya Shobali, ihiiri ya Zibeoni, ihiiri ya Ana, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.20",
            "verseOrgIds": [
              "GEN.36.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 36:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dishoni, Ezeri, na Dishani.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.21",
            "verseOrgIds": [
              "GEN.36.21"
            ]
          }
        }
      ]
    },
