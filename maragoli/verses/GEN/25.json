              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avayaayi yava vaaviruka, na Esau yagwa muhimi mulahi ligali, mundu wayanza limenya liechova. Yakobo yaali mundu muchiring'anu uwatigalaa hango. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.27",
            "verseOrgIds": [
