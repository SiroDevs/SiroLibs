              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lidiku lilala lwa Yakobo yaali nadeeka muduyaa, Esau yingira natura mu lihiima. Yaali ni inzara ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.29",
            "verseOrgIds": [
