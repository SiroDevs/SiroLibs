              "type": "text"
            }
          ]
        },
        {
          "text": "kandi yavolera Yakobo, “Inzi mbeeye ni inzara ombe kumuduya mwakanyu yigwo.” Yiki nicho chagira nalangwa Edomu",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.30",
