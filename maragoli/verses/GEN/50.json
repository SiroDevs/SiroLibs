          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunangwa Josefu yakuzira naveeye ni mihiga 110. Valomba muviri gwigwe kandi nivaguvika mu lisandugu mu Egebeti.",
          "type": "text",
