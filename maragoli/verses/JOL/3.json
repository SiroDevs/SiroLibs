            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yahova avoora,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.1",
            "verseOrgIds": [
              "JOL.3.1"
            ]
          }
        }
