{
  "id": "ECC.5",
  "number": "5",
  "bookId": "ECC",
  "reference": "Kohelezu 5",
  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
