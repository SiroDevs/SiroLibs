          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avandu vaviri vanyara kogenda harara nivatavungirani?",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.3",
            "verseOrgIds": [
              "AMO.3.3"
            ]
          }
        }
      ]
    },
    {
