          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutego gunyala kutiguka vugira kutigulwa?",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.5",
            "verseOrgIds": [
              "AMO.3.5"
            ]
          }
        }
