      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Tiro",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
