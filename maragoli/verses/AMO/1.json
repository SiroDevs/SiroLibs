            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.2",
            "verseOrgIds": [
              "AMO.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "AMO 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yahova avoora, “Avandu vi lidaala linene lia Damasiko mukivala cha Siria vamali kokora uvwoni haali kanyingi; na kigira yaga, ndavaha amageri ligali vakoleye avandu va Gileadi uvudamanu, vavaduvagiiyi hasi kuli mundu uhulaa vuswage na mavere nu muvango. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.3",
            "verseOrgIds": [
              "AMO.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "AMO 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunangwa, ndatuma mulilu ku inyumba yu vwami yumbakwa nu mwami Hazaeli, na ndasamba zimbinga zie zinyumba zio vwami vwa mwami Benihadadi. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.4",
            "verseOrgIds": [
              "AMO.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "AMO 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndavunanyia vilivwa vie lidaala linene lia Damasiko mu Siria nu kutuliza ho avandu vamenyi mu livona lia Aveni",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.5",
            "verseOrgIds": [
              "AMO.1.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "1:5",
              "type": "text"
            },
            {
              "text": "Aveni:",
              "type": "text"
            },
            {
              "text": "Inyumba yu vwoni.",
              "type": "text"
            }
          ]
        },
        {
          "text": " na avami va Bez-edeni",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.5",
            "verseOrgIds": [
              "AMO.1.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "1:5",
              "type": "text"
            },
            {
              "text": "Bez-edeni:",
              "type": "text"
            },
            {
              "text": "Inyumba yu kwisangaliza.",
              "type": "text"
            }
          ]
        },
        {
          "text": ". Avandu va Siria valahirwa mu vuhambe mu kivala cha Kiri.”",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.5",
            "verseOrgIds": [
              "AMO.1.5"
            ]
          }
        }
      ]
    },
