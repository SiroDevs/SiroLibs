          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.10",
            "verseOrgIds": [
              "AMO.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "AMO 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yahova avoora, “Avandu vi kivala cha Edomu vamali kokora uvwoni haali kanyingi, na kigira yaga ndavaha amageri. Vaahiima avamwavo vaavo vandu va Isiraeli ni kivavi, na sivaveererera mba. Vutima vwavo sivwaali ne keheri mba. Sivaaloleka vahomati mba. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.11",
            "verseOrgIds": [
              "AMO.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "AMO 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunangwa ndatuma muliru ku lidaala linene lia Temani na gulasamba zimbinga zia Bozira.”",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.12",
            "verseOrgIds": [
              "AMO.1.12"
            ]
          }
        }
      ]
    },
    {
