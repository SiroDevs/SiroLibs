          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwami Huramu yatuma aveleemi vi limanya linene kutura mu zimeri zizie ziu vulwani kutumika harara na valala ku vandu va Solomoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.27",
