            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.24",
            "verseOrgIds": [
              "1KI.14.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
