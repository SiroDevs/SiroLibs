        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.28",
            "verseOrgIds": [
              "1KI.14.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 14:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vindu vindi viosi viu mwami Rehoboamu yakola viang'odwa mu vitabu via makuva ga kale ga vami vi Ivuyuda. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.29",
            "verseOrgIds": [
              "1KI.14.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 14:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu ing'inga yiyi yoosi, Rehoboamu na Jeroboamu vaali mu vulwani kazozo. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.30",
            "verseOrgIds": [
              "1KI.14.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 14:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rehoboamu yakuza kandi nayavirwa mu vilindwa vio mu Lidaala linene lia Daudi; kandi muyaayi weve Abija yavugula vogono vwivwe kuli mwami.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.31",
            "verseOrgIds": [
              "1KI.14.31"
            ]
          }
        }
      ]
