            "number": "25",
            "style": "v",
            "sid": "1KI 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu muhiga gwa katano gwu vwamihi vwa Rehoboamu, mwami Shishaka wa Egebeti yingilira jerusalemi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.25",
            "verseOrgIds": [
              "1KI.14.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 14:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yavugula viju viuvuguli viosi kutura mu Litembeli, kandi munyumba yu vwami, komeeda ku zikuuti zie zahabu zia Solomoni yaali niyalomba. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.26",
            "verseOrgIds": [
              "1KI.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwilanyia ho viju vindi, mwami Rehoboamu yalomba zikuuti zie migasa kandi naviika mu vulindi vulahi vwa vanene valindanga virivwa vie nyumba yu vwami. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.27",
            "verseOrgIds": [
              "1KI.14.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vuli ing'inga lwu mwami yazia mu Litembeli, avasikari vaginga zikuuti yizio ma kandi vaziiranyia mu keng'oze chukuzilindira mu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.28",
            "verseOrgIds": [
              "1KI.14.28"
            ]
          }
        }
      ]
    },
    {
