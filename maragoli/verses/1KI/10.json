              "type": "text"
            },
            {
              "text": "Kilikia:",
              "type": "text"
            },
            {
              "text": "Inyala kuva Silisia.",
              "type": "text"
            }
          ]
        },
        {
          "text": ". ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.28",
            "verseOrgIds": [
              "1KI.10.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Valeta magare gwuvulwaani kutura Egebeti ku vuguli vwi vidonye viefeza 600 vuli lilala na ibarasi kuvuguli vwi vidonye 150 viefeza Vaziguliza kandi ku vami va hiti, na Siria ku vuguli vulala vwere.",
          "type": "text",
