        },
        {
          "text": "Mwami Solomoni yaali mutugi kandi mugeri ligali kuvita Mwami wundi woosi mu lirova, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.23",
            "verseOrgIds": [
              "1KI.10.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi vandu vosi vi lirova venya kuuza kuhuliriza vogeri vwivwe vwa Nyasaye yaali niyamuha. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.24",
            "verseOrgIds": [
              "1KI.10.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vulii mundu waza, yamuletera vihaanwa, kuli; viju vie zahabu ni feza, ziganza, viugi, mudalasini, zibarasi, kandi zisukiri. Yaga gazizagilira vuli muhiga.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.25",
            "verseOrgIds": [
              "1KI.10.25"
            ]
          }
        }
      ]
    },
