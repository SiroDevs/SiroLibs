  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "31",
        "style": "c",
        "sid": "2CH 31"
      },
      "items": [
        {
          "text": "31",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 31:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izvi zvose pazvakapera, vaIsraeri vakanga varipo vakabuda vakaenda kumaguta eJudha vakaputsa matombo ose anoera uye vakatema matanda aAshera. Vakaparadza nzvimbo dzakakwirira nearitari muJudha yose neBhenjamini nomuEfuremu neManase. Vapedza kuparadza zvose vaIsraeri vakadzokera kumaguta avo nokuzvinhu zvavo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.1",
            "verseOrgIds": [
              "2CH.31.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Vashumiri vanogoverwa mabasa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 31:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekia akaisa vaprista navaRevhi mumapoka avo mumwe nomumwe wavo mumabasa avo savaprista kana kuti vaRevhi kuti vape zvipiriso zvinopiswa nezvipo zvokuyananisa kuti vashumire, kuti varonge uye kuti vaimbe nziyo dzokurumbidza pamasuo enzvimbo yaJehovha yokugara.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.2",
            "verseOrgIds": [
              "2CH.31.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 31:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo akapawo kubva mupfuma yake zvipiriso zvinoitwa mangwanani nemadekwana, nezvipiriso zvinopiswa zvamaSabata, zvoKugara kwoMwedzi napane mimwe mitambo yakatarwa sezvazvakanyorwa muMurayiro waJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.3",
            "verseOrgIds": [
              "2CH.31.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 31:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akarayira vanhu vaigara muJerusarema kuti vape zvakakodzera kupiwa vaprista navaRevhi kuti ivo vazvipire kuMurayiro waJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.4",
            "verseOrgIds": [
              "2CH.31.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 31:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shoko parakangoenda, vaIsraeri vakapa zvakawanda zvibereko zvokutanga zvezvirimwa zvavo, waini itsva, mafuta nouchi nezvose zvakabuda muminda yavo. Vakauyisa zvakawanda, chegumi chezvose.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.5",
            "verseOrgIds": [
              "2CH.31.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 31:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Varume veIsraeri neJudha vaigara mumaguta eJudha vakauyisa chegumi chamatanga avo nechegumi chezvinhu zvitsvene zvakakumikidzwa kuna Jehovha Mwari wavo, uye vakazviisa mumatutu matatu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.6",
            "verseOrgIds": [
              "2CH.31.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 31:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakatanga kuita izvi mumwedzi wechitatu vakazopedza mumwedzi wechinomwe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.7",
            "verseOrgIds": [
              "2CH.31.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 31:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekia namakurukota ake pavakauya vakaona matutu ezvinhu, vakarumbidza Jehovha uye vakaropafadza vanhu vake Israeri.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.8",
            "verseOrgIds": [
              "2CH.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 31:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekia akabvunza vaprista navaRevhi nezvamatutu aya.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.9",
            "verseOrgIds": [
              "2CH.31.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 31:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azaria muprista mukuru kubva kuimba yaZadhoki akapindura achiti, \"Kubva zvakatanga vanhu kuuyisa zvipo zvavo kutemberi yaJehovha, takawana zvokudya zvakatiringana, nezvizhinji zvaisara, nokuti Jehovha akaropafadza vanhu vake, uye izvi zvizhinji ndizvo zvakasara.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.10",
            "verseOrgIds": [
              "2CH.31.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 31:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekia akarayira kuti kugadzirwe matura okuchengetera zvinhu mutemberi yaJehovha, izvi zvikaitwa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.11",
            "verseOrgIds": [
              "2CH.31.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 31:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo vakauyisa zvipo zvavo vakatendeka, nezvegumi nezvipo zvakakumikidzwa. Konania muRevhi ndiye aiva mutariri wezvinhu izvi uye mununʼuna wake Shimei ndiye aimutevera.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.12",
            "verseOrgIds": [
              "2CH.31.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 31:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehieri, Azazia, Nahati, Asaheri, Jerimoti, Jozabhadhi, Erieri, Isimakia, Mahati, naBhenaya vaiva vatariri vari pasi paKonania naShimei mununʼuna wake, sokupiwa basa kwavakaitwa naMambo Hezekia naAzaria muchinda aiona nezvetemberi yaMwari.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.13",
            "verseOrgIds": [
              "2CH.31.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 31:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kore mwanakomana waImina muRevhi, muchengeti weSuo rokumabvazuva, ndiye aichengeta zvipo zvokupa nokuzvisarudzira kuna Mwari achizogovera zvipo zvaipiwa kuna Jehovha pamwe chete nezvipo zvakatsaurwa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.14",
            "verseOrgIds": [
              "2CH.31.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 31:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Edheni, Miniamini, Jeshua, Shemaya, Amaria naShekania vakamubatsira vakatendeka mumaguta avaprista, vachigovera vamwe vaprista mumapoka avo, vakuru navadiki zvakafanana.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.15",
            "verseOrgIds": [
              "2CH.31.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 31:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamusoro pezvo vakagovera kuvanhurume vaiva namakore matatu zvichikwira avo vaiva namazita avo akanyorwa mumagwaro enhoroondo, vose avo vaizopinda mutemberi yaJehovha kuti vaite mabasa ezuva nezuva akasiyana-siyana, zvichienderana nezvavakatarirwa kuti vaite uye namapoka avo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.16",
            "verseOrgIds": [
              "2CH.31.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 31:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye vakagovera kuvaprista sokunyorwa kwazvakaitwa munhoroondo yavo mumhuri dzavo, uye saizvozvowo kuvaRevhi, vaiva namakore makumi maviri zvichikwira zvichienderana namabasa avo namapoka avo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.17",
            "verseOrgIds": [
              "2CH.31.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 31:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vaisanganiswa vadiki vose, vakadzi, navanakomana navanasikana venzvimbo yose vakanyorwa munhoroondo nokuti vakanga vakatendeka pakuzvinatsa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.18",
            "verseOrgIds": [
              "2CH.31.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 31:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuvaprista, zvizvarwa zvaAroni vaigara mumaruwa akanga akakomberedza maguta avo kana mune mamwe maguta, varume vakapiwa mabasa namazita avo kuti vape migove kuno murume mumwe nomumwe aiva pakati pavo nokuna vose vakanga vakanyorwa mumabhuku enhoroondo dzavaRevhi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.19",
            "verseOrgIds": [
              "2CH.31.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 31:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izvi ndizvo zvakaitwa naHezekia muJudha yose achiita zvakanga zvakanaka uye zvakarurama uye zvakatendeka pamberi paJehovha Mwari wake.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.20",
            "verseOrgIds": [
              "2CH.31.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 31:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mune zvose zvaakaita mukushandira temberi yaMwari uye mukutevera murayiro nezvakarayirwa, akatsvaka Mwari wake akashanda nomwoyo wose. Saka akabudirira.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.21",
            "verseOrgIds": [
              "2CH.31.21"
            ]
          }
        }
      ]
    }
  ],
