    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jotamu Mambo weJudha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 27:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jotamu aiva namakore makumi maviri namashanu paakava mambo, uye akatonga muJerusarema kwamakore gumi namatanhatu. Amai vake vainzi Jerusha mwanasikana waZadhoki.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.1",
            "verseOrgIds": [
              "2CH.27.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaita zvakanaka pamberi paJehovha sezvakanga zvaitwa nababa vake Uzia, asi iye haana kuzopinda zvake mutemberi yaJehovha. Kunyange zvakadaro, vanhu vakaramba vachiita zvakaipa zvavo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.2",
            "verseOrgIds": [
              "2CH.27.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jotamu akavakazve Suo Rokumusoro retemberi yaJehovha akaita basa guru kwazvo parusvingo rwapagomo raOferi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.3",
            "verseOrgIds": [
              "2CH.27.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akavaka maguta muzvikomo zveJudhea, nenhare neshongwe mumatondo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.4",
            "verseOrgIds": [
              "2CH.27.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jotamu akarwa namambo wavaAmoni akavakunda. Mugore iroro vaAmoni vakamuripa matarenda zana",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.5",
            "verseOrgIds": [
              "2CH.27.5"
            ]
          }
        },
        {
          "text": "esirivha, nezviyero zvegorosi zviuru gumi",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.5",
            "verseOrgIds": [
              "2CH.27.5"
            ]
          }
        },
        {
          "text": ", nezviyero zvebhari zviuru gumi. VaAmoni vakauyisa zvimwe chetezvo mugore rechipiri nerechitatu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.5",
            "verseOrgIds": [
              "2CH.27.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jotamu akava nesimba kwazvo nokuti aifamba akatendeka pamberi paJehovha Mwari wake.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.6",
            "verseOrgIds": [
              "2CH.27.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvimwe zvakaitwa mukutonga kwaJotamu pamwe chete nehondo dzake dzose dzaakarwa nezvimwe zvinhu zvaakaita, zvakanyorwa mubhuku ramadzimambo eIsraeri neeJudha.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.7",
            "verseOrgIds": [
              "2CH.27.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aiva namakore makumi maviri namashanu paakava mambo, uye akatonga muJerusarema kwamakore gumi namatanhatu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.8",
            "verseOrgIds": [
              "2CH.27.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jotamu akazorora namadzibaba ake akavigwa muGuta raDhavhidhi. Uye Ahazi mwanakomana wake akamutevera paumambo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.9",
            "verseOrgIds": [
              "2CH.27.9"
            ]
          }
        }
      ]
    }
  ],
