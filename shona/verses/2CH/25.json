  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "25",
        "style": "c",
        "sid": "2CH 25"
      },
      "items": [
        {
          "text": "25",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amazia Mambo weJudha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amazia aiva namakore makumi maviri namashanu paakava mambo, akatonga muJerusarema kwamakore makumi maviri namapfumbamwe. Mai vake vainzi Jehoadhini, uye vaibva kuJerusarema.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.1",
            "verseOrgIds": [
              "2CH.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaita zvakanga zvakanaka pamberi paJehovha, asi kwete nomwoyo wose.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.2",
            "verseOrgIds": [
              "2CH.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paakapedza kusimbisa umambo hwake akauraya machinda akanga auraya baba vake.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.3",
            "verseOrgIds": [
              "2CH.25.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunyange zvakadaro haana kuuraya vanakomana vavo asi akaita sezvazvakanga zvakanyorwa muMurayiro, muBhuku raMozisi, umo Jehovha akarayira achiti, \"Madzibaba havafaniri kuurayiwa nokuda kwavana vavo, uye kuti vana havafaniri kuurayiwa nokuda kwamadzibaba avo.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.4",
            "verseOrgIds": [
              "2CH.25.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amazia akaunganidza vanhu veJudha akavaronga zvichienderana nemhuri dzavo pasi pavatungamiri vezviuru uye navatungamiri vamazana akaverengawo vaiva namakore makumi maviri naanopfuura akaona kuti vaisvika zviuru mazana matatu vakanga vakagadzirira kuenda kuhondo, vaigona kushandisa mapfumo nenhoo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.5",
            "verseOrgIds": [
              "2CH.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akatorazve varwi zviuru zana kubva kuIsraeri akavaripa matarenda zana",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.6",
            "verseOrgIds": [
              "2CH.25.6"
            ]
          }
        },
        {
          "text": "esirivha.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.6",
            "verseOrgIds": [
              "2CH.25.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi munhu waMwari akauya kwaari akati, \"Haiwa Mambo, ava varwi vabva kuIsraeri havafaniri kuenda nemi nokuti Jehovha havasi kuIsraeri, havasi kune upi zvake munhu wokuEfuremu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.7",
            "verseOrgIds": [
              "2CH.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunyange mukaenda kundorwa nesimba rose, Mwari achakukundai pamberi pavavengi nokuti Mwari ane simba rokubatsira kana kuputsa.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.8",
            "verseOrgIds": [
              "2CH.25.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amazia akabvunza munhu waMwari akati, \"Asi, matarenda zana andakaripa kuvaIsraeri anoitwa sei?\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.9",
            "verseOrgIds": [
              "2CH.25.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2CH 25:9"
      },
      "items": [
        {
          "text": "Munhu waMwari akapindura akati, \"Jehovha anogona kukupa zvakawanda kupfuura izvi.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.9",
            "verseOrgIds": [
              "2CH.25.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Amazia akaregera varwi vose vakanga vabva kuEfuremu vachienda uye akavati vaende zvavo kumba. Vakatsamwa zvikuru nokuda kweJudha vakaenda kumba vachipopota zvikuru.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.10",
            "verseOrgIds": [
              "2CH.25.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Amazia akatungamirira hondo yake kuMupata weMunyu, kwaakandouraya varume veSeiri zviuru gumi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.11",
            "verseOrgIds": [
              "2CH.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hondo yeJudha yakabatazve varume zviuru gumi vakavatora vakaenda navo pamusoro pegomo pamawere vakavakanda pasi pakavhunika-vhunika.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.12",
            "verseOrgIds": [
              "2CH.25.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panguva imwe cheteyo varwi vakanga vadzoserwa naAmazia pakurwa uku vakandopamba maguta eJudhea kubva kuSamaria kusvika kuBheti Horoni. Vakauraya zviuru zvitatu zvavanhu vakatakura zvinhu zvizhinji kwazvo zvavakapamba.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.13",
            "verseOrgIds": [
              "2CH.25.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amazia paakadzoka kundouraya vaEdhomu, akadzosa vamwari vavanhu veSeiri akavamisa, akavakotamira savamwari vake, akavapisira zvibayiro.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.14",
            "verseOrgIds": [
              "2CH.25.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutsamwa kwaMwari kwakauya pamusoro paAmazia, akatuma muprofita kwaari, akati, \"Seiko uchibvunzira kuna vamwari vavanhu ava vakatadza kuponesa vanhu vavo kubva mumaoko ako?\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.15",
            "verseOrgIds": [
              "2CH.25.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achiri kutaura, mambo akati kwaari, \"Ko, takugadza kuti uve mupi wamazano wamambo here? Mira! Uchafireko?\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.16",
            "verseOrgIds": [
              "2CH.25.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2CH 25:16"
      },
      "items": [
        {
          "text": "Saka muprofita akamira, asi akati, \"Ndinoziva kuti Mwari akagadzirira kukuparadza nokuti wakaita izvi, uye hauna kuteerera kurayira kwangu.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.16",
            "verseOrgIds": [
              "2CH.25.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mushure mokunge Amazia mambo weJudha abvunza vapi vake vamazano akatumira shoko rokudenha kuna Jehoashi, mwanakomana waJehoahazi, mwanakomana waJehu, mambo weIsraeri achiti, \"Uya tisangane chiso nechiso.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.17",
            "verseOrgIds": [
              "2CH.25.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi Jehoashi mambo weIsraeri akapindura Amazia mambo weJudha akati, \"Rukato rwakanga rwuri muRebhanoni rwakatuma shoko kumusidhari wakanga uri muRebhanoni, rokuti, 'Ipa mwanasikana wako kumwanakomana wangu kuti ave mukadzi wake.' Ipapo imwe mhuka yomusango yaiva muRebhanoni yakauya ikatsika-tsika rukato rwuya pasi petsoka dzayo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.18",
            "verseOrgIds": [
              "2CH.25.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unozviti wakakunda vaEdhomu uye zvino wava namanyawi nokuzvikudza. Zvino gara kumba kwako! Seiko uchikumbira matambudziko uye uchizviwisira pasi iwe neJudhawo?\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.19",
            "verseOrgIds": [
              "2CH.25.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 25:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunyange zvakadaro, Amazia haana kuteerera, nokuti Mwari akaita izvozvo kuti avaise kuna Jehoashi nokuti vakanga vatsvaka vamwari veEdhomu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.20",
            "verseOrgIds": [
              "2CH.25.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 25:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Jehoashi mambo weIsraeri akavarwisa. Iye naAmazia vakatarisana paBheti Shemeshi muJudha.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.21",
            "verseOrgIds": [
              "2CH.25.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 25:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Judha yakakundwa neIsraeri uye munhu wose akatizira kumba kwake.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.22",
            "verseOrgIds": [
              "2CH.25.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 25:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehoashi mambo weIsraeri akatapa Amazia mambo weJudha, mwanakomana waJoashi, mwanakomana waAhazia paBheti Shemeshi. Ipapo Jehoashi akauya naye kuJerusarema akaputsa rusvingo rweJerusarema kubva paSuo raEfuremu kusvika paSuo Rapakona, nzvimbo yakareba makubhiti mazana mana",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.23",
            "verseOrgIds": [
              "2CH.25.23"
            ]
          }
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.23",
            "verseOrgIds": [
              "2CH.25.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 25:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akatora goridhe nesirivha yose nemidziyo yose yakawanikwa mutemberi yaMwari zvaichengetwa naObhedhi-Edhomu, pamwe chete nepfuma yose yaiva mumuzinda navanhu vorubatso, uye vakadzokera kuSamaria.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.24",
            "verseOrgIds": [
              "2CH.25.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 25:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amazia mwanakomana waJoashi mambo weJudha akararama kwamakore gumi namashanu mushure mokunge Jehoashi mwanakomana waJehoahazi mambo weIsraeri afa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.25",
            "verseOrgIds": [
              "2CH.25.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 25:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvimwe zvose zvakaitwa naAmazia mukutonga kwake kubva pakutonga kusvikira pakupedzisira hazvina kunyorwa here mubhuku ramadzimambo eJudha neIsraeri?",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.26",
            "verseOrgIds": [
              "2CH.25.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 25:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubva panguva yakatsauka Amazia kubva mukutevera Jehovha, vakamupandukira muJerusarema uye iye akatizira kuRakishi vakandomuurayira ikoko.",
          "type": "text",
