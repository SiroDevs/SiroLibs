  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "2CH 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kukumikidzwa kweTemberi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soromoni paakapedza kunyengetera, moto wakaburuka kubva kudenga ukapisa chipiriso chinopiswa nezvibayiro uye kubwinya kwaJehovha kwakazadza temberi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.1",
            "verseOrgIds": [
              "2CH.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vaprista vakatadza kupinda mutemberi yaJehovha nokuti kubwinya kwaJehovha kwakanga kwakaizadza.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.2",
            "verseOrgIds": [
              "2CH.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "VaIsraeri vose pavakaona moto uchiburuka uye kubwinya kwaJehovha kuri pamusoro petemberi, vakapfugama pachivara zviso zvavo zvakatarisa pasi, uye vakanamata vakavonga Jehovha vachiti:",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.3",
            "verseOrgIds": [
              "2CH.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "2CH 7:3"
      },
      "items": [
        {
          "text": "\"Iye akanaka;",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.3",
            "verseOrgIds": [
              "2CH.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2CH 7:3"
      },
      "items": [
        {
          "text": "rudo rwake runogara nokusingaperi.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.3",
            "verseOrgIds": [
              "2CH.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo mambo navanhu vose vakapa zvibayiro pamberi paJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.4",
            "verseOrgIds": [
              "2CH.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye Mambo Soromoni akapa chibayiro chemombe zviuru makumi maviri nezviviri namakwai nembudzi zviuru zana namakumi maviri. Saka mambo navanhu vose vakakumikidza temberi yaMwari.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.5",
            "verseOrgIds": [
              "2CH.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vaprista vakaenda panzvimbo dzavo sezvakaitwawo navaRevhi vane zviridzwa zvaJehovha zvakanga zvagadzirwa naMambo Dhavhidhi kuti zvishandiswe pakurumbidza Jehovha uye ndizvo zvakashandiswa pavakavonga vachiti, \"Rudo rwake runogara nokusingaperi.\" Kune rumwe rutivi rwakatarisana navaRevhi, vaprista vakaridza hwamanda dzavo uye vaIsraeri vose vakanga vakamira.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.6",
            "verseOrgIds": [
              "2CH.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soromoni akatsaura nzvimbo yapakati pechivanze chapamberi petemberi yaJehovha uye ipapo akapa zvipiriso zvinopiswa namafuta ezvipiriso zvokuwadzana, nokuti aritari yendarira yaakanga agadzira yaisakwana zvipiriso zvinopiswa, nezvipiriso zvoupfu namafuta.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.7",
            "verseOrgIds": [
              "2CH.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Soromoni akatamba mutambo panguva iyoyo kwamazuva manomwe, uye Israeri yose yakanga inaye, ungano huru kwazvo, vanhu vaibva kuRebho Hamati kusvika kuRwizi rweIjipiti.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.8",
            "verseOrgIds": [
              "2CH.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pazuva rorusere vakaungana pamwe chete nokuti vakanga vapemberera kutsaurwa kwearitari kwamazuva manomwe uye mutambo uyu kwamamwezve mazuva manomwe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.9",
            "verseOrgIds": [
              "2CH.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pazuva ramakumi maviri namatatu romwedzi wechinomwe akaendesa vanhu kudzimba dzavo, vachifara uye mwoyo yavo ichifara nokuda kwezvinhu zvakanaka zvakanga zvaitwa naJehovha kuna Dhavhidhi naSoromoni nokuvanhu vake Israeri.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.10",
            "verseOrgIds": [
              "2CH.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jehovha anozviratidza kuna Soromoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soromoni paakapedza temberi yaJehovha nomuzinda wake, uye abudirira mukuita zvose zvaaiva nazvo mupfungwa dzake kuita mutemberi yaJehovha nomumuzinda wake,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.11",
            "verseOrgIds": [
              "2CH.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha akazviratidza kwaari usiku akati:",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.12",
            "verseOrgIds": [
              "2CH.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "2CH 7:12"
      },
      "items": [
        {
          "text": "\"Ndanzwa munyengetero wako uye ndazvisarudzira nzvimbo ino setemberi yezvibayiro.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.12",
            "verseOrgIds": [
              "2CH.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kana ndikapfiga matenga kukasava nemvura inonaya, kana kuti ndikarayira mhashu kuti dziparadze nyika kana kuti ndikatuma denda pakati pavanhu vangu,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.13",
            "verseOrgIds": [
              "2CH.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "kana vanhu vangu vanodaidzwa nezita rangu, vakazvininipisa, vakanyengetera vakatsvaga chiso changu, vakatendeuka kubva panzira dzavo dzakaipa, ipapo ndichavanzwa kubva kudenga uye ndicharegerera chivi chavo uye ndichaporesa nyika yavo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.14",
            "verseOrgIds": [
              "2CH.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino meso angu achaona uye nzeve dzangu dzichanzwa minyengetero ichapirwa munzvimbo ino.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.15",
            "verseOrgIds": [
              "2CH.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndasarudza ndikatsaura temberi ino kuti Zita rangu rivepo nokusingaperi. Meso angu nomwoyo wangu zvicharamba zviripo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.16",
            "verseOrgIds": [
              "2CH.7.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kana uriwe, kana ukafamba pamberi pangu sezvakaitwa naDhavhidhi baba vako, uye ukaita zvose zvandichakurayira uye ukachengeta mitemo yangu nemirayiro yangu,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.17",
            "verseOrgIds": [
              "2CH.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndichasimbisa chigaro chako choushe, sezvandakavimbisa Dhavhidhi baba vako pandakati, 'Hauchazongokundikani kuva nomunhu achatonga Israeri.'",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.18",
            "verseOrgIds": [
              "2CH.7.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Asi kana mukatsauka mukasiya mitemo nezvandakakurayirai, mukaenda kundoshumira vamwe vaMwari mukavanamata,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.19",
            "verseOrgIds": [
              "2CH.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "ipapo ndichadzura Israeri kubva kunyika yangu, yandakavapa, uye ndicharasira kure temberi iyi yandakazvitsaurira Zita rangu. Ndichaiita tsumo nechiseko pakati pamarudzi ose.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.20",
            "verseOrgIds": [
              "2CH.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye kunyange temberi ino ichishamisa zvakadai, vose vachapfuura napairi vachakanuka vagoti, 'Seiko Jehovha akaita chinhu chakadai kunyika ino nokutemberi iyi?'",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.21",
            "verseOrgIds": [
              "2CH.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanhu vachapindura vachiti, 'Nokuti vakasiya Jehovha Mwari wamadzibaba avo, akavabudisa kubva muIjipiti uye vakanamatira kuna vamwe vamwari uye vachivanamata nokuvashumira, ndokusaka akauyisa njodzi iyi pavari.' \"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.22",
            "verseOrgIds": [
              "2CH.7.22"
            ]
          }
        }
      ]
    }
  ],
