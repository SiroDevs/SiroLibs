  "verseCount": 19,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "LEV 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Kana munhu akatadza nokuti aramba kupa uchapupu iye achinzi ape uchapupu pamusoro pezvaakaona kana zvaakanzwa, achava nemhosva.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.1",
            "verseOrgIds": [
              "LEV.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Kana kuti munhu akabata zvinhu zvipi zvazvo zvisina kuchena, zvingava zvitunha zvemhuka dzesango dzisina kuchena, kana mombe isina kuchena, kana zvipuka zvisina kuchena zvinofamba pavhu, kunyange asingazvizivi, atova asina kuchena uye ane mhosva.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.2",
            "verseOrgIds": [
              "LEV.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Kana kuti akabata zvisakachena zvavanhu, chinhu chipi zvacho chinoita kuti asava akachena, kunyange asingazvizivi, paanozozviziva, achava nemhosva.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.3",
            "verseOrgIds": [
              "LEV.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Kana kuti munhu asina kunyatsofungisisa akaita mhiko yokuti achaita chimwe chinhu, chingava chakanaka kana chakaipa, panyaya ipi zvayo, munhu yaanenge apika pamusoro payo asina kufungisisa, kunyange zvazvo asingazvizivi, paanozozviziva achava nemhosva.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.4",
            "verseOrgIds": [
              "LEV.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Kana munhu akava nemhosva pane chimwe chaizvozvi anofanira kureurura nzira yaakatadza nayo",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.5",
            "verseOrgIds": [
              "LEV.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye somuripo wechivi chaakaita, anofanira kuuya kuna Jehovha negwayana sheshe kana mbudzana sechipiriso chechivi uye muprista achamuyananisira chivi chake.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.6",
            "verseOrgIds": [
              "LEV.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Kana asingakwanisi kuuya negwayana anofanira kuuya nenjiva mbiri kana hangaiwa diki mbiri kuna Jehovha somuripo wechivi chake, imwe somuripo wechivi, imwe sechipiriso chinopiswa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.7",
            "verseOrgIds": [
              "LEV.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anofanira kudziuyisa kumuprista uyo achatanga kupa imwe yacho sechipiriso chechivi. Anofanira kumonyorora mutsipa wayo asingabvisi musoro zvachose.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.8",
            "verseOrgIds": [
              "LEV.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achasasa rimwe ropa rechipiriso chezvivi kumativi earitari, rimwe ropa rose rinofanira kudururwa mujinga mearitari. Ichi chipiriso chechivi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.9",
            "verseOrgIds": [
              "LEV.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo muprista achapa chimwe chacho sechipiriso chinopiswa nenzira yakatarwa agomuyananisira pachivi chaakaita, uye acharegererwa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.10",
            "verseOrgIds": [
              "LEV.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Asi, kana asingakwanisi kuuya nenjiva mbiri kana hangaiwa diki mbiri, anofanira kuuya nechipiriso chezvivi zvake chiri chegumi cheefa",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.11",
            "verseOrgIds": [
              "LEV.5.11"
            ]
          }
        },
        {
          "text": "youpfu hwakatsetseka sechipiriso chezvivi. Haafaniri kuisa mafuta kana zvinonhuhwira pazviri nokuti chipiriso chechivi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.11",
            "verseOrgIds": [
              "LEV.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anofanira kuzviuyisa kumuprista uyo achatora tsama sechikamu chechirangaridzo agozvipisa paaritari pamusoro pezvipiriso zvinoitirwa Jehovha nomoto. Ichi chipiriso chezvivi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.12",
            "verseOrgIds": [
              "LEV.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nenzira iyi muprista achamuyananisira pazvivi zvose zvaakaita uye acharegererwa. Zvimwe zvose zvezvipiriso zvinosara zvichava zvomuprista, sezvinoitwa nezvipiriso zvezviyo.' \"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.13",
            "verseOrgIds": [
              "LEV.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Chipiriso cheMhosva",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Jehovha akati kuna Mozisi:",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.14",
            "verseOrgIds": [
              "LEV.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kana munhu akakanganisa chimwe chinhu uye akatadza nokusaziva maererano nezvinhu zvose zvitsvene zvaJehovha, anofanira kuuya kuna Jehovha nomuripo wegondobwe risina kuremara, uye rine muripo unokwanirana nesirivha, maererano neshekeri repanzvimbo tsvene",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.15",
            "verseOrgIds": [
              "LEV.5.15"
            ]
          }
        },
        {
          "text": ". Ichi chipiriso chezvivi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.15",
            "verseOrgIds": [
              "LEV.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anofanira kuripira zvaakatadza kuita maererano nezvinhu zvitsvene, agowedzera chikamu chimwe chete kubva muzvishanu agopa zvose kumuprista, achamuyananisira negondobwe sechipiriso chemhosva, uye acharegererwa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.16",
            "verseOrgIds": [
              "LEV.5.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kana munhu akatadza uye akaita zvisingabvumirwi pamirayiro ipi zvayo yaJehovha, kunyange asingazvizivi, ane mhosva uye achava nemhaka.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.17",
            "verseOrgIds": [
              "LEV.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anofanira kuuya kumuprista nechipiriso chemhosva gondobwe risina kuremara uye rine muripo wakafanira. Nenzira iyi muprista achamuyananisira pakukanganisa kwaakaita nokusaziva, uye acharegererwa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.18",
            "verseOrgIds": [
              "LEV.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichi chipiriso chezvivi, akabatwa nemhosva yaakapara kuna Jehovha.\"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.19",
            "verseOrgIds": [
              "LEV.5.19"
            ]
          }
        }
      ]
    }
  ],
