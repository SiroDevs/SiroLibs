  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "24",
        "style": "c",
        "sid": "LEV 24"
      },
      "items": [
        {
          "text": "24",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mafuta nechingwa zvinoiswa pamberi paJehovha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha akati kuna Mozisi,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.1",
            "verseOrgIds": [
              "LEV.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Rayira vaIsraeri kuti vauye kwauri namafuta akaisvonaka amaorivhi akasvinwa, omwenje, kuitira kuti mwenje irambe ichibvira nguva dzose.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.2",
            "verseOrgIds": [
              "LEV.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunze kwechidzitiro cheChipupuriro muTende Rokusangana, Aroni anofanira kuchengetedza mwenje iyi pamberi paJehovha kubva manheru kusvikira kwaedza, nguva dzose. Uyu unofanira kuva murayiro unogara nokusingaperi kuzvizvarwa zvichauya.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.3",
            "verseOrgIds": [
              "LEV.24.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenje iri pachigadziko chomwenje chegoridhe rakaisvonaka chiri pamberi paJehovha inofanira kuchengetedzwa nguva dzose.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.4",
            "verseOrgIds": [
              "LEV.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Torai upfu hwakatsetseka mugobika zvingwa gumi nezviviri muchishandisa zvikamu zviviri kubva mugumi zveefa",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.5",
            "verseOrgIds": [
              "LEV.24.5"
            ]
          }
        },
        {
          "text": "pachingwa chimwe nechimwe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.5",
            "verseOrgIds": [
              "LEV.24.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zviisei mumitsara miviri, zvitanhatu mumutsara mumwe nomumwe, patafura yegoridhe rakaisvonaka pamberi paJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.6",
            "verseOrgIds": [
              "LEV.24.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamutsetse mumwe nomumwe isai zvinonhuhwira zvive chirangaridzo chinomirira chingwa uye zvive chipiriso chinoitirwa Jehovha nomoto.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.7",
            "verseOrgIds": [
              "LEV.24.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chingwa ichi chinofanira kuiswa pamberi paJehovha nguva nenguva, Sabata neSabata zvakamirira vaIsraeri sesungano inogara nokusingaperi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.8",
            "verseOrgIds": [
              "LEV.24.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "NdechaAroni navanakomana vake, vanofanira kuchidyira munzvimbo tsvene, nokuti ichi chikamu chitsvene-tsvene chezvipiriso zvavo zvenguva nenguva zvinoitirwa Jehovha nomoto.\"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.9",
            "verseOrgIds": [
              "LEV.24.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Akatuka Jehovha akatakwa namabwe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino mwanakomana wavamwe mai vechiIsraeri uye baba vake vari vechiIjipita, akafamba pakati pavana vaIsraeri, uye mwanakomana womukadzi muIsraeri akarwa nomurume muIsraeri mumusasa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.10",
            "verseOrgIds": [
              "LEV.24.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanakomana womukadzi muIsraeri akatuka Zita raJehovha nechituko; naizvozvo vakauya naye kuna Mozisi. (Zita ramai vake rainzi Sheromiti, mwanasikana waDhibhiri worudzi rwaDhani.)",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.11",
            "verseOrgIds": [
              "LEV.24.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakamuisa mutorongo kusvikira kuda kwaJehovha kwaiswa pachena kwavari.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.12",
            "verseOrgIds": [
              "LEV.24.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Jehovha akati kuna Mozisi,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.13",
            "verseOrgIds": [
              "LEV.24.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Tora mutuki uende naye kunze kwomusasa. Vose vakamunzwa vanofanira kuisa maoko avo pamusoro wake uye ungano yose inofanira kumutaka namabwe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.14",
            "verseOrgIds": [
              "LEV.24.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uti kuvaIsraeri, 'Kana munhu upi zvake akatuka Mwari wake achava nemhosva;",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.15",
            "verseOrgIds": [
              "LEV.24.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ani naani anotuka zita raJehovha anofanira kuurayiwa. Ungano yose inofanira kumutaka namabwe. Kunyange ari mutorwa kana chizvarwa chenyu, akatuka Zita raJehovha anofanira kuurayiwa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.16",
            "verseOrgIds": [
              "LEV.24.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 24:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ani naani anouraya munhu, anofanira kuurayiwa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.17",
            "verseOrgIds": [
              "LEV.24.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 24:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munhu wose anouraya chipfuwo chomumwe munhu anofanira kuripa, upenyu hunotsiviwa noupenyu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.18",
            "verseOrgIds": [
              "LEV.24.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 24:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana munhu akakuvadza muvakidzani wake, zvose zvaaita zvinofanira kuitwa kwaari.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.19",
            "verseOrgIds": [
              "LEV.24.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 24:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutyora kunotsiviwa nokutyora, ziso rinotsiviwa neziso, zino rinotsiviwa nezino. Sezvaakuvadza mumwe saka naiye anofanira kukuvadzwa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.20",
            "verseOrgIds": [
              "LEV.24.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 24:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani naani anouraya mhuka anofanira kuripa asi ani naani anouraya munhu anofanira kuurayiwa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.21",
            "verseOrgIds": [
              "LEV.24.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 24:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munofanira kuva nomutemo mumwe chete pamutorwa napachizvarwa chemo. Ndini Jehovha Mwari wenyu.' \"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.22",
            "verseOrgIds": [
              "LEV.24.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 24:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Mozisi akataura navaIsraeri, vakatora mutuki vakaenda naye kunze kwomusasa, vakamutaka namabwe akafa. VaIsraeri vakaita sezvakarayirwa Mozisi naJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.23",
            "verseOrgIds": [
              "LEV.24.23"
            ]
          }
        }
      ]
    }
  ],
