  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
        "style": "c",
        "sid": "PRO 13"
      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanakomana akachenjera anoteerera kurayira kwababa vake,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.1",
            "verseOrgIds": [
              "PRO.13.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 13:1"
      },
      "items": [
        {
          "text": "asi mudadi haateereri kana achitsiurwa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.1",
            "verseOrgIds": [
              "PRO.13.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubva pazvibereko zvomuromo wake munhu achadya zvinhu zvakanaka,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.2",
            "verseOrgIds": [
              "PRO.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 13:2"
      },
      "items": [
        {
          "text": "asi vasina kutendeka vanofarira kumanikidza.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.2",
            "verseOrgIds": [
              "PRO.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyo anobata muromo wake anochengeta upenyu hwake,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.3",
            "verseOrgIds": [
              "PRO.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 13:3"
      },
      "items": [
        {
          "text": "asi uyo anokurumidzira kutaura achaparadzwa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.3",
            "verseOrgIds": [
              "PRO.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simbe inopanga asi igoshayiwa chinhu,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.4",
            "verseOrgIds": [
              "PRO.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 13:4"
      },
      "items": [
        {
          "text": "asi zvishuvo zvavanoshingaira zvichazadziswa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.4",
            "verseOrgIds": [
              "PRO.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakarurama vanovenga nhema,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.5",
            "verseOrgIds": [
              "PRO.13.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 13:5"
      },
      "items": [
        {
          "text": "asi vakaipa vanouyisa kunyadziswa nokunyangadza.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.5",
            "verseOrgIds": [
              "PRO.13.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kururama kunorinda munhu ane unhu hwakanaka,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.6",
            "verseOrgIds": [
              "PRO.13.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 13:6"
      },
      "items": [
        {
          "text": "asi kuipa kunowisira mutadzi pasi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.6",
            "verseOrgIds": [
              "PRO.13.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumwe munhu anozviti mupfumi, asi asina chinhu;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.7",
            "verseOrgIds": [
              "PRO.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 13:7"
      },
      "items": [
        {
          "text": "mumwewo anozviti murombo, asi aine upfumi huzhinji.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.7",
            "verseOrgIds": [
              "PRO.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Upfumi hwomunhu hunogona kudzikinura upenyu hwake,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.8",
            "verseOrgIds": [
              "PRO.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 13:8"
      },
      "items": [
        {
          "text": "asi murombo haana chinomutyisidzira.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.8",
            "verseOrgIds": [
              "PRO.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chiedza cheakarurama chinopenya kwazvo;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.9",
            "verseOrgIds": [
              "PRO.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 13:9"
      },
      "items": [
        {
          "text": "asi mwenje woakaipa uchadzimwa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.9",
            "verseOrgIds": [
              "PRO.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuzvikudza kunongouyisa kukakavara chete,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.10",
            "verseOrgIds": [
              "PRO.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 13:10"
      },
      "items": [
        {
          "text": "asi uchenjeri hunowanikwa mune avo vanogamuchira kurayirwa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.10",
            "verseOrgIds": [
              "PRO.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mari yakawanikwa zvisakarurama ichakurumidza kupera,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.11",
            "verseOrgIds": [
              "PRO.13.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 13:11"
      },
      "items": [
        {
          "text": "asi uyo anounganidza mari zvishoma nezvishoma achaita kuti iwande.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.11",
            "verseOrgIds": [
              "PRO.13.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tariro kana ichinonoka inoodza mwoyo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.12",
            "verseOrgIds": [
              "PRO.13.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 13:12"
      },
      "items": [
        {
          "text": "asi chishuvo chazadziswa muti woupenyu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.12",
            "verseOrgIds": [
              "PRO.13.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyo anozvidza kurayirwa achazozviripira izvozvo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.13",
            "verseOrgIds": [
              "PRO.13.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 13:13"
      },
      "items": [
        {
          "text": "asi uyo anokudza murayiro achawana mubayiro.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.13",
            "verseOrgIds": [
              "PRO.13.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kudzidzisa kwowakachenjera itsime roupenyu,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.14",
            "verseOrgIds": [
              "PRO.13.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 13:14"
      },
      "items": [
        {
          "text": "rinobvisa munhu pamusungo worufu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.14",
            "verseOrgIds": [
              "PRO.13.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunzwisisa kwakanaka kunowanisa nyasha,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.15",
            "verseOrgIds": [
              "PRO.13.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 13:15"
      },
      "items": [
        {
          "text": "asi nzira yavasina kutendeka ihukutu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.15",
            "verseOrgIds": [
              "PRO.13.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munhu wose akachenjera anoita zvinhu noruzivo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.16",
            "verseOrgIds": [
              "PRO.13.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 13:16"
      },
      "items": [
        {
          "text": "asi benzi rinoratidza upenzi hwaro.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.16",
            "verseOrgIds": [
              "PRO.13.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nhume yakaipa inowira munjodzi,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.17",
            "verseOrgIds": [
              "PRO.13.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 13:17"
      },
      "items": [
        {
          "text": "asi munyai akatendeka anouya nokuporesa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.17",
            "verseOrgIds": [
              "PRO.13.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
