              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muranda haarayirwi namashoko zvawo chete,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.19",
            "verseOrgIds": [
              "PRO.29.19"
