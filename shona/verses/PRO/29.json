      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:18"
      },
      "items": [
        {
          "text": "asi akaropafadzwa uyo anochengeta murayiro.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.18",
            "verseOrgIds": [
              "PRO.29.18"
