          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana munhu akaregerera muranda wake kubva paudiki,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.21",
            "verseOrgIds": [
              "PRO.29.21"
