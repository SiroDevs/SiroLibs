            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pasina chizaruro, vanhu vanoramba kuzvidzora;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.18",
            "verseOrgIds": [
              "PRO.29.18"
