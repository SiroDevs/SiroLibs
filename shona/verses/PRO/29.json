      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:20"
      },
      "items": [
        {
          "text": "Benzi rine tariro zhinji kupfuura iye.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.20",
            "verseOrgIds": [
              "PRO.29.20"
            ]
          }
        }
      ]
