      "attrs": {
        "style": "q2",
        "vid": "PRO 29:19"
      },
      "items": [
        {
          "text": "nokuti kunyange achinzwisisa, haangadaviri.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.19",
            "verseOrgIds": [
              "PRO.29.19"
            ]
          }
        }
      ]
