  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "PRO 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yambiro pamusoro poUpombwe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanakomana wangu, nyatsoteerera kuuchenjeri hwangu,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.1",
            "verseOrgIds": [
              "PRO.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 5:1"
      },
      "items": [
        {
          "text": "teereresa kumashoko angu oungwaru,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.1",
            "verseOrgIds": [
              "PRO.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuti ugare wakachengeta kungwara",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.2",
            "verseOrgIds": [
              "PRO.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 5:2"
      },
      "items": [
        {
          "text": "uye kuti miromo yako ichengetedze zivo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.2",
            "verseOrgIds": [
              "PRO.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti miromo yomukadzi chifeve inodonha uchi,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.3",
            "verseOrgIds": [
              "PRO.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 5:3"
      },
      "items": [
        {
          "text": "nomutauriro wake unotedza kupfuura mafuta;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.3",
            "verseOrgIds": [
              "PRO.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "asi pakupedzisira anovava senduru,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.4",
            "verseOrgIds": [
              "PRO.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 5:4"
      },
      "items": [
        {
          "text": "anopinza somunondo unocheka namativi ose.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.4",
            "verseOrgIds": [
              "PRO.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsoka dzake dzinoenda kurufu;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.5",
            "verseOrgIds": [
              "PRO.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 5:5"
      },
      "items": [
        {
          "text": "nhambwe dzake dzinonanga kuguva.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.5",
            "verseOrgIds": [
              "PRO.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haafungi pamusoro penzira youpenyu;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.6",
            "verseOrgIds": [
              "PRO.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 5:6"
      },
      "items": [
        {
          "text": "nzira dzake dzakaminama, asi iye haazvizivi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.6",
            "verseOrgIds": [
              "PRO.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka zvino, vanakomana vangu, nditeererei;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.7",
            "verseOrgIds": [
              "PRO.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 5:7"
      },
      "items": [
        {
          "text": "musatsauka pane zvandinotaura.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.7",
            "verseOrgIds": [
              "PRO.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fambai nenzira iri kure naye,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.8",
            "verseOrgIds": [
              "PRO.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 5:8"
      },
      "items": [
        {
          "text": "musasvika pedyo nomusuo wemba yake,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.8",
            "verseOrgIds": [
              "PRO.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuti murege kupa vamwe zvakanaka zvesimba renyu,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.9",
            "verseOrgIds": [
              "PRO.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 5:9"
      },
      "items": [
        {
          "text": "uye namakore enyu kuno uyo ane utsinye,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.9",
            "verseOrgIds": [
              "PRO.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuti vatorwa varege kudya upfumi hwenyu,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.10",
            "verseOrgIds": [
              "PRO.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 5:10"
      },
      "items": [
        {
          "text": "uye kushanda kwenyu nesimba kurege kupfumisa imba yomumwe munhu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.10",
            "verseOrgIds": [
              "PRO.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakupedzisira kwoupenyu hwako uchagomera,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.11",
            "verseOrgIds": [
              "PRO.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 5:11"
      },
      "items": [
        {
          "text": "kana nyama nomuviri wako zvaparadzwa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.11",
            "verseOrgIds": [
              "PRO.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uchazoti, \"Mavengero andaiita kurayirwa!",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.12",
            "verseOrgIds": [
              "PRO.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 5:12"
      },
      "items": [
        {
          "text": "Mashorero aiita mwoyo wangu kudzorwa!",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.12",
            "verseOrgIds": [
              "PRO.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakanga ndisingateereri vadzidzisi vangu,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.13",
            "verseOrgIds": [
              "PRO.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 5:13"
      },
      "items": [
        {
          "text": "kana kunzwa varairidzi vangu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.13",
            "verseOrgIds": [
              "PRO.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndasvika pakuparara chaiko",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.14",
            "verseOrgIds": [
              "PRO.5.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 5:14"
      },
      "items": [
        {
          "text": "pakati peungano yose.\"",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.14",
            "verseOrgIds": [
              "PRO.5.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inwa mvura pachirongo chako chaicho,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.15",
            "verseOrgIds": [
              "PRO.5.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 5:15"
      },
      "items": [
        {
          "text": "mvura inoerera patsime rako chairo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.15",
            "verseOrgIds": [
              "PRO.5.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ko, zvitubu zvako zvinofanira kuerera mumigwagwa here;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.16",
            "verseOrgIds": [
              "PRO.5.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 5:16"
      },
      "items": [
        {
          "text": "nzizi dzako dzemvura pazvivara?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.16",
            "verseOrgIds": [
              "PRO.5.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngadzive dzako woga,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.17",
            "verseOrgIds": [
              "PRO.5.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 5:17"
      },
      "items": [
        {
          "text": "hadzitombofaniri kugoveranwa navatorwa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.17",
            "verseOrgIds": [
              "PRO.5.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PRO 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsime rako ngariropafadzwe,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.18",
            "verseOrgIds": [
              "PRO.5.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 5:18"
      },
      "items": [
        {
          "text": "uye ufadzwe nomudzimai woujaya hwako.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.18",
            "verseOrgIds": [
              "PRO.5.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PRO 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sehadzi yengururu inofadza, nehadzi yenondo yakanaka,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.19",
            "verseOrgIds": [
              "PRO.5.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 5:19"
      },
      "items": [
        {
          "text": "mazamu ake ngaakufadze nguva dzose,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.19",
            "verseOrgIds": [
              "PRO.5.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
