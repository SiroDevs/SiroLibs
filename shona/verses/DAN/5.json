        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ruoko Runonyora paMadziro",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DAN 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo Bherishazari akaitira makurukota chiuru mabiko makuru akanwa waini pamwe chete navo.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.1",
            "verseOrgIds": [
              "DAN.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DAN 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bherishazari achiri kunwa waini yake, akarayira kuti vauyise midziyo yegoridhe neyesirivha iya yakanga yatorwa nababa vake Nebhukadhinezari kubva kutemberi yokuJerusarema, kuitira kuti mambo namakurukota ake, navakadzi vake uye navarongo vake vanwiremo.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.2",
            "verseOrgIds": [
              "DAN.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DAN 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka vakauyisa midziyo yegoridhe yakanga yatorwa mutemberi yaMwari muJerusarema, uye mambo namakurukota ake, vakadzi vake navarongo vake vakanwira mairi.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.3",
            "verseOrgIds": [
              "DAN.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DAN 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pavakanga vachinwa waini, vakarumbidza vamwari vegoridhe, vesirivha, vendarira, vesimbi, vamatanda nevamabwe.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.4",
            "verseOrgIds": [
              "DAN.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DAN 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakarepo minwe yoruoko rwomunhu yakaonekwa ikanyora pamadziro akanamwa, pedyo napachigadziko chomwenje mumuzinda wamambo. Mambo akatarisa chanza pachakanga chichinyora.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.5",
            "verseOrgIds": [
              "DAN.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DAN 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chiso chake chakashanduka akatsvukuruka uye akavhunduka zvikuru, mabvi ake akadedera uye makumbo ake akarukutika.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.6",
            "verseOrgIds": [
              "DAN.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DAN 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo akadana vaya vamazango, vazivi vezvenyeredzi navavuki kuti vaunzwe ndokuti kuvarume ava vakachenjera veBhabhironi, \"Ani naani anoverenga runyoro urwo uye akanditaurira zvarunoreva achapfekedzwa nguo dzepepuru uye nouketani hwegoridhe mumutsipa wake, uye achaitwa mutongi wapamusoro-soro wechitatu muumambo.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.7",
            "verseOrgIds": [
              "DAN.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DAN 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo vakachenjera vose vamambo vakapinda, asi havana kugona kuverenga runyoro kana kutaurira mambo zvarwaireva.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.8",
            "verseOrgIds": [
              "DAN.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DAN 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Mambo Bherishazari akanyanya kutya uye uso hwake hukanyanya kutsvukuruka. Makurukota ake akakanganisika.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.9",
            "verseOrgIds": [
              "DAN.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DAN 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambokadzi akati achinzwa inzwi ramambo namakurukota ake, akauya muimba yaiitirwa mabiko, akati, \"Imi mambo, raramai nokusingaperi! Musatya! Regai kutsvukuruka kuuso kwenyu!",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.10",
            "verseOrgIds": [
              "DAN.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DAN 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muumambo hwenyu muno murume ano mweya wavamwari vatsvene maari. Panguva yababa venyu iye akawanikwa achigona zviri mberi nezivo nouchenjeri hwakafanana nohwavamwari. Mambo Nebhukadhinezari baba venyu, ndati baba venyu imi mambo, vakamugadza kuti ave mukuru wenʼanga, nowevamazango, vazivi vezvenyeredzi navavuki.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.11",
            "verseOrgIds": [
              "DAN.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DAN 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Murume uyu Dhanieri, iye akatumidzwa zita rokuti Bheriteshazari namambo, akawanikwa aine pfungwa dzine shungu nezivo uye ano kunzwisisa, kugona kududzira kurota, nokutsanangura zvirahwe uye nokupedza matambudziko akaoma. Daidzai Dhanieri, uye iyeye achakuudzai zvinoreva runyoro.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.12",
            "verseOrgIds": [
              "DAN.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DAN 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Dhanieri akauyiswa pamberi pamambo, mambo akati kwaari, \"Ndiwe Dhanieri mumwe wavakatapwa nababa vangu mambo kubva kuJudha here?",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.13",
            "verseOrgIds": [
              "DAN.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DAN 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndanzwa kuti mweya wavamwari uri mauri uye kuti unoona zviri mberi, une zivo nouchenjeri hwapamusoro.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.14",
            "verseOrgIds": [
              "DAN.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DAN 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vachenjeri nevamazango vakauyiswa pamberi pangu kuti vazoverenga runyoro urwu uye vagondiudza zvarunoreva, asi havana kugona kunditsanangurira.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.15",
            "verseOrgIds": [
              "DAN.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DAN 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino ndanzwa kuti unogona kupa dudziro uye unopedza matambudziko akaoma. Kana ukagona kuverenga runyoro uye ukanditaurira zvarunoreva, uchapfekedzwa nguo yepepuru, uchaiswa uketani hwegoridhe pamutsipa wako, uye uchaitwa mutongi wechitatu wapamusoro-soro muumambo.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.16",
            "verseOrgIds": [
              "DAN.5.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DAN 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Dhanieri akapindura mambo achiti, \"Zvichengeterei henyu zvipo zvenyu uye mugopa mibayiro yenyu kuno mumwe. Kunyange zvakadaro, ndichaverengera mambo runyoro ndigomuudza zvarunoreva.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.17",
            "verseOrgIds": [
              "DAN.5.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DAN 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Haiwa mambo, Mwari Wokumusoro-soro akapa baba venyu Nebhukadhinezari ushe, ukuru, kukudzwa nokubwinya.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.18",
            "verseOrgIds": [
              "DAN.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DAN 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuda kwechinzvimbo chakakwirira chaakamupa, vanhu vose nendudzi dzose navanhu vemitauro yose vakadedera uye vakamutya. Avo vaaida kuuraya, aiuraya, avo vaaida kuraramisa, airaramisa; avo vaaida kusimudzira, aisimudzira; uye avo vaaida kuninipisa, aininipisa.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.19",
            "verseOrgIds": [
              "DAN.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DAN 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi mwoyo wake wakati wazvikudza uye waomeswa nokuzvikudza, akabviswa pachigaro chake choushe vakamutorera kukudzwa kwake.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.20",
            "verseOrgIds": [
              "DAN.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DAN 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akadzingwa pakati pavanhu akapiwa pfungwa yemhuka; akagara pakati pembizi akadya uswa semombe; uye muviri wake ukanyoroveswa nedova rokudenga, kusvikira aziva kuti Mwari Wokumusoro-soro ndiye ishe pamusoro poushe hwavanhu uye kuti anogadza pamusoro pavo ani zvake waanoda.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.21",
            "verseOrgIds": [
              "DAN.5.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DAN 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Asi imi mwanakomana wake, imi Bherishazari, hamuna kuzvininipisa, kunyange maiziva henyu chinhu ichi.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.22",
            "verseOrgIds": [
              "DAN.5.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DAN 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamusoro pezvo imi masarudza kurwa naIshe wokudenga. Maita kuti midziyo yegoridhe iuyiswe kwamuri ichibva kutemberi, uye imi namakurukota enyu, vakadzi venyu navarongo venyu manwira waini mairi. Marumbidza vamwari vesirivha, vegoridhe, vendarira, vesimbi, vamatanda nevamabwe, vasingagoni kuona, kunzwa kana kunzwisisa. Asi hamuna kukudza Mwari akabata muruoko rwake upenyu hwenyu nenzira dzenyu dzose.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.23",
            "verseOrgIds": [
              "DAN.5.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DAN 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo akatumira ruoko rwakanyora zvakanyorwa.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.24",
            "verseOrgIds": [
              "DAN.5.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DAN 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Izvi ndizvo zvakanyorwa:",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.25",
            "verseOrgIds": [
              "DAN.5.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pc",
        "vid": "DAN 5:25"
      },
      "items": [
        {
          "text": "mene, mene, tekere, ufasini.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.25",
            "verseOrgIds": [
              "DAN.5.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DAN 5:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Hezvino zvinoreva mashoko aya:",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.26",
            "verseOrgIds": [
              "DAN.5.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "DAN 5:26"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "DAN 5:26"
      },
      "items": [
        {
          "text": "\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.26",
            "verseOrgIds": [
              "DAN.5.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "tl"
          },
          "items": [
            {
              "text": "Mene",
              "type": "text",
              "attrs": {
                "verseId": "DAN.5.26",
                "verseOrgIds": [
                  "DAN.5.26"
                ]
              }
            }
          ]
        },
        {
          "text": ": Mwari akaverenga mazuva okutonga kwenyu akaagumisa.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.26",
            "verseOrgIds": [
              "DAN.5.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
