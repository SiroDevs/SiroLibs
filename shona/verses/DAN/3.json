  "verseCount": 30,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "DAN 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Chifananidzo cheGoridhe neVira roMoto",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DAN 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo Nebhukadhinezari akaita chifananidzo chegoridhe, chakanga chakareba makubhiti makumi matanhatu",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.1",
            "verseOrgIds": [
              "DAN.3.1"
            ]
          }
        },
        {
          "text": "uye makubhiti matanhatu",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.1",
            "verseOrgIds": [
              "DAN.3.1"
            ]
          }
        },
        {
          "text": "paupamhi, akachimisa pabani reDhura munyika yeBhabhironi.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.1",
            "verseOrgIds": [
              "DAN.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DAN 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akadana machinda, varayiri, madzishe, vapi vamazano, vachengeti vepfuma, vatongi vedzimhosva vakuru, vatongi vedzimhosva vadiki navamwe vabati vose vamatunhu kuti vauye kuzokumikidza chifananidzo chaakanga amisa.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.2",
            "verseOrgIds": [
              "DAN.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DAN 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka machinda, varayiri, madzishe, vapi vamazano, vachengeti vepfuma, vatongi, navatongi vedzimhosva navamwe vabati vose vamatunhu vakaungana kuti vakumikidze chifananidzo chakanga chamiswa naMambo Nebhukadhinezari, vakamira pamberi pacho.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.3",
            "verseOrgIds": [
              "DAN.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DAN 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo mushamarari akadanidzira zvikuru achiti, \"Izvi ndizvo zvamunorayirwa kuti muite, imi vanhu, nemi ndudzi nemi vanhu vemitauro yose:",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.4",
            "verseOrgIds": [
              "DAN.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DAN 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamunongonzwa kurira kwehwamanda, nyere, mutopota, rudimbwa, mbira, mabhosvo nemhando dzose dzezviridzwa, munofanira kuwira pasi mugonamata chifananidzo chegoridhe chakamiswa naMambo Nebhukadhinezari.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.5",
            "verseOrgIds": [
              "DAN.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DAN 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani naani asingawiri pasi achinamata achakandwa muvira romoto pakarepo.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.6",
            "verseOrgIds": [
              "DAN.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DAN 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo, pavakangonzwa kurira kwehwamanda, nyere, mutopota, rudimbwa, mbira nemhando dzose dzezviridzwa, vanhu vose, nendudzi dzose navanhu vemitauro yose vakawira pasi ndokunamata chifananidzo chegoridhe chakanga chamiswa naMambo Nebhukadhinezari.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.7",
            "verseOrgIds": [
              "DAN.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DAN 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panguva iyi vamwe voruzivo nezvenyeredzi vakauya pamberi vakatuka vaJudha.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.8",
            "verseOrgIds": [
              "DAN.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DAN 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakati kuna Mambo Nebhukadhinezari, \"Imi mambo, raramai nokusingaperi!",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.9",
            "verseOrgIds": [
              "DAN.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DAN 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makatema chirevo imi mambo, kuti ani naani anonzwa kurira kwehwamanda, nenyere, nomutopota, norudimbwa, nembira namabhosvo uye nemhando dzose dzezviridzwa, anofanira kuwira pasi anamate chifananidzo chegoridhe,",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.10",
            "verseOrgIds": [
              "DAN.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DAN 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye kuti ani naani asingawiri pasi akanamata achakandwa muvira romoto.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.11",
            "verseOrgIds": [
              "DAN.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DAN 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi pane vamwe vaJudha vamakagadza pamusoro pamabasa enyika yeBhabhironi, Shadhireki, Meshaki naAbhedhinego, vasingatomboteereri imi mambo. Havamboshumiri vamwari venyu kana kunamata chifananidzo chegoridhe chamakamisa.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.12",
            "verseOrgIds": [
              "DAN.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DAN 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebhukadhinezari azere nehasha, akarayira kuti Shadhireki, Meshaki naAbhedhinego vauye. Saka varume ava vakauyiswa pamberi pamambo,",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.13",
            "verseOrgIds": [
              "DAN.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DAN 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebhukadhinezari akati kwavari, \"Ichokwadi here, imi vanaShadhireki, Meshaki naAbhedhinego, kuti hamusi kushumira vamwari vangu kana kunamata chifananidzo chegoridhe chandakamisa?",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.14",
            "verseOrgIds": [
              "DAN.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DAN 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino pamunonzwa kurira kwehwamanda, nyere, mutopota, rudimbwa, mabhosvo nemhando dzose dzezviridzwa, kana mukagadzirira kuwira pasi, mukanamata chifananidzo chandakaita, zvakanaka hazvo. Asi kana musingachinamati, muchakandwa mumoto pakarepo. Zvino mwari achakurwirai muruoko rwangu ndoupiko?\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.15",
            "verseOrgIds": [
              "DAN.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DAN 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shadhireki, Meshaki naAbhedhinego vakapindura mambo vakati, \"Imi Nebhukadhinezari, isu hatifaniri kuzvirwira pamberi penyu pamusoro penyaya iyi.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.16",
            "verseOrgIds": [
              "DAN.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DAN 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana tikakandwa mumoto unopfuta, Mwari watinoshumira anogona kutiponesa pauri, uye achatirwira paruoko rwenyu, imi mambo.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.17",
            "verseOrgIds": [
              "DAN.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DAN 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi kunyange dai akasatirwira, tinoda kuti muzive, imi mambo, kuti hatizoshumiri vamwari venyu kana kunamata chifananidzo chegoridhe chamakamisa.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.18",
            "verseOrgIds": [
              "DAN.3.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DAN 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Nebhukadhinezari akashatirwa nokuda kwaShadhireki, Meshaki naAbhedhinego, chiso chake chikavashandukira. Akarayira kuti vira romoto riveserwe moto unopisa kwazvo kukunda unosiveserwamo kanomwe.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.19",
            "verseOrgIds": [
              "DAN.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DAN 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye akarayira vamwe vavarwi vehondo yake vakasimba kwazvo kuti vasunge Shadhireki naMeshaki naAbhedhinego vavakande mumoto uyu waipfuta kwazvo.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.20",
            "verseOrgIds": [
              "DAN.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DAN 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka varume ava, vakapfeka nguo dzavo, namabhurugwa avo, nenguwani dzavo nedzimwe hembe, vakasungwa ndokukandwa mumoto waipfuta kwazvo.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.21",
            "verseOrgIds": [
              "DAN.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DAN 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kurayira kwamambo kwakava nechimbi chimbi kwazvo uye choto chaipisa kwazvo zvokuti moto wakauraya varwi vakakanda Shadhireki, Meshaki naAbhedhinego,",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.22",
            "verseOrgIds": [
              "DAN.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DAN 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye varume vatatu ava vakasungwa zvakasimba, vakawira mumoto unopfuta kwazvo.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.23",
            "verseOrgIds": [
              "DAN.3.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DAN 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Mambo Nebhukadhinezari akasvetuka achishamisika kwazvo ndokubvunza vanamupamazano vake achiti, \"Ko, havasi varume vatatu vatasunga tikakanda mumoto here?\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.24",
            "verseOrgIds": [
              "DAN.3.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "DAN 3:24"
      },
      "items": [
        {
          "text": "Vakamupindura vachiti, \"Ndizvozvo mambo.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.24",
            "verseOrgIds": [
              "DAN.3.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DAN 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye akati, \"Tarirai! Ndiri kuona vanhu vana vachifamba-famba mumoto, vasina kusungwa uye vasina kutsva, uye wechina anoratidzika somwanakomana wavamwari.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.25",
            "verseOrgIds": [
              "DAN.3.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DAN 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Nebhukadhinezari akaswedera kumuromo wechoto chomoto waipfuta kwazvo akadanidzira akati, \"Shadhireki, newe Meshaki naAbhedhinego, imi varanda vaMwari Wokumusoro-soro, budai. Uyai pano!\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.26",
            "verseOrgIds": [
              "DAN.3.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "DAN 3:26"
      },
      "items": [
        {
          "text": "Saka Shadhireki, Meshaki naAbhedhinego vakabuda mumoto,",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.26",
            "verseOrgIds": [
              "DAN.3.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DAN 3:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye machinda, varayiri, vabati navanamupamazano vamambo vakavaunganira. Vakaona kuti moto wakanga usina kumbokuvadza miviri yavo, uye nebvudzi remisoro yavo harina kumbotsva; uye nguo dzavo hadzina kutsva, uye pakanga pasina kunhuhwa kwomoto pavari.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.27",
            "verseOrgIds": [
              "DAN.3.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DAN 3:28"
          },
          "items": [
            {
