  "verseCount": 49,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "DAN 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kurota kwaNebhukadhinezari",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DAN 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mugore rechipiri rokutonga kwake, Nebhukadhinezari akarota hope; pfungwa dzake dzikashushikana uye akashaya hope.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.1",
            "verseOrgIds": [
              "DAN.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DAN 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka mambo akarayira nʼanga, navanofarira mazango, navaroyi, navafemberi vezvenyeredzi kuti vamuudze zvaakanga arota. Vakati vapinda vakamira pamberi pamambo,",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.2",
            "verseOrgIds": [
              "DAN.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DAN 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "iye akati kwavari, \"Ndakarota hope dzinonditambudza zvino ndinoda kuziva zvadzinoreva.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.3",
            "verseOrgIds": [
              "DAN.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DAN 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo vachenjeri vezvenyeredzi vakapindura mambo norurimi rwavaAramu vachiti, \"Haiwa mambo, raramai nokusingaperi! Udzai varanda venyu kurota kwenyu, isu tigodudzira.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.4",
            "verseOrgIds": [
              "DAN.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DAN 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo akapindura vachenjeri vezvenyeredzi achiti, \"Izvi ndizvo zvandafunga chaizvoizvo: Kana imi mukasandiudza kuti kurota kwangu kwaiva kupi uye mukadudzira, ndichaita kuti mugurwe-gurwe uye dzimba dzenyu dziitwe mirwi yamarara.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.5",
            "verseOrgIds": [
              "DAN.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DAN 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi kana mukandiudza zvandakarota mukazvidudzira, muchagamuchira zvipo nemibayiro nokukudzwa kukuru zvinobva kwandiri. Saka ndiudzei chiroto mugochidudzira kwandiri.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.6",
            "verseOrgIds": [
              "DAN.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DAN 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivo vakapindurazve vachiti, \"Mambo ngaaudze varanda vake chiroto, uye isu tichachidudzira.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.7",
            "verseOrgIds": [
              "DAN.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DAN 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo mambo akapindura akati, \"Ndinoziva kwazvo kuti imi munongoda kuwedzera nguva, nokuti munoziva kuti izvi ndizvo zvandatema:",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.8",
            "verseOrgIds": [
              "DAN.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DAN 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana musingandiudzi zvandarota, panongova nechirango chimwe chete. Imi makarangana kundiudza zvinhu zvinonyengera uye zvakaipa, muchifunga kuti zvinhu zvichashanduka. Saka zvino, ndiudzei zvandakarota, ndigoziva kuti muchagona kundidudzira chiroto.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.9",
            "verseOrgIds": [
              "DAN.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DAN 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vachenjeri vezvenyeredzi vakapindura mambo vachiti, \"Hakuna munhu panyika angagona kuita zvinodiwa namambo! Hakuna mambo, kunyange mukuru kana ane simba, akambotsvaka chinhu chakadai kunʼanga ipi zvayo kana vaya vanoita zvamazango kana vachenjeri vezvenyeredzi.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.10",
            "verseOrgIds": [
              "DAN.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DAN 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvinhu zvinodikanwa namambo zvakaoma kwazvo. Hakuna munhu angazvizivisa kuna mambo izvozvo kunze kwavamwari, uye vasingagari pakati pavanhu.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.11",
            "verseOrgIds": [
              "DAN.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DAN 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izvi zvakaita kuti mambo ashatirwe zvikuru uye akava nehasha zvokuti akarayira kuti vakachenjera vose veBhabhironi vaurayiwe.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.12",
            "verseOrgIds": [
              "DAN.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DAN 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka chirevo chakapiwa kuti vachenjeri vaurayiwe, uye varume vakatumwa kundotsvaka Dhanieri neshamwari dzake kuti vaurayiwewo.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.13",
            "verseOrgIds": [
              "DAN.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DAN 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arioki, mukuru wavarindi vamambo, akati abudisa kundouraya vachenjeri veBhabhironi, Dhanieri akataura kwaari nouchenjeri uye nokungwara.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.14",
            "verseOrgIds": [
              "DAN.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DAN 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akabvunza muchinda wamambo achiti, \"Seiko mambo akatema chirevo chakadai?\" Arioki akatsanangurira Dhanieri nyaya yacho.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.15",
            "verseOrgIds": [
              "DAN.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DAN 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokudaro, Dhanieri akapinda kuna mambo akandokumbira nguva kwaari, kuitira kuti agomududzira chiroto chiya.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.16",
            "verseOrgIds": [
              "DAN.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DAN 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Dhanieri akadzokera kumba kwake akandotsanangurira nyaya yacho kushamwari dzake vanaHanania, Mishaeri naAzaria.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.17",
            "verseOrgIds": [
              "DAN.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DAN 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akavakurudzira kuti vakumbire nyasha kubva kuna Mwari wokudenga pamusoro pechakavanzika ichi, kuitira kuti iye neshamwari dzake varege kuurayiwa pamwe chete navakachenjera veBhabhironi.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.18",
            "verseOrgIds": [
              "DAN.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DAN 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chakavanzika ichi chakazoratidzwa kuna Dhanieri usiku muchiratidzo. Ipapo Dhanieri akarumbidza Mwari wokudenga",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.19",
            "verseOrgIds": [
              "DAN.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DAN 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "akati:",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.20",
            "verseOrgIds": [
              "DAN.2.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "DAN 2:20"
      },
      "items": [
        {
          "text": "\"Zita raMwari ngarirumbidzwe nokusingaperi-peri;",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.20",
            "verseOrgIds": [
              "DAN.2.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "DAN 2:20"
      },
      "items": [
        {
          "text": "uchenjeri nesimba ndezvake.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.20",
            "verseOrgIds": [
              "DAN.2.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DAN 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anoshandura nguva nemwaka;",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.21",
            "verseOrgIds": [
              "DAN.2.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "DAN 2:21"
      },
      "items": [
        {
          "text": "ndiye anogadza madzimambo uye ndiye anoabvisa.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.21",
            "verseOrgIds": [
              "DAN.2.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "DAN 2:21"
      },
      "items": [
        {
          "text": "Anopa uchenjeri kuna vakachenjera",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.21",
            "verseOrgIds": [
              "DAN.2.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "DAN 2:21"
      },
      "items": [
        {
          "text": "nezivo kuna vanonzvera.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.21",
            "verseOrgIds": [
              "DAN.2.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DAN 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anozarura zvakadzika nezvakavanzika;",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.22",
            "verseOrgIds": [
              "DAN.2.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "DAN 2:22"
      },
      "items": [
        {
          "text": "anoziva zviri murima,",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.22",
            "verseOrgIds": [
              "DAN.2.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "DAN 2:22"
      },
      "items": [
        {
          "text": "uye chiedza chinogara maari.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.22",
            "verseOrgIds": [
              "DAN.2.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DAN 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinokuvongai uye ndinokurumbidzai, imi Mwari wamadzibaba angu:",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.23",
            "verseOrgIds": [
              "DAN.2.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "DAN 2:23"
      },
      "items": [
        {
          "text": "Makandipa uchenjeri nesimba,",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.23",
            "verseOrgIds": [
              "DAN.2.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "DAN 2:23"
      },
      "items": [
        {
          "text": "makandizivisa zvatakakumbira kwamuri,",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.23",
            "verseOrgIds": [
              "DAN.2.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "DAN 2:23"
      },
      "items": [
        {
          "text": "makazivisa kwatiri kurota kwamambo.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.23",
            "verseOrgIds": [
              "DAN.2.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Dhanieri anodudzira Chiroto",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DAN 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Dhanieri akaenda kuna Arioki, uya akanga agadzwa namambo kuti auraye varume vakachenjera veBhabhironi, akati kwaari, \"Musauraya vachenjeri veBhabhironi. Ndiendesei kuna mambo, ndinomududzira zvaakarota.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.24",
            "verseOrgIds": [
              "DAN.2.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DAN 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arioki akaenda naDhanieri kuna mambo nokukurumidza uye akati kwaari, \"Ndawana munhu pakati pavakatapwa vokwaJudha anogona kuudza mambo zvinoreva chiroto chavo.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.25",
            "verseOrgIds": [
              "DAN.2.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DAN 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo akabvunza Dhanieri (iye ainziwo Bheriteshazari), \"Iwe unogona here kundiudza zvandakaona pakurota uye ugozvidudzira?\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.26",
            "verseOrgIds": [
              "DAN.2.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DAN 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhanieri akapindura akati, \"Hakuna munhu akachenjera, kana wamazango, kana nʼanga kana mufemberi angagona kurondedzera kuna mambo chakavanzika chaanobvunza pamusoro pacho",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.27",
            "verseOrgIds": [
              "DAN.2.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DAN 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "asi kudenga kuna Mwari anozivisa zvakavanzika. Iye akaratidza Mambo Nebhukadhinezari zvichaitika mumazuva anouya. Kurota kwenyu nezviratidzo zvakaratidzwa mundangariro dzenyu muvete pamubhedha ndezvizvi:",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.28",
            "verseOrgIds": [
              "DAN.2.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DAN 2:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Pamakanga muvete ipapo, imi mambo, pfungwa dzenyu dzakaenda kuzvinhu zvichauya, uye muzivisi wezvakavanzika akakuratidzai zvichaitika.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.29",
            "verseOrgIds": [
              "DAN.2.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "DAN 2:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi ini chakavanzika ichi chakaziviswa kwandiri, kwete nokuda kwokuti ndine njere huru kupfuura vamwe vanhu vanorarama asi kuti imi mambo, mugoziva dudziro uye kuti mugonzwisisa zvakapinda mundangariro dzenyu.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.30",
            "verseOrgIds": [
              "DAN.2.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "DAN 2:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Imi mambo, makatarira, uye ipapo pamberi penyu pakanga pamire chifananidzo, chakakura kwazvo, chaibwinya, chaityisa pakuonekwa kwacho.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.31",
            "verseOrgIds": [
              "DAN.2.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "DAN 2:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musoro wechifananidzo ichi wakanga wakaitwa negoridhe rakanatswa, chipfuva chacho namaoko zvakanga zviri zvesirivha; dumbu racho nezvidyiro zvaiva zvendarira,",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.32",
            "verseOrgIds": [
              "DAN.2.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "DAN 2:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "makumbo acho akanga ari esimbi, tsoka dzacho dzaiti pamwe simbi pamwe ivhu.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.33",
            "verseOrgIds": [
              "DAN.2.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "DAN 2:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muchakatarisa, makaona ibwe richivezwa, asi kwete namaoko omunhu. Rakarova chifananidzo patsoka dzacho dzesimbi nevhu ndokuzvipwanya.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.34",
            "verseOrgIds": [
              "DAN.2.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "DAN 2:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo simbi, ivhu, ndarira, sirivha, negoridhe zvakaputsanyiwa nenguva imwe cheteyo zvikaita sehundi iri paburiro panguva yechirimo. Mhepo yakazvikukura pakasava nechinhu chakasara. Asi ibwe riya rakarova chifananidzo rakazova gomo guru rikazadza nyika yose.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.35",
            "verseOrgIds": [
              "DAN.2.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "DAN 2:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Uku ndiko kwaiva kurota kwenyu, uye zvino tichakududzira kwamuri mambo.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.36",
            "verseOrgIds": [
              "DAN.2.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "DAN 2:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imi mambo, muri mambo wamadzimambo. Mwari wokudenga akakupai ushe nesimba noukuru nokubwinya,",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.37",
            "verseOrgIds": [
              "DAN.2.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "DAN 2:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "akaisa marudzi avanhu mumaoko enyu nezvikara zvenyika neshiri dzedenga. Akakuitai mutongi pamusoro pazvo, pose pazvinogara. Ndimi musoro uya wegoridhe.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.38",
            "verseOrgIds": [
              "DAN.2.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "DAN 2:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Shure kwenyu, humwe umambo huchamuka, hudiki kuno hwenyu. Umambo hwechitatu huchatevera, umambo hwendarira, huchatonga pamusoro penyika yose.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.39",
            "verseOrgIds": [
              "DAN.2.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "DAN 2:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakupedzisira kuchava noushe hwechina, hwakasimba sesimbi, nokuti simbi inopwanya uye inoputsanya zvinhu zvose, uye sokuputsanya kunoita simbi zvinhu, saizvozvo huchapwanya uye hugoputsanya humwe hwose.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.40",
            "verseOrgIds": [
              "DAN.2.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "DAN 2:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sezvamakaona kuti tsoka nezvigunwe zvakanga zvakavhenganiswa ivhu nesimbi, saizvozvo umambo uhu huchava hwakaganhurwa, asi huchava nerimwe simba resimbi mahuri, sezvamakaona simbi yakavhenganiswa nevhu.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.41",
            "verseOrgIds": [
              "DAN.2.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "DAN 2:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sezvo zvigunwe zvakanga zvakati pamwe simbi pamwe ivhu, saizvozvo umambo uhu huchava hwakasimba kuno rumwe rutivi uye husina kusimba kuno rumwe rutivi.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.42",
            "verseOrgIds": [
              "DAN.2.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "DAN 2:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye sezvamakaona simbi yakavhenganiswa nevhu, saizvozvo vanhu vachavhengana uye havangarambi vakabatana, sezvinoita ivhu nesimbi zvakavhengana.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.43",
            "verseOrgIds": [
              "DAN.2.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "DAN 2:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mumazuva amadzimambo ayo, Mwari wokudenga achagadza ushe husingazoparadzwi, uye hahungazombosiyirwi vamwe vanhu. Huchapwanya ushe hwose hugohugumisa, asi ihwo huchagara nokusingaperi.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.44",
            "verseOrgIds": [
              "DAN.2.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "DAN 2:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izvi ndizvo zvinoreva chiratidzo chedombo rakavezwa pagomo, asi kwete namaoko omunhu, dombo rakaputsa simbi, ndarira, ivhu, sirivha negoridhe zvikati mwarara.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.45",
            "verseOrgIds": [
              "DAN.2.45"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "DAN 2:45"
      },
      "items": [
        {
          "text": "\"Mwari mukuru akaratidza mambo zvichaitika pamazuva anouya. Kurota uku ndokwechokwadi uye nedudziro yacho ndeyechokwadi.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.45",
            "verseOrgIds": [
              "DAN.2.45"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "DAN 2:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo mambo Nebhukadhinezari akawira pasi nechiso chake pamberi paDhanieri akamuremekedza akarayira kuti apiwe chipo nezvinonhuhwira.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.46",
            "verseOrgIds": [
              "DAN.2.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "DAN 2:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo akati kuna Dhanieri, \"Zvirokwazvo Mwari wako ndiMwari wavamwari naIshe wamadzimambo uye nomuzivisi wezvakavanzika, nokuti iwe wakagona kuzivisa chakavanzika ichi.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.47",
            "verseOrgIds": [
              "DAN.2.47"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "DAN 2:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo mambo akaisa Dhanieri pachinzvimbo chakakwirira akapa zvipo zvizhinji kwaari. Akamuita mutongi pamusoro penyika yose yeBhabhironi akamuita mukuru wavachenjeri vose.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.48",
            "verseOrgIds": [
              "DAN.2.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "DAN 2:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamusoro paizvozvo, Dhanieri akakumbira mambo kuti agadze vanaShadhireki, Meshaki naAbhedhinego kuti vave vatariri vamatunhu eBhabhironi, iye Dhanieri pachake achiramba ari paruvazhe rwamambo.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.49",
            "verseOrgIds": [
              "DAN.2.49"
            ]
          }
        }
      ]
    }
  ],
