        "sid": "SNG 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "Murume",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "SNG 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndauya zvangu mubindu rangu, hanzvadzi yangu, iwe mwenga wangu;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.1",
            "verseOrgIds": [
              "SNG.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:1"
      },
      "items": [
        {
          "text": "ndaunganidza mura yangu pamwe chete nezvinonhuhwira zvangu.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.1",
            "verseOrgIds": [
              "SNG.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 5:1"
      },
      "items": [
        {
          "text": "Ndadya zinga rangu rouchi nouchi hwangu;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.1",
            "verseOrgIds": [
              "SNG.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:1"
      },
      "items": [
        {
          "text": "ndanwa waini yangu nomukaka wangu.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.1",
            "verseOrgIds": [
              "SNG.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp",
        "vid": "SNG 5:1"
      },
      "items": [
        {
          "text": "Shamwari",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 5:1"
      },
      "items": [
        {
          "text": "Idyai, imi shamwari, uye munwe;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.1",
            "verseOrgIds": [
              "SNG.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:1"
      },
      "items": [
        {
          "text": "inwai mugute, imi vanodanana.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.1",
            "verseOrgIds": [
              "SNG.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "Mukadzi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "SNG 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakavata asi mwoyo wangu wakanga wakasvinura.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.2",
            "verseOrgIds": [
              "SNG.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:2"
      },
      "items": [
        {
          "text": "Inzwai! Mudiwa wangu ari kugogodza, achiti,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.2",
            "verseOrgIds": [
              "SNG.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 5:2"
      },
      "items": [
        {
          "text": "\"Ndizarurire, hanzvadzi yangu, mudiwa wangu,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.2",
            "verseOrgIds": [
              "SNG.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:2"
      },
      "items": [
        {
          "text": "njiva yangu, wangu asina chinongo.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.2",
            "verseOrgIds": [
              "SNG.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 5:2"
      },
      "items": [
        {
          "text": "Musoro wangu wanyorova nedova,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.2",
            "verseOrgIds": [
              "SNG.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:2"
      },
      "items": [
        {
          "text": "bvudzi rangu ranyoroveswa nounyoro hweusiku.\"",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.2",
            "verseOrgIds": [
              "SNG.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "SNG 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndabvisa nguo yangu,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.3",
            "verseOrgIds": [
              "SNG.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:3"
      },
      "items": [
        {
          "text": "ndoipfekazve here?",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.3",
            "verseOrgIds": [
              "SNG.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 5:3"
      },
      "items": [
        {
          "text": "Ndashambidza tsoka dzangu,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.3",
            "verseOrgIds": [
              "SNG.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:3"
      },
      "items": [
        {
          "text": "ndodzisvibisazve here?",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.3",
            "verseOrgIds": [
              "SNG.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "SNG 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mudiwa wangu akapinza ruoko rwake nepahwangwadza yomukova;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.4",
            "verseOrgIds": [
              "SNG.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:4"
      },
      "items": [
        {
          "text": "mwoyo wangu wakatanga kumudokwairira.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.4",
            "verseOrgIds": [
              "SNG.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "SNG 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakasimuka kuti ndizarurire mudiwa wangu,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.5",
            "verseOrgIds": [
              "SNG.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:5"
      },
      "items": [
        {
          "text": "maoko angu akadonha mura,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.5",
            "verseOrgIds": [
              "SNG.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 5:5"
      },
      "items": [
        {
          "text": "mimwe yangu ichiyerera mura,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.5",
            "verseOrgIds": [
              "SNG.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:5"
      },
      "items": [
        {
          "text": "pazvibato zvechizarira.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.5",
            "verseOrgIds": [
              "SNG.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "SNG 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakazarurira mudiwa wangu,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.6",
            "verseOrgIds": [
              "SNG.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:6"
      },
      "items": [
        {
          "text": "asi mudiwa wangu akanga abva; akanga atoenda.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.6",
            "verseOrgIds": [
              "SNG.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 5:6"
      },
      "items": [
        {
          "text": "Mwoyo wangu wakarwadziwa nokuenda kwake.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.6",
            "verseOrgIds": [
              "SNG.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:6"
      },
      "items": [
        {
          "text": "Ndakamutsvaka asi handina kumuwana.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.6",
            "verseOrgIds": [
              "SNG.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:6"
      },
      "items": [
        {
          "text": "Ndakamudana asi haana kupindura.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.6",
            "verseOrgIds": [
              "SNG.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "SNG 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Varindi vakandiona",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.7",
            "verseOrgIds": [
              "SNG.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:7"
      },
      "items": [
        {
          "text": "pavaiva pabasa ravo rokufamba-famba vachichengetedza guta.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.7",
            "verseOrgIds": [
              "SNG.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 5:7"
      },
      "items": [
        {
          "text": "Vakandirova, vakandikuvadza;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.7",
            "verseOrgIds": [
              "SNG.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:7"
      },
      "items": [
        {
          "text": "vakanditorera jasi rangu,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.7",
            "verseOrgIds": [
              "SNG.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:7"
      },
      "items": [
        {
          "text": "ivavo varindi vamasvingo!",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.7",
            "verseOrgIds": [
              "SNG.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "SNG 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imi vanasikana veJerusarema, ndinokurayirai,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.8",
            "verseOrgIds": [
              "SNG.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:8"
      },
      "items": [
        {
          "text": "kana mukaona mudiwa wangu,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.8",
            "verseOrgIds": [
              "SNG.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 5:8"
      },
      "items": [
        {
          "text": "muchamuudzeiko?",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.8",
            "verseOrgIds": [
              "SNG.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:8"
      },
      "items": [
        {
          "text": "Mumuudze kuti ndinorwara nerudo.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.8",
            "verseOrgIds": [
              "SNG.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "Shamwari",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "SNG 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mudiwa wako akanaka kukunda vamwe pakudii,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.9",
            "verseOrgIds": [
              "SNG.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:9"
      },
      "items": [
        {
          "text": "iwe zvako wakanaka kukunda vamwe vakadzi?",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.9",
            "verseOrgIds": [
              "SNG.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 5:9"
      },
      "items": [
        {
          "text": "Mudiwa wako akanaka kukunda vamwe pakudii,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.9",
            "verseOrgIds": [
              "SNG.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 5:9"
      },
      "items": [
        {
          "text": "zvaunotirayira kudaro?",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.9",
            "verseOrgIds": [
              "SNG.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "Mukadzi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "SNG 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mudiwa wangu akanaka uye mutsvuku,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.10",
            "verseOrgIds": [
              "SNG.5.10"
