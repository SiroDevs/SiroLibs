{
  "id": "JER.30",
  "number": "30",
  "bookId": "JER",
  "reference": "Jeremia 30",
  "copyright": "Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi™ Kopakodzero © 2005, 2018 ne Biblica, Inc. Biblica® Open Shona Contemporary Bible™ Copyright © 2005, 2018 by Biblica, Inc.",
  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "30",
        "style": "c",
        "sid": "JER 30"
      },
      "items": [
        {
          "text": "30",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kuvandudzwa kweIsraeri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 30:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iri ndiro shoko rakauya kuna Jeremia richibva kuna Jehovha richiti,",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.1",
            "verseOrgIds": [
              "JER.30.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 30:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Zvanzi naJehovha, Mwari waIsraeri, 'Nyora mubhuku mashoko ose andakakuudza.",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.2",
            "verseOrgIds": [
              "JER.30.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 30:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mazuva anouya,' ndizvo zvinotaura Jehovha, 'andichadzosa vanhu vangu, vaIsraeri navaJudha kubva kuutapwa. Uye ndichavadzosera kunyika yandakapa madzitateguru avo kuti ive yavo,' ndizvo zvinotaura Jehovha.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.3",
            "verseOrgIds": [
              "JER.30.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 30:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aya ndiwo mashoko akataurwa naJehovha pamusoro peIsraeri neJudha:",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.4",
            "verseOrgIds": [
              "JER.30.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 30:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Zvanzi naJehovha:",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.5",
            "verseOrgIds": [
              "JER.30.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 30:5"
      },
      "items": [
        {
          "text": "\" 'Tinonzwa kuchema kwevanotya,",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.5",
            "verseOrgIds": [
              "JER.30.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 30:5"
      },
      "items": [
        {
          "text": "kwokutyisidzirwa, kwete kworugare.",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.5",
            "verseOrgIds": [
              "JER.30.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 30:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bvunzai muone:",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.6",
            "verseOrgIds": [
              "JER.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 30:6"
      },
      "items": [
        {
          "text": "Ko, murume angagona kusununguka mwana here?",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.6",
            "verseOrgIds": [
              "JER.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 30:6"
      },
      "items": [
        {
          "text": "Zvino, seiko ndichiona murume mumwe nomumwe akasimba",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.6",
            "verseOrgIds": [
              "JER.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 30:6"
      },
      "items": [
        {
          "text": "akabata padumbu pake namaoko ake somukadzi orwadziwa,",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.6",
            "verseOrgIds": [
              "JER.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 30:6"
      },
      "items": [
        {
          "text": "zviso zvose zvachenuruka?",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.6",
            "verseOrgIds": [
              "JER.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 30:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haiwa, zuva iro richatyisa seiko!",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.7",
            "verseOrgIds": [
              "JER.30.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 30:7"
      },
      "items": [
        {
          "text": "Hakuna richafanana naro.",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.7",
            "verseOrgIds": [
              "JER.30.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 30:7"
      },
      "items": [
        {
          "text": "Ichava nguva yaJakobho yokutambudzika,",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.7",
            "verseOrgIds": [
              "JER.30.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 30:7"
      },
      "items": [
        {
          "text": "asi achaponeswa pairi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.7",
            "verseOrgIds": [
              "JER.30.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Pazuva iro,' ndizvo zvinotaura Jehovha Wamasimba Ose,",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.8",
            "verseOrgIds": [
              "JER.30.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 30:8"
      },
      "items": [
        {
          "text": "'Ndichavhuna joko pamitsipa yavo",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.8",
            "verseOrgIds": [
              "JER.30.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 30:8"
      },
      "items": [
        {
          "text": "uye ndichadambura zvisungo zvavo;",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.8",
            "verseOrgIds": [
              "JER.30.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 30:8"
      },
      "items": [
        {
          "text": "havachazoitwizve varanda navatorwa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.8",
            "verseOrgIds": [
              "JER.30.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 30:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi, vachashumira Jehovha Mwari wavo",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.9",
            "verseOrgIds": [
              "JER.30.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 30:9"
      },
      "items": [
        {
          "text": "naDhavhidhi mambo wavo,",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.9",
            "verseOrgIds": [
              "JER.30.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 30:9"
      },
      "items": [
        {
          "text": "iye wandichavamutsira.",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.9",
            "verseOrgIds": [
              "JER.30.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 30:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Saka, usatya, iwe Jakobho muranda wangu;",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.10",
            "verseOrgIds": [
              "JER.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 30:10"
      },
      "items": [
        {
          "text": "usavhunduka, iwe Israeri,'",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.10",
            "verseOrgIds": [
              "JER.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q4",
        "vid": "JER 30:10"
      },
      "items": [
        {
          "text": "ndizvo zvinotaura Jehovha.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 30:10"
      },
      "items": [
        {
          "text": "'Zvirokwazvo ndichakuponesa kubva kunyika iri kure,",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.10",
            "verseOrgIds": [
              "JER.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 30:10"
      },
      "items": [
        {
          "text": "zvizvarwa zvako kubva kunyika youtapwa hwavo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.10",
            "verseOrgIds": [
              "JER.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 30:10"
      },
      "items": [
        {
          "text": "Jakobho achavazve norunyararo uye nokuchengetedzeka,",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.10",
            "verseOrgIds": [
              "JER.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 30:10"
      },
      "items": [
        {
          "text": "uye hakuna achazomutyisa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.10",
            "verseOrgIds": [
              "JER.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 30:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinewe uye ndichakuponesa,'",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.11",
            "verseOrgIds": [
              "JER.30.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 30:11"
      },
      "items": [
        {
          "text": "ndizvo zvinotaura Jehovha.",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.11",
            "verseOrgIds": [
              "JER.30.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 30:11"
      },
      "items": [
        {
          "text": "'Kunyange zvazvo ndakaparadza chose ndudzi dzose",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.11",
            "verseOrgIds": [
              "JER.30.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 30:11"
      },
      "items": [
        {
          "text": "dzandakakuparadzira pakati padzo,",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.11",
            "verseOrgIds": [
              "JER.30.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 30:11"
      },
      "items": [
        {
          "text": "handingazokuparadze zvachose iwe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.11",
            "verseOrgIds": [
              "JER.30.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 30:11"
      },
      "items": [
        {
          "text": "Ndichakuranga asi nokururamisira chete;",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.11",
            "verseOrgIds": [
              "JER.30.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 30:11"
      },
      "items": [
        {
          "text": "handingakusiyi usina kurangwa zvachose.'",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.11",
            "verseOrgIds": [
              "JER.30.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 30:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Zvanzi naJehovha:",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.12",
            "verseOrgIds": [
              "JER.30.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 30:12"
      },
      "items": [
        {
          "text": "\" 'Ronda rako harirapiki,",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.12",
            "verseOrgIds": [
              "JER.30.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 30:12"
      },
      "items": [
        {
          "text": "kukuvadzwa kwako hakupori.",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.12",
            "verseOrgIds": [
              "JER.30.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 30:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuna anokureverera mhaka yako,",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.13",
            "verseOrgIds": [
              "JER.30.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 30:13"
      },
      "items": [
        {
          "text": "vanga rako harina mushonga,",
