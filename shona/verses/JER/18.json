{
  "id": "JER.18",
  "number": "18",
  "bookId": "JER",
  "reference": "Jeremia 18",
  "copyright": "Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi™ Kopakodzero © 2005, 2018 ne Biblica, Inc. Biblica® Open Shona Contemporary Bible™ Copyright © 2005, 2018 by Biblica, Inc.",
  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "18",
        "style": "c",
        "sid": "JER 18"
      },
      "items": [
        {
          "text": "18",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Paimba yoMuumbi weHari",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iri ndiro shoko rakauya kuna Jeremia richibva kuna Jehovha richiti,",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.1",
            "verseOrgIds": [
              "JER.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Buruka uende kuimba yomuumbi wehari, ndigokupa shoko rangu ikoko.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.2",
            "verseOrgIds": [
              "JER.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka ndakaenda kuimba yomuumbi wehari, ndikamuona achishanda paguyo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.3",
            "verseOrgIds": [
              "JER.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi hari yaakanga achiumba nevhu yakashatiswa mumaoko ake; saka muumbi akaita imwe hari akaiumba namaumbiro aaiona akanaka.",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.4",
            "verseOrgIds": [
              "JER.18.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo shoko raJehovha rakasvika kwandiri richiti,",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.5",
            "verseOrgIds": [
              "JER.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Haiwa imba yaIsraeri, handingagoni kuita nemi sezvinoita muumbi wehari uyu here?\" ndizvo zvinotaura Jehovha. \"Sezvakaita ivhu muruoko rwomuumbi, ndizvo zvamakaita muruoko rwangu, imi imba yaIsraeri.",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.6",
            "verseOrgIds": [
              "JER.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana ndikazivisa panguva ipi zvayo kuti rudzi kana ushe zvidzurwe nokubvarurwa uye zviparadzwe,",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.7",
            "verseOrgIds": [
              "JER.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye kana rudzi urwo rwandakayambira rukatendeuka pane zvakaipa zvarwo, ipapo ndichazvidemba ndigorega kuisa pamusoro pavo njodzi yandakanga ndavarongera.",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.8",
            "verseOrgIds": [
              "JER.18.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye kana pane imwe nguva ndikazivisa kuti rudzi kana ushe zvivakwe uye zvisimwe,",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.9",
            "verseOrgIds": [
              "JER.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye kana rukaita zvakaipa pamberi pangu uye rukasanditeerera, ipapo ndicharangarirazve zvakanaka zvandakanga ndichida kuruitira.",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.10",
            "verseOrgIds": [
              "JER.18.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Naizvozvo zvino uti kuvanhu veJudha naavo vanogara muJerusarema, 'Zvanzi naJehovha: Tarirai, ndiri kugadzirira njodzi uye ndiri kuronga urongwa hwakaipa pamusoro penyu. Saka dzokai mubve panzira dzenyu dzakaipa, mumwe nomumwe wenyu, uye mushandure nzira dzenyu namaitiro enyu.'",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.11",
            "verseOrgIds": [
              "JER.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi vachapindura vachiti, 'Hazvina maturo. Ticharambira pane zvatakafunga; mumwe nomumwe wedu achatevera kusindimara kwomwoyo wake wakaipa.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.12",
            "verseOrgIds": [
              "JER.18.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo zvanzi naJehovha:",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.13",
            "verseOrgIds": [
              "JER.18.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 18:13"
      },
      "items": [
        {
          "text": "\"Bvunzai pakati pevedzimwe ndudzi kuti:",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.13",
            "verseOrgIds": [
              "JER.18.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 18:13"
      },
      "items": [
        {
          "text": "Ndiani akambonzwa chimwe chinhu chakadai?",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.13",
            "verseOrgIds": [
              "JER.18.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 18:13"
      },
      "items": [
        {
          "text": "Chinhu chakaipa kwazvo chakaitwa",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.13",
            "verseOrgIds": [
              "JER.18.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 18:13"
      },
      "items": [
        {
          "text": "neMhandara Israeri.",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.13",
            "verseOrgIds": [
              "JER.18.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ko, chando cheRebhanoni",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.14",
            "verseOrgIds": [
              "JER.18.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 18:14"
      },
      "items": [
        {
          "text": "chinomboshayikwawo pamawere ematombo here?",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.14",
            "verseOrgIds": [
              "JER.18.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 18:14"
      },
      "items": [
        {
          "text": "Ko, mvura yaro inotonhorera inoyerera ichibva kure",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.14",
            "verseOrgIds": [
              "JER.18.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 18:14"
      },
      "items": [
        {
          "text": "inombomira kuyerera here?",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.14",
            "verseOrgIds": [
              "JER.18.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunyange zvakadaro, vanhu vangu vakandikanganwa;",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.15",
            "verseOrgIds": [
              "JER.18.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 18:15"
      },
      "items": [
        {
          "text": "vanopisira zvinonhuhwira kuzvifananidzo zvisina maturo,",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.15",
            "verseOrgIds": [
              "JER.18.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 18:15"
      },
      "items": [
        {
          "text": "izvo zvakaita kuti vagumburwe munzira dzavo,",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.15",
            "verseOrgIds": [
              "JER.18.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 18:15"
      },
      "items": [
        {
          "text": "uye napamakwara ekare kare.",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.15",
            "verseOrgIds": [
              "JER.18.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 18:15"
      },
      "items": [
        {
          "text": "Vakavaita kuti vafambe mumakwara akatsauka",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.15",
            "verseOrgIds": [
              "JER.18.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 18:15"
      },
      "items": [
        {
          "text": "nomumigwagwa isina kugadzirwa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.15",
            "verseOrgIds": [
              "JER.18.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyika yavo ichaitwa dongo,",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.16",
            "verseOrgIds": [
              "JER.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 18:16"
      },
      "items": [
        {
          "text": "chiseko chisingaperi;",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.16",
            "verseOrgIds": [
              "JER.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 18:16"
      },
      "items": [
        {
          "text": "vose vanopfuura nemo vachashamiswa",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.16",
            "verseOrgIds": [
              "JER.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 18:16"
      },
      "items": [
        {
          "text": "uye vachadzungudza misoro yavo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.16",
            "verseOrgIds": [
              "JER.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Semhepo inobva kumabvazuva,",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.17",
            "verseOrgIds": [
              "JER.18.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 18:17"
      },
      "items": [
        {
          "text": "ndichavaparadzira pamberi pavavengi vavo;",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.17",
            "verseOrgIds": [
              "JER.18.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 18:17"
      },
      "items": [
        {
          "text": "ndichavaratidza musana wangu kwete uso hwangu,",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.17",
            "verseOrgIds": [
              "JER.18.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 18:17"
      },
      "items": [
        {
          "text": "pazuva renjodzi yavo.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.17",
            "verseOrgIds": [
              "JER.18.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakati, \"Uyai tironge zvatingaita naJeremia; nokuti kudzidziswa kwomurayiro navaprista hakungaraswi, kunyange zano rinobva kuna vakachenjera, kana shoko rinobva kuvaprofita. Saka uyai, timurove nendimi dzedu tirege kuteerera chinhu chipi nechipi chaanoreva.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.18",
            "verseOrgIds": [
              "JER.18.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haiwa Jehovha ndinzweiwo;",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.19",
            "verseOrgIds": [
              "JER.18.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 18:19"
      },
      "items": [
        {
          "text": "inzwai zvinorehwa navapomeri vangu!",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.19",
            "verseOrgIds": [
              "JER.18.19"
            ]
          }
        }
      ]
    },
    {
