      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 18:20"
      },
      "items": [
        {
          "text": "Kunyange zvakadaro vakandicherera gomba.",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.20",
            "verseOrgIds": [
              "JER.18.20"
