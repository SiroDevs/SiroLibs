  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "11",
        "style": "c",
        "sid": "JER 11"
      },
      "items": [
        {
          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Sungano Yaputswa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iri ndiro shoko rakauya kuna Jeremia richibva kuna Jehovha:",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.1",
            "verseOrgIds": [
              "JER.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Inzwai mashoko esungano iyi mugoazivisa kuvanhu veJudha nokuna vanogara muJerusarema.",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.2",
            "verseOrgIds": [
              "JER.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muvaudze kuti zvanzi naJehovha Mwari waIsraeri, 'Akatukwa munhu asingateereri mashoko esungano iyi,",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.3",
            "verseOrgIds": [
              "JER.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "mashoko andakarayira madzitateguru enyu pandakavabudisa muIjipiti kubva muchoto chamatare.' Ndakati, 'Nditeererei mugoita zvose zvandinokurayirai, mugova vanhu vangu, ini ndigova Mwari wenyu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.4",
            "verseOrgIds": [
              "JER.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo ndichazadzisa mhiko yandakapika kumadzitateguru enyu, kuti ndichavapa nyika inoyerera mukaka nouchi,' nyika yava yenyu nhasi.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.5",
            "verseOrgIds": [
              "JER.11.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JER 11:5"
      },
      "items": [
        {
          "text": "Ndakapindura ndichiti, \"Ameni, Jehovha.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.5",
            "verseOrgIds": [
              "JER.11.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha akati kwandiri, \"Paridza mashoko aya ose mumaguta eJudha nomumigwagwa yeJerusarema uchiti, 'Inzwai mashoko esungano iyi muatevere.",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.6",
            "verseOrgIds": [
              "JER.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubva panguva yandakabudisa madzitateguru enyu kubva muIjipiti kusvikira nhasi, ndakavayambira ndavayambirazve ndichiti, \"Nditeererei.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.7",
            "verseOrgIds": [
              "JER.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi havana kuteerera kana kuva nehanya; asi vakatevera kusindimara kwemwoyo yavo yakaipa. Saka ndakauyisa pamusoro pavo kutuka kwose kwesungano yandakanga ndavarayira kuti vatevere asi havana kuichengeta.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.8",
            "verseOrgIds": [
              "JER.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Jehovha akati kwandiri, \"Pane rangano pakati pavanhu veJudha navanogona kundimukira navanogara muJerusarema.",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.9",
            "verseOrgIds": [
              "JER.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vadzokera pazvakaipa zvamadzitateguru avo, avo vakaramba kuteerera mashoko angu. Vakatevera vamwe vamwari kuti vavashumire. Dzimba mbiri idzi, yaIsraeri neyaJudha dzakaputsa sungano yandakaita namadzitateguru avo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.10",
            "verseOrgIds": [
              "JER.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo zvanzi naJehovha, 'Ndichauyisa njodzi pamusoro pavo yavasingagoni kupunyuka. Kunyange vakachema kwandiri handingavateereri.",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.11",
            "verseOrgIds": [
              "JER.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maguta eJudha navanhu veJerusarema vachaenda kundodana kuna vamwari vavaipisira zvinonhuhwira, asi havazovabatsiri zvachose pavanosvikirwa nenjodzi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.12",
            "verseOrgIds": [
              "JER.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Una vamwari vakawanda sokuwanda kwakaita maguta ako, iwe Judha; uye aritari dzamakamisa kuti mupisire zvinonhuhwira kuna mwari anonyadzisa, iye Bhaari, dzakawanda sokuwanda kwakaita migwagwa yeJerusarema.'",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.13",
            "verseOrgIds": [
              "JER.11.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Usanyengeterera vanhu kana kupa chikumbiro chipi zvacho kana kuvakumbirira, nokuti handizoteereri pavanodana kwandiri panguva yokutambudzika kwavo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.14",
            "verseOrgIds": [
              "JER.11.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ko, mudiwa wangu ari kuitei mutemberi yangu,",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.15",
            "verseOrgIds": [
              "JER.11.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 11:15"
      },
      "items": [
        {
          "text": "zvaari kuita mabasa ake akaipa navazhinji?",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.15",
            "verseOrgIds": [
              "JER.11.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 11:15"
      },
      "items": [
        {
          "text": "Ko, nyama yakatsaurwa ingadzivisa kurohwa kwako here?",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.15",
            "verseOrgIds": [
              "JER.11.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 11:15"
      },
      "items": [
        {
          "text": "Pamunoita zvakaipa zvenyu,",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.15",
            "verseOrgIds": [
              "JER.11.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 11:15"
      },
      "items": [
        {
          "text": "ipapo imi mofara.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.15",
            "verseOrgIds": [
              "JER.11.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha akati ndiwe muti womuorivhi une upenyu,",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.16",
            "verseOrgIds": [
              "JER.11.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 11:16"
      },
      "items": [
        {
          "text": "une michero yakanaka yakaurungana.",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.16",
            "verseOrgIds": [
              "JER.11.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 11:16"
      },
      "items": [
        {
          "text": "Asi nokutinhira kwemhepo ine simba",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.16",
            "verseOrgIds": [
              "JER.11.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 11:16"
      },
      "items": [
        {
          "text": "achautungidza nomoto,",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.16",
            "verseOrgIds": [
              "JER.11.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 11:16"
      },
      "items": [
        {
          "text": "uye matavi awo achavhunika.",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.16",
            "verseOrgIds": [
              "JER.11.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha Wamasimba Ose, iye akakusima, atema chirevo chezvakaipa kwauri, nokuti imba yaIsraeri neimba yaJudha vakaita zvakaipa, vakanditsamwisa nokupisira Bhaari zvinonhuhwira.",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.17",
            "verseOrgIds": [
              "JER.11.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Rangano pamusoro paJeremia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti Jehovha akandionesa rangano yavo, ndikaiziva, nokuti panguva iyoyo akandiratidza zvavakanga vachiita.",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.18",
            "verseOrgIds": [
              "JER.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakanga ndakaita segwayana rakapfava riri kuendeswa kundobayiwa; ndakanga ndisingazivi kuti vakanga vandirangana, vachiti,",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.19",
            "verseOrgIds": [
              "JER.11.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 11:19"
      },
      "items": [
        {
          "text": "\"Ngatiparadzei muti nemichero yawo;",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.19",
            "verseOrgIds": [
              "JER.11.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 11:19"
      },
      "items": [
        {
          "text": "ngatimubvisei panyika yavapenyu,",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.19",
            "verseOrgIds": [
              "JER.11.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 11:19"
      },
      "items": [
        {
          "text": "kuti zita rake rirege kuzorangarirwazve.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.19",
            "verseOrgIds": [
              "JER.11.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi imi Jehovha Wamasimba Ose, iyemi munotonga nokururama,",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.20",
            "verseOrgIds": [
              "JER.11.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 11:20"
      },
      "items": [
        {
          "text": "uye munoedza mwoyo nendangariro,",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.20",
            "verseOrgIds": [
              "JER.11.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 11:20"
      },
      "items": [
        {
          "text": "ngandione kutsiva kwenyu pamusoro pavo,",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.20",
            "verseOrgIds": [
              "JER.11.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 11:20"
      },
      "items": [
        {
          "text": "nokuti ndakaisa mhaka yangu kwamuri.",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.20",
            "verseOrgIds": [
              "JER.11.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 11:21"
          },
