              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "naizvozvo zvanzi naJehovha Wamasimba Ose, 'Ndichavaranga. Majaya avo achafa nomunondo, vanakomana navanasikana vavo vachafa nenzara.",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.22",
            "verseOrgIds": [
