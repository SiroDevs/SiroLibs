  "verseCount": 30,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "22",
        "style": "c",
        "sid": "JER 22"
      },
      "items": [
        {
          "text": "22",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kutongwa kwaMadzimambo Akaipa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvanzi naJehovha: \"Burukira kumuzinda wamambo weJudha undoparidza shoko iri ikoko uchiti,",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.1",
            "verseOrgIds": [
              "JER.22.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "'Inzwai shoko raJehovha, imi mambo weJudha, iyemi munogara pachigaro choushe chaDhavhidhi, imi namachinda enyu navanhu venyu vanopinda napamasuo aya.",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.2",
            "verseOrgIds": [
              "JER.22.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvanzi naJehovha: Itai zvakanaka nezvakarurama. Rwirai akabirwa muruoko rwounomumanikidza. Regai kuitira zvakaipa kana chisimba kumutorwa nenherera kana chirikadzi, uye musateura ropa risina mhosva panzvimbo ino.",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.3",
            "verseOrgIds": [
              "JER.22.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti kana mukachenjerera kuteerera mirayiro, ipapo madzimambo anogara pachigaro chaDhavhidhi achapinda napamasuo omuzinda uyu, vakakwira mungoro nepamabhiza vachiperekedzwa namachinda avo navanhu vavo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.4",
            "verseOrgIds": [
              "JER.22.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi kana mukaramba kunzwa mirayiro iyi, ndizvo zvinotaura Jehovha, ndinopika neni ndimene kuti nzvimbo ino ichava dongo.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.5",
            "verseOrgIds": [
              "JER.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti zvanzi naJehovha pamusoro pomuzinda wamambo weJudha:",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.6",
            "verseOrgIds": [
              "JER.22.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 22:6"
      },
      "items": [
        {
          "text": "\"Kunyange wakaita seGireadhi kwandiri,",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.6",
            "verseOrgIds": [
              "JER.22.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 22:6"
      },
      "items": [
        {
          "text": "wakaita somusoro weRebhanoni,",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.6",
            "verseOrgIds": [
              "JER.22.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 22:6"
      },
      "items": [
        {
          "text": "zvirokwazvo ndichakuita segwenga,",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.6",
            "verseOrgIds": [
              "JER.22.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 22:6"
      },
      "items": [
        {
          "text": "semaguta asingagarwi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.6",
            "verseOrgIds": [
              "JER.22.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndichatumira vaparadzi pamusoro penyu,",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.7",
            "verseOrgIds": [
              "JER.22.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 22:7"
      },
      "items": [
        {
          "text": "mumwe nomumwe nezvombo zvake,",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.7",
            "verseOrgIds": [
              "JER.22.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 22:7"
      },
      "items": [
        {
          "text": "uye vachatema matanda enyu emisidhari akanaka",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.7",
            "verseOrgIds": [
              "JER.22.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 22:7"
      },
      "items": [
        {
          "text": "vagoakanda mumoto.",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.7",
            "verseOrgIds": [
              "JER.22.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Marudzi mazhinji avanhu achapfuura nepaguta rino uye vachabvunzana vachiti, 'Jehovha aitireiko chinhu chakadai kuguta rino?'",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.8",
            "verseOrgIds": [
              "JER.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino mhinduro ichati, 'Nokuti vakasiya sungano yaJehovha Mwari wavo vakanamata uye vakashumira vamwe vamwari.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.9",
            "verseOrgIds": [
              "JER.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musachema mambo akafa kana kuungudza nezvake;",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.10",
            "verseOrgIds": [
              "JER.22.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 22:10"
      },
      "items": [
        {
          "text": "asi muchemere kwazvo uyo akatapwa,",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.10",
            "verseOrgIds": [
              "JER.22.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 22:10"
      },
      "items": [
        {
          "text": "nokuti haachambodzoki kana kuzoonazve nyika yaakaberekerwa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.10",
            "verseOrgIds": [
              "JER.22.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti zvanzi naJehovha pamusoro paSharumi mwanakomana waJosia, uyo akatevera Baba vake samambo weJudha asi akabva panzvimbo ino: \"Haazombodzoki.",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.11",
            "verseOrgIds": [
              "JER.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achafira munzvimbo yavakamuendesa kuutapwa; haachazombooni nyika inozve.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.12",
            "verseOrgIds": [
              "JER.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ane nhamo uyo anovaka muzinda wake nokusarurama,",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.13",
            "verseOrgIds": [
              "JER.22.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 22:13"
      },
      "items": [
        {
          "text": "namakamuri ake okumusoro nokusaruramisira,",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.13",
            "verseOrgIds": [
              "JER.22.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 22:13"
      },
      "items": [
        {
          "text": "anoshandisa vanhu vokwake pasina chaanovapa,",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.13",
            "verseOrgIds": [
              "JER.22.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 22:13"
      },
      "items": [
        {
          "text": "asingavaripiri pakushanda kwavo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.13",
            "verseOrgIds": [
              "JER.22.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anoti, 'Ndichazvivakira muzinda wakakura",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.14",
            "verseOrgIds": [
              "JER.22.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 22:14"
      },
      "items": [
        {
          "text": "una makamuri okumusoro anoyevedza.'",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.14",
            "verseOrgIds": [
              "JER.22.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 22:14"
      },
      "items": [
        {
          "text": "Saka anoita mawindo makuru mairi,",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.14",
            "verseOrgIds": [
              "JER.22.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 22:14"
      },
      "items": [
        {
          "text": "achiabatanidza nomusidhari,",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.14",
            "verseOrgIds": [
              "JER.22.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 22:14"
      },
      "items": [
        {
          "text": "agoashongedza nezvitsvuku.",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.14",
            "verseOrgIds": [
              "JER.22.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Izvozvo zvinokuita mambo here,",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.15",
            "verseOrgIds": [
              "JER.22.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 22:15"
      },
      "items": [
        {
          "text": "kuva nemisidhari yakawandawanda?",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.15",
            "verseOrgIds": [
              "JER.22.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 22:15"
      },
      "items": [
        {
          "text": "Ko, baba vako havana kuwana zvokudya nezvokunwa here?",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.15",
            "verseOrgIds": [
              "JER.22.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 22:15"
      },
      "items": [
        {
          "text": "Iye akaita zvakarurama uye nokururamisira,",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.15",
            "verseOrgIds": [
              "JER.22.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 22:15"
      },
      "items": [
        {
          "text": "saka zvose zvakamufambira zvakanaka.",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.15",
            "verseOrgIds": [
              "JER.22.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akatongera varombo nevaishayiwa mhaka dzavo,",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.16",
            "verseOrgIds": [
              "JER.22.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 22:16"
      },
      "items": [
        {
          "text": "nokudaro zvose zvakafamba zvakanaka.",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.16",
            "verseOrgIds": [
              "JER.22.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 22:16"
      },
      "items": [
        {
          "text": "Hazvisizvo zvinoreva kundiziva here?\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.16",
            "verseOrgIds": [
              "JER.22.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 22:16"
      },
      "items": [
        {
          "text": "ndizvo zvinotaura Jehovha.",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.16",
            "verseOrgIds": [
              "JER.22.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Asi meso enyu nemwoyo yenyu",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.17",
            "verseOrgIds": [
              "JER.22.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 22:17"
      },
      "items": [
        {
          "text": "zvakangotarisa chete papfuma isakarurama,",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.17",
            "verseOrgIds": [
              "JER.22.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 22:17"
      },
      "items": [
        {
          "text": "pakuteura ropa risina mhosva",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.17",
            "verseOrgIds": [
              "JER.22.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 22:17"
      },
      "items": [
        {
          "text": "napakumanikidza nokuita nechisimba.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.17",
            "verseOrgIds": [
              "JER.22.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo zvanzi naJehovha, pamusoro paJehoyakimi mwanakomana waJosia, mambo weJudha:",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.18",
            "verseOrgIds": [
              "JER.22.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 22:18"
      },
      "items": [
        {
          "text": "\"Havangamuchemi vachiti:",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.18",
            "verseOrgIds": [
              "JER.22.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 22:18"
      },
      "items": [
        {
          "text": "'Yowe-e, mununʼuna wangu! Yowe-e, hanzvadzi yangu!'",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.18",
            "verseOrgIds": [
              "JER.22.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 22:18"
      },
      "items": [
        {
          "text": "Havangamuchemi vachiti:",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.18",
            "verseOrgIds": [
              "JER.22.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 22:18"
      },
      "items": [
        {
          "text": "'Yowe-e, tenzi wangu! Yowe-e, ukuru hwake!'",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.18",
            "verseOrgIds": [
              "JER.22.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achavigwa sokuvigwa kunoitwa mbongoro,",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.19",
            "verseOrgIds": [
              "JER.22.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 22:19"
      },
      "items": [
        {
          "text": "achakwekweredzwa agoraswa kure,",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.19",
            "verseOrgIds": [
              "JER.22.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 22:19"
      },
      "items": [
        {
          "text": "kunze kwamasuo eJerusarema.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.19",
            "verseOrgIds": [
              "JER.22.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kwirai kuRebhanoni mudanidzire,",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.20",
            "verseOrgIds": [
              "JER.22.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 22:20"
      },
      "items": [
        {
          "text": "inzwi renyu ngarinzwike paBhashani,",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.20",
            "verseOrgIds": [
              "JER.22.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 22:20"
      },
      "items": [
        {
          "text": "danidzirai kubva paAbharimi,",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.20",
            "verseOrgIds": [
              "JER.22.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 22:20"
      },
      "items": [
        {
          "text": "nokuti shamwari dzenyu dzose dzaparadzwa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.20",
            "verseOrgIds": [
              "JER.22.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakakuyambira uchigere zvakanaka,",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.21",
            "verseOrgIds": [
              "JER.22.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 22:21"
      },
      "items": [
        {
          "text": "asi iwe wakati, 'Handidi kuteerera!'",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.21",
            "verseOrgIds": [
              "JER.22.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 22:21"
      },
      "items": [
        {
          "text": "Ndiyo yanga iri nzira yako kubva pauduku hwako;",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.21",
            "verseOrgIds": [
              "JER.22.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 22:21"
      },
      "items": [
        {
          "text": "hauna kunditeerera.",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.21",
            "verseOrgIds": [
              "JER.22.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 22:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mhepo ichadzingira kure vafudzi vako vose,",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.22",
            "verseOrgIds": [
              "JER.22.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 22:22"
      },
      "items": [
        {
          "text": "uye shamwari dzako dzichaenda kuutapwa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.22",
            "verseOrgIds": [
              "JER.22.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 22:22"
      },
      "items": [
        {
          "text": "Ipapo iwe uchanyara uye uchanyadziswa,",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.22",
            "verseOrgIds": [
              "JER.22.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 22:22"
      },
      "items": [
        {
          "text": "nokuda kwokuipa kwako kwose.",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.22",
            "verseOrgIds": [
              "JER.22.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 22:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imi mugere mu'Rebhanoni,'",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.23",
            "verseOrgIds": [
              "JER.22.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 22:23"
      },
      "items": [
        {
          "text": "iyemi makavakirwa matendere mudzimba dzemisidhari,",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.23",
            "verseOrgIds": [
              "JER.22.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 22:23"
      },
      "items": [
        {
          "text": "muchagomera sei kurwadza pakuchauya pamusoro penyu,",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.23",
            "verseOrgIds": [
              "JER.22.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 22:23"
      },
      "items": [
        {
          "text": "kurwadziwa sekwomukadzi anosununguka!",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.23",
            "verseOrgIds": [
              "JER.22.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 22:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Zvirokwazvo, noupenyu hwangu,\" ndizvo zvinotaura Jehovha, \"kunyange kana iwe Jehoyakini mwanakomana waJehoyakimi mambo weJudha, wakanga uri mhete muruoko rwangu rworudyi, ndaingokubvisa zvakadaro.",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.24",
            "verseOrgIds": [
              "JER.22.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 22:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndichakuisa mumaoko aavo vanotsvaka kukuuraya, ivo vaunotya, kuna Nebhukadhinezari mambo weBhabhironi nokuvaBhabhironi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.25",
            "verseOrgIds": [
              "JER.22.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 22:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndichapotsera iwe namai vakakubereka kune imwe nyika kwamusina kuberekerwa, uye ikoko kwamuchandofira muri vaviri.",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.26",
            "verseOrgIds": [
              "JER.22.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 22:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamuzombodzokizve kunyika yamunoshuva kudzokera kwairi.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.27",
            "verseOrgIds": [
              "JER.22.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 22:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ko, murume uyu Jehoyakini munhu akazvidzika, ihari yakaputsika,",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.28",
            "verseOrgIds": [
              "JER.22.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 22:28"
      },
      "items": [
        {
          "text": "chinhu chisina angada here?",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.28",
            "verseOrgIds": [
              "JER.22.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 22:28"
      },
      "items": [
        {
          "text": "Seiko iye navana vake vapotserwa kunze,",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.28",
            "verseOrgIds": [
              "JER.22.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 22:28"
      },
      "items": [
        {
          "text": "vakarasirwa kunyika yavasingazivi?",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.28",
            "verseOrgIds": [
              "JER.22.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 22:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwe nyika, nyika, nyika,",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.29",
            "verseOrgIds": [
              "JER.22.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 22:29"
      },
      "items": [
        {
          "text": "inzwa shoko raJehovha!",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.29",
            "verseOrgIds": [
              "JER.22.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JER 22:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvanzi naJehovha:",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.30",
            "verseOrgIds": [
              "JER.22.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 22:30"
      },
      "items": [
        {
          "text": "\"Nyora munhu uyu seasina mwana,",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.30",
            "verseOrgIds": [
              "JER.22.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 22:30"
      },
      "items": [
        {
          "text": "munhu asingazobudiriri pamazuva oupenyu hwake,",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.30",
            "verseOrgIds": [
              "JER.22.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 22:30"
      },
      "items": [
        {
          "text": "nokuti hakuna mwana wake achapfuma,",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.30",
            "verseOrgIds": [
              "JER.22.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 22:30"
      },
