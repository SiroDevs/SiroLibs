  "verseCount": 19,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "JER 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mashoko aJeremia mwanakomana waHirikia, mumwe wavaprista paAnatoti munyika yaBhenjamini.",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.1",
            "verseOrgIds": [
              "JER.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shoko raJehovha rakauya kwaari mugore regumi namatatu rokutonga kwaJosia mwanakomana waAmoni mambo weJudha,",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.2",
            "verseOrgIds": [
              "JER.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye nomunguva yokutonga kwaJehoyakimi mwanakomana waJosia mambo weJudha, kusvikira pamwedzi wechishanu wegore regumi nerimwe raZedhekia mwanakomana waJosia mambo weJudha, vanhu veJerusarema pavakazoenda kuutapwa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.3",
            "verseOrgIds": [
              "JER.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kudanwa kwaJeremia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shoko raJehovha rakauya kwandiri, richiti,",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.4",
            "verseOrgIds": [
              "JER.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndisati ndakuumba mudumbu ramai vako, ndakakuziva iwe,",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.5",
            "verseOrgIds": [
              "JER.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 1:5"
      },
      "items": [
        {
          "text": "usati waberekwa, ndakakutsaura;",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.5",
            "verseOrgIds": [
              "JER.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 1:5"
      },
      "items": [
        {
          "text": "ndakakugadza somuprofita kumarudzi.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.5",
            "verseOrgIds": [
              "JER.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ini ndikati, \"Haiwa, Ishe Jehovha, handigoni kutaura; ndinongova mwana hangu.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.6",
            "verseOrgIds": [
              "JER.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi Jehovha akati kwandiri, \"Usati, 'Ndinongova mwana hangu.' Unofanira kuenda kuna ani naani wandinokutuma kwaari undotaura zvose zvandinokurayira.",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.7",
            "verseOrgIds": [
              "JER.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usavatya, nokuti ini ndinewe uye ndichakurwira,\" ndizvo zvinotaura Jehovha.",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.8",
            "verseOrgIds": [
              "JER.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Jehovha akatambanudza ruoko rwake akabata muromo wangu akati kwandiri, \"Zvino ndaisa mashoko angu mumuromo mako.",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.9",
            "verseOrgIds": [
              "JER.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tarira, nhasi ndakugadza pamusoro pendudzi napamusoro poushe kuti udzure, ubvarure, uparadze, ukoromore, uvake uye usime.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.10",
            "verseOrgIds": [
              "JER.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shoko raJehovha rakauya kwandiri richiti, \"Jeremia, uri kuonei?\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.11",
            "verseOrgIds": [
              "JER.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JER 1:11"
      },
      "items": [
        {
          "text": "Ndakapindura ndikati, \"Ndiri kuona davi romuti womuarimondi.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.11",
            "verseOrgIds": [
              "JER.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha akati kwandiri, \"Waona zvakanaka, nokuti ndiri kutarira kuti ndione kuzadziswa kweshoko rangu.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.12",
            "verseOrgIds": [
              "JER.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shoko raJehovha rakauyazve kwandiri richiti, \"Uri kuoneiko?\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.13",
            "verseOrgIds": [
              "JER.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JER 1:13"
      },
      "items": [
        {
          "text": "Ndakapindura ndikati, \"Ndiri kuona hari iri kuvira, yakarerekera kubva kumusoro.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.13",
            "verseOrgIds": [
              "JER.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha akati kwandiri, \"Njodzi ichadururirwa pamusoro pavanhu vagere munyika ichibva nokumusoro.",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.14",
            "verseOrgIds": [
              "JER.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti iye zvino ndiri kudana vanhu vose voushe hwokumusoro,\" ndizvo zvinotaura Jehovha.",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.15",
            "verseOrgIds": [
              "JER.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 1:15"
      },
      "items": [
        {
          "text": "\"Madzimambo avo achauya achizoisa zvigaro zvavo zvoushe",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.15",
            "verseOrgIds": [
              "JER.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 1:15"
      },
      "items": [
        {
          "text": "pamasuo eJerusarema;",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.15",
            "verseOrgIds": [
              "JER.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 1:15"
      },
      "items": [
        {
          "text": "vachauya kuzorwisa masvingo aro ose akarikomberedza",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.15",
            "verseOrgIds": [
              "JER.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 1:15"
      },
      "items": [
        {
          "text": "uye namaguta ose eJudha.",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.15",
            "verseOrgIds": [
              "JER.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndichareva zvandakatonga pamusoro pavanhu vangu",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.16",
            "verseOrgIds": [
              "JER.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 1:16"
      },
      "items": [
        {
          "text": "nokuda kwezvakaipa zvavo zvavakaita vachindisiya,",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.16",
            "verseOrgIds": [
              "JER.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 1:16"
      },
      "items": [
        {
          "text": "vachipisira zvinonhuhwira kuna vamwe vamwari",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.16",
            "verseOrgIds": [
              "JER.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 1:16"
      },
      "items": [
        {
          "text": "uye vachinamata zvakaumbwa namaoko avo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.16",
            "verseOrgIds": [
              "JER.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Iwe chigadzirira! Simuka uvataurire zvose zvandinokurayira. Usavhundutswa navo, kuti ini ndirege kuzokuvhundutsa pamberi pavo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.17",
            "verseOrgIds": [
              "JER.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nhasi ndakuita guta rakakomberedzwa nembiru yesimbi namasvingo endarira, kuti urwe nenyika yose, urwe namadzimambo eJudha, namachinda avo, navaprista vavo uye navanhu venyika.",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.18",
            "verseOrgIds": [
              "JER.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vacharwa newe asi havangakukundi, nokuti ndinewe uye ndichakurwira,\" ndizvo zvinotaura Jehovha.",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.19",
            "verseOrgIds": [
              "JER.1.19"
            ]
          }
        }
      ]
    }
  ],
