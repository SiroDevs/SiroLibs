  "verseCount": 16,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "40",
        "style": "c",
        "sid": "JER 40"
      },
      "items": [
        {
          "text": "40",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jeremia anosunungurwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 40:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shoko rakasvika kuna Jeremia richibva kuna Jehovha mushure mokusunungurwa kwake paRama naNebhuzaradhani mukuru wavarindi. Akanga awana Jeremia akasungwa nengetani ari pakati pavatapwa vose vaibva kuJerusarema neJudha avo vakanga vachiendeswa kuutapwa kuBhabhironi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.1",
            "verseOrgIds": [
              "JER.40.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 40:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukuru wavarindi akati awana Jeremia, akati kwaari, \"Jehovha Mwari wako akatenda kuti njodzi iyi iwire nzvimbo ino.",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.2",
            "verseOrgIds": [
              "JER.40.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 40:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino Jehovha aita kuti zviitike, aita sezvaakareva kuti achaita. Izvi zvose zvakaitika nokuti imi vanhu makatadzira Jehovha uye hamuna kumuteerera.",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.3",
            "verseOrgIds": [
              "JER.40.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 40:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi nhasi ndinokusunungura kubva pangetani dziri mumaoko ako. Uya tiende tose kuBhabhironi, kana uchida, ini ndichakuchengeta; asi kana usingadi, usauya. Tarira, nyika yose iri pamberi pako; enda hako kwose kwaunoda.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.4",
            "verseOrgIds": [
              "JER.40.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 40:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunyange zvakadaro hazvo, Jeremia asati atendeuka kuti aende, Nebhuzaradhani akaenderera mberi achiti, \"Dzokera kuna Gedharia mwanakomana waAhikami, mwanakomana waShafani uyo akagadzwa namambo weBhabhironi kuti ave mubati wemaguta eJudha, undogara naye pakati pavanhu, kana kuti woenda kwose kwaunoda.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.5",
            "verseOrgIds": [
              "JER.40.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JER 40:5"
      },
      "items": [
        {
          "text": "Ipapo mukuru wavarindi akamupa zvokudya zvokutakura nezvipo akamurega achienda.",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.5",
            "verseOrgIds": [
              "JER.40.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 40:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Jeremia akaenda kuna Gedharia mwanakomana waAhikami paMizipa akandogara naye pakati pavanhu vakanga vasara munyika.",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.6",
            "verseOrgIds": [
              "JER.40.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gedharia anourayiwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 40:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakuru vehondo navanhu vakanga vachigara mumasango enyika vakati vanzwa kuti mambo weBhabhironi akanga agadza Gedharia mwanakomana waAhikami kuti ave mubati wenyika uye kuti mambo akanga amuita mutariri wavarume, vakadzi navana, avo vakanga vari varombo zvakanyanya munyika uye vakanga vasina kuendeswa pautapwa kuBhabhironi,",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.7",
            "verseOrgIds": [
              "JER.40.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 40:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "vakauya kuna Gedharia paMizipa, Ishumaeri mwanakomana waNetania, Johanani naJonatani vanakomana vaKarea, naSeraya mwanakomana waTanhumeti, mwanakomana waEfai muNetofati, naJaazania mwanakomana womuMaakati, ivo navanhu vavo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.8",
            "verseOrgIds": [
              "JER.40.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 40:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gedharia mwanakomana waAhikami, mwanakomana waShafani, akapika mhiko yokuvasimbisa ivo navanhu vavo achiti, \"Musatya kushandira vaBhabhironi. Garai henyu munyika mushandire mambo weBhabhironi, zvigokuitirai zvakanaka.",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.9",
            "verseOrgIds": [
              "JER.40.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 40:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ini pachangu ndichagara paMizipa kuti ndikumirirei pamberi pavaBhabhironi vanouya kwatiri, asi imi munofanira kukohwa waini, nezvibereko zvezhizha namafuta mugozviisa mumidziyo yenyu, mugogara mumaguta amakakunda.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.10",
            "verseOrgIds": [
              "JER.40.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 40:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "VaJudha vose vaiva muMoabhu, muAmoni, nevemuEdhomu nedzimwe nyika dzose vakati vanzwa kuti mambo weBhabhironi akanga asiya vamwe vanhu muJudha uye kuti akanga agadza Gedharia mwanakomana waAhikami, mwanakomana waShafani, somubati pamusoro pavo,",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.11",
            "verseOrgIds": [
              "JER.40.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 40:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "vose vakadzoka kunyika yeJudha, kuna Gedharia paMizipa, vachibva kunyika dzose kwavakanga vakaparadzirwa. Uye vakakohwa waini yakawanda nezvibereko zvezhizha zvizhinji kwazvo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.12",
            "verseOrgIds": [
              "JER.40.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 40:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Johanani mwanakomana waKarea navakuru vose vehondo vakanga vachiri kumasango vakauya kuna Gedharia paMizipa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.13",
            "verseOrgIds": [
              "JER.40.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 40:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakati kwaari, \"Hauzivi here kuti Bhaarisi mambo wavaAmoni atuma Ishumaeri mwanakomana waNetania kuti azokuuraya?\" Asi Gedharia mwanakomana waAhikami haana kuvatenda.",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.14",
            "verseOrgIds": [
              "JER.40.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 40:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Johanani mwanakomana waKarea akati kuna Gedharia muchivande vari paMizipa, \"Rega ndinouraya Ishumaeri mwanakomana waNetania, uye hapana achazviziva. Anodirei kukuuraya nokuita kuti vaJudha vose vakaungana, vakakupoteredza, vaparadzirwe uye vakasara veJudha vaparare?\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.15",
            "verseOrgIds": [
              "JER.40.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 40:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi Gedharia mwanakomana waAhikami akati kuna Johanani mwanakomana waKarea, \"Usaita chinhu chakadaro! Zvauri kutaura pamusoro paIshumaeri hazvisi zvechokwadi.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.16",
            "verseOrgIds": [
              "JER.40.16"
            ]
          }
        }
      ]
    }
  ],
