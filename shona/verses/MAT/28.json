  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "28",
        "style": "c",
        "sid": "MAT 28"
      },
      "items": [
        {
          "text": "28",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kumuka kwaJesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 28:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mushure meSabata, ava mambakwedza nomusi wokutanga wevhiki, Maria Magadharena nomumwe Maria vakaenda kundoona guva.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.1",
            "verseOrgIds": [
              "MAT.28.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 28:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakava nokudengenyeka kwenyika kukuru nokuti mutumwa waShe akabva kudenga akaenda paguva akasvikokungurutsa ibwe riya akagara pamusoro paro.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.2",
            "verseOrgIds": [
              "MAT.28.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 28:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuonekwa kwake kwakanga kwakaita semheni uye nguo dzake dzakanga dzakachena sechando.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.3",
            "verseOrgIds": [
              "MAT.28.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Varindi vakamutya kwazvo zvokuti vakadedera vakaita savanhu vafa.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.4",
            "verseOrgIds": [
              "MAT.28.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 28:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutumwa akati kuvakadzi vaya, \"Musatya nokuti ndinoziva kuti muri kutsvaka Jesu uyo akarovererwa pamuchinjikwa.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.5",
            "verseOrgIds": [
              "MAT.28.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 28:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haapo pano; amuka sokutaura kwaakaita. Uyai muone panzvimbo paakanga avete.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.6",
            "verseOrgIds": [
              "MAT.28.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino kurumidzai muende kundoudza vadzidzi vake kuti, 'Amuka kubva kuvakafa uye kuti afanotungamira kuGarirea. Muchanomuona ikoko.' Zvino ndakuudzai.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.7",
            "verseOrgIds": [
              "MAT.28.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka vakadzi ava vakakurumidza kubva paguva vachitya asi vakazadzwa nomufaro, uye vakamhanya kundoudza vadzidzi vake.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.8",
            "verseOrgIds": [
              "MAT.28.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 28:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakarepo Jesu akasangana navo, akati, \"Kwaziwai.\" Vakauya kwaari vakabata tsoka dzake uye vakamunamata.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.9",
            "verseOrgIds": [
              "MAT.28.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Jesu akati kwavari, \"Musatya. Endai mundoudza hama dzangu kuti vaende kuGarirea; ikoko ndiko kwavachanondiona.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.10",
            "verseOrgIds": [
              "MAT.28.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Zvakataurwa naVarindi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 28:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakadzi vaya vachiri munzira, vamwe vevarindi vakaenda muguta vakandotaurira vaprista vakuru zvose zvakanga zvaitika.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.11",
            "verseOrgIds": [
              "MAT.28.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 28:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vaprista vakuru vakati vasangana navakuru, uye vafunga zano, vakapa varwi mari zhinji",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.12",
            "verseOrgIds": [
              "MAT.28.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 28:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "vakati kwavari, \"Imi munofanira kutaura muchiti, 'Vadzidzi vake vakauya usiku vakamuba isu tivete.'",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.13",
            "verseOrgIds": [
              "MAT.28.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 28:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana mashoko aya akasvika munzeve dzomubati, isu tichaita kuti agutsikane uye imi musawira mudambudziko.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.14",
            "verseOrgIds": [
              "MAT.28.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 28:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka varwi vakatora mari iya vakaita sezvavakanga varayirwa. Uye shoko iri rakaparadzirwa kwazvo pakati pavaJudha kusvikira zuva ranhasi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.15",
            "verseOrgIds": [
              "MAT.28.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kutumwa Kukuru",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 28:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo vadzidzi gumi nomumwe vakaenda kuGarirea, kugomo ravainge vaudzwa naJesu kuti vaende.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.16",
            "verseOrgIds": [
              "MAT.28.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 28:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakati vamuona, vakamunamata, asi vamwe vakakahadzika.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.17",
            "verseOrgIds": [
              "MAT.28.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 28:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Jesu akasvika pavari akati, \"Simba rose kudenga napanyika rakapiwa kwandiri.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.18",
            "verseOrgIds": [
              "MAT.28.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 28:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo endai mudzidzise ndudzi dzose, muchivabhabhatidza muzita raBaba, neroMwanakomana neroMweya Mutsvene,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.19",
            "verseOrgIds": [
              "MAT.28.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 28:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye muchivadzidzisa kuti vachengete zvose zvandakakurayirai. Uye zvechokwadi ndinemi kusvikira pakuguma kwenyika.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.20",
            "verseOrgIds": [
              "MAT.28.20"
            ]
          }
        }
      ]
    }
  ],
