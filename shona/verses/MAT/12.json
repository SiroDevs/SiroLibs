  "verseCount": 50,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "12",
        "style": "c",
        "sid": "MAT 12"
      },
      "items": [
        {
          "text": "12",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ishe weSabata",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panguva iyoyo Jesu akapfuura nomuminda yaiva nezviyo uri musi weSabata. Vadzidzi vake vakanga vava nenzara ndokubva vatanga kupurura hura hwezviyo zviya vachidya.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.1",
            "verseOrgIds": [
              "MAT.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "VaFarisi pavakazviona, vakati kwaari, \"Tarirai, vadzidzi venyu vari kuita zvisingabvumirwi nomusi weSabata.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.2",
            "verseOrgIds": [
              "MAT.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati kwavari, \"Ko, hamuna kuverenga here zvakaitwa naDhavhidhi navamwe vake pavakanga vava nenzara?",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.3",
            "verseOrgIds": [
              "MAT.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akapinda muimba yaMwari iye nevamwe vake vakadya chingwa chitsvene chavaisabvumirwa kudya, asi chaingodyiwa navaprista chete.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.4",
            "verseOrgIds": [
              "MAT.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana kuti hamuna kuverenga here muMurayiro kuti nomusi weSabata vaprista mutemberi vanosvibisa zuva iri asi vasingapiwi mhosva?",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.5",
            "verseOrgIds": [
              "MAT.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinokuudzai kuti mukuru kupfuura temberi ari pano.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.6",
            "verseOrgIds": [
              "MAT.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dai maiziva zvinorehwa namashoko anoti, 'Ndinoda ngoni, kwete zvibayiro,' hamaizopa mhosva vasina mhosva.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.7",
            "verseOrgIds": [
              "MAT.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti Mwanakomana woMunhu ndiye Ishe weSabata.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.8",
            "verseOrgIds": [
              "MAT.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achipfuurira mberi kubva panzvimbo iyoyo, akapinda musinagoge ravo,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.9",
            "verseOrgIds": [
              "MAT.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye makanga muno murume akanga ano ruoko rwakanga rwakakokonyara. Vachitsvaka mhosva yokupomera Jesu vakamubvunza vakati, \"Zviri pamutemo here kuporesa nomusi weSabata?\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.10",
            "verseOrgIds": [
              "MAT.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati kwavari, \"Kana mumwe wenyu aine gwai, rikawira mugomba nomusi weSabata, haangatambanudzi ruoko rwake akaribudisa here?",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.11",
            "verseOrgIds": [
              "MAT.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ko, zvino munhu anokosha zvakadini pane gwai! Naizvozvo zviri pamutemo kuita zvakanaka nomusi weSabata.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.12",
            "verseOrgIds": [
              "MAT.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati kumurume uya, \"Tambanudza ruoko rwako.\" Akarutambanudza rukapora rukava sorumwe.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.13",
            "verseOrgIds": [
              "MAT.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi vaFarisi vakabuda kundorangana kuti vangamuuraya sei.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.14",
            "verseOrgIds": [
              "MAT.12.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Muranda Akasarudzwa naMwari",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achiziva izvi, Jesu akabva panzvimbo iyi. Vazhinji vakamutevera, akaporesa varwere vavo vose.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.15",
            "verseOrgIds": [
              "MAT.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akavayambira kuti vasafamba vachitaura kuti iye ndiye ani.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.16",
            "verseOrgIds": [
              "MAT.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izvi zvakanga zvichizadzisa zvainge zvataurwa nomuprofita Isaya achiti:",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.17",
            "verseOrgIds": [
              "MAT.12.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Houno muranda wangu wandakasarudza,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.18",
            "verseOrgIds": [
              "MAT.12.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MAT 12:18"
      },
      "items": [
        {
          "text": "wandinoda, anondifadza;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.18",
            "verseOrgIds": [
              "MAT.12.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MAT 12:18"
      },
      "items": [
        {
          "text": "ndichaisa Mweya wangu paari,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.18",
            "verseOrgIds": [
              "MAT.12.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MAT 12:18"
      },
      "items": [
        {
          "text": "iye achazivisa nyika kutonga kwakarurama.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.18",
            "verseOrgIds": [
              "MAT.12.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haazokakavari kana kuridza mhere;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.19",
            "verseOrgIds": [
              "MAT.12.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MAT 12:19"
      },
      "items": [
        {
          "text": "hakuna anozonzwa inzwi rake mumigwagwa.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.19",
            "verseOrgIds": [
              "MAT.12.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rutsanga rwakapwanyika haangarutyori,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.20",
            "verseOrgIds": [
              "MAT.12.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MAT 12:20"
      },
      "items": [
        {
          "text": "nomwenje unopfuta zvishoma haangaudzimi,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.20",
            "verseOrgIds": [
              "MAT.12.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MAT 12:20"
      },
      "items": [
        {
          "text": "kusvikira atungamirira kutonga kwakarurama mukukunda.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.20",
            "verseOrgIds": [
              "MAT.12.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Marudzi ose achaisa tariro yawo muzita rake.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.21",
            "verseOrgIds": [
              "MAT.12.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jesu naBheerizebhubhi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo vakauya kwaari nomurume akanga akabatwa nedhimoni ari bofu uye ari mbeveve, uye Jesu akamuporesa, zvokuti akagona zvose kutaura nokuona.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.22",
            "verseOrgIds": [
              "MAT.12.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 12:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanhu vose vakashamiswa uye vakati, \"Kuti uyu angava Mwanakomana waDhavhidhi here?\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.23",
            "verseOrgIds": [
              "MAT.12.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 12:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi vaFarisi pavakanzwa izvi, vakati, \"NdiBheerizebhubhi chete, muchinda wamadhimoni, waanodzinga naye madhimoni.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.24",
            "verseOrgIds": [
              "MAT.12.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akaziva pfungwa dzavo akati kwavari, \"Umambo hwose hunozvipesanisa huchaparara, uye guta ripi neripi kana imba ipi neipi inozvipesanisa haingamiri.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.25",
            "verseOrgIds": [
              "MAT.12.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 12:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino kana Satani achibudisa mumwe Satani, zvinoreva kuti anozvipesanisa. Saka umambo hwake hungamira sei?",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.26",
            "verseOrgIds": [
              "MAT.12.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino kana ini ndichibudisa madhimoni naBheerizebhubhi, ko, vanakomana venyu vanoabudisa naani?",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.27",
            "verseOrgIds": [
              "MAT.12.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 12:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi kana ndichibudisa madhimoni noMweya waMwari zvinoreva kuti umambo hwaMwari hwasvika kwamuri.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.28",
            "verseOrgIds": [
              "MAT.12.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 12:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Uyezve, munhu angapinda sei mumba momunhu ane simba agoenda nezvinhu zvake asina kutanga asunga munhu uyu ane simba? Ipapo anogona kuzopamba imba yake.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.29",
            "verseOrgIds": [
              "MAT.12.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 12:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Uyo asineni anopesana neni, nouyo asingaunganidzi neni anoparadza.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.30",
            "verseOrgIds": [
              "MAT.12.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 12:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye naizvozvo ndinokuudzai kuti, vanhu vacharegererwa zvivi zvose nokumhura kwose asi kumhura Mweya hakuzoregererwi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.31",
            "verseOrgIds": [
              "MAT.12.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 12:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani naani achataura zvakaipa pamusoro poMwanakomana woMunhu acharegererwa, asi ani naani achataura zvakaipa pamusoro poMweya Mutsvene haazoregererwi, kunyange panguva ino kana inouya.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.32",
            "verseOrgIds": [
              "MAT.12.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 12:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Itai kuti muti uve wakanaka uye michero yawo ichava yakanaka kana kuti itai kuti muti uve wakaipa, uye michero yawo ichava yakaipa, nokuti muti uchazivikanwa nemichero yawo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.33",
            "verseOrgIds": [
              "MAT.12.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 12:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imi vana venyoka, zvingaitike here kuti imi makaipa kudai mutaure chipi zvacho chakanaka? Nokuti muromo unotaura zviri mumwoyo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.34",
            "verseOrgIds": [
              "MAT.12.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 12:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munhu akanaka anobudisa zvakanaka zvagara zviri mudura romwoyo wake, uye munhu akaipa anobudisa zvakaipa zvagara zviri mudura romwoyo wake.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.35",
            "verseOrgIds": [
              "MAT.12.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MAT 12:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi ndinokuudzai kuti vanhu vachazvidavirira pamusi wokutongwa pamusoro peshoko rimwe nerimwe ravakataura risina maturo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.36",
            "verseOrgIds": [
              "MAT.12.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MAT 12:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti namashoko ako ucharuramisirwa, uye namashoko ako uchawanikwa une mhosva.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.37",
            "verseOrgIds": [
              "MAT.12.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Chiratidzo chaJona",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MAT 12:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo vamwe vaFarisi navadzidzisi vomurayiro vakati kwaari, \"Mudzidzisi, tinoda kuona chiratidzo chechishamiso kubva kwamuri.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.38",
            "verseOrgIds": [
              "MAT.12.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MAT 12:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akavapindura akati, \"Rudzi rwakaipa nerwoupombwe runokumbira chiratidzo! Asi hapana chiratidzo chichapiwa kwarwuri kunze chete kwechiratidzo chomuprofita Jona.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.39",
            "verseOrgIds": [
              "MAT.12.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "MAT 12:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti Jona sezvaakaita mazuva matatu nousiku hutatu ari mudumbu rehove huru, saizvozvo Mwanakomana woMunhu achava mumwoyo wenyika kwamazuva matatu nousiku hutatu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.40",
            "verseOrgIds": [
              "MAT.12.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MAT 12:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanhu veNinevhe vachamira pakutongwa pamwe chete norudzi urwu uye vacharupa mhosva; nokuti vakatendeuka pakuparidza kwaJona, uye zvino mukuru kuna Jona ari pano.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.41",
            "verseOrgIds": [
              "MAT.12.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "MAT 12:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambokadzi weZasi achasimuka pakutongwa pamwe chete norudzi urwu uye acharupa mhosva, nokuti akabva kumagumo enyika kuti azoteerera kuuchenjeri hwaSoromoni, uye zvino mukuru kuna Soromoni ari pano.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.42",
            "verseOrgIds": [
              "MAT.12.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "MAT 12:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kana mweya wakaipa wabva pano munhu, unofamba-famba nomunzvimbo dzakaoma uchitsvaka zororo asi unorishaya.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.43",
            "verseOrgIds": [
              "MAT.12.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "MAT 12:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo unoti, 'Ndichadzokera kumba kwandakabva.' Kana wasvika, unosvikowana imba iya isina ageremo, asi yakanyatsotsvairwa zvakachena nokunyatsorongedzwa zvakanaka.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.44",
            "verseOrgIds": [
              "MAT.12.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "MAT 12:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo unobva waenda kundotsvaka mimwe mweya minomwe yakaipa kukunda iwo, uye inopinda igogaramo. Uye kupedzisira kwomunhu uyu kwakaipa kupfuura kutanga kwake. Ndizvo zvazvichaita kurudzi urwu rwakaipa.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.45",
            "verseOrgIds": [
              "MAT.12.45"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mai vaJesu naVanunʼuna Vake",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "MAT 12:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu paakanga achiri kutaura kuvanhu vazhinji, mai vake navanunʼuna vake vakamira panze vachida kutaura naye.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.46",
            "verseOrgIds": [
              "MAT.12.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "MAT 12:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumwe akati kwaari, \"Mai venyu navanunʼuna venyu vamire panze, vari kuda kutaura nemi.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.47",
            "verseOrgIds": [
              "MAT.12.47"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "MAT 12:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akamupindura akati, \"Ko, mai vangu ndiani, navanunʼuna vangu ndivanaani?\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.48",
            "verseOrgIds": [
              "MAT.12.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "MAT 12:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achinongedzera vadzidzi vake akati, \"Ava ndivo mai vangu navanunʼuna vangu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.49",
            "verseOrgIds": [
              "MAT.12.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "MAT 12:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti ani naani anoita kuda kwaBaba vangu vari kudenga ndiye mununʼuna wangu nehanzvadzi yangu, namai vangu.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.50",
            "verseOrgIds": [
              "MAT.12.50"
            ]
          }
        }
      ]
    }
  ],
