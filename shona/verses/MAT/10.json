  "verseCount": 42,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "MAT 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jesu Anotuma Vane Gumi Navaviri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akadana vadzidzi vake gumi navaviri akavapa simba rokudzinga mweya yakaipa nokuporesa marudzi ose ezvirwere namarudzi ose ehosha.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.1",
            "verseOrgIds": [
              "MAT.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino aya ndiwo mazita avapostori gumi navaviri:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "MAT 10:2"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "MAT 10:2"
      },
      "items": [
        {
          "text": "wokutanga ndiSimoni ainzi Petro nomununʼuna wake Andirea;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.2",
            "verseOrgIds": [
              "MAT.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "MAT 10:2"
      },
      "items": [
        {
          "text": "Jakobho mwanakomana waZebhedhi nomununʼuna wake Johani;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.2",
            "verseOrgIds": [
              "MAT.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Firipi naBhatoromeo;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.3",
            "verseOrgIds": [
              "MAT.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "MAT 10:3"
      },
      "items": [
        {
          "text": "Tomasi naMateo muteresi;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.3",
            "verseOrgIds": [
              "MAT.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "MAT 10:3"
      },
      "items": [
        {
          "text": "Jakobho mwanakomana waArifeasi naTadheo;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.3",
            "verseOrgIds": [
              "MAT.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simoni muZiroti naJudhasi Iskarioti uyo akazomupandukira.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.4",
            "verseOrgIds": [
              "MAT.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akatuma gumi navaviri ava, akavarayira achiti, \"Musaenda munzira yeveDzimwe Ndudzi kana kupinda muguta ripi zvaro ravaSamaria.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.5",
            "verseOrgIds": [
              "MAT.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi endai kumakwai akarasika eimba yaIsraeri.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.6",
            "verseOrgIds": [
              "MAT.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamunoenda, muparidze muchiti, 'Umambo hwokudenga hwaswedera.'",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.7",
            "verseOrgIds": [
              "MAT.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Poresai vanorwara, mutsai vakafa, natsai vaya vana maperembudzi, dzingai madhimoni. Makagamuchira pasina muripo, chingopaiwo pasina muripo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.8",
            "verseOrgIds": [
              "MAT.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musatakura goridhe, kana sirivha kana ndarira, muzvikwama zvenyu;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.9",
            "verseOrgIds": [
              "MAT.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "musatakura hombodo yorwendo kana dzimwe nguo, shangu kana tsvimbo nokuti mushandi anofanira kurarama nomubayiro webasa rake.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.10",
            "verseOrgIds": [
              "MAT.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Muguta ripi neripi nomusha upi noupi wamunenge mapinda, tsvakai munhu akakodzera uye mugogara mumba make kusvikira mabvamo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.11",
            "verseOrgIds": [
              "MAT.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamunopinda mumusha, kwazisai vanenge varimo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.12",
            "verseOrgIds": [
              "MAT.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana musha uyu wakakodzera, rugare rwenyu ngaruuye pauri asi kana usina kukodzera, rugare rwenyu ngarudzokere kwamuri.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.13",
            "verseOrgIds": [
              "MAT.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana ani naani zvake akasakugamuchirai, kana kuteerera mashoko enyu, gumai guruva retsoka dzenyu pamunenge mobva pamusha ipapo kana muguta imomo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.14",
            "verseOrgIds": [
              "MAT.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinokuudzai chokwadi kuti zvichava nani kuSodhomu neGomora pazuva rokutongwa pane zvichaitwa kuguta iroro.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.15",
            "verseOrgIds": [
              "MAT.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndiri kukutumai samakwai pakati pamapere. Naizvozvo chenjerai senyoka uye mugova vasina mhosva senjiva.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.16",
            "verseOrgIds": [
              "MAT.10.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Chenjerai kuti vanhu vachakuisai kumatare uye vagokurovai mumasinagoge avo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.17",
            "verseOrgIds": [
              "MAT.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuda kwangu, vachakuendesai pamberi pavabati namadzishe kuti muve zvapupu zvangu kwavari nokune veDzimwe Ndudzi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.18",
            "verseOrgIds": [
              "MAT.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi kana vakusungai, musafunganya pamusoro pokuti muchataurei kana kuti muchataura sei. Panguva iyoyo muchapiwa zvokutaura,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.19",
            "verseOrgIds": [
              "MAT.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "nokuti munenge musiri imi munotaura, asi Mweya waBaba venyu uchataura nomamuri.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.20",
            "verseOrgIds": [
              "MAT.10.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mukoma achaurayisa mununʼuna wake, nababa mwana wavo, vana vachapandukira vabereki vavo uye vachavaurayisa.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.21",
            "verseOrgIds": [
              "MAT.10.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanhu vose vachakuvengai nokuda kwangu, asi uyo achatsungirira kusvikira kumagumo achaponeswa.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.22",
            "verseOrgIds": [
              "MAT.10.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana mukatambudzwa mune rimwe guta, tizirai kune rimwe. Ndinokuudzai chokwadi kuti hamungatizira kumaguta ose omuIsraeri Mwanakomana woMunhu asati adzoka.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.23",
            "verseOrgIds": [
              "MAT.10.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mudzidzi haasi mukuru kumudzidzisi wake, kana muranda kuna ishe wake.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.24",
            "verseOrgIds": [
              "MAT.10.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvakakwana kuti mudzidzi ave somudzidzisi wake nomurandawo sashe wake. Zvino kana mukuru weimba akanzi ndiBheerizebhubhi, vachadaro zvikuru sei kune veimba yake!",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.25",
            "verseOrgIds": [
              "MAT.10.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 10:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Naizvozvo musavatya. Hapana chakavanzika chisingazobudiswi pachena kana chakavigwa chisingazozivikanwi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.26",
            "verseOrgIds": [
              "MAT.10.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvandinokuudzai murima muzvitaure muchiedza; zvinozevezerwa munzeve dzenyu, muzviparidze muri pamusoro pedzimba.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.27",
            "verseOrgIds": [
              "MAT.10.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musatya avo vanouraya muviri asi vasingagoni kuuraya mweya. Asi ityai uyo anogona kuparadza zvose muviri nomweya mugehena.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.28",
            "verseOrgIds": [
              "MAT.10.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ko, shiri duku mbiri hadzitengeswi nesendi here? Kunyange zvakadaro hapana imwe chete yadzo inowira pasi kunze kwokunge Baba venyu vazvibvumira.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.29",
            "verseOrgIds": [
              "MAT.10.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 10:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye kunyange nebvudzi riri mumusoro yenyu rakaverengwa.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.30",
            "verseOrgIds": [
              "MAT.10.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 10:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo musatya nokuti munokosha kupfuura shiri duku zhinji.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.31",
            "verseOrgIds": [
              "MAT.10.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 10:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ani naani anondipupura pamberi pavanhu neniwo ndichamupupura pamberi paBaba vangu vari kudenga.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.32",
            "verseOrgIds": [
              "MAT.10.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi ani naani anondiramba pamberi pavanhu, neni ndichamurambawo pamberi paBaba vangu vari kudenga.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.33",
            "verseOrgIds": [
              "MAT.10.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 10:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Musafunga kuti ndakauya kuzouyisa rugare panyika. Handina kuuya kuzouyisa rugare asi munondo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.34",
            "verseOrgIds": [
              "MAT.10.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 10:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakauya kuti:",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.35",
            "verseOrgIds": [
              "MAT.10.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MAT 10:35"
      },
      "items": [
        {
          "text": "\" 'mwanakomana apesane nababa vake,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.35",
            "verseOrgIds": [
              "MAT.10.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MAT 10:35"
      },
      "items": [
        {
          "text": "mwanasikana apesane namai vake,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.35",
            "verseOrgIds": [
              "MAT.10.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MAT 10:35"
      },
      "items": [
        {
          "text": "muroora apesane navamwene vake,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.35",
            "verseOrgIds": [
              "MAT.10.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MAT 10:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "vavengi vomunhu vachava hama dzake dzomumba.'",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.36",
            "verseOrgIds": [
              "MAT.10.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MAT 10:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ani naani anoda baba vake kana mai vake kupfuura ini haana kukodzera kuva wangu; uye ani naani anoda mwanakomana kana mwanasikana wake kupfuura ini haana kukodzera kuva wangu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.37",
            "verseOrgIds": [
              "MAT.10.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MAT 10:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye uyo asingatakuri muchinjikwa wake akanditevera haana kukodzera kuva wangu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.38",
            "verseOrgIds": [
              "MAT.10.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MAT 10:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani naani anowana upenyu hwake acharasikirwa nahwo, asi uyo acharasikirwa noupenyu hwake nokuda kwangu achahuwana.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.39",
            "verseOrgIds": [
              "MAT.10.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "MAT 10:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Anokugamuchirai anogamuchira ini, uye anogamuchira ini anogamuchira iye akandituma.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.40",
            "verseOrgIds": [
              "MAT.10.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MAT 10:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani naani anogamuchira muprofita nokuti muprofita achagamuchira mubayiro womuprofita, uye ani naani anogamuchira munhu akarurama nokuda kwokuti akarurama, achagamuchira mubayiro womunhu akarurama.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.41",
            "verseOrgIds": [
              "MAT.10.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "MAT 10:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye kana munhu akapa mukombe wemvura inotonhorera kuno mumwe wavaduku ava nokuda kwokuti iye mudzidzi wangu, ndinokuudzai chokwadi kuti haazorasikirwi nomubayiro wake.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.42",
            "verseOrgIds": [
              "MAT.10.42"
            ]
          }
        }
      ]
    }
  ],
