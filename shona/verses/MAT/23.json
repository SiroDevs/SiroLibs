  "verseCount": 39,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "23",
        "style": "c",
        "sid": "MAT 23"
      },
      "items": [
        {
          "text": "23",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jesu Anotuka Vanyori nevaFarisi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Jesu akataura kuvanhu vazhinji nokuvadzidzi vake achiti,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.1",
            "verseOrgIds": [
              "MAT.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Vadzidzisi vomurayiro navaFarisi vagere pachigaro chaMozisi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.2",
            "verseOrgIds": [
              "MAT.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka munofanira kuvateerera muite zvinhu zvose zvavanokuudzai. Asi musaita zvavanoita, nokuti havaiti zvavanoparidza.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.3",
            "verseOrgIds": [
              "MAT.23.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanosunga mitoro inorema voitakudza pamafudzi avanhu, asi ivo pachavo havadi kusimudza munwe kuti vaibvise.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.4",
            "verseOrgIds": [
              "MAT.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Vanoita zvinhu zvose kuti vaonekwe navanhu. Vanotambanudza mafirakiteri avo uye vanorebesa pfunha dzenguo dzavo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.5",
            "verseOrgIds": [
              "MAT.23.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanoda zvigaro zvapamberi pamitambo nezvigaro zvapamusoro-soro mumasinagoge.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.6",
            "verseOrgIds": [
              "MAT.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanofarira kukwaziswa pamisika uye kuti vanzi 'Rabhi' navanhu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.7",
            "verseOrgIds": [
              "MAT.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Asi imi hamufaniri kunzi 'Rabhi' nokuti munongova naTenzi mumwe chete uye mose muri hama.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.8",
            "verseOrgIds": [
              "MAT.23.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musadana ani zvake ari panyika muchiti, 'Baba' nokuti munongova naBaba vamwe chete uye vari kudenga.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.9",
            "verseOrgIds": [
              "MAT.23.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye musadaidzwa muchinzi 'mudzidzisi' nokuti muno Mudzidzisi mumwe chete iye Kristu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.10",
            "verseOrgIds": [
              "MAT.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukuru pakati penyu ndiye achava muranda wenyu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.11",
            "verseOrgIds": [
              "MAT.23.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti ani naani anozvikudza achaninipiswa uye ani naani anozvininipisa achakudzwa.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.12",
            "verseOrgIds": [
              "MAT.23.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mune nhamo imi vadzidzisi vomurayiro nemi vaFarisi, vanyengeri! Nokuti munopfigira vanhu umambo hwedenga vachizviona. Imi pachenyu hamupindi, uye vaya vanoedza kupinda hamuvatenderi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.13",
            "verseOrgIds": [
              "MAT.23.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mune nhamo imi vadzidzisi vomurayiro nemi vaFarisi, vanyengeri! Munoparadza dzimba dzechirikadzi, uye munoita minyengetero mirefu kuti muonekwe. Naizvozvo muchatongwa zvakaomesesa.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.14",
            "verseOrgIds": [
              "MAT.23.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mune nhamo imi vadzidzisi vomurayiro nemi vaFarisi, vanyengeri! Munofamba panyika napamakungwa kuti mutendeutse munhu mumwe chete. Kana atendeuka munomuita mwanakomana wegehena kakapetwa kaviri panemi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.15",
            "verseOrgIds": [
              "MAT.23.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mune nhamo imi vatungamiri mapofu! Imi munoti, 'Kana munhu akapika netemberi, hazvina hazvo mhosva, asi kana munhu akapika negoridhe romutemberi anosungwa nemhiko yake.'",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.16",
            "verseOrgIds": [
              "MAT.23.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imi mapenzi amapofu! Chikuru chii: Goridhe netemberi inoita kuti goridhe rive dzvene?",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.17",
            "verseOrgIds": [
              "MAT.23.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyezve imi munoti, 'Kana munhu upi zvake akapika nearitari hazvirevi chinhu, asi kana munhu upi zvake akapika nechipo chiri pairi, asungwa nemhiko yake.'",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.18",
            "verseOrgIds": [
              "MAT.23.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imi mapofu! Chikuru chii: Chipo kana kuti aritari inoita kuti chipo chive chitsvene?",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.19",
            "verseOrgIds": [
              "MAT.23.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo, uyo anopika nearitari anopika nayo nezvose zviri pairi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.20",
            "verseOrgIds": [
              "MAT.23.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 23:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye uyo anopika netemberi anopika nayo uye naiye anogara mairi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.21",
            "verseOrgIds": [
              "MAT.23.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 23:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye uyo anopika nedenga anopika nechigaro choushe chaMwari uye naiye anogara pachiri.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.22",
            "verseOrgIds": [
              "MAT.23.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 23:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mune nhamo imi vadzidzisi vomurayiro nemi vaFarisi, imi vanyengeri! Munopa chegumi chezvose zvinonhuhwira zvinoti: mindi, anisi nekumini. Asi munoshaya hanya nezvinhu zvinokosha zvomurayiro zvinoti: kururamisira, ngoni nokutendeka. Maifanira kuita izviwo musingakanganwi zvokutanga.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.23",
            "verseOrgIds": [
              "MAT.23.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imi vatungamiri mapofu, munomimina nyunyu asi muchimedza ngamera.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.24",
            "verseOrgIds": [
              "MAT.23.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mune nhamo imi vadzidzisi vomurayiro nemi vaFarisi, imi vanyengeri! Munosuka mikombe nendiro kunze asi mukati menyu muzere namakaro nokusazvidzora.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.25",
            "verseOrgIds": [
              "MAT.23.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 23:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwe bofu romuFarisi! Tanga wachenesa mukati momukombe nendiro, uye ipapo kunze kwazvo kuchachenawo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.26",
            "verseOrgIds": [
              "MAT.23.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 23:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mune nhamo imi vadzidzisi vomurayiro nemi vaFarisi, imi vanyengeri! Makafanana namakuva akacheneswa kunze anoratidzika kuva akanaka kunze asi mukati muzere mapfupa avanhu vakafa nezvinhu zvose zvine tsvina.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.27",
            "verseOrgIds": [
              "MAT.23.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nenzira imwe cheteyo, munoonekwa navanhu kunze semakarurama asi mukati menyu muzere nounyengeri uye nohuipi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.28",
            "verseOrgIds": [
              "MAT.23.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 23:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mune nhamo imi vadzidzisi vomurayiro nemi vaFarisi, imi vanyengeri! Munovaka makuva avaprofita nokushongedza makuva avakarurama.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.29",
            "verseOrgIds": [
              "MAT.23.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 23:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye moti, 'Dai takanga tararama pamazuva amadzitateguru edu, tingadai tisina kubatsirana navo pakuteura ropa ravaprofita.'",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.30",
            "verseOrgIds": [
              "MAT.23.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 23:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka muri kuzvipupurira pachenyu kuti muri zvizvarwa zvaivavo vakaponda vaprofita.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.31",
            "verseOrgIds": [
              "MAT.23.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 23:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino chizadzisai chiyero chechivi chamadzitateguru enyu!",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.32",
            "verseOrgIds": [
              "MAT.23.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 23:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Imi nyoka! Imi vana venyoka! Muchatiza seiko kutongwa kunokuendesai kugehena?",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.33",
            "verseOrgIds": [
              "MAT.23.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 23:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo ndiri kukutumirai vaprofita navachenjeri navadzidzisi. Vamwe vavo muchavauraya uye muchavaroverera pamuchinjikwa; vamwe muchavarova mumasinagoge enyu uye muchavadzingirira kubva kune rimwe guta kusvikira kune rimwe guta.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.34",
            "verseOrgIds": [
              "MAT.23.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 23:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye nokudaro, ropa ravakarurama vose rakateurwa panyika richauya pamusoro penyu kubvira paropa raAbheri akanga akarurama kusvikira paropa raZekaria mwanakomana waBherekia uyo wamakauraya pakati petemberi nearitari.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.35",
            "verseOrgIds": [
              "MAT.23.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MAT 23:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinokuudzai chokwadi kuti zvose izvi zvichava pamusoro porudzi urwu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.36",
            "verseOrgIds": [
              "MAT.23.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MAT 23:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Iwe Jerusarema, Jerusarema! Iwe unouraya vaprofita nokutaka namabwe avo vanotumirwa kwauri, kazhinji sei kandaidisa kuunganidza vana vako sezvinoita nhunzvi yehuku inounganidza hukwana dzayo pasi pamapapiro ayo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.37",
            "verseOrgIds": [
              "MAT.23.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MAT 23:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tarira, wasiyirwa imba yako yangova dongo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.38",
            "verseOrgIds": [
              "MAT.23.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MAT 23:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinokuudza kuti, hauchazondionizve kusvikira wati, 'Akaropafadzwa anouya muzita raIshe.' \"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.39",
            "verseOrgIds": [
              "MAT.23.39"
            ]
          }
        }
      ]
    }
