  "verseCount": 13,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "MIC 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gomo raJehovha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MIC 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumazuva okupedzisira",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.1",
            "verseOrgIds": [
              "MIC.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 4:1"
      },
      "items": [
        {
          "text": "gomo retemberi yaJehovha richasimbiswa",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.1",
            "verseOrgIds": [
              "MIC.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:1"
      },
      "items": [
        {
          "text": "segomo guru pakati pamakomo;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.1",
            "verseOrgIds": [
              "MIC.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 4:1"
      },
      "items": [
        {
          "text": "richasimudzwa pamusoro pezvikomo,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.1",
            "verseOrgIds": [
              "MIC.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:1"
      },
      "items": [
        {
          "text": "uye marudzi achaenda kwariri.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.1",
            "verseOrgIds": [
              "MIC.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MIC 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndudzi zhinji dzichauya dzichiti,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.2",
            "verseOrgIds": [
              "MIC.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 4:2"
      },
      "items": [
        {
          "text": "\"Uyai, handei kugomo raJehovha,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.2",
            "verseOrgIds": [
              "MIC.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:2"
      },
      "items": [
        {
          "text": "kuimba yaMwari waJakobho.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.2",
            "verseOrgIds": [
              "MIC.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 4:2"
      },
      "items": [
        {
          "text": "Achatidzidzisa nzira dzake,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.2",
            "verseOrgIds": [
              "MIC.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:2"
      },
      "items": [
        {
          "text": "kuti tigofamba munzira dzake.\"",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.2",
            "verseOrgIds": [
              "MIC.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 4:2"
      },
      "items": [
        {
          "text": "Murayiro uchabuda kubva paZioni,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.2",
            "verseOrgIds": [
              "MIC.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:2"
      },
      "items": [
        {
          "text": "shoko raJehovha kubva paJerusarema.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.2",
            "verseOrgIds": [
              "MIC.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MIC 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achatonga pakati pamarudzi mazhinji",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.3",
            "verseOrgIds": [
              "MIC.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:3"
      },
      "items": [
        {
          "text": "uye achapedza gakava pakati pendudzi dzine simba dziri kure kure.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.3",
            "verseOrgIds": [
              "MIC.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 4:3"
      },
      "items": [
        {
          "text": "Vachapfura minondo yavo vagoiita mapadza,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.3",
            "verseOrgIds": [
              "MIC.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:3"
      },
      "items": [
        {
          "text": "namapfumo vachiaita mapanga okuchekerera miti.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.3",
            "verseOrgIds": [
              "MIC.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 4:3"
      },
      "items": [
        {
          "text": "Rudzi harungasimudziri rumwe rudzi munondo,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.3",
            "verseOrgIds": [
              "MIC.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:3"
      },
      "items": [
        {
          "text": "havangazodzidzirizve kurwa.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.3",
            "verseOrgIds": [
              "MIC.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MIC 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumwe nomumwe achagara pasi pomuzambiringa wake,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.4",
            "verseOrgIds": [
              "MIC.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:4"
      },
      "items": [
        {
          "text": "napasi pomuonde wake,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.4",
            "verseOrgIds": [
              "MIC.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 4:4"
      },
      "items": [
        {
          "text": "uye hapana anozovaita kuti vatye,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.4",
            "verseOrgIds": [
              "MIC.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:4"
      },
      "items": [
        {
          "text": "nokuti Jehovha Wamasimba Ose ataura.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.4",
            "verseOrgIds": [
              "MIC.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MIC 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndudzi dzose dzingafamba",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.5",
            "verseOrgIds": [
              "MIC.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:5"
      },
      "items": [
        {
          "text": "muzita ravamwari vadzo;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.5",
            "verseOrgIds": [
              "MIC.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 4:5"
      },
      "items": [
        {
          "text": "isu tichafamba muzita raJehovha",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.5",
            "verseOrgIds": [
              "MIC.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:5"
      },
      "items": [
        {
          "text": "Mwari wedu nokusingaperi-peri.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.5",
            "verseOrgIds": [
              "MIC.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Urongwa hwaJehovha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MIC 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Pazuva iro,\" ndizvo zvinotaura Jehovha,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.6",
            "verseOrgIds": [
              "MIC.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:6"
      },
      "items": [
        {
          "text": "\"Ndichaunganidza vakaremara;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.6",
            "verseOrgIds": [
              "MIC.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 4:6"
      },
      "items": [
        {
          "text": "ndichaunganidza vakadzingwa",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.6",
            "verseOrgIds": [
              "MIC.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:6"
      },
      "items": [
        {
          "text": "neavo vandakatambudza.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.6",
            "verseOrgIds": [
              "MIC.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MIC 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndicharemadza vakasara,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.7",
            "verseOrgIds": [
              "MIC.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:7"
      },
      "items": [
        {
          "text": "vaya vakadzingwa, ivo rudzi rwakasimba.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.7",
            "verseOrgIds": [
              "MIC.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 4:7"
      },
      "items": [
        {
          "text": "Jehovha achavatonga paGomo reZioni",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.7",
            "verseOrgIds": [
              "MIC.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:7"
      },
      "items": [
        {
          "text": "kubva pazuva iroro nokusingaperi.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.7",
            "verseOrgIds": [
              "MIC.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MIC 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana uri iwe, chirindo cheboka",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.8",
            "verseOrgIds": [
              "MIC.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:8"
      },
      "items": [
        {
          "text": "iwe nhare yoMwanasikana weZioni,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.8",
            "verseOrgIds": [
              "MIC.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 4:8"
      },
      "items": [
        {
          "text": "ushe hwakare huchadzoswa kwauri;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.8",
            "verseOrgIds": [
              "MIC.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:8"
      },
      "items": [
        {
          "text": "umambo huchauya kuMwanasikana weJerusarema.\"",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.8",
            "verseOrgIds": [
              "MIC.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MIC 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sei muchiridza mhere iye zvino,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.9",
            "verseOrgIds": [
              "MIC.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:9"
      },
      "items": [
        {
          "text": "hamuna mambo here?",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.9",
            "verseOrgIds": [
              "MIC.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 4:9"
      },
      "items": [
        {
          "text": "Gota renyu raparara here zvokuti kurwadza",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.9",
            "verseOrgIds": [
              "MIC.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:9"
      },
      "items": [
        {
          "text": "kwakubatai sekwomukadzi anosununguka?",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.9",
            "verseOrgIds": [
              "MIC.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MIC 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tambura ugomere,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.10",
            "verseOrgIds": [
              "MIC.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 4:10"
      },
      "items": [
        {
