  "verseCount": 16,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "MIC 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MIC 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shoko raJehovha rakauya kuna Mika weMoresheti panguva yokutonga kwaJotamu, Ahazi naHezekia, madzimambo aJudha, chiratidzo chaakaona pamusoro peSamaria neJerusarema.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.1",
            "verseOrgIds": [
              "MIC.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MIC 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inzwai, imi marudzi avanhu, imi mose,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.2",
            "verseOrgIds": [
              "MIC.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 1:2"
      },
      "items": [
        {
          "text": "teerera, iwe nyika navose vari mauri,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.2",
            "verseOrgIds": [
              "MIC.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 1:2"
      },
      "items": [
        {
          "text": "kuti Ishe Jehovha achakupai mhosva,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.2",
            "verseOrgIds": [
              "MIC.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 1:2"
      },
      "items": [
        {
          "text": "Jehovha ari mutemberi yake tsvene.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.2",
            "verseOrgIds": [
              "MIC.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kutongwa kweSamaria neJerusarema",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MIC 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tarirai! Jehovha ari kubuda panzvimbo yaanogara:",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.3",
            "verseOrgIds": [
              "MIC.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 1:3"
      },
      "items": [
        {
          "text": "anoburuka pasi agotsika panzvimbo dzakakwirira dzenyika.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.3",
            "verseOrgIds": [
              "MIC.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MIC 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makomo achanyongodeka pasi pake",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.4",
            "verseOrgIds": [
              "MIC.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 1:4"
      },
      "items": [
        {
          "text": "uye mipata ichapamuka,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.4",
            "verseOrgIds": [
              "MIC.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 1:4"
      },
      "items": [
        {
          "text": "senamo pamoto,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.4",
            "verseOrgIds": [
              "MIC.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 1:4"
      },
      "items": [
        {
          "text": "semvura inoyerera pamawere.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.4",
            "verseOrgIds": [
              "MIC.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MIC 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvose izvi zvakaitika nokuda kwokudarika kwaJakobho,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.5",
            "verseOrgIds": [
              "MIC.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 1:5"
      },
      "items": [
        {
          "text": "nokuda kwezvivi zveimba yaIsraeri.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.5",
            "verseOrgIds": [
              "MIC.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 1:5"
      },
      "items": [
        {
          "text": "Kudarika kwaJakobho ndokweiko?",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.5",
            "verseOrgIds": [
              "MIC.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 1:5"
      },
      "items": [
        {
          "text": "Hakuzi Samaria here?",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.5",
            "verseOrgIds": [
              "MIC.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 1:5"
      },
      "items": [
        {
          "text": "Nzvimbo yakakwirira yaJudha ndeipiko?",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.5",
            "verseOrgIds": [
              "MIC.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 1:5"
      },
      "items": [
        {
          "text": "Haizi Jerusarema here?",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.5",
            "verseOrgIds": [
              "MIC.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MIC 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Naizvozvo ndichaita Samaria murwi wamabwe,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.6",
            "verseOrgIds": [
              "MIC.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 1:6"
      },
      "items": [
        {
          "text": "nzvimbo yokusima minda yemizambiringa.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.6",
            "verseOrgIds": [
              "MIC.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MIC 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvose zvifananidzo zvaro zvichaputswa kuita zvimedu;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.7",
            "verseOrgIds": [
              "MIC.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 1:7"
      },
      "items": [
        {
          "text": "zvose zvipo zvaro zvomutemberi zvichapiswa nomoto;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.7",
            "verseOrgIds": [
              "MIC.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 1:7"
      },
      "items": [
        {
          "text": "ndichaparadza zvifananidzo zvaro zvose.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.7",
            "verseOrgIds": [
              "MIC.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 1:7"
      },
      "items": [
        {
          "text": "Sezvo akaunganidza zvipo zvake kubva pamibayiro yezvifeve,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.7",
            "verseOrgIds": [
              "MIC.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 1:7"
      },
      "items": [
        {
          "text": "semibayiro yezvifeve zvichazoshandiswa zvakare.\"",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.7",
            "verseOrgIds": [
              "MIC.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kuchema noKuungudza",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MIC 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuda kwaizvozvo ndichachema uye ndigoungudza;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.8",
            "verseOrgIds": [
              "MIC.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 1:8"
      },
      "items": [
        {
          "text": "ndichafamba ndisina shangu mutsoka uye ndisina kupfeka.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.8",
            "verseOrgIds": [
              "MIC.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 1:8"
      },
      "items": [
        {
          "text": "Ndichaungudza segava",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.8",
            "verseOrgIds": [
              "MIC.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 1:8"
      },
      "items": [
        {
          "text": "uye ndichachema sezizi.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.8",
            "verseOrgIds": [
              "MIC.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MIC 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti ronda rake harirapiki;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.9",
            "verseOrgIds": [
              "MIC.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 1:9"
      },
      "items": [
        {
          "text": "rasvika kuna Judha.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.9",
            "verseOrgIds": [
              "MIC.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 1:9"
      },
      "items": [
        {
          "text": "Rasvika pasuo ravanhu vangu chaipo,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.9",
            "verseOrgIds": [
              "MIC.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 1:9"
      },
      "items": [
        {
          "text": "kunyange kuJerusarema chaiko.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.9",
            "verseOrgIds": [
              "MIC.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MIC 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musazvireva paGati;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.10",
            "verseOrgIds": [
              "MIC.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 1:10"
      },
      "items": [
        {
          "text": "musambochema.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.10",
            "verseOrgIds": [
              "MIC.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 1:10"
      },
      "items": [
        {
          "text": "MuBheti Ofira",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.10",
            "verseOrgIds": [
              "MIC.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 1:10"
      },
      "items": [
        {
          "text": "umburukai muguruva.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.10",
            "verseOrgIds": [
              "MIC.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MIC 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pfuurai muende musina kupfeka mukunyara,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.11",
            "verseOrgIds": [
              "MIC.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 1:11"
      },
      "items": [
        {
          "text": "imi munogara muShafiri.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.11",
            "verseOrgIds": [
              "MIC.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 1:11"
      },
      "items": [
        {
          "text": "Avo vanogara muZaanani",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.11",
            "verseOrgIds": [
              "MIC.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 1:11"
      },
      "items": [
        {
          "text": "havangabudi kunze.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.11",
            "verseOrgIds": [
              "MIC.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 1:11"
      },
      "items": [
        {
          "text": "Bheti Ezeri riri mukuchema;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.11",
            "verseOrgIds": [
              "MIC.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 1:11"
      },
      "items": [
        {
          "text": "kudzivirirwa kwaro kwabviswa kubva kwariri.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.11",
            "verseOrgIds": [
              "MIC.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
