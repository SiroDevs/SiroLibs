            "sid": "MIC 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Zvirokwazvo ndichakuunganidzai imi mose, iwe Jakobho;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.12",
            "verseOrgIds": [
              "MIC.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 2:12"
      },
      "items": [
        {
          "text": "zvirokwazvo ndichaunganidza pamwe chete vakasara vaIsraeri.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.12",
            "verseOrgIds": [
              "MIC.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 2:12"
      },
      "items": [
        {
          "text": "Ndichavaunganidza pamwe chete samakwai muchirugu,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.12",
            "verseOrgIds": [
              "MIC.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 2:12"
      },
      "items": [
        {
          "text": "seboka pamafuro aro; nzvimbo yacho ichazara navanhu.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.12",
            "verseOrgIds": [
              "MIC.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MIC 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyo achaparura nzira achaenda pamberi pavo;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.13",
            "verseOrgIds": [
              "MIC.2.13"
            ]
          }
        }
      ]
