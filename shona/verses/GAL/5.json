{
  "id": "GAL.5",
  "number": "5",
  "bookId": "GAL",
  "reference": "VaGaratia 5",
  "copyright": "Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi™ Kopakodzero © 2005, 2018 ne Biblica, Inc. Biblica® Open Shona Contemporary Bible™ Copyright © 2005, 2018 by Biblica, Inc.",
  "verseCount": 26,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "GAL 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kusununguka muna Kristu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GAL 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kristu akatisunungura kuti tive vakasununguka. Zvino, mirai nesimba, murege kuzviremedza zvakare nejoko routapwa.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.1",
            "verseOrgIds": [
              "GAL.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GAL 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batai mashoko angu! Ini, Pauro, ndinokuudzai kuti kana muchidzingiswa, Kristu haachakosheswi kwamuri napaduku.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.2",
            "verseOrgIds": [
              "GAL.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GAL 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyezve, ndinotaura kumunhu wose anoda kudzingiswa kuti anofanira kuteerera murayiro wose.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.3",
            "verseOrgIds": [
              "GAL.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GAL 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imi munoedza kururamisirwa nomurayiro makaparadzaniswa naKristu; makabva panyasha.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.4",
            "verseOrgIds": [
              "GAL.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GAL 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi nokutenda tinoshinga kwazvo kumirira kururama, kunova ndiko kwatine tariro nako kubudikidza noMweya.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.5",
            "verseOrgIds": [
              "GAL.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GAL 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti muna Kristu Jesu kudzingiswa kana kusadzingiswa hazvina maturo. Chinhu chinokosha chete ndiko kutenda kunozviratidza kubudikidza norudo.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.6",
            "verseOrgIds": [
              "GAL.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GAL 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makanga muchimhanya nhangemutange yakanaka. Ndianiko akakudzivisai uye akakukonesai kuteerera chokwadi?",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.7",
            "verseOrgIds": [
              "GAL.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GAL 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kugombedzera ikoko hakuna kubva kuna iye anokudanai.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.8",
            "verseOrgIds": [
              "GAL.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GAL 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbiriso shoma inovirisa chikanyiwa chose chakakanyiwa.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.9",
            "verseOrgIds": [
              "GAL.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GAL 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinovimba muna She kuti hamuchazogamuchiri dzimwe pfungwa. Iyeye anokunyonganisai achazviripira mhaka yake, angava ani zvake.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.10",
            "verseOrgIds": [
              "GAL.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GAL 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hama dzangu, kana ndichiri kuparidza nezvokudzingiswa, ko, ndichiri kutambudzirwei hangu? Naizvozvo kugumbusa kwomuchinjikwa kwabviswa.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.11",
            "verseOrgIds": [
              "GAL.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GAL 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana vari vaya vanokukuchidzirai, ndaida hangu kuti vazvigure zvinhu zvavo.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.12",
            "verseOrgIds": [
              "GAL.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GAL 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imi, hama dzangu, makadanwa kuti muve vakasununguka. Asi regai kushandisa rusununguko rwenyu munyama; asi shandiranai murudo.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.13",
            "verseOrgIds": [
              "GAL.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GAL 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Murayiro wose unobatanidzwa mumurayiro mumwe chete unoti: \"Ude wokwako sezvaunozvida iwe.\"",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.14",
            "verseOrgIds": [
              "GAL.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GAL 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana muchiramba muchirumana uye nokudyana, chenjererai kuti murege kuparadzana mumwe nomumwe wenyu.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.15",
            "verseOrgIds": [
              "GAL.5.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Upenyu noMweya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GAL 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka ndinoti, raramai noMweya, uye hamungazofadzi nyama nokuchiva kwayo.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.16",
            "verseOrgIds": [
              "GAL.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GAL 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti nyama inoshuva zvinopesana noMweya, uye Mweya anopesanawo nezvinoshuviwa nenyama. Izvi zvinorwisana pachazvo, kuti murege kuita zvamunoda.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.17",
            "verseOrgIds": [
              "GAL.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GAL 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi kana muchitungamirirwa noMweya, hamusi pasi pomurayiro.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.18",
            "verseOrgIds": [
              "GAL.5.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GAL 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mabasa enyama ndiwo aya: upombwe, tsvina, utere;",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.19",
            "verseOrgIds": [
              "GAL.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GAL 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "kunamata zvifananidzo, uroyi, ruvengo, gakava, godo, kutsamwa, kuzvikudza, kuparadzana, dzidziso dzakatsauka",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.20",
            "verseOrgIds": [
              "GAL.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GAL 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "nokugodorana; kudhakwa, kutamba kwakaipa, nezvimwe zvakadaro. Ndinokuyambirai, sezvandakamboita kare kuti avo vana mararamiro iwaya havangagari nhaka youmambo hwaMwari.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.21",
            "verseOrgIds": [
              "GAL.5.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GAL 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi chibereko choMweya ndirwo rudo, mufaro, rugare, mwoyo murefu, unyoro, kunaka, kutendeka,",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.22",
            "verseOrgIds": [
              "GAL.5.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GAL 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "kupfava uye kuzvidzora. Hakuna murayiro unopesana nezvizvi.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.23",
            "verseOrgIds": [
              "GAL.5.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GAL 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avo vari vaKristu Jesu vakaroverera pamuchinjikwa nyama nokuchiva kwayo uye nezvainoshuva.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.24",
            "verseOrgIds": [
              "GAL.5.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GAL 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sezvo tichirarama noMweya, ngatifambei noMweya.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.25",
            "verseOrgIds": [
              "GAL.5.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GAL 5:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngatiregei kuzvikudza, tichitsamwisana kana kuchiva zvevamwe.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.26",
            "verseOrgIds": [
              "GAL.5.26"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "GAL.6",
    "number": "6",
