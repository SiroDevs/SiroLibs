      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ZEP 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shoko raJehovha rakasvika kuna Zefania, mwanakomana waKushi, mwanakomana waGedharia, mwanakomana waAmaria, mwanakomana waHezekia, pamazuva okutonga kwaJosia mwanakomana waAmoni mambo weJudha richiti:",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.1",
            "verseOrgIds": [
              "ZEP.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yambiro yokuuya kwoKuparadzwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEP 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndichatsvaira zvose",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.2",
            "verseOrgIds": [
              "ZEP.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 1:2"
      },
      "items": [
        {
          "text": "kubva pamusoro penyika,\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.2",
            "verseOrgIds": [
              "ZEP.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q4",
        "vid": "ZEP 1:2"
      },
      "items": [
        {
          "text": "ndizvo zvinotaura Jehovha.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEP 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndichatsvaira zvose vanhu nemhuka;",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.3",
            "verseOrgIds": [
              "ZEP.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 1:3"
      },
      "items": [
        {
          "text": "ndichatsvaira shiri dzedenga nehove dzegungwa.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.3",
            "verseOrgIds": [
              "ZEP.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEP 1:3"
      },
      "items": [
        {
          "text": "Vakaipa vachasara nemirwi yamarara chete,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.3",
            "verseOrgIds": [
              "ZEP.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 1:3"
      },
      "items": [
        {
          "text": "kana ndabvisa munhu pamusoro penyika,\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.3",
            "verseOrgIds": [
              "ZEP.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q4",
        "vid": "ZEP 1:3"
      },
      "items": [
        {
          "text": "ndizvo zvinotaura Jehovha.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kurwiswa kweJudha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEP 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndichatambanudza ruoko rwangu kuti ndirwise Judha",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.4",
            "verseOrgIds": [
              "ZEP.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 1:4"
      },
      "items": [
        {
          "text": "uye ndicharwisa vose vanogara muJerusarema.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.4",
            "verseOrgIds": [
              "ZEP.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEP 1:4"
      },
      "items": [
        {
          "text": "Ndichaparadza kubva panzvimbo ino vose vakasara vaBhaari,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.4",
            "verseOrgIds": [
              "ZEP.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 1:4"
      },
      "items": [
        {
          "text": "mazita avaprista vechihedheni vanonamata zvifananidzo,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.4",
            "verseOrgIds": [
              "ZEP.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEP 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "vaya vanopfugama pamusoro pedzimba",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.5",
            "verseOrgIds": [
              "ZEP.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 1:5"
      },
      "items": [
        {
          "text": "kuti vanamate nyeredzi dzedenga,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.5",
            "verseOrgIds": [
              "ZEP.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEP 1:5"
      },
      "items": [
        {
          "text": "vaya vanopfugama vachipika naJehovha",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.5",
            "verseOrgIds": [
              "ZEP.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 1:5"
      },
      "items": [
        {
          "text": "uye vanopikawo naMoreki,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.5",
            "verseOrgIds": [
              "ZEP.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEP 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "vaya vanotsauka kubva pakutevera Jehovha",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.6",
            "verseOrgIds": [
              "ZEP.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 1:6"
      },
      "items": [
        {
          "text": "uye vasingatsvaki Jehovha kana kubvunza kwaari.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.6",
            "verseOrgIds": [
              "ZEP.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEP 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyararai pamberi paIshe Jehovha,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.7",
            "verseOrgIds": [
              "ZEP.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 1:7"
      },
      "items": [
        {
          "text": "nokuti zuva raJehovha rava pedyo.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.7",
            "verseOrgIds": [
              "ZEP.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEP 1:7"
      },
      "items": [
        {
          "text": "Jehovha agadzirira chibayiro;",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.7",
            "verseOrgIds": [
              "ZEP.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 1:7"
      },
      "items": [
        {
          "text": "akavaita vatsvene, vaya vaakakoka.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.7",
            "verseOrgIds": [
              "ZEP.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEP 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pazuva rechibayiro chaJehovha,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.8",
            "verseOrgIds": [
              "ZEP.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 1:8"
      },
      "items": [
        {
          "text": "ndicharova machinda",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.8",
            "verseOrgIds": [
              "ZEP.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 1:8"
      },
      "items": [
        {
          "text": "navanakomana vamambo,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.8",
            "verseOrgIds": [
              "ZEP.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEP 1:8"
      },
      "items": [
        {
          "text": "navaya vose vakapfeka",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.8",
            "verseOrgIds": [
              "ZEP.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 1:8"
      },
      "items": [
        {
          "text": "nguo dzavatorwa.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.8",
            "verseOrgIds": [
              "ZEP.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEP 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pazuva iro ndicharanga",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.9",
            "verseOrgIds": [
              "ZEP.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 1:9"
      },
      "items": [
        {
          "text": "vose vanonyenyeredza kuti vasatsika paburiro,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.9",
            "verseOrgIds": [
              "ZEP.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEP 1:9"
      },
      "items": [
        {
          "text": "vanozadza temberi yavamwari vavo",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.9",
            "verseOrgIds": [
              "ZEP.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 1:9"
      },
      "items": [
        {
          "text": "nechisimba nounyengeri.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.9",
            "verseOrgIds": [
              "ZEP.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ZEP 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Pazuva iro,\" ndizvo zvinotaura Jehovha,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.10",
            "verseOrgIds": [
              "ZEP.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 1:10"
      },
      "items": [
        {
          "text": "\"kuchema kuchanzwikwa kubva kuSuo reHove,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.10",
            "verseOrgIds": [
              "ZEP.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 1:10"
      },
      "items": [
        {
          "text": "kuungudza kubva kuRutivi Rutsva rweguta,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.10",
            "verseOrgIds": [
              "ZEP.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 1:10"
      },
      "items": [
        {
          "text": "nokukoromoka kukuru kubva kuzvikomo.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.10",
            "verseOrgIds": [
              "ZEP.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEP 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ungudzai imi munogara munharaunda yomusika,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.11",
            "verseOrgIds": [
              "ZEP.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 1:11"
      },
      "items": [
        {
          "text": "vashambadzi venyu vose vachaparadzwa,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.11",
            "verseOrgIds": [
              "ZEP.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 1:11"
      },
      "items": [
        {
          "text": "vose vanotengesa nesirivha vachaparadzwa.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.11",
            "verseOrgIds": [
              "ZEP.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ZEP 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panguva iyoyo ndichanzvera Jerusarema nomwenje;",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.12",
            "verseOrgIds": [
              "ZEP.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 1:12"
      },
      "items": [
        {
          "text": "uye ndicharanga vaya vagere zvavo,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.12",
            "verseOrgIds": [
              "ZEP.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
