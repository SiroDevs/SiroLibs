          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unganai pamwe chete, unganai pamwe chete,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.1",
            "verseOrgIds": [
              "ZEP.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 2:1"
      },
      "items": [
        {
          "text": "imi rudzi runonyadzisa,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.1",
            "verseOrgIds": [
              "ZEP.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEP 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "nguva dzakatarwa dzisati dzasvika",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.2",
            "verseOrgIds": [
              "ZEP.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 2:2"
      },
      "items": [
        {
          "text": "uye zuva iroro risati rapfuura sehundi,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.2",
            "verseOrgIds": [
              "ZEP.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEP 2:2"
      },
      "items": [
        {
          "text": "kutsamwa kukuru kwaJehovha kusati kwauya pamusoro penyu,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.2",
            "verseOrgIds": [
              "ZEP.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 2:2"
      },
      "items": [
        {
          "text": "zuva rehasha dzaJehovha risati rauya pamusoro penyu.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.2",
            "verseOrgIds": [
              "ZEP.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEP 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsvakai Jehovha, imi mose vanyoro vapanyika,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.3",
            "verseOrgIds": [
              "ZEP.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 2:3"
      },
      "items": [
        {
          "text": "imi mose munoita zvaakarayira.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.3",
            "verseOrgIds": [
              "ZEP.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEP 2:3"
      },
      "items": [
        {
          "text": "Tsvakai kururama, tsvakai unyoro;",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.3",
            "verseOrgIds": [
              "ZEP.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 2:3"
      },
      "items": [
        {
          "text": "zvimwe mungadzivirirwa",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.3",
            "verseOrgIds": [
              "ZEP.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 2:3"
      },
      "items": [
        {
          "text": "pazuva rokutsamwa kwaJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.3",
            "verseOrgIds": [
              "ZEP.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kurwiswa kweFiristia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEP 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaza richasiyiwa",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.4",
            "verseOrgIds": [
              "ZEP.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 2:4"
      },
      "items": [
        {
          "text": "uye Ashikeroni richasiyiwa rava dongo.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.4",
            "verseOrgIds": [
              "ZEP.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEP 2:4"
      },
      "items": [
        {
          "text": "Pamasikati makuru Ashidhodhi richasiyiwa risisina chinhu",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.4",
            "verseOrgIds": [
              "ZEP.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 2:4"
      },
      "items": [
        {
          "text": "uye Ekironi radzurwa.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.4",
            "verseOrgIds": [
              "ZEP.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEP 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mune nhamo imi munogara pedyo negungwa,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.5",
            "verseOrgIds": [
              "ZEP.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 2:5"
      },
      "items": [
        {
          "text": "imi vanhu veKereti;",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.5",
            "verseOrgIds": [
              "ZEP.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEP 2:5"
      },
      "items": [
        {
          "text": "shoko raJehovha rinokurwisa,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.5",
            "verseOrgIds": [
              "ZEP.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 2:5"
      },
      "items": [
        {
          "text": "iwe Kenani nyika yavaFiristia.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.5",
            "verseOrgIds": [
              "ZEP.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEP 2:5"
      },
      "items": [
        {
          "text": "\"Ndichakuparadza,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.5",
            "verseOrgIds": [
              "ZEP.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 2:5"
      },
      "items": [
        {
          "text": "uye hapana achasara.\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.5",
            "verseOrgIds": [
              "ZEP.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEP 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyika iri pedyo negungwa, panogara vaKereti,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.6",
            "verseOrgIds": [
              "ZEP.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 2:6"
      },
      "items": [
        {
          "text": "ichava nzvimbo yavafudzi namatanga ehwai.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.6",
            "verseOrgIds": [
              "ZEP.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEP 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichava yavakasara veimba yavaJudha;",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.7",
            "verseOrgIds": [
              "ZEP.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 2:7"
      },
      "items": [
        {
          "text": "vachawana mafuro ikoko.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.7",
            "verseOrgIds": [
              "ZEP.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEP 2:7"
      },
      "items": [
        {
          "text": "Mumadekwana vachavata pasi",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.7",
            "verseOrgIds": [
              "ZEP.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 2:7"
      },
      "items": [
        {
          "text": "mudzimba dzaAshikeroni.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.7",
            "verseOrgIds": [
              "ZEP.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEP 2:7"
      },
      "items": [
        {
          "text": "Jehovha Mwari wavo achavachengeta;",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.7",
            "verseOrgIds": [
              "ZEP.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 2:7"
      },
      "items": [
        {
          "text": "Achavadzorera pfuma yavo.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.7",
            "verseOrgIds": [
              "ZEP.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kurwiswa kweMoabhu neAmoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEP 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndakanzwa kutuka kwaMoabhu",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.8",
            "verseOrgIds": [
              "ZEP.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 2:8"
      },
      "items": [
        {
          "text": "nokuzvidza kwavaAmoni,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.8",
            "verseOrgIds": [
              "ZEP.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEP 2:8"
      },
      "items": [
        {
          "text": "avo vakatuka vanhu vangu",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.8",
            "verseOrgIds": [
              "ZEP.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 2:8"
      },
      "items": [
        {
          "text": "uye vakatyisidzira nyika yavo.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.8",
            "verseOrgIds": [
              "ZEP.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEP 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo, zvirokwazvo noupenyu hwangu,\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.9",
            "verseOrgIds": [
              "ZEP.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 2:9"
      },
      "items": [
        {
          "text": "ndizvo zvinotaura Wamasimba Ose, Mwari waIsraeri,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.9",
            "verseOrgIds": [
              "ZEP.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEP 2:9"
      },
      "items": [
        {
          "text": "\"zvirokwazvo Moabhu achaita seSodhomu,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.9",
            "verseOrgIds": [
              "ZEP.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 2:9"
      },
      "items": [
        {
          "text": "vaAmoni seGomora,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.9",
            "verseOrgIds": [
              "ZEP.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEP 2:9"
      },
      "items": [
        {
          "text": "nzvimbo yesora namakomba emunyu,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.9",
            "verseOrgIds": [
              "ZEP.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 2:9"
      },
      "items": [
        {
          "text": "matongo nokusingaperi.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.9",
            "verseOrgIds": [
              "ZEP.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEP 2:9"
      },
      "items": [
        {
          "text": "Vakasara vavanhu vangu vachavapamba;",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.9",
            "verseOrgIds": [
              "ZEP.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 2:9"
      },
      "items": [
        {
          "text": "vachararama vorudzi rwangu vachagara nhaka yenyika yavo.\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.9",
            "verseOrgIds": [
              "ZEP.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ZEP 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izvi ndizvo zvavachawana nokuda kwokuzvikudza kwavo,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.10",
            "verseOrgIds": [
              "ZEP.2.10"
            ]
          }
        }
      ]
