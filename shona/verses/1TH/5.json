  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "1TH 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1TH 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino, hama, kana dziri nguva kana misi hatifaniri kuti tikunyorerei,",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.1",
            "verseOrgIds": [
              "1TH.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1TH 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "nokuti imi munoziva kwazvo kuti zuva raShe richauya sembavha usiku.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.2",
            "verseOrgIds": [
              "1TH.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1TH 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanhu pavanenge vachiti, \"Rugare norunyararo,\" kuparadzwa kuchasvika pamusoro pavo nokukurumidza, somukadzi ane mimba worwadziwa, uye havangapunyuki.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.3",
            "verseOrgIds": [
              "1TH.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1TH 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi imi, hama, hamusi murima zvokuti zuva iri rikusvikirei sembavha.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.4",
            "verseOrgIds": [
              "1TH.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1TH 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imi mose muri vanakomana vechiedza navanakomana vamasikati. Hatizi vousiku kana verima.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.5",
            "verseOrgIds": [
              "1TH.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1TH 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka zvino, ngatiregei kuita savamwe vavete, asi ngatisvinurei uye tive vanozvidzora.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.6",
            "verseOrgIds": [
              "1TH.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1TH 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti avo vanovata, vanovata usiku, uye avo vanodhakwa, vanodhakwa usiku.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.7",
            "verseOrgIds": [
              "1TH.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1TH 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi sezvo tiri vamasikati, ngatizvidzorei, takapfeka kutenda norudo sechidzitiro chechipfuva, netariro yoruponeso senguwani.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.8",
            "verseOrgIds": [
              "1TH.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1TH 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti Mwari haana kutisarudza kuti tive vokutsamwirwa asi kuti tigamuchire ruponeso kubudikidza naIshe wedu Jesu Kristu.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.9",
            "verseOrgIds": [
              "1TH.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1TH 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akatifira isu kuitira kuti, kunyange takasvinura kana tivete, tigare pamwe chete naye.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.10",
            "verseOrgIds": [
              "1TH.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1TH 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo kurudziranai uye muvakane, sezvamunoita zvino.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.11",
            "verseOrgIds": [
              "1TH.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kurayira Kwokupedzisira",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1TH 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino tinokukumbirai, hama, kuti muremekedze avo vanoshanda nesimba pakati penyu, vari pamusoro penyu muna She uye vanokurayirai.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.12",
            "verseOrgIds": [
              "1TH.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1TH 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muvakudze zvikuru murudo nokuda kwebasa ravo. Garai murunyararo nomumwe nomumwe wenyu.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.13",
            "verseOrgIds": [
              "1TH.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1TH 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye tinokukurudzirai, hama, kuti muyambire avo vano usimbe, mukurudzire vanotya, batsirai vasina simba, muite mwoyo murefu kuvanhu vose.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.14",
            "verseOrgIds": [
              "1TH.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1TH 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muve nechokwadi kuti kurege kuva nomunhu anodzorera chakaipa nechakaipa, asi edzai kuva nomwoyo munyoro kuno mumwe nomumwe wenyu uye nokuna vose.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.15",
            "verseOrgIds": [
              "1TH.5.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1TH 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Farai nguva dzose;",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.16",
            "verseOrgIds": [
              "1TH.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1TH 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "rambai muchinyengetera;",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.17",
            "verseOrgIds": [
              "1TH.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1TH 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "vongai pazvinhu zvose, nokuti ndiko kuda kwaMwari kwamuri muna Kristu Jesu.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.18",
            "verseOrgIds": [
              "1TH.5.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1TH 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musadzima moto woMweya;",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.19",
            "verseOrgIds": [
              "1TH.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1TH 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "musazvidza zviprofita.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.20",
            "verseOrgIds": [
              "1TH.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1TH 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Edzai zvinhu zvose. Batirirai kune zvakanaka.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.21",
            "verseOrgIds": [
              "1TH.5.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1TH 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Regai zvakaipa zvose.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.22",
            "verseOrgIds": [
              "1TH.5.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1TH 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwari pachake, iye Mwari worugare, ngaakuitei vatsvene kwazvo kwazvo. Mweya wenyu wose, nomwoyo uye nomuviri zvichengetwe zvisina mhosva pakuuya kwaIshe wedu Jesu Kristu.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.23",
            "verseOrgIds": [
              "1TH.5.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1TH 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anokudanai akatendeka uye achazviita.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.24",
            "verseOrgIds": [
              "1TH.5.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1TH 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hama, tinyengeterereiwo.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.25",
            "verseOrgIds": [
              "1TH.5.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1TH 5:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwazisai hama dzose nokutsvoda kutsvene.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.26",
            "verseOrgIds": [
              "1TH.5.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1TH 5:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinokurayirai pamberi paIshe kuti tsamba iyi iverengerwe hama dzose.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.27",
            "verseOrgIds": [
              "1TH.5.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1TH 5:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasha dzaIshe wedu Jesu Kristu ngadzive nemi.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.28",
            "verseOrgIds": [
              "1TH.5.28"
            ]
          }
        }
      ]
    }
