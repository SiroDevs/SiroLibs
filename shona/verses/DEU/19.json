  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "19",
        "style": "c",
        "sid": "DEU 19"
      },
      "items": [
        {
          "text": "19",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Maguta oUtiziro",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana Jehovha Mwari wenyu aparadza ndudzi dzaari kukupai nyika yadzo, uye kana muchinge madzidzinga mukagara mumaguta avo nedzimba dzavo,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.1",
            "verseOrgIds": [
              "DEU.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ipapo muzvitsaurire maguta matatu ari pakati penyika yamuri kupiwa naJehovha Mwari wenyu kuti ive yenyu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.2",
            "verseOrgIds": [
              "DEU.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mugadzire migwagwa inoenda kwaari uye mugoganhura, muzvikamu zvitatu nyika yamuri kupiwa naJehovha Mwari wenyu senhaka, kuitira kuti ani naani anenge auraya munhu agotizirako.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.3",
            "verseOrgIds": [
              "DEU.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyu ndiwo murayiro pamusoro pomunhu anenge auraya mumwe munhu anotizirako kuti aponese upenyu hwake, munhu anouraya muvakidzani wake asingazivi, asina kunge amuvenga kare.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.4",
            "verseOrgIds": [
              "DEU.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Somuenzaniso, munhu anogona kupinda musango nomuvakidzani wake kundotema huni, paanosimudza demo kuti ateme muti, demo rovhomoka rotema muvakidzani wake ofa. Munhu iyeye anogona kutizira kune rimwe ramaguta aya agoponesa mweya wake.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.5",
            "verseOrgIds": [
              "DEU.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvimwe, mutsivi weropa angamutevera mukutsamwa, akamubata kana rwendo rwuri rurefu kwazvo, akamuuraya kunyange zvake akanga asingafaniri kufa, sezvo asina kuzviita kumuvakidzani wake noruvengo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.6",
            "verseOrgIds": [
              "DEU.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndokusaka ndichikurayirai kuti muzvitsaurire maguta matatu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.7",
            "verseOrgIds": [
              "DEU.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana Jehovha Mwari wenyu achinge azokurisa nyika yenyu, sezvaakavimbisa madzitateguru enyu nemhiko, uye kana achinge akupai nyika yose yaakavimbisa,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.8",
            "verseOrgIds": [
              "DEU.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "nokuti mukachenjerera kutevera mirayiro iyi yose yandinokurayirai nhasi, kuti mude Jehovha Mwari wenyu uye mufambe munzira dzake nguva dzose, ipapo munofanira kutsaura maguta matatu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.9",
            "verseOrgIds": [
              "DEU.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muite izvi kuitira kuti ropa risina mhosva rirege kuteurwa munyika yenyu, yamuri kupiwa naJehovha Mwari wenyu kuti ive nhaka yenyu, uye kuti murege kuva nemhosva yokuteura ropa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.10",
            "verseOrgIds": [
              "DEU.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi kana munhu achivenga muvakidzani wake akamuvandira, akamurova uye akamuuraya, akatizira kune rimwe ramaguta aya,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.11",
            "verseOrgIds": [
              "DEU.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "vakuru veguta rake vanofanira kutuma munhu kuti andomutora kubva kuguta, uye vagomuisa mumaoko omutsivi weropa kuti afe.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.12",
            "verseOrgIds": [
              "DEU.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musamunzwira tsitsi. Munofanira kubvisa muIsraeri mhosva yokuteurwa kweropa risina mhaka, kuitira kuti zvigokunakirai.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.13",
            "verseOrgIds": [
              "DEU.19.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musabvisa dombo romuganhu nomuvakidzani wenyu, rakaiswa nevakakutangirai munhaka yamunogamuchira munyika yamunopiwa naJehovha Mwari wenyu kuti ive yenyu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.14",
            "verseOrgIds": [
              "DEU.19.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Zvapupu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chapupu chimwe chete hachifaniri kupupurira munhu kuti agobatwa nemhosva yokupupura mhaka, kunyange dai akapara mhaka. Nyaya inofanira kusimbiswa nouchapupu hwevaviri kana vatatu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.15",
            "verseOrgIds": [
              "DEU.19.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana chapupu chenhema chikapupurira munhu kuti ane mhaka,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.16",
            "verseOrgIds": [
              "DEU.19.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "varume ava vari vaviri vari kuitirana nharo vanofanira kumira pamberi paJehovha napamberi pavaprista navatongi vanenge vachitonga panguva iyoyo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.17",
            "verseOrgIds": [
              "DEU.19.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vatongi vanofanira kunyatsoferefeta nyaya iyi, zvino kana chapupu ichi chikabatwa kuti chinoreva nhema, chichipa uchapupu hwenhema pamusoro pehama yake,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.18",
            "verseOrgIds": [
              "DEU.19.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "ipapo itai kwaari sezvaanga achida kuita kuhama yake. Munofanira kubvisa chakaipa pakati penyu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.19",
            "verseOrgIds": [
              "DEU.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanhu vose vachanzwa izvi vagotya uye chakaipa chakadai hachizoitwizve pakati penyu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.20",
            "verseOrgIds": [
              "DEU.19.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musaratidza tsitsi, upenyu noupenyu, ziso neziso, zino nezino, ruoko noruoko, tsoka netsoka.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.21",
            "verseOrgIds": [
              "DEU.19.21"
            ]
          }
        }
      ]
    }
  ],
