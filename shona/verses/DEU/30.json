  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "30",
        "style": "c",
        "sid": "DEU 30"
      },
      "items": [
        {
          "text": "30",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kubudirira mushure mokudzokera kuna Jehovha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 30:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana kuropafadzwa nokutukwa uku kwose kwandaisa pamberi penyu kwakuwirai uye mazviisa pamwoyo kwose kwamunoparadzirwa naJehovha Mwari wenyu pakati pendudzi,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.1",
            "verseOrgIds": [
              "DEU.30.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 30:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye kana iwe navana vako ukadzokera kuna Jehovha Mwari wako ukamutereera nomwoyo wako wose nomweya wako wose maererano nezvose zvandakurayirai nhasi,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.2",
            "verseOrgIds": [
              "DEU.30.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 30:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ipapo Jehovha Mwari wenyu achakudzorerai pfuma yenyu agokunzwirai tsitsi nokukuunganidzai kubva kundudzi dzose kwaakakuparadzirai.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.3",
            "verseOrgIds": [
              "DEU.30.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 30:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunyange dai manga makarasirwa kunyika iri kure kwazvo pasi pedenga, kubva ikoko Jehovha Mwari wenyu achakuunganidzai uye agokudzosai.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.4",
            "verseOrgIds": [
              "DEU.30.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 30:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achakudzosai kunyika yamadzibaba enyu, uye muchaitora igova yenyu. Achakuitai kuti munyanyobudirira uye muwande kupfuura madzibaba enyu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.5",
            "verseOrgIds": [
              "DEU.30.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 30:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha Mwari wenyu achadzingisa mwoyo yenyu nemwoyo yezvizvarwa zvenyu, kuitira kuti mugomuda nomwoyo wenyu wose uye nomweya wenyu wose, mugorarama.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.6",
            "verseOrgIds": [
              "DEU.30.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 30:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha Mwari wenyu achaisa kutukwa uku kwose pamusoro pavavengi venyu vanokuvengai nokukutambudzai.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.7",
            "verseOrgIds": [
              "DEU.30.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muchateererazve Jehovha uye muchatevera mirayiro yake yose yandiri kukupai nhasi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.8",
            "verseOrgIds": [
              "DEU.30.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 30:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Jehovha Mwari wako achakupfumisa zvikuru mumabasa ose amaoko ako nechibereko chomuviri wako, nezvibereko zvezvipfuwo zvako uye nezvibereko zvevhu rako. Jehovha achafadzwazve newe agokupfumisa, sokufadzwa kwaakaitwa namadzibaba ako,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.9",
            "verseOrgIds": [
              "DEU.30.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 30:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "kana ukateerera Jehovha Mwari wako uye ukachengeta mirayiro yake nemitemo yake yakanyorwa mubhuku iri roMurayiro uye ukadzoka kuna Jehovha Mwari wako nomwoyo wako wose nomweya wako wose.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.10",
            "verseOrgIds": [
              "DEU.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kusarudza Upenyu kana Rufu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 30:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino zvandiri kukurayirai nhasi hazvina kunyanya kukuomerai kana kuva kure nemi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.11",
            "verseOrgIds": [
              "DEU.30.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 30:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hauzi kudenga, zvokuti mungabvunza muchiti, \"Ndiani achatikwirira kudenga kundoutora agotiparidzira kuti tiuite?\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.12",
            "verseOrgIds": [
              "DEU.30.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 30:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana kuti uri mhiri kwegungwa zvokuti mungabvunza muchiti, \"Ndiani angatiyambukira mhiri kundotitorera kuti atiparidzire kuti tiuite.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.13",
            "verseOrgIds": [
              "DEU.30.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 30:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwete, shoko riri pedyo newe kwazvo; riri mumuromo mako nomumwoyo mako kuti uriite.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.14",
            "verseOrgIds": [
              "DEU.30.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 30:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tarira, ndaisa pamberi pako nhasi upenyu noupfumi, uye rufu nokuparadzwa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.15",
            "verseOrgIds": [
              "DEU.30.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 30:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti ndinokurayira kuti ude Jehovha Mwari wako nhasi, kuti ufambe munzira dzake nguva dzose uye uchengete zvaakarayira, mitemo nemirayiro yake; ipapo uchararama ugowanda, uye Jehovha Mwari wako achakuropafadza munyika yauri kupinda kuti uitore.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.16",
            "verseOrgIds": [
              "DEU.30.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 30:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi kana mwoyo wako ukatsauka uye kana usingateereri, uye kana ukakwezvwa kuti undopfugamira vamwe vamwari ugovanamata,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.17",
            "verseOrgIds": [
              "DEU.30.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 30:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndinokuudza nhasi kuti uchaparadzwa zvirokwazvo. Haungararami kwenguva refu munyika yamuri kuyambuka Jorodhani kuti mupinde mugoitora.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.18",
            "verseOrgIds": [
              "DEU.30.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 30:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nhasi uno ndinodana denga nenyika kuti zvikupupurirei kuti ndaisa pamberi penyu upenyu nerufu, maropafadzo nokutukwa. Zvino sarudza upenyu, kuitira kuti iwe navana vako mugorarama.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.19",
            "verseOrgIds": [
              "DEU.30.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 30:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye ugoda Jehovha Mwari wako, uteerere inzwi rake, uye ugobatirira paari. Nokuti Jehovha ndiye upenyu hwako, uye achakupa makore mazhinji munyika yaakapika kuti achaipa kumadzibaba enyu Abhurahama, Isaka naJakobho.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.20",
            "verseOrgIds": [
              "DEU.30.20"
            ]
          }
        }
      ]
    }
  ],
