  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "DEU 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Usakanganwa Jehovha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muchenjerere kutevera murayiro mumwe nomumwe, wandinokupai nhasi, kuitira kuti mugorarama, mugowanda, mugopinda mugotora nyika iyo Jehovha akavimbisa madzitateguru enyu nemhiko.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.1",
            "verseOrgIds": [
              "DEU.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rangarirai matungamirirwo amakaitwa naJehovha Mwari wenyu munzira yose yomurenje makore ose aya makumi mana, achikuninipisai uye achikuedzai kuti azive zvaiva mumwoyo menyu, kana makanga muchida kuchengeta mirayiro yake kana kuti kwete.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.2",
            "verseOrgIds": [
              "DEU.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akakuninipisai, akakuitai kuti muziye nenzara akakugutsai nemana, iyo yakanga isingazivikanwi nemi kunyange namadzibaba enyu, kuti akudzidzisei kuti munhu haararame nechingwa chete asi neshoko rimwe nerimwe rinobva mumuromo maJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.3",
            "verseOrgIds": [
              "DEU.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nguo dzenyu hadzina kusakara uye tsoka dzenyu hadzina kuzvimba pamakore aya makumi mana.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.4",
            "verseOrgIds": [
              "DEU.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo zvizive mumwoyo wako kuti Jehovha Mwari wako anokuranga, somunhu anoranga mwanakomana wake.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.5",
            "verseOrgIds": [
              "DEU.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chengeta mirayiro yaJehovha Mwari wako, ufambe munzira dzake uye umukudze.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.6",
            "verseOrgIds": [
              "DEU.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti Jehovha Mwari wako ari kukuuyisa kunyika yakanaka, nyika ine hova dzemvura namatsime, nezvitubu zvinoerera mumupata nomumakomo;",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.7",
            "verseOrgIds": [
              "DEU.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "nyika ine zviyo nebhari, mizambiringa nemiti yemionde, neyemitamba, namafuta emiorivhi nouchi;",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.8",
            "verseOrgIds": [
              "DEU.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "nyika isingashayikwi chingwa uye hamuchazoshayiwi chinhu; nyika ine mabwe endarira uye uchachera mhangura mumakomo ayo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.9",
            "verseOrgIds": [
              "DEU.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana uchinge wadya waguta rumbidza Jehovha Mwari wako nokuda kwenyika yakanaka yaakakupa,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.10",
            "verseOrgIds": [
              "DEU.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "chenjera kuti urege kukanganwa Jehovha Mwari wako uchirega kuchengeta zvaakarayira, mirayiro yake nemitemo yake yandinokupai nhasi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.11",
            "verseOrgIds": [
              "DEU.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti zvichida kana wadya ukaguta, kana ukavaka dzimba dzakanaka uye wagadzikana,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.12",
            "verseOrgIds": [
              "DEU.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye kana mombe dzako namapoka amakwai ako zvawanda, nesirivha negoridhe rako zvawanda uye zvose zvaunazvo zvikawanda,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.13",
            "verseOrgIds": [
              "DEU.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ipapo mwoyo wako uchazvikudza zvino uchakanganwa Jehovha Mwari wako, akakubudisa kubva kuIjipiti, kubva kunyika youranda.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.14",
            "verseOrgIds": [
              "DEU.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akakutungamirirai murenje guru rinotyisa, munyika iyo yakaoma isina mvura, nenyoka dzayo nezvinyavada zvine uturu. Akakubudisirai mvura kubva padombo rakaoma.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.15",
            "verseOrgIds": [
              "DEU.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akakupai mana kuti mudye murenje, chinhu chakanga chisingambozivikanwi namadzibaba enyu, kuti akuninipisei nokukuedzai kuitira kuti zvikuitirei zvakanaka pakupedzisira.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.16",
            "verseOrgIds": [
              "DEU.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ungati mumwoyo mako, \"Simba rangu nesimba ramaoko angu ndizvo zvakandiitira upfumi uhu.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.17",
            "verseOrgIds": [
              "DEU.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi urangarire Jehovha Mwari wako, nokuti ndiye anokupa simba rokuita upfumi, naizvozvo achisimbisa sungano yake, yaakapikira madzitateguru enyu, sezvazviri nhasi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.18",
            "verseOrgIds": [
              "DEU.8.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana mukangokanganwa Jehovha Mwari wenyu muchitevera vamwe vamwari nokuvanamata uye nokuvapfugamira, ndinokupupurirai nhasi kuti zvirokwazvo muchaparadzwa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.19",
            "verseOrgIds": [
              "DEU.8.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imi muchaparadzwa sendudzi dzakaparadzwa naJehovha pamberi penyu, kana mukaramba kuteerera Jehovha Mwari wenyu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.20",
            "verseOrgIds": [
              "DEU.8.20"
            ]
          }
        }
      ]
    }
  ],
