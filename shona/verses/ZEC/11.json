{
  "id": "ZEC.11",
  "number": "11",
  "bookId": "ZEC",
  "reference": "Zekaria 11",
  "copyright": "Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi™ Kopakodzero © 2005, 2018 ne Biblica, Inc. Biblica® Open Shona Contemporary Bible™ Copyright © 2005, 2018 by Biblica, Inc.",
  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "11",
        "style": "c",
        "sid": "ZEC 11"
      },
      "items": [
        {
          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ZEC 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zarura mikova yako, iwe Rebhanoni,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.1",
            "verseOrgIds": [
              "ZEC.11.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 11:1"
      },
      "items": [
        {
          "text": "kuti moto uparadze misidhari yako!",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.1",
            "verseOrgIds": [
              "ZEC.11.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEC 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ungudza, iwe muti womupaini,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.2",
            "verseOrgIds": [
              "ZEC.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 11:2"
      },
      "items": [
        {
          "text": "nokuti musidhari wawa, miti yakaisvonaka yaparadzwa!",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.2",
            "verseOrgIds": [
              "ZEC.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 11:2"
      },
      "items": [
        {
          "text": "Ungudzai, imi miouki yeBhashani,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.2",
            "verseOrgIds": [
              "ZEC.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 11:2"
      },
      "items": [
        {
          "text": "nokuti dondo resango ratemwa!",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.2",
            "verseOrgIds": [
              "ZEC.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEC 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inzwai kuungudza kwavafudzi;",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.3",
            "verseOrgIds": [
              "ZEC.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 11:3"
      },
      "items": [
        {
          "text": "mafuro avo akapfuma aparadzwa!",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.3",
            "verseOrgIds": [
              "ZEC.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 11:3"
      },
      "items": [
        {
          "text": "Inzwai kuomba kweshumba,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.3",
            "verseOrgIds": [
              "ZEC.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 11:3"
      },
      "items": [
        {
          "text": "sango rinoyevedza reJorodhani raparadzwa!",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.3",
            "verseOrgIds": [
              "ZEC.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Vafudzi Vaviri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvanzi naJehovha Mwari wangu: \"Fudzai makwai akagadzirirwa kundobayiwa.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.4",
            "verseOrgIds": [
              "ZEC.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vatengi vawo vanoabaya vagoenda nawo vasina kurangwa. Avo vanoatengesa vanoti, 'Jehovha ngaakudzwe, ndapfuma!' Vafudzi vawo havangaaponesi.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.5",
            "verseOrgIds": [
              "ZEC.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti handichazonzwirizve vanhu venyika tsitsi,\" ndizvo zvinotaura Jehovha. \"Ndichaisa mumwe nomumwe kumuvakidzani wake uye kuna mambo wake. Vachamanikidza nyika, uye handingavanunuri kubva pamaoko avo.\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.6",
            "verseOrgIds": [
              "ZEC.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEC 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka ndakafudza makwai akatsaurirwa kundobayiwa kunyanya ainzwisa urombo. Ipapo ndakatora tsvimbo mbiri ndikatumidza imwe kuti Nyasha uye imwe Kubatana, uye ndakafudza makwai.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.7",
            "verseOrgIds": [
              "ZEC.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEC 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumwedzi mumwe chete ndakadzinga vafudzi vatatu.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.8",
            "verseOrgIds": [
              "ZEC.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ZEC 11:8"
      },
      "items": [
        {
          "text": "Boka rakandivenga, uye ndakatanga kuneta naro",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.8",
            "verseOrgIds": [
              "ZEC.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye ndikati, \"Handichazovi mufudzi wenyu. Regai makwai ari kufa afe, neari kuparara aparare. Regai ayo akasara adyanane nyama.\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.9",
            "verseOrgIds": [
              "ZEC.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ZEC 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo ndakatora tsvimbo yangu yainzi Nyasha ndikaivhuna, ndichiputsa sungano yandakanga ndaita nendudzi dzose.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.10",
            "verseOrgIds": [
              "ZEC.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEC 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakaputswa pazuva iroro, uye makwai airwadziwa akanga akanditarira akaziva kuti raiva shoko raJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.11",
            "verseOrgIds": [
              "ZEC.11.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ZEC 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakaaudza kuti, \"Kana muchiona zvakanaka, ndipei muripo wangu, asi kana zvisina, uchengetei.\" Nokudaro vakandipa mubayiro wangu wamakumi matatu esirivha.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.12",
            "verseOrgIds": [
              "ZEC.11.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ZEC 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha akati kwandiri, \"Ikande kumuumbi wehari, muripo wakanaka wavakanditenga nawo!\" Saka ndakatora makumi matatu esirivha aya ndikaakanda muimba yaJehovha kumuumbi wehari.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.13",
            "verseOrgIds": [
              "ZEC.11.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ZEC 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo ndakavhuna tsvimbo yangu yechipiri inonzi Kubatana ndichiputsa ukama hwakanga huripo pakati peJudha neIsraeri.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.14",
            "verseOrgIds": [
              "ZEC.11.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ZEC 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Jehovha akati kwandiri, \"Torazve nhumbi dzomufudzi benzi.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.15",
            "verseOrgIds": [
              "ZEC.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ZEC 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti ndichamutsa mufudzi panyika asingazovi nehanya neakarasika, kana kutsvaka makwayana, kana kurapa akakuvadzwa, kana kufudza akasimba, asi achadya nyama yamakwai akakora uye achabvambura mahwanda awo.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.16",
            "verseOrgIds": [
              "ZEC.11.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ZEC 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ane nhamo mufudzi asina maturo",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.17",
            "verseOrgIds": [
              "ZEC.11.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 11:17"
      },
      "items": [
        {
          "text": "anosiya makwai!",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.17",
            "verseOrgIds": [
              "ZEC.11.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 11:17"
      },
      "items": [
        {
          "text": "Munondo ngaubaye ruoko rwake uye neziso rake rokurudyi!",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.17",
            "verseOrgIds": [
              "ZEC.11.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 11:17"
      },
      "items": [
        {
          "text": "Ruoko rwake ngaruome zvachose,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.17",
            "verseOrgIds": [
              "ZEC.11.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 11:17"
      },
      "items": [
        {
          "text": "ziso rake rokurudyi ripofumadzwe zvachose!\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.17",
            "verseOrgIds": [
              "ZEC.11.17"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "ZEC.12",
    "number": "12",
