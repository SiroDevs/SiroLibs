  "verseCount": 13,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "ZEC 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Murume ane Rwodzi Rwokuyeresa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ZEC 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo ndakasimudza meso angu, zvino hapo pamberi pangu paiva nomurume aiva nerwodzi rwokuyeresa muruoko rwake!",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.1",
            "verseOrgIds": [
              "ZEC.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEC 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakabvunza ndikati, \"Uri kuendepiko?\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.2",
            "verseOrgIds": [
              "ZEC.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ZEC 2:2"
      },
      "items": [
        {
          "text": "Akandipindura achiti, \"Kunoyera Jerusarema, kuti ndione kufara kwaro nokureba kwaro.\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.2",
            "verseOrgIds": [
              "ZEC.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEC 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo mutumwa aitaura neni akaenda, uye mumwe mutumwa akauya kuzosangana naye",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.3",
            "verseOrgIds": [
              "ZEC.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye akati kwaari: \"Mhanya undoudza jaya iro kuti, 'Jerusarema richava guta risina masvingo nokuda kwokuwanda kwavanhu nezvipfuwo zviri mariri.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.4",
            "verseOrgIds": [
              "ZEC.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye ini pachangu ndichava rusvingo rwomoto rwakarikomberedza,' ndizvo zvinotaura Jehovha, 'uye ndichava kubwinya kwaro mukati maro.'",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.5",
            "verseOrgIds": [
              "ZEC.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Uyai! Uyai! Tizai kubva kunyika yokumusoro,\" ndizvo zvinotaura Jehovha, \"nokuti ndakakuparadzirai kumhepo ina dzedenga,\" ndizvo zvinotaura Jehovha.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.6",
            "verseOrgIds": [
              "ZEC.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEC 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Uya, iwe Zioni! Tiza, iwe unogara muMwanasikana weBhabhironi!\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.7",
            "verseOrgIds": [
              "ZEC.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEC 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti zvanzi naJehovha Wamasimba Ose, \"Mushure mokunge andikudza uye andituma kundorwisa ndudzi dzakakupambai, nokuti ani naani anokubatai anobata mboni yeziso rake,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.8",
            "verseOrgIds": [
              "ZEC.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "zvirokwazvo ndichasimudza ruoko rwangu kuti ndivarwise kuitira kuti nhapwa dzavo dzigovapamba. Ipapo muchaziva kuti Jehovha Wamasimba Ose akandituma.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.9",
            "verseOrgIds": [
              "ZEC.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ZEC 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Pembera uye ufare, iwe Mwanasikana weZioni. Nokuti ndiri kuuya, uye ndichagara pakati penyu,\" ndizvo zvinotaura Jehovha.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.10",
            "verseOrgIds": [
              "ZEC.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEC 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndudzi zhinji dzichabatana naJehovha pazuva iro uye vachava vanhu vangu. Ndichagara pakati penyu uye muchaziva kuti Jehovha Wamasimba Ose akandituma kwamuri.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.11",
            "verseOrgIds": [
              "ZEC.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ZEC 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Judha ichava nhaka yaJehovha somugove wake munyika tsvene uye achasarudzazve Jerusarema.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.12",
            "verseOrgIds": [
              "ZEC.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ZEC 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyararai pamberi paJehovha, vanhu vose, nokuti asimuka kubva panzvimbo yake tsvene yaanogara.\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.13",
            "verseOrgIds": [
              "ZEC.2.17"
            ]
          }
        }
      ]
    }
  ],
