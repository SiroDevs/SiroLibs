          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "muHadhidhi, Zebhoimi neNebharati,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.34",
            "verseOrgIds": [
              "NEH.11.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
