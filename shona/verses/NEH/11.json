          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvizvarwa zvaBhenjamini zvaibva kuGebha zvakagara muMikimashi, neAija neBheteri namaruwa acho,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.31",
            "verseOrgIds": [
              "NEH.11.31"
            ]
          }
        },
