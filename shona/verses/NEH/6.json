  "verseCount": 19,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "NEH 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kuvaka patsva kunopikiswazve",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NEH 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shoko rakati rasvika kuna Sanibharati, Tobhia naGeshemu muArabhu uye noruzhinji rwavavengi vedu kuti ndakanga ndavakazve rusvingo uye pakanga pasina chakanga chasara parwuri, kunyange panguva iyoyo ndakanga ndisati ndamisa makonhi pamasuo,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.1",
            "verseOrgIds": [
              "NEH.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NEH 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sanibharati naGeshemu vakatuma shoko kwandiri vachiti, \"Uya tisangane pano mumwe wemisha iri mubani reOno.\"",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.2",
            "verseOrgIds": [
              "NEH.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "NEH 6:2"
      },
      "items": [
        {
          "text": "Asi vakanga vachironga kundiitira zvakaipa.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.2",
            "verseOrgIds": [
              "NEH.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NEH 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka ndakatuma nhume kwavari nemhinduro ndichiti, \"Ndine basa guru kwazvo randiri kuita, saka handigoni kuburukira kwamuri ikoko. Basa ringamirireiko ini ndichirisiya ndichimbouya kwamuri?\"",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.3",
            "verseOrgIds": [
              "NEH.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NEH 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakatuma shoko rimwe chetero kwandiri runa rwose, asi ndakavapindura zvimwe chetezvo nguva dzose.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.4",
            "verseOrgIds": [
              "NEH.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NEH 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino, Sanibharati akatumazve muranda wake kwandiri kechishanu, neshoko rimwe chetero netsamba mumaoko ake yakanga isina kunamwa.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.5",
            "verseOrgIds": [
              "NEH.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NEH 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakanga yakanyorwa zvinoti:",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.6",
            "verseOrgIds": [
              "NEH.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "NEH 6:6"
      },
      "items": [
        {
          "text": "\"Pakati pamarudzi zvinotaurwa kuti, uye Geshemu anotiwo ichokwadi, iwe navaJudha muri kurangana kumukira mambo, ndokusaka muri kuvaka rusvingo. Pamusoro pezvo, iwe wava kuda kuva mambo wavo sokutaurwa kwazvo.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.6",
            "verseOrgIds": [
              "NEH.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NEH 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye wakatogadza vaprofita kuti vataure pamusoro pako muJerusarema vachiti: 'MuJudha mava namambo!' Zvino nyaya iyi ichasvika kuna mambo, saka uya titaurirane.\"",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.7",
            "verseOrgIds": [
              "NEH.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NEH 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakatumira mhinduro kwaari ndikati, \"Hapana chinhu chakaita sechauri kutaura chiri kuitika; ndiwe uri kungozvifunga mumusoro mako.\"",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.8",
            "verseOrgIds": [
              "NEH.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NEH 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vose vaingoedza kutivhundutsira vachiti mumwoyo yavo, \"Maoko avo achaneta nebasa, uye harizoperi.\"",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.9",
            "verseOrgIds": [
              "NEH.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "NEH 6:9"
      },
      "items": [
        {
          "text": "Asi ndakanyengetera ndikati, \"Simbisai maoko angu zvino.\"",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.9",
            "verseOrgIds": [
              "NEH.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NEH 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rimwe zuva ndakaenda kumba kwaShemaya mwanakomana waDheraya, mwanakomana waMehetabheri, uyo akanga azvipfigira mumba make, iye akati, \"Ngatisangane mumba yaMwari mukati metemberi tigopfiga mikova yetemberi, nokuti kuna varume vari kuuya kuzokuuraya, panguva dzousiku vari kuuya kuzokuuraya.\"",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.10",
            "verseOrgIds": [
              "NEH.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NEH 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi ini ndakati kwaari, \"Murume akaita seni angatiza here? Uye munhu akaita seni angatizira mutemberi kuti aponese upenyu hwake here? Handidi kuenda ini!\"",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.11",
            "verseOrgIds": [
              "NEH.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NEH 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakaona kuti Mwari akanga asina kumutuma asi kuti aiprofita zvakaipa pamusoro pangu nokuti akanga atengwa naTobhia naSanibharati.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.12",
            "verseOrgIds": [
              "NEH.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NEH 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akanga atengwa kuti azondivhundutsira kuitira kuti ndiite chivi nokuita izvi, uye ipapo vagondipa zita rakaipa kuti vandisvibise.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.13",
            "verseOrgIds": [
              "NEH.6.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NEH 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haiwa Mwari wangu, rangarirai henyu Tobhia naSanibharati, nokuda kwezvavaita; rangariraiwo muprofitakadzi Noadhia uye noruzhinji rwavaprofita avo vanga vachiedza kundivhundutsira.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.14",
            "verseOrgIds": [
              "NEH.6.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kupera kwoRusvingo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NEH 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo rusvingo rwakapera nezuva ramakumi maviri namashanu romwedzi waEruri, mumazuva makumi mashanu namaviri.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.15",
            "verseOrgIds": [
              "NEH.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NEH 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vavengi vedu vose vakati vanzwa izvi, marudzi ose akatipoteredza akatya uye vakaora mwoyo, nokuti vakaona kuti basa iri rakanga raitwa norubatsiro rwaMwari wedu.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.16",
            "verseOrgIds": [
              "NEH.6.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NEH 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyezve, mumazuva iwayo vakuru veJudha vaitumira matsamba akawanda kuna Tobhia, uye mhinduro dzaibva kuna Tobhia dzairamba dzichiuya kwavari.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.17",
            "verseOrgIds": [
              "NEH.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NEH 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti vazhinji muJudha vakanga vaita mhiko pasi pake, sezvo akanga ari mukuwasha kuna Shekania mwanakomana waAra, uye mwanakomana wake Jehohanani akanga akawana mwanasikana waMeshurami mwanakomana waBherekia.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.18",
            "verseOrgIds": [
              "NEH.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NEH 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamusoro paizvozvo, vairamba vachingondiudza mabasa ake akanaka uye ivo vachizomuudzawo zvandinenge ndataura. Uye Tobhia akatumira matsamba okundivhundutsira.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.19",
            "verseOrgIds": [
              "NEH.6.19"
            ]
          }
        }
      ]
    }
  ],
