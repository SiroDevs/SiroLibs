    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Vavaki voRusvingo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NEH 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino Eriashibhi muprista mukuru navamwe vaprista vakaenda kundoshanda uye vakavakazve Suo raMakwai. Vakarikumikidza vakaisa makonhi panzvimbo yawo, vakarivaka kunosvika paShongwe yeZana, iyo yavakakumikidza, kusvikira paShongwe yaHananeri.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.1",
            "verseOrgIds": [
              "NEH.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NEH 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Varume veJeriko vakavaka chikamu chaiva pedyo, uye Zakuri mwanakomana waImuri akavaka parutivi pavo.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.2",
            "verseOrgIds": [
              "NEH.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NEH 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Suo reHove rakavakwa navanakomana veHasenaya. Vakaisa matanda okuchinjika vakaisa makonhi aro namabhaudhi uye namazariro panzvimbo yawo.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.3",
            "verseOrgIds": [
              "NEH.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NEH 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meromoti mwanakomana waUria, mwanakomana waHakozi akagadzira chikamu chaitevera. Aimutevera pakugadzira aiva Meshurami mwanakomana waBherekia, mwanakomana waMeshebhezeri, uye aitevera mushure make, Zadhoki mwanakomana waBhaana, akagadzirawo.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.4",
            "verseOrgIds": [
              "NEH.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NEH 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chikamu chaitevera chakagadzirwa navarume veTekoa, asi vakuru vavo vakangopeta maoko avo vakasashandira Ishe wavo.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.5",
            "verseOrgIds": [
              "NEH.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NEH 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Suo raJeshana rakagadzirwa naJoyadha mwanakomana waPasea naMeshurami mwanakomana waBhesodheya. Vakaisa matanda aro okuchinjika ndokuisa makonhi namabhaudhi namazariro panzvimbo yawo.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.6",
            "verseOrgIds": [
              "NEH.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NEH 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvakatevera pakugadzirwa zvakaitwa navarume vaibva kuGibheoni neMizipa, naMeratia weGibheoni uye naJadhoni wokuMeronoti, nzvimbo dzaiva pasi pomubati wemhiri kweYufuratesi.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.7",
            "verseOrgIds": [
              "NEH.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NEH 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzieri mwanakomana waHaraya, mumwe wavapfuri vegoridhe, akagadzira chikamu chaitevera; uye Hanania, mumwe wavavhenganisi vezvinonhuhwira, akagadzira chikamu chaitevera ichocho. Vakavandudza Jerusarema kudzamara vasvika parusvingo rwakapamhama.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.8",
            "verseOrgIds": [
              "NEH.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NEH 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Refaya mwanakomana waHuri, mutongi wehafu yerimwe dunhu reJerusarema, akagadzira chikamu chaitevera.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.9",
            "verseOrgIds": [
              "NEH.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NEH 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakabatana navo, Jedhaya mwanakomana waHarumafi akagadzira chikamu chakatarisana neimba yake, uye Hatushi mwanakomana waHashabheneya akagadzira chikamu chaitevera.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.10",
            "verseOrgIds": [
              "NEH.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NEH 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Marikiya mwanakomana waHarimu naHashubhi mwanakomana waPahati-Moabhu vakagadzira chimwe chikamu uye neShongwe yeMahovhoni.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.11",
            "verseOrgIds": [
              "NEH.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NEH 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sharumi mwanakomana waHaroheshi, mutongi wehafu yerimwe dunhu reJerusarema, akagadzira chikamu chaitevera achibatsirwa navanasikana vake.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.12",
            "verseOrgIds": [
              "NEH.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NEH 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Suo roMupata rakagadzirwa naHanuni navagari veZanoa. Vakarivaka patsva ndokuisa makonhi aro namabhaudhi nemazariro esimbi panzvimbo yawo. Vakagadzirawo makubhiti chiuru chimwe",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.13",
            "verseOrgIds": [
              "NEH.3.13"
            ]
          }
        },
        {
          "text": "orusvingo kudzamara vasvika paSuo reNdove.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.13",
            "verseOrgIds": [
              "NEH.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NEH 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Marikiya mwanakomana waRekabhi, mutongi wedunhu reBheti Hakeremu, akagadzira Suo reNdove. Akarivaka patsva ndokuisa makonhi aro namabhaudhi namazariro panzvimbo yawo.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.14",
            "verseOrgIds": [
              "NEH.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NEH 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Suo reTsime rakagadzirwa naSharuni mwanakomana waKori-Hoze, mutongi wedunhu reMizipa. Akarivaka patsva ndokuisa denga namakonhi aro namabhaudhi uye akaisa nemazariro panzvimbo yawo. Akagadzirazve rusvingo rweDziva reSiroami, paBindu raMambo kusvikira pamatanho anoburukira kuGuta raDhavhidhi.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.15",
            "verseOrgIds": [
              "NEH.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NEH 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akamutevera ndiNehemia mwanakomana waAzubhuki mutongi wehafu yedunhu reBheti Zuri, akagadzira kusvikira panzvimbo yakatarisana nemakuva aDhavhidhi kusvikira padziva nokuImba yeMhare.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.16",
            "verseOrgIds": [
              "NEH.3.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NEH 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "VaRevhi vaiva pasi paRehumi mwanakomana waBhani vakamutevera pakugadzira. Parutivi pake, Hashabhia, mutongi wehafu yedunhu reKeira, akaita mabasa okugadzira panzvimbo yedunhu rake.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.17",
            "verseOrgIds": [
              "NEH.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NEH 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vaimutevera pakugadzira, vanhu venyika yavo vaiva pasi paBhinui mwanakomana waHenadhadhi, mutongi weimwe hafu yeKeira.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.18",
            "verseOrgIds": [
              "NEH.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NEH 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aimutevera ndiEzeri mwanakomana waJeshua, mutongi weMizipa, akagadzira chimwe chikamu kubva pamukwidza wakatarisana neimba yezvombo zvehondo kusvikira pakona.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.19",
            "verseOrgIds": [
              "NEH.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NEH 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bharuki mwanakomana waZabhai akamutevera, akagadzira chimwe chikamu nomwoyo wose kubva pakona zvichienda pamusuo weimba yaEriashibhi muprista mukuru.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.20",
            "verseOrgIds": [
              "NEH.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NEH 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aimutevera, ndiMeromoti mwanakomana waUria, mwanakomana waHakozi, akagadzira chimwe chikamu, kubva pamusuo weimba yaEriashibhi kusvikira painoguma.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.21",
            "verseOrgIds": [
              "NEH.3.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NEH 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvakagadzirwa mumashure make zvakaitwa navaprista vaibva mudunhu rakapoteredza.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.22",
            "verseOrgIds": [
              "NEH.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NEH 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumashure mavo, Bhenjamini naHashubhi vakazogadzira mberi kweimba yavo; uye aivatevera, Azaria mwanakomana waMaaseya, mwanakomana waAnania, akagadzira parutivi peimba yake.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.23",
            "verseOrgIds": [
              "NEH.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NEH 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aimutevera, Bhinui mwanakomana waHanadhadhi akagadzira chimwe chikamu, kubva paimba yaAzaria kusvikira pakona nokune imwezve kona,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.24",
            "verseOrgIds": [
              "NEH.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NEH 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye Parari mwanakomana waUzia akashanda pakatarisana nepakona uye napashongwe inobuda ichibva kumuzinda wokumusoro pedyo noruvazhe rwavarindi. Aimutevera, Pedhaya mwanakomana waParoshi",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.25",
            "verseOrgIds": [
              "NEH.3.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NEH 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "navashandi vomutemberi vaigara pamusoro pegomo reOferi vakagadzira kusvikira panzvimbo yakatarisana neSuo reMvura kwakananga kumabvazuva uye napanobudikira neshongwe.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.26",
            "verseOrgIds": [
              "NEH.3.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NEH 3:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vaivatevera, varume veTekoa vakagadzira chimwe chikamu, kubva panobuda shongwe huru kusvikira kurusvingo rweOferi.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.27",
            "verseOrgIds": [
              "NEH.3.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NEH 3:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vaprista vakagadzira pamusoro peSuo raMabhiza, mumwe nomumwe pamberi peimba yake.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.28",
            "verseOrgIds": [
              "NEH.3.28"
            ]
          }
        },
        {
