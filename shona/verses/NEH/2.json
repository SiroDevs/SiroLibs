  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "NEH 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Atazekisesi anotumira Nehemia kuJerusarema",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NEH 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumwedzi waNisani mugore ramakumi maviri raMambo Atazekisesi, panguva yaakavigirwa waini, ndakatora waini ndikapa kuna mambo. Handina kumbenge ndambosuruvara zvakadai pamberi pake.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.1",
            "verseOrgIds": [
              "NEH.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NEH 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka mambo akandibvunza akati, \"Ko, chiso chako chinoratidza kusuwa seiko iwe usingarwari? Hapangavi nechimwe chinhu asi shungu dzomwoyo bedzi.\"",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.2",
            "verseOrgIds": [
              "NEH.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "NEH 2:2"
      },
      "items": [
        {
          "text": "Ndakatya kwazvo,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.2",
            "verseOrgIds": [
              "NEH.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NEH 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "asi ndakati kuna mambo, \"Mambo ngaararame nokusingaperi! Ko, chiso changu chingatadza kupunyaira seiko kana guta rakavigwa madzibaba angu rava dongo uye masuo aro aparadzwa nomoto?\"",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.3",
            "verseOrgIds": [
              "NEH.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NEH 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo akati kwandiri, \"Chii chauri kuda?\"",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.4",
            "verseOrgIds": [
              "NEH.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "NEH 2:4"
      },
      "items": [
        {
          "text": "Ipapo ndakanyengetera kuna Mwari wokudenga,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.4",
            "verseOrgIds": [
              "NEH.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NEH 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndikapindura mambo ndichiti, \"Kana zvichifadza mambo uye kana muranda wenyu awana nyasha pamberi pake, mambo ngaanditumire kuguta riri kuJudha kwakavigwa madzibaba angu kuitira kuti ndinorivakazve.\"",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.5",
            "verseOrgIds": [
              "NEH.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NEH 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo mambo, navahosi vakagara parutivi pake, akandibvunza akati, \"Rwendo rwako runotora mazuva mangani, uye uchadzoka rinhi?\" Naizvozvo zvakafadza mambo kuti anditume; saka ndakatara nguva.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.6",
            "verseOrgIds": [
              "NEH.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NEH 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakatizve kwaari, \"Kana mambo achifadzwa nazvo, ndingapiwawo tsamba here dzinoenda kuvabati vari mhiri kwaYufuratesi, kuitira kuti vagondipa mvumo yokupfuura kusvikira ndasvika muJudha?",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.7",
            "verseOrgIds": [
              "NEH.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NEH 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye ndinokumbirawo tsamba inoenda kuna Asafi, muchengeti wesango ramambo, kuitira kuti azondipa matanda okuchinjika pamusoro pamasuo enhare iri patemberi uye neorusvingo rweguta neeimba yandichagara?\" Mambo akandipa zvandakakumbira, nokuti ruoko rwenyasha rwaMwari wangu rwaiva pamusoro pangu.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.8",
            "verseOrgIds": [
              "NEH.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NEH 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka ndakaenda kuvabati vaiva mhiri kwaYufuratesi ndikavapa tsamba dzamambo. Zvino mambo akanga atumawo pamwe chete neni vakuru vehondo navatasvi vamabhiza.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.9",
            "verseOrgIds": [
              "NEH.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NEH 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sanibharati muHoroni naTobhia muranda wavaAmoni pavakazvinzwa vakashatirwa kwazvo vachiti kwauya mumwe anoda kusimudzira magariro akanaka avaIsraeri.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.10",
            "verseOrgIds": [
              "NEH.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nehemia anoongorora Masvingo eJerusarema",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NEH 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo ndakaenda kuJerusarema ndikagarako kwamazuva matatu.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.11",
            "verseOrgIds": [
              "NEH.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NEH 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakamuka usiku navarume vashoma shoma. Ndakanga ndisina kumboudza munhu zvakanga zvaiswa mumwoyo mangu naMwari wangu kuti ndiite muJerusarema. Pakanga pasina chimwe chipfuwo kunze kwechandakanga ndakatasva.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.12",
            "verseOrgIds": [
              "NEH.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NEH 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakabuda usiku ndikapinda napaSuo roMupata ndakananga nokuTsime reShato nokuSuo raMarara, ndichiongorora masvingo eJerusarema, akanga akoromorwa, uye masuo awo, akanga aparadzwa nomoto.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.13",
            "verseOrgIds": [
              "NEH.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NEH 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo ndakapfuurira mberi ndakananga kuSuo reTsime nokuDziva raMambo, asi pakanga pasina nzvimbo yokupinda nechipfuwo changu;",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.14",
            "verseOrgIds": [
              "NEH.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NEH 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "saka ndakakwidza nokumupata nousiku, ndichiongorora rusvingo. Pakupedzisira, ndakadzoka ndikapindazve napakati peSuo roMupata.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.15",
            "verseOrgIds": [
              "NEH.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NEH 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vabati havana kuziva kwandakanga ndaenda kana zvandakanga ndichiita, nokuti ndakanga ndisati ndambotaura chinhu kuvaJudha kana kuvaprista kana vakuru kana vabati, kana vamwewo zvavo vaizoita basa.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.16",
            "verseOrgIds": [
              "NEH.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NEH 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo ndakati kwavari, \"Muri kuona dambudziko ratinaro here: Jerusarema rava dongo, uye masuo aro akapiswa nomoto. Uyai, ngativakeizve rusvingo rweJerusarema, kuti tisazonyadziswazve.\"",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.17",
            "verseOrgIds": [
              "NEH.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NEH 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakavaudza pamusoro poruoko rwenyasha rwaMwari wangu rwaiva pamusoro pangu uye zvakanga zvataurwa namambo kwandiri.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.18",
            "verseOrgIds": [
              "NEH.2.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "NEH 2:18"
      },
      "items": [
        {
          "text": "Ivo vakati, \"Ngatitangei kuvaka.\" Saka vakatanga basa rakanaka iri.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.18",
            "verseOrgIds": [
              "NEH.2.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NEH 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi Sanibharati muHoroni, naTobhia muranda wavaAmoni naGeshemu muArabhu vakati vazvinzwa, vakatiseka uye vakatizvidza. Vakatibvunza vachiti, \"Chiiko ichi chamuri kuita? Muri kumukira mambo kanhi?\"",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.19",
            "verseOrgIds": [
              "NEH.2.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NEH 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakavapindura ndikati, \"Mwari wokudenga achaita kuti tibudirire. Isu varanda vake tichatanga kuvaka asi kana murimi, hamuna mugove kana simba kana chirangaridzo paJerusarema.\"",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.20",
            "verseOrgIds": [
              "NEH.2.20"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "NEH.3",
    "number": "3",
