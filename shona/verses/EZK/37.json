  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "37",
        "style": "c",
        "sid": "EZK 37"
      },
      "items": [
        {
          "text": "37",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mupata waMapfupa Akaoma",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 37:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruoko rwaJehovha rwakanga rwuri pamusoro pangu, uye akandibudisa noMweya waJehovha akandiisa pakati pomupata; wakanga uzere namapfupa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.1",
            "verseOrgIds": [
              "EZK.37.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 37:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akanditungamirira kuno nokoko pakati pawo, uye ndakaona mapfupa mazhinji zhinji pamusoro pomupata; mapfupa akanga akaoma kwazvo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.2",
            "verseOrgIds": [
              "EZK.37.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 37:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akandibvunza akati, \"Mwanakomana womunhu, mapfupa aya angararama here?\"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.3",
            "verseOrgIds": [
              "EZK.37.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EZK 37:3"
      },
      "items": [
        {
          "text": "Ini ndakati, \"Imi Ishe Jehovha, iyemi moga munoziva.\"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.3",
            "verseOrgIds": [
              "EZK.37.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 37:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo iye akati kwandiri, \"Profita kumapfupa aya uti kwaari, 'Imi mapfupa akaoma, inzwai shoko raJehovha:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.4",
            "verseOrgIds": [
              "EZK.37.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 37:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvanzi naIshe Jehovha kumapfupa aya: Ndichaisa mweya mukati menyu mugorarama.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.5",
            "verseOrgIds": [
              "EZK.37.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 37:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndichaisa marunda pamuri ndigoita kuti muve nenyama pamusoro penyu uye ndichakufukidzai neganda; ndichaisa mweya mukati menyu uye muchava vapenyu. Ipapo muchaziva kuti ndini Jehovha.' \"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.6",
            "verseOrgIds": [
              "EZK.37.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 37:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka ndakaprofita sezvandakarayirwa. Zvino ndakati ndichiprofita, kwakava nomumvumo, nokurira kwaiti kweche kweche, uye mapfupa akaswededzana, bvupa nebvupa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.7",
            "verseOrgIds": [
              "EZK.37.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 37:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakatarira, ndikaona marunda nenyama zvavapo uye zvakafukidzwa neganda, asi makanga musina mweya mukati mazvo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.8",
            "verseOrgIds": [
              "EZK.37.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 37:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akati kwandiri, \"Profita kumhepo; profita, mwanakomana womunhu, uti kwairi, 'Zvanzi naIshe Jehovha: Uya uchibva kumhepo ina, iwe mweya, ufemere mukati maava vakaurayiwa, kuti vararame.' \"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.9",
            "verseOrgIds": [
              "EZK.37.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 37:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka ndakaprofita sezvaakandirayira, mweya ukapinda mukati mavo; vakararama vakamira netsoka dzavo, iri hondo huru kwazvo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.10",
            "verseOrgIds": [
              "EZK.37.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 37:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akati kwandiri, \"Mwanakomana womunhu, mapfupa aya ndiyo imba yose yaIsraeri. Ivo vanoti, 'Mapfupa edu aoma uye hatisisina tariro; taparadzwa hedu.'",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.11",
            "verseOrgIds": [
              "EZK.37.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 37:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo profita uti kwavari, 'Zvanzi naIshe Jehovha: Haiwa vanhu vangu, ndiri kuzozarura marinda enyu ndigokubudisai maari; ndichakudzoseraizve kunyika yaIsraeri.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.12",
            "verseOrgIds": [
              "EZK.37.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 37:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo imi, vanhu vangu, muchaziva kuti ndini Jehovha, pandichazarura marinda enyu ndichikubudisai maari.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.13",
            "verseOrgIds": [
              "EZK.37.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 37:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndichaisa mweya wangu mukati menyu mugorarama, uye ndichakugarisai munyika yenyu. Ipapo muchaziva kuti ini Jehovha ndakazvitaura, uye ndakazviita, ndizvo zvinotaura Jehovha.' \"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.14",
            "verseOrgIds": [
              "EZK.37.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Rudzi rumwe chete pasi pamambo mumwe chete",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 37:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shoko raJehovha rakasvika kwandiri richiti,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.15",
            "verseOrgIds": [
              "EZK.37.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 37:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mwanakomana womunhu, tora rutanda unyore parwuri kuti, 'ZvaJudha nezvaIsraeri shamwari dzake.' Ipapo utore rumwe rutanda, ugonyora pamusoro parwo kuti, 'Rutanda rwaEfuremu, norwaJosefa neimba yose yaIsraeri neshamwari dzake.'",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.16",
            "verseOrgIds": [
              "EZK.37.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 37:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzvibatanidze pamwe chete zvive rutanda rumwe kuitira kuti zvive rutanda rumwe chete muruoko rwako.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.17",
            "verseOrgIds": [
              "EZK.37.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 37:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kana vanhu venyika yako vakakubvunza vachiti, 'Haungatiudziwo zvaunoreva nechinhu ichi here?'",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.18",
            "verseOrgIds": [
              "EZK.37.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 37:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "uti kwavari, 'Zvanzi naJehovha: Ndiri kuzotora rutanda rwaJosefa, rwuri muruoko rwaEfuremu, nerwaIsraeri shamwari dzake, ndigorubatanidza nerwaJudha, ndichiaita rutanda rumwe chete rwehuni, agova rutanda rumwe chete muruoko rwangu.'",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.19",
            "verseOrgIds": [
              "EZK.37.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 37:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uabate pamberi pavo iwo matanda awakanyora paari",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.20",
            "verseOrgIds": [
              "EZK.37.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 37:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "ugoti kwavari, 'Zvanzi naIshe Jehovha: Kubva munyika dzose kwavakanga vaenda ndichadzosera vaIsraeri munyika yavo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.21",
            "verseOrgIds": [
              "EZK.37.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 37:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndichavaita rudzi rumwe chete munyika iyo, pamakomo eIsraeri. Pachava namambo mumwe chete pamusoro pavo vose uye havachazovazve marudzi maviri kana kupatsanurwa kuti vave umambo huviri.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.22",
            "verseOrgIds": [
              "EZK.37.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 37:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Havachazozvisvibisizve nezvifananidzo zvavo kana nezvinonyangadza zvavo kana kudarika kuipa kwavo, nokuti ini ndichavaponesa pazvivi zvavo zvokudzokera shure, uye ndichavanatsa. Vachava vanhu vangu uye ini ndichava Mwari wavo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.23",
            "verseOrgIds": [
              "EZK.37.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 37:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Muranda wangu Dhavhidhi achava mambo pamusoro pavo, uye vose vachava nomufudzi mumwe chete. Vachatevera mirayiro yangu uye vachachenjerera kuchengeta mitemo yangu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.24",
            "verseOrgIds": [
              "EZK.37.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 37:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vachagara munyika yandakapa kumuranda wangu Jakobho, iyo nyika yaigara madzibaba avo. Vachagaramo nokusingaperi ivo navana vavo navana vavana vavo uye Dhavhidhi muranda wangu achava muchinda wavo nokusingaperi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.25",
            "verseOrgIds": [
              "EZK.37.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 37:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndichaita sungano yorugare navo; ichava sungano isingaperi. Ndichavasimbisa, ndichavawanza uye ndichaisa nzvimbo yangu tsvene pakati pavo nokusingaperi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.26",
            "verseOrgIds": [
              "EZK.37.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 37:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ugaro hwangu huchava pakati pavo, ini ndichava Mwari wavo, uye ivo vachava vanhu vangu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.27",
            "verseOrgIds": [
              "EZK.37.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZK 37:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo ndudzi dzichaziva kuti ini Jehovha ndinoita Israeri kuti ave mutsvene, kana nzvimbo yangu tsvene ikagara pakati pavo nokusingaperi.' \"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.28",
            "verseOrgIds": [
              "EZK.37.28"
            ]
          }
        }
      ]
    }
  ],
