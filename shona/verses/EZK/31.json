  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "31",
        "style": "c",
        "sid": "EZK 31"
      },
      "items": [
        {
          "text": "31",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Musidhari womuRebhanoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 31:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mugore regumi nerimwe, mumwedzi wechitatu pazuva rokutanga, shoko raJehovha rakasvika kwandiri richiti,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.1",
            "verseOrgIds": [
              "EZK.31.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 31:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mwanakomana womunhu, uti kuna Faro mambo weIjipiti navanhu vake vose:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.2",
            "verseOrgIds": [
              "EZK.31.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 31:2"
      },
      "items": [
        {
          "text": "\" 'Ndianiko angaenzaniswa nemi paushe?",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.2",
            "verseOrgIds": [
              "EZK.31.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 31:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rangarirai Asiria, yaimbova musidhari muRebhanoni,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.3",
            "verseOrgIds": [
              "EZK.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 31:3"
      },
      "items": [
        {
          "text": "wakanga una matavi akaisvonaka akanga akafukidzira dondo;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.3",
            "verseOrgIds": [
              "EZK.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 31:3"
      },
      "items": [
        {
          "text": "wakanga wakareba kwazvo,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.3",
            "verseOrgIds": [
              "EZK.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 31:3"
      },
      "items": [
        {
          "text": "manhengenya awo ari pamusoro pamashizha akapfumvutira.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.3",
            "verseOrgIds": [
              "EZK.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 31:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mvura zhinji yakaupa zvokudya,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.4",
            "verseOrgIds": [
              "EZK.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 31:4"
      },
      "items": [
        {
          "text": "zvitubu zvakadzika zvakaita kuti urebe;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.4",
            "verseOrgIds": [
              "EZK.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 31:4"
      },
      "items": [
        {
          "text": "hova dzacho dzakayerera dzichipoteredza hunde,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.4",
            "verseOrgIds": [
              "EZK.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 31:4"
      },
      "items": [
        {
          "text": "uye dzakatumira mironga yadzo kumiti yose yesango.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.4",
            "verseOrgIds": [
              "EZK.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 31:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka wakareba kwazvo",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.5",
            "verseOrgIds": [
              "EZK.31.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 31:5"
      },
      "items": [
        {
          "text": "kupfuura miti yose yesango,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.5",
            "verseOrgIds": [
              "EZK.31.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 31:5"
      },
      "items": [
        {
          "text": "mativi awo akawanda",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.5",
            "verseOrgIds": [
              "EZK.31.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 31:5"
      },
      "items": [
        {
          "text": "uye matavi awo akareba,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.5",
            "verseOrgIds": [
              "EZK.31.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 31:5"
      },
      "items": [
        {
          "text": "achitandavara nokuda kwemvura zhinji.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.5",
            "verseOrgIds": [
              "EZK.31.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 31:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shiri dzose dzedenga",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.6",
            "verseOrgIds": [
              "EZK.31.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 31:6"
      },
      "items": [
        {
          "text": "dzakavakira matendere adzo pamatavi awo,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.6",
            "verseOrgIds": [
              "EZK.31.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 31:6"
      },
      "items": [
        {
          "text": "mhuka dzose dzesango",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.6",
            "verseOrgIds": [
              "EZK.31.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 31:6"
      },
      "items": [
        {
          "text": "dzakaberekera pasi pamatavi awo;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.6",
            "verseOrgIds": [
              "EZK.31.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 31:6"
      },
      "items": [
        {
          "text": "ndudzi dzose huru",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.6",
            "verseOrgIds": [
              "EZK.31.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 31:6"
      },
      "items": [
        {
          "text": "dzakagara pamumvuri wawo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.6",
            "verseOrgIds": [
              "EZK.31.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 31:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakanga uchiyevedza parunako,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.7",
            "verseOrgIds": [
              "EZK.31.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 31:7"
      },
      "items": [
        {
          "text": "namatavi awo akatandavara,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.7",
            "verseOrgIds": [
              "EZK.31.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 31:7"
      },
      "items": [
        {
          "text": "nokuti midzi yawo yaidzika pasi",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.7",
            "verseOrgIds": [
              "EZK.31.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 31:7"
      },
      "items": [
        {
          "text": "kune mvura zhinji.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.7",
            "verseOrgIds": [
              "EZK.31.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 31:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Misidhari yomubindu raMwari",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.8",
            "verseOrgIds": [
              "EZK.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 31:8"
      },
      "items": [
        {
          "text": "yakanga isingagoni kuukunda,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.8",
            "verseOrgIds": [
              "EZK.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 31:8"
      },
      "items": [
        {
          "text": "uye miti yomupaini",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.8",
            "verseOrgIds": [
              "EZK.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 31:8"
      },
      "items": [
        {
          "text": "yakanga isingaenzani namatavi awo,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.8",
            "verseOrgIds": [
              "EZK.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 31:8"
      },
      "items": [
        {
          "text": "uye miti yemipurani",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.8",
            "verseOrgIds": [
              "EZK.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 31:8"
      },
      "items": [
        {
          "text": "hayaienzaniswa namatavi awo,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.8",
            "verseOrgIds": [
              "EZK.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 31:8"
      },
      "items": [
        {
          "text": "hakuna muti mubindu raMwari",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.8",
            "verseOrgIds": [
              "EZK.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 31:8"
      },
      "items": [
        {
          "text": "waienzana nawo pakunaka.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.8",
            "verseOrgIds": [
              "EZK.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 31:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakauita muti unoyevedza",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.9",
            "verseOrgIds": [
              "EZK.31.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 31:9"
      },
      "items": [
        {
          "text": "una matavi akawanda,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.9",
            "verseOrgIds": [
              "EZK.31.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 31:9"
      },
      "items": [
        {
          "text": "muti waiyemurwa nemiti yose yomuEdheni",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.9",
            "verseOrgIds": [
              "EZK.31.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 31:9"
      },
      "items": [
        {
          "text": "mubindu raMwari.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.9",
            "verseOrgIds": [
              "EZK.31.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 31:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Naizvozvo zvanzi naIshe Jehovha: Nemhaka yokuti wakanga wakareba kwazvo, uchisimudzira manhengenya awo pamatavi akapfumvutira, uye nemhaka yokuti wakazvikudza nokuda kwokureba kwawo,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.10",
            "verseOrgIds": [
              "EZK.31.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 31:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndakauisa kumutongi wendudzi, kuti vamuitire zvakafanira kuipa kwawo. Ndakaukanda padivi,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.11",
            "verseOrgIds": [
              "EZK.31.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 31:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye rudzi rwakaipisisa kundudzi dzavatorwa rwakautemera pasi ndokuusiya. Matavi awo akawira pamakomo nomumipata yose; matavi awo ose akavhunikira muhova dzose dzenyika. Ndudzi dzose dzomunyika dzakabva pasi pomumvuri wawo dzikausiya.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.12",
            "verseOrgIds": [
              "EZK.31.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 31:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shiri dzose dzedenga dzakamhara pamuti wakawa, uye mhuka dzose dzenyika dzakanga dziri pakati pamatavi awo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.13",
            "verseOrgIds": [
              "EZK.31.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 31:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo hakuna mimwe miti iri pamvura zhinji ichareba kwazvo ichizvikudza, ichizvisimudzira manhengenya ayo pamusoro pamatavi akapfumvutira. Hakuna mimwe miti inowana mvura yakadai ichazombosvika paurefu hwakadai; yose ichafa, nokuti nyika iri pasi, pakati pavanhu vanofa, navaya vanoburukira kugomba.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.14",
            "verseOrgIds": [
              "EZK.31.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 31:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Zvanzi naIshe Jehovha: Pazuva rawakaburutsirwa muguva ndakafukidza matsime akadzika kuti aungudze nokuda kwawo ndikamisa hova dzawo, uye mvura yawo zhinji yakadziviswa. Nemhaka yawo ndakafukidza Rebhanoni nokusuwa, uye miti yose yesango yakasvava.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.15",
            "verseOrgIds": [
              "EZK.31.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 31:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakaita kuti ndudzi dzidedere padzakanzwa kuwa kwako pandakuburusira muguva navaya vanoenda mugomba nawo. Ipapo miti yose yomuEdheni, yakasarudzika uye neyakanakisa muRebhanoni, miti yose yakanga ichiwana mvura yakakwana, yakanyaradzwa panyika pasi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.16",
            "verseOrgIds": [
              "EZK.31.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 31:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vaya vaigara mumumvuri wawo, navaya vavaibatana navo pakati pendudzi, vakanga vaburukirawo muguva nawo, vachiva pamwe navaya vakaurayiwa nomunondo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.17",
            "verseOrgIds": [
              "EZK.31.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 31:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ndeipiko miti yeEdheni ingaenzaniswa newe pakubwinya noushe? Kunyange zvakadaro, newewo, uchaburutswa pamwe chete nemiti yeEdheni panyika pasi; ucharara pakati pavasina kudzingiswa, navaya vakaurayiwa nomunondo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.18",
            "verseOrgIds": [
              "EZK.31.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EZK 31:18"
      },
      "items": [
        {
          "text": "\" 'Ndiye Faro navanhu vake vazhinji, ndizvo zvinotaura Ishe Jehovha.' \"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.18",
            "verseOrgIds": [
              "EZK.31.18"
            ]
          }
        }
      ]
    }
  ],
