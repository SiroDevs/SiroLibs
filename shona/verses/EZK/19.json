          "text": "19",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kuchema pamusoro paMachinda eIsraeri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Chema pamusoro pamachinda eIsraeri",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.1",
            "verseOrgIds": [
              "EZK.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "uti:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.2",
            "verseOrgIds": [
              "EZK.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 19:2"
      },
      "items": [
        {
          "text": "\" 'Mai vako vaiva shumbakadzi yakadii",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.2",
            "verseOrgIds": [
              "EZK.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 19:2"
      },
      "items": [
        {
          "text": "pakati peshumba!",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.2",
            "verseOrgIds": [
              "EZK.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 19:2"
      },
      "items": [
        {
          "text": "Yaivata pasi pakati peshumba duku",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.2",
            "verseOrgIds": [
              "EZK.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 19:2"
      },
      "items": [
        {
          "text": "uye yairera vana vayo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.2",
            "verseOrgIds": [
              "EZK.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakarera mumwe mwana wayo,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.3",
            "verseOrgIds": [
              "EZK.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 19:3"
      },
      "items": [
        {
          "text": "ikava shumba yakasimba.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.3",
            "verseOrgIds": [
              "EZK.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 19:3"
      },
      "items": [
        {
          "text": "Yakadzidza kubvambura nyama,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.3",
            "verseOrgIds": [
              "EZK.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 19:3"
      },
      "items": [
        {
          "text": "uye yaidya vanhu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.3",
            "verseOrgIds": [
              "EZK.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndudzi dzakanzwa nezvayo,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.4",
            "verseOrgIds": [
              "EZK.19.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 19:4"
      },
      "items": [
        {
          "text": "dzikaibata muhunza yadzo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.4",
            "verseOrgIds": [
              "EZK.19.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 19:4"
      },
      "items": [
        {
          "text": "Vakaenda nayo nezvikokovono",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.4",
            "verseOrgIds": [
              "EZK.19.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 19:4"
      },
      "items": [
        {
          "text": "kunyika yeIjipiti.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.4",
            "verseOrgIds": [
              "EZK.19.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Yakati ichiona kuti tariro yayo haina kuzadziswa,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.5",
            "verseOrgIds": [
              "EZK.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 19:5"
      },
      "items": [
        {
          "text": "yarasikirwa nezvayakanga yakatarisira,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.5",
            "verseOrgIds": [
              "EZK.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 19:5"
      },
      "items": [
        {
          "text": "yakatora mumwe wevana vayo",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.5",
            "verseOrgIds": [
              "EZK.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 19:5"
      },
      "items": [
        {
          "text": "ndokumuita shumba yakasimba.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.5",
            "verseOrgIds": [
              "EZK.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakafamba ichinyahwaira pakati peshumba,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.6",
            "verseOrgIds": [
              "EZK.19.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 19:6"
      },
      "items": [
        {
          "text": "nokuti yakanga yava shumba ine simba zvino.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.6",
            "verseOrgIds": [
              "EZK.19.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 19:6"
      },
      "items": [
        {
          "text": "Yakadzidza kubvambura chayabata",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.6",
            "verseOrgIds": [
              "EZK.19.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 19:6"
      },
      "items": [
        {
          "text": "uye yaidya vanhu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.6",
            "verseOrgIds": [
              "EZK.19.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakakoromora nhare dzavo",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.7",
            "verseOrgIds": [
              "EZK.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 19:7"
      },
      "items": [
        {
          "text": "uye ikaparadza maguta avo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.7",
            "verseOrgIds": [
              "EZK.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 19:7"
      },
      "items": [
        {
          "text": "Nyika navose vaivamo",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.7",
            "verseOrgIds": [
              "EZK.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 19:7"
      },
      "items": [
        {
          "text": "vakavhundutswa nokuomba kwayo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.7",
            "verseOrgIds": [
              "EZK.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo ndudzi dzakarwisana nayo,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.8",
            "verseOrgIds": [
              "EZK.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 19:8"
      },
      "items": [
        {
          "text": "vaya vaibva kumatunhu akapoteredza.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.8",
            "verseOrgIds": [
              "EZK.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 19:8"
      },
      "items": [
        {
          "text": "Vakaikandira mambure,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.8",
            "verseOrgIds": [
              "EZK.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 19:8"
      },
      "items": [
        {
          "text": "iyo ndokubatwa muhunza yavo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.8",
            "verseOrgIds": [
              "EZK.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakaipinza muchizarira nezvikokovono",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.9",
            "verseOrgIds": [
              "EZK.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 19:9"
      },
      "items": [
        {
          "text": "vakandoiisa kuna mambo weBhabhironi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.9",
            "verseOrgIds": [
              "EZK.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 19:9"
      },
      "items": [
        {
          "text": "Vakaiisa mutorongo,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.9",
            "verseOrgIds": [
              "EZK.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 19:9"
      },
      "items": [
        {
          "text": "saka kuomba kwayo hakuna kuzonzwikwazve",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.9",
            "verseOrgIds": [
              "EZK.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 19:9"
      },
      "items": [
        {
          "text": "pamakomo aIsraeri.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.9",
            "verseOrgIds": [
              "EZK.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Mai vako vakanga vakaita somuzambiringa mumunda wako wemizambiringa,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.10",
            "verseOrgIds": [
              "EZK.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 19:10"
      },
      "items": [
        {
          "text": "wakasimwa pane mvura;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.10",
            "verseOrgIds": [
              "EZK.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 19:10"
      },
      "items": [
        {
          "text": "wakanga une zvibereko uye uzere namatavi",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.10",
            "verseOrgIds": [
              "EZK.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 19:10"
      },
      "items": [
        {
          "text": "nokuda kwemvura zhinji.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.10",
            "verseOrgIds": [
              "EZK.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Matavi awo akanga akasimba,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.11",
            "verseOrgIds": [
              "EZK.19.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 19:11"
      },
      "items": [
        {
          "text": "akanakira kuva tsvimbo yomutongi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.11",
            "verseOrgIds": [
              "EZK.19.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 19:11"
      },
      "items": [
        {
          "text": "Wakanga wakareba kwazvo",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.11",
            "verseOrgIds": [
              "EZK.19.11"
            ]
          }
