          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Vanhu veIsraeri havachazovizve navavakidzani vanovagodora vachivarwadzisa sorukato runopinza. Ipapo vachaziva kuti ndini Ishe Jehovha.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.24",
            "verseOrgIds": [
              "EZK.28.24"
            ]
          }
        }
