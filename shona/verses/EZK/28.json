  "verseCount": 26,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "28",
        "style": "c",
        "sid": "EZK 28"
      },
      "items": [
        {
          "text": "28",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Chiprofita pamusoro paMambo weTire",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 28:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shoko raJehovha rakasvika kwandiri richiti,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.1",
            "verseOrgIds": [
              "EZK.28.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 28:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mwanakomana womunhu, uti kumubati weTire, 'Zvanzi naIshe Jehovha:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.2",
            "verseOrgIds": [
              "EZK.28.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 28:2"
      },
      "items": [
        {
          "text": "\" 'Mukuzvikudza kwomwoyo wako",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.2",
            "verseOrgIds": [
              "EZK.28.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 28:2"
      },
      "items": [
        {
          "text": "iwe unoti, \"Ini ndiri mwari;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.2",
            "verseOrgIds": [
              "EZK.28.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 28:2"
      },
      "items": [
        {
          "text": "ndinogara pachigaro choushe chamwari,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.2",
            "verseOrgIds": [
              "EZK.28.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 28:2"
      },
      "items": [
        {
          "text": "pakati pomwoyo wamakungwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.2",
            "verseOrgIds": [
              "EZK.28.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 28:2"
      },
      "items": [
        {
          "text": "Asi uri munhu zvako uye hauzi mwari,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.2",
            "verseOrgIds": [
              "EZK.28.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 28:2"
      },
      "items": [
        {
          "text": "kunyange uchifunga kuti wakachenjera samwari.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.2",
            "verseOrgIds": [
              "EZK.28.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 28:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakachenjera kukunda Dhanieri here?",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.3",
            "verseOrgIds": [
              "EZK.28.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 28:3"
      },
      "items": [
        {
          "text": "Hauna chakavanzika chausingazivi here?",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.3",
            "verseOrgIds": [
              "EZK.28.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakazviwanira pfuma",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.4",
            "verseOrgIds": [
              "EZK.28.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 28:4"
      },
      "items": [
        {
          "text": "nouchenjeri hwako nokunzwisisa kwako,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.4",
            "verseOrgIds": [
              "EZK.28.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 28:4"
      },
      "items": [
        {
          "text": "uye wakazviunganidzira goridhe nesirivha",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.4",
            "verseOrgIds": [
              "EZK.28.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 28:4"
      },
      "items": [
        {
          "text": "muzvivigiro zvepfuma yako.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.4",
            "verseOrgIds": [
              "EZK.28.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 28:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakawanza pfuma yako",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.5",
            "verseOrgIds": [
              "EZK.28.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 28:5"
      },
      "items": [
        {
          "text": "nouchenjeri hwako hwokutengesa,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.5",
            "verseOrgIds": [
              "EZK.28.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 28:5"
      },
      "items": [
        {
          "text": "uye nokuda kwepfuma yako",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.5",
            "verseOrgIds": [
              "EZK.28.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 28:5"
      },
      "items": [
        {
          "text": "mwoyo wako wakazvikudza.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.5",
            "verseOrgIds": [
              "EZK.28.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 28:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Naizvozvo zvanzi naIshe Jehovha:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.6",
            "verseOrgIds": [
              "EZK.28.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 28:6"
      },
      "items": [
        {
          "text": "\" 'Nokuti unofunga kuti wakangwara,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.6",
            "verseOrgIds": [
              "EZK.28.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 28:6"
      },
      "items": [
        {
          "text": "sokungwara kwamwari,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.6",
            "verseOrgIds": [
              "EZK.28.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndava kuzouyisa vatorwa kuti vazokurwisa,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.7",
            "verseOrgIds": [
              "EZK.28.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 28:7"
      },
      "items": [
        {
          "text": "rudzi rwakaipisisa pakati pendudzi dzose,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.7",
            "verseOrgIds": [
              "EZK.28.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 28:7"
      },
      "items": [
        {
          "text": "vachavhomora minondo yavo kuti varwise kunaka nokuchenjera kwako,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.7",
            "verseOrgIds": [
              "EZK.28.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 28:7"
      },
      "items": [
        {
          "text": "vagosvibisa kupenya kwokubwinya kwako.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.7",
            "verseOrgIds": [
              "EZK.28.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vachakuburutsira kugomba,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.8",
            "verseOrgIds": [
              "EZK.28.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 28:8"
      },
      "items": [
        {
          "text": "uye uchafa rufu runorwadza",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.8",
            "verseOrgIds": [
              "EZK.28.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 28:8"
      },
      "items": [
        {
          "text": "pakati pomwoyo wamakungwa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.8",
            "verseOrgIds": [
              "EZK.28.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 28:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo uchati here, \"Ndiri mwari,\"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.9",
            "verseOrgIds": [
              "EZK.28.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 28:9"
      },
      "items": [
        {
          "text": "pamberi pavanokuuraya?",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.9",
            "verseOrgIds": [
              "EZK.28.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 28:9"
      },
      "items": [
        {
          "text": "Uchava munhu chete, kwete mwari,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.9",
            "verseOrgIds": [
              "EZK.28.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 28:9"
      },
      "items": [
        {
          "text": "mumaoko aivo vanokuuraya.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.9",
            "verseOrgIds": [
              "EZK.28.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uchafa rufu rwomunhu asina kudzingiswa",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.10",
            "verseOrgIds": [
              "EZK.28.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 28:10"
      },
      "items": [
        {
          "text": "pamaoko avatorwa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.10",
            "verseOrgIds": [
              "EZK.28.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m",
        "vid": "EZK 28:10"
      },
      "items": [
        {
          "text": "Ndazvitaura, ndizvo zvinotaura Ishe Jehovha.' \"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.10",
            "verseOrgIds": [
              "EZK.28.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 28:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shoko raJehovha rakasvika kwandiri richiti:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.11",
            "verseOrgIds": [
              "EZK.28.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 28:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mwanakomana womunhu, chemera mambo weTire ugoti kwaari, 'Zvanzi naIshe Jehovha:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.12",
            "verseOrgIds": [
              "EZK.28.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 28:12"
      },
      "items": [
        {
          "text": "\" 'Wakanga uri muenzaniso wokukwana,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.12",
            "verseOrgIds": [
              "EZK.28.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 28:12"
      },
      "items": [
        {
          "text": "uzere nouchenjeri wakakwana parunako.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.12",
            "verseOrgIds": [
              "EZK.28.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 28:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakanga uri muEdheni,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.13",
            "verseOrgIds": [
              "EZK.28.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 28:13"
      },
      "items": [
        {
          "text": "bindu raMwari;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.13",
            "verseOrgIds": [
              "EZK.28.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 28:13"
      },
