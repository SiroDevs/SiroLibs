  "verseCount": 36,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "27",
        "style": "c",
        "sid": "EZK 27"
      },
      "items": [
        {
          "text": "27",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kuchema pamusoro peTire",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 27:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shoko raJehovha rakasvika kwandiri richiti,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.1",
            "verseOrgIds": [
              "EZK.27.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mwanakomana womunhu, chema pamusoro peTire.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.2",
            "verseOrgIds": [
              "EZK.27.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uti kuTire, riri pasuo rokugungwa, mushambadziri wavanhu vamarudzi ose pazviwi zvizhinji, 'Zvanzi naIshe Jehovha:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.3",
            "verseOrgIds": [
              "EZK.27.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 27:3"
      },
      "items": [
        {
          "text": "\" 'Unoti, iwe Tire,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.3",
            "verseOrgIds": [
              "EZK.27.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 27:3"
      },
      "items": [
        {
          "text": "\"Ini ndakakwana parunako.\"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.3",
            "verseOrgIds": [
              "EZK.27.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simba rako rakanga riri pamakungwa makuru;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.4",
            "verseOrgIds": [
              "EZK.27.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 27:4"
      },
      "items": [
        {
          "text": "vavaki vako vakaita kuti runako rwako rusvike pakukwana.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.4",
            "verseOrgIds": [
              "EZK.27.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakaita mapuranga ako ose",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.5",
            "verseOrgIds": [
              "EZK.27.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 27:5"
      },
      "items": [
        {
          "text": "emiti yemipaini inobva kuSeniri;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.5",
            "verseOrgIds": [
              "EZK.27.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 27:5"
      },
      "items": [
        {
          "text": "vakatora musidhari waibva kuRebhanoni,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.5",
            "verseOrgIds": [
              "EZK.27.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 27:5"
      },
      "items": [
        {
          "text": "kuti vakuitire danda rokutsigira maseiri muchikepe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.5",
            "verseOrgIds": [
              "EZK.27.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakaita matanda okukwasva nawo",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.6",
            "verseOrgIds": [
              "EZK.27.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 27:6"
      },
      "items": [
        {
          "text": "omuouki aibva kuBhashani;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.6",
            "verseOrgIds": [
              "EZK.27.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 27:6"
      },
      "items": [
        {
          "text": "namapuranga omusipuresi aibva kuzviwi zveSaipurasi",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.6",
            "verseOrgIds": [
              "EZK.27.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 27:6"
      },
      "items": [
        {
          "text": "vakaita uriri hwako namapuranga, ane nyanga dzenzou mukati.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.6",
            "verseOrgIds": [
              "EZK.27.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maseiri ako akanga ari omucheka wakarukwa zvakaisvonaka waibva kuIjipiti,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.7",
            "verseOrgIds": [
              "EZK.27.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 27:7"
      },
      "items": [
        {
          "text": "uye wakashandiswa somureza wako;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.7",
            "verseOrgIds": [
              "EZK.27.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 27:7"
      },
      "items": [
        {
          "text": "zvifukidzo zvako zvamatende zvakanga zviri bhuruu nepepuru,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.7",
            "verseOrgIds": [
              "EZK.27.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 27:7"
      },
      "items": [
        {
          "text": "zvaibva kumahombekombe aErisha.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.7",
            "verseOrgIds": [
              "EZK.27.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Varume veSidhoni neArivhadhi ndivo vakanga vari vakwasvi vako;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.8",
            "verseOrgIds": [
              "EZK.27.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 27:8"
      },
      "items": [
        {
          "text": "mhizha dzako, iwe Tire dzakanga dzirimo savafambisi vako vechikepe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.8",
            "verseOrgIds": [
              "EZK.27.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mhare dzoumhizha dzeGebhari vakanga varimo,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.9",
            "verseOrgIds": [
              "EZK.27.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 27:9"
      },
      "items": [
        {
          "text": "savavaki vechikepe kuti vaname maburi emaseiri ako.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.9",
            "verseOrgIds": [
              "EZK.27.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 27:9"
      },
      "items": [
        {
          "text": "Zvikepe zvose zvegungwa navafambisi vazvo",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.9",
            "verseOrgIds": [
              "EZK.27.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 27:9"
      },
      "items": [
        {
          "text": "vakauya kuzotengeserana newe zvawakagadzira.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.9",
            "verseOrgIds": [
              "EZK.27.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Varume vokuPezhia, neRidhia nePuti",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.10",
            "verseOrgIds": [
              "EZK.27.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 27:10"
      },
      "items": [
        {
          "text": "vakashanda savarwi muhondo yako.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.10",
            "verseOrgIds": [
              "EZK.27.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 27:10"
      },
      "items": [
        {
          "text": "Vakarembedza nhoo dzavo nenguwani pamasvingo ako,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.10",
            "verseOrgIds": [
              "EZK.27.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 27:10"
      },
      "items": [
        {
          "text": "vachikuvigira mbiri.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.10",
            "verseOrgIds": [
              "EZK.27.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Varume vokuArivhadhi nevokuHereki",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.11",
            "verseOrgIds": [
              "EZK.27.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 27:11"
      },
      "items": [
        {
          "text": "vakakomba masvingo ako kumativi ose;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.11",
            "verseOrgIds": [
              "EZK.27.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 27:11"
      },
      "items": [
        {
          "text": "varume vokuGamadhi",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.11",
            "verseOrgIds": [
              "EZK.27.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 27:11"
      },
      "items": [
        {
          "text": "vakanga vari mushongwe dzako.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.11",
            "verseOrgIds": [
              "EZK.27.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 27:11"
      },
      "items": [
        {
          "text": "Vakaturika nhoo dzavo pamasvingo ako;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.11",
            "verseOrgIds": [
              "EZK.27.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 27:11"
      },
      "items": [
        {
          "text": "vakaita kuti runako rwako rukwane.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.11",
            "verseOrgIds": [
              "EZK.27.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Tashishi yakatengeserana newe nokuda kwepfuma yako huru yenhumbi; vakatsinhanisa sirivha, nesimbi, netini nedare zvokushambadzira zvako.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.12",
            "verseOrgIds": [
              "EZK.27.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Girisi, Tubhari neMesheki dzakatengeserana newe; vakatsinhanisa nhapwa nezvinhu zvendarira zvezvigadzirwa zvako.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.13",
            "verseOrgIds": [
              "EZK.27.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Varume veBheti Togarima vakatsinhanisa mabhiza ebasa namabhiza ehondo namanyurusi kuti uzvishambadzire.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.14",
            "verseOrgIds": [
              "EZK.27.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Varume vokuRodhe vakatengeserana newe, uye zviwi zvizhinji zvakanga zviri nzvimbo dzako dzokutengesera; vaikuripira nenyanga dzenzou nomuti womuvanga.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.15",
            "verseOrgIds": [
              "EZK.27.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 27:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Aramu yakatengeserana newe nokuda kwezvibereko zvako zvizhinji; vakatsinhanisa matombo eturikoise nemicheka yepepuru, nezvakarukwa, nemicheka yakaisvonaka, nekorari namatombo amarubhi zvokutengesa zvako.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.16",
            "verseOrgIds": [
              "EZK.27.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 27:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Judha neIsraeri vakatengeserana newe, vakatsinhanisa gorosi neMiniti nezvinotapira, uchi, mafuta nebharimi nezvigadzirwa zvako.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.17",
            "verseOrgIds": [
              "EZK.27.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 27:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Dhamasiko, rakatengeserana newe nokuda kwezvigadzirwa zvako zvizhinji nepfuma yenhumbi newaini yaibva kuHeribhoni newuru yaibva kuZahari.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.18",
            "verseOrgIds": [
              "EZK.27.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 27:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'VaDhani navaGiriki vaibva kuUzari vakatenga zvawaishambadzira; vakatsinhanisa simbi yakabikwa, nekasia, nekaramo zvigadzirwa zvako.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.19",
            "verseOrgIds": [
              "EZK.27.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 27:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Dhedhani akatengeserana newe machira okugarira pamabhiza.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.20",
            "verseOrgIds": [
              "EZK.27.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 27:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Arabhia namachinda ose eKedhari vakanga vachikutengera; vakatengeserana newe namakwayana, makondobwe nembudzi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.21",
            "verseOrgIds": [
              "EZK.27.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 27:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Vashambadziri vokuShebha neRama vakatengeserana newe; pane zvawaishambadzira iwe ivo vakatsinhanisa namarudzi ezvinonhuhwira ose uye namabwe anokosha, negoridhe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.22",
            "verseOrgIds": [
              "EZK.27.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 27:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Harani, Kane neEdheni navashambadziri vokuShebha, Ashuri neKirimadhi vakatengeserana newe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.23",
            "verseOrgIds": [
              "EZK.27.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 27:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakatengeserana newe munzvimbo dzokutengesera nguo dzakaisvonaka, dzemicheka yebhuruu, nezvakarukwa, namachira amavara namabote akakoswa uye ane mafundo akasimba.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.24",
            "verseOrgIds": [
              "EZK.27.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 27:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Zvikepe zveTashishi zvakashanda",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.25",
            "verseOrgIds": [
              "EZK.27.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 27:25"
      },
      "items": [
        {
          "text": "pakutakura zvigadzirwa zvako.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.25",
            "verseOrgIds": [
              "EZK.27.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 27:25"
      },
      "items": [
        {
          "text": "Iwe wakazadzwa nezvitakurwa zvinorema,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.25",
            "verseOrgIds": [
              "EZK.27.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 27:25"
      },
      "items": [
        {
          "text": "imo mumwoyo megungwa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.25",
            "verseOrgIds": [
              "EZK.27.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 27:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakwasvi vako vanokutora",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.26",
            "verseOrgIds": [
              "EZK.27.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 27:26"
      },
      "items": [
        {
          "text": "voenda newe kumakungwa makuru.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.26",
            "verseOrgIds": [
              "EZK.27.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 27:26"
      },
      "items": [
        {
          "text": "Asi mhepo yokumabvazuva ichakuputsa-putsa mumwoyo megungwa chaimo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.26",
            "verseOrgIds": [
              "EZK.27.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 27:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pfuma yako, nenhumbi dzokutengesa nezvakagadzirwa,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.27",
            "verseOrgIds": [
              "EZK.27.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 27:27"
      },
      "items": [
        {
          "text": "varayiri navafambisi vako vezvikepe navagadziri vazvo,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.27",
            "verseOrgIds": [
              "EZK.27.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 27:27"
      },
      "items": [
        {
          "text": "vashambadziri vako nevarwi vako vose,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.27",
            "verseOrgIds": [
              "EZK.27.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 27:27"
      },
      "items": [
        {
          "text": "uye vose varimo",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.27",
            "verseOrgIds": [
              "EZK.27.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 27:27"
      },
      "items": [
        {
          "text": "vachanyura mukati momwoyo wegungwa,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.27",
            "verseOrgIds": [
              "EZK.27.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 27:27"
      },
      "items": [
        {
          "text": "pazuva rokuparadzwa kwechikepe chako.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.27",
            "verseOrgIds": [
              "EZK.27.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZK 27:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyika dzokumahombekombe dzichadengenyeka",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.28",
            "verseOrgIds": [
              "EZK.27.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 27:28"
      },
      "items": [
        {
          "text": "panodanidzira vafambisi vako vezvikepe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.28",
            "verseOrgIds": [
              "EZK.27.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZK 27:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vose vanobata matanda okukwasva",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.29",
            "verseOrgIds": [
              "EZK.27.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 27:29"
      },
      "items": [
        {
          "text": "vachasiya zvikepe zvavo;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.29",
            "verseOrgIds": [
              "EZK.27.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 27:29"
      },
      "items": [
        {
          "text": "vachairi nevafambisi vako vezvikepe",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.29",
            "verseOrgIds": [
              "EZK.27.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 27:29"
      },
      "items": [
        {
          "text": "vachamira kumahombekombe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.29",
            "verseOrgIds": [
              "EZK.27.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EZK 27:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vachadanidzira namanzwi avo",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.30",
            "verseOrgIds": [
              "EZK.27.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 27:30"
      },
      "items": [
        {
          "text": "vagochema zvikuru pamusoro pako;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.30",
            "verseOrgIds": [
              "EZK.27.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 27:30"
      },
      "items": [
        {
          "text": "vachakusha guruva pamisoro yavo",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.30",
            "verseOrgIds": [
              "EZK.27.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 27:30"
      },
      "items": [
        {
          "text": "vagoumburuka mumadota.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.30",
            "verseOrgIds": [
              "EZK.27.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EZK 27:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vachaveura misoro yavo nokuda kwako,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.31",
            "verseOrgIds": [
              "EZK.27.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 27:31"
      },
      "items": [
        {
          "text": "uye vachapfeka nguo dzamasaga.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.31",
            "verseOrgIds": [
              "EZK.27.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 27:31"
      },
      "items": [
        {
          "text": "Vachachema pamusoro pako nokurwadza kwomwoyo,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.31",
            "verseOrgIds": [
              "EZK.27.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 27:31"
      },
      "items": [
        {
          "text": "uye nokuchema kukuru.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.31",
            "verseOrgIds": [
              "EZK.27.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EZK 27:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pavanoungudza nokuchema pamusoro pako,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.32",
            "verseOrgIds": [
              "EZK.27.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 27:32"
      },
      "items": [
        {
          "text": "vachachema pamusoro pako vachiti,",
