  "verseCount": 15,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "EST 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Hamani anoronga kuparadza vaJudha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EST 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shure kwaizvozvo, Mambo Zekisesi akaremekedza Hamani mwanakomana waHamedhata, muAgagi, akamukwidziridza nokumupa chigaro chinokudzwa chakanga chiri pamusoro-soro kupfuura zvamamwe makurukota ose.",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.1",
            "verseOrgIds": [
              "EST.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EST 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vabati vose vomuumambo vaimira pamusuo vakamupfugamira vakapa rukudzo kuna Hamani, nokuti mambo akanga arayira kuti aitirwe izvi. Asi Modhekai akanga asingamupfugamiri kana kumukudza.",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.2",
            "verseOrgIds": [
              "EST.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo vabati vaimira pasuo ramambo vakabvunza Modhekai vakati, \"Sei usingateereri murayiro wamambo?\"",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.3",
            "verseOrgIds": [
              "EST.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EST 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zuva nezuva vaitaura naye asi iye akaramba kuvanzwa. Naizvozvo vakaudza Hamani izvozvo kuti vaone kuti maitiro aModhekai angangoregererwa here, nokuti iye akanga avaudza kuti aiva muJudha.",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.4",
            "verseOrgIds": [
              "EST.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EST 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamani akati aona kuti Modhekai akanga asingamupfugamiri kana kumuremekedza, akatsamwa kwazvo.",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.5",
            "verseOrgIds": [
              "EST.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EST 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi paakanzwa kuti vanhu vaModhekai vaiva vapi akafunga zvokusauraya Modhekai chete. Panzvimbo yokuita izvi, Hamani akatsvaka nzira yokuuraya vanhu vose vaModhekai, vaJudha vose vaiva muumambo hwaZekisesi.",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.6",
            "verseOrgIds": [
              "EST.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EST 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mugore regumi namaviri raMambo Zekisesi mumwedzi wokutanga, mwedzi waNisani, vakakanda puri (ndiwo mujenya) pamberi paHamani kuti vasarudze zuva nomwedzi. Mujenya wakawira pamwedzi wegumi nemiviri, mwedzi waAdha.",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.7",
            "verseOrgIds": [
              "EST.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EST 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Hamani akati kuna Mambo Zekisesi, \"Kuna vamwe vanhu vakapararira nokutekeshera vari pakati pamarudzi mumatunhu oushe hwenyu vane tsika yakasiyana navamwe vanhu vose uye havateereri mirayiro yamambo; hazvinganakiri mambo kuti muvaregerere.",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.8",
            "verseOrgIds": [
              "EST.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EST 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana mambo achifara nazvo, ngapaiswe chirevo chokuti vaparadzwe, uye ini ndicharipa matarenda zviuru gumi",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.9",
            "verseOrgIds": [
              "EST.3.9"
            ]
          }
        },
        {
          "text": "esirivha mudura repfuma yamambo kuti igoshandiswa kuripira avo vachabata basa iri ramambo.\"",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.9",
            "verseOrgIds": [
              "EST.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EST 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo mambo akatora mhete yechindori kubva pamunwe wake akaipa kuna Hamani mwanakomana waHamedhata, muAgagi, muvengi wavaJudha.",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.10",
            "verseOrgIds": [
              "EST.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EST 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo akati kuna Hamani, \"Chengeta mari uye uite zvaunoda navanhu.\"",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.11",
            "verseOrgIds": [
              "EST.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EST 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino pazuva regumi namatatu romwedzi wokutanga vanyori vamambo vakadaidzwa. Vakanyora namanyorero enyika imwe neimwe uye nomutauro worudzi rumwe norumwe zvose zvakarayirwa naHamani kumakurukota ehurumende, navabati venyika dzakasiyana-siyana namakurukota amarudzi akasiyana-siyana. Tsamba idzi dzakanyorwa muzita raMambo Zekisesi pachake uye dzikasimbiswa nemhete yake.",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.12",
            "verseOrgIds": [
              "EST.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EST 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Matsamba aya akatumirwa navatakuri vamatsamba kunyika dzose dzamambo Zekisesi dziine murayiro wokuparadza, kuuraya, nokupedza vaJudha vose, vadiki navakuru, vakadzi navana vadiki, nokupamba zvinhu zvavo, nezuva rimwe chete, pazuva regumi namatatu romwedzi wegumi nemiviri, iwo mwedzi waAdha.",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.13",
            "verseOrgIds": [
              "EST.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EST 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rimwe gwaro rechirevo ichi raizodzikwa somutemo mudunhu rimwe nerimwe, vanhu vendudzi dzose vachizoziviswa kuti vagare vakagadzirira zuva iroro.",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.14",
            "verseOrgIds": [
              "EST.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EST 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vatakuri vamatsamba vakabuda nokukasika sokurayira kwamambo, vakandozivisa chirevo panhare yeShushani. Mambo naHamani vakagara pasi kuti vanwe, asi guta reShushani rakanyonganiswa.",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.15",
            "verseOrgIds": [
              "EST.3.15"
            ]
          }
        }
      ]
    }
  ],
