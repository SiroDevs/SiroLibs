  "verseCount": 54,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "11",
        "style": "c",
        "sid": "LUK 11"
      },
      "items": [
        {
          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kudzidzisa kwaJesu pamusoro poKunyengetera",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumwe musi Jesu akanga achinyengetera ari pane imwe nzvimbo. Akati apedza, mumwe wavadzidzi vake akati kwaari, \"Ishe, tidzidzisei kunyengetera, saJohani akadzidzisa vadzidzi vake.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.1",
            "verseOrgIds": [
              "LUK.11.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye akati kwavari, \"Kana muchinyengetera, muti:",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.2",
            "verseOrgIds": [
              "LUK.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "LUK 11:2"
      },
      "items": [
        {
          "text": "\" 'Baba vedu vari kudenga,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.2",
            "verseOrgIds": [
              "LUK.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "LUK 11:2"
      },
      "items": [
        {
          "text": "zita renyu ngarikudzwe noutsvene.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.2",
            "verseOrgIds": [
              "LUK.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "LUK 11:2"
      },
      "items": [
        {
          "text": "Umambo hwenyu ngahuuye. Kuda kwenyu ngakuitwe panyika sezvinoitwa kudenga.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.2",
            "verseOrgIds": [
              "LUK.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tipei zuva nezuva chingwa chedu chamazuva namazuva.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.3",
            "verseOrgIds": [
              "LUK.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye mutiregerere zvivi zvedu;",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.4",
            "verseOrgIds": [
              "LUK.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LUK 11:4"
      },
      "items": [
        {
          "text": "nokuti nesuwo tinoregerera vose vanotitadzira.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.4",
            "verseOrgIds": [
              "LUK.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "LUK 11:4"
      },
      "items": [
        {
          "text": "Musatitungamirira mukuedzwa; uye mutinunure pane zvakaipa.' \"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.4",
            "verseOrgIds": [
              "LUK.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akati kwavari, \"Kana mumwe wenyu ane shamwari, uye akaenda kwaari pakati pousiku akati, 'Shamwari, ndikweretesewo zvingwa zvitatu,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.5",
            "verseOrgIds": [
              "LUK.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "nokuti shamwari yangu iri parwendo yasvika kwangu, uye ini handina chandingamupa.'",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.6",
            "verseOrgIds": [
              "LUK.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ipapo uya ari mukati akati, 'Rega kundinetsa. Mukova wangu watopfigwa, uye vana vangu neni tavata. Handikwanisi kumuka kuti ndikupe kana chinhu.'",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.7",
            "verseOrgIds": [
              "LUK.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinokuudzai, kuti kunyange asingazomuki kuti amupe chingwa nokuda kwokuti ishamwari yake, asi nokuda kwokushingirira kwomunhu uyu, achamuka agomupa zvose zvaanoda.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.8",
            "verseOrgIds": [
              "LUK.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Saka ndinoti kwamuri: Kumbirai, muchapiwa, tsvakai, muchawana; gogodzai, muchazarurirwa mukova.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.9",
            "verseOrgIds": [
              "LUK.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti ani naani anokumbira achapiwa; anotsvaka achawana; anogogodza, achazarurirwa mukova.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.10",
            "verseOrgIds": [
              "LUK.11.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndiani pakati penyu vanababa, angati, kana mwanakomana wake amukumbira hove, omupa nyoka pachinzvimbo chehove?",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.11",
            "verseOrgIds": [
              "LUK.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana kuti akakumbira zai, angamupa chinyavada here?",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.12",
            "verseOrgIds": [
              "LUK.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino kana imi, kunyange makaipa zvenyu, muchiziva kupa zvipo zvakanaka kuvana venyu, Baba venyu vari kudenga vachapa zvikuru sei Mweya Mutsvene kuna vanomukumbira!\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.13",
            "verseOrgIds": [
              "LUK.11.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jesu naBheerizebhubhi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akanga achidzinga dhimoni raiva mbeveve. Dhimoni rakati rabva, munhu uya akanga ari mbeveve akataura, uye vazhinji vakashamiswa nazvo.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.14",
            "verseOrgIds": [
              "LUK.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi vamwe vavo vakati, \"Anodzinga dhimoni naBheerizebhubhi, muchinda mukuru wamadhimoni.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.15",
            "verseOrgIds": [
              "LUK.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vamwewo vakamuedza nokumukumbira chiratidzo.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.16",
            "verseOrgIds": [
              "LUK.11.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akaziva ndangariro dzavo akati kwavari, \"Umambo hupi zvahwo hunozvipesanisa huchaparadzwa, uye imba inozvipesanisa ichawa.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.17",
            "verseOrgIds": [
              "LUK.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana Satani achizvipesanisa, umambo hwake hungamira seiko? Ndinotaura izvi nokuti munonditi ndinobudisa madhimoni naBheerizebhubhi.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.18",
            "verseOrgIds": [
              "LUK.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino kana ndichibudisa madhimoni naBheerizebhubhi, ko, vanakomana venyu vanoabudisa naani? Saka zvino, ivo vachava vatongi venyu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.19",
            "verseOrgIds": [
              "LUK.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi kana ndichidzinga madhimoni nomunwe waMwari, ipapo umambo hwaMwari hwasvika kwamuri.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.20",
            "verseOrgIds": [
              "LUK.11.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kana munhu ane simba, akanyatsoshonga nhumbi dzake dzokurwa, akachengeta imba yake, pfuma yake inochengetedzeka.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.21",
            "verseOrgIds": [
              "LUK.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi kana mumwe ane simba akamurwisa uye akamukunda, anomutorera nhumbi dzokurwa dzaanga achivimba nadzo agogova zvaanenge apamba.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.22",
            "verseOrgIds": [
              "LUK.11.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ani naani asiri kudivi rangu anorwa neni, uye asingaunganidzi pamwe chete neni, anoparadzira.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.23",
            "verseOrgIds": [
              "LUK.11.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kana mweya wakaipa ukabuda mumunhu, unopinda nomunzvimbo dzakaoma uchitsvaka zororo ugorishayiwa. Ipapo unoti, 'Ndichadzokera kumba kwandakabva.'",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.24",
            "verseOrgIds": [
              "LUK.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paunosvika, unowana imba yakatsvairwa, yanaka uye igere zvakanaka.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.25",
            "verseOrgIds": [
              "LUK.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo unobuda wondotsvaka mimwe mweya minomwe yakaipa kupfuura iwo, igopinda yondogaramo. Uye magumo omunhu uyo akaipa kupfuura okutanga.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.26",
            "verseOrgIds": [
              "LUK.11.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akati achiri kutaura zvinhu izvi, mumwe mukadzi aiva pakati pavanhu vazhinji akadanidzira achiti, \"Vakaropafadzwa mai vakakuzvarai vakakuyamwisai.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.27",
            "verseOrgIds": [
              "LUK.11.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akapindura akati, \"Asi vakaropafadzwa avo vanonzwa shoko raMwari uye vachiriteerera.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.28",
            "verseOrgIds": [
              "LUK.11.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Chiratidzo chaJona",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanhu vakati vachiwanda, Jesu akati kwavari, \"Rudzi urwu rwakaipa. Runokumbira chiratidzo, asi harungapiwi chiratidzo kunze kwechaJona.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.29",
            "verseOrgIds": [
              "LUK.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti sezvo Jona akanga ari chiratidzo kuvaNinevhe, saizvozvowo ndizvo zvichaita Mwanakomana woMunhu kurudzi urwu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.30",
            "verseOrgIds": [
              "LUK.11.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambokadzi weZasi achasimuka pakutongwa navarume vorudzi urwu agovapa mhosva; nokuti akabva kumagumo enyika kuzonzwa uchenjeri hwaSoromoni, zvino mukuru kuna Soromoni ari pano.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.31",
            "verseOrgIds": [
              "LUK.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Varume veNinevhe vachasimuka pakutongwa norudzi urwu vagorupa mhosva; nokuti ivo vakatendeuka pakuparidza kwaJona, zvino mukuru kuna Jona ari pano.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.32",
            "verseOrgIds": [
              "LUK.11.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mwenje woMuviri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 11:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Hakuna munhu anotungidza mwenje agouisa panzvimbo yakavanda, kana pasi pedengu. Asi anouisa pachigadziko, kuitira kuti vose vanopinda mumba vaone chiedza.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.33",
            "verseOrgIds": [
              "LUK.11.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 11:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ziso rako ndiwo mwenje womuviri wako. Kana meso ako akanaka, muviri wako wosewo uzere nechiedza. Asi kana akaipa, muviri wakowo uzere nerima.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.34",
            "verseOrgIds": [
              "LUK.11.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 11:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chenjererai kuti chiedza chiri mamuri chirege kuva rima.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.35",
            "verseOrgIds": [
              "LUK.11.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 11:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo kana muviri wako wose uzere nechiedza, uye pasina chikamu chawo chine rima, uchavhenekerwa zvakakwana, sezvinoita chiedza chomwenje pachinovhenekera pauri.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.36",
            "verseOrgIds": [
              "LUK.11.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Matambudziko Matanhatu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LUK 11:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akati apedza kutaura, mumwe muFarisi akamukoka kuti azodya naye; saka akaenda, akapinda akagara naye pakudya.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.37",
            "verseOrgIds": [
              "LUK.11.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 11:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi muFarisi akaona kuti Jesu akanga asina kutanga ageza asati adya, zvikamushamisa.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.38",
            "verseOrgIds": [
              "LUK.11.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LUK 11:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Ishe akati kwaari, \"Zvino, imi vaFarisi munosuka kunze kwomukombe nendiro, asi mukati menyu muzere nokukara nokuipa.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.39",
            "verseOrgIds": [
              "LUK.11.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LUK 11:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imi mapenzi avanhu! Ko, akaita kunze haaziye akaitawo nomukati here?",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.40",
            "verseOrgIds": [
              "LUK.11.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LUK 11:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi ipai zviri mukati mendiro sezvipo kuvarombo, uye ipapo zvose zvichava zvakachena kwamuri.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.41",
            "verseOrgIds": [
              "LUK.11.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LUK 11:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mune nhamo imi vaFarisi, nokuti munopa kuna Mwari chegumi chemindi, nerui nezvimwe zvirimwa zvomubindu romuriwo, asi muchirega kururamisira, norudo rwaMwari. Maifanira kuzviita izvi musingasiyi zvokutanga zvisati zvaitwa.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.42",
            "verseOrgIds": [
              "LUK.11.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LUK 11:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mune nhamo imi vaFarisi, nokuti munoda zvigaro zvapamusoro mumasinagoge nokukwaziswa pamisika.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.43",
            "verseOrgIds": [
              "LUK.11.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LUK 11:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mune nhamo imi, nokuti makaita samakuva asina mucherechedzo, vanhu vanofamba napamusoro pawo vasingazvizivi.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.44",
            "verseOrgIds": [
              "LUK.11.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LUK 11:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumwe wavadudziri vomurayiro akamupindura akati, \"Mudzidzisi, kana muchitaura izvi, munotuka nesuwo.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.45",
            "verseOrgIds": [
              "LUK.11.45"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LUK 11:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akapindura akati, \"Mune nhamo nemiwo vadudziri vomurayiro, nokuti munoremedza vanhu nemitoro yavasingagoni kutakura, asi imi pachenyu hamutongosimudzi munwe wenyu kuti muvabatsire.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.46",
            "verseOrgIds": [
              "LUK.11.46"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "LUK 11:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mune nhamo imi, nokuti munovaka marinda avaprofita, uye madzitateguru enyu ariwo akavauraya.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.47",
            "verseOrgIds": [
              "LUK.11.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "LUK 11:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka muri kupupura kuti munotenderana nezvakaitwa namadzitateguru enyu; vakauraya vaprofita uye imi munovaka marinda avo.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.48",
            "verseOrgIds": [
              "LUK.11.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "LUK 11:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuda kwaizvozvo, Mwari muuchenjeri hwake akati, 'Ndichatumira vaprofita navapostori, vamwe vavo vachavauraya uye vachatambudza vamwe.'",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.49",
            "verseOrgIds": [
              "LUK.11.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "LUK 11:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo rudzi urwu ruchava nemhosva yeropa ravaprofita vose, rakadeurwa kubva pakuvamba kwenyika,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.50",
            "verseOrgIds": [
              "LUK.11.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "LUK 11:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "kubva paropa raAbheri kusvikira kuropa raZekaria, uyo akaurayiwa pakati pearitari neimba tsvene. Hongu, ndinoti kwamuri, rudzi urwu ruchava nemhosva yezvinhu izvi zvose.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.51",
            "verseOrgIds": [
              "LUK.11.51"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "LUK 11:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mune nhamo imi, vadudziri vomurayiro, nokuti makabvisa kiyi yokuziva. Imi pachenyu hamuna kupinda, uye makadzivisa vaya vakanga vachipinda.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.52",
            "verseOrgIds": [
              "LUK.11.52"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "LUK 11:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akati abva ipapo, vaFarisi navadzidzisi vomurayiro vakatanga kumupikisa zvikuru nokumubvunza mibvunzo yakawanda,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.53",
            "verseOrgIds": [
              "LUK.11.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "LUK 11:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "vachimirira kuti vamubate pane zvaaizotaura.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.54",
            "verseOrgIds": [
              "LUK.11.54"
            ]
          }
        }
      ]
    }
  ],
