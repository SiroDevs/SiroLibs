  "verseCount": 38,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "1KI 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Soromoni anovaka Temberi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino mugore ramazana mana namakumi masere mushure mokubuda kwavaIsraeri munyika yeIjipiti, mugore rechina rokubata ushe kwaSoromoni pamusoro peIsraeri, mumwedzi waZivhi, unova mwedzi wechipiri, akatanga kuvaka temberi yaJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.1",
            "verseOrgIds": [
              "1KI.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Temberi yakavakirwa Jehovha naMambo Soromoni yakanga yakareba makubhiti makumi matanhatu",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.2",
            "verseOrgIds": [
              "1KI.6.2"
            ]
          }
        },
        {
          "text": ", ina makubhiti makumi maviri",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.2",
            "verseOrgIds": [
              "1KI.6.2"
            ]
          }
        },
        {
          "text": "paupamhi hwayo, ina makubhiti makumi matatu",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.2",
            "verseOrgIds": [
              "1KI.6.2"
            ]
          }
        },
        {
          "text": "pakukwirira kwayo kumusoro.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.2",
            "verseOrgIds": [
              "1KI.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biravira raiva mberi kweimba huru yetemberi rakawedzera upamhi hwetemberi hwamakubhiti makumi maviri",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.3",
            "verseOrgIds": [
              "1KI.6.3"
            ]
          }
        },
        {
          "text": "uye rakanga rakapfuurira mberi kwetemberi namakubhiti gumi",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.3",
            "verseOrgIds": [
              "1KI.6.3"
            ]
          }
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.3",
            "verseOrgIds": [
              "1KI.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaitira temberi iyi mawindo ane upamhi hudiki.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.4",
            "verseOrgIds": [
              "1KI.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamadziro eimba huru neeimba tsvene yomukati akavaka chivakwa chakapoteredza imba, chaiva nedzimwe dzimba kumativi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.5",
            "verseOrgIds": [
              "1KI.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imba yapasi yaiva noupamhi hwamakubhiti mashanu",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.6",
            "verseOrgIds": [
              "1KI.6.6"
            ]
          }
        },
        {
          "text": ", imba yapakati yaiva noupamhi hwamakubhiti matanhatu",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.6",
            "verseOrgIds": [
              "1KI.6.6"
            ]
          }
        },
        {
          "text": "uye imba yechitatu yaiva namakubhiti manomwe",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.6",
            "verseOrgIds": [
              "1KI.6.6"
            ]
          }
        },
        {
          "text": ". Nechokunze akavaka zvitakuriso kumativi kuti matanda arege kupinda mukati mamadziro etemberi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.6",
            "verseOrgIds": [
              "1KI.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuvaka madziro etemberi mabwe akanga avezwa chete ndiwo akashandiswa, uye hapana kunzwikwa kurira kwesando kana mbezo kana mumwe mudziyo patemberi payakanga ichivakwa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.7",
            "verseOrgIds": [
              "1KI.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musuo weimba yapakati waiva kuchamhembe kwetemberi, paiva namatanho aienda kuimba yapasi, achizobva kuimba yapakati achienda kune yechitatu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.8",
            "verseOrgIds": [
              "1KI.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo akavaka temberi, uye akaipedza, akaturika denga ramatanda namapuranga emisidhari.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.9",
            "verseOrgIds": [
              "1KI.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye akavaka dzimba pamadziro etemberi yose. Imwe neimwe yakanga yakareba makubhiti mashanu, uye dzakanga dzakabatanidzwa netemberi namatanda emisidhari.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.10",
            "verseOrgIds": [
              "1KI.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino shoko raJehovha rakasvika kuna Soromoni richiti,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.11",
            "verseOrgIds": [
              "1KI.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Pane zvetemberi iyi yauri kuvaka, kana ukatevera mitemo yangu, ukaita zvandakatema, uye ukachengeta mirayiro yangu yose nokuiteerera, ipapo ndichazadzisa chivimbiso changu newe, chandakavimbisa baba vako Dhavhidhi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.12",
            "verseOrgIds": [
              "1KI.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye ndichagara pakati pavaIsraeri, uye handizorasi vanhu vangu vaIsraeri.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.13",
            "verseOrgIds": [
              "1KI.6.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Soromoni akavaka temberi akaipedza.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.14",
            "verseOrgIds": [
              "1KI.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaisa mapuranga emisidhari pamadziro etemberi nomukati, akaaroverera kubvira pasi kusvikira kumusoro, uye pasi pose pakanga pane mapuranga emusipuresi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.15",
            "verseOrgIds": [
              "1KI.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akakamura necheshure kwetemberi chimwe chikamu chakanga chakareba makubhiti makumi maviri",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.16",
            "verseOrgIds": [
              "1KI.6.16"
            ]
          }
        },
        {
          "text": ", namapuranga emusidhari kubva pasi kusvika kumusoro kuti chive nzvimbo tsvene yomukati metemberi, Nzvimbo Tsvene-tsvene.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.16",
            "verseOrgIds": [
              "1KI.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imba huru yakanga iri pamberi peimba iyi yakanga yakareba makubhiti makumi mana",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.17",
            "verseOrgIds": [
              "1KI.6.17"
            ]
          }
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.17",
            "verseOrgIds": [
              "1KI.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukati metemberi makaitwa nemisidhari yakavezwa mifananidzo yemikombe namaruva akazaruka. Zvose zvaiva misidhari chete, hapana dombo raionekwa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.18",
            "verseOrgIds": [
              "1KI.6.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akagadzira nzvimbo tsvene yomukati, mukatikati metemberi, kuti agogadzikapo areka yesungano yaJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.19",
            "verseOrgIds": [
              "1KI.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukati menzvimbo tsvene yomukati makanga makareba makubhiti makumi maviri, uye upamhi hwayo makubhiti makumi maviri",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.20",
            "verseOrgIds": [
              "1KI.6.20"
            ]
          }
        },
        {
          "text": ", uye makareba makubhiti makumi maviri pakukwirira kwamo mudenga. Akafukidza mukati mose negoridhe rakaisvonaka, uye akafukidzawo aritari namapuranga omusidhari.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.20",
            "verseOrgIds": [
              "1KI.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soromoni akafukidza mukati metemberi yose negoridhe rakaisvonaka, uye akaisa ngetani dzegoridhe dzakachinjika pamberi penzvimbo tsvene yomukati, iyo yakanga yakafukidzwa mukati mose negoridhe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.21",
            "verseOrgIds": [
              "1KI.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka akafukidza mukati mose negoridhe. Akafukidzawo aritari yenzvimbo tsvene yomukati negoridhe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.22",
            "verseOrgIds": [
              "1KI.6.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaita makerubhi maviri omuti womuorivhi, rimwe nerimwe rakareba makubhiti gumi",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.23",
            "verseOrgIds": [
              "1KI.6.23"
            ]
          }
        },
        {
          "text": ", munzvimbo tsvene yomukati.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.23",
            "verseOrgIds": [
              "1KI.6.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bapiro rimwe chete rekerubhi rokutanga rakanga rakareba makubhiti mashanu, uye rimwe bapiro rakanga rakareba makubhiti mashanu, makubhiti gumi kubva pamuromo perimwe bapiro kusvika pamuromo perimwe bapiro.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.24",
            "verseOrgIds": [
              "1KI.6.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kerubhi rechipiri rakanga rakarebawo makubhiti gumi, nokuti makerubhi maviri aya akanga akafanana pakukura namaumbirwo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.25",
            "verseOrgIds": [
              "1KI.6.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kerubhi rimwe nerimwe rakanga rakareba makubhiti gumi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.26",
            "verseOrgIds": [
              "1KI.6.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaisa makerubhi munzvimbo yomukatikati metemberi, mapapiro amakerubhi akatambanudzwa. Bapiro rerimwe kerubhi raiguma mamwe madziro, bapiro rerimwe richiguma mamwe madziro uye mamwe mapapiro awo aigumana pakati peimba.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.27",
            "verseOrgIds": [
              "1KI.6.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 6:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akafukidza makerubhi negoridhe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.28",
            "verseOrgIds": [
              "1KI.6.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 6:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaveza mifananidzo yamakerubhi, yemiti yemichindwe neyamaruva akazaruka, pamadziro ose akatenderedza mudzimba dzomukati nedzimba dzokunze.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.29",
            "verseOrgIds": [
              "1KI.6.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 6:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akafukidzawo pasi pedzimba dzomukati nedzimba dzokunze dzetemberi negoridhe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.30",
            "verseOrgIds": [
              "1KI.6.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 6:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akagadzirira musuo wenzvimbo tsvene yomukati makonhi omuti womuorivhi; chivivo chapamusoro namagwatidziro zvaiva namativi mashanu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.31",
            "verseOrgIds": [
              "1KI.6.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 6:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamakonhi maviri aya omuti womuorivhi akaveza mifananidzo yamakerubhi, yemiti yemichindwe neyamaruva akazaruka, akafukidza makerubhi nemiti yemichindwe negoridhe rakarohwa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.32",
            "verseOrgIds": [
              "1KI.6.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 6:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nenzira imwe cheteyo akagadzirirawo musuo weimba huru chivivo namagwatidziro zvomuti womuorivhi zvakanga zvine mativi mana.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.33",
            "verseOrgIds": [
              "1KI.6.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 6:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaitawo makonhi maviri omuti womusipuresi, mapenga maviri egonhi rimwe aigona kupetwa, uye mapenga maviri erimwe gonhi aigona kupetwa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.34",
            "verseOrgIds": [
              "1KI.6.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1KI 6:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaveza makerubhi, miti yemichindwe namaruva akazaruka paari, akazvifukidza negoridhe rakarohwa zvakaenzanirana pamusoro pezvakavezwa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.35",
            "verseOrgIds": [
              "1KI.6.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1KI 6:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye akavaka chivanze chomukati chine hwaro hutatu hwamatombo akavezwa, nehwaro humwe chete hwamatanda omusidhari.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.36",
            "verseOrgIds": [
              "1KI.6.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1KI 6:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hwaro hwetemberi yaJehovha hwakavakwa mugore rechina, mumwedzi waZivhi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.37",
            "verseOrgIds": [
              "1KI.6.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1KI 6:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mugore regumi nerimwe mumwedzi waBhuri, mwedzi worusere, temberi yakapera kuvakwa yose sezvayakanga yakafanira kuitwa. Akapedza makore manomwe achiivaka.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.38",
            "verseOrgIds": [
              "1KI.6.38"
            ]
          }
        }
      ]
