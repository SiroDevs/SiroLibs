  "verseCount": 66,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "1KI 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Areka inouyiswa kuTemberi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Soromoni akaunganidza pamberi pake vakuru veIsraeri navatungamiri vamarudzi muJerusarema namadzishe emhuri dzavaIsraeri, kuti vauyise areka yesungano yaJehovha kubva kuZioni, Guta raDhavhidhi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.1",
            "verseOrgIds": [
              "1KI.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanhu vose veIsraeri vakaungana pana Mambo Soromoni panguva yomutambo mumwedzi waEtanimi, unova mwedzi wechinomwe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.2",
            "verseOrgIds": [
              "1KI.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakuru vose veIsraeri vakati vasvika, vaprista vakatakura areka,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.3",
            "verseOrgIds": [
              "1KI.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye vakauyisa areka yaJehovha, neTende Rokusangana nemidziyo yose yakatsaurwa yaiva mairi. Vaprista navaRevhi vakazvitakura,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.4",
            "verseOrgIds": [
              "1KI.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye Mambo Soromoni neungano yose yeIsraeri yakanga yaungana paari, vakanga vanaye pamberi peareka, vachibayira makwai nehando zvakawanda zvokuti zvakanga zvisingagoni kuverengwa nokuwanda kwazvo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.5",
            "verseOrgIds": [
              "1KI.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo vaprista vakatakura areka yesungano yaJehovha vakaenda nayo kunzvimbo yayo munzvimbo tsvene yomukati metemberi, muNzvimbo Tsvene-tsvene, vakaigadzika pasi pamapapiro amakerubhi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.6",
            "verseOrgIds": [
              "1KI.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makerubhi akatambanudza mapapiro awo pamusoro penzvimbo yeareka uye akafukidza areka namatanda ayo okutakurisa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.7",
            "verseOrgIds": [
              "1KI.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Matanda aya akanga akareba zvokuti miromo yawo yaionekwa munhu ari paNzvimbo Tsvene pamberi penzvimbo tsvene yomukati, asi kwete munhu ari kunze kweNzvimbo Tsvene; uye achiripo nanhasi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.8",
            "verseOrgIds": [
              "1KI.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muareka makanga musina chinhu kunze kwamahwendefa maviri amabwe ayo akanga aiswamo naMozisi paHorebhi, Jehovha paakaita sungano navaIsraeri mushure mokunge vabuda muIjipiti.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.9",
            "verseOrgIds": [
              "1KI.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vaprista vakati vabuda paNzvimbo Tsvene, gore rakazadza temberi yaJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.10",
            "verseOrgIds": [
              "1KI.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye vaprista vakatadza kuita shumiro yavo nokuda kwegore, nokuti kubwinya kwaJehovha kwakazadza temberi yaJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.11",
            "verseOrgIds": [
              "1KI.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Soromoni akati, \"Jehovha ati anoda kugara mukati merima guru;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.12",
            "verseOrgIds": [
              "1KI.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "zvirokwazvo ndakuvakirai temberi yakanakisisa, nzvimbo yamungagara nokusingaperi.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.13",
            "verseOrgIds": [
              "1KI.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ungano yose yaIsraeri imire ipapo, mambo akatendeukira kwavari akavaropafadza.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.14",
            "verseOrgIds": [
              "1KI.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino akati:",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.15",
            "verseOrgIds": [
              "1KI.8.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "1KI 8:15"
      },
      "items": [
        {
          "text": "\"Ngaarumbidzwe Jehovha, Mwari waIsraeri, uyo ashandisa ruoko rwake kuzadzisa zvaakavimbisa nomuromo wake kuna baba vangu Dhavhidhi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.15",
            "verseOrgIds": [
              "1KI.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti akati, 'Kubvira pazuva randakabudisa vanhu vangu Israeri kubva muIjipiti, handina kusarudza guta rorudzi rupi rweIsraeri kuti ndivake temberi, kuti Zita rangu rive ipapo, asi ndakasarudza Dhavhidhi kuti atonge vanhu vangu Israeri.'",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.16",
            "verseOrgIds": [
              "1KI.8.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Baba vangu Dhavhidhi, mumwoyo mavo vaida kuvakira Zita raJehovha, Mwari weIsraeri, temberi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.17",
            "verseOrgIds": [
              "1KI.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi Jehovha akati kuna baba vangu Dhavhidhi, 'Nokuti zvakanga zviri mumwoyo mako kuti uvakire Zita rangu temberi, wakaita zvakanaka kuva naizvozvo mumwoyo mako.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.18",
            "verseOrgIds": [
              "1KI.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunyange zvakadaro, iwe hausi kuzovaka temberi iyi, asi mwanakomana wako, wauchabereka ndiye achavakira Zita rangu temberi.'",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.19",
            "verseOrgIds": [
              "1KI.8.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Jehovha achengeta chivimbiso chaakaita: ini ndatevera panzvimbo yababa vangu Dhavhidhi, uye zvino ndigere pachigaro chokutonga chaIsraeri, sokuvimbisa kwakaita Jehovha, uye ndavakira Zita raJehovha, Mwari weIsraeri, temberi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.20",
            "verseOrgIds": [
              "1KI.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imomo ndakagadzira nzvimbo yeareka, iyo ine sungano yaJehovha yaakaita namadzibaba edu paakavabudisa kubva muIjipiti.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.21",
            "verseOrgIds": [
              "1KI.8.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Munyengetero waSoromoni woKukumikidza",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Soromoni akamira pamberi pearitari yaJehovha pamberi peungano yose yaIsraeri, akatambanudza maoko ake kudenga,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.22",
            "verseOrgIds": [
              "1KI.8.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "akati,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.23",
            "verseOrgIds": [
              "1KI.8.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "1KI 8:23"
      },
      "items": [
        {
          "text": "\"Jehovha, Mwari weIsraeri, hakuna mumwe Mwari akaita semi kumusoro kudenga kana pasi panyika, imi munochengeta sungano yorudo yavaranda venyu vanofamba pamberi penyu nomwoyo wavo wose.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.23",
            "verseOrgIds": [
              "1KI.8.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makachengeta chivimbiso chenyu kumuranda wenyu Dhavhidhi baba vangu; makavimbisa nomuromo wenyu uye mazvizadzisa noruoko rwenyu sezvazviri nhasi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.24",
            "verseOrgIds": [
              "1KI.8.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Zvino Jehovha, Mwari waIsraeri, chengeterai muranda wenyu Dhavhidhi baba vangu, zvivimbiso zvamakamuitira pamakati, 'Pamberi pangu hapangazoshayikwi munhu anokutevera pachigaro choushe cheIsraeri, kana vana vako vakachenjera pane zvose zvavanoita, vakafamba pamberi pangu sezvawakaita iwe.'",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.25",
            "verseOrgIds": [
              "1KI.8.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo zvino, haiwa Mwari waIsraeri, ndinokumbira kuti shoko renyu ramakavimbisa kumuranda wenyu Dhavhidhi baba vangu riitike.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.26",
            "verseOrgIds": [
              "1KI.8.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Chingava chokwadi here kuti Mwari angagara panyika? Tarirai, matenga kana nokudengadenga hazvingagoni kukukwanai. Ko, kuzoti temberi iyi yandakuvakirai!",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.27",
            "verseOrgIds": [
              "1KI.8.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 8:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunyange zvakadaro, teererai munyengetero womuranda wenyu nokukumbira kwake, haiwa Jehovha Mwari wangu. Inzwai kudanidzira nomunyengetero uri kuitwa nomuranda wenyu pamberi penyu nhasi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.28",
            "verseOrgIds": [
              "1KI.8.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meso enyu ngaarambe akatarisa temberi iyi usiku namasikati, nzvimbo iyi yamakataura muchiti, 'Zita rangu richavapo,' kuti muzonzwa munyengetero unonamatwa nomuranda wenyu akatarisa kunzvimbo ino.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.29",
            "verseOrgIds": [
              "1KI.8.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inzwai kukumbira kwomuranda wenyu, nokwavanhu venyu Israeri pavanozonamata vakatarisa kunzvimbo ino. Inzwai muri kudenga kwamunogara, uye kana manzwa mugoregerera.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.30",
            "verseOrgIds": [
              "1KI.8.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 8:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kana munhu achinge atadzira muvakidzani wake, akanzi apike mhiko uye akauya akapika mhiko pamberi pearitari yenyu mutemberi ino,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.31",
            "verseOrgIds": [
              "1KI.8.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 8:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "ipapo inzwai muri kudenga uye muwane zvamunoita. Tongai pakati pavaranda venyu, mupe mhosva kumutadzi nokuisa pamusoro wake iye zvaanenge aita. Mururamisire akarurama nokumupa zvakafanira kururama kwake.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.32",
            "verseOrgIds": [
              "1KI.8.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 8:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kana vanhu venyu Israeri vachinge vakundwa navavengi vavo, nokuti vakutadzirai, uye vakadzokazve kwamuri, vakapupura zita renyu, vakanamata nokukumbira kwamuri mutemberi, ino,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.33",
            "verseOrgIds": [
              "1KI.8.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 8:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "ipapo inzwai muri kudenga mugoregerera chivi chavanhu venyu Israeri, uye mugovadzosera kunyika yamakapa madzibaba avo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.34",
            "verseOrgIds": [
              "1KI.8.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1KI 8:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kana denga richinge razarirwa mvura ikasanaya nokuti vanhu venyu vakutadzirai, pavanonamata vakatarisa kunzvimbo ino, uye vakapupura zita renyu, vakatendeuka kubva kuchivi chavo nokuti mavaranga,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.35",
            "verseOrgIds": [
              "1KI.8.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1KI 8:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "ipapo inzwai muri kudenga uye mugoregerera chivi chavaranda venyu, vanhu venyu Israeri. Vadzidzisei nzira yakanaka yavanofanira kurarama nayo, uye nayisai mvura panyika yamakapa vanhu venyu kuti ive nhaka yavo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.36",
            "verseOrgIds": [
              "1KI.8.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1KI 8:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kana nzara kana denda zvikauya panyika, kana nyunje, kana muhuvhe, mhashu, kana ndongwe kana muvengi wavo akavakomba mune ripi zvaro ramaguta avo, zvisinei kuti inyatwa ipi kana kuti idenda ripi rauya,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.37",
            "verseOrgIds": [
              "1KI.8.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1KI 8:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye, kana munyengetero kana chikumbiro chaitwa naani zvake wavanhu venyu Israeri, mumwe nomumwe achiziva zvinomutambudza mumwoyo make, akatambanudzira maoko ake kutemberi ino,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.38",
            "verseOrgIds": [
              "1KI.8.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1KI 8:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "ipapo inzwai muri kudenga kwamunogara. Regererai mugowana zvamunoita; mugoitira mumwe nomumwe maererano nazvose zvaanoita, sezvo muchiziva mwoyo wake (nokuti imi chete ndimi munoziva zviri mumwoyo momunhu wose),",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.39",
            "verseOrgIds": [
              "1KI.8.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1KI 8:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuti vakutyei mazuva ose avanorarama panyika yamakapa madzibaba edu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.40",
            "verseOrgIds": [
              "1KI.8.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1KI 8:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Zvino kana ari mutorwa, asiri wavanhu venyu Israeri asi anouya achibva kunyika iri kure nokuda kwezita renyu,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.41",
            "verseOrgIds": [
              "1KI.8.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1KI 8:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "nokuti vanhu vachanzwa nezvezita renyu guru, ruoko rwenyu rune simba noruoko rwenyu rwakatambanudzwa, paanouya akanyengetera akatarisa kutemberi ino,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.42",
            "verseOrgIds": [
              "1KI.8.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1KI 8:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "ipapo inzwai muri kudenga kwamunogara, uye mugoita chinhu chipi nechipi chinokumbirwa kwamuri nomutorwa uyu, kuti marudzi ose enyika azive zita renyu uye agokutyai, sezvinoitwa navanhu venyu Israeri, uye kuti vazive kuti imba ino yandavaka ine Zita renyu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.43",
            "verseOrgIds": [
              "1KI.8.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "1KI 8:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kana vanhu venyu vakaenda kundorwa navavengi vavo, kwose kwamunovatuma, uye pavanonyengetera kuna Jehovha vakatarisa kuguta ramakasarudza netemberi yandavakira Zita renyu,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.44",
            "verseOrgIds": [
              "1KI.8.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "1KI 8:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "ipapo muri kudenga, inzwai munyengetero wavo nechikumbiro chavo, uye mugovabatsira pane zvavanorwira.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.45",
            "verseOrgIds": [
              "1KI.8.45"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "1KI 8:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kana vakakutadzirai, nokuti hakuna munhu asingatadzi, imi mukavatsamwira, mukavaisa mumaoko omuvengi, uye akavaita nhapwa munyika yake, kure kana pedyo;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.46",
            "verseOrgIds": [
              "1KI.8.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "1KI 8:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye kana vakapinduka pamwoyo munyika umo mavari nhapwa, uye vakatendeuka nokudemba kwamuri munyika yavatapi vavo, vakati, 'Takaita, zvakaipa zvisakarurama;'",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.47",
            "verseOrgIds": [
              "1KI.8.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "1KI 8:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye kana vakadzokera kwamuri nomwoyo nomweya wavo wose munyika yavavengi vavo avo vakavatapa vakanyengetera kwamuri vakatarisa kunyika yamakapa madzibaba avo, vakatarisa kuguta ramakasarudza netemberi yandavakira Zita renyu;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.48",
            "verseOrgIds": [
              "1KI.8.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "1KI 8:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "ipapo, muri kudenga, kwamunogara, inzwai munyengetero wavo nechikumbiro chavo, uye mugovabatsira pane zvavanorwira.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.49",
            "verseOrgIds": [
              "1KI.8.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "1KI 8:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muregerere vanhu venyu, vakakutadzirai; muvaregerere pamhosva dzose dzavakapara kwamuri, mugoita kuti vakavatapa vavanzwire tsitsi;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.50",
            "verseOrgIds": [
              "1KI.8.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "1KI 8:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "nokuti vanhu venyu nenhaka yenyu vamakabudisa kubva muIjipiti, vira romoto.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.51",
            "verseOrgIds": [
              "1KI.8.51"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "1KI 8:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Meso enyu ngaaone chikumbiro chomuranda wenyu nechikumbiro chavanhu venyu Israeri, uye muteerere kwavari nguva dzose pavanochema kwamuri.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.52",
            "verseOrgIds": [
              "1KI.8.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "1KI 8:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti makavasarudza pamarudzi ose enyika kuti vave nhaka yenyu, sezvamakataura nokumuranda wenyu Mozisi, imi Jehovha Mwari, pamakabudisa madzibaba edu kubva muIjipiti.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.53",
            "verseOrgIds": [
              "1KI.8.53"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Soromoni anoropafadza Ungano yaIsraeri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "1KI 8:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino Soromoni akati apedza munyengetero uyu wose nokukumbira uku kuna Jehovha, akasimuka achibva pamberi pearitari yaJehovha, paakanga akapfugama namabvi ake, maoko ake akatambanudzirwa kudenga.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.54",
            "verseOrgIds": [
              "1KI.8.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "1KI 8:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akamira akaropafadza ungano yose yeIsraeri nenzwi guru akati:",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.55",
            "verseOrgIds": [
              "1KI.8.55"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "1KI 8:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Jehovha ngaarumbidzwe, iye akapa zororo kuvanhu vake Israeri sezvaakavimbisa chaizvoizvo. Hapana kana shoko rimwe chete risina kuitika pazvivimbiso zvose zvakanaka zvaakapa nokumuranda wake Mozisi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.56",
            "verseOrgIds": [
              "1KI.8.56"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "57",
            "style": "v",
            "sid": "1KI 8:57"
          },
          "items": [
            {
              "text": "57",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha Mwari wedu ngaave nesu sezvaaiva namadzibaba edu; ngaarege kuzotisiya kana kutirasa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.57",
            "verseOrgIds": [
              "1KI.8.57"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "58",
            "style": "v",
            "sid": "1KI 8:58"
          },
          "items": [
            {
              "text": "58",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngaaite kuti mwoyo yedu yose ive yake, kuti tifambe munzira dzake dzose tichichengeta mirayiro, mitemo nezvaakareva izvo zvaakapa madzibaba edu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.58",
            "verseOrgIds": [
              "1KI.8.58"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "59",
            "style": "v",
            "sid": "1KI 8:59"
          },
          "items": [
            {
              "text": "59",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino mashoko angu aya, andanyengetera pamberi paJehovha, ngaave pedyo naJehovha Mwari wedu masikati nousiku, kuti asimudzire zvinorwirwa nomuranda wake nezvinorwirwa navanhu vake Israeri nezvinenge zvichidiwa zuva nezuva,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.59",
            "verseOrgIds": [
              "1KI.8.59"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "60",
            "style": "v",
            "sid": "1KI 8:60"
          },
          "items": [
            {
              "text": "60",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuti vanhu vose vapanyika vazive kuti Jehovha ndiMwari, uye kuti hakuna mumwe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.60",
            "verseOrgIds": [
              "1KI.8.60"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "61",
            "style": "v",
            "sid": "1KI 8:61"
          },
          "items": [
            {
              "text": "61",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi mwoyo yenyu inofanira kuva yakapiwa zvachose kuna Jehovha Mwari wedu, kuti murarame nemitemo yake uye muteerere mirayiro yake sezvamuri kuita iye zvino.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.61",
            "verseOrgIds": [
              "1KI.8.61"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kukumikidzwa kweTemberi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "62",
            "style": "v",
            "sid": "1KI 8:62"
          },
          "items": [
            {
              "text": "62",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino mambo navaIsraeri vose vakabayira zvibayiro pamberi paJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.62",
            "verseOrgIds": [
              "1KI.8.62"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "63",
            "style": "v",
            "sid": "1KI 8:63"
          },
          "items": [
            {
              "text": "63",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soromoni akabayira chibayiro chezvipiriso zvokuwadzana kuna Jehovha; zviuru makumi maviri nezviviri zvemombe nezviuru zana namakumi maviri zvamakwai nembudzi. Saizvozvo mambo navaIsraeri vose vakakumikidza temberi yaJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.63",
            "verseOrgIds": [
              "1KI.8.63"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "64",
            "style": "v",
            "sid": "1KI 8:64"
          },
          "items": [
            {
              "text": "64",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musi iwoyo mambo akakumikidza chikamu chapakati chechivanze chaiva pamberi petemberi yaJehovha, uye ndipo paakabayira zvipiriso zvinopiswa, zvipiriso zvezviyo, namafuta ezvipiriso zvokuwadzana nokuti aritari yendarira yaiva pamberi paJehovha yakanga yakanyanya kuita duku kuti ikwane zvipiriso zvinopiswa, zvipiriso zvezviyo, namafuta ezvipiriso zvokuwadzana.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.64",
            "verseOrgIds": [
              "1KI.8.64"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "65",
            "style": "v",
            "sid": "1KI 8:65"
          },
          "items": [
            {
              "text": "65",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Soromoni akaita mutambo uyu panguva iyoyo, neIsraeri yose pamwe chete naye, ungano huru kwazvo, vanhu vachibva kuRebho Hamati vachisvika kuWadhi yeIjipiti. Vakaupemberera pamberi paJehovha Mwari wedu kwamazuva manomwe namamwe manomwe pamusoro, mazuva gumi namana pamwe chete.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.65",
            "verseOrgIds": [
              "1KI.8.65"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "66",
            "style": "v",
            "sid": "1KI 8:66"
          },
          "items": [
            {
              "text": "66",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pazuva rakatevera akaita kuti vanhu vaende. Vanhu vakaropafadza mambo vakaenda kumisha yavo vane rufaro mumwoyo mavo nokuda kwezvinhu zvakanaka zvose Jehovha zvaakanga aitira muranda wake Dhavhidhi navanhu vake Israeri.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.66",
            "verseOrgIds": [
              "1KI.8.66"
            ]
          }
        }
      ]
    }
