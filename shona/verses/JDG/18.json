  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "18",
        "style": "c",
        "sid": "JDG 18"
      },
      "items": [
        {
          "text": "18",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "VaDhani vanondogara muRaishi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JDG 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumazuva iwayo Israeri yakanga isina mambo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.1",
            "verseOrgIds": [
              "JDG.18.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JDG 18:1"
      },
      "items": [
        {
          "text": "Uye mumazuva iwayo vorudzi rwavaDhani vakanga vachitsvaka nzvimbo yavo pachavo yavangagara, nokuti vakanga vasati vapiwa nhaka pakati pamarudzi eIsraeri.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.1",
            "verseOrgIds": [
              "JDG.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka vaDhani vakatuma varwi vashanu vaibva kuZora neEshitaori kuti vandosora nyika uye vaitarisise. Varume ava vakanga vachimirira dzimba dzavo dzose. Vakavaudza kuti, \"Endai munotarisisa nyika.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.2",
            "verseOrgIds": [
              "JDG.18.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JDG 18:2"
      },
      "items": [
        {
          "text": "Varume vakapinda munyika yezvikomo yaEfuremu vakasvika paimba yaMika, vakavatapo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.2",
            "verseOrgIds": [
              "JDG.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakati vava pedyo nemba yaMika, vakaziva inzwi rejaya muRevhi; saka vakatsaukiramo vakamubvunza vachiti, \"Ndianiko akakuuyisa kuno? Unobatei pano? Seiko uri pano?\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.3",
            "verseOrgIds": [
              "JDG.18.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akavataurira zvaakanga aitirwa naMika, akati, \"Akandipa basa uye ndiri muprista wake.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.4",
            "verseOrgIds": [
              "JDG.18.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo vakati kwaari, \"Tapota, tibvunzire Mwari kuti tizive kana rwendo rwedu ruchabudirira.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.5",
            "verseOrgIds": [
              "JDG.18.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muprista akavapindura akati, \"Endai henyu norugare. Rwendo rwenyu rwatendwa naJehovha.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.6",
            "verseOrgIds": [
              "JDG.18.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka varume vashanyi vaya vakabvapo vakandosvika kuRaishi, uko kwavakandoona kuti vanhu vakanga vagere zvakanaka, sezvakaita vaSidhoni, vasina chavanofungidzira uye vagere zvakanaka. Uye sezvo nyika yavo yakanga isingashayiwi chinhu, vakanga vakabudirira. Uyezve, vakanga vagere kure nava Sidhoni uye vakanga vasina ushamwari naani zvake.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.7",
            "verseOrgIds": [
              "JDG.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakati vadzokera kuZora neEshitaori, hama dzavo dzakavabvunza dzikati, \"Makazviona sei zvinhu imi?\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.8",
            "verseOrgIds": [
              "JDG.18.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakapindura vakati, \"Uyai, tivarwise! Takaona kuti nyika yacho yakanaka kwazvo. Hamungaiti chimwe chinhu here? Musanonoka kuendako kundoitora.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.9",
            "verseOrgIds": [
              "JDG.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamunosvikako muchawana mumaoko enyu naMwari, nyika isina kana chainoshayiwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.10",
            "verseOrgIds": [
              "JDG.18.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo mazana matanhatu avarume vaibva kumhuri yavaDhani vakapakata zvombo kuti vandorwa, vakasimuka vachibva kuZora neEshitaori.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.11",
            "verseOrgIds": [
              "JDG.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vari munzira yavo vakadzika misasa pedyo neKiriati Jearimi muJudha. Ndokusaka nzvimbo iri kumavirira eKiriati Jearimi ichinzi Mahane Dhani kusvikira zuva ranhasi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.12",
            "verseOrgIds": [
              "JDG.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubva ipapo vakaenda kunyika yezvikomo yaEfuremu uye vakasvika kumba kwaMika.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.13",
            "verseOrgIds": [
              "JDG.18.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo varume vashanu vakanga vandosora nyika yeRaishi vakati kuhama dzavo, \"Munoziva here kuti imwe yedzimba idzi ine efodhi, vamwe vamwari, chifananidzo chakavezwa nechifananidzo chakaumbwa? Zvino imi munoziva zvokuita.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.14",
            "verseOrgIds": [
              "JDG.18.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka vakatsaukiramo vakaenda kumba kwejaya muRevhi kumba kwaMika vakandomukwazisa.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.15",
            "verseOrgIds": [
              "JDG.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mazana matanhatu avaDhani, vakapakata zvombo zvokurwa, vakamira pamukova wokupinda nawo pasuo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.16",
            "verseOrgIds": [
              "JDG.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Varume vashanu vakanga vandosora nyika vakapinda mukati vakatora chifananidzo chakavezwa, efodhi, vamwe vamwari nechifananidzo chakaumbwa asi muprista namazana matanhatu avarume vakanga vakapakata zvombo zvokurwa nazvo vakamira pamukova wesuo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.17",
            "verseOrgIds": [
              "JDG.18.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Varume ava vakati vapinda mumba maMika, vakatora mufananidzo wakavezwa, efodhi, vamwe vamwari nechifananidzo chakaumbwa, muprista akati kwavari, \"Muri kuiteiko?\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.18",
            "verseOrgIds": [
              "JDG.18.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JDG 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakamupindura vakati, \"Nyarara! Usambotaura shoko. Handei tose, ugova baba vedu nomuprista wedu. Handiti zviri nani kushumira rudzi neimba iri muIsraeri somuprista pachinzvimbo cheimba yomunhu mumwe here?\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.19",
            "verseOrgIds": [
              "JDG.18.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JDG 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo muprista akafara. Akatora efodhi, vamwe vamwari nechifananidzo chakavezwa akaenda pamwe chete navanhu.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.20",
            "verseOrgIds": [
              "JDG.18.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JDG 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakaisa vana vavo vaduku, zvipfuwo zvavo nenhumbi dzavo pamberi pavo, vakasimuka vakaenda.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.21",
            "verseOrgIds": [
              "JDG.18.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JDG 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakati vafamba chinhambwe kubva pamba yaMika varume vaigara pedyo naMika vakadanwa pamwe chete vakatevera vaDhani vakavabata.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.22",
            "verseOrgIds": [
              "JDG.18.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JDG 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pavakadaidzira mushure mavo, vaDhani vakatendeuka vakati kuna Mika, \"Wakaita seiko iwe, zvawadana vanhu vako kuti vazorwa?\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.23",
            "verseOrgIds": [
              "JDG.18.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JDG 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akapindura akati, \"Makatora vamwari vandakaita, uye muprista wangu mukaenda naye. Chii zvino chandasarirwa nacho? Mungabvunza seiko muchiti, 'Wakaita seiko iwe?' \"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.24",
            "verseOrgIds": [
              "JDG.18.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JDG 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "VaDhani vakapindura vakati, \"Usaita nharo nesu, kuti varume vane hasha varege kukurwisa, uye iwe nemhuri yako mukazorasikirwa noupenyu hwenyu.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.25",
            "verseOrgIds": [
              "JDG.18.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JDG 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka vaDhani vakaenda zvavo, uye Mika, achiona kuti vakanga vaine simba kukunda iye, akadzoka akaenda kumusha kwake.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.26",
            "verseOrgIds": [
              "JDG.18.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JDG 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo vakatora zvakanga zvagadzirwa naMika, uye muprista wake, vakaenda kuRaishi, vakandorwa navanhu vakanga vasina chavanofungidzira vano rugare. Vakavauraya nomunondo vakavapisira maguta avo nomoto.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.27",
            "verseOrgIds": [
              "JDG.18.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JDG 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakanga pasina munhu anovanunura nokuti vaigara kure neSidhoni uye vasina ushamwari naani zvake. Guta rakanga riri mumupata waiva pedyo neBheti Rehobhi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.28",
            "verseOrgIds": [
              "JDG.18.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JDG 18:28"
      },
      "items": [
        {
          "text": "VaDhani vakavakazve guta vakagaramo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.28",
            "verseOrgIds": [
              "JDG.18.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JDG 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakaritumidza kuti Dhani zita ratateguru wavo Dhani, akanga aberekerwa Israeri, kunyange raimbonzi Raishi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.29",
            "verseOrgIds": [
              "JDG.18.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JDG 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikoko vaDhani vakazvimisira chifananidzo, uye Jonatani mwanakomana waGerishomi, mwanakomana waMozisi, uye vanakomana vake vakava vaprista vorudzi rwaDhani kusvikira panguva youtapwa hwenyika.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.30",
            "verseOrgIds": [
              "JDG.18.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JDG 18:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakaramba vachishandisa zvifananidzo zvakaitwa naMika, nguva dzose imba yaMwari payakanga iri muShiro.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.31",
            "verseOrgIds": [
              "JDG.18.31"
            ]
          }
        }
      ]
