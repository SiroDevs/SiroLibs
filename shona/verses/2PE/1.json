  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "2PE 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2PE 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simoni Petro, muranda nomupostori waJesu Kristu, kuna vaya vakagamuchira kutenda kunokosha sokwedu, kubudikidza nokururama kwaMwari wedu noMuponesi wedu Jesu Kristu:",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.1",
            "verseOrgIds": [
              "2PE.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2PE 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasha norugare ngazvive nemi, zviwande kubudikidza nokuziva kwaMwari nokwaJesu Ishe wedu.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.2",
            "verseOrgIds": [
              "2PE.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kudanwa kwoMunhu noKusanangurwa Kwake ngakuve kweChokwadi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2PE 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simba rake dzvene rakatipa zvinhu zvose zvatinoda zvoupenyu uye noumwari kubudikidza nokumuziva kwedu iye akatidana nokubwinya nokunaka kwake chaiko.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.3",
            "verseOrgIds": [
              "2PE.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2PE 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubudikidza naizvozvo, akatipa zvipikirwa zvake zvikuru kwazvo zvinokosha kuti nazvo, mugone kugoverwa umwari uye mugotiza kuora kwomunyika kunouyiswa nokuchiva.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.4",
            "verseOrgIds": [
              "2PE.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2PE 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuda kwaizvozvi, shingairai kuti muwedzere kunaka pakutenda kwenyu; uye pakunaka, muwedzere kuziva;",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.5",
            "verseOrgIds": [
              "2PE.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2PE 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "napakuziva muwedzere kuzvidzora; napakuzvidzora, muwedzere kutsungirira; napakutsungirira, muwedzere umwari;",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.6",
            "verseOrgIds": [
              "2PE.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2PE 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "napaumwari muwedzere kuda vatendi; napakuda vatendi, muwedzere rudo.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.7",
            "verseOrgIds": [
              "2PE.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2PE 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti kana mune zvinhu izvi, zvichiramba zvichiwanda, zvichakuitai kuti musava nousimbe uye musashayiwa zvibereko mukuziva kwenyu Ishe wedu Jesu Kristu.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.8",
            "verseOrgIds": [
              "2PE.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2PE 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi kana munhu asina zvinhu izvi, anoona zviri pedyo uye ibofu, uye akanganwa kuti iye akanatswa pazvivi zvake zvakare.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.9",
            "verseOrgIds": [
              "2PE.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2PE 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo, hama dzangu, shingairai kwazvo kuti muite kuti kudanwa kwenyu nokusanangurwa kwenyu kusimbe. Nokuti kana muchiita zvinhu izvi, hamungatongogumburwi,",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.10",
            "verseOrgIds": [
              "2PE.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2PE 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "nokuti muchagamuchirwa nomufaro mukuru muumambo husingaperi hwaIshe noMuponesi wedu Jesu Kristu.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.11",
            "verseOrgIds": [
              "2PE.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Chiprofita choRugwaro",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2PE 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka ndicharamba ndichikuyeuchidzai zvinhu izvi, kunyange zvazvo muchizviziva uye makanyatsosimba muchokwadi chamunacho zvino.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.12",
            "verseOrgIds": [
              "2PE.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2PE 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinofunga kuti zvakanaka kuti ndimutse ndangariro dzenyu ndichiri mutende romuviri uno,",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.13",
            "verseOrgIds": [
              "2PE.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2PE 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "nokuti ndinoziva kuti ndichakurumidza kuibvisa, sezvandakaratidzwa pachena naIshe wedu Jesu Kristu.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.14",
            "verseOrgIds": [
              "2PE.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2PE 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye ndichashingaira kuti ndione kuti shure kwokuenda kwangu mucharamba muchirangarira zvinhu izvi.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.15",
            "verseOrgIds": [
              "2PE.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2PE 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti hatina kutevera ngano dzakarukwa nouchenjeri patakakuudzai nezvesimba uye nokuuya kwaIshe wedu Jesu Kristu, asi takanga tiri zvapupu zvakaona kubwinya kwake.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.16",
            "verseOrgIds": [
              "2PE.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2PE 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti akagamuchira kukudzwa nokubwinya kwakabva kuna Mwari Baba pakauya inzwi kwaari richibva kudenga mukubwinya kukuru richiti, \"Uyu ndiye Mwanakomana wangu, wandinoda; wandinofarira kwazvo.\"",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.17",
            "verseOrgIds": [
              "2PE.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2PE 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isu pachedu takanzwa inzwi iri rakabva kudenga patakanga tinaye mugomo dzvene.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.18",
            "verseOrgIds": [
              "2PE.1.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2PE 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye tine shoko ravaprofita rakasimba kwazvo, uye muchaita zvakanaka kuti muriteerere, rakaita sechiedza chinovhenekera murima, kusvikira utonga hwatsvuka uye nyamasase ichibuda mumwoyo yenyu.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.19",
            "verseOrgIds": [
              "2PE.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2PE 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamusoro pazvo zvose, munofanira kunzwisisa kuti hakuna chiprofita choRugwaro chakauya nokungodudzira kwomuprofita pachake oga.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.20",
            "verseOrgIds": [
              "2PE.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2PE 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti hakuna chiprofita chakatongouya nokuda kwomunhu, asi vanhu vakataura zvaibva kuna Mwari vachisundwa noMweya Mutsvene.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.21",
            "verseOrgIds": [
              "2PE.1.21"
            ]
          }
        }
      ]
    }
  ],
