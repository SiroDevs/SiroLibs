{
  "id": "2SA.10",
  "number": "10",
  "bookId": "2SA",
  "reference": "2 Samueri 10",
  "copyright": "Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi™ Kopakodzero © 2005, 2018 ne Biblica, Inc. Biblica® Open Shona Contemporary Bible™ Copyright © 2005, 2018 by Biblica, Inc.",
  "verseCount": 19,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "2SA 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Dhavhidhi anokunda vaAmoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokufamba kwenguva mambo wavaAmoni akafa, mwanakomana wake Hanuni akamutevera paumambo.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.1",
            "verseOrgIds": [
              "2SA.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi akafunga kuti, \"Ndichaitira Hanuni mwanakomana waNahashi tsitsi, sokundiitira tsitsi kwakaita baba vake.\" Naizvozvo Dhavhidhi akatuma nhume kundobata Hanuni maoko pamusoro pababa vake.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.2",
            "verseOrgIds": [
              "2SA.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 10:2"
      },
      "items": [
        {
          "text": "Vanhu vaDhavhidhi vakati vasvika kunyika yavaAmoni,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.2",
            "verseOrgIds": [
              "2SA.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "machinda avaAmoni akati kuna Hanuni mambo wavo, \"Munofunga here imi kuti Dhavhidhi ari kuremekedza baba venyu nokutumira kwaaita vanhu vake kuzochema nemi? Dhavhidhi haana kuvatuma here kuti vazoongorora guta nokurisora kuti vagoriparadza?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.3",
            "verseOrgIds": [
              "2SA.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo Hanuni akabata vanhu vaDhavhidhi, akavaveura rumwe rutivi rwendebvu, akacheka zvipfeko zvavo napakati kumagaro, ndokuvadzinga.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.4",
            "verseOrgIds": [
              "2SA.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino Dhavhidhi akati audzwa nezvazvo, akatuma nhume kundosangana navarume ava, nokuti vakanga vanyadziswa zvikuru. Mambo akati, \"Chimbogarai henyu paJeriko kudzamara ndebvu dzenyu dzakura, mugozouya.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.5",
            "verseOrgIds": [
              "2SA.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino vaAmoni pavakaziva kuti vakanga vonhuhwa pamberi paDhavhidhi, vakatenga varwi vetsoka zviuru makumi maviri zvavaAramu kubva kuBheti Rehobhi neZobha, pamwe chete namambo weMaaka navarume chiuru chimwe, uye navarume zviuru gumi nezviviri vaibva kuTobhi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.6",
            "verseOrgIds": [
              "2SA.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paakazvinzwa, Dhavhidhi akatumira Joabhu navarume vose veboka ravarwi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.7",
            "verseOrgIds": [
              "2SA.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "VaAmoni vakabuda pasuo reguta ravo ndokubva vazvironga kuti varwe, uye vaAramu veZobha neRehobhi navarume veTobhi neveMaaka vakanga vari voga mubani.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.8",
            "verseOrgIds": [
              "2SA.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joabhu akaona kuti akanga akombwa navarwi mberi neshure; naizvozvo akasarudza dzimwe mhare dzavaIsraeri ndokuvaendesa kundorwisa vaAramu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.9",
            "verseOrgIds": [
              "2SA.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaisa vamwe vose pasi paAbhishai mukoma wake ndokuvatuma kundorwisa vaAmoni.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.10",
            "verseOrgIds": [
              "2SA.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joabhu akati, \"Kana vaAramu vakandikurira iwe wozouya kuzondinunura; asi kana vaAmoni vakakukurira ipapo ini ndichauya kuzokununura.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.11",
            "verseOrgIds": [
              "2SA.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iva nesimba tirwire vanhu vedu namaguta aMwari wedu takashinga. Jehovha achaita zvinomufadza.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.12",
            "verseOrgIds": [
              "2SA.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino Joabhu navarwi vake vakaenda kundorwisa vaAramu, ivo vakatiza pamberi pake.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.13",
            "verseOrgIds": [
              "2SA.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "VaAmoni pavakaona vaAramu vachitiza, vakatiza pamberi paAbhishai, ndokupinda muguta. Saka Joabhu akadzoka kundorwisa vaAmoni akasvika kuJerusarema.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.14",
            "verseOrgIds": [
              "2SA.10.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "VaAramu vakati vaona kuti vakundwa navaIsraeri, vakaunganazve.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.15",
            "verseOrgIds": [
              "2SA.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hadhadhezeri akakokera vaAramu kubva mhiri kwoRwizi; vakaenda kuHeramu vachitungamirirwa naShobhaki mutungamiri wehondo yaHadhadhezeri.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.16",
            "verseOrgIds": [
              "2SA.10.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi akati azvinzwa, akaunganidza vaIsraeri vose, vakayambuka Jorodhani vakaenda kuHeramu. VaAramu vakazvigadzirira kuti vasangane naDhavhidhi uye vakarwa naye.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.17",
            "verseOrgIds": [
              "2SA.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi vakatiza pamberi pavaIsraeri, Dhavhidhi akauraya mazana manomwe avachairi vengoro dzamabhiza nezviuru makumi mana zvavarwi vetsoka. Akabaya Shobhaki mutungamiri wehondo yavo, akafira ipapo.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.18",
            "verseOrgIds": [
              "2SA.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Madzimambo ose akanga ari varanda vaHadhadhezeri akati aona kuti akundwa navaIsraeri, akayanana navaIsraeri uye akava pasi pavo.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.19",
            "verseOrgIds": [
              "2SA.10.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 10:19"
      },
      "items": [
        {
          "text": "Saka vaAramu vakatya kubatsira vaAmoni zvakare.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.19",
            "verseOrgIds": [
              "2SA.10.19"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "2SA.11",
    "number": "11",
