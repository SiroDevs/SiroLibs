          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akabvisa korona pamusoro wamambo wavo, kurema kwayo kwaisvika tarenda rimwe chete",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.30",
            "verseOrgIds": [
              "2SA.12.30"
            ]
          }
        },
        {
          "text": "uye yakanga yakanamirwa mabwe anokosha, uye yakaiswa pamusoro waDhavhidhi. Akapamba zvinhu zvizhinji kwazvo kubva muguta iri",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.30",
            "verseOrgIds": [
              "2SA.12.30"
            ]
          }
        },
        {
          "name": "verse",
