  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "12",
        "style": "c",
        "sid": "2SA 12"
      },
      "items": [
        {
          "text": "12",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Natani anotsiura Dhavhidhi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha akatuma Natani kuna Dhavhidhi. Paakasvika kwaari, akataura akati, \"Pakanga pane varume vaviri mune rimwe guta, mumwe akanga akapfuma mumwe ari murombo.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.1",
            "verseOrgIds": [
              "2SA.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mupfumi uyu akanga ana makwai mazhinji kwazvo uye nemombe zhinji,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.2",
            "verseOrgIds": [
              "2SA.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "asi murombo akanga asina chinhu kusara kwegwayana rimwe chete raakanga atenga. Akarirera, rikakura naye navana vake. Raidya pamwe chete naye, richinwira pamukombe waayinwira, uye richirara pamaoko ake. Rakanga rakaita somwanasikana kwaari.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.3",
            "verseOrgIds": [
              "2SA.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Zvino muenzi aipfuura hake akasvika kumupfumi uya, asi mupfumi uyu haana kuda kubata rimwe ramakwai ake kana mombe kuti agadzirire zvokudya mupfuuri uyu akanga asvika kwaari. Asi iye akatora gwayana romurombo akarigadzirira uya akanga asvika kwaari.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.4",
            "verseOrgIds": [
              "2SA.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi akatsamwira munhu uyu zvikuru kwazvo akati kuna Natani, \"Chokwadi naJehovha mupenyu, munhu akaita zvinhu zvakadai anofanira kufa!",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.5",
            "verseOrgIds": [
              "2SA.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anofanira kuripira gwayana iri kakapetwa runa pamusoro, nokuti akaita zvinhu zvakadai akasava netsitsi.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.6",
            "verseOrgIds": [
              "2SA.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Natani akati kuna Dhavhidhi, \"Ndimi munhu uyo! Zvanzi naJehovha: Mwari weIsraeri: 'Ndakakuzodza kuti uve mambo weIsraeri, uye ndakakununura kubva paruoko rwaSauro.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.7",
            "verseOrgIds": [
              "2SA.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakapa kwauri imba yatenzi wako, uye vakadzi vatenzi wako ndakavaisa mumaoko ako. Ndakakupa imba yaIsraeri neyaJudha. Uye dai zvose izvi zvakava zvishoma, ndaidai ndakakupa zvimwezve.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.8",
            "verseOrgIds": [
              "2SA.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ko, wakazvidzirei shoko raJehovha nokuita zvisakarurama pamberi pake? Wakauraya Uria muHiti nomunondo uye ukatora mukadzi wake ukamuita wako. Wakamuuraya nomunondo wavaAmoni.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.9",
            "verseOrgIds": [
              "2SA.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo, munondo hauchazobvi mumba mako, nokuti wakandizvidza uye ukatora mukadzi waUria muHiti kuti ave wako.'",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.10",
            "verseOrgIds": [
              "2SA.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Zvanzi naJehovha: 'Kubva mumba mako chaimo ndichauyisa njodzi pamusoro pako. Ndichatora vakadzi vako iwe wakatarira ndigovapa kuno mumwe ari pedyo newe, uye acharara navo masikati machena.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.11",
            "verseOrgIds": [
              "2SA.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwe wakaita muchivande, asi ini ndichazviita masikati machena pamberi peIsraeri yose.' \"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.12",
            "verseOrgIds": [
              "2SA.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Dhavhidhi akati kuna Natani, \"Ndakatadzira Jehovha.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.13",
            "verseOrgIds": [
              "2SA.12.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 12:13"
      },
      "items": [
        {
          "text": "Natani akapindura akati, \"Jehovha akuregerera chitadzo chako. Haungafi hako kwete.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.13",
            "verseOrgIds": [
              "2SA.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi nokuda kwokuti waita izvi, waita kuti vavengi vaJehovha vamuzvidze kwazvo, mwanakomana uyu wauchaberekerwa achafa.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.14",
            "verseOrgIds": [
              "2SA.12.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mushure mokunge Natani adzokera kumba, Jehovha akarova mwana akaberekerwa Dhavhidhi nomukadzi waUria, akabva arwara.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.15",
            "verseOrgIds": [
              "2SA.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi akanyengeterera mwana kuna Mwari. Akatsanya uye akapinda mumba make akapedza usiku nousiku akarara pasi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.16",
            "verseOrgIds": [
              "2SA.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakuru veimba yake vakamira paakanga ari, vachida kuti amuke pasi paakanga ari, asi iye akaramba, uye haana kuda kuti adye navo.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.17",
            "verseOrgIds": [
              "2SA.12.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pazuva rechinomwe mwana akafa. Varanda vaDhavhidhi vakatya kumuudza kuti mwana akanga afa, nokuti vakafunga kuti, \"Apo mwana paakanga achiri mupenyu, takataura naDhavhidhi asi haana kuda kutiteerera. Zvino tichamuudza sei kuti mwana afa? Achazvikuvadza zvikada.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.18",
            "verseOrgIds": [
              "2SA.12.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi akaona kuti varanda vake vakanga vachizevezerana ndokubva aziva kuti mwana akanga afa. Akabvunza akati, \"Mwana afa kanhi?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.19",
            "verseOrgIds": [
              "2SA.12.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 12:19"
      },
      "items": [
        {
          "text": "Vakapindura vakati, \"Hongu afa.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.19",
            "verseOrgIds": [
              "2SA.12.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Dhavhidhi akamuka pasi paakanga ari. Mushure mokunge ashamba, akazora mafuta, uye akapfeka zvimwe zvipfeko, akapinda mumba maJehovha akanamata. Ipapo akaenda kumba kwake, akakumbira zvokudya vakamupa, akadya.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.20",
            "verseOrgIds": [
              "2SA.12.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Varanda vake vakamubvunza vakati, \"Ko, muri kuitirei zvinhu zvakadai? Mwana paakanga achiri mupenyu makatsanya uye mukachema, asi zvino mwana afa, momuka modya!\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.21",
            "verseOrgIds": [
              "2SA.12.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye akapindura akati, \"Apo mwana paakanga achiri mupenyu, ndakatsanya uye ndikachema. Ndaifunga kuti, 'Ndiani anoziva? Zvimwe Jehovha angandinzwira nyasha akaita kuti mwana ararame.'",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.22",
            "verseOrgIds": [
              "2SA.12.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 12:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi zvino zvaafa, ndichatsanyireiko? Ko, ndingamudzosazve here? Ini ndichaenda kwaari, asi iye haangadzoki kwandiri.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.23",
            "verseOrgIds": [
              "2SA.12.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2SA 12:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino Dhavhidhi akanyaradza mukadzi wake Bhatishebha, akaenda kwaari akandorara naye. Akabereka mwanakomana, vakamutumidza kuti Soromoni. Jehovha akamuda;",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.24",
            "verseOrgIds": [
              "2SA.12.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye nokuti Jehovha akamuda, akatuma shoko nokuna Natani muprofita kuti amutumidze kuti Jedhidhia.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.25",
            "verseOrgIds": [
              "2SA.12.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2SA 12:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino Joabhu akandorwa naRabha wavaAmoni uye akatora nhare yamambo.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.26",
            "verseOrgIds": [
              "2SA.12.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2SA 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Joabhu akatuma nhume kuna Dhavhidhi, achiti, \"Ndarwisa Rabha ndikatora nzvimbo inobva mvura yeguta iri.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.27",
            "verseOrgIds": [
              "2SA.12.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2SA 12:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo unganidzai varwi vose mukombe guta mugorikunda. Zvikasadaro ini ndichatora guta, uye rinozotumidzwa zita rangu.\"",
          "type": "text",
          "attrs": {
