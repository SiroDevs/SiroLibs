              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo Dhavhidhi akaunganidza hondo yose ndokubva aenda kuRabha, akandorirwisa akaritora.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.29",
            "verseOrgIds": [
              "2SA.12.29"
            ]
          }
        },
