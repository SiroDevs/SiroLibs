  "verseCount": 39,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "2SA 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hondo pakati peimba yaSauro neimba yaDhavhidhi yakatora nguva refu isati yapera. Dhavhidhi akaramba achisimba asi imba yaSauro yakaramba ichipererwa nesimba.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.1",
            "verseOrgIds": [
              "2SA.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi akaberekerwa vanakomana paHebhuroni:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "2SA 3:2"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "2SA 3:2"
      },
      "items": [
        {
          "text": "Dangwe rake raiva Amunoni mwanakomana waAbhinoami weJezireeri;",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.2",
            "verseOrgIds": [
              "2SA.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "wechipiri, Kiriabhu mwanakomana waAbhigairi chirikadzi yaNabhari weKarimeri;",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.3",
            "verseOrgIds": [
              "2SA.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "2SA 3:3"
      },
      "items": [
        {
          "text": "wechitatu, Abhusaromu mwanakomana waMaaka mwanasikana waTarimai mambo weGeshuri;",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.3",
            "verseOrgIds": [
              "2SA.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "wechina, Adhoniya mwanakomana waHagiti;",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.4",
            "verseOrgIds": [
              "2SA.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "2SA 3:4"
      },
      "items": [
        {
          "text": "wechishanu, Shefatia mwanakomana waAbhitari;",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.4",
            "verseOrgIds": [
              "2SA.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye wechitanhatu, Itireamu mwanakomana womukadzi waDhavhidhi Egira.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.5",
            "verseOrgIds": [
              "2SA.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "2SA 3:5"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4",
        "vid": "2SA 3:5"
      },
      "items": [
        {
          "text": "Ava ndivo vakaberekerwa Dhavhidhi paHebhuroni.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abhineri anoenda kudivi raDhavhidhi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munguva yehondo pakati peimba yaSauro neimba yaDhavhidhi, Abhineri akanga achisimbisa chinzvimbo chake muimba yaSauro.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.6",
            "verseOrgIds": [
              "2SA.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino Sauro aiva nomukadzi womurongo ainzi Rizipa mwanasikana waAiya. Uye Ishi-Bhosheti akati kuna Abhineri, \"Wakararirei nomurongo wababa vangu?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.7",
            "verseOrgIds": [
              "2SA.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhineri akatsamwa zvikuru nezvakanga zvataurwa naIshi-Bhosheti ndokupindura achiti, \"Ko, ndiri musoro wembwa kurutivi rwaJudha here? Nhasi uno ndakatendeka, kuimba yababa vako Sauro nokumhuri yake zvose neshamwari dzake. Handina kukuisa mumaoko aDhavhidhi. Kunyange zvakadaro iye zvino unondipomera mhaka pamusoro pomukadzi uyu!",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.8",
            "verseOrgIds": [
              "2SA.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwari ngaarove Abhineri, zvive zvinorwadza kwazvo, kana ndikasaitira Dhavhidhi izvo zvaakapikirwa naJehovha",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.9",
            "verseOrgIds": [
              "2SA.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "nokubvisa umambo muimba yaSauro ndichisimbisa chigaro choushe chaDhavhidhi pamusoro peIsraeri neJudha kubva paDhani kusvikira kuBheerishebha.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.10",
            "verseOrgIds": [
              "2SA.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ishi-Bhosheti haana kuzomboti bufuzve kuna Abhineri, nokuti akanga ava kumutya.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.11",
            "verseOrgIds": [
              "2SA.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Abhineri akatumira nhume kuna Dhavhidhi kuti dzindopa mashoko ake okuti, \"Ko, nyika ino ndeyani? Itai sungano neni, uye ini ndichakubatsirai kuti Israeri yose iuye kwamuri.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.12",
            "verseOrgIds": [
              "2SA.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi akati, \"Zvakanaka, ndichaita sungano newe. Asi ndinoda chinhu chimwe chete kubva kwauri: Usasvika pamberi pangu kunze kwokunge wauya naMikari mwanasikana waSauro paunouya kuzondiona.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.13",
            "verseOrgIds": [
              "2SA.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Dhavhidhi akatuma nhume kuna Ishi-Bhosheti mwanakomana waSauro, kundoti, \"Ndipe Mikari mudzimai wangu, wandakatsidzirana naye nezvikanda zvokudzingiswa zvapamberi zvavaFiristia vane zana.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.14",
            "verseOrgIds": [
              "2SA.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo Ishi-Bhosheti akatuma nhume kundomutora kumurume wake Paritieri mwanakomana waRaishi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.15",
            "verseOrgIds": [
              "2SA.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvisinei, murume wake akamuperekedza, achichema ari mumashure make dakara vanosvika kuBhahurimi. Ipapo Abhineri akati kwaari, \"Dzokera kumba!\" iye ndokudzokera hake.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.16",
            "verseOrgIds": [
              "2SA.3.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhineri akakurukura navakuru veIsraeri akati, \"Pava nenguva muchida kugadza Dhavhidhi kuti ave mambo wenyu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.17",
            "verseOrgIds": [
              "2SA.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka chizviitai iye zvino! Nokuti Jehovha akavimbisa Dhavhidhi achiti, 'Noruoko rwomuranda wangu Dhavhidhi ndichanunura vanhu vangu Israeri kubva muruoko rwavavengi vavo vose.' \"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.18",
            "verseOrgIds": [
              "2SA.3.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhineri akataura navaBhenjamini pachake. Ipapo akabva akaenda kundoudza Dhavhidhi paHebhuroni zvose zvakanga zvichida kuzoitwa navaIsraeri neimba yose yaBhenjamini.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.19",
            "verseOrgIds": [
              "2SA.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino Abhineri, uyo akanga ana varume makumi maviri, akati asvika kuna Dhavhidhi paHebhuroni, Dhavhidhi akamugadzirira mabiko pamwe chete navarume vaaiva navo.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.20",
            "verseOrgIds": [
              "2SA.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Abhineri akati kuna Dhavhidhi, \"Nditenderei kuti ndiende iye zvino ndinounganidzira ishe wangu mambo Israeri yose, kuti vaite sungano nemi, uye kuti mubate ushe pamusoro pezvose zvinodiwa nomwoyo wenyu.\" Saka Dhavhidhi akaendesa Abhineri, iye akaenda norugare.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.21",
            "verseOrgIds": [
              "2SA.3.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Joabhu anouraya Abhineri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panguva iyoyo varanda vaDhavhidhi naJoabhu vakadzoka kubva kundopamba uye vakauya nezvakawanda zvavakanga vapamba. Asi Abhineri akanga achisiri pamwe naDhavhidhi muHebhuroni, nokuti Dhavhidhi akanga amutendera kuenda, uye akanga aenda norugare.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.22",
            "verseOrgIds": [
              "2SA.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joabhu paakasvika navarwi vose vaaiva navo, akaudzwa kuti Abhineri mwanakomana waNeri akanga auya kuna mambo uye kuti mambo akanga amutendera kuti aende, uye akanga aenda norugare.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.23",
            "verseOrgIds": [
              "2SA.3.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2SA 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo Joabhu akaenda kuna mambo akati, \"Ko, chii chamaita? Tarirai, Abhineri akauya kwamuri. Ko, makaregerei achienda? Zvino atoenda zvake!",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.24",
            "verseOrgIds": [
              "2SA.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munomuziva imi Abhuneri mwanakomana waNeri; anga auya kuzokunyengerai uye kuzoongorora mafambiro enyu nokusora zvose zvamuri kuita.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.25",
            "verseOrgIds": [
              "2SA.3.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2SA 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Joabhu akabva pana Dhavhidhi ndokutumira nhume kuti dzitevere Abhineri, uye vakadzoka naye kubva patsime reSira. Asi Dhavhidhi haana kuzviziva.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.26",
            "verseOrgIds": [
              "2SA.3.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2SA 3:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuzoti Abhineri adzoka paHebhuroni, Joabhu akamutora akaenda naye parutivi, pakati pesuo sokunge aida kutaura naye muchivande. Zvino ipapo, kuti atsive ropa raAsaheri mununʼuna wake, Joabhu akamubaya padumbu, ndokubva afa.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.27",
            "verseOrgIds": [
              "2SA.3.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2SA 3:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shure kwokunge Dhavhidhi anzwa nezvazvo, akati, \"Ini noushe hwangu hatina mhosva nokusingaperi pamberi paJehovha pamusoro peropa raAbhuneri mwanakomana waNeri.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.28",
            "verseOrgIds": [
              "2SA.3.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2SA 3:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ropa rake ngarive pamusoro waJoabhu nepaimba yababa vake yose! Imba yaJoabhu ngairege kushaya munhu ane ronda risingapori, kana ana maperembudzi, kana anofamba nomudonzvo, kana anourayiwa nomunondo, kana anoshayiwa zvokudya.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.29",
            "verseOrgIds": [
              "2SA.3.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2SA 3:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Joabhu nomununʼuna wake Abhishai vakaponda Abhineri nokuti akanga auraya Asaheri mununʼuna wavo muhondo paGibheoni.)",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.30",
            "verseOrgIds": [
              "2SA.3.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2SA 3:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Dhavhidhi akati kuna Joabhu navanhu vose vaiva naye, \"Bvarurai nguo dzenyu mupfeke masaga mufambe muchiungudza pamberi paAbhineri.\" Mambo Dhavhidhi pachake akafamba ari shure kwengoro yaiva nechitunha.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.31",
            "verseOrgIds": [
              "2SA.3.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2SA 3:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakaviga Abhineri paHebhuroni, uye mambo akaridza mhere paguva raAbhineri. Vanhu vose vakachemawo.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.32",
            "verseOrgIds": [
              "2SA.3.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2SA 3:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo akaimba rwiyo urwu rwokuchema Abhineri:",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.33",
            "verseOrgIds": [
              "2SA.3.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "2SA 3:33"
      },
      "items": [
        {
          "text": "\"Ko, Abhineri aifanira kufa nomufiro webenzi here?",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.33",
            "verseOrgIds": [
              "2SA.3.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2SA 3:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maoko ako akanga asina kusungwa,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.34",
            "verseOrgIds": [
              "2SA.3.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2SA 3:34"
      },
      "items": [
        {
          "text": "makumbo ako akanga asina kuiswa mumatare.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.34",
            "verseOrgIds": [
              "2SA.3.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "2SA 3:34"
      },
      "items": [
        {
          "text": "Wakafa sokufa kwomunhu anofira pamberi pavanyangadzi.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.34",
            "verseOrgIds": [
              "2SA.3.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 3:34"
      },
      "items": [
        {
          "text": "Uye vanhu vose vakamuchemazve.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.34",
            "verseOrgIds": [
              "2SA.3.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2SA 3:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo vose vakauya vakagombedzera Dhavhidhi kuti awane chaangadya achiri masikati; asi Dhavhidhi akaita mhiko, achiti, \"Mwari ngaandirove, uye zvakanyanyisa, kana ndikaravira chingwa kana chimwe chinhu zuva risati ravira!\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.35",
            "verseOrgIds": [
              "2SA.3.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2SA 3:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanhu vose vakazviona uye vakafara; zvirokwazvo, chose chakaitwa namambo chakavafadza.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.36",
            "verseOrgIds": [
              "2SA.3.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2SA 3:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo musi uyu vanhu vose neIsraeri yose, vakaziva kuti mambo akanga asingatenderani nokuurayiwa kwaAbhineri mwanakomana waNeri.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.37",
            "verseOrgIds": [
              "2SA.3.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "2SA 3:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo mambo akati kuvaranda vake, \"Hamuzivi here kuti nhasi kwafa jinda uye munhu anokosha muIsraeri?",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.38",
            "verseOrgIds": [
              "2SA.3.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "2SA 3:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye kuti nhasi, kunyange ndiri mambo akazodzwa, handina simba, uye vanakomana vaZeruya ava vava nesimba kupfuura ini. Jehovha ngaaripire munyangadzi zvinoenderana nokuipa kwamabasa ake!\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.39",
            "verseOrgIds": [
              "2SA.3.39"
            ]
          }
        }
      ]
    }
  ],
