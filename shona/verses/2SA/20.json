  "verseCount": 26,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "20",
        "style": "c",
        "sid": "2SA 20"
      },
      "items": [
        {
          "text": "20",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Shebha anomukira Dhavhidhi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino nhubu yainzi Shebha mwanakomana waBhikiri, muBhenjamini, aivapowo. Akaridza hwamanda akadanidzira achiti,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.1",
            "verseOrgIds": [
              "2SA.20.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "2SA 20:1"
      },
      "items": [
        {
          "text": "\"Isu hatina mugove muna Dhavhidhi,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.1",
            "verseOrgIds": [
              "2SA.20.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2SA 20:1"
      },
      "items": [
        {
          "text": "hatina chikamu mumwanakomana waJese!",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.1",
            "verseOrgIds": [
              "2SA.20.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "2SA 20:1"
      },
      "items": [
        {
          "text": "Munhu wose ngaaende kutende rake, imi vaIsraeri!\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.1",
            "verseOrgIds": [
              "2SA.20.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka varume vose veIsraeri vakasiya Dhavhidhi kuti vatevere Shebha mwanakomana waBhikiri. Asi varume veJudha vakagara namambo wavo kubva kuJorodhani kusvikira kuJerusarema.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.2",
            "verseOrgIds": [
              "2SA.20.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi akati adzokera kumuzinda wake muJerusarema, akatora varongo vake gumi vaakanga asiya kuti vachengete muzinda akavaisa mumba vakachengetwa. Akavariritira asi haana kuvata navo. Vakanga vakachengetwa kusvikira pazuva rokufa kwavo, vachirarama sechirikadzi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.3",
            "verseOrgIds": [
              "2SA.20.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo mambo akati kuna Amasa, \"Dana varume veJudha vauye kwandiri pakati pamazuva matatu, uye newe uve pano.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.4",
            "verseOrgIds": [
              "2SA.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi Amasa akati aenda kundodana Judha, akatora nguva yakareba kupfuura yaakanga atarirwa namambo.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.5",
            "verseOrgIds": [
              "2SA.20.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi akati kuna Abhishai, \"Zvino Shebha mwanakomana waBhikiri achatiitira zvakaipa kupfuura zvakaitwa naAbhusaromu. Tora varanda vatenzi wako umutevere, zvimwe angawana maguta akakomberedzwa uye akatipunyuka.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.6",
            "verseOrgIds": [
              "2SA.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka vanhu vaJoabhu, vaKereti, vaPereti nemhare dzose vakabuda vachitungamirirwa naAbhishai. Vakafamba vachibva kuJerusarema vachitevera Shebha mwanakomana waBhikiri.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.7",
            "verseOrgIds": [
              "2SA.20.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakati vari padombo guru muGibheoni, Amasa akauya kuzosangana navo. Joabhu akanga akapfeka nguo yake yokurwa, uye pairi paiva nebhanhire rakasungirwa pachiuno chake rine munondo waiva mumuhara wawo. Zvino akati achienda mberi, wakadonha kubva mumuhara wawo.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.8",
            "verseOrgIds": [
              "2SA.20.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joabhu akati kuna Amasa, \"Wakadiniko, mununʼuna wangu?\" Ipapo Joabhu akabata ndebvu dzaAmasa noruoko rwake rworudyi kuti amutsvode.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.9",
            "verseOrgIds": [
              "2SA.20.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amasa akanga asina kuona munondo waiva muruoko rwaJoabhu, uye Joabhu akaunyudza mudumbu make, uye ura hwake hukawira pasi. Asina kunge abayiwazve, Amasa akafa. Ipapo Joabhu nomununʼuna wake vakatevera Shebha mwanakomana waBhikiri.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.10",
            "verseOrgIds": [
              "2SA.20.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumwe wavanhu vaJoabhu akamira parutivi rwaAmasa akati, \"Ani naani anoda Joabhu, uye ani naani ari waDhavhidhi, ngaatevere Joabhu!\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.11",
            "verseOrgIds": [
              "2SA.20.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amasa akavata achiumburuka muropa rake pakati pomugwagwa. Uye mumwe murume akaona kuti mauto ose aiuya achimira ipapo. Paakaona kuti munhu wose aisvika pana Amasa aimira, akamukweva kubva mumugwagwa akamuisa musango, akakanda nguo pamusoro pake.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.12",
            "verseOrgIds": [
              "2SA.20.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shure kwokunge Amasa abviswa mumugwagwa, varume vose vakapfuurira mberi naJoabhu vachitevera Shebha mwanakomana waBhikiri.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.13",
            "verseOrgIds": [
              "2SA.20.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shebha akapfuura nomumarudzi ose aIsraeri kusvikira kuAbheri Bheti Maaka uye nomudunhu rose ravaBheri, uye vakaungana pamwe chete vakamutevera.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.14",
            "verseOrgIds": [
              "2SA.20.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakauya vakamukomba paShebha muAbheri Bheti Maaka. Vakavaka rusvingo rwevhu rukasvika kuguta, uye rwakamira rwakatarisana nenhare dzokunze. Pavakanga vachiputsa rusvingo,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.15",
            "verseOrgIds": [
              "2SA.20.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "mukadzi akangwara akadanidzira ari muguta akati, \"Inzwai! Inzwai! Taurirai Joabhu kuti auye pano kuti ndigotaura naye.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.16",
            "verseOrgIds": [
              "2SA.20.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaenda kwaari, iye akamubvunza akati, \"Ndiwe Joabhu here?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.17",
            "verseOrgIds": [
              "2SA.20.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 20:17"
      },
      "items": [
        {
          "text": "Akapindura akati, \"Ndini.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.17",
            "verseOrgIds": [
              "2SA.20.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 20:17"
      },
      "items": [
        {
          "text": "Mukadzi akati, \"Teererai zvinoreva murandakadzi wenyu.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.17",
            "verseOrgIds": [
              "2SA.20.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 20:17"
      },
      "items": [
        {
          "text": "Iye akati, \"Ndakateerera.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.17",
            "verseOrgIds": [
              "2SA.20.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukadzi akaenderera achiti, \"Kare kare vaisimboti, 'Tora mhinduro yako paAbheri,' uye zvaipera ipapo.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.18",
            "verseOrgIds": [
              "2SA.20.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 20:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isu tiri vorugare navakatendeka muIsraeri. Uri kuedza kuparadza guta rinova ndiro mai muIsraeri. Seiko uchida kumedza nhaka yaJehovha?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.19",
            "verseOrgIds": [
              "2SA.20.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 20:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joabhu akati, \"Ngazvive kure neni! Ngazvive kure neni kuti ndimedze kana kuparadza!",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.20",
            "verseOrgIds": [
              "2SA.20.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 20:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hazvina kudaro. Asi murume anonzi Shebha mwanakomana waBhikiri, anobva kunyika yamakomo yaEfuremu, ndiye akasimudza ruoko rwake kuti arwise mambo, kuti arwise Dhavhidhi. Uyai nomurume mumwe chete iyeye, ipapo ndichabva paguta.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.21",
            "verseOrgIds": [
              "2SA.20.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 20:21"
      },
      "items": [
        {
          "text": "Mukadzi akati kuna Joabhu, \"Musoro wake uchakandwa kwauri naparusvingo.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.21",
            "verseOrgIds": [
              "2SA.20.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 20:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo mukadzi akaenda kuvanhu vose nezano rake, vakagura musoro waShebha mwanakomana waBhikiri vakaukanda kuna Joabhu. Saka Joabhu akaridza hwamanda, vanhu vake vakapararira vachibva paguta, mumwe nomumwe achidzokera kumba kwake. Uye Joabhu akadzokera kuna mambo muJerusarema.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.22",
            "verseOrgIds": [
              "2SA.20.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 20:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joabhu akanga ari mukuru wehondo yose yeIsraeri;",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.23",
            "verseOrgIds": [
              "2SA.20.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "2SA 20:23"
      },
      "items": [
        {
          "text": "Bhenaya mwanakomana waJehoyadha akanga ari mukuru wavaKereti navaPareti;",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.23",
            "verseOrgIds": [
              "2SA.20.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
