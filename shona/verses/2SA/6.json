  "reference": "2 Samueri 6",
  "copyright": "Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi™ Kopakodzero © 2005, 2018 ne Biblica, Inc. Biblica® Open Shona Contemporary Bible™ Copyright © 2005, 2018 by Biblica, Inc.",
  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "2SA 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Areka inouyiswa kuJerusarema",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi akaunganidza zvakare varume veIsraeri vakanga vasarudzwa, vaisvika makumi matatu ezviuru.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.1",
            "verseOrgIds": [
              "2SA.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akasimuka akaenda navanhu vose vaakanga anavo kuBhaara reJudha, kundotora areka yaMwari kubva ikoko, iyo inodanwa neZita, iro zita raJehovha Wamasimba Ose, agere pakati pamakerubhi ari pamusoro peareka.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.2",
            "verseOrgIds": [
              "2SA.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakaisa areka yaMwari mungoro itsva uye vakauya nayo kubva kumba kwaAbhinadhabhu, pachikomo. Uza naAhio, vanakomana vaAbhinadhabhu, ndivo vakanga vachifambisa ngoro itsva iyi",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.3",
            "verseOrgIds": [
              "2SA.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "areka yaMwari iri pamusoro payo, uye Ahio akanga achifamba mberi kwayo.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.4",
            "verseOrgIds": [
              "2SA.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi neimba yose yeIsraeri vakapemberera Jehovha nesimba ravo rose, vachiimba nokuridza zviridzwa zvamarudzi ose zvomusipuresi, rudimbwa, mbira, matambureni, ngoma dzamatare namakandira.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.5",
            "verseOrgIds": [
              "2SA.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakati vasvika paburiro raNakoni, Uza akatambanudza ruoko rwake ndokubata areka yaMwari, nokuti nzombe dzakanga dzagumburwa.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.6",
            "verseOrgIds": [
              "2SA.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutsamwa kwaJehovha kwakapfuta pamusoro paUza nokuda kwokutadza kwake; naizvozvo Mwari akamuuraya ipapo parutivi peareka yaMwari.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.7",
            "verseOrgIds": [
              "2SA.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Dhavhidhi akatsamwa nokuti Jehovha akanga atsamwira Uza, nokudaro kusvika zvino nzvimbo iyi inodaidzwa kuti Perezi Uza.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.8",
            "verseOrgIds": [
              "2SA.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi akatya Jehovha pazuva iri uye akati, \"Zvino areka yaJehovha ichasvika seiko kwandiri?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.9",
            "verseOrgIds": [
              "2SA.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haana kuda kutora areka yaJehovha kuti aende nayo kuGuta raDhavhidhi. Asi akaitsautsira kumba kwaObhedhi-Edhomu muGiti.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.10",
            "verseOrgIds": [
              "2SA.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Areka yaJehovha yakagara mumba maObhedhi-Edhomu muGiti kwemwedzi mitatu, Jehovha akamuropafadza, iye neimba yake yose.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.11",
            "verseOrgIds": [
              "2SA.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino Mambo Dhavhidhi akaudzwa kuti, \"Jehovha akaropafadza imba yaObhedhi-Edhomu nezvose zvaanazvo, nokuda kweareka yaMwari.\" Saka Dhavhidhi akaburuka akandotora areka yaMwari kubva muimba yaObhedhi-Edhomu akakwidza nayo kuGuta raDhavhidhi achipembera nomufaro.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.12",
            "verseOrgIds": [
              "2SA.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino avo vakanga vakatakura areka yaJehovha vaiti vakafamba nhambwe nhanhatu, vobayira nzombe nemhuru yakakodzwa.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.13",
            "verseOrgIds": [
              "2SA.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi, akapfeka efodhi yomucheka, akatamba pamberi paJehovha nesimba rake rose,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.14",
            "verseOrgIds": [
              "2SA.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "iye neimba yaIsraeri yose vakakwidza neareka yaJehovha vachipururudza nokuridza hwamanda.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.15",
            "verseOrgIds": [
              "2SA.6.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Areka yaJehovha payakanga yopinda muGuta raDhavhidhi, Mikari mwanasikana waSauro akatarira napawindo. Uye paakaona Mambo Dhavhidhi achipembera nokutamba pamberi paJehovha, akamushora mumwoyo make.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.16",
            "verseOrgIds": [
              "2SA.6.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakasvika neareka yaJehovha vakaigadzika panzvimbo yayo mukati metende rayakanga yagadzirirwa naDhavhidhi, uye Dhavhidhi akabayira zvipiriso zvinopiswa nezvipiriso zvokuyananisa pamberi paJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.17",
            "verseOrgIds": [
              "2SA.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino akati apedza kubayira zvipiriso zvinopiswa nezvipiriso zvokuyananisa, akaropafadza vanhu muzita raJehovha Wamasimba Ose.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.18",
            "verseOrgIds": [
              "2SA.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akazotorazve chingwa, keke ramadheti nekeke ramazambiringa akaomeswa akazvipa kuno mumwe nomumwe weungano yose yavaIsraeri, varume navakadzi. Uye vanhu vose vakaenda kudzimba dzavo.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.19",
            "verseOrgIds": [
              "2SA.6.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi paakadzokera kumba kuti andoropafadza veimba yake, Mikari mwanasikana waSauro akabuda kundosangana naye akati, \"Mambo weIsraeri azvisimudzira sei nhasi, zvaabvisa nguo dzoushe pamberi pavarandakadzi vavaranda vake sezvinoitwa nebenzi ripi zvaro.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.20",
            "verseOrgIds": [
              "2SA.6.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi akati kuna Mikari, \"Ndazviita pamberi paJehovha, iye akandisarudza pachinzvimbo chababa vako kana mumwe munhu upi zvake muimba yake uye akandiita kuti ndive mutongi wavanhu vaJehovha, vaIsraeri; naizvozvo ndichapembera pamberi paJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.21",
            "verseOrgIds": [
              "2SA.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndichazvideredza kupfuura izvi, uye ndichazvininipisa pachangu. Asi kana vari varandakadzi vawareva, ndichakudzwa navo.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.22",
            "verseOrgIds": [
              "2SA.6.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye Mikari mwanasikana waSauro haana kubereka vana kusvikira pazuva rokufa kwake.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.23",
            "verseOrgIds": [
              "2SA.6.23"
            ]
          }
        }
      ]
    }
  ],
