  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "16",
        "style": "c",
        "sid": "2SA 16"
      },
      "items": [
        {
          "text": "16",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Dhavhidhi naZibha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi akati afamba chinhambwe chiduku pamusoro pegomo, akaona Zibha, muranda waMefibhosheti akamumirira. Akanga ane mbongoro mbiri dzakanga dzakatakudzwa mazana maviri ezvingwa, nezana ramakeke amaonde nedende rewaini.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.1",
            "verseOrgIds": [
              "2SA.16.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo akabvunza Zibha akati, \"Ko, wauyirei nezvinhu izvi?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.2",
            "verseOrgIds": [
              "2SA.16.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 16:2"
      },
      "items": [
        {
          "text": "Zibha akapindura akati, \"Mbongoro ndedzeveimba yamambo kuti vatasve, zvingwa nemichero ndezvavarume kuti vadye, uye waini ndeyokupedza nyota yeavo vanga vaneta nokuda kwerenje.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.2",
            "verseOrgIds": [
              "2SA.16.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo akabvunza akati, \"Ko, muzukuru watenzi wako aripi?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.3",
            "verseOrgIds": [
              "2SA.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 16:3"
      },
      "items": [
        {
          "text": "Zibha akati kwaari, \"Ari kugara muJerusarema, nokuti anoti iye, 'Nhasi veimba yaIsraeri vachandidzorera umambo hwasekuru vangu.' \"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.3",
            "verseOrgIds": [
              "2SA.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo mambo akati kuna Zibha, \"Tarira, zvose zvanga zviri zvaMefibhosheti zvava zvako.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.4",
            "verseOrgIds": [
              "2SA.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 16:4"
      },
      "items": [
        {
          "text": "Zibha akati, \"Ndinozvideredza. Dai ndawana nyasha pamberi penyu, ishe wangu mambo.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.4",
            "verseOrgIds": [
              "2SA.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Shimei anotuka Dhavhidhi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo Dhavhidhi paakanga ava kusvika kuBhahurimi, mumwe murume aibva kurudzi rumwe chete nemhuri yaSauro akabudamo. Zita rake ainzi Shimei mwanakomana waGera, uye aituka paaibuda.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.5",
            "verseOrgIds": [
              "2SA.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akapotsera mabwe kuna Dhavhidhi namakurukota ose amambo, kunyange zvazvo varwi vose navachengeti vake vakanga vari kurudyi nokuruboshwe rwake.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.6",
            "verseOrgIds": [
              "2SA.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shimei akatuka achiti, \"Ibva kuno, ibva kuno, iwe munhu weropa, munhu akaipa!",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.7",
            "verseOrgIds": [
              "2SA.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha akuripira ropa rose rawakadeura muimba yaSauro, uyo wawakatorera chigaro chokutonga. Jehovha apa ushe kumwanakomana wako Abhusaromu. Wasvika pakuparara nokuti uri munhu weropa!\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.8",
            "verseOrgIds": [
              "2SA.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Abhishai mwanakomana waZeruya akati kuna mambo, \"Ko, iyi imbwa yakafa ingatukirei ishe mambo wangu? Regai ndiende ndinodimura musoro wake.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.9",
            "verseOrgIds": [
              "2SA.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi mambo akati, \"Ko, ini nemi takafanana pakudii, imi vanakomana vaZeruya? Ko, kana achituka nokuti Jehovha ati kwaari, 'Tuka Dhavhidhi,' ndiani angati, 'Ko, unoitirei izvi?' \"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.10",
            "verseOrgIds": [
              "2SA.16.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Dhavhidhi akati kuna Abhishai namakorokota ake ose, \"Mwana wangu, anova wenyama yangu chaiyo, ari kuda kundiuraya. Ko, kuzoti uyu zvake, muBhenjamini! Musiyei akadaro; regai atuke, nokuti Jehovha amutuma.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.11",
            "verseOrgIds": [
              "2SA.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvichida Jehovha angaona kutambura kwangu uye zvimwe angandiripira zvakanaka nokuda kwokutukwa kwandiri kugamuchira nhasi.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.12",
            "verseOrgIds": [
              "2SA.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Dhavhidhi navanhu vake vakaramba vachifamba nenzira, Shimei paakanga achifamba ari kuno rumwe rutivi rwegomo, achituka achingoenda achipotsera matombo kwaari achimupfumburira guruva.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.13",
            "verseOrgIds": [
              "2SA.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo navanhu vose vaiva naye vakasvika kwavaienda vaneta. Akazororapo.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.14",
            "verseOrgIds": [
              "2SA.16.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Zano raHushai naAhitoferi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panguva iyi, Abhusaromu navarume vose veIsraeri vakasvika muJerusarema, uye Ahitoferi aiva naye.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.15",
            "verseOrgIds": [
              "2SA.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino Hushai muAriki, shamwari yaDhavhidhi, akaenda kuna Abhusaromu akandoti kwaari, \"Mambo ngaararame nokusingaperi! Mambo ngaararame nokusingaperi!\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.16",
            "verseOrgIds": [
              "2SA.16.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhusaromu akabvunza Hushai akati, \"Urwu ndirwo rudo rwaunoratidza shamwari yako here? Sei usina kuenda neshamwari yako?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.17",
            "verseOrgIds": [
              "2SA.16.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hushai akati kuna Abhusaromu, \"Kwete, iye akasarudzwa naJehovha, navanhu ava uye navarume vose veIsraeri, ini ndichava wake, uye ndicharamba ndinaye.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.18",
            "verseOrgIds": [
              "2SA.16.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvakarezve, ndingagoshandira aniko? Ko, handifaniri kushandira mwanakomana? Sezvandaishandira baba venyu, saizvozvo ndichakushandirai.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.19",
            "verseOrgIds": [
              "2SA.16.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhusaromu akati kuna Ahitoferi, \"Tipewo zano rako. Toita sei?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.20",
            "verseOrgIds": [
              "2SA.16.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahitoferi akapindura akati, \"Vatai navarongo vababa venyu avo vakasiyiwa vakachengeta muzinda wamambo. Ipapo Israeri yose ichanzwa kuti mazviita chinhu chinonhuhwa mumhuno dzababa venyu, uye maoko avanhu vose vanokutsigirai achasimbiswa.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.21",
            "verseOrgIds": [
              "2SA.16.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo vakamisira Abhusaromu tende pamusoro pedenga remba, uye akavata navarongo vababa vake vaIsraeri vose vachiona.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.22",
            "verseOrgIds": [
              "2SA.16.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 16:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino mumazuva iwayo zano raipiwa naAhitoferi raiita seromunhu anobvunza kuna Mwari. Ndizvozvo zvaifungwa naDhavhidhi pamwe chete naAbhusaromu pamusoro pamazano aipiwa naAhitoferi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.23",
            "verseOrgIds": [
              "2SA.16.23"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "2SA.17",
    "number": "17",
