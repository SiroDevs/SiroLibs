{
  "id": "2KI.6",
  "number": "6",
  "bookId": "2KI",
  "reference": "2 Madzimambo 6",
  "copyright": "Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi™ Kopakodzero © 2005, 2018 ne Biblica, Inc. Biblica® Open Shona Contemporary Bible™ Copyright © 2005, 2018 by Biblica, Inc.",
  "verseCount": 33,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "2KI 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Demo rinopapamadzwa pamusoro pemvura",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino boka ravaprofita rakati kuna Erisha, \"Tarisai, nzvimbo yatinosangana nemi yatiitira diki kwazvo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.1",
            "verseOrgIds": [
              "2KI.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngatiendei kuJorodhani, mumwe nomumwe wedu andotora danda ikoko; tigozvivakira ikoko nzvimbo yokugara.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.2",
            "verseOrgIds": [
              "2KI.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 6:2"
      },
      "items": [
        {
          "text": "Iye akati, \"Endai.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.2",
            "verseOrgIds": [
              "2KI.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo mumwe wavo akati, \"Ndapota, ko, imi hamungaendiwo navaranda venyu here?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.3",
            "verseOrgIds": [
              "2KI.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 6:3"
      },
      "items": [
        {
          "text": "Erisha akati, \"Ndinoenda.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.3",
            "verseOrgIds": [
              "2KI.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo akaenda navo. Vakaenda kuJorodhani vakatanga kutema miti.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.4",
            "verseOrgIds": [
              "2KI.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi mumwe akati achiri kutema muti, musoro wedemo wakasvotoka ukawira mumvura. Akadanidzira akati, \"Haiwa, ishe wangu, rakanga rakweretwa!\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.5",
            "verseOrgIds": [
              "2KI.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munhu waMwari akati, \"Rawira napapi?\" Akati amuratidza nzvimbo yacho, Erisha akatema rutanda akarukandirapo, uye akapapamadza musoro wedemo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.6",
            "verseOrgIds": [
              "2KI.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati, \"Ribudise.\" Ipapo murume akatambanudza ruoko rwake akaritora.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.7",
            "verseOrgIds": [
              "2KI.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Erisha anobata vaAramu vapofumadzwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino mambo weAramu akanga achirwa neIsraeri. Mushure mokutaurirana navaranda vake, akati, \"Ndichadzika musasa wangu panzvimbo yokuti neyokuti.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.8",
            "verseOrgIds": [
              "2KI.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munhu waMwari akatumira shoko kuna mambo weIsraeri achiti, \"Chenjerai kuti murege kupfuura napanzvimbo iyo nokuti vaAramu vari kuburukirako.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.9",
            "verseOrgIds": [
              "2KI.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo mambo weIsraeri akatumira vanhu kunzvimbo iyoyo yaakanga aratidzwa nomunhu waMwari, kuti vandoiongorora. Nguva nenguva Erisha aiyambira mambo, kuti achenjerere nzvimbo dzakadaro.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.10",
            "verseOrgIds": [
              "2KI.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izvi zvakatsamwisa mambo weAramu. Akadana vabati vake akati kwavari, \"Hamungandiudzewo here kuti pakati pedu ari kurutivi rwamambo weIsraeri ndiani?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.11",
            "verseOrgIds": [
              "2KI.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumwe wavabati vake akati, \"Pakati pedu hapana, ishe wangu mambo, asi Erisha, muprofita ari muIsraeri ndiye anoudza mambo weIsraeri mashoko chaiwoiwo amunotaura muimba yenyu yokurara.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.12",
            "verseOrgIds": [
              "2KI.6.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo akati, \"Endai munotsvaka kuti ari kupi, kuitira kuti ndigotuma varume vanomubata.\" Akaziviswa kuti, \"Ari muDhotani.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.13",
            "verseOrgIds": [
              "2KI.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akatumira ikoko mabhiza nengoro namauto akasimba. Vakaenda usiku vakakomba guta.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.14",
            "verseOrgIds": [
              "2KI.6.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muranda womunhu waMwari akati amuka mangwanani aitevera, akabuda panze akaona hondo namabhiza nengoro zvakomba guta. Muranda wake akati, \"Haiwa, ishe wangu, tichaita seiko?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.15",
            "verseOrgIds": [
              "2KI.6.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muprofita akapindura akati, \"Usatya. Vari kwatiri vazhinji kupfuura vari kwavari.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.16",
            "verseOrgIds": [
              "2KI.6.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Erisha akanyengetera akati, \"Haiwa Jehovha, svinudzai meso ake kuti aone.\" Ipapo Jehovha akasvinudza meso omuranda, iye ndokutarisa akaona zvikomo zvakazara namabhiza nengoro dzomoto zvakakomba Erisha.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.17",
            "verseOrgIds": [
              "2KI.6.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vavengi pavakaburuka kwaari, Erisha akanyengetera kuna Jehovha akati, \"Pofumadzai vanhu ava.\" Naizvozvo akavapofumadza sezvakanga zvakumbirwa naErisha.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.18",
            "verseOrgIds": [
              "2KI.6.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erisha akati kwavari, \"Iyi handiyo nzira uye iri harizi iro guta racho. Nditeverei, ndichakutungamirirai kumunhu wamuri kutsvaka.\" Uye akavatungamirira kuSamaria.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.19",
            "verseOrgIds": [
              "2KI.6.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mushure mokupinda kwavo muguta, Erisha akati, \"Jehovha, svinudzai meso avarume ava kuti vaone.\" Ipapo Jehovha akasvinudza meso avo vakatarira, onei, vava muSamaria.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.20",
            "verseOrgIds": [
              "2KI.6.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo weIsraeri akati achivaona, akabvunza Erisha akati, \"Ndivauraye here, baba vangu? Ndovauraya here?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.21",
            "verseOrgIds": [
              "2KI.6.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akamupindura akati, \"Musavauraya. Hamungazouraya vanhu vamunenge makatapa nomunondo wenyu kana uta hwenyu here? Vaisirei zvokudya nemvura pamberi pavo kuti vadye uye vanwe vagodzokera kuna tenzi wavo.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.22",
            "verseOrgIds": [
              "2KI.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo akavagadzirira mabiko makuru, uye vakati vapedza kudya nokunwa akavaendesa, ivo vakadzokera kuna tenzi wavo. Naizvozvo mapoka avapambi vokuAramu akarega zvokupamba nyika yeIsraeri.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.23",
            "verseOrgIds": [
              "2KI.6.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nzara muSamaria",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shure kwenguva, Bheni-Hadhadhi mambo weAramu, akaunganidza hondo yake yose akaenda kundokomba Samaria.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.24",
            "verseOrgIds": [
              "2KI.6.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwakava nenzara huru muguta zvokuti musoro wembongoro waitengeswa mashekeri makumi masere",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.25",
            "verseOrgIds": [
              "2KI.6.25"
            ]
          }
        },
        {
          "text": "esirivha, uye chitswanda",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.25",
            "verseOrgIds": [
              "2KI.6.25"
            ]
          }
        },
        {
          "text": "chamatoto enjiva chaitengeswa namashekeri mashanu",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.25",
            "verseOrgIds": [
              "2KI.6.25"
            ]
          }
        },
        {
          "text": "; nokuti nguva yokukombwa yakanga yarebesa.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.25",
            "verseOrgIds": [
              "2KI.6.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo weIsraeri akati achipfuura naparusvingo, mumwe mukadzi akadanidzira kwaari akati, \"Ndibatsireiwo, ishe wangu mambo!\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.26",
            "verseOrgIds": [
              "2KI.6.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo akamupindura akati, \"Kana Jehovha asingakubatsiri ini ndingakuwanira rubatsiro kupi? Kubva paburiro here? Kubva pachisviniro chewaini here?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.27",
            "verseOrgIds": [
              "2KI.6.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 6:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akamubvunza akati, \"Zvaita sei?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.28",
            "verseOrgIds": [
              "2KI.6.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 6:28"
      },
      "items": [
        {
          "text": "Iye akamupindura akati, \"Mukadzi uyu akati kwandiri, 'Tipe mwanakomana wako kuti timudye nhasi, mangwana tigozodya wangu.'",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.28",
            "verseOrgIds": [
              "2KI.6.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 6:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo takabika mwana wangu tikamudya. Fume mangwana, ini ndokuti kwaari, 'Tipe mwanakomana wako kuti timudye,' asi iye akanga andomuviga.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.29",
            "verseOrgIds": [
              "2KI.6.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2KI 6:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino mambo akanzwa mashoko omukadzi uyu, akabvarura nguo dzake. Akati achifamba naparusvingo, vanhu vakamutarisa, vakaona kuti akanga akapfeka masaga mukati menguo, pamuviri wake.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.30",
            "verseOrgIds": [
              "2KI.6.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2KI 6:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati, \"Mwari ngaandirove zvakanyanya kwazvo, kana musoro waErisha mwanakomana waShafati ukaramba uri pamapfudzi ake nhasi!\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.31",
            "verseOrgIds": [
              "2KI.6.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2KI 6:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino Erisha akanga akagara mumba make, uye vakuru vakanga vagere naye. Mambo akatuma nhume mberi, asi asati asvika, Erisha akati kuvakuru, \"Hamuoni here iyi mhondi iri kutumira munhu kuzodimura musoro wangu? Tarirai, kana nhume yasvika, mupfige mukova muutsigire kuti asapinda. Ko, hausi mutsindo wetsoka dzatenzi wake mushure make here?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.32",
            "verseOrgIds": [
              "2KI.6.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2KI 6:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati achiri kutaurirana navo, nhumwa yakasvika kwaari. Mambo akati, \"Dambudziko iri rinobva kuna Jehovha. Ndichagoramba ndakamirira Jehovha nemhaka yeiko?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.33",
            "verseOrgIds": [
              "2KI.6.33"
            ]
          }
        }
      ]
    }
  ],
