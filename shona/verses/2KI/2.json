  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "2KI 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Eria anoenda kuDenga",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha paakanga ava kuda kutora Eria nechinyamupupuri kuti amuendese kudenga, Eria naErisha vakanga vari munzira vachibva kuGirigari.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.1",
            "verseOrgIds": [
              "2KI.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eria akati kuna Erisha, \"Gara pano, nokuti Jehovha andituma kuBheteri.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.2",
            "verseOrgIds": [
              "2KI.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 2:2"
      },
      "items": [
        {
          "text": "Asi Erisha akati, \"Zvirokwazvo naJehovha mupenyu uye noupenyu hwenyu, handingakusiyei.\" Naizvozvo vakadzika kuBheteri.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.2",
            "verseOrgIds": [
              "2KI.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boka ravaprofita vapaBheteri rakauya kuna Erisha vakamubvunza vakati, \"Unoziva here kuti Jehovha ari kuzokutorera tenzi wako nhasi?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.3",
            "verseOrgIds": [
              "2KI.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 2:3"
      },
      "items": [
        {
          "text": "Erisha akavapindura akati, \"Hongu, ndinozviziva, regai henyu kuzvitaura.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.3",
            "verseOrgIds": [
              "2KI.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Eria akatizve kwaari, \"Gara pano, Erisha; nokuti Jehovha andituma kuJeriko.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.4",
            "verseOrgIds": [
              "2KI.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 2:4"
      },
      "items": [
        {
          "text": "Iye akapindura akati, \"Zvirokwazvo naJehovha mupenyu, uye noupenyu hwenyu, handingakusiyei.\" Naizvozvo vakaenda kuJeriko.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.4",
            "verseOrgIds": [
              "2KI.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boka ravaprofita vapaJeriko rakakwira kuna Erisha vakamubvunza vakati, \"Unoziva here kuti Jehovha ari kuzokutorera tenzi wako nhasi?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.5",
            "verseOrgIds": [
              "2KI.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 2:5"
      },
      "items": [
        {
          "text": "Akavapindura akati, \"Hongu, ndinozviziva, regai henyu kuzvitaura.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.5",
            "verseOrgIds": [
              "2KI.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Eria akatizve kwaari, \"Gara pano; nokuti Jehovha andituma kuJorodhani.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.6",
            "verseOrgIds": [
              "2KI.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 2:6"
      },
      "items": [
        {
          "text": "Iye akapindura akati, \"Zvirokwazvo naJehovha mupenyu uye noupenyu hwenyu, handikusiyei.\" Saka vakafamba vose vari vaviri.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.6",
            "verseOrgIds": [
              "2KI.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boka ravaprofita, ravarume makumi mashanu, rakaenda rikandomira nechokure, vakatarisana napanzvimbo pakanga pamire Eria naErisha paJorodhani.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.7",
            "verseOrgIds": [
              "2KI.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eria akatora jasi rake akaripeta akarova mvura naro, mvura ikaparadzana, imwe kurudyi, imwe kuruboshwe, ivo vaviri vakayambuka napakaoma.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.8",
            "verseOrgIds": [
              "2KI.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakati vayambuka, Eria akati kuna Erisha, \"Nditaurire, unoda kuti ndikuitirei ndisati ndatorwa kubva kwauri?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.9",
            "verseOrgIds": [
              "2KI.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 2:9"
      },
      "items": [
        {
          "text": "Erisha akapindura akati \"Ndipei migove miviri yomweya wenyu.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.9",
            "verseOrgIds": [
              "2KI.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eria akati, \"Wakumbira chinhu chakaoma, asi kana ukandiona ndichitorwa kubva kwauri, uchaupiwa, asi kana zvisina kudaro, haungaupiwi.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.10",
            "verseOrgIds": [
              "2KI.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino pavakanga vachifamba, vachitaurirana, pakarepo ngoro yomoto namabhiza omoto zvakaonekwa zvikaparadzanisa vaviri ava, Eria akaenda kudenga muchinyamupupuri.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.11",
            "verseOrgIds": [
              "2KI.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye Erisha akazviona akadanidzira nenzwi guru akati, \"Baba vangu! Baba vangu! Ngoro navarume vamabhiza veIsraeri!\" Zvino Erisha haana kuzomuonazve. Ipapo akabata nguo dzake akadzibvarura napakati.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.12",
            "verseOrgIds": [
              "2KI.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akanonga jasi rakanga rawira pasi, richibva kuna Eria akadzokera kundomira pamahombekombe eJorodhani.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.13",
            "verseOrgIds": [
              "2KI.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akatora jasi raEria rakanga rawa kubva paari akarova mvura naro akati, \"Zvino Jehovha Mwari waEria aripiko?\" Paakarova mvura, yakaparadzana, imwe kurudyi, imwe kuruboshwe, iye ndokubva ayambuka achienda mhiri.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.14",
            "verseOrgIds": [
              "2KI.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boka ravaprofita vapaJeriko, avo vakanga vakatarisa, vakati, \"Mweya waEria wagara pamusoro paErisha.\" Uye vakaenda kundosangana naye vakakotamira pasi pamberi pake.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.15",
            "verseOrgIds": [
              "2KI.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakati, \"Tarirai, isu varanda venyu tine varume makumi mashanu vakasimba. Ngavaende vandotsvaka tenzi wenyu. Zvimwe Mweya waJehovha wamusimudza ukandomugarisa pamusoro perimwe gomo kana mune mumwe mupata.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.16",
            "verseOrgIds": [
              "2KI.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 2:16"
      },
      "items": [
        {
          "text": "Erisha akavapindura akati, \"Kwete, musavatuma.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.16",
            "verseOrgIds": [
              "2KI.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi vakaramba vachimugombedzera kusvikira anyara kwazvo kuti avarambidze. Saka akati, \"Vatumei henyu.\" Saka vakatuma varume makumi mashanu vakandomutsvaka kwamazuva matatu asi havana kumuwana.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.17",
            "verseOrgIds": [
              "2KI.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pavakadzokera kuna Erisha, kwaaigara muJeriko, akati kwavari, \"Handina kukuudzai here kuti musaenda?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.18",
            "verseOrgIds": [
              "2KI.2.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mvura inonatswa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Varume vomuguta vakati kuna Erisha, \"Tarirai, tenzi wedu, guta iri riri pakanaka, asi sezvamunoona henyu, mvura yacho yakaipa uye nyika yacho haina zvibereko.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.19",
            "verseOrgIds": [
              "2KI.2.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye akati, \"Ndivigirei ndiro itsva uye muise munyu mairi.\" Naizvozvo vakamuvigira ndiro yacho.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.20",
            "verseOrgIds": [
              "2KI.2.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akaenda kuchitubu akakanda munyu imomo achiti, \"Zvanzi naJehovha: 'Ndanatsa mvura iyi. Haichazokonzeri rufuzve kana kushayisa nyika zvibereko.' \"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.21",
            "verseOrgIds": [
              "2KI.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka mvura yakaramba yakanaka kusvikira nhasi sezvakanga zvarehwa neshoko rakataurwa naErisha.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.22",
            "verseOrgIds": [
              "2KI.2.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achibva ipapo, Erisha akaenda kuBheteri. Paakanga achifamba mumugwagwa, vamwe vechidiki vakabuda muguta vakamusveeredza, vakati kwaari, \"Kwira kumusoro, iwe nyamhanza! Kwira kumusoro, iwe nyamhanza!\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.23",
            "verseOrgIds": [
              "2KI.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
