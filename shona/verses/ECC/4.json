  "verseCount": 16,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "ECC 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Udzvinyiriri, Kushanda, noKusava Neshamwari",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ECC 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakatarirazve ndikaona udzvinyiriri hwose hwaiitika pasi pezuva:",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.1",
            "verseOrgIds": [
              "ECC.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 4:1"
      },
      "items": [
        {
          "text": "Ndakaona misodzi yavanodzvinyirirwa,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.1",
            "verseOrgIds": [
              "ECC.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 4:1"
      },
      "items": [
        {
          "text": "uye havana munyaradzi;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.1",
            "verseOrgIds": [
              "ECC.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 4:1"
      },
      "items": [
        {
          "text": "simba raiva kudivi ravadzvinyiriri vavo,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.1",
            "verseOrgIds": [
              "ECC.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 4:1"
      },
      "items": [
        {
          "text": "uye havana munyaradzi.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.1",
            "verseOrgIds": [
              "ECC.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ECC 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakati vakafa,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.2",
            "verseOrgIds": [
              "ECC.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 4:2"
      },
      "items": [
        {
          "text": "vakanguri vafa kare,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.2",
            "verseOrgIds": [
              "ECC.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 4:2"
      },
      "items": [
        {
          "text": "vano mufaro kupfuura vapenyu,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.2",
            "verseOrgIds": [
              "ECC.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 4:2"
      },
      "items": [
        {
          "text": "vachiri kurarama.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.2",
            "verseOrgIds": [
              "ECC.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ECC 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi ari nani kupfuura",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.3",
            "verseOrgIds": [
              "ECC.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 4:3"
      },
      "items": [
        {
          "text": "vose ndiye uyo asati atombovapo,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.3",
            "verseOrgIds": [
              "ECC.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 4:3"
      },
      "items": [
        {
          "text": "uyo asati amboona zvakaipa",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.3",
            "verseOrgIds": [
              "ECC.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 4:3"
      },
      "items": [
        {
          "text": "zvinoitwa pasi pezuva.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.3",
            "verseOrgIds": [
              "ECC.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ECC 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye ndakaona kuti kushanda kwose nokuwana kwose kwomunhu kunobva pakuchiva muvakidzani wake. Izviwo hazvina maturo, kudzinganisana nemhepo.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.4",
            "verseOrgIds": [
              "ECC.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ECC 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Benzi rinopeta maoko aro,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.5",
            "verseOrgIds": [
              "ECC.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 4:5"
      },
      "items": [
        {
          "text": "rozviparadza.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.5",
            "verseOrgIds": [
              "ECC.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ECC 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsama imwe yorugare",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.6",
            "verseOrgIds": [
              "ECC.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 4:6"
      },
      "items": [
        {
          "text": "inopfuura tsama mbiri dzokutambudzika",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.6",
            "verseOrgIds": [
              "ECC.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 4:6"
      },
      "items": [
        {
          "text": "nokudzingana nemhepo.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.6",
            "verseOrgIds": [
              "ECC.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ECC 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino ndakaona chinhu chisina maturo pasi pezuva.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.7",
            "verseOrgIds": [
              "ECC.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ECC 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwaiva nomunhu aigara ari oga;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.8",
            "verseOrgIds": [
              "ECC.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 4:8"
      },
      "items": [
        {
          "text": "akanga asina mwanakomana, kana mununʼuna.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.8",
            "verseOrgIds": [
              "ECC.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 4:8"
      },
      "items": [
        {
          "text": "Kushanda kwake kwakanga kusina magumo,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.8",
            "verseOrgIds": [
              "ECC.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 4:8"
      },
      "items": [
        {
          "text": "kunyange zvakadaro meso ake haana kugutswa nepfuma yake.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.8",
            "verseOrgIds": [
              "ECC.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 4:8"
      },
      "items": [
        {
          "text": "Akabvunza akati, \"Ndinotambudzikira aniko,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.8",
            "verseOrgIds": [
              "ECC.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 4:8"
      },
      "items": [
        {
          "text": "uye sei ndichizvinyima mafaro?\"",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.8",
            "verseOrgIds": [
              "ECC.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 4:8"
      },
      "items": [
        {
          "text": "Naizvozviwo hazvina maturo,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.8",
            "verseOrgIds": [
              "ECC.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 4:8"
      },
      "items": [
        {
          "text": "basa rokutambura!",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.8",
            "verseOrgIds": [
              "ECC.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ECC 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vaviri vari nani pano mumwe chete,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.9",
            "verseOrgIds": [
              "ECC.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 4:9"
      },
      "items": [
        {
          "text": "nokuti vano mugove wakanaka pakushanda kwavo:",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.9",
            "verseOrgIds": [
              "ECC.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ECC 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana mumwe akawira pasi,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.10",
            "verseOrgIds": [
              "ECC.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 4:10"
      },
      "items": [
        {
          "text": "shamwari yake inogona kumubatsira kuti amire zvakare.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.10",
            "verseOrgIds": [
              "ECC.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 4:10"
      },
      "items": [
        {
          "text": "Asi ane nhamo munhu anowira pasi,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.10",
            "verseOrgIds": [
              "ECC.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 4:10"
      },
      "items": [
        {
          "text": "asina anomusimudza!",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.10",
            "verseOrgIds": [
              "ECC.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ECC 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyezve kana vaviri vachivata pamwe chete, vachadziyirwa.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.11",
            "verseOrgIds": [
              "ECC.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 4:11"
      },
      "items": [
        {
          "text": "Asi mumwe chete angadziyirwa sei?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.11",
            "verseOrgIds": [
              "ECC.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ECC 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munhu mumwe chete angakurirwa simba,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.12",
            "verseOrgIds": [
              "ECC.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 4:12"
      },
      "items": [
        {
          "text": "asi vaviri vanozvidzivirira.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.12",
            "verseOrgIds": [
              "ECC.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 4:12"
      },
      "items": [
        {
          "text": "Rwodzi rwakakoswa mutatu harungakurumidzi kudamburwa.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.12",
            "verseOrgIds": [
              "ECC.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kuenda mberi hakuna maturo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ECC 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jaya murombo asi rakachenjera riri nani kupfuura mambo mutana ari benzi, asisazivi kuteerera kana achipiwa yambiro.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.13",
            "verseOrgIds": [
              "ECC.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
