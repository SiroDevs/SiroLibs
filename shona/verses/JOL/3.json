  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "JOL 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kutongwa kweNdudzi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOL 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mumazuva iwayo, napanguva iyoyo,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.1",
            "verseOrgIds": [
              "JOL.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 3:1"
      },
      "items": [
        {
          "text": "kana ndichinge ndadzosa pfuma yeJudha neyeJerusarema,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.1",
            "verseOrgIds": [
              "JOL.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOL 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndichaunganidza ndudzi dzose",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.2",
            "verseOrgIds": [
              "JOL.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 3:2"
      },
      "items": [
        {
          "text": "ndigoenda nadzo kuMupata waJehoshafati.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.2",
            "verseOrgIds": [
              "JOL.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOL 3:2"
      },
      "items": [
        {
          "text": "Ipapo ndichavatonga",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.2",
            "verseOrgIds": [
              "JOL.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 3:2"
      },
      "items": [
        {
          "text": "nokuda kwenhaka yangu, vanhu vangu vaIsraeri,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.2",
            "verseOrgIds": [
              "JOL.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOL 3:2"
      },
      "items": [
        {
          "text": "nokuti vakaparadzira vanhu vangu pakati pendudzi,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.2",
            "verseOrgIds": [
              "JOL.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 3:2"
      },
      "items": [
        {
          "text": "uye vakagovana nyika yangu.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.2",
            "verseOrgIds": [
              "JOL.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOL 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakakanda mijenya pamusoro pavanhu vangu,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.3",
            "verseOrgIds": [
              "JOL.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 3:3"
      },
      "items": [
        {
          "text": "vakatsinhanisa vakomana nezvifeve;",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.3",
            "verseOrgIds": [
              "JOL.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOL 3:3"
      },
      "items": [
        {
          "text": "vakatengesa vanasikana kuti vagotenga waini",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.3",
            "verseOrgIds": [
              "JOL.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 3:3"
      },
      "items": [
        {
          "text": "yokuti vanwe.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.3",
            "verseOrgIds": [
              "JOL.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOL 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Zvino ndakakutadzirai chiiko, imi Tire neSidhoni, nemi matunhu ose eFiristia? Muri kundiripira chimwe chinhu chandakaita here? Zvino kana muchindiripira, ini ndichadzosera zvamakaita pamisoro yenyu chaiyo nokukurumidza chaizvo.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.4",
            "verseOrgIds": [
              "JOL.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOL 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti makatora sirivha negoridhe rangu, mukatakurawo midziyo yangu yakanakisisa mukandoiisa kutemberi dzenyu.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.5",
            "verseOrgIds": [
              "JOL.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOL 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makatengesa vanhu veJudha neveJerusarema kuvaGiriki kuti muvaendese kure.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.6",
            "verseOrgIds": [
              "JOL.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOL 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Tarirai, ini ndichavamutsa kubva kunzvimbo dzamakavatengesera, uye ndichadzosera pamisoro yenyu chaiyo zvamakaita.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.7",
            "verseOrgIds": [
              "JOL.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOL 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndichatengesa vanakomana navanasikana venyu kuvanhu veJudha, uye vachavatengesa kuvaShebha, rudzi rwuri kure.\" Jehovha ataura.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.8",
            "verseOrgIds": [
              "JOL.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOL 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paridzirai izvi kundudzi dzose:",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.9",
            "verseOrgIds": [
              "JOL.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 3:9"
      },
      "items": [
        {
          "text": "Gadzirirai hondo!",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.9",
            "verseOrgIds": [
              "JOL.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOL 3:9"
      },
      "items": [
        {
          "text": "Mutsai varwi!",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.9",
            "verseOrgIds": [
              "JOL.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 3:9"
      },
      "items": [
        {
          "text": "Varwi vose ngavaswedere pedyo varwise.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.9",
            "verseOrgIds": [
              "JOL.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOL 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pfurai mapadza enyu muaite minondo,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.10",
            "verseOrgIds": [
              "JOL.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 3:10"
      },
      "items": [
        {
          "text": "uye mapanga okuchekerera miti muaite mapfumo.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.10",
            "verseOrgIds": [
              "JOL.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOL 3:10"
      },
      "items": [
        {
          "text": "Asina simba ngaati, \"Ndine simba!\"",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.10",
            "verseOrgIds": [
              "JOL.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOL 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyai nokukurumidza, imi ndudzi dzose, kubva kumativi ose",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.11",
            "verseOrgIds": [
              "JOL.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 3:11"
      },
      "items": [
        {
          "text": "mugoungana ipapo.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.11",
            "verseOrgIds": [
              "JOL.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "JOL 3:11"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOL 3:11"
      },
      "items": [
        {
          "text": "Haiwa Jehovha, burutsai varwi venyu.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.11",
            "verseOrgIds": [
              "JOL.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOL 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndudzi dzose ngadzimutswe;",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.12",
            "verseOrgIds": [
              "JOL.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 3:12"
      },
      "items": [
        {
          "text": "ngadziende kuMupata waJehoshafati,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.12",
            "verseOrgIds": [
              "JOL.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOL 3:12"
      },
      "items": [
        {
          "text": "nokuti ipapo ndipo pandichagara pasi",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.12",
            "verseOrgIds": [
              "JOL.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 3:12"
      },
      "items": [
        {
          "text": "kuti nditonge ndudzi dzose kumativi ose enyika.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.12",
            "verseOrgIds": [
              "JOL.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOL 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shandisai jeko,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.13",
            "verseOrgIds": [
              "JOL.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 3:13"
      },
      "items": [
        {
          "text": "nokuti gohwo raibva.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.13",
            "verseOrgIds": [
              "JOL.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOL 3:13"
      },
      "items": [
        {
          "text": "Uyai musvine mazambiringa netsoka dzenyu,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.13",
            "verseOrgIds": [
              "JOL.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 3:13"
      },
      "items": [
        {
          "text": "nokuti chisviniro chazara,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.13",
            "verseOrgIds": [
              "JOL.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 3:13"
      },
      "items": [
        {
          "text": "uye zvirongo zvopfachukira,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.13",
            "verseOrgIds": [
              "JOL.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOL 3:13"
      },
      "items": [
        {
          "text": "uku ndiko kukura kwakaita kuipa kwavo.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.13",
            "verseOrgIds": [
              "JOL.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOL 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vazhinji zhinji, vazhinji zhinji,",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.14",
            "verseOrgIds": [
              "JOL.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOL 3:14"
      },
      "items": [
        {
          "text": "vari mumupata wokutonga.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.14",
            "verseOrgIds": [
              "JOL.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOL 3:14"
      },
      "items": [
        {
          "text": "Nokuti zuva raJehovha rava pedyo",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.14",
            "verseOrgIds": [
              "JOL.4.14"
