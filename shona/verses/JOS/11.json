  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "11",
        "style": "c",
        "sid": "JOS 11"
      },
      "items": [
        {
          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Madzimambo oKumusoro anokundwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino Jabhini mambo weHazori akati anzwa pamusoro paizvozvi, akatumira shoko kuna Jobhabhi mambo weMadhoni, nokuna madzimambo eShimuroni neAkishafi,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.1",
            "verseOrgIds": [
              "JOS.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye nokumadzimambo okumusoro aigara mumakomo, muArabha zasi kweKinereti, kumadokero kwamajinga ezvikomo uye nokuzvikomo zveNafoti Dhori kumadokero;",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.2",
            "verseOrgIds": [
              "JOS.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "NokuvaKenani kumabudazuva nokumadokero, nokuvaAmori, vaHiti, vaPerizi navaJebhusi munyika yamakomo; uye nokuvaHivhi muzasi meHemoni mudunhu reMizipa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.3",
            "verseOrgIds": [
              "JOS.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakauya nehondo dzavo dzose namabhiza nengoro zhinji zhinji, navanhu vazhinji kwazvo, vakanga vakawanda sejecha rapamahombekombe egungwa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.4",
            "verseOrgIds": [
              "JOS.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Madzimambo ose aya akaungana vakavaka musasa pamwe chete paMvura yeMeromi, kuti vazorwa navaIsraeri.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.5",
            "verseOrgIds": [
              "JOS.11.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha akati kuna Joshua, \"Usavatya nokuti mangwana nguva ino ndichavaisa vose vakatofa mumaoko avaIsraeri. Munofanira kutema marunda amakumbo amabhiza avo nokupisa ngoro dzavo.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.6",
            "verseOrgIds": [
              "JOS.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo Joshua nehondo yake vakavavinga pakarepo paMvura yeMeromi vakavarwisa,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.7",
            "verseOrgIds": [
              "JOS.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye Jehovha akavaisa mumaoko avaIsraeri. Vakavakunda vakavadzinganisa kusvikira kuGuta reSidhoni, nokuMisirefoti Maimi, nokuMupata weMizipa kumabvazuva, kusvikira pasisina mupenyu akasara.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.8",
            "verseOrgIds": [
              "JOS.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joshua akaita kwavari zvakanga zvarayirwa naJehovha: Akatema marunda amabhiza akapisa ngoro dzavo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.9",
            "verseOrgIds": [
              "JOS.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panguva iyoyo, Joshua akadzokera akatora Hazori ndokuuraya mambo waro. (Hazori waiva muzinda woumambo hwose uhu.)",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.10",
            "verseOrgIds": [
              "JOS.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakauraya nomunondo munhu wose aivamo. Vakavaparadza zvachose, vakasasiya chipi nechipi chaifema, uye akapisa Hazori pacharo nomoto.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.11",
            "verseOrgIds": [
              "JOS.11.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joshua akakunda maguta oumambo ose aya namadzimambo awo ndokuvauraya nomunondo. Akavaparadza zvachose, sezvakanga zvarayirwa naMozisi muranda waJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.12",
            "verseOrgIds": [
              "JOS.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi vaIsraeri havana kupisa kana rimwe ramaguta akanga akavakwa pazvikomo zvavo, kusara kweHazori chete, rakapiswa naJoshua.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.13",
            "verseOrgIds": [
              "JOS.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "VaIsraeri vakatakura zvose zvavakapamba nezvipfuwo zvamaguta iwaya, asi vakaparadza zvachose vanhu vose, vakasasiya kana mumwe aifema.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.14",
            "verseOrgIds": [
              "JOS.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sezvakanga zvarayirwa Mozisi muranda wake naJehovha, saizvozvo Mozisi akarayira Joshua, uye Joshua akazviita; hapana chaakasiya chisina kuitwa pane zvose zvakanga zvarayirwa Mozisi naJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.15",
            "verseOrgIds": [
              "JOS.11.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo Joshua akatora nyika yose iyi nyika yamakomo, neNegevhi, dunhu rose reGosheni, majinga ezvikomo zvokumavirira, neArabha namakomo eIsraeri namajinga awo,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.16",
            "verseOrgIds": [
              "JOS.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "kubvira kuGomo reHaraki, rinokwidza rakananga kuSeiri, kuBhaari Gadhi muMupata weRebhanoni, zasi kweGomo reHemoni. Akabata madzimambo avo ose akavaparadza, akavauraya.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.17",
            "verseOrgIds": [
              "JOS.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joshua akarwa namadzimambo ose aya kwenguva refu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.18",
            "verseOrgIds": [
              "JOS.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuna guta kana rimwe rakaita sungano yorugare navaIsraeri kunze kwavaHivhi vaigara muGibheoni, vavakatora vose pakurwa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.19",
            "verseOrgIds": [
              "JOS.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti Jehovha ndiye akaomesa mwoyo yavo kuti varwe navaIsraeri, kuti vavaparadze zvachose, vavaparadze pasina kunzwira tsitsi, sezvakanga zvarayirwa Mozisi naJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.20",
            "verseOrgIds": [
              "JOS.11.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panguva iyoyo Joshua akaenda akandoparadza vaAnaki munyika yamakomo: kubva kuHebhuroni, nokuDhebhiri nokuAnabhi, nokubva munyika yose yamakomo yeJudha, uye nokubva munyika yose yamakomo yavaIsraeri. Joshua akavaparadza zvachose namaguta avo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.21",
            "verseOrgIds": [
              "JOS.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuna vaAnaki vakasara munyika yeIsraeri: kusara kwomuGaza, nomuGati nomuAshidhodhi makasara vamwe.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.22",
            "verseOrgIds": [
              "JOS.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo Joshua akatora nyika yose, sezvakanga zvarayirwa Mozisi naJehovha, uye akaipa kuvaIsraeri kuti ive nhaka yavo zvichienderana namarudzi avo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.23",
            "verseOrgIds": [
              "JOS.11.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JOS 11:23"
      },
      "items": [
        {
          "text": "Ipapo nyika yakazorora pakurwa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.23",
            "verseOrgIds": [
              "JOS.11.23"
            ]
          }
        }
      ]
    }
  ],
