  "verseCount": 26,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "JOS 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Chivi chaAkani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi vaIsraeri vakaita zvisina kutendeka pamusoro pezvinhu zvakatukwa; Akani mwanakomana waKami, mwanakomana waZimiri, mwanakomana waZera, worudzi rwaJudha, akatora zvimwe zvezvinhu zvakatukwa. Naizvozvo hasha dzaJehovha dzakamukira vaIsraeri.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.1",
            "verseOrgIds": [
              "JOS.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino Joshua akatuma vanhu kubva kuJeriko kuenda kuAi, iri pedyo neBheti Avheni kumabudazuva kweBheteri, akavaudza kuti, \"Endai munosora nzvimbo iyi.\" Naizvozvo varume vakaenda vakanosora Ai.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.2",
            "verseOrgIds": [
              "JOS.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pavakadzoka kuna Joshua, vakati, \"Hazvifaniri kuti vanhu vose vaende kundorwa neAi. Tumirai varume zviuru zviviri kana zvitatu kuti vaitore, mugorega kunetsa vanhu vose ava, nokuti ikoko kuna vanhu vashomanana chete.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.3",
            "verseOrgIds": [
              "JOS.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo kwakaenda varume zviuru zvitatu; asi vakamhanyiswa zvakaipisisa navarume veAi,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.4",
            "verseOrgIds": [
              "JOS.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "avo vakauraya vaIsraeri makumi matatu navatanhatu vavo. Vakavadzinganisa kubva pasuo reguta kusvikira kuShebharimu vakavaurayira pamawere, ipapo mwoyo yavanhu yakanyongodeka ikaita semvura.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.5",
            "verseOrgIds": [
              "JOS.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino Joshua akabvarura nguo dzake akawira pasi nechiso chake pamberi peareka yaJehovha akaramba aripo kusvikira madekwana. Vakuru vavaIsraeri vakaitawo saizvozvo, vakadira guruva pamisoro yavo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.6",
            "verseOrgIds": [
              "JOS.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino Joshua akati, \"Haiwa! Ishe Jehovha, makamboyambutsirei vanhu ava Jorodhani kuti mutiise mumaoko avaAmori kuti vatiparadze? Dai takangogutsikana hedu takagara mhiri kweJorodhani!",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.7",
            "verseOrgIds": [
              "JOS.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haiwa Ishe, ndingatiiko zvino vaIsraeri zvavakundwa navavengi vavo?",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.8",
            "verseOrgIds": [
              "JOS.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "VaKenani navamwe vanhu vari munyika muno vachazvinzwa vagotikomberedza nokubvisa zita redu pano pasi. Zvino muchagozoitei nezita renyu guru?\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.9",
            "verseOrgIds": [
              "JOS.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha akati kuna Joshua, \"Simuka! Wawireiko pasi nechiso chako?",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.10",
            "verseOrgIds": [
              "JOS.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "VaIsraeri vatadza; vadarika sungano yangu, yandakavarayira kuti vaichengete. Vatora zvimwe zvezvinhu zvakatukwa; vaba, vanyepa, vazvivhenganisa nezvinhu zvavo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.11",
            "verseOrgIds": [
              "JOS.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndokusaka vaIsraeri vasingagoni kumisidzana navavengi vavo; vanofuratira vachitiza nokuti vava vanhu vakatukwa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.12",
            "verseOrgIds": [
              "JOS.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Enda unonatsa vanhu. Uvataurire kuti, 'Zvinatsei muchigadzirira zuva ramangwana; nokuti zvanzi naJehovha, Mwari waIsraeri: Chinhu chakatukwa chiri pakati penyu, imi vaIsraeri. Hamungagoni kumisidzana navavengi venyu kusvikira machibvisa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.13",
            "verseOrgIds": [
              "JOS.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Zvino mangwana mangwanani, munofanira kuzviratidza rudzi norudzi. Rudzi ruchabatwa naJehovha runofanira kuuya mberi imba neimba; imba ichabatwa naJehovha inofanira kuuya mberi, mhuri nemhuri; mhuri ichabatwa naJehovha inofanira kuuya mberi munhu nomunhu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.14",
            "verseOrgIds": [
              "JOS.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyo achawanikwa ane zvinhu zvakatukwa achaparadzwa nomoto, nazvose zvaanazvo. Akanganisa sungano yaJehovha uye aita chinhu chinonyadzisa muIsraeri!' \"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.15",
            "verseOrgIds": [
              "JOS.7.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mangwana mangwanani Joshua akati vaIsraeri vauye rudzi norudzi; rudzi rwaJudha rukabatwa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.16",
            "verseOrgIds": [
              "JOS.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dzimba dzokwaJudha dzakauya mberi imba yavaZera ikabatwa. Akauyisa imba yavaZera nemhuri dzayo, Zimiri akabatwa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.17",
            "verseOrgIds": [
              "JOS.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joshua akauyisa mhuri yake munhu nomunhu, uye Akani mwanakomana waKami, mwanakomana waZimiri, mwanakomana waZera, worudzi rwaJudha, akabatwa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.18",
            "verseOrgIds": [
              "JOS.7.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akati kuna Akani, \"Mwanakomana wangu, ipa mbiri kuna Jehovha, Mwari waIsraeri, ureurure kwaari. Ndiudze kuti chii chawaita; usandivanzira.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.19",
            "verseOrgIds": [
              "JOS.7.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akani akapindura achiti, \"Ichokwadi! Ndakatadzira Jehovha, Mwari waIsraeri. Izvi ndizvo zvandakaita:",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.20",
            "verseOrgIds": [
              "JOS.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pandakaona pakati pezvakapambwa nguo yakanaka yokuBhabhironi, mashekeri mazana maviri",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.21",
            "verseOrgIds": [
              "JOS.7.21"
            ]
          }
        },
        {
          "text": "esirivha negoridhe rairema mashekeri makumi mashanu",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.21",
            "verseOrgIds": [
              "JOS.7.21"
            ]
          }
        },
        {
          "text": ", ndakazvichiva ndikazvitora. Zvakavigwa pasi mutende, sirivha iri pasi pazvo.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.21",
            "verseOrgIds": [
              "JOS.7.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo Joshua akatuma nhume, vakamhanyira kutende, vakanowana zviriko, zvakavigwa mutende rake, sirivha iri pasi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.22",
            "verseOrgIds": [
              "JOS.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakazvibvisa mutende, vakauya nazvo kuna Joshua nokuvaIsraeri vose, vakazviwadzira pamberi paJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.23",
            "verseOrgIds": [
              "JOS.7.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOS 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Joshua, pamwe chete navaIsraeri vose vakatora Akani mwanakomana waZera, nesirivha, nenguo, negoridhe, navanakomana navanasikana vake, mombe dzake, nembongoro dzake namakwai ake, netende rake nezvose zvaaiva nazvo, vakaenda nazvo kuMupata weAkori.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.24",
            "verseOrgIds": [
              "JOS.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOS 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joshua akati, \"Watipinzireiko mudambudziko iri? Jehovha achakupinza mudambudziko nhasi.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.25",
            "verseOrgIds": [
              "JOS.7.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JOS 7:25"
      },
      "items": [
        {
          "text": "Ipapo vaIsraeri vose vakamutema namatombo, uye shure kwokuvatema vose, vakavapisa nomoto.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.25",
            "verseOrgIds": [
              "JOS.7.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOS 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakaunganidza murwi wamatombo mukuru pamusoro paAkani, uchiripo nanhasi. Ipapo Jehovha akadzora kutsamwa kwake kukuru. Naizvozvo nzvimbo iyi yakanzi Mupata weAkori kubvira ipapo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.26",
            "verseOrgIds": [
              "JOS.7.26"
            ]
          }
        }
      ]
    }
  ],
