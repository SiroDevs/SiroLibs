  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "18",
        "style": "c",
        "sid": "JOS 18"
      },
      "items": [
        {
          "text": "18",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kuganhurwa kweNyika Yakasara",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ungano yose yavaIsraeri yakaungana paShiro vakadzikapo Tende Rokusangana. Nyika yakanga yava pasi pavo,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.1",
            "verseOrgIds": [
              "JOS.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi kwakanga kwasara marudzi manomwe avaIsraeri akanga asati agoverwa nhaka yawo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.2",
            "verseOrgIds": [
              "JOS.18.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Joshua akati kuvaIsraeri, \"Muchamirira kusvika rinhiko musati matora nyika yamakapiwa naJehovha Mwari wamadzibaba enyu?",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.3",
            "verseOrgIds": [
              "JOS.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvitsaurirei varume vatatu kurudzi rumwe norumwe. Ndichavatuma kuti vanosora nyika uye kuti vagonyora vachirondedzera zvayakaita maererano nenhaka imwe neimwe. Ipapo vachadzoka kwandiri.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.4",
            "verseOrgIds": [
              "JOS.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munofanira kuganhura kuti iite zvikamu zvinomwe. Judha anofanira kuramba ari munyika yezasi uye imba yaJosefa munyika yokumusoro.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.5",
            "verseOrgIds": [
              "JOS.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mushure mokunge manyora rondedzero yezvikamu zvinomwe zvenyika, muuye nazvo kwandiri ndigokukandirai mujenya pamberi paJehovha Mwari wenyu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.6",
            "verseOrgIds": [
              "JOS.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunyange zvakadaro hazvo, vaRevhi havawani mugove pakati penyu, nokuti uprista hwaJehovha ndihwo nhaka yavo. Uye Gadhi, Rubheni nehafu yorudzi rwaManase vakapiwa kare nhaka yavo kumabvazuva kweJorodhani. Mozisi muranda waJehovha ndiye akavapa nhaka iyoyo.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.7",
            "verseOrgIds": [
              "JOS.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Varume vakati vaenda kundotara muganhu wenyika, Joshua akavarayira achiti, \"Endai mundosora nyika mugonyora rondedzero yayo. Ipapo mugodzoka kwandiri, uye ndichakukandirai mujenya pano paShiro pamberi paJehovha.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.8",
            "verseOrgIds": [
              "JOS.18.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka varume vakaenda, vakafamba nenyika. Vakanyora rondedzero yayo mubhuku, guta neguta, muzvikamu zvinomwe, ndokudzokera kuna Joshua kumusasa paShiro.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.9",
            "verseOrgIds": [
              "JOS.18.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Joshua akavakandira mujenya muShiro pamberi paJehovha, ndokugovera vaIsraeri nyika ipapo maererano namarudzi avo.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mugove waBhenjamini",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rudzi rwaBhenjamini rwakapiwa mugove warwo, mhuri nemhuri. Nyika yavakagoverwa yakanga iri pakati pamarudzi aJudha neaJosefa:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumusoro muganhu wavo waitangira paJorodhani, uchipfuura nokumusoro kwamateru eJeriko ndokunanga kumavirira okunyika yamakomo, uchindobuda kurenje reBheti Avheni.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.12",
            "verseOrgIds": [
              "JOS.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubva ikoko wakayambukira kumateru ezasi kweRuzi (iro Bheteri) uchizoburukira kuAtaroti Adhari pagomo riri zasi kweBheti Horoni yezasi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.13",
            "verseOrgIds": [
              "JOS.18.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubva pachikomo chakatarisana neBheti Horoni nechokumusoro, muganhu wakadzokera zasi kudivi rokumavirira ndokundobudira paKiriati Bhaari (iro Kiriati Jearimi), guta ravanhu veJudha. Iri ndiro raiva divi rokumavirira.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.14",
            "verseOrgIds": [
              "JOS.18.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rutivi rwezasi rwakatangira panogumira Kiriati Jearimi kumavirira, uye muganhu wakandobudira patsime remvura zhinji reNefitoa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.15",
            "verseOrgIds": [
              "JOS.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muganhu wakaburukira mujinga megomo rakatarisana nomupata weBheni Hinomi kumusoro kwomupata weRefaimi. Wakaramba uchidzika nokuMupata weHinomi mujinga memateru echezasi kweguta ravaJebhusi kusvikira kuEni Rogeri.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.16",
            "verseOrgIds": [
              "JOS.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo wakazokombamira kumusoro uchienda kuEni Shemeshi, uchipfuurira mberi kuGeriroti yakatarisana noMupata weAdhumimi, ndokuburikira kuDombo raBhohani mwanakomana waRubheni.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.17",
            "verseOrgIds": [
              "JOS.18.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakaramba uchienda nokurutivi rwokumusoro kwamateru eBheti Arabha.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.18",
            "verseOrgIds": [
              "JOS.18.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo wakananga nechokumusoro kwamateru eBheti Hogira ndokubudira kumusoro kweGungwa roMunyu, pamuromo weJorodhani nechezasi. Uyu ndiwo wakanga uri muganhu wezasi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.19",
            "verseOrgIds": [
              "JOS.18.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jorodhani ndirwo rwakanga rwuri muganhu kumabvazuva.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.20",
            "verseOrgIds": [
              "JOS.18.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4",
        "vid": "JOS 18:20"
      },
      "items": [
        {
          "text": "Iyi ndiyo yakanga iri miganhu yairatidza nhaka yemhuri dzaBhenjamini kumativi ose.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rudzi rwaBhenjamini, mhuri nemhuri, rwakanga runa maguta anotevera anoti:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "JOS 18:21"
      },
      "items": [
        {
          "text": "Jeriko, Bheti Hogira, Emeki Kezizi,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.21",
            "verseOrgIds": [
              "JOS.18.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bheti Arabha, Zamaraini, Bheteri,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.22",
            "verseOrgIds": [
              "JOS.18.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avhimi, Para, Ofira,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.23",
            "verseOrgIds": [
              "JOS.18.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOS 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kefari Amoni, Ofini, neGebha, maguta gumi namaviri pamwe chete nemisha yawo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.24",
            "verseOrgIds": [
              "JOS.18.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOS 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghibheoni, Rama, Bheeroti,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.25",
            "verseOrgIds": [
              "JOS.18.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOS 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mizipa, Kefira, Moza,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.26",
            "verseOrgIds": [
              "JOS.18.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOS 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rekemu, Iripeeri, Tarara,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.27",
            "verseOrgIds": [
              "JOS.18.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOS 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zera, Haerefi guta ravaJebhusi, (iro Jerusarema) Gibhea neKiriati, maguta gumi namana pamwe chete nemisha yawo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.28",
            "verseOrgIds": [
              "JOS.18.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4",
        "vid": "JOS 18:28"
      },
      "items": [
        {
          "text": "Iyi ndiyo yakanga iri nhaka yemhuri dzaBhenjamini.",
          "type": "text"
        }
      ]
    }
  ],
