  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "JOS 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Rahabhi naVasori",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino Joshua mwanakomana waNuni akatuma vasori vaviri muchivande kubva kuShitimu. Akati, \"Endai munotarisa nyika, kunyanya Jeriko.\" Naizvozvo vakaenda vakandopinda mumba mechifeve chainzi Rahabhi vakagaramo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.1",
            "verseOrgIds": [
              "JOS.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino mambo weJeriko akaudzwa kuti, \"Tarirai! Kune vamwe vaIsraeri vauya muno manheru anhasi kuzosora nyika.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.2",
            "verseOrgIds": [
              "JOS.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo mambo weJeriko akatumira shoko kuna Rahabhi achiti, \"Budisa varume vauya kwauri vakapinda mumba mako, nokuti vauya kuzosora nyika yose.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.3",
            "verseOrgIds": [
              "JOS.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi mukadzi uyu akanga atora varume vaviri vaya akavavanza. Iye ndokuti, \"Ichokwadi, varume ava vakauya kwandiri, asi handina kuziva kuti vakanga vabvepi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.4",
            "verseOrgIds": [
              "JOS.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino kwati zvarara yava nguva yokupfiga suo reguta, varume ava vakaenda. Handizivi kuti vakaenda vakanangepi. Vateverei nokukurumidza, pamwe mungangovabata.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.5",
            "verseOrgIds": [
              "JOS.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Asi iye akanga avatora ndokuvaisa pamusoro pemba ndokuvavanza mumashanga aakanga aunganidza pamusoro pemba.)",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.6",
            "verseOrgIds": [
              "JOS.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo varume vakasimuka votevera vasori nenzira yainanga kumazambuko eJorodhani, uye vaitevera vachangobuda, suo rakabva rapfigwa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.7",
            "verseOrgIds": [
              "JOS.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vasori vasati varara, iye akakwira padenga remba,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.8",
            "verseOrgIds": [
              "JOS.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndokuti kwavari, \"Ndinozviziva kuti Jehovha akupai nyika ino, uye kuti kutyiwa kwenyu kukuru kuri pamusoro pedu, zvokuti vose vanogara munyika muno vari kubvunda nokutya nokuda kwenyu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.9",
            "verseOrgIds": [
              "JOS.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Takanzwa maomeserwo akaitwa mvura yeGungwa Dzvuku naJehovha nokuda kwenyu pamakabuda muIjipiti, uye zvamakaita kuna Sihoni naOgi, madzimambo maviri avaAmori kumabvazuva kweJorodhani, avo vamakaparadza zvachose.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.10",
            "verseOrgIds": [
              "JOS.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Patakazvinzwa mwoyo yedu yakarukutika, uye hapana akasara nokutsunga maari nokuda kwenyu, nokuti Jehovha Mwari wenyu ndiMwari kumusoro kudenga napasi panyika.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.11",
            "verseOrgIds": [
              "JOS.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino ndapota, pikai kwandiri naJehovha kuti muchaitira mhuri yangu tsitsi, nokuti ini ndakuitiraiwo tsitsi. Ndipei chiratidzo chechokwadi chakasimba",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.12",
            "verseOrgIds": [
              "JOS.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "chokuti muchararamisa baba vangu namai vangu, hanzvadzi dzangu namadzikoma angu, nemhuri dzavo dzose, uye kuti muchatiponesa kubva parufu.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.13",
            "verseOrgIds": [
              "JOS.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo varume vaya vakamuvimbisa vachiti, \"Isu ngatife pachinzvimbo chenyu. Kana ukasareva zvatiri kuita tichakubata zvakanaka nokutendeka kana Jehovha atipa nyika ino.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.14",
            "verseOrgIds": [
              "JOS.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka akavadzikisa pasi netambo napawindo, nokuti imba yaaigara yaiva mumasvingo eguta.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.15",
            "verseOrgIds": [
              "JOS.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino akati kwavari, \"Endai kumakomo kuitira kuti vateveri varege kukuwanai. Muvande ikoko kwamazuva matatu kusvikira vadzoka, mozoenda henyu nenzira yenyu.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.16",
            "verseOrgIds": [
              "JOS.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Varume vaya ndokuti kwaari, \"Mhiko yawatipikisa iyi haizotisungi",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.17",
            "verseOrgIds": [
              "JOS.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "kunze kwokuti, patinopinda munyika, uchange wasungirira tambo tsvuku iyi pawindo rawatidzikisa naro, uye kunze kwokunge wapinza baba vako namai vako, hanzvadzi dzako nemhuri yako yose mumba mako.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.18",
            "verseOrgIds": [
              "JOS.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani naani anobuda mumba mako achienda panze, ropa rake richava pamusoro wake, isu hatizova nemhosva. Asi wose anenge ari mumba pamwe chete newe, ropa rake richava pamisoro yedu kana pakangowana anomubata chete.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.19",
            "verseOrgIds": [
              "JOS.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi ukangoreva zvatiri kuita, tichasunungurwa pamhiko yawatipikisa.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.20",
            "verseOrgIds": [
              "JOS.2.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye akapindura akati, \"Ngazviitwe sokutaura kwenyu.\" Naizvozvo akavati vaende ivo ndokuenda. Ipapo akabva asungirira tambo tsvuku pawindo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.21",
            "verseOrgIds": [
              "JOS.2.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pavakabva, vakaenda mumakomo vakagaramo kwamazuva matatu, kusvikira vateveri vatsvaka nzira yose vakavashayiwa vakadzoka.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.22",
            "verseOrgIds": [
              "JOS.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo varume vaviri vaya vakatanga kudzokera. Vakadzika kubva muzvikomo ndokuyambuka rwizi vakasvika kuna Joshua mwanakomana waNuni vakamuudza zvose zvakanga zvaitika kwavari.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.23",
            "verseOrgIds": [
              "JOS.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOS 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakati kuna Joshua, \"Zvirokwazvo Jehovha aisa nyika yose mumaoko edu; vanhu vose vari kugwagwadza nokutitya.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.24",
            "verseOrgIds": [
              "JOS.2.24"
            ]
          }
        }
      ]
    }
  ],
  "next": {
