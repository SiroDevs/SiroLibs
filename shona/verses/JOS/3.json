  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "JOS 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "VaIsraeri vanoyambuka Jorodhani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mangwanani-ngwanani Joshua navaIsraeri vose vakasimuka kubva paShitimu vakaenda kuJorodhani, pavakavaka misasa vasati vayambukira mhiri.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.1",
            "verseOrgIds": [
              "JOS.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shure kwamazuva matatu vatungamiri vavanhu vakapinda mumisasa,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.2",
            "verseOrgIds": [
              "JOS.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "vachirayira vanhu vachiti, \"Pamunoona areka yesungano yaJehovha Mwari wenyu, navaprista, vaRevhi, voitakura, munofanira kubva panzvimbo dzenyu moitevera.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.3",
            "verseOrgIds": [
              "JOS.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo muchaziva nzira yamunofanira kuenda nayo, nokuti hamusati mambofamba nenzira iyi. Asi munofanira kusiya nzvimbo inosvika makubhiti zviuru zviviri",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.4",
            "verseOrgIds": [
              "JOS.3.4"
            ]
          }
        },
        {
          "text": "pakati penyu neareka. Regai kuswedera pedyo nayo.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.4",
            "verseOrgIds": [
              "JOS.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino Joshua akati kuvanhu, \"Zvinatsei, nokuti mangwana Jehovha achaita zvinhu zvinoshamisa pakati penyu.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.5",
            "verseOrgIds": [
              "JOS.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joshua akati kuvaprista, \"Simudzai areka yesungano mutungamirire vanhu.\" Naizvozvo vakaisimudza vakatungamirira vanhu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.6",
            "verseOrgIds": [
              "JOS.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino Jehovha akati kuna Joshua, \"Nhasi ndichatanga kukusimudzira pamberi pavaIsraeri vose, kuitira kuti vazive kuti ndinewe sezvandaiva naMozisi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.7",
            "verseOrgIds": [
              "JOS.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taurira vaprista vanotakura areka yesungano uti: 'Kana masvika panotangira mvura yeJorodhani, munofanira kupinda momira muJorodhani.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.8",
            "verseOrgIds": [
              "JOS.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joshua akati kuvaIsraeri, \"Uyai pano muteerere mashoko aJehovha Mwari wenyu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.9",
            "verseOrgIds": [
              "JOS.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichi ndicho chinhu chamuchaziva nacho kuti Mwari wenyu mupenyu ari pakati penyu uye kuti zvirokwazvo achadzinga vaKenani mberi kwenyu, navaHiti, navaPerizi, navaGirigashi, navaAmoni navaJebhusi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.10",
            "verseOrgIds": [
              "JOS.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tarirai, areka yesungano yaShe wenyika yose ichakutungamirirai pakuyambuka Jorodhani.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.11",
            "verseOrgIds": [
              "JOS.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo, sarudzai varume gumi navaviri kubva kumarudzi avaIsraeri, mumwe chete kubva kurudzi rumwe norumwe.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.12",
            "verseOrgIds": [
              "JOS.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye vaprista vanotakura areka yaJehovha, Ishe wenyika yose, pavanongotsika netsoka dzavo muJorodhani, mvura yarwo inoerera ichibva kumusoro ichamira yoita murwi.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.13",
            "verseOrgIds": [
              "JOS.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo vanhu pavakasimuka kubva pamisasa kuti vayambuke Jorodhani, vaprista vakanga vakatakura areka yesungano vakavatungamirira.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.14",
            "verseOrgIds": [
              "JOS.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino Jorodhani runogara ruzere nguva yose yokukohwa. Asi vaprista vakanga vakatakura areka pavakangosvika paJorodhani tsoka dzavo dzichitsika kumucheto kwemvura,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.15",
            "verseOrgIds": [
              "JOS.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "mvura yaibva kumusoro yakabva yamira kuerera. Yakaungana ikaita murwi iri kure chaizvo, paguta rinonzi Adhama pedyo neZaretani, mvura yaiererawo ichidzika kuGungwa reArabha (Gungwa roMunyu) yakagurwa zvachose. Naizvozvo vanhu vakayambuka mhiri kwakatarisana neJeriko.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.16",
            "verseOrgIds": [
              "JOS.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vaprista vakanga vakatakura areka yesungano yaJehovha vakaramba vamire pavhu rakaoma pakati peJorodhani, vaIsraeri vose pavaipfuura, kusvikira rudzi rwose rwapedza kuyambuka napavhu rakaoma.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.17",
            "verseOrgIds": [
              "JOS.3.17"
            ]
          }
        }
      ]
    }
  ],
