        {
          "text": "\"Uti kuvaRevhi: 'Pamunouyisa chikamu chakanakisisa, chichagamuchirwa kubva kwamuri sechakabva paburiro kana pachisviniro chewaini,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.30",
