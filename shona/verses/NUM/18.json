              "type": "text"
            }
          ]
        },
        {
          "text": "iwe nemhuri yako mungadya henyu zvakasara zvose chero pamunenge muri, nokuti ndiwo mubayiro wenyu webasa renyu rapaTende Rokusangana.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.31",
