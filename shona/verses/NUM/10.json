      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 10:35"
      },
      "items": [
        {
          "text": "Vavengi venyu ngavaparadzirwe,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.35",
            "verseOrgIds": [
              "NUM.10.35"
            ]
          }
        }
      ]
