      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NUM 10:35"
      },
      "items": [
        {
          "text": "\"Haiwa Jehovha, simukai!",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.35",
            "verseOrgIds": [
              "NUM.10.35"
            ]
          }
