          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka vakasimuka kubva pagomo raJehovha vakafamba kwamazuva matatu. Areka yaJehovha yesungano yakavatungamirira pamazuva matatu iwayo kuti vatsvakirwe nzvimbo yokuzororera.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.33",
            "verseOrgIds": [
              "NUM.10.33"
            ]
          }
        },
        {
          "name": "verse",
