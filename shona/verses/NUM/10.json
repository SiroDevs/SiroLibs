              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paingosimuka areka, Mozisi aiti,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.35",
            "verseOrgIds": [
              "NUM.10.35"
            ]
          }
        }
