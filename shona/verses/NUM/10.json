            "style": "v",
            "sid": "NUM 10:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gore raJehovha rakanga riri pamusoro pavo masikati pavakasimuka kubva pamusasa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.34",
            "verseOrgIds": [
              "NUM.10.34"
            ]
          }
        }
      ]
