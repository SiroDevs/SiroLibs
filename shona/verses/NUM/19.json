  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "19",
        "style": "c",
        "sid": "NUM 19"
      },
      "items": [
        {
          "text": "19",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mvura yoKunatsa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha akati kuna Mozisi naAroni,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.1",
            "verseOrgIds": [
              "NUM.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Izvi ndizvo zvinodikanwa pamurayiro wakarayirwa naJehovha. Udza vaIsraeri kuti vakuvigire tsiru dzvuku risina kuremara, kana charingapomerwa uye risina kumbosungwa pajoko.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.2",
            "verseOrgIds": [
              "NUM.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uripe kuna Ereazari muprista; rinofanira kubudiswa kunze kwomusasa rigourayiwa pamberi pake.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.3",
            "verseOrgIds": [
              "NUM.19.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Ereazari muprista anofanira kutora rimwe reropa raro nomunwe agorisasa kanomwe akananga mberi kweTende Rokusangana.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.4",
            "verseOrgIds": [
              "NUM.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akatarisa, tsiru rinofanira kupiswa, dehwe raro, nyama yaro namazvizvi aro.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.5",
            "verseOrgIds": [
              "NUM.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muprista anofanira kutora huni dzomusidhari, hisopi newuru tsvuku agozvikanda pamusoro petsiru riri kutsva.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.6",
            "verseOrgIds": [
              "NUM.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shure kwaizvozvo, muprista anofanira kusuka nguo dzake uye azvishambidze nemvura. Ipapo angachipinda hake mumusasa, asi achange asina kunatswa kusvikira madekwana.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.7",
            "verseOrgIds": [
              "NUM.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munhu acharipisa naiyewo anofanira kusuka nguo dzake uye agoshamba nemvura uye iyewo achava asina kuchena kusvikira madekwana.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.8",
            "verseOrgIds": [
              "NUM.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Munhu akachena achaunganidza madota etsiru agoaisa panzvimbo yakanaka iri kunze kwomusasa. Achachengetwa neungano yavaIsraeri kuti agoshandiswa pamvura yokunatsa; ndeyokunatswa kubva pachivi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.9",
            "verseOrgIds": [
              "NUM.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munhu anounganidza madota etsiru anofanirawo kusuka nguo dzake, naiyewo achava asina kuchena kusvikira madekwana. Mutemo uyu uchagara uripo pakati pavaIsraeri navatorwa vagere pakati pavo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.10",
            "verseOrgIds": [
              "NUM.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ani naani anobata chitunha chaani zvake achava asina kuchena kwamazuva manomwe.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.11",
            "verseOrgIds": [
              "NUM.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anofanira kuzvinatsa nemvura nezuva retatu uye nezuva rechinomwe; ipapo achava akachena.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.12",
            "verseOrgIds": [
              "NUM.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani naani anobata chitunha chaani zvake akasazvinatsa anosvibisa tabhenakeri yaJehovha. Munhu uyu anofanira kubviswa pakati pavaIsraeri. Nokuti mvura yokunatsa haina kumbosaswa pamusoro pake, haana kuchena; kusachena kwake kucharamba kuri paari.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.13",
            "verseOrgIds": [
              "NUM.19.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Uyu ndiwo murayiro unobata pamunhu anofira mutende: Ani naani anopinda mutende uye ani zvake ari mariri achava asina kuchena kwamazuva manomwe,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.14",
            "verseOrgIds": [
              "NUM.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye midziyo yose yakazarurwa, isina kukwidibirwa, ichava isina kuchena.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.15",
            "verseOrgIds": [
              "NUM.19.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ani naani ari musango anobata munhu akaurayiwa nomunondo kana mumwe munhu akangofawo zvake, kana munhu anobata bvupa romunhu kana guva, achava asina kuchena kwamazuva manomwe.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.16",
            "verseOrgIds": [
              "NUM.19.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kana munhu asina kuchena, utore dota rinobva pachipiriso chokunatsa chakapiswa ugoriisa muchirongo ugoridira mvura yakachena.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.17",
            "verseOrgIds": [
              "NUM.19.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo munhu akachena anofanira kutora hisopi, ainyike mumvura agosasa tende nemidziyo yose uye navanhu vanga varimo. Anofanira kusasawo ani zvake akabata bvupa romunhu kana guva kana mumwe munhu akaurayiwa kana munhu akangofawo zvake.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.18",
            "verseOrgIds": [
              "NUM.19.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munhu akachena anofanira kusasa munhu asina kuchena nezuva rechitatu uye nerechinomwe, uye pazuva rechinomwe anofanira kumunatsa. Munhu ari kunatswa anofanira kusuka nguo dzake agozvishambidza nemvura, uye manheru iwayo anofanira kuva akachena.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.19",
            "verseOrgIds": [
              "NUM.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi kana munhu asina kuchena akasazvinatsa, anofanira kubviswa paungano, nokuti iye asvibisa nzvimbo tsvene yaJehovha. Mvura yokunatsa haina kumbosaswa paari, nokudaro haana kuchena.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.20",
            "verseOrgIds": [
              "NUM.19.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyu mutemo uchagara uripo kwavari.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.21",
            "verseOrgIds": [
              "NUM.19.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "NUM 19:21"
      },
      "items": [
        {
          "text": "\"Munhu anosasa mvura yokunatsa anofanirawo kusuka nguo dzake, uye ani naani anobata mvura yokunatsa achava asina kunaka kusvikira madekwana.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.21",
            "verseOrgIds": [
              "NUM.19.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chinhu chose chinobatwa nomunhu asina kuchena chinova chisina kuchena, uye ani naani anochibata anova asina kuchena kusvikira madekwana.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.19.22",
            "verseOrgIds": [
              "NUM.19.22"
            ]
          }
        }
      ]
    }
  ],
