  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "28",
        "style": "c",
        "sid": "NUM 28"
      },
      "items": [
        {
          "text": "28",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Zvipiriso zvamazuva ose",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 28:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha akati kuna Mozisi,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.1",
            "verseOrgIds": [
              "NUM.28.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 28:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Upe murayiro uyu kuvaIsraeri, uti kwavari, 'Onai kuti maisa pamberi pangu panguva yakatarwa, zvokudya zvangu zvezvipiriso zvinoitwa nomoto, sezvinonhuhwira zvinondifadza.'",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.2",
            "verseOrgIds": [
              "NUM.28.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 28:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uti kwavari: 'Ichi ndicho chipiriso chakaitwa nomoto chamunofanira kupa kuna Jehovha: makwayana maviri egore rimwe chete asina kuremara, sechipiriso chinopiswa chamazuva ose, zuva rimwe nerimwe.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.3",
            "verseOrgIds": [
              "NUM.28.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ugadzire gwayana rimwe chete mangwanani uye rimwe racho panguva yamadekwana,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.4",
            "verseOrgIds": [
              "NUM.28.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 28:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "pamwe chete nechipiriso chezviyo, chegumi cheefa",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.5",
            "verseOrgIds": [
              "NUM.28.5"
            ]
          }
        },
        {
          "text": "youpfu hwakatsetseka hwakavhenganiswa nechikamu chimwe chete muzvina chehini",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.5",
            "verseOrgIds": [
              "NUM.28.5"
            ]
          }
        },
        {
          "text": "yamafuta omuorivhi akasvinwa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.5",
            "verseOrgIds": [
              "NUM.28.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 28:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichi ndicho chipiriso chinopiswa chamazuva ose chakatarwa paGomo reSinai kuti chive munhuwi unonhuhwira zvinofadza, chipiriso chinoitirwa Jehovha nomoto.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.6",
            "verseOrgIds": [
              "NUM.28.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panobayirwa gwayana rimwe nerimwe, chipiriso chokunwa chinopiwa panguva imwe cheteyo chinofanira kuva chikamu chimwe chete muzvina chehini, chezvinonhuhwira zvakaviriswa. Udurure chipiriso chinonwiwa kuna Jehovha panzvimbo tsvene.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.7",
            "verseOrgIds": [
              "NUM.28.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ugadzire gwayana rechipiri panguva dzamadekwana, pamwe chete nechipiriso chezviyo nechipiriso chinonwiwa, zvakafanana nezvamangwanani. Ichi ndicho chipiriso chinoitwa nomoto, chinonhuhwira zvinofadza kuna Jehovha.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.8",
            "verseOrgIds": [
              "NUM.28.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Zvipiriso zveSabata",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 28:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Nomusi weSabata, muite chipiriso chamakwayana maviri egore rimwe chete asina kuremara, pamwe chete nechipiriso chacho chokunwa, uye nechipiriso chezviyo chezvegumi zviviri zveefa",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.9",
            "verseOrgIds": [
              "NUM.28.9"
            ]
          }
        },
        {
          "text": "youpfu hwakatsetseka, hwakavhenganiswa namafuta.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.9",
            "verseOrgIds": [
              "NUM.28.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichi ndicho chipiriso chinopiswa cheSabata rimwe nerimwe, pamusoro pechipiriso chinopiswa chamazuva ose uye nechipiriso chacho chinonwiwa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.10",
            "verseOrgIds": [
              "NUM.28.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Zvipiriso zvomwedzi nomwedzi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 28:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Nomusi wokutanga womwedzi woga woga, mupe kuna Jehovha chipiriso chehando duku mbiri, gondobwe rimwe chete namakwayana makono manomwe egore rimwe chete, ose asina kuremara.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.11",
            "verseOrgIds": [
              "NUM.28.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 28:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamwe chete nehando imwe neimwe, panofanira kuva nechipiriso chezviyo chezvegumi zviviri zveefa",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.12",
            "verseOrgIds": [
              "NUM.28.12"
            ]
          }
        },
        {
          "text": "yeupfu hwakatsetseka, hwakavhenganiswa namafuta;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.12",
            "verseOrgIds": [
              "NUM.28.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 28:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye negwayana rimwe nerimwe, chipiriso chezviyo chechegumi cheefa yeupfu hwakatsetseka, hwakavhenganiswa namafuta. Izvi ndizvo zvinoitwa pachipiriso chinopiswa, chinonhuhwira zvinofadza, chipiriso chinoitirwa Jehovha nomoto.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.13",
            "verseOrgIds": [
              "NUM.28.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 28:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamwe chete nehando imwe neimwe, panofanira kuva nechipiriso chokunwa chehafu yehini yewaini; pamwe chete negondobwe, chikamu chimwe chete kubva muzvitatu chehini",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.14",
            "verseOrgIds": [
              "NUM.28.14"
            ]
          }
        },
        {
          "text": "; uye pamwe chete negwayana rimwe nerimwe, chikamu chimwe chete muzvina chehini",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.14",
            "verseOrgIds": [
              "NUM.28.14"
            ]
          }
        },
        {
          "text": ". Ichi ndicho chipiriso chinopiswa chomwedzi mumwe nomumwe chinofanira kupiwa pakugara kwomwedzi mumwe nomumwe pagore.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.14",
            "verseOrgIds": [
              "NUM.28.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 28:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamusoro pechipiriso chinopiswa chamazuva ose nechipiriso chacho chokunwa, nhongo imwe chete inofanira kupiwa sechipiriso chechivi kuna Jehovha.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.15",
            "verseOrgIds": [
              "NUM.28.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Pasika",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 28:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Pazuva regumi namana romwedzi wokutanga munofanira kuita Pasika yaJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.16",
            "verseOrgIds": [
              "NUM.28.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 28:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pazuva regumi namana romwedzi uyu, munofanira kuita mutambo; kwamazuva manomwe munofanira kudya chingwa chisina mbiriso.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.17",
            "verseOrgIds": [
              "NUM.28.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 28:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pazuva rokutanga munofanira kuita ungano tsvene uye murege kuita mabasa amazuva ose.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.18",
            "verseOrgIds": [
              "NUM.28.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 28:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mupe kuna Jehovha chipiriso chakaitwa nomoto, chipiriso chinopiswa chehando duku mbiri, gondobwe rimwe chete uye makwayana makono manomwe ane gore rimwe chete, ose asina kuremara.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.19",
            "verseOrgIds": [
              "NUM.28.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 28:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamwe chete nehando imwe neimwe mugadzire chipiriso chezviyo, chezvikamu zvitatu mugumi zveefa yeupfu hwakatsetseka, hwakavhenganiswa namafuta; pamwe chete negondobwe, zvikamu zviviri mugumi;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.20",
            "verseOrgIds": [
              "NUM.28.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 28:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye pamwe chete nerimwe nerimwe ramakwayana manomwe, chikamu chimwe chete mugumi;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.21",
            "verseOrgIds": [
              "NUM.28.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 28:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "uisewo nhongo imwe chete yembudzi sechipiriso chechivi kuti iwe uzviyananisire.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.22",
            "verseOrgIds": [
              "NUM.28.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 28:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mugadzire izvi pamwe chete nezvipiriso zvinopiswa zvamangwanani zvamazuva ose.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.23",
            "verseOrgIds": [
              "NUM.28.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 28:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nenzira iyi mugadzire zvokudya zvezvipiriso zvinoitwa nomoto mazuva ose kwamazuva manomwe sezvinonhuhwira zvinofadza kuna Jehovha; zvinofanira kugadzirwa pamwe chete nezvipiriso zvinopiswa nechipiriso chacho chinonwiwa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.24",
            "verseOrgIds": [
              "NUM.28.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 28:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pazuva rechinomwe muite ungano tsvene uye murege kuita basa ramazuva ose.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.25",
            "verseOrgIds": [
              "NUM.28.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mutambo waMavhiki",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 28:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Pazuva rezvibereko zvokutanga, pamunopa zvipiriso zvenyu kuna Jehovha, zvezvitsva zvezviyo panguva yoMutambo weMavhiki, muite ungano tsvene uye murege kuita basa ramazuva ose.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.26",
            "verseOrgIds": [
              "NUM.28.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 28:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mupe chipiriso chinopiswa chehando duku mbiri, gondobwe rimwe chete uye makwayana manomwe makono egore rimwe chete, chive chipiriso chinofadza kuna Jehovha.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.27",
            "verseOrgIds": [
              "NUM.28.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 28:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamwe chete nehando imwe neimwe, panofanira kuva nechipiriso chezviyo chezvikamu zvitatu mugumi zveefa yeupfu hwakatsetseka hwakavhenganiswa namafuta; pamwe chete negondobwe, zvikamu zviviri mugumi;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.28",
            "verseOrgIds": [
              "NUM.28.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 28:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
