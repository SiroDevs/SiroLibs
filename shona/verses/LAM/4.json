      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 4:1"
      },
      "items": [
        {
          "text": "goridhe rakaisvonaka harichabwinyi sei!",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.1",
            "verseOrgIds": [
              "LAM.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "LAM 4:1"
      },
      "items": [
        {
          "text": "Matombo matsvene aparadzirwa",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.1",
            "verseOrgIds": [
              "LAM.4.1"
            ]
          }
        }
      ]
    },
