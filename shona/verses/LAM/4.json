      "attrs": {
        "style": "q2",
        "vid": "LAM 4:2"
      },
      "items": [
        {
          "text": "kare vaimbokodzera chiero chavo chegoridhe,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.2",
            "verseOrgIds": [
              "LAM.4.2"
            ]
