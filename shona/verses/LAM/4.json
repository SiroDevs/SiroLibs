      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "LAM 4:2"
      },
      "items": [
        {
          "text": "zvino voonekwa sehari dzevhu,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.2",
            "verseOrgIds": [
              "LAM.4.2"
            ]
