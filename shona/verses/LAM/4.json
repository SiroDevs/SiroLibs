      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LAM 4:1"
      },
      "items": [
        {
          "text": "kumusoro kwenzira imwe neimwe.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.4.1",
            "verseOrgIds": [
              "LAM.4.1"
            ]
          }
        }
      ]
    },
