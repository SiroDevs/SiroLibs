  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "HOS 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HOS 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Uti kuvanunʼuna vako, 'Vanhu vangu,' nokuhanzvadzi dzako 'vadikanwa vangu.' \"",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.1",
            "verseOrgIds": [
              "HOS.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Israeri inorangwa uye inodzorwazve",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HOS 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Tsiurai mai venyu, vatsiurei,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.2",
            "verseOrgIds": [
              "HOS.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:2"
      },
      "items": [
        {
          "text": "nokuti havasi mukadzi wangu,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.2",
            "verseOrgIds": [
              "HOS.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:2"
      },
      "items": [
        {
          "text": "uye handisi murume wavo.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.2",
            "verseOrgIds": [
              "HOS.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 2:2"
      },
      "items": [
        {
          "text": "Ngavabvise kuonekwa kwoufeve pachiso chavo",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.2",
            "verseOrgIds": [
              "HOS.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:2"
      },
      "items": [
        {
          "text": "nokusatendeka pakati pamazamu avo.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.2",
            "verseOrgIds": [
              "HOS.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HOS 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana zvikasadaro, ndichavabvisa nguo dzose",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.3",
            "verseOrgIds": [
              "HOS.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:3"
      },
      "items": [
        {
          "text": "vagosara vakashama sezvavakanga vakaita musi wavakaberekwa.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.3",
            "verseOrgIds": [
              "HOS.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 2:3"
      },
      "items": [
        {
          "text": "Ndichavaita segwenga",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.3",
            "verseOrgIds": [
              "HOS.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:3"
      },
      "items": [
        {
          "text": "ndigovashandura vave nyika yakaoma",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.3",
            "verseOrgIds": [
              "HOS.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:3"
      },
      "items": [
        {
          "text": "uye ndichavauraya nenyota.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.3",
            "verseOrgIds": [
              "HOS.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HOS 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Handizoratidzi vana vavo rudo,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.4",
            "verseOrgIds": [
              "HOS.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:4"
      },
      "items": [
        {
          "text": "nokuti vana voufeve.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.4",
            "verseOrgIds": [
              "HOS.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HOS 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mai vavo vakanga vasina kutendeka",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.5",
            "verseOrgIds": [
              "HOS.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:5"
      },
      "items": [
        {
          "text": "uye vakavaberekera mune zvinonyadzisa.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.5",
            "verseOrgIds": [
              "HOS.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 2:5"
      },
      "items": [
        {
          "text": "Vakati, 'Ndichateverazve vadiwa vangu,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.5",
            "verseOrgIds": [
              "HOS.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:5"
      },
      "items": [
        {
          "text": "vanondipa zvokudya zvangu nemvura yangu,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.5",
            "verseOrgIds": [
              "HOS.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:5"
      },
      "items": [
        {
          "text": "makushe angu nomucheka wangu, mafuta angu nezvokunwa zvangu.'",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.5",
            "verseOrgIds": [
              "HOS.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HOS 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo ndichasosera nzira yavo namasanzu eminzwa;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.6",
            "verseOrgIds": [
              "HOS.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:6"
      },
      "items": [
        {
          "text": "ndichavapfigira mukati morusvingo zvokuti havangawani nzira yavo.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.6",
            "verseOrgIds": [
              "HOS.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HOS 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vachadzinganisa vadiwa vavo asi havangavabati;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.7",
            "verseOrgIds": [
              "HOS.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:7"
      },
      "items": [
        {
          "text": "vachavatsvaka, asi havangavawani.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.7",
            "verseOrgIds": [
              "HOS.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 2:7"
      },
      "items": [
        {
          "text": "Ipapo vachati, 'Ndichadzokera kumurume wangu sapakutanga",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.7",
            "verseOrgIds": [
              "HOS.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:7"
      },
      "items": [
        {
          "text": "nokuti ipapo ndaiva nani kupfuura pari zvino.'",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.7",
            "verseOrgIds": [
              "HOS.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HOS 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Havana kuzvibvuma kuti ndini",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.8",
            "verseOrgIds": [
              "HOS.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:8"
      },
      "items": [
        {
          "text": "ndaivapa zviyo, newaini itsva namafuta,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.8",
            "verseOrgIds": [
              "HOS.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 2:8"
      },
      "items": [
        {
          "text": "ndini ndakavapa sirivha negoridhe rakawanda",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.8",
            "verseOrgIds": [
              "HOS.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:8"
      },
      "items": [
        {
          "text": "izvo zvavakashandira Bhaari nazvo.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.8",
            "verseOrgIds": [
              "HOS.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HOS 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Naizvozvo ndichavatorera zviyo zvangu kana zvaibva,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.9",
            "verseOrgIds": [
              "HOS.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:9"
      },
      "items": [
        {
          "text": "newaini yangu itsva nenguva yayo.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.9",
            "verseOrgIds": [
              "HOS.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 2:9"
      },
      "items": [
        {
          "text": "Ndichatora makushe angu nomucheka wangu",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.9",
            "verseOrgIds": [
              "HOS.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:9"
      },
      "items": [
        {
          "text": "zvaifanira kufukidza kushama kwavo.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.9",
            "verseOrgIds": [
              "HOS.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HOS 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka zvino ndichabudisa pachena unzenza hwavo",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.10",
            "verseOrgIds": [
              "HOS.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:10"
      },
      "items": [
        {
          "text": "pamberi pavadiwa vavo;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.10",
            "verseOrgIds": [
              "HOS.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:10"
      },
      "items": [
        {
          "text": "hapana achazovatora kubva mumaoko angu.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.10",
            "verseOrgIds": [
              "HOS.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HOS 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndichagumisa kupembera kwavo kwose:",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.11",
            "verseOrgIds": [
              "HOS.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:11"
      },
      "items": [
        {
          "text": "mitambo yavo yose yegore negore, nguva dzoKugara kwoMwedzi,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.11",
            "verseOrgIds": [
              "HOS.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:11"
      },
      "items": [
        {
          "text": "maSabata avo nemitambo yavo yose yakatarwa.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.11",
            "verseOrgIds": [
              "HOS.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HOS 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndichaparadza mizambiringa yavo nemiti yavo yemionde",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.12",
            "verseOrgIds": [
              "HOS.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 2:12"
      },
      "items": [
        {
          "text": "yakanga iri muripo waibva kuvadiwa vavo.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.12",
            "verseOrgIds": [
              "HOS.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 2:12"
      },
      "items": [
        {
          "text": "Ndichazviita dondo,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.12",
            "verseOrgIds": [
              "HOS.2.14"
            ]
          }
        }
      ]
    },
    {
