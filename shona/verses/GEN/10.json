          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ava ndivo vanakomana vaShemu nedzimba dzavo uye nemitauro yavo, munyika dzavo nendudzi dzavo.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
