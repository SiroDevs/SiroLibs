            "sid": "GEN 10:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Idzi ndidzo dzimba dzavanakomana vaNoa maererano nezvizvarwa zvavo, pakati pendudzi dzavo. Kubva kuna ava ndudzi dzakapararira pamusoro penyika shure kwamafashamu.",
          "type": "text"
        }
      ]
