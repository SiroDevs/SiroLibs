  "verseCount": 43,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "30",
        "style": "c",
        "sid": "GEN 30"
      },
      "items": [
        {
          "text": "30",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 30:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rakeri akati aona kuti akanga asingaberekeri Jakobho vana, akaitira mukoma wake godo. Saka akati kuna Jakobho, \"Ndipe vana, kana zvikasadaro ndichafa!\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.1",
            "verseOrgIds": [
              "GEN.30.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 30:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jakobho akamutsamwira akati, \"Ko, ini ndiri panzvimbo yaMwari here akakuita kuti urege kuva nevana?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.2",
            "verseOrgIds": [
              "GEN.30.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 30:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akati, \"Hoyu Bhiriha, murandakadzi wangu. Vata naye kuitira kuti andiberekere vana uye kuti kubudikidza naye neni ndigovawo nemhuri.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.3",
            "verseOrgIds": [
              "GEN.30.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 30:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka akamupa murandakadzi wake Bhiriha kuti ave mukadzi wake. Jakobho akavata naye,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.4",
            "verseOrgIds": [
              "GEN.30.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 30:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "akava nemimba akamuberekera mwanakomana.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.5",
            "verseOrgIds": [
              "GEN.30.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 30:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Rakeri akati, \"Mwari andiruramisira; iye akanzwa mukumbiro wangu uye akandipa mwanakomana.\" Nokuda kwaizvozvo akamutumidza zita rokuti Dhani.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.6",
            "verseOrgIds": [
              "GEN.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 30:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhiriha murandakadzi waRakeri akavazve nemimba uye akaberekera Jakobho mwanakomana wechipiri.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.7",
            "verseOrgIds": [
              "GEN.30.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Rakeri akati, \"Ndakava nokurwa kukuru nomukoma wangu, ndikakunda.\" Saka akamutumidza zita rokuti Nafutari.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.8",
            "verseOrgIds": [
              "GEN.30.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 30:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rea akati aona kuti aguma kubereka vana, akatora murandakadzi wake Ziripa akamupa kuna Jakobho somukadzi wake.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.9",
            "verseOrgIds": [
              "GEN.30.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 30:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ziripa murandakadzi waRea akaberekera Jakobho mwanakomana.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.10",
            "verseOrgIds": [
              "GEN.30.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 30:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Rea akati, \"Makorokoto! Zvaita zvakanaka.\" Saka akamutumidza zita rokuti Gadhi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.11",
            "verseOrgIds": [
              "GEN.30.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 30:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ziripa murandakadzi waRea akaberekera Jakobho mwanakomana wechipiri.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.12",
            "verseOrgIds": [
              "GEN.30.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 30:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Rea akati, \"Mufaroi wandinawo! Vakadzi vachati mufaro kwandiri.\" Saka akamutumidza zita rokuti Asheri.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.13",
            "verseOrgIds": [
              "GEN.30.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 30:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panguva yokuchekwa kwegorosi, Rubheni akabuda akaenda musango akandowana mamandiraki, akauya nawo kuna mai vake Rea, Rakeri akati kuna Rea, \"Ndapota dondipawo mamwe mamandiraki omwanakomana wako.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.14",
            "verseOrgIds": [
              "GEN.30.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 30:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi iye akati kwaari, \"Ko, hazvina kuringana here kuti wakanditorera murume wangu? Uchada kutorazve mamandiraki omwanakomana wangu here?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.15",
            "verseOrgIds": [
              "GEN.30.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 30:15"
      },
      "items": [
        {
          "text": "Rakeri akati, \"Zvakanaka, ngaavate newe usiku huno nokuda kwamamandiraki omwanakomana wako.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.15",
            "verseOrgIds": [
              "GEN.30.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 30:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Jakobho akati achisvika kubva kusango manheru iwayo, Rea akabuda kundomuchingamidza. Akati kwaari, \"Unofanira kuvata neni iwe. Ndakutenga nemamandiraki omwanakomana wangu.\" Saka akavata naye usiku ihwohwo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.16",
            "verseOrgIds": [
              "GEN.30.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 30:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwari akanzwa Rea, uye akava nemimba akaberekera Jakobho mwanakomana wechishanu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.17",
            "verseOrgIds": [
              "GEN.30.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 30:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Rea akati, \"Mwari akandipa mubayiro nokuda kwokupa murandakadzi wangu kumurume wangu.\" Saka akamutumidza zita rokuti Isakari.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.18",
            "verseOrgIds": [
              "GEN.30.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 30:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rea akabatazve pamuviri uye akaberekera Jakobho mwanakomana wechitanhatu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.19",
            "verseOrgIds": [
              "GEN.30.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 30:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Rea akati, \"Mwari andipa chipo chinokosha. Nguva ino murume wangu achandikudza, nokuti ndamuberekera vanakomana vatanhatu.\" Saka akamutumidza zita rokuti Zebhuruni.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.20",
            "verseOrgIds": [
              "GEN.30.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 30:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shure kwaizvozvo akazobereka mwanasikana uye akamutumidza zita rokuti Dhaina.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.21",
            "verseOrgIds": [
              "GEN.30.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 30:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Mwari akarangarira Rakeri; akamunzwa uye akazarura chizvaro chake.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.22",
            "verseOrgIds": [
              "GEN.30.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 30:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akava nemimba akabereka mwanakomana uye akati, \"Mwari abvisa kunyadziswa kwangu.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.23",
            "verseOrgIds": [
              "GEN.30.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 30:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akamutumidza zita rokuti Josefa, uye akati, \"Mwari ngaandiwedzere mumwe mwanakomana.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.24",
            "verseOrgIds": [
              "GEN.30.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Zvipfuwo zvaJakobho zvinowanda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 30:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shure kwokuberekwa kwaJosefa naRakeri, Jakobho akati kuna Rabhani, \"Ndiregei ndiende kunyika yokwangu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.25",
            "verseOrgIds": [
              "GEN.30.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 30:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipei vakadzi vangu navana, avo vandakakushandirai kuti ndigowana, uye ndigoenda. Munoziva kuti ndakakushandirai sei.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.26",
            "verseOrgIds": [
              "GEN.30.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 30:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi Rabhani akati kwaari, \"Kana ndawana nyasha pamberi pako, ndapota hangu imbogara. Ndakaona nokuvuka kuti Jehovha akandiropafadza nokuda kwako.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.27",
            "verseOrgIds": [
              "GEN.30.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 30:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akatizve, \"Reva muripo wako, uye ndichakuripa.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.28",
            "verseOrgIds": [
              "GEN.30.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 30:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jakobho akati kwaari, \"Munoziva kuti ndakakushandirai sei uye kuti zvipfuwo zvenyu ndakazvichengeta sei.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.29",
            "verseOrgIds": [
              "GEN.30.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 30:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvishoma zvamaiva nazvo kare ndisati ndauya zvawanda, uye Jehovha akakuropafadzai kwose kwandakanga ndiri. Asi zvino, ndichaitirawo mhuri yangu chinhu riniko?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.30",
            "verseOrgIds": [
              "GEN.30.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 30:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akamubvunza akati, \"Ndokupeiko?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.31",
            "verseOrgIds": [
              "GEN.30.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 30:31"
      },
      "items": [
        {
          "text": "Jakobho akati, \"Musandipa chinhu. Asi kana mukandiitira chinhu chimwe chete ichi, ndicharamba ndichifudza makwai enyu uye ndichaachengeta:",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.31",
            "verseOrgIds": [
              "GEN.30.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 30:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Regai ndifambe pakati pezvipfuwo zvenyu zvose nhasi nditsaure pakati pazvo zvose zvina mavara namakwai ana makwapa, gwayana dema rimwe nerimwe nembudzi imwe neimwe ina mavara kana ina makwapa. Ndizvo zvichava mubayiro wangu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.32",
            "verseOrgIds": [
              "GEN.30.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 30:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye kutendeka kwangu kuchandipupurira pane ramangwana rangu, pose pamunenge muchizoona mubayiro wangu wamakandipa. Mbudzi ipi zvayo yandinayo inenge isina mavara kana gwapa, kana gwayana ripi zvaro rinenge risina kusviba, zvichanzi zvakabiwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.33",
            "verseOrgIds": [
              "GEN.30.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "GEN 30:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rabhani akati, \"Ndizvozvo. Ngazvive sezvawataura.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.34",
            "verseOrgIds": [
              "GEN.30.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "GEN 30:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musi wacho iwoyo akatsaura nhongo dzose dzembudzi dzakanga dzine mitsetse kana dzaiva namakwapa, nenhunzvi dzose dzembudzi (dzose dzakanga dzine zvichena padziri) namakwayana matema ose, akazvichengetesa navanakomana vake.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.35",
            "verseOrgIds": [
              "GEN.30.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "GEN 30:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akaisa nhambwe yorwendo rwamazuva matatu pakati pake naJakobho, asi Jakobho akaramba achifudza makwai akanga asara aRabhani.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.36",
            "verseOrgIds": [
              "GEN.30.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "GEN 30:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunyange zvakadaro, Jakobho akatora matavi akatemwa kubva pamupopura, muarimondi nomuti womupureni uye akasvuura mitsetse michena pairi achibvisa gwati kuti kuchena kwedanda kwomukati kuonekwe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.37",
            "verseOrgIds": [
              "GEN.30.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "GEN 30:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akaisa matanda ose akasvuurwa muzvinwiro zvose, kuitira kuti ave mberi kwezvipfuwo pazvainge zvauya kuzonwa. Zvipfuwo zvapfumvura zvaiti pazvinenge zvauya kuzonwa mvura,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.38",
            "verseOrgIds": [
              "GEN.30.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "GEN 30:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "zvaisangana pamberi pamatanda. Uye zvaibereka vana vane mitsetse kana vane mavara kana makwapa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.39",
            "verseOrgIds": [
              "GEN.30.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "GEN 30:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jakobho aitsaura mbudzana kana makwayana oga, asi aiita kuti akasara atarisane nezvipfuwo zvine mitsetse nezvipfuwo zvitema zvakanga zviri zvaRabhani. Nokudaro akaparadzanisa zvipfuwo zvake nezvaRabhani.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.40",
            "verseOrgIds": [
              "GEN.30.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "GEN 30:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pose painge nhunzvi dzezvipfuwo zvine simba zvapfumvura, Jakobho aiisa matanda muzvinwiro pamberi pezvipfuwo kuitira kuti zvisangane pedyo namatanda,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.41",
            "verseOrgIds": [
              "GEN.30.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "GEN 30:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "asi kana zvipfuwo zvisina simba, aisaisa matanda ipapo. Saka zvipfuwo zvisina simba zvakaenda kuna Rabhani uye zvine simba zvikaenda kuna Jakobho.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.42",
            "verseOrgIds": [
              "GEN.30.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "GEN 30:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nenzira iyi murume uyu akapfuma kwazvo uye akava namapoka akawanda amakwai, navarandakadzi navarandarume, uye ngamera nembongoro.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.43",
            "verseOrgIds": [
              "GEN.30.43"
            ]
          }
        }
      ]
    }
  ],
