          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanakomana vaAna vaiva:",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.25",
            "verseOrgIds": [
              "GEN.36.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 36:25"
      },
      "items": [
        {
          "text": "Dishoni naOhoribhama, mwanakomana waAna.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.25",
            "verseOrgIds": [
              "GEN.36.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 36:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanakomana vaDhishoni vaiva:",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.26",
            "verseOrgIds": [
              "GEN.36.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 36:26"
      },
      "items": [
        {
          "text": "Hemidhani, Eshibhani, Itirani naKerani.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.26",
            "verseOrgIds": [
              "GEN.36.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 36:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanakomana vaEzeri vaiva:",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.27",
            "verseOrgIds": [
              "GEN.36.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 36:27"
      },
      "items": [
        {
          "text": "Bhirihani, Zaavhani naAkani.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.27",
            "verseOrgIds": [
              "GEN.36.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 36:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanakomana vaDhishani vaiva:",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.28",
            "verseOrgIds": [
              "GEN.36.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 36:28"
      },
      "items": [
        {
          "text": "Uzi naArani.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.28",
            "verseOrgIds": [
              "GEN.36.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 36:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aya ndiwo akanga ari madzishe avaHori:",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.29",
            "verseOrgIds": [
              "GEN.36.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 36:29"
      },
      "items": [
        {
          "text": "Rotani, Shobhari, Zibheoni, Ana,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.29",
            "verseOrgIds": [
              "GEN.36.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 36:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhishoni, Ezeri naDhishani.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.30",
            "verseOrgIds": [
              "GEN.36.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4",
        "vid": "GEN 36:30"
      },
      "items": [
        {
          "text": "Aya ndiwo akanga ari madzishe avaHori zvichienderana namarudzi avo, munyika yaSeiri.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Vatongi veEdhomu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 36:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aya ndiwo madzimambo akatonga muEdhomu pasati pambova namambo upi zvake akatonga muIsraeri:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 36:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhera, mwanakomana waBheori, akava mambo weEdhomu. Guta rake rakatumidzwa zita rokuti Dhinihabha.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.32",
            "verseOrgIds": [
              "GEN.36.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 36:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhera akati afa, Jobhabhi, mwanakomana waZera, aibva kuBhozira akamutevera paumambo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.33",
            "verseOrgIds": [
              "GEN.36.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "GEN 36:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jobhabhi akati afa, Hushami aibva kunyika yavaTemani akamutevera paumambo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.34",
            "verseOrgIds": [
              "GEN.36.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "GEN 36:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hushani akati afa, Hadhadhi mwanakomana waBhedhadhi, uya akakunda Midhiani munyika yeMoabhu, akamutevera paumambo. Guta rake rakatumidzwa zita rokuti Avhiti.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.35",
            "verseOrgIds": [
              "GEN.36.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "GEN 36:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hadhadhi akati afa, Samura aibva kuMasireka akamutevera paumambo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.36",
            "verseOrgIds": [
              "GEN.36.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "GEN 36:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samura akati afa, Shauri aibva kuRehobhoti paRwizi akamutevera paumambo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.37",
            "verseOrgIds": [
              "GEN.36.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "GEN 36:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shauri akati afa, Bhaari-Hanani mwanakomana waAkibhori akamutevera paumambo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.38",
            "verseOrgIds": [
              "GEN.36.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "GEN 36:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhaari-Hanani mwanakomana waAkibhori akati afa, Hadhadhi akamutevera paumambo. Guta rake rakatumidzwa zita rokuti Pua, uye zita romukadzi wake rainzi Mehetabheri mwanasikana waMatiredhi, mwanasikana waMe-Zahabhi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.39",
            "verseOrgIds": [
              "GEN.36.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "GEN 36:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aya ndiwo madzishe akabva kuna Esau, namazita avo, maererano nedzimba dzavo namatunhu avo:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "GEN 36:40"
      },
      "items": [
        {
          "text": "Timina, Arivha, Jeteti,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.40",
            "verseOrgIds": [
              "GEN.36.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "GEN 36:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ohoribhama, Era, Pinoni,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.41",
            "verseOrgIds": [
              "GEN.36.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "GEN 36:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenazi, Temani, Mibhiza,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.42",
            "verseOrgIds": [
              "GEN.36.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "GEN 36:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Magidhieri naIrami.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.43",
            "verseOrgIds": [
              "GEN.36.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4",
        "vid": "GEN 36:43"
      },
      "items": [
        {
          "text": "Aya ndiwo akanga ari madzishe eEdhomu, maererano namagariro avo munyika yavakatora.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "GEN 36:43"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4",
        "vid": "GEN 36:43"
      },
      "items": [
        {
          "text": "Uyu ndiye Esau baba wevaEdhomu.",
          "type": "text"
        }
      ]
    }
