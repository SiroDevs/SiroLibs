  "verseCount": 43,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "36",
        "style": "c",
        "sid": "GEN 36"
      },
      "items": [
        {
          "text": "36",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Zvizvarwa zvaEsau",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 36:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyi ndiyo nhoroondo yaEsau (ndiye Edhomu).",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.1",
            "verseOrgIds": [
              "GEN.36.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 36:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esau akatora mukadzi wake kubva kuvakadzi veKenani: Adha mwanasikana waEroni muHiti, naOhoribhama mwanasikana waAna, muzukuru waZibheoni muHivhi,",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 36:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "uyewo Bhasemati mwanasikana waIshumaeri, hanzvadzi yaNebhayoti.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 36:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adha akaberekera Esau Erifazi, Bhasemati akabereka Reueri,",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 36:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye Ohoribhama akabereka Jeushi, Jaramu naKora. Ndivo vana vaEsau vaakaberekerwa muKenani.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 36:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esau akatora vakadzi vake navanakomana vake uye vanasikana vake navamwe vose veimba yake, pamwe chete nemombe dzake nezvimwe zvipfuwo zvake nepfuma yake yose yaakanga awana muKenani, akaenda kunyika yakanga iri kure nomununʼuna wake Jakobho.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 36:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pfuma yakanga yawanda kwazvo kuti vagare pamwe chete; nyika yavaigara yakanga isisavaringani vose nokuda kwezvipfuwo zvavo.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 36:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Esau (ndiye Edhomu) akandogara kunyika yezvikomo yeSeiri.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 36:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyi ndiyo nhoroondo yaEsau baba vavaEdhomu munyika yezvikomo yeSeiri.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 36:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aya ndiwo mazita avanakomana vaEsau:",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.10",
            "verseOrgIds": [
              "GEN.36.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 36:10"
      },
      "items": [
        {
          "text": "Erifazi, mwanakomana womukadzi waEsau, Adha, Reueri, mwanakomana waBhasemati, mukadzi waEsau.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.10",
            "verseOrgIds": [
              "GEN.36.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 36:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanakomana vaErifazi vaiva:",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.11",
            "verseOrgIds": [
              "GEN.36.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 36:11"
      },
      "items": [
        {
          "text": "Temani, Omari, Zefo, Gatami naKenazi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.11",
            "verseOrgIds": [
              "GEN.36.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 36:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanakomana waEsau, Erifazi naiyewo akanga ano murongo ainzi Timina, uyo akamuberekera Amareki. Ava ndivo vaiva vazukuru vaAdha, mukadzi waEsau.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.12",
            "verseOrgIds": [
              "GEN.36.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 36:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanakomana vaReueri vaiva:",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.13",
            "verseOrgIds": [
              "GEN.36.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 36:13"
      },
      "items": [
        {
          "text": "Nahati, Zera, Shama naMiza. Ava ndivo vaiva vazukuru vaBhasemati mukadzi waEsau.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.13",
            "verseOrgIds": [
              "GEN.36.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 36:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanakomana vaOhoribhama, mukadzi waEsau, mwanasikana waAna, muzukuru waZibheoni, vaakaberekera Esau, vaiva:",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.14",
            "verseOrgIds": [
              "GEN.36.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 36:14"
      },
      "items": [
        {
          "text": "Jeushi, Jaramu naKora.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.14",
            "verseOrgIds": [
              "GEN.36.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 36:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aya ndiwo aiva madzishe pakati pezvizvarwa zvaEsau:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "GEN 36:15"
      },
      "items": [
        {
          "text": "Vanakomana vaErifazi, dangwe raEsau, vaiva:",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.15",
            "verseOrgIds": [
              "GEN.36.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 36:15"
      },
      "items": [
        {
          "text": "madzishe Temani, Omari, Sefo, Kenazi,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.15",
            "verseOrgIds": [
              "GEN.36.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 36:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kora, Gatami naAmareki. Aya ndiwo madzishe akabva kuna Erifazi muEdhomu; vaiva vazukuru vaAdha.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.16",
            "verseOrgIds": [
              "GEN.36.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 36:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanakomana vaReueri, mwanakomana waEsau,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.17",
            "verseOrgIds": [
              "GEN.36.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 36:17"
      },
      "items": [
        {
          "text": "vaiva madzishe Nahati, Zera, Shama naMiza. Aya ndiwo madzishe akabva kuna Reueri muEdhomu; vakanga vari vazukuru vaBhasemati, mukadzi waEsau.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.17",
            "verseOrgIds": [
              "GEN.36.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 36:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanakomana vaOhoribhama, mukadzi waEsau, vaiva:",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.18",
            "verseOrgIds": [
              "GEN.36.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 36:18"
      },
      "items": [
        {
          "text": "madzishe Jeushi, Jaramu naKora. Aya ndiwo madzishe akabva kuna Ohoribhama mukadzi waEsau mwanasikana waAna.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.18",
            "verseOrgIds": [
              "GEN.36.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 36:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ava ndivo vaiva vanakomana vaEsau (ndiye Edhomu) uye aya ndiwo madzishe avo.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 36:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ava ndivo vakanga vari vanakomana vaSeiri muHori, vakanga vachigara mudunhu iroro:",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.20",
            "verseOrgIds": [
              "GEN.36.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 36:20"
      },
      "items": [
        {
          "text": "Rotani, Shobhari, Zibheoni, Ana,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.20",
            "verseOrgIds": [
              "GEN.36.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 36:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhishoni, Ezeri naDhishani. Vanakomana ava vaSeiri muEdhomu vakanga vari madzishe avaHori.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.21",
            "verseOrgIds": [
              "GEN.36.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 36:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanakomana vaRotani vaiva:",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.22",
            "verseOrgIds": [
              "GEN.36.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 36:22"
      },
      "items": [
        {
          "text": "Hori naHomami. Timina akanga ari hanzvadzi yaRotani.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.22",
            "verseOrgIds": [
              "GEN.36.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 36:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanakomana vaShobhari vaiva:",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.23",
            "verseOrgIds": [
              "GEN.36.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 36:23"
      },
      "items": [
        {
          "text": "Arivhani, Manahati, Ebhari, Shefo naOnami.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.23",
            "verseOrgIds": [
              "GEN.36.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 36:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanakomana vaZibheoni vaiva:",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.24",
            "verseOrgIds": [
              "GEN.36.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 36:24"
      },
      "items": [
        {
          "text": "Ayia naAna. Uyu ndiye uya Ana akawana matsime emvura inopisa mugwenga paakanga achifudza mbongoro dzababa vake Zibheoni.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.24",
            "verseOrgIds": [
              "GEN.36.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
