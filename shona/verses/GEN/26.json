              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musi iwoyo varanda vaIsaka vakauya vakamuudza nezvetsime ravakanga vachera. Vakati, \"Tawana mvura!\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.32",
