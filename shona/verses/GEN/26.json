          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaritumidza zita rokuti Shibha, uye kusvikira nhasi zita reguta richiri kunzi Bheerishebha.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.33",
