              "type": "text"
            }
          ]
        },
        {
          "text": "Mangwanani akatevera varume ava vakapikirana. Ipapo Isaka akavaendesa parwendo rwavo, vakamusiya murugare.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.31",
            "verseOrgIds": [
