              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Varume vakanga vakagariswa pamberi pake zvaienderana namazera avo, kubva kudangwe kusvikira kugotwe; uye vakatarisana zvikavakatyamadza.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.33",
