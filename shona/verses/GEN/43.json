  "verseCount": 34,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "43",
        "style": "c",
        "sid": "GEN 43"
      },
      "items": [
        {
          "text": "43",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Rwendo rwechipiri rwokuenda kuIjipiti",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 43:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino nzara yakanga ichakanyanya munyika.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.1",
            "verseOrgIds": [
              "GEN.43.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 43:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka vakati vadya zviyo zvose zvavakanga vabva nazvo kuIjipiti, baba vavo vakati kwavari, \"Dzokerai mundotitengera zvimwe zvokudya.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.2",
            "verseOrgIds": [
              "GEN.43.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 43:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi Judha akati kwavari, \"Murume uya akatiyambira kwazvo akati, 'Hamungazooni chiso changuzve kunze kwokunge mununʼuna wenyu auya nemi.'",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.3",
            "verseOrgIds": [
              "GEN.43.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 43:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana mukaendesa mununʼuna wedu nesu, tichaenda kundokutengerai zvokudya.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.4",
            "verseOrgIds": [
              "GEN.43.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 43:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi kana mukasamuendesa, hatingatongoendi, nokuti murume uya akati, 'Hamungazooni chiso changuzve kunze kwokunge mununʼuna wenyu auya nemi.' \"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.5",
            "verseOrgIds": [
              "GEN.43.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 43:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Israeri akabvunza akati, \"Seiko makauyisa dambudziko iri pamusoro pangu zvamakaudza murume uyu kuti muno mumwe mununʼuna?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.6",
            "verseOrgIds": [
              "GEN.43.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 43:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivo vakapindura vakati, \"Murume uyu akatibvunzisisa kwazvo nezvedu uye nezvemhuri yedu. Akati, 'Baba venyu vachiri vapenyu here? Muno mumwe mununʼuna here?' Takangopindura mubvunzo wake zvakanaka. Ko, taiziva sei kuti aizoti, 'Uyai nomununʼuna wenyu kuno?' \"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.7",
            "verseOrgIds": [
              "GEN.43.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 43:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Judha akati kuna Israeri baba vake, \"Tumai mukomana pamwe chete neni tibve taenda izvozvi, kuitira kuti isu nemi navana vedu tirarame uye tirege kufa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.8",
            "verseOrgIds": [
              "GEN.43.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 43:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ini pachangu ndichava rubatso rwokuchengetedzeka kwake; musiyei muruoko rwangu pachangu. Kana ndikasadzoka naye kwamuri ndikamumisa pamberi penyu, ini ndichava nemhosva pamberi penyu muupenyu hwangu hwose.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.9",
            "verseOrgIds": [
              "GEN.43.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 43:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izvozvi dai tisina kunonoka, tingadai takatoenda uye takatodzoka kaviri kwose.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.10",
            "verseOrgIds": [
              "GEN.43.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 43:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo baba vavo Israeri vakati kwavari, \"Kana zvakadaro, itai izvi zvino: Isai zvimwe zvibereko zvemichero yenyika ino zvakaisvonaka mumasaga enyu uye mugoenda nazvo sezvipo kumurume uyo, bharimu shoma shoma, nouchi hushoma shoma, zvinonhuhwira nemura, nzungu dzomupistakio namaarimondi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.11",
            "verseOrgIds": [
              "GEN.43.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 43:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutakure mari yakapetwa kaviri, nokuti munofanira kudzorera mari yakanga yadzoserwa pamiromo yamasaga enyu. Zvichida kwaiva kukanganisa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.12",
            "verseOrgIds": [
              "GEN.43.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 43:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toraiwo mununʼuna wenyu mudzokere izvozvi kumunhu uyo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.13",
            "verseOrgIds": [
              "GEN.43.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 43:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye Mwari Wamasimba Ose ngaakunzwirei ngoni pamberi pomunhu uyo kuitira kuti asunungure mumwe mununʼuna wenyu naBhenjamini uye vagodzokazve nemi. Kana ndirini, kana ndafirwa navana vangu, ndafirwa hangu.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.14",
            "verseOrgIds": [
              "GEN.43.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 43:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka varume vakatora zvipo nemari yakapetwa kaviri, naBhenjaminiwo. Vakakurumidza kuburuka kuIjipiti vakandozviratidza kuna Josefa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.15",
            "verseOrgIds": [
              "GEN.43.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 43:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Josefa akati achiona Bhenjamini anavo, akati kuvatariri veimba yake, \"Torai varume ava muende navo kumba kwangu, muuraye chipfuwo mugogadzira zvokudya; vanofanira kudya neni masikati ano.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.16",
            "verseOrgIds": [
              "GEN.43.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 43:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Varume vakaita sezvavakanga vaudzwa naJosefa vakabva vatora varume vaya vakaenda navo kumba kwaJosefa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.17",
            "verseOrgIds": [
              "GEN.43.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 43:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino varume vaya vakatya pavakatorwa vakaendwa navo kumba kwake. Vakafunga vakati, \"Tauyiswa muno nokuda kwemari iya yakadzoserwa mumasaga edu panguva yokutanga. Anoda kutirwisa, agotikunda, agotisunga senhapwa uye agotora mbongoro dzedu.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.18",
            "verseOrgIds": [
              "GEN.43.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 43:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka vakaenda kumutariri waJosefa vakandotaura naye pamukova wokupinda mumba make.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.19",
            "verseOrgIds": [
              "GEN.43.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 43:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakati kwaari, \"Tapota ishe, takauya kuno panguva yokutanga kuti tizotenga zvokudya.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.20",
            "verseOrgIds": [
              "GEN.43.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 43:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi patakamira pane imwe nzvimbo usiku, takazarura masaga edu uye mumwe nomumwe wedu akawana mari yake iri pamuromo wesaga, iyo mari yacho yose zvayo. Saka tadzoka nayo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.21",
            "verseOrgIds": [
              "GEN.43.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 43:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tauyawo neimwe mari yokuti tizotenga zvokudya. Hatizivi akaisa mari yedu mumasaga edu.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.22",
            "verseOrgIds": [
              "GEN.43.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 43:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye akati, \"Zvakanakai. Musatya henyu Mwari wenyu, iye Mwari wababa venyu, ndiye akakupai pfuma mumasaga enyu, ini ndakagamuchira mari yenyu.\" Ipapo akabudisa Simeoni akamuuyisa kwavari.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.23",
            "verseOrgIds": [
              "GEN.43.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 43:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutariri uya akauyisa varume vaya mumba maJosefa, akavapa mvura kuti vashambe tsoka dzavo uye akapa mbongoro dzavo zvokudya.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.24",
            "verseOrgIds": [
              "GEN.43.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 43:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakagadzira zvipo zvokupa Josefa pakusvika kwake masikati, nokuti vakanga vanzwa kuti vachandodya ikoko.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.25",
            "verseOrgIds": [
              "GEN.43.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 43:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Josefa akati auya kumba, ivo vakamupa zvipo zvavakanga vapinda nazvo mumba, uye vakakotamira pasi kwaari.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.26",
            "verseOrgIds": [
              "GEN.43.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 43:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akavabvunza mufaro, uye akati, \"Vakadii baba venyu, mutana, vamakandiudza nezvavo? Vachiri vapenyu here?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.27",
            "verseOrgIds": [
              "GEN.43.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 43:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakapindura vakati, \"Muranda wenyu, ivo baba vedu vachiri vapenyu uye vanofara.\" Uye vakakotama pasi kuti vamuremekedze.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.28",
            "verseOrgIds": [
              "GEN.43.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 43:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paakatarisa-tarisa akaona mununʼuna wake Bhenjamini, mwanakomana wamai vake chaiye, akabvunza akati, \"Uyu ndiye mununʼuna wenyu gotwe, wamakandiudza nezvake here?\" Uye akati, \"Mwari akuitire nyasha, mwanakomana wangu.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.29",
            "verseOrgIds": [
              "GEN.43.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 43:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adumbirwa pakuona kwake mununʼuna wake, Josefa akakurumidza kubuda uye akatsvaka nzvimbo paangachema ari. Akapinda muimba yake yomukati akandochema ari imomo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.30",
            "verseOrgIds": [
              "GEN.43.30"
            ]
          }
        }
      ]
    },
