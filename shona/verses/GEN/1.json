          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mavambo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakutanga Mwari akasika matenga nenyika.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.1",
            "verseOrgIds": [
              "GEN.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino nyika yakanga isina kugadzirwa uye isina chinhu, rima rakanga riri pamusoro pemvura yakadzika, uye Mweya waMwari wakanga uchigara pamusoro pemvura.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.2",
            "verseOrgIds": [
              "GEN.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye Mwari akati, \"Chiedza ngachivepo,\" chiedza chikavapo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.3",
            "verseOrgIds": [
              "GEN.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwari akaona kuti chiedza chakanga chakanaka, uye akaparadzanisa chiedza nerima.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.4",
            "verseOrgIds": [
              "GEN.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwari akatumidza chiedza kuti \"masikati,\" uye rima akaritumidza kuti \"usiku.\" Uye madekwana akavapo, namangwanani akavapo, zuva rokutanga.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.5",
            "verseOrgIds": [
              "GEN.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye Mwari akati, \"Ngapave nenzvimbo pakati pemvura kuti iparadzanise mvura nemvura.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.6",
            "verseOrgIds": [
              "GEN.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Mwari akaita nzvimbo uye akaparadzanisa mvura yakanga iri pasi penzvimbo iyi kubva pamvura yakanga iri pamusoro payo. Uye zvakaita saizvozvo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.7",
            "verseOrgIds": [
              "GEN.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwari akatumidza nzvimbo iyi kuti \"denga.\" Uye madekwana akavapo, namangwanani akavapo, zuva rechipiri.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.8",
            "verseOrgIds": [
              "GEN.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye Mwari akati, \"Mvura iri pasi pedenga ngaiungane panzvimbo imwe chete, uye pasi pakaoma ngapaonekwe.\" Uye zvakaita saizvozvo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.9",
            "verseOrgIds": [
              "GEN.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwari akatumidza pasi pakaoma kuti, \"nyika,\" uye mvura yakaungana akaiti \"makungwa.\" Uye Mwari akaona kuti zvakanga zvakanaka.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.10",
            "verseOrgIds": [
              "GEN.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Mwari akati, \"Nyika ngaimerese uswa: miriwo inobereka mbeu nemiti panyika inobereka michero ine mhodzi mukati mayo, maererano nemhando dzayo dzakasiyana-siyana.\" Uye zvakaita saizvozvo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.11",
            "verseOrgIds": [
              "GEN.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyika yakameresa uswa: miriwo inobereka mbeu maererano nemhando dzayo nemiti inobereka michero ine mhodzi mukati mayo, maererano nemhando dzayo. Uye Mwari akaona kuti zvakanga zvakanaka.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.12",
            "verseOrgIds": [
              "GEN.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye madekwana akavapo, namangwanani akavapo, zuva rechitatu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.13",
            "verseOrgIds": [
              "GEN.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye Mwari akati, \"Ngakuve nezviedza munzvimbo yedenga kuti zviparadzanise masikati kubva pausiku, uye ngazvishande sezviratidzo zvokucherechedza mwaka namazuva namakore,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.14",
            "verseOrgIds": [
              "GEN.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye ngazvive zviedza munzvimbo yedenga kuti zvivhenekere panyika.\" Uye zvakaita saizvozvo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.15",
            "verseOrgIds": [
              "GEN.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwari akaita zviedza zvikuru zviviri, chiedza chikuru kuti chibate ushe masikati uye chiedza chiduku kuti chibate ushe usiku. Akaitawo nyeredzi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.16",
            "verseOrgIds": [
              "GEN.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwari akazviisa munzvimbo yedenga kuti zvivhenekere panyika,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.17",
            "verseOrgIds": [
              "GEN.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuti zvibate ushe masikati nousiku, uye kuti zviparadzanise chiedza kubva parima. Uye Mwari akaona kuti zvakanga zvakanaka.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.18",
            "verseOrgIds": [
              "GEN.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye madekwana akavapo, namangwanani akavapo, zuva rechina.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.19",
            "verseOrgIds": [
              "GEN.1.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye Mwari akati, \"Mvura ngaive nezvisikwa zvipenyu, uye shiri ngadzibhururuke pamusoro penyika munzvimbo yedenga.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.20",
            "verseOrgIds": [
              "GEN.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Mwari akasika zvisikwa zvikuru zvegungwa nezvipenyu zvose zvinokambaira zvinogara mumvura, maererano namarudzi azvo, uye neshiri dzina mapapiro, maererano namarudzi adzo. Uye Mwari akaona kuti zvakanga zvakanaka.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.21",
            "verseOrgIds": [
              "GEN.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwari akazviropafadza akati, \"Berekanai muwande muzadze mvura iri mumakungwa, uye shiri ngadziwande panyika.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.22",
            "verseOrgIds": [
              "GEN.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye madekwana akavapo, namangwanani akavapo, zuva rechishanu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.23",
            "verseOrgIds": [
              "GEN.1.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye Mwari akati, \"Nyika ngaibereke zvisikwa zvipenyu maererano namarudzi azvo: zvipfuwo, zvisikwa zvinokambaira panyika, nezvikara zvesango, chimwe nechimwe nemhando yacho.\" Uye zvakaita saizvozvo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.24",
            "verseOrgIds": [
              "GEN.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwari akaita mhuka dzesango maererano namarudzi adzo, zvipfuwo namarudzi azvo, nezvisikwa zvose zvinokambaira panyika maererano namarudzi azvo. Uye Mwari akaona kuti zvakanga zvakanaka.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.25",
            "verseOrgIds": [
              "GEN.1.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Mwari akati, \"Ngatiitei munhu nomufananidzo wedu, akafanana nesu, uye ngavave nesimba pamusoro pehove dzegungwa napamusoro peshiri dzedenga, napamusoro pemombe, napamusoro penyika yose, uye napamusoro pezvisikwa zvose zvinokambaira panyika.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.26",
            "verseOrgIds": [
              "GEN.1.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 1:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Mwari akasika munhu nomufananidzo wake,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.27",
            "verseOrgIds": [
              "GEN.1.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 1:27"
      },
      "items": [
        {
          "text": "akamusika mumufananidzo waMwari;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.27",
            "verseOrgIds": [
              "GEN.1.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 1:27"
      },
      "items": [
        {
          "text": "akavasika murume nomukadzi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.27",
            "verseOrgIds": [
              "GEN.1.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwari akavaropafadza akati kwavari, \"Berekanai muwande; zadzai nyika uye mubate ushe pamusoro payo. Muve nesimba pamusoro pehove dzegungwa napamusoro peshiri dzedenga napamusoro pezvisikwa zvipenyu zvinokambaira panyika.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.28",
            "verseOrgIds": [
              "GEN.1.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 1:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Mwari akati, \"Ndinokupai miriwo yose inobereka iri pamusoro penyika yose nemiti yose ine michero, ine mhodzi mukati mayo. Zvichava zvokudya zvenyu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.29",
            "verseOrgIds": [
              "GEN.1.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 1:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
