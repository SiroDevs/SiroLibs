              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akavarayira akati, \"Ini ndava kuzosanganiswa navanhu vokwangu. Mundivige namadzibaba angu mubako mumunda waEfuroni muHiti,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.29",
            "verseOrgIds": [
              "GEN.49.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 49:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "bako riri mumunda weMakapera, pedyo neMamure muKenani, rakatengwa kubva kuna Efuroni naAbhurahama senzvimbo yokuviga pamwe chete nomunda.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.30",
            "verseOrgIds": [
              "GEN.49.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 49:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo pakavigwa Abhurahama nomukadzi wake Sara, ndipozve pakavigwa Isaka nomukadzi wake Rabheka, uye Rea akavigwa ipapo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.31",
            "verseOrgIds": [
              "GEN.49.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 49:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munda nebako riri mauri zvakatengwa kubva kuvaHiti.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.32",
            "verseOrgIds": [
              "GEN.49.32"
            ]
          }
        }
