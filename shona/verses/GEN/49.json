  "verseCount": 33,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "49",
        "style": "c",
        "sid": "GEN 49"
      },
      "items": [
        {
          "text": "49",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jakobho anoropafadza vanakomana vake",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 49:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Jakobho akadana vanakomana vake akati, \"Unganai kuti ndikuudzei zvichaitika kwamuri pamazuva anouya.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.1",
            "verseOrgIds": [
              "GEN.49.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 49:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Unganai muteerere, imi vanakomana vaJakobho;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.2",
            "verseOrgIds": [
              "GEN.49.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:2"
      },
      "items": [
        {
          "text": "teererai kuna baba venyu Israeri.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.2",
            "verseOrgIds": [
              "GEN.49.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 49:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Rubheni, iwe uri dangwe rangu,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.3",
            "verseOrgIds": [
              "GEN.49.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:3"
      },
      "items": [
        {
          "text": "simba rangu, chiratidzo chokutanga chesimba rangu,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.3",
            "verseOrgIds": [
              "GEN.49.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:3"
      },
      "items": [
        {
          "text": "unokunda mukukudzwa, unokunda musimba.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.3",
            "verseOrgIds": [
              "GEN.49.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 49:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unozunguzika semvura zhinji, hauchazokundizve,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.4",
            "verseOrgIds": [
              "GEN.49.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:4"
      },
      "items": [
        {
          "text": "nokuti wakakwira panhoo yababa vako,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.4",
            "verseOrgIds": [
              "GEN.49.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:4"
      },
      "items": [
        {
          "text": "panhoo yangu uye ukaisvibisa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.4",
            "verseOrgIds": [
              "GEN.49.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 49:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Simeoni naRevhi mukoma nomununʼuna,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.5",
            "verseOrgIds": [
              "GEN.49.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:5"
      },
      "items": [
        {
          "text": "minondo yavo zvombo zvokurwa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.5",
            "verseOrgIds": [
              "GEN.49.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 49:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngandirege kupinda parangano yavo,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.6",
            "verseOrgIds": [
              "GEN.49.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:6"
      },
      "items": [
        {
          "text": "ngandirege kuva paungano yavo,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.6",
            "verseOrgIds": [
              "GEN.49.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 49:6"
      },
      "items": [
        {
          "text": "nokuti vakauraya vanhu mukutsamwa kwavo",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.6",
            "verseOrgIds": [
              "GEN.49.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:6"
      },
      "items": [
        {
          "text": "uye vakagura marunda enzombe sezvavaida.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.6",
            "verseOrgIds": [
              "GEN.49.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 49:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutsamwa kwavo ngakutukwe, kunotyisa zvakadai,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.7",
            "verseOrgIds": [
              "GEN.49.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:7"
      },
      "items": [
        {
          "text": "uye hasha dzavo, dzaiva noutsinye kudai!",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.7",
            "verseOrgIds": [
              "GEN.49.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 49:7"
      },
      "items": [
        {
          "text": "Ndichavaparadzira muna Jakobho",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.7",
            "verseOrgIds": [
              "GEN.49.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:7"
      },
      "items": [
        {
          "text": "uye ndigovatsaura muna Israeri.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.7",
            "verseOrgIds": [
              "GEN.49.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 49:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Judha, hama dzako dzichakurumbidza;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.8",
            "verseOrgIds": [
              "GEN.49.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:8"
      },
      "items": [
        {
          "text": "ruoko rwako ruchava pamitsipa yavavengi vako;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.8",
            "verseOrgIds": [
              "GEN.49.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:8"
      },
      "items": [
        {
          "text": "vanakomana vababa vako vachakotama kwauri.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.8",
            "verseOrgIds": [
              "GEN.49.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 49:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uri mwana weshumba, iwe Judha;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.9",
            "verseOrgIds": [
              "GEN.49.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:9"
      },
      "items": [
        {
          "text": "unodzoka kubva kune zvaunouraya, mwana wangu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.9",
            "verseOrgIds": [
              "GEN.49.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 49:9"
      },
      "items": [
        {
          "text": "Seshumba anonyangira uye anovata pasi,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.9",
            "verseOrgIds": [
              "GEN.49.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:9"
      },
      "items": [
        {
          "text": "seshumbakadzi, ndiani anotsunga kumumutsa?",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.9",
            "verseOrgIds": [
              "GEN.49.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 49:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsvimbo youshe haingabvi kuna Judha,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.10",
            "verseOrgIds": [
              "GEN.49.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:10"
      },
      "items": [
        {
          "text": "uye mudonzvo womutongi pakati pamakumbo ake,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.10",
            "verseOrgIds": [
              "GEN.49.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 49:10"
      },
      "items": [
        {
          "text": "kusvikira asvika kumuridzi wawo,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.10",
            "verseOrgIds": [
              "GEN.49.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:10"
      },
      "items": [
        {
          "text": "uye kuteerera kwendudzi ndokwake.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.10",
            "verseOrgIds": [
              "GEN.49.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 49:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achasungirira mbongoro yake pamuzambiringa,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.11",
            "verseOrgIds": [
              "GEN.49.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:11"
      },
      "items": [
        {
          "text": "nomwana wayo padavi rakaisvonaka;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.11",
            "verseOrgIds": [
              "GEN.49.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 49:11"
      },
      "items": [
        {
          "text": "achasuka nguo dzake muwaini,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.11",
            "verseOrgIds": [
              "GEN.49.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:11"
      },
      "items": [
        {
          "text": "zvokufuka zvake muropa ramazambiringa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.11",
            "verseOrgIds": [
              "GEN.49.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 49:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meso ake achasviba kupfuura waini,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.12",
            "verseOrgIds": [
              "GEN.49.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:12"
      },
      "items": [
        {
          "text": "meno ake achachena kupfuura mukaka.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.12",
            "verseOrgIds": [
              "GEN.49.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 49:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Zebhuruni achagara kumahombekombe egungwa",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.13",
            "verseOrgIds": [
              "GEN.49.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:13"
      },
      "items": [
        {
          "text": "uye achava zororo rezvikepe;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.13",
            "verseOrgIds": [
              "GEN.49.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:13"
      },
      "items": [
        {
          "text": "muganhu wake uchasvika paSidhoni.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.13",
            "verseOrgIds": [
              "GEN.49.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 49:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
