  "verseCount": 29,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "35",
        "style": "c",
        "sid": "GEN 35"
      },
      "items": [
        {
          "text": "35",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jakobho anodzokera kuBheteri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 35:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Mwari akati kuna Jakobho, \"Kwira uende kuBheteri undogara ikoko, uye uvake aritari yaMwari ikoko, iye akazviratidza kwauri pawakanga uchitiza mukoma wako Esau.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.1",
            "verseOrgIds": [
              "GEN.35.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 35:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Jakobho akati kune veimba yake nokuna vose vakanga vanaye, \"Bvisai vamwari vavatorwa vamunavo, muzvinatse uye mupfeke dzimwe nguo dzenyu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.2",
            "verseOrgIds": [
              "GEN.35.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 35:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo mugouya tiende kuBheteri, uko kwandichandovaka aritari yaMwari, iye akandipindura pazuva rokutambudzika kwangu uye iye akanga aneni kwose kwandakaenda.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.3",
            "verseOrgIds": [
              "GEN.35.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 35:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka vakapa Jakobho vamwari vavatorwa vose vavaiva navo nemhete dzaiva munzeve dzavo, uye Jakobho akazvifushira pasi pomuouki weShekemu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.4",
            "verseOrgIds": [
              "GEN.35.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 35:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo vakasimuka, kutya Mwari kukawira pamusoro pamaguta ose akavapoteredza zvokuti hakuna munhu akavatevera.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.5",
            "verseOrgIds": [
              "GEN.35.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 35:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jakobho navanhu vose vaaiva navo vakasvika kuRuzi (ndirowo Bheteri) munyika yeKenani.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.6",
            "verseOrgIds": [
              "GEN.35.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 35:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akavaka aritari ipapo, akatumidza nzvimbo iyo zita rokuti Eri Bheteri, nokuti Mwari akazviratidza kwaari ipapo paakanga achitiza mukoma wake.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.7",
            "verseOrgIds": [
              "GEN.35.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 35:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino Dhibhora, mureri waRabheka, akafa akavigwa pasi pomuouki mujinga meBheteri. Saka pakatumidzwa zita rokuti Aroni Bhakuti.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.8",
            "verseOrgIds": [
              "GEN.35.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 35:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shure kwokudzokera kwaJakobho kuPadhani Aramu, Mwari akazviratidza zvakare uye akamuropafadza.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.9",
            "verseOrgIds": [
              "GEN.35.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 35:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwari akati kwaari, \"Zita rako ndiJakobho, asi hauchanzi Jakobho, zita rako richanzi Israeri.\" Saka akamutumidza zita rokuti Israeri.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.10",
            "verseOrgIds": [
              "GEN.35.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 35:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye Mwari akati kwaari, \"Ndini Mwari Wamasimba Ose; berekanai muwande. Rudzi neboka rendudzi zvichabva kwauri, uye madzimambo achabuda kubva mauri.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.11",
            "verseOrgIds": [
              "GEN.35.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 35:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyika yandakapa Abhurahama naIsaka ndinoipawo kwauri, uye ndichapa nyika ino kuzvizvarwa zvako zvinokutevera.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.12",
            "verseOrgIds": [
              "GEN.35.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 35:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Mwari akakwira kudenga akabva panzvimbo yaakanga ataura naye.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.13",
            "verseOrgIds": [
              "GEN.35.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 35:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jakobho akamisa mbiru yebwe panzvimbo iyo Mwari akanga ataura naye, uye akadururira chipiriso chinonwiwa pariri; akadirawo mafuta pariri.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.14",
            "verseOrgIds": [
              "GEN.35.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 35:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jakobho akatumidza nzvimbo iyo Mwari akanga ataura naye kuti Bheteri.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.15",
            "verseOrgIds": [
              "GEN.35.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kufa kwaRakeri naIsaka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 35:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo vakapfuurira mberi kubva kuBheteri. Vachiri chinhambwe neEfurati, Rakeri akatanga kurwadziwa uye akatambudzika zvikuru.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.16",
            "verseOrgIds": [
              "GEN.35.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 35:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye paakanga achitambudzika zvikuru pakupona mwana, mbuya vaimuchengeta vakati kwaari, \"Usatya, nokuti uno mumwe mwanakomana.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.17",
            "verseOrgIds": [
              "GEN.35.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 35:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paakabudisa mweya wake, nokuti akanga ofa, akatumidza mwanakomana wake zita rokuti Bheni-Oni. Asi baba vake vakamutumidza zita rokuti Bhenjamini.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.18",
            "verseOrgIds": [
              "GEN.35.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 35:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Rakeri akafa akavigwa munzira yaienda kuEfurati (ndiro Bheterehema).",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.19",
            "verseOrgIds": [
              "GEN.35.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 35:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamusoro peguva rake Jakobho akaisa mbiru, uye kusvikira zuva ranhasi mbiru iyi inoratidza guva raRakeri.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.20",
            "verseOrgIds": [
              "GEN.35.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 35:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Israeri akapfuurira mberi zvakare akandodzika tende rake seri kweMigidhari Edheri.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.21",
            "verseOrgIds": [
              "GEN.35.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 35:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Israeri achiri kugara munyika iyo, Rubheni akapinda akandovata nomurongo wababa vake Bhiriha, uye Israeri akanzwa nezvazvo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.22",
            "verseOrgIds": [
              "GEN.35.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "GEN 35:22"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4",
        "vid": "GEN 35:22"
      },
      "items": [
        {
          "text": "Jakobho akanga ana vanakomana gumi navaviri:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 35:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanakomana vaRea vaiti:",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.23",
            "verseOrgIds": [
              "GEN.35.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 35:23"
      },
      "items": [
        {
          "text": "Rubheni dangwe raJakobho,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.23",
            "verseOrgIds": [
              "GEN.35.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 35:23"
      },
      "items": [
        {
          "text": "Simeoni, Revhi, Judha, Isakari naZebhuruni.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.23",
            "verseOrgIds": [
              "GEN.35.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 35:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanakomana vaRakeri vaiva:",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.24",
            "verseOrgIds": [
              "GEN.35.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 35:24"
      },
      "items": [
        {
          "text": "Josefa naBhenjamini.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.24",
            "verseOrgIds": [
              "GEN.35.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 35:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanakomana vaBhiriha murandakadzi waRakeri vaiva:",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.25",
            "verseOrgIds": [
              "GEN.35.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 35:25"
      },
      "items": [
        {
          "text": "Dhani naNafutari.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.25",
            "verseOrgIds": [
              "GEN.35.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 35:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanakomana vaZiripa murandakadzi waRea vaiva:",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.26",
            "verseOrgIds": [
              "GEN.35.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 35:26"
      },
      "items": [
        {
          "text": "Gadhi naAsheri.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.26",
            "verseOrgIds": [
              "GEN.35.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "GEN 35:26"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4",
        "vid": "GEN 35:26"
      },
      "items": [
        {
          "text": "Ava ndivo vanakomana vaJakobho, vaakabereka muPadhani Aramu.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
