          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akati, \"Ishe ngaarege kunditsamwira, asi regai nditaure hangu. Ko, kana makumi matatu chete vakawanikwamo?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.30",
            "verseOrgIds": [
