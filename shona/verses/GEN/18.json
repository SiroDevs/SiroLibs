        "style": "p",
        "vid": "GEN 18:30"
      },
      "items": [
        {
          "text": "Iye akapindura akati, \"Handingaiti izvozvo kana ndikawana makumi matatu chete.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.30",
            "verseOrgIds": [
