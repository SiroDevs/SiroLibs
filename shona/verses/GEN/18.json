              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvakarezve akataura kwaari akati, \"Ko, kana kukawanikwa makumi mana chete?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.29",
            "verseOrgIds": [
              "GEN.18.29"
            ]
          }
        }
      ]
    },
