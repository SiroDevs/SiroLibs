      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 18:29"
      },
      "items": [
        {
          "text": "Iye akati, \"Nokuda kwamakumi mana iwayo, handingaiti izvozvo.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.29",
            "verseOrgIds": [
              "GEN.18.29"
            ]
          }
        }
      ]
