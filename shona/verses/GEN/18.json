  "verseCount": 33,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "18",
        "style": "c",
        "sid": "GEN 18"
      },
      "items": [
        {
          "text": "18",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Vatumwa Vatatu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha akazviratidza kuna Abhurahama pedyo nemiti mikuru yeMamure panguva yaakanga agere pamukova wokupinda patende rake masikati zuva richipisa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.1",
            "verseOrgIds": [
              "GEN.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhurahama akasimudza meso ake ndokuona varume vatatu vamire naye. Akati avaona, akamhanya achibva pamukova wetende rake kuti andosangana navo uye akakotamira pasi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.2",
            "verseOrgIds": [
              "GEN.18.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati, \"Kana ndawana nyasha pamberi penyu, ishe wangu, musapfuura henyu muranda wenyu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.3",
            "verseOrgIds": [
              "GEN.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Regai muvigirwe mvura shoma, mugoshamba tsoka dzenyu mose uye mugozorora pasi pomuti uyu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.4",
            "verseOrgIds": [
              "GEN.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Regai ndikutorerei zvokudya kuti mudye, kuitira kuti musimbiswe ipapo mugoenderera henyu mberi norwendo rwenyu, sezvo zvino masvika pamuranda wenyu.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.5",
            "verseOrgIds": [
              "GEN.18.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 18:5"
      },
      "items": [
        {
          "text": "Vakapindura vakati, \"Zvakanaka, ita hako sezvawareva.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.5",
            "verseOrgIds": [
              "GEN.18.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Abhurahama akakurumidza kuenda kutende kuna Sara. Akati kwaari, \"Kurumidza, tora zviero zvitatu",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.6",
            "verseOrgIds": [
              "GEN.18.6"
            ]
          }
        },
        {
          "text": "zvoupfu hwakatsetseka uhukanye ugobika chingwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.6",
            "verseOrgIds": [
              "GEN.18.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo iye akamhanyira kumombe akandosarudza mhuru yakaisvonaka, akaipa kumuranda, uyo akakurumidza kuigadzira.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.7",
            "verseOrgIds": [
              "GEN.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akauyisa ruomba nomukaka uye nemhuru yakanga yagadzirwa, akazvigadzika pamberi pavo. Pavakanga vachidya, akamira pedyo navo pasi pomuti.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.8",
            "verseOrgIds": [
              "GEN.18.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakamubvunza vakati, \"Mukadzi wako Sara aripiko?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.9",
            "verseOrgIds": [
              "GEN.18.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 18:9"
      },
      "items": [
        {
          "text": "Iye akati, \"Ari mutende umo.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.9",
            "verseOrgIds": [
              "GEN.18.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Jehovha akati, \"Zvirokwazvo ndichadzokazve gore rinouya nenguva inenge seino, uye Sara mukadzi wako achava nomwanakomana.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.10",
            "verseOrgIds": [
              "GEN.18.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 18:10"
      },
      "items": [
        {
          "text": "Zvino Sara akanga achiteerera ari pamukova wetende wakanga uri shure kwake.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.10",
            "verseOrgIds": [
              "GEN.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhurahama naSara vakanga vakwegura uye vava namakore mazhinji, uye Sara akanga atopfuura zera rokubereka vana.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.11",
            "verseOrgIds": [
              "GEN.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Sara akaseka mumwoyo make paakafunga achiti, \"Ndichazovawo nomufaro uyu here zvino shure kwokuchembera kwangu, vatenzi vangu vakwegura?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.12",
            "verseOrgIds": [
              "GEN.18.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Jehovha akati kuna Abhurahama, \"Seiko Sara aseka achiti, 'Ndichava nomwana zvechokwadi here, sezvo zvino ndakwegura?'",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.13",
            "verseOrgIds": [
              "GEN.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pane chinhu chakaoma kuna Jehovha here? Ndichadzokazve kwauri gore rinouya senguva dzakatarwa uye Sara achava nomwanakomana.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.14",
            "verseOrgIds": [
              "GEN.18.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sara akatya, saka akareva nhema akati, \"Handina kuseka.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.15",
            "verseOrgIds": [
              "GEN.18.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 18:15"
      },
      "items": [
        {
          "text": "Asi iye akati, \"Hongu, waseka.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.15",
            "verseOrgIds": [
              "GEN.18.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abhurahama anokumbirira Sodhomu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Varume vakati vasimuka kuti vaende, vakatarisa vakananga zasi kuSodhomu, uye Abhurahama akafamba navo achivaperekedza.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.16",
            "verseOrgIds": [
              "GEN.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Jehovha akati, \"Ko, ndichavanzira Abhurahama zvandiri kuda kuita here.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.17",
            "verseOrgIds": [
              "GEN.18.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvirokwazvo Abhurahama achava rudzi rukuru rune simba, uye ndudzi dzose dzapanyika dzicharopafadzwa kubudikidza naye.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.18",
            "verseOrgIds": [
              "GEN.18.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti ndakamusarudza kuti agotungamirira vana vake neveimba yake kuti vachengete nzira yaJehovha nokuita zvakanaka nezvakarurama, kuitira kuti Jehovha agouyisa pamusoro paAbhurahama zvaakamuvimbisa.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.19",
            "verseOrgIds": [
              "GEN.18.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Jehovha akati, \"Kuchema pamusoro peSodhomu neGomora kukuru kwazvo uye chivi chavo chaipisisa",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.20",
            "verseOrgIds": [
              "GEN.18.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "zvokuti ndichaburuka kuti ndinoona kana zvavakaita zvakanyanya kuipa sokuchema kwakasvika kwandiri. Kana zvisina kudaro, ndichazviziva.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.21",
            "verseOrgIds": [
              "GEN.18.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanhu vaya vakabvapo uye vakaenda vakananga kuSodhomu, asi Abhurahama akaramba amire pamberi paJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.22",
            "verseOrgIds": [
              "GEN.18.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Abhurahama akaswedera kwaari akati, \"Ko, muchaparadza vakarurama pamwe chete navakaipa here?",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.23",
            "verseOrgIds": [
              "GEN.18.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ko, kana muguta mune vanhu makumi mashanu vakarurama? Muchariparadza zvechokwadi here mukasasiya nzvimbo iyo nokuda kwavanhu makumi mashanu varimo?",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.24",
            "verseOrgIds": [
              "GEN.18.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvakadaro ngazvive kure nemi kuti muite chinhu chakadai, kuti muuraye vakarurama pamwe chete navatadzi, muchiitira vakarurama zvakafanana navatadzi. Zvakadaro ngazvive kure nemi! Ko, mutongi wenyika yose haangaiti zvakarurama here?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.25",
            "verseOrgIds": [
              "GEN.18.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha akati, \"Kana ndikawana vanhu vakarurama makumi mashanu vari muguta reSodhomu, ndichaponesa nzvimbo yose nokuda kwavo.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.26",
            "verseOrgIds": [
              "GEN.18.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Abhurahama akataurazve akati, \"Zvino zvandatanga kudai kuti nditaure kuna Ishe, kunyange hazvo ndisiri chinhu asi guruva namadota,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.27",
            "verseOrgIds": [
              "GEN.18.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "ko, kana kukashayikwa vashanu kune vakarurama vana makumi mashanu? Muchaparadza guta rose nokuda kwavashanu ava here?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.28",
            "verseOrgIds": [
              "GEN.18.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 18:28"
      },
      "items": [
        {
          "text": "Akati, \"Kana ndikawana makumi mana navashanu imomo, handingariparadzi.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.28",
            "verseOrgIds": [
              "GEN.18.28"
            ]
          }
        }
      ]
