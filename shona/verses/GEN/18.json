              "type": "text"
            }
          ]
        },
        {
          "text": "Abhurahama akati, \"Zvino zvandatsunga hangu kudai kuti nditaure kuna Ishe, ko, kana makumi maviri akawanikwamo?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.31",
