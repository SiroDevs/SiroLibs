        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abhurama naRoti vanoparadzana",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Abhurama akakwidza achibva kuIjipiti akaenda kuNegevhi, nomukadzi wake uye nezvinhu zvose zvaakanga anazvo, uye Roti akaenda naye.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.1",
            "verseOrgIds": [
              "GEN.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhurama akanga apfuma kwazvo pamombe nesirivha uye negoridhe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.2",
            "verseOrgIds": [
              "GEN.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubva kuNegevhi akafamba nzvimbo nenzvimbo kudzamara asvika kuBheteri, kunzvimbo iri pakati peBheteri neAi kwaimbova netende rake kare",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.3",
            "verseOrgIds": [
              "GEN.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye kwaakanga atanga kuvaka aritari. Abhurama akadana kuzita raJehovha ikoko.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.4",
            "verseOrgIds": [
              "GEN.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino Roti, uyo akanga achifamba naAbhurama, akanga ana makwai nemombewo namatende.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.5",
            "verseOrgIds": [
              "GEN.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi nyika haina kugona kuvaringana kuti vagare pamwe chete, nokuti pfuma yavo yakanga yakawanda kwazvo zvokuti vakanga vasisakwanisi kugara pamwe chete.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.6",
            "verseOrgIds": [
              "GEN.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye gakava rakamuka pakati pavafudzi vaAbhurama navafudzi vaRoti. VaKenani navaPerizi vakanga vachigarawo munyika panguva iyoyo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.7",
            "verseOrgIds": [
              "GEN.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Abhurama akati kuna Roti, \"Ngaparege kuva negakava pakati pako neni, kana pakati pavafudzi vako nevangu, nokuti tiri hama.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.8",
            "verseOrgIds": [
              "GEN.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ko, nyika yose iyi haisi pamberi pako here? Ngatiparadzane. Kana ukaenda kuruboshwe, ini ndichaenda kurudyi; kana ukaenda kurudyi, ini ndichaenda kuruboshwe.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.9",
            "verseOrgIds": [
              "GEN.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Roti akatarira kumusoro akaona bani rose reJorodhani kuti rakanga rakanyatsonyorova, sebindu raJehovha, kufanana nenyika yeIjipiti, kwakanangana neZoari. (Panguva iyi Jehovha akanga achigere kuparadza Sodhomu neGomora.)",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.10",
            "verseOrgIds": [
              "GEN.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Roti akazvisarudzira bani rose reJorodhani uye akasimuka akananga kumabvazuva. Varume vaviri ava vakaparadzana:",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.11",
            "verseOrgIds": [
              "GEN.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhurama akagara munyika yeKenani, Roti akagara pakati pamaguta omumapani uye akadzika matende ake pedyo neSodhomu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.12",
            "verseOrgIds": [
              "GEN.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino varume veSodhomu vakanga vakaipa uye vaitadzira Jehovha kwazvo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.13",
            "verseOrgIds": [
              "GEN.13.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha akati kuna Abhurama shure kwokubva kwaRoti, \"Simudza meso ako uri pauri ipapo uye utarire kumusoro nezasi, kumabvazuva nokumavirira.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.14",
            "verseOrgIds": [
              "GEN.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyika yose yauri kuona ndichakupa iwe navana vako nokusingaperi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.15",
            "verseOrgIds": [
              "GEN.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndichaita kuti vana vako vave seguruva renyika, zvokuti kana pano munhu angagona kuverenga guruva, naizvozvo vana vako vachagona kuverengwawo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.16",
            "verseOrgIds": [
              "GEN.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enda, famba munyika, muurefu nomuupamhi hwayo, nokuti ndichaipa kwauri.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.17",
            "verseOrgIds": [
              "GEN.13.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Abhurama akabvisa matende ake uye akandogara pedyo nemiti mikuru yeMamure paHebhuroni, uye akavakira Jehovha aritari ipapo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.18",
            "verseOrgIds": [
              "GEN.13.18"
            ]
          }
        }
      ]
    }
  ],
