  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "20",
        "style": "c",
        "sid": "GEN 20"
      },
      "items": [
        {
          "text": "20",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abhurahama naAbhimereki",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino Abhurahama akabvapo akapinda mudunhu rokuNegevhi akandogara pakati peKadheshi neShuri. Akagara muGerari kwechinguva,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.1",
            "verseOrgIds": [
              "GEN.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye ikoko Abhurahama akati nezvomukadzi wake Sara, \"Ihanzvadzi yangu.\" Ipapo Abhimereki mambo weGerari akatuma vanhu kuti vandotora Sara.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.2",
            "verseOrgIds": [
              "GEN.20.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi Mwari akauya kuna Abhimereki usiku mukurota uye akati kwaari, \"Wakangoita somunhu akafa nokuda kwomukadzi wawatora; mukadzi womunhu.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.3",
            "verseOrgIds": [
              "GEN.20.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino Abhimereki akanga asati aswedera kwaari, saka akati, \"Ishe, muchaparadza rudzi rusina mhosva here?",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.4",
            "verseOrgIds": [
              "GEN.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ko, iye haana kuti kwandiri, 'Ihanzvadzi yangu' here, naiyewo mukadzi haana kuti kwandiri 'Ihanzvadzi yangu' here? Ndakaita izvi nehana yakachena uye namaoko akachena.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.5",
            "verseOrgIds": [
              "GEN.20.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Mwari akati kwaari mukurota, \"Hongu, ndinozviziva kuti wakaita izvi nehana yakachena, nokudaro ndakukonesa kuti unditadzire. Ndokusaka ndisina kukutendera kuti umubate.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.6",
            "verseOrgIds": [
              "GEN.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino chidzosera mukadzi womurume uyu, nokuti muprofita, uye achakunyengeterera urarame. Asi kana usina kumudzosa, uzive kuti iwe navose vari vako muchafa.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.7",
            "verseOrgIds": [
              "GEN.20.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mangwanani akatevera Abhimereki akadana varanda vake vose, uye paakavaudza zvose zvakanga zvaitika, vakatya kwazvo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.8",
            "verseOrgIds": [
              "GEN.20.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Abhimereki akadana Abhurahama kuti apinde akati, \"Waiteiko kwatiri? Ndakakutadzira zvakaita seiko zvawauyisa mhosva huru yakadai pamusoro pangu napamusoro poumambo hwangu? Wandiitira zvinhu zvisingafaniri kuitwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.9",
            "verseOrgIds": [
              "GEN.20.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye Abhimereki akabvunza Abhurahama akati, \"Wakaoneiko chakaita kuti uite izvi?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.10",
            "verseOrgIds": [
              "GEN.20.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhurahama akapindura akati, \"Ndakati mumwoyo mangu, 'Zvirokwazvo munzvimbo ino hamuna kutya Mwari, uye vachandiuraya nokuda kwomukadzi wangu.'",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.11",
            "verseOrgIds": [
              "GEN.20.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvisinei hazvo, zvirokwazvo ihanzvadzi yangu, mwanasikana wababa vangu kunyange hazvo asina kuberekwa namai vangu; uye akazova hake mukadzi wangu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.12",
            "verseOrgIds": [
              "GEN.20.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye Mwari paakandiita kuti ndifambe kubva paimba yababa vangu, ndakati kwaari, 'Izvi ndizvo zvaungandiratidza nazvo madiro aunondiita: Kwose kwatinoenda, utaure pamusoro pangu uchiti, \"Ihanzvadzi yangu.\" ' \"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.13",
            "verseOrgIds": [
              "GEN.20.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Abhimereki akauya namakwai nemombe uye navarandarume navarandakadzi akavapa kuna Abhurahama, uye akadzosa Sara mukadzi wake.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.14",
            "verseOrgIds": [
              "GEN.20.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye Abhimereki akati, \"Nyika yangu iri pamberi pako; gara paunoda.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.15",
            "verseOrgIds": [
              "GEN.20.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuna Sara akati, \"Ndiri kupa hanzvadzi yako mashekeri chiuru",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.16",
            "verseOrgIds": [
              "GEN.20.16"
            ]
          }
        },
        {
          "text": "esirivha. Ichi ndicho chichava chifukidzo pamusoro pemhosva yandakaita kwauri pamberi pavose vaunavo; waruramiswa kwazvo.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.16",
            "verseOrgIds": [
              "GEN.20.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Abhurahama akanyengetera kuna Mwari, uye Mwari akaporesa Abhimereki, mukadzi wake uye navarandakadzi vake kuti vakwanise kuita vana zvakare,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.17",
            "verseOrgIds": [
              "GEN.20.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "nokuti Jehovha akanga azarira zvizvaro zvavo zvose muimba yaAbhimereki nokuda kwaSara mukadzi waAbhurahama.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.18",
            "verseOrgIds": [
              "GEN.20.18"
            ]
          }
        }
      ]
    }
  ],
