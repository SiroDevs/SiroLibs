          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musadaro, musava vasakarurama;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.29",
            "verseOrgIds": [
              "JOB.6.29"
            ]
