      "attrs": {
        "style": "q2",
        "vid": "JOB 6:26"
      },
      "items": [
        {
          "text": "nokutora mashoko omunhu arasa tariro semhepo here?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.26",
            "verseOrgIds": [
              "JOB.6.26"
            ]
          }
