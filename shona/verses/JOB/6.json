          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino nemiwo maratidza kusabatsira;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.21",
            "verseOrgIds": [
              "JOB.6.21"
            ]
