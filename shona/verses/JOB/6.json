            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vafambi veTema vanotsvaka mvura,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.19",
            "verseOrgIds": [
              "JOB.6.19"
            ]
          }
        }
