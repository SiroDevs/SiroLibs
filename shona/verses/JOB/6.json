      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 6:20"
      },
      "items": [
        {
          "text": "vasvikapo, vachashaya zvokuita.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.20",
            "verseOrgIds": [
              "JOB.6.20"
            ]
          }
        }
      ]
