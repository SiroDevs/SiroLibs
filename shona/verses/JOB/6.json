      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 6:19"
      },
      "items": [
        {
          "text": "vashambadziri veShebha vanomirira netariro.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.19",
            "verseOrgIds": [
              "JOB.6.19"
            ]
