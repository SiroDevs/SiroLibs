      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 6:22"
      },
      "items": [
        {
          "text": "ndipei fufuro rinobva papfuma yenyu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.22",
            "verseOrgIds": [
              "JOB.6.22"
            ]
          }
        }
      ]
