      "attrs": {
        "style": "q2",
        "vid": "JOB 6:24"
      },
      "items": [
        {
          "text": "ndiratidzei pandakakanganisa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.24",
            "verseOrgIds": [
              "JOB.6.24"
            ]
