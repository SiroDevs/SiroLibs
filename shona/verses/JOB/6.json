      "attrs": {
        "style": "q2",
        "vid": "JOB 6:21"
      },
      "items": [
        {
          "text": "munoti mukaona chinhu chinotyisa mobva matya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.21",
            "verseOrgIds": [
              "JOB.6.21"
            ]
          }
