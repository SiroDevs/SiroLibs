      "attrs": {
        "style": "q2",
        "vid": "JOB 6:25"
      },
      "items": [
        {
          "text": "Asi gakava renyu rinoratidzeiko?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.25",
            "verseOrgIds": [
              "JOB.6.25"
            ]
