          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ko, ndakamboti, 'Ndipeiwo chipo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.6.22",
            "verseOrgIds": [
              "JOB.6.22"
            ]
          }
