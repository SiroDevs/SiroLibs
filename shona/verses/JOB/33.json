      "attrs": {
        "style": "q2",
        "vid": "JOB 33:32"
      },
      "items": [
        {
          "text": "taurisa, nokuti ndinoda kuti ururamisirwe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.32",
            "verseOrgIds": [
              "JOB.33.32"
            ]
          }
        }
