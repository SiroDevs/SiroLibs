          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munosunga tsoka dzangu nezvisungo;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.27",
            "verseOrgIds": [
              "JOB.13.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 13:27"
      },
      "items": [
        {
          "text": "munocherechedza nzira dzangu dzose nokuisa mutaro panotsika tsoka dzangu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.27",
            "verseOrgIds": [
              "JOB.13.27"
            ]
          }
        }
      ]
