          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOB 13:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti munonyora zvinhu zvinovava pamusoro pangu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.26",
            "verseOrgIds": [
              "JOB.13.26"
            ]
          }
        }
      ]
    },
