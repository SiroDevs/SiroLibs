      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOB 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Haiwa Mwari, nditsidzirei hangu zvinhu zviviri izvi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.20",
            "verseOrgIds": [
              "JOB.13.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 13:20"
      },
      "items": [
        {
          "text": "Uye ipapo handingavandi pamberi penyu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.20",
            "verseOrgIds": [
              "JOB.13.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOB 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bvisai ruoko rwenyu rwuve kure neni,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.21",
            "verseOrgIds": [
              "JOB.13.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 13:21"
      },
      "items": [
        {
          "text": "uye murege kundivhundutsa nokutyisa kwenyu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.21",
            "verseOrgIds": [
              "JOB.13.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOB 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo mukandidana ndichadavira.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.22",
            "verseOrgIds": [
              "JOB.13.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 13:22"
      },
      "items": [
        {
          "text": "Kana kuti murege nditaure, imi mugopindura.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.22",
            "verseOrgIds": [
              "JOB.13.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOB 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvivi zvandakaita nezvikanganiso zvangu zvinganiko?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.23",
            "verseOrgIds": [
              "JOB.13.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 13:23"
      },
      "items": [
        {
          "text": "Ndiratidzei kudarika kwangu nechivi changu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.23",
            "verseOrgIds": [
              "JOB.13.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOB 13:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munovanzireiko chiso chenyu",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.24",
            "verseOrgIds": [
              "JOB.13.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 13:24"
      },
      "items": [
        {
          "text": "muchindiona somuvengi wenyu?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.24",
            "verseOrgIds": [
              "JOB.13.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOB 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ko, muchatambudza shizha rinopeperetswa nemhepo here?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.25",
            "verseOrgIds": [
              "JOB.13.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 13:25"
      },
      "items": [
        {
          "text": "Ko, muchadzingana nehundi yakaoma here?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.25",
            "verseOrgIds": [
              "JOB.13.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
