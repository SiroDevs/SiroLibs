          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Saizvozvo munhu anopera kufanana nechinhu chakaora,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.13.28",
            "verseOrgIds": [
              "JOB.13.28"
            ]
