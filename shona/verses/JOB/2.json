  "verseCount": 13,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "JOB 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kuedzwa kwaJobho kweChipiri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rimwe zuvazve vatumwa vakauya kuzomira pamberi paJehovha, uye Satani akasvika pamwe chete navo kuti andomirawo pamberi pake.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.1",
            "verseOrgIds": [
              "JOB.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino Jehovha akati kuna Satani, \"Wabvepiko?\"",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.2",
            "verseOrgIds": [
              "JOB.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JOB 2:2"
      },
      "items": [
        {
          "text": "Satani akapindura Jehovha akati, \"Ndabva pakupota-pota nenyika napakukwidza nokudzika mairi.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.2",
            "verseOrgIds": [
              "JOB.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Jehovha akati kuna Satani, \"Warangarira here muranda wangu Jobho? Hakuna munhu akafanana naye panyika, haana chaanopomerwa uye akarurama, munhu anotya Mwari uye anonzvenga chakaipa. Uye anoramba amire pakururama kwake, kunyange iwe wakandikurudzira pamusoro pake kuti ndimuparadze pasina chikonzero.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.3",
            "verseOrgIds": [
              "JOB.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Satani akapindura achiti, \"Ganda neganda! Munhu achapa zvose zvaanazvo nokuda kwoupenyu hwake.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.4",
            "verseOrgIds": [
              "JOB.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi tambanudzai ruoko murove muviri wake namapfupa ake, uye zvirokwazvo achakutukai pachena.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.5",
            "verseOrgIds": [
              "JOB.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha akati kuna Satani, \"Saka zvakanaka, ari mumaoko ako, asi haufaniri kubata upenyu hwake.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.6",
            "verseOrgIds": [
              "JOB.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Satani akabva pamberi paJehovha akandorova Jobho namaronda anorwadza kubva pasi petsoka dzake kusvikira panhongonya yomusoro wake.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.7",
            "verseOrgIds": [
              "JOB.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Jobho akatora chaenga akazvikwenya nacho paakanga agere pakati pamadota.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.8",
            "verseOrgIds": [
              "JOB.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukadzi wake akati, \"Ucharambira pakururama kwako kusvikira riniko? Tuka Mwari ufe!\"",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.9",
            "verseOrgIds": [
              "JOB.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye akapindura akati, \"Iwe unotaura somukadzi benzi. Ko, tichagamuchira zvakanaka kubva kuna Mwari, tikashayiwa zvakaipa here?\"",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.10",
            "verseOrgIds": [
              "JOB.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JOB 2:10"
      },
      "items": [
        {
          "text": "Muzvinhu izvi zvose, Jobho haana kutadza pane zvaakataura.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.10",
            "verseOrgIds": [
              "JOB.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Shamwari Nhatu dzaJobho",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shamwari nhatu dzaJobho, Erifazi muTemani, Bhiridhadhi muShuhi naZofari muNamati dzakati dzanzwa pamusoro pokutambudzika kwakanga kwawira pamusoro pake, vakabva kumisha yavo vakaungana pamwe chete vatenderana kuti vaende kundomudemba uye vamunyaradze.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.11",
            "verseOrgIds": [
              "JOB.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakati vamuona ari chinhambwe, havana kugona kumuziva, vakatanga kuchema zvikuru, uye vakabvarura nguo dzavo uye vakazvimwaya guruva pamisoro yavo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.12",
            "verseOrgIds": [
              "JOB.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo vakagara pasi naye kwamazuva manomwe nousiku hunomwe. Hakuna munhu akagona kutaura kana shoko kwaari, nokuti vakaona kukura kwokutambudzika kwake.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.13",
            "verseOrgIds": [
              "JOB.2.13"
            ]
          }
        }
      ]
    }
  ],
