        "style": "c",
        "sid": "JOB 23"
      },
      "items": [
        {
          "text": "23",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "Jobho",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Jobho akapindura akati:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.1",
            "verseOrgIds": [
              "JOB.23.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kunyange nanhasi ndinonyunyuta ndine shungu;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.2",
            "verseOrgIds": [
              "JOB.23.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 23:2"
      },
      "items": [
        {
          "text": "ruoko rwake runondiremera kunyange ndiri pakugomera kwangu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.2",
            "verseOrgIds": [
              "JOB.23.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dai chete ndaiziva kwandingamuwana;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.3",
            "verseOrgIds": [
              "JOB.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 23:3"
      },
      "items": [
        {
          "text": "dai chete ndaigona kuenda kwaanogara!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.3",
            "verseOrgIds": [
              "JOB.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndaitaura hangu mhaka yangu pamberi pake,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.4",
            "verseOrgIds": [
              "JOB.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 23:4"
      },
      "items": [
        {
          "text": "uye ndaizadza muromo wangu nenharo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.4",
            "verseOrgIds": [
              "JOB.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndaizoziva hangu zvaaizondipindura,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.5",
            "verseOrgIds": [
              "JOB.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 23:5"
      },
      "items": [
        {
          "text": "uye ndaizocherechedza zvaaizoreva.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.5",
            "verseOrgIds": [
              "JOB.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuti aizondidzivisa nesimba guru here?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.6",
            "verseOrgIds": [
              "JOB.23.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 23:6"
      },
      "items": [
        {
          "text": "Kwete, haaizondipomera mhaka.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.6",
            "verseOrgIds": [
              "JOB.23.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo munhu akarurama aigona kuzotaura mhaka yake pamberi pake,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.7",
            "verseOrgIds": [
              "JOB.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 23:7"
      },
      "items": [
        {
          "text": "uye ndaizosunungurwa kubva pamutongi wangu nokusingaperi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.7",
            "verseOrgIds": [
              "JOB.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Asi kana ndikaenda kumabvazuva, iye haako;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.8",
            "verseOrgIds": [
              "JOB.23.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 23:8"
      },
      "items": [
        {
          "text": "kana ndikaenda kumavirira, handimuwani.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.8",
            "verseOrgIds": [
              "JOB.23.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paanenge ari pabasa nechokumusoro, handimuoni;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.9",
            "verseOrgIds": [
              "JOB.23.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 23:9"
      },
      "items": [
        {
          "text": "paanotsaukira zasi, handikwanisi kumuona.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.9",
            "verseOrgIds": [
              "JOB.23.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi iye anoziva nzira yandinofamba nayo;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.10",
            "verseOrgIds": [
              "JOB.23.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 23:10"
      },
      "items": [
        {
          "text": "kana apedza kundiedza, ndichabuda ndava segoridhe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.10",
            "verseOrgIds": [
              "JOB.23.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsoka dzangu dzakanyatsotevera paakatsika;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.11",
            "verseOrgIds": [
              "JOB.23.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 23:11"
      },
      "items": [
        {
          "text": "ndakarambira panzira dzake ndisingambotsaukiri parutivi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.11",
            "verseOrgIds": [
              "JOB.23.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Handina kumbobva pamirayiro yemiromo yake;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.12",
            "verseOrgIds": [
              "JOB.23.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 23:12"
      },
      "items": [
        {
          "text": "ndakakoshesa mashoko omuromo wake kupfuura chingwa changu chamazuva ose.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.12",
            "verseOrgIds": [
              "JOB.23.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Asi iye anomira oga, uye ndiani angapikisana naye?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.13",
            "verseOrgIds": [
              "JOB.23.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 23:13"
      },
      "items": [
        {
          "text": "Anoita zvaanoda.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.13",
            "verseOrgIds": [
              "JOB.23.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anoita zvaakatema pamusoro pangu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.14",
            "verseOrgIds": [
              "JOB.23.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 23:14"
      },
      "items": [
        {
          "text": "uye urongwa huzhinji hwakadai achinahwo mudura rake.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.14",
            "verseOrgIds": [
              "JOB.23.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndokusaka ndichitya pamberi pake;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.15",
            "verseOrgIds": [
              "JOB.23.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 23:15"
      },
      "items": [
        {
          "text": "pandinofunga nezvose izvi, ndomutya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.15",
            "verseOrgIds": [
              "JOB.23.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwari akaita kuti mwoyo wangu unete;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.16",
            "verseOrgIds": [
              "JOB.23.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 23:16"
      },
      "items": [
        {
          "text": "Wamasimba Ose akandivhundutsa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.16",
            "verseOrgIds": [
              "JOB.23.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunyange zvakadaro rima harina kuita kuti ndinyarare,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.17",
            "verseOrgIds": [
              "JOB.23.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 23:17"
      },
      "items": [
        {
          "text": "iro rima guru rinofukidza chiso changu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.17",
            "verseOrgIds": [
              "JOB.23.17"
            ]
          }
        }
      ]
    }
  ],
