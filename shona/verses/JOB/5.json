  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "JOB 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Chidana zvino kana uchida, asi ndianiko achadavira?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.1",
            "verseOrgIds": [
              "JOB.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:1"
      },
      "items": [
        {
          "text": "Uchadzokera kuno upiko wavatsvene?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.1",
            "verseOrgIds": [
              "JOB.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutsamwa kunouraya benzi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.2",
            "verseOrgIds": [
              "JOB.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:2"
      },
      "items": [
        {
          "text": "uye godo rinouraya asina mano.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.2",
            "verseOrgIds": [
              "JOB.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ini pachangu ndakaona benzi richidzika midzi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.3",
            "verseOrgIds": [
              "JOB.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:3"
      },
      "items": [
        {
          "text": "asi pakarepo imba yake yakatukwa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.3",
            "verseOrgIds": [
              "JOB.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vana vake havana kuchengetedzeka,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.4",
            "verseOrgIds": [
              "JOB.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:4"
      },
      "items": [
        {
          "text": "vanopwanyiwa padare vasina anovarwira.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.4",
            "verseOrgIds": [
              "JOB.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vane nzara vanodya zvaakacheka,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.5",
            "verseOrgIds": [
              "JOB.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:5"
      },
      "items": [
        {
          "text": "vachizvitora kunyange pakati peminzwa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.5",
            "verseOrgIds": [
              "JOB.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:5"
      },
      "items": [
        {
          "text": "uye vane nyota vanodokwairira pfuma yake.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.5",
            "verseOrgIds": [
              "JOB.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti kutambudzika hakubudi muvhu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.6",
            "verseOrgIds": [
              "JOB.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:6"
      },
      "items": [
        {
          "text": "uye nhamo haimeri muvhu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.6",
            "verseOrgIds": [
              "JOB.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi munhu anoberekerwa nhamo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.7",
            "verseOrgIds": [
              "JOB.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:7"
      },
      "items": [
        {
          "text": "zvirokwazvo sokubarika kwomoto kunokwira kumusoro.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.7",
            "verseOrgIds": [
              "JOB.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Asi dai ndakanga ndirini, ndaiturira mhosva yangu kuna Mwari;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.8",
            "verseOrgIds": [
              "JOB.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:8"
      },
      "items": [
        {
          "text": "ndaiisa mhaka yangu pamberi pake.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.8",
            "verseOrgIds": [
              "JOB.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anoita minana isingagoni kuyerwa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.9",
            "verseOrgIds": [
              "JOB.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:9"
      },
      "items": [
        {
          "text": "zvishamiso zvisingagoni kuverengwa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.9",
            "verseOrgIds": [
              "JOB.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anopa mvura panyika;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.10",
            "verseOrgIds": [
              "JOB.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:10"
      },
      "items": [
        {
          "text": "anotuma mvura pamusoro penyika.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.10",
            "verseOrgIds": [
              "JOB.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanozvininipisa anovaisa pakakwirira,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.11",
            "verseOrgIds": [
              "JOB.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:11"
      },
      "items": [
        {
          "text": "uye vaya vanochema vanosimudzirwa kuchinzvimbo chokuchengetedzwa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.11",
            "verseOrgIds": [
              "JOB.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anokonesa zvirongwa zvavanyengeri,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.12",
            "verseOrgIds": [
              "JOB.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:12"
      },
      "items": [
        {
          "text": "kuitira kuti maoko avo abate pasina.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.12",
            "verseOrgIds": [
              "JOB.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anobata vakachenjera muunyengeri hwavo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.13",
            "verseOrgIds": [
              "JOB.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:13"
      },
      "items": [
        {
          "text": "uye zvirongwa zvenhubu zvinokukurwa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.13",
            "verseOrgIds": [
              "JOB.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rima rinosvika pamusoro pavo masikati;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.14",
            "verseOrgIds": [
              "JOB.5.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:14"
      },
      "items": [
        {
          "text": "vanotsvanzvadzira masikati makuru sapausiku.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.14",
            "verseOrgIds": [
              "JOB.5.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anoponesa vanoshayiwa kubva pamunondo uri pamiromo yavo;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.15",
            "verseOrgIds": [
              "JOB.5.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:15"
      },
      "items": [
        {
          "text": "anovaponesa pakudzvinya kwavane simba.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.15",
            "verseOrgIds": [
              "JOB.5.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka varombo vane tariro,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.16",
            "verseOrgIds": [
              "JOB.5.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:16"
      },
      "items": [
        {
          "text": "uye kusaruramisira kunopfumbira muromo wako.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.16",
            "verseOrgIds": [
              "JOB.5.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Akaropafadzwa munhu anogadziridzwa zvaari naMwari;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.17",
            "verseOrgIds": [
              "JOB.5.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:17"
      },
      "items": [
        {
          "text": "saka usazvidza kuranga kwoWamasimba Ose.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.17",
            "verseOrgIds": [
              "JOB.5.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti anopa vanga, asi achisungazve;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.18",
            "verseOrgIds": [
              "JOB.5.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:18"
      },
      "items": [
        {
          "text": "anokuvadza, asi maoko ake anorapazve.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.18",
            "verseOrgIds": [
              "JOB.5.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achakurwira kubva panjodzi nhanhatu;",
