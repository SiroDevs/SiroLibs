{
  "id": "1SA.4",
  "number": "4",
  "bookId": "1SA",
  "reference": "1 Samueri 4",
  "copyright": "Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi™ Kopakodzero © 2005, 2018 ne Biblica, Inc. Biblica® Open Shona Contemporary Bible™ Copyright © 2005, 2018 by Biblica, Inc.",
  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "1SA 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye shoko raSamueri rakasvika kuIsraeri yose.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.1",
            "verseOrgIds": [
              "1SA.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1",
        "vid": "1SA 4:1"
      },
      "items": [
        {
          "text": "VaFiristia vanopamba Areka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 4:1"
      },
      "items": [
        {
          "text": "Zvino vaIsraeri vakaenda kundorwa navaFiristia. VaIsraeri vakaungana paEbhenezeri, vaFiristia vakavaka misasa yavo paAfeki.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.1",
            "verseOrgIds": [
              "1SA.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "VaFiristia vakagadzirira varwi vavo kuti vandosangana neIsraeri, uye hondo payakanga yava kupararira, Israeri yakakundwa navaFiristia avo vakauraya varume zviuru zvina zvavo pavairwira.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.2",
            "verseOrgIds": [
              "1SA.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Varwi pavakadzoka kumusasa, vakuru veIsraeri vakabvunza vakati, \"Sei Jehovha aita kuti tikundwe nhasi pamberi pavaFiristia? Ngatitorei areka yesungano yaJehovha kubva kuShiro, kuti igoenda nesu uye igotiponesa kubva muruoko rwavavengi vedu.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.3",
            "verseOrgIds": [
              "1SA.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo vanhu vakatuma varume kuShiro, uye vakadzosa areka yaJehovha Wamasimba Ose uye agere pachigaro choushe pakati pamakerubhi. Zvino vanakomana vaviri vaEri, Hofini naFinehasi, vaivapo neareka yesungano yaMwari.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.4",
            "verseOrgIds": [
              "1SA.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Areka yesungano yaJehovha payakauya mumusasa, Israeri yose yakapururudza uye vakaita ruzha rukuru zvokuti pasi pakatinhira.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.5",
            "verseOrgIds": [
              "1SA.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pavakanzwa mheremhere, vaFiristia vakabvunza vakati, \"Mheremhere iri mumusasa wavaHebheru ndeyei?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.6",
            "verseOrgIds": [
              "1SA.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 4:6"
      },
      "items": [
        {
          "text": "Vakati vazvinzwa kuti areka yaJehovha yakanga yauya mumusasa,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.6",
            "verseOrgIds": [
              "1SA.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "vaFiristia vakatya. Vakati, \"Mwari asvika mumusasa. Tava munhamo! Hapana chinhu chakadai seichi chati chamboitika.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.7",
            "verseOrgIds": [
              "1SA.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tine nhamo! Ndianiko achatirwira pamaoko avamwari ava vane simba? Ndivo vamwari vakarova vaIjipita namarudzi ose amatambudziko mugwenga.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.8",
            "verseOrgIds": [
              "1SA.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simbai vaFiristia! Ivai varume, mukasadaro muchava varanda vavaHebheru sezvavakanga vakaita kwamuri. Ivai varume, murwe!\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.9",
            "verseOrgIds": [
              "1SA.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka vaFiristia vakarwa, vaIsraeri vakakundwa uye munhu wose akatiza achidzokera kutende rake. Pakava nokuurayiwa kukuru; Israeri yakarasikirwa navarwi vetsoka zviuru makumi matatu.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.10",
            "verseOrgIds": [
              "1SA.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Areka yaJehovha yakapambwa uye vanakomana vaviri vaEri, Hofini naFinehasi, vakafa.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.11",
            "verseOrgIds": [
              "1SA.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kufa kwaEri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zuva rimwe chetero, mumwe murume weBhenjamini akamhanya achibva kuhondo akaenda kuShiro, nguo dzake dzakabvaruka uye ane guruva pamusoro wake.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.12",
            "verseOrgIds": [
              "1SA.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paakasvikako, Eri akanga akagara pachigaro chake parutivi rwenzira, akangotarisa, nokuti mwoyo wake waityira areka yaJehovha. Murume uyu paakapinda muguta akataura zvakanga zvaitika, guta rose rakachema.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.13",
            "verseOrgIds": [
              "1SA.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri akanzwa kuchema akandobvunza achiti, \"Mheremhere iyi yose ndeyeiko?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.14",
            "verseOrgIds": [
              "1SA.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 4:14"
      },
      "items": [
        {
          "text": "Murume uyu akachimbidza kuenda kuna Eri,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.14",
            "verseOrgIds": [
              "1SA.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "akanga ava namakore makumi mapfumbamwe namasere okuberekwa uye meso ava norutara zvokuti akanga asisaoni.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.15",
            "verseOrgIds": [
              "1SA.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati kuna Eri, \"Ndiri kubva kuhondo izvozvi; ndatotizako nhasi chaiye.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.16",
            "verseOrgIds": [
              "1SA.4.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 4:16"
      },
      "items": [
        {
          "text": "Eri akabvunza akati, \"Chiiko chaitika mwanakomana wangu?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.16",
            "verseOrgIds": [
              "1SA.4.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Murume akauya neshoko akapindura achiti, \"Israeri yatiza vaFiristia, uye hondo yarasikirwa zvikuru. Uyewo vanakomana venyu vaviri Hofini naFinehasi vafa, uye areka yaMwari yapambwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.17",
            "verseOrgIds": [
              "1SA.4.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paakataura nezveareka yaMwari, Eri akawa negotsi kubva pachigaro chake parutivi rwesuo. Mutsipa wake wakatyoka akabva afa nokuti aiva murume akanga akwegura uye ari mukobvu. Akanga atungamirira Israeri kwamakore makumi mana.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.18",
            "verseOrgIds": [
              "1SA.4.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muroora wake, mukadzi waFinehasi, akanga ane pamuviri ava pedyo nokuda kubatsirwa. Paakanzwa nhau idzi dzokuti areka yaJehovha yakanga yapambwa uye kuti vatezvara vake nomurume wake vakanga vafa, akarwadziwa napamuviri akabereka mwana, asi akakurirwa namarwadzo ake pakusununguka.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.19",
            "verseOrgIds": [
              "1SA.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paakanga ava kufa madzimai aimubatsira akati, \"Usaora mwoyo wabatsirwa nomwana mukomana.\" Asi haana kumbopindura kana kuzviteerera.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.20",
            "verseOrgIds": [
              "1SA.4.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akatumidza mukomana uyu kuti Ikabhodhi, achiti, \"Kubwinya kwabva muIsraeri,\" nokuda kwokutorwa kweareka yaMwari uye nokufa kwatezvara vake nomurume wake.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.21",
            "verseOrgIds": [
              "1SA.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati, \"Kubwinya kwabva muIsraeri, nokuti areka yaMwari yapambwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.22",
            "verseOrgIds": [
              "1SA.4.22"
            ]
          }
        }
      ]
    }
  ],
