  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "1SA 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka varume veKiriati Jearimi vakauya vakatora areka yaJehovha. Vakaiendesa kuimba yaAbhinadhabhi pachikomo uye vakatsaura Ereazari mwanakomana wake kuti achengete areka yaJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.1",
            "verseOrgIds": [
              "1SA.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Samueri anokurira vaFiristia paMizipa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Areka yakaramba iri paKiriati Jearimi kwenguva yakareba kwazvo, makore makumi maviri pamwe chete, uye vanhu vose veIsraeri vakachema uye vakatsvaka Jehovha.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.2",
            "verseOrgIds": [
              "1SA.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Samueri akati kuimba yeIsraeri, \"Kana muchidzokera kuna Jehovha nemwoyo yenyu yose, zvino chibvisai pakati penyu vamwari vavatorwa navaAshitoreti mugozvikumikidza kuna Jehovha uye mumushumire iye bedzi, uye achakudzikinurai kubva muruoko rwavaFiristia.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.3",
            "verseOrgIds": [
              "1SA.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka vaIsraeri vakarasa vose vaBhaari vavo navaAshitoreti, vakashumira Jehovha chete.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.4",
            "verseOrgIds": [
              "1SA.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Samueri akati, \"Unganidzai Israeri yose paMizipa uye ndichakukumbirirai kuna Jehovha.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.5",
            "verseOrgIds": [
              "1SA.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakati vaungana paMizipa, vakachera mvura vakaidururira pamberi paJehovha. Nomusi iwoyo vakatsanya ipapo vakareurura vachiti, \"Takatadzira Jehovha.\" Uye Samueri akava mutungamiri weIsraeri yose paMizipa.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.6",
            "verseOrgIds": [
              "1SA.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "VaFiristia vakati vanzwa kuti Israeri yakanga yaungana paMizipa, vatungamiri vavaFiristia vakauya kuzovarwisa. Zvino vaIsraeri vakati vazvinzwa, vakatya nokuda kwavaFiristia.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.7",
            "verseOrgIds": [
              "1SA.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakati kuna Samueri, \"Musarega henyu kuramba muchidanidzira kuna Jehovha Mwari nokuda kwedu, kuti atirwire pamaoko avaFiristia.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.8",
            "verseOrgIds": [
              "1SA.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Samueri akatora gwayana rainwa akaribayira sechipiriso chinopiswa kuna Jehovha. Akachema kuna Jehovha pamusoro peIsraeri, Jehovha akamupindura.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.9",
            "verseOrgIds": [
              "1SA.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samueri paakanga achibayira chipiriso chinopiswa, vaFiristia vakaswedera pedyo kuti varwise Israeri. Asi zuva iroro Jehovha akatinhira nokutinhira kukuru pamberi pavaFiristia akavavhundutsa zvokuti vakakundwa pamberi pavaIsraeri.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.10",
            "verseOrgIds": [
              "1SA.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Varume veIsraeri vakachimbidza kubuda muMizipa vakadzingirira vaFiristia, vakavauraya munzira kusvikira kunzvimbo iri zasi kweBhetikari.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.11",
            "verseOrgIds": [
              "1SA.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Samueri akatora dombo akarimisa pakati peMizipa neSheni. Akaritumidza kuti Ebhenezeri akati, \"Jehovha akatibatsira kusvikira pano.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.12",
            "verseOrgIds": [
              "1SA.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka vaFiristia vakakurirwa uye havana kuzorwisa nyika yavaIsraeri zvakare.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.13",
            "verseOrgIds": [
              "1SA.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 7:13"
      },
      "items": [
        {
          "text": "Uye ruoko rwaJehovha rwakarwa navaFiristia mazuva ose aSamueri.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.13",
            "verseOrgIds": [
              "1SA.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maguta anobva kuEkironi kusvikira kuGati akanga apambwa navaFiristia kubva kuIsraeri akadzorerwa kwairi, uye Israeri yakasunungura rimwe dunhu rayo kubva muruoko rwavaFiristia. Uye pakazova norunyararo pakati peIsraeri navaAmori.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.14",
            "verseOrgIds": [
              "1SA.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samueri akaramba ari mutongi weIsraeri kwoupenyu hwake hwose.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.15",
            "verseOrgIds": [
              "1SA.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gore negore aitenderera kubva kuBheteri achienda kuGirigari nokuMizipa, achitonga Israeri munzvimbo dzose idzodzo.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.16",
            "verseOrgIds": [
              "1SA.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi aipota achidzokera kuRama, kwaiva nomusha wake, uye ikokowo akatonga Israeri. Uye akavakira Jehovha aritari ikoko.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.17",
            "verseOrgIds": [
              "1SA.7.17"
            ]
          }
        }
      ]
    }
  ],
