  "verseCount": 58,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "17",
        "style": "c",
        "sid": "1SA 17"
      },
      "items": [
        {
          "text": "17",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Dhavhidhi naGoriati",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino vaFiristia vakakoka varwi vavo kuti vazorwa hondo ndokubva vaungana paSoko muJudha. Vakadzika musasa paEfesi Dhamimi, pakati peSoko neAzeka.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.1",
            "verseOrgIds": [
              "1SA.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sauro navaIsraeri vakaungana vakadzika musasa mumupata weEra, vakatara mutaro wokurwa pavaizosangana navaFiristia.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.2",
            "verseOrgIds": [
              "1SA.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "VaFiristia vakatora chimwe chikomo, vaIsraeri vakatora chimwe, pakati pavo paine mupata.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.3",
            "verseOrgIds": [
              "1SA.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shasha yainzi Goriati yaibva kuGati, yakabuda pakati pomusasa wavaFiristia. Akanga akareba makubhiti matanhatu",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.4",
            "verseOrgIds": [
              "1SA.17.4"
            ]
          }
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.4",
            "verseOrgIds": [
              "1SA.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akanga ane nguwani yendarira pamusoro wake uye akanga akafuka nguo dzokurwa dzamakwati endarira dzairema mashekeri zviuru zvishanu",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.5",
            "verseOrgIds": [
              "1SA.17.5"
            ]
          }
        },
        {
          "text": ";",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.5",
            "verseOrgIds": [
              "1SA.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "pamakumbo ake akanga akapfeka zvidzitiro zvendarira, uye pfumo rendarira rakanga rakarembedzwa kumusana kwake.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.6",
            "verseOrgIds": [
              "1SA.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rwiriko rwepfumo rake rwakanga rwakaita setsvimbo yomuruki, uye muromo waro wesimbi wakanga uchirema mashekeri mazana matanhatu",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.7",
            "verseOrgIds": [
              "1SA.17.7"
            ]
          }
        },
        {
          "text": ". Mutakuri wenhoo yake aifamba ari mberi kwake.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.7",
            "verseOrgIds": [
              "1SA.17.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Goriati akamira akadanidzira kuhondo dzavaIsraeri achiti, \"Seiko mabuda kuti muzogadzirira kurwa? Ko, ini handisi muFiristia, uye imi hamusi varanda vaSauro here? Sarudzai murume mugoita kuti aburuke kuno kwandiri.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.8",
            "verseOrgIds": [
              "1SA.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana achigona kurwa uye akandiuraya, isu tichava varanda venyu; asi kana ndikamukunda ndikamuuraya, imi muchava varanda vedu uye muchatishandira.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.9",
            "verseOrgIds": [
              "1SA.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo muFiristia akati, \"Nhasi ndiri kudenha hondo dzavaIsraeri! Ndipei murume kuti tirwe.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.10",
            "verseOrgIds": [
              "1SA.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sauro navaIsraeri vose vakati vachinzwa mashoko omuFiristia vakavhunduka uye vakatya.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.11",
            "verseOrgIds": [
              "1SA.17.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino Dhavhidhi akanga ari mwanakomana womuEfurata ainzi Jese, uyo akanga achibva kuBheterehema reJudha. Jese akanga ana vanakomana vasere, uye pamazuva aSauro akanga ava mutana, akwegura, ava namakore mazhinji.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.12",
            "verseOrgIds": [
              "1SA.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanakomana vaJese vakuru vatatu vakanga vatevera Sauro kuhondo: Wokutanga akanga ari Eriabhi; wechipiri, Abhinadhabhi; uye wechitatu, Shama.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.13",
            "verseOrgIds": [
              "1SA.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi ndiye akanga ari muduku kuna vose. Vakuru vatatu ava vakatevera Sauro,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.14",
            "verseOrgIds": [
              "1SA.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi Dhavhidhi aimbobva kuna Sauro achidzokera kundofudza makwai ababa vake kuBheterehema.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.15",
            "verseOrgIds": [
              "1SA.17.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwamazuva makumi mana, muFiristia akauya pamberi mangwanani oga oga namadekwana akamira.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.16",
            "verseOrgIds": [
              "1SA.17.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino Jese akati kuna Dhavhidhi mwanakomana wake, \"Chitora efa",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.17",
            "verseOrgIds": [
              "1SA.17.17"
            ]
          }
        },
        {
          "text": "iyi yezviyo zvakakangwa nezvingwa izvi gumi ukurumidze kundopa madzikoma ako kumusasa wavo.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.17",
            "verseOrgIds": [
              "1SA.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uendewo nezvidimbu izvi zvechizi kumukuru wechiuru. Uone kuti madzikoma ako akadini ugouya neshoko rinobva kwavari.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.18",
            "verseOrgIds": [
              "1SA.17.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vari pamwe chete naSauro navarume vose veIsraeri muMupata weEra kwavari kurwa navaFiristia.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.19",
            "verseOrgIds": [
              "1SA.17.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 17:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mangwanani-ngwanani, Dhavhidhi akasiya boka ramakwai rino mufudzi, akarongedza akaenda, sezvaakanga arayirwa naJese. Akasvika pamusasa varwi pavakanga vobuda kuti vaende kunzvimbo dzavo dzokurwira, vachiita ruzha rwehondo,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.20",
            "verseOrgIds": [
              "1SA.17.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 17:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "VaIsraeri navaFiristia vakanga vakamira pamitsetse yavo vakatarisana.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.21",
            "verseOrgIds": [
              "1SA.17.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 17:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi akasiya zvinhu zvake zvino mutariri wenhumbi, akamhanyira kwakanga kwakamira varwi, akakwazisa madzikoma ake.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.22",
            "verseOrgIds": [
              "1SA.17.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 17:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paakanga achitaura navo, Goriati, muFiristia, shasha yaibva kuGati, akabuda kubva kumitsetse yokwake akadanidzira achimhura sezvaaisiita, uye Dhavhidhi akazvinzwa.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.23",
            "verseOrgIds": [
              "1SA.17.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1SA 17:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "VaIsraeri vakati vachiona murume uyu, vose vakamutiza vachitya zvikuru.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.24",
            "verseOrgIds": [
              "1SA.17.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1SA 17:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino vaIsraeri vakanga vachiti, \"Muri kuona here murume uyu ari kuramba achibuda? Ari kubuda kunze kuzoshora vaIsraeri. Mambo achapa pfuma zhinji kumunhu anomuuraya. Achamupawo mwanasikana wake kuti ave mukadzi wake, uye achasunungura mhuri yababa vake kuti irege kuzobvisa mutero muIsraeri.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.25",
            "verseOrgIds": [
              "1SA.17.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1SA 17:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi akabvunza varume vakanga vamire naye akati, \"Munhu achauraya muFiristia uyu agobvisa chinyadziso ichi pavaIsraeri achaitirwei? Ndianiko muFiristia uyu asina kudzingiswa anoshora hondo dzaMwari mupenyu?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.26",
            "verseOrgIds": [
              "1SA.17.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1SA 17:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakadzokorora kwaari zviya zvavakanga vachitaura vakati kwaari, \"Ndizvo zvichaitirwa munhu anomuuraya.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.27",
            "verseOrgIds": [
              "1SA.17.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1SA 17:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eriabhi, mukoma mukuru waDhavhidhi, akati achimunzwa achitaura navarume vaya, akamutsamwira zvikuru, akamubvunza akati, \"Seiko iwe waburuka ukauya kuno? Ko, makwai mashoma aya waasiya naani kurenje? Ndinoziva manyawi ako nokuipa kwomwoyo wako; waburuka kuno kuti uzoona hondo chete.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.28",
            "verseOrgIds": [
              "1SA.17.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1SA 17:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi akati, \"Ko, zvino ndaita sei hangu? Ko, handingatongotauriwo here?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.29",
            "verseOrgIds": [
              "1SA.17.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1SA 17:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akatendeukira kuno mumwezve akamubvunza shoko rimwe chetero, vanhu vakamupindurazve saizvozvo.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.30",
            "verseOrgIds": [
              "1SA.17.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1SA 17:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvakataurwa naDhavhidhi zvakanzwikwa uye runyerekupe rukaziviswa kuna Sauro, uye Sauro akatuma munhu kundomudana.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.31",
            "verseOrgIds": [
              "1SA.17.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1SA 17:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi akati kuna Sauro, \"Ngaparege kuva nomunhu anoora mwoyo nokuda kwomuFiristia uyu; muranda wenyu achaenda kundorwa naye.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.32",
            "verseOrgIds": [
              "1SA.17.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1SA 17:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sauro akamupindura akati, \"Haungagoni kuenda kundorwa nomuFiristia uyu; iwe uchingori mukomana zvako, uye iye akagara ari munhu wokurwa kubva paujaya hwake.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.33",
            "verseOrgIds": [
              "1SA.17.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1SA 17:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi Dhavhidhi akati kuna Sauro, \"Muranda wenyu akanga achifudza makwai ababa vake. Shumba kana bere zvaiti zvikauya, zvikatakura gwai kubva paboka ramakwai,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.34",
            "verseOrgIds": [
              "1SA.17.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1SA 17:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndaitevera, ndigoiuraya ndigoponesa gwai kubva pamuromo wayo. Yakati ichitendeukira kwandiri, ndakaibata nemvere dzayo, ndikaibaya ndikaiuraya.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.35",
            "verseOrgIds": [
              "1SA.17.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1SA 17:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muranda wenyu akauraya zvose shumba nebere; muFiristia uyu asina kudzingiswa achafanana nechimwe chazvo, nokuti ashora hondo dzaMwari mupenyu.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.36",
            "verseOrgIds": [
              "1SA.17.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1SA 17:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha akandirwira pagumbo reshumba nerebere, ndiye achandirwira muruoko rwomuFiristia uyu.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.37",
            "verseOrgIds": [
              "1SA.17.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 17:37"
      },
      "items": [
        {
          "text": "Sauro akati kuna Dhavhidhi, \"Enda, uye Jehovha ave newe.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.37",
            "verseOrgIds": [
              "1SA.17.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1SA 17:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Sauro akashongedza Dhavhidhi nenguo dzake. Akamupfekedza jasi rokurwa uye nguwani yendarira pamusoro wake.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.38",
            "verseOrgIds": [
              "1SA.17.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1SA 17:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi akasungira munondo wake pamusoro penguo akaedza kufamba-famba nadzo akakundikana, nokuti akanga asina kudzizivira.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.39",
            "verseOrgIds": [
              "1SA.17.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 17:39"
      },
      "items": [
        {
          "text": "Akati kuna Sauro, \"Handingaendi ndakapfeka idzi, nokuti handina kudzijaira.\" Saka akadzibvisa.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.39",
            "verseOrgIds": [
              "1SA.17.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1SA 17:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akabata tsvimbo yake muruoko rwake, akasarudza hurungudo shanu murukova, akadziisa munhava yake yomufudzi, uye ane chimviriri muruoko rwake, akaswedera kumuFiristia.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.40",
            "verseOrgIds": [
              "1SA.17.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1SA 17:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvichakadaro, muFiristia, nomutakuri wenhoo yake mberi kwake, vakaramba vachiswedera pedyo naDhavhidhi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.41",
            "verseOrgIds": [
              "1SA.17.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1SA 17:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akatarisa akaona kuti Dhavhidhi akanga ari mukomana zvake, mutsvuku, akanaka, uye akamuzvidza.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.42",
            "verseOrgIds": [
              "1SA.17.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1SA 17:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati kuna Dhavhidhi, \"Ndiri imbwa kanhi, zvaunouya kwandiri nezvimiti?\" Uye navamwari vake, muFiristia akatuka Dhavhidhi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.43",
            "verseOrgIds": [
              "1SA.17.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "1SA 17:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati, \"Uya kuno ndigopa nyama yako kushiri dzedenga nokumhuka dzesango!\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.44",
            "verseOrgIds": [
              "1SA.17.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "1SA 17:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi akati kumuFiristia, \"Iwe unouya kwandiri nomunondo, nepfumo uye nepfumo guru, asi ini ndinouya kwauri muzita raJehovha Wamasimba Ose, Mwari wehondo dzavaIsraeri, uyo waunozvidza.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.45",
            "verseOrgIds": [
              "1SA.17.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "1SA 17:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nhasi Jehovha achakuisa muruoko rwangu, uye ndichakuuraya ndigokugura musoro wako. Nhasi ndichapa mitumbi yehondo yavaFiristia kushiri dzedenga nokuzvikara zvenyika, uye nyika yose ichaziva kuti muIsraeri muna Mwari.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.46",
            "verseOrgIds": [
              "1SA.17.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "1SA 17:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vose vakaungana pano vachaziva kuti Jehovha haaponesi nomunondo kana nepfumo; nokuti kurwa ndokwaJehovha, uye achaisa imi mose mumaoko edu.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.47",
            "verseOrgIds": [
              "1SA.17.47"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "1SA 17:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "MuFiristia akati achiswedera pedyo kuti amuuraye, Dhavhidhi akakurumidza kumhanyira kumutsara wokurwa kuti andosangana naye.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.48",
            "verseOrgIds": [
              "1SA.17.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "1SA 17:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akapinza ruoko rwake munhava ndokutora dombo, akaripotsera nechimviriri akarova muFiristia pahuma. Dombo rakanyura muhuma yake, akawira pasi nechiso chake.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.49",
            "verseOrgIds": [
              "1SA.17.49"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "1SA 17:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Dhavhidhi akakunda muFiristia nechimviriri uye nedombo; akauraya muFiristia asina munondo muruoko rwake.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.50",
            "verseOrgIds": [
              "1SA.17.50"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "1SA 17:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi akamhanya akandomira pamusoro pake. Akatora munondo womuFiristia akauvhomora mumuhara. Mushure mokunge amuuraya, akagura musoro wake nomunondo.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.51",
            "verseOrgIds": [
              "1SA.17.51"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 17:51"
      },
      "items": [
        {
          "text": "VaFiristia vakati vaona kuti mhare yavo yafa, vakatendeuka vakatiza.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.51",
            "verseOrgIds": [
              "1SA.17.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "1SA 17:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo varume veIsraeri neveJudha vakaenda mberi vachidanidzira uye vakatevera vaFiristia kusvikira pasuo reGati nokumasuo eEkironi. Vakafa vavo vakati kata kata mumugwagwa weShaaraimi waienda kuGati nokuEkironi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.52",
            "verseOrgIds": [
              "1SA.17.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "1SA 17:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "VaIsraeri vakati vadzoka kundodzinganisa vaFiristia, vakapamba musasa wavo.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.53",
            "verseOrgIds": [
              "1SA.17.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "1SA 17:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi akatora musoro womuFiristia akauya nawo kuJerusarema, uye akatora zvombo zvomuFiristia akazviisa mutende rake.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.54",
            "verseOrgIds": [
              "1SA.17.54"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "1SA 17:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sauro akati atarisa Dhavhidhi achindosangana nomuFiristia, akati kuna Abhineri, mukuru wehondo, \"Abhineri, jaya iri mwanakomana waaniko?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.55",
            "verseOrgIds": [
              "1SA.17.55"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 17:55"
      },
      "items": [
        {
          "text": "Abhineri akati, \"Zvirokwazvo noupenyu hwenyu, mambo, ini handizivi.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.55",
            "verseOrgIds": [
              "1SA.17.55"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "1SA 17:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo akati, \"Bvunza kuti jaya iri, mwanakomana waaniko?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.56",
            "verseOrgIds": [
              "1SA.17.56"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "57",
            "style": "v",
            "sid": "1SA 17:57"
          },
          "items": [
            {
              "text": "57",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi akati achangobva kundouraya muFiristia, Abhineri akamutora akamuendesa pamberi paSauro, Dhavhidhi achakangobata musoro womuFiristia.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.57",
            "verseOrgIds": [
              "1SA.17.57"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "58",
