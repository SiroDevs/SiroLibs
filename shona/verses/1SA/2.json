  "verseCount": 36,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "1SA 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Munyengetero waHana",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Hana akanyengetera achiti:",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.1",
            "verseOrgIds": [
              "1SA.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1SA 2:1"
      },
      "items": [
        {
          "text": "\"Mwoyo wangu unofara muna Jehovha;",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.1",
            "verseOrgIds": [
              "1SA.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1SA 2:1"
      },
      "items": [
        {
          "text": "muna Jehovha runyanga rwangu rwasimudzirwa kumusoro.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.1",
            "verseOrgIds": [
              "1SA.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1SA 2:1"
      },
      "items": [
        {
          "text": "Muromo wangu unotaura usingatyi pamusoro pavavengi vangu,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.1",
            "verseOrgIds": [
              "1SA.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1SA 2:1"
      },
      "items": [
        {
          "text": "nokuti ndinofarira ruponeso rwenyu.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.1",
            "verseOrgIds": [
              "1SA.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Hakuna mutsvene akaita saJehovha;",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.2",
            "verseOrgIds": [
              "1SA.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1SA 2:2"
      },
      "items": [
        {
          "text": "hakuna mumwe kunze kwenyu;",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.2",
            "verseOrgIds": [
              "1SA.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1SA 2:2"
      },
      "items": [
        {
          "text": "hakuna Dombo rakaita saMwari wedu.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.2",
            "verseOrgIds": [
              "1SA.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Usaramba uchitaura uchizvikudza",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.3",
            "verseOrgIds": [
              "1SA.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1SA 2:3"
      },
      "items": [
        {
          "text": "uye manyawi ngaarege kubuda mumuromo mako,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.3",
            "verseOrgIds": [
              "1SA.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1SA 2:3"
      },
      "items": [
        {
          "text": "nokuti Jehovha ndiMwari anoziva,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.3",
            "verseOrgIds": [
              "1SA.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1SA 2:3"
      },
      "items": [
        {
          "text": "uye naye mabasa anoyerwa.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.3",
            "verseOrgIds": [
              "1SA.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Uta hwavarwi hwatyorwa,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.4",
            "verseOrgIds": [
              "1SA.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1SA 2:4"
      },
      "items": [
        {
          "text": "asi avo vakagumburwa vashongedzwa simba.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.4",
            "verseOrgIds": [
              "1SA.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avo vaiva vakaguta vakandoshandira zvokudya zvavo,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.5",
            "verseOrgIds": [
              "1SA.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1SA 2:5"
      },
      "items": [
        {
          "text": "asi avo vaiva nenzara havachanzwi nzara zvakare.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.5",
            "verseOrgIds": [
              "1SA.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1SA 2:5"
      },
      "items": [
        {
          "text": "Uyo aiva asingabereki abereka vana vanomwe,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.5",
            "verseOrgIds": [
              "1SA.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1SA 2:5"
      },
      "items": [
        {
          "text": "asi iye akanga ana vana vazhinji oshayiwa simba.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.5",
            "verseOrgIds": [
              "1SA.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Jehovha ndiye anouraya uye ndiye anoraramisa;",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.6",
            "verseOrgIds": [
              "1SA.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1SA 2:6"
      },
      "items": [
        {
          "text": "anodzikisa kuguva uye anomutsawo.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.6",
            "verseOrgIds": [
              "1SA.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha ndiye anopa urombo uye noupfumi;",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.7",
            "verseOrgIds": [
              "1SA.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1SA 2:7"
      },
      "items": [
        {
          "text": "uye anoninipisa uye anosimudzira.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.7",
            "verseOrgIds": [
              "1SA.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anosimudza varombo kubva paguruva",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.8",
            "verseOrgIds": [
              "1SA.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1SA 2:8"
      },
      "items": [
        {
          "text": "uye anosimudza vanoshaya kubva padurunhuru ramadota;",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.8",
            "verseOrgIds": [
              "1SA.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1SA 2:8"
      },
      "items": [
        {
          "text": "anovagarisa namachinda",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.8",
            "verseOrgIds": [
              "1SA.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1SA 2:8"
      },
      "items": [
        {
          "text": "uye anovaita kuti vagare nhaka yechigaro choumambo chokukudzwa.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.8",
            "verseOrgIds": [
              "1SA.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "1SA 2:8"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1SA 2:8"
      },
      "items": [
        {
          "text": "\"Nokuti nheyo dzenyika ndedzaJehovha,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.8",
            "verseOrgIds": [
              "1SA.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1SA 2:8"
      },
      "items": [
        {
          "text": "pamusoro padzo akamisa nyika.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.8",
            "verseOrgIds": [
              "1SA.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Acharinda tsoka dzavatsvene vake,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.9",
            "verseOrgIds": [
              "1SA.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1SA 2:9"
      },
      "items": [
        {
          "text": "asi vakaipa vachanyaradzwa murima.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.9",
            "verseOrgIds": [
              "1SA.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "1SA 2:9"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1SA 2:9"
      },
      "items": [
        {
          "text": "\"Nokuti hakuna munhu achakunda nesimba rake.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.9",
            "verseOrgIds": [
              "1SA.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avo vanopikisa Jehovha vachaparadzwa.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.10",
            "verseOrgIds": [
              "1SA.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1SA 2:10"
      },
      "items": [
        {
          "text": "Achavatinhirira ari kudenga;",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.10",
            "verseOrgIds": [
              "1SA.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1SA 2:10"
      },
      "items": [
        {
          "text": "Jehovha achatonga magumo enyika.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.10",
            "verseOrgIds": [
              "1SA.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "1SA 2:10"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1SA 2:10"
      },
      "items": [
        {
          "text": "\"Achapa simba kuna mambo wake,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.10",
            "verseOrgIds": [
              "1SA.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1SA 2:10"
      },
      "items": [
        {
          "text": "uye achasimudzira runyanga rwomuzodziwa wake.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.10",
            "verseOrgIds": [
              "1SA.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino Erikana akaenda kumusha kwake kuRama, asi mukomana akashumira pamberi paJehovha ari pasi paEri muprista.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.11",
            "verseOrgIds": [
              "1SA.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Vanakomana vaEri vakanga vakaipa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanakomana vaEri vakanga vari vanhu vakaipa; vakanga vasina hanya naJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.12",
            "verseOrgIds": [
              "1SA.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino yakanga iri tsika yavaprista kuvanhu kuti munhu paaibayira chibayiro uye nyama ichiri kubikwa, muranda womuprista aiuya neforogo ine zvibayiso zvitatu muruoko rwake.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.13",
            "verseOrgIds": [
              "1SA.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aiinyudza mugango, kana muhadyana, kana mugate kana mupoto, ipapo muprista ozvitorera chero zvainge zvabudiswa neforogo. Aya ndiwo mabatiro avaiita nawo vaIsraeri vose vaiuya kuShiro.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.14",
            "verseOrgIds": [
              "1SA.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi, kunyange mafuta asati atsva, muranda womuprista aiuya achiti kumurume aibayira chibayiro, \"Ipa muprista nyama yokugocha; haasi kuzogamuchira nyama yakabikwa kubva kwauri, asi mbishi chete.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.15",
            "verseOrgIds": [
              "1SA.2.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana murume uya aiti kwaari, \"Rega mafuta ambotanga atsva uye iwe ugozotora chero zvaunoda,\" muranda aibva apindura achiti, \"Kwete, ndipe kuno izvozvi; kana ukasandipa ndichaitora nechisimba.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.16",
            "verseOrgIds": [
              "1SA.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichi chivi chamajaya aya chaiva chakakura kwazvo pamberi paJehovha, nokuti vaizvidza chipo chaJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.17",
            "verseOrgIds": [
              "1SA.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi Samueri aishumira pamberi paJehovha, mukomana aive akapfeka efodhi yomucheka.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.18",
            "verseOrgIds": [
              "1SA.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gore rimwe nerimwe, mai vake vaimuitira nguo diki uye vaienda nayo kwaari pavaienda nomurume wavo kundopa chibayiro chegore.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.19",
            "verseOrgIds": [
              "1SA.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri aibva aropafadza Erikana nomukadzi wake achiti, \"Jehovha ngaakupe vana nomukadzi uyu kuti vatore nzvimbo youyo waakakumbira uye akamupa kuna Jehovha.\" Ipapo vaibva vaenda kumusha kwavo.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.20",
            "verseOrgIds": [
              "1SA.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino Jehovha akava nenyasha kuna Hana; akabata pamuviri akabereka vanakomana vatatu navanasikana vaviri. Zvichakadaro, mukomana uyu Samueri akakura ari pamberi paJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.21",
            "verseOrgIds": [
              "1SA.2.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino Eri, uyo akanga akwegura kwazvo, akanzwa zvose zvaiitwa navanakomana vake kuvaIsraeri vose zvokuti vairara namadzimai aishumira pasuo reTende Rokusangana.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.22",
            "verseOrgIds": [
              "1SA.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka akati kwavari, \"Sei muchiita zvinhu zvakadai? Ndinonzwa navanhu vose pamusoro pezviito zvenyu zvakaipa izvi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.23",
            "verseOrgIds": [
              "1SA.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1SA 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwete, vana vangu; harisi shoko rakanaka randinonzwa richipararira pakati pavanhu vaJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.24",
            "verseOrgIds": [
              "1SA.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1SA 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana munhu akatadzira mumwe munhu, Mwari angamumiririre, asi kana munhu akatadzira Jehovha, ndiani angamumiririre?\" Kunyange zvakadaro, vanakomana vake havana kuteerera kutsiura kwababa vavo, nokuti kwaiva kuda kwaJehovha kuti avauraye.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.25",
            "verseOrgIds": [
              "1SA.2.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1SA 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino mukomana uyu Samueri akaramba achikura pamumhu uye napakudiwa naJehovha navanhu.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.26",
            "verseOrgIds": [
              "1SA.2.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Chiprofita pamusoro peimba yaEri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1SA 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino munhu waMwari akauya kuna Eri akati kwaari, \"Zvanzi naJehovha: 'Handina kuzviratidza pachena kuimba yababa vako here pavaiva muIjipiti pasi paFaro?",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.27",
            "verseOrgIds": [
              "1SA.2.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1SA 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakasarudza baba vako kubva kumarudzi ose aIsraeri kuti vave muprista wangu, kuti vakwire kuaritari yangu, kundopisa zvinonhuhwira, uye kuti vapfeke efodhi pamberi pangu. Ndakapawo imba yababa vako zvose zvipiriso zvaipiswa navaIsraeri.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.28",
            "verseOrgIds": [
              "1SA.2.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1SA 2:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sei muchizvidza chibayiro changu nechipiriso changu, zvandakarayira mumba mangu? Sei muchikudza vanakomana venyu kudarika ini nokuzvikudza pachenyu nezvikamu zvakanakisisa zvezvipiriso zvose zvinopiwa navanhu vangu veIsraeri?'",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.29",
            "verseOrgIds": [
              "1SA.2.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1SA 2:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Naizvozvo Jehovha, Mwari weIsraeri, anoti, 'Ndakavimbisa kuti imba yako neimba yababa vako dzichashumira pamberi pangu nokusingaperi.' Asi zvino Jehovha anoti, 'Ngazvive kure neni! Avo vanondikudza ndichavakudza, asi avo vanondizvidza vachadzikisiswa.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.30",
            "verseOrgIds": [
              "1SA.2.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1SA 2:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nguva iri kuuya yandichagura simba rako nesimba reimba yababa vako, zvokuti hakuchazova nomutana mumhuri yako",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.31",
            "verseOrgIds": [
              "1SA.2.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1SA 2:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye uchaona kutambudzika muimba yangu. Kunyange zvazvo zvakanaka zvichizoitirwa Israeri, mumhuri yako hamuzofi makava nomutana.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.32",
            "verseOrgIds": [
              "1SA.2.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1SA 2:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumwe nomumwe wenyu wandisingabvisi paaritari yangu achasiyiwa kuti apofumadze meso enyu nemisodzi uye kuti arwadzise mwoyo yenyu, uye zvizvarwa zvako zvose zvichafa zvichine simba.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.33",
            "verseOrgIds": [
              "1SA.2.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1SA 2:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Uye zvichaitika kuvanakomana vako vaviri, Hofini naFinehasi zvichava chiratidzo kwauri, vachafa vose zuva rimwe chete.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.34",
            "verseOrgIds": [
              "1SA.2.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1SA 2:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndichazvimutsira muprista akatendeka, achaita zvinoenderana nezviri mumwoyo mangu nomundangariro dzangu. Ndichamisa imba yake zvakasimba, uye achashumira pamberi pomuzodziwa wangu nguva dzose.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.35",
            "verseOrgIds": [
              "1SA.2.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1SA 2:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo wose achasara mumhuri yako achauya agokotama pamberi pake kuti apiwe mari yesirivha nechimedu chechingwa agokumbirisa achiti, \"Dondipaiwo rimwe basa rouprista kuti ndingowana zvokudya.\" ' \"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.36",
            "verseOrgIds": [
              "1SA.2.36"
            ]
          }
        }
      ]
    }
  ],
