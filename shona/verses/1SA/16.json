  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "16",
        "style": "c",
        "sid": "1SA 16"
      },
      "items": [
        {
          "text": "16",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Samueri anozodza Dhavhidhi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha akati kuna Samueri, \"Uchasvika riniko uchichema Sauro, sezvo ini ndakamuramba kuti asava mambo wavaIsraeri? Zadza gonamombe rako namafuta ugopinda munzira yako; ndiri kukutuma kuna Jese wokuBheterehema. Ndasarudza mumwe wavanakomana vake kuti ave mambo.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.1",
            "verseOrgIds": [
              "1SA.16.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi Samueri akati, \"Ndingaenda seiko? Sauro achanzwa nezvazvo akandiuraya.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.2",
            "verseOrgIds": [
              "1SA.16.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 16:2"
      },
      "items": [
        {
          "text": "Jehovha akati, \"Tora tsiru uende naro ugondoti, 'Ndauya kuzobayira kuna Jehovha.'",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.2",
            "verseOrgIds": [
              "1SA.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukoke Jese kuti auye kuchibayiro, uye ini ndichakuratidza zvokuita. Unofanira kundizodzera uyo wandichakuratidza.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.3",
            "verseOrgIds": [
              "1SA.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samueri akaita zvakataurwa naJehovha. Akati asvika kuBheterehema, vakuru vomusha vakadedera pavakasangana naye. Vakamubvunza vakati, \"Mauya norugare here?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.4",
            "verseOrgIds": [
              "1SA.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samueri akati, \"Hongu, ndauya norugare; ndauya kuzobayira kuna Jehovha. Zvinatsei mugoenda neni kuchibayiro.\" Ipapo akanatsa Jese navanakomana vake akavakoka kuti vauye kuchibayiro.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.5",
            "verseOrgIds": [
              "1SA.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakati vasvika, Samueri akaona Eriabhi akafunga kuti, \"Zvirokwazvo muzodziwa waJehovha ndiye amire pano pamberi paJehovha.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.6",
            "verseOrgIds": [
              "1SA.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi Jehovha akati kuna Samueri, \"Rega kutarira chiso chake kana mumhu wake, nokuti ndamuramba. Jehovha haatarisi zvinhu zvinoonekwa navanhu. Munhu anotarisa zviri kunze, asi Jehovha anotarisa pamwoyo.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.7",
            "verseOrgIds": [
              "1SA.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Jese akadana Abhinadhabhi akaita kuti apfuure napamberi paSamueri. Asi Samueri akati, \"Jehovha haana kusarudza uyuwo.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.8",
            "verseOrgIds": [
              "1SA.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jese akaita kuti Shama apfuure napo, asi Samueri akati, \"Nouyu haana kusarudzwa naJehovha.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.9",
            "verseOrgIds": [
              "1SA.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jese akaita kuti vanakomana vake vanomwe vapfuure napamberi paSamueri, asi Samueri akati kwaari, \"Jehovha haana kusarudza ava.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.10",
            "verseOrgIds": [
              "1SA.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka akabvunza Jese akati, \"Ava ndivo vose vanakomana vaunavo here?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.11",
            "verseOrgIds": [
              "1SA.16.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 16:11"
      },
      "items": [
        {
          "text": "Jese akapindura akati, \"Kuchino mumwe muduku kuna vose, asi ari kufudza makwai.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.11",
            "verseOrgIds": [
              "1SA.16.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 16:11"
      },
      "items": [
        {
          "text": "Samueri akati, \"Tuma munhu kwaari; hatingagari pasi kusvikira asvika pano.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.11",
            "verseOrgIds": [
              "1SA.16.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka akatuma munhu kuti andouya naye. Akanga ari mutsvuku, ane chiso chakaisvonaka nechimiro chakanaka.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.12",
            "verseOrgIds": [
              "1SA.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 16:12"
      },
      "items": [
        {
          "text": "Ipapo Jehovha akati, \"Simuka umuzodze, nokuti ndiyeyu.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.12",
            "verseOrgIds": [
              "1SA.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Samueri akatora gonamombe ramafuta akamuzodza pamberi pamadzikoma ake, uye kubva pazuva iroro Mweya waJehovha wakauya pamusoro paDhavhidhi nesimba. Ipapo Samueri akaenda kuRama.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.13",
            "verseOrgIds": [
              "1SA.16.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Dhavhidhi anoshandira Sauro",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino Mweya waJehovha wakanga wabva pana Sauro, uye mweya wakaipa wakabva kuna Jehovha ukamutambudza.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.14",
            "verseOrgIds": [
              "1SA.16.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Varanda vaSauro vakati kwaari, \"Tarirai mweya wakaipa unobva kuna Mwari unokutambudzai.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.15",
            "verseOrgIds": [
              "1SA.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ishe ngaarayire varanda vake vari pano kuti vatsvake mumwe munhu anogona kuridza mbira. Acharidza kana mweya wakaipa unobva kuna Mwari wauya pamusoro penyu, uye imi muchanzwa zviri nani.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.16",
            "verseOrgIds": [
              "1SA.16.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Sauro akati kuvaranda vake, \"Tsvakai munhu anogona kuridza zvakanaka muuye naye kwandiri.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.17",
            "verseOrgIds": [
              "1SA.16.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumwe wavaranda akapindura akati, \"Ndaona mwanakomana waJese wokuBheterehema anoziva kuridza mbira. Murume asingatyi uye murwi. Anogona kutaura zvakanaka uye munhu akaisvonaka. Uye Jehovha anaye.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.18",
            "verseOrgIds": [
              "1SA.16.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Sauro akatuma nhume kuna Jese akati, \"Nditumirewo mwanakomana wako Dhavhidhi, uyo ari kumakwai.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.19",
            "verseOrgIds": [
              "1SA.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Jese akatora mbongoro akaitakudza chingwa, guchu rewaini nembudzana akazvitumira kuna Sauro naDhavhidhi mwanakomana wake.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.20",
            "verseOrgIds": [
              "1SA.16.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi akasvika kuna Sauro akapinda kundomushandira. Sauro akamuda kwazvo, uye Dhavhidhi akava mumwe wavatakuri venhumbi dzake dzokurwa.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.21",
            "verseOrgIds": [
              "1SA.16.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Sauro akatuma shoko kuna Jese, achiti, \"Tendera Dhavhidhi kuti andishandire, nokuti ndinofadzwa naye.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.22",
            "verseOrgIds": [
              "1SA.16.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 16:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mweya waibva kuna Mwari waiti wasvika pamusoro paSauro, Dhavhidhi aibva atora mbira dzake oridza. Ipapo Sauro aibva anzwa kusununguka; onzwa zviri nani uye mweya wakaipa wobva wamusiya.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.23",
            "verseOrgIds": [
              "1SA.16.23"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "1SA.17",
