  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "ROM 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abhurahama akaruramiswa noKutenda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ROM 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino tichati Abhurahama, tateguru wedu, panyama akawaneiko pazviri?",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.1",
            "verseOrgIds": [
              "ROM.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ROM 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti dai Abhurahama akaruramisirwa namabasa, angadai aine chinhu chokuzvirumbidza nacho, asi kwete pamberi paMwari.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.2",
            "verseOrgIds": [
              "ROM.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ROM 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ko, Rugwaro runoti kudiniko? \"Abhurahama akatenda Mwari, uye kukanzi kwaari ndiko kururama.\"",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.3",
            "verseOrgIds": [
              "ROM.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino kana munhu achiita basa, mubayiro wake hautorwi sechipo chokungopiwa, asi somubayiro wakamufanira.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.4",
            "verseOrgIds": [
              "ROM.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi kumunhu asingashandi, asi achitenda Mwari uyo anoruramisira munhu akaipa, kutenda kwake kuchanzi kwaari ndiko kururama.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.5",
            "verseOrgIds": [
              "ROM.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi anotaura pamusoro pechinhu chimwe chete ichi paanotaura zvokuropafadzwa kwomunhu anonzi naMwari akarurama kunze kwamabasa, achiti:",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.6",
            "verseOrgIds": [
              "ROM.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Vakaropafadzwa avo",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.7",
            "verseOrgIds": [
              "ROM.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ROM 4:7"
      },
      "items": [
        {
          "text": "vakaregererwa zvakaipa zvavo,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.7",
            "verseOrgIds": [
              "ROM.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ROM 4:7"
      },
      "items": [
        {
          "text": "vakafukidzirwa zvivi zvavo.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.7",
            "verseOrgIds": [
              "ROM.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ROM 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaropafadzwa munhu",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.8",
            "verseOrgIds": [
              "ROM.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ROM 4:8"
      },
      "items": [
        {
          "text": "ane chivi chisingazombobvunzwi naIshe pamusoro pake.\"",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.8",
            "verseOrgIds": [
              "ROM.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ROM 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ko, kuropafadzwa uku ndokwavakadzingiswa chete here? Kana kuti navasina kudzingiswawo? Nokuti tati kuna Abhurahama kutenda kwake kwakanzi kwaari ndiko kururama.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.9",
            "verseOrgIds": [
              "ROM.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino zvakanzarwo seiko? Akanga adzingiswa here, kana kuti asati? Haana kunzarwo adzingiswa, asi kuti asati adzingiswa!",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.10",
            "verseOrgIds": [
              "ROM.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ROM 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye akagamuchira chiratidzo chokudzingiswa, sechisimbiso chokururama kwaakawana nokutenda asati adzingiswa. Saka naizvozvo ndiye baba wavose vanotenda, asi vasina kudzingiswa, kuitira kuti kururama kugopiwa kwavari.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.11",
            "verseOrgIds": [
              "ROM.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye ndiyewo baba wavakadzingiswa, avo vasina kudzingiswa bedzi, asi vanofambawo mumakwara okutenda kwakanga kuna baba vedu Abhurahama vasati vadzingiswa.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.12",
            "verseOrgIds": [
              "ROM.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti Abhurahama, nezvizvarwa zvake, haana kupiwa chipikirwa chokuti achava mugari wenhaka yenyika, kubudikidza nomurayiro, asi kubudikidza nokururama kunobva pakutenda.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.13",
            "verseOrgIds": [
              "ROM.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti dai vaya vanorarama nomurayiro vari ivo vadyi venhaka, kutenda hakuna maturo uye nechipikirwa chinokoneswa,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.14",
            "verseOrgIds": [
              "ROM.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "nokuti murayiro unouyisa kutsamwa. Uye pasina murayiro hapanawo kudarika.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.15",
            "verseOrgIds": [
              "ROM.4.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ROM 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo chipikirwa chinouya nokutenda, kuitira kuti zvive zvenyasha uye kuti chisimbiswe kuzvizvarwa zvose zvaAbhurahama, kwete avo vari vomurayiro voga, asi nokuna avo vari vokutenda kwaAbhurahama. Ndiye baba vedu tose.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.16",
            "verseOrgIds": [
              "ROM.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sezvazvakanyorwa zvichinzi: \"Ndakakuita baba vendudzi zhinji.\" Ndiye baba vedu pamberi paMwari, uyo waakatenda kwaari, iye Mwari anopa upenyu kuvakafa uye anodana zvisipo sokunge zviripo.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.17",
            "verseOrgIds": [
              "ROM.4.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ROM 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pasina kana tariro, Abhurahama netariro akatenda uye akava baba vendudzi zhinji, sezvazvakanga zvarehwa kwaari zvichinzi, \"Zvizvarwa zvako zvichadarowo.\"",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.18",
            "verseOrgIds": [
              "ROM.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ROM 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haana kushayiwa simba mukutenda kwake, paakaona kuti muviri wake wakanga watofa hawo, sezvo akanga ava namakore anenge zana okuzvarwa, uye kuti chizvaro chaSara chakanga chafawo.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.19",
            "verseOrgIds": [
              "ROM.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ROM 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi haana kukahadzika nokuda kwokusatenda pamusoro pechipikirwa chaMwari, asi akasimbiswa mukutenda kwake uye akakudza Mwari,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.20",
            "verseOrgIds": [
              "ROM.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ROM 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "achinyatsogutsikana kuti Mwari ane simba rokuita zvaakanga avimbisa.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.21",
            "verseOrgIds": [
              "ROM.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ROM 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndokusaka \"zvakanzi kwaari ndiko kururama.\"",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.22",
            "verseOrgIds": [
              "ROM.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ROM 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mashoko okuti, \"zvakanzi kwaari,\" haana kunyorerwa iye oga,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.23",
            "verseOrgIds": [
              "ROM.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ROM 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "asi kwatiriwo, kuna avo vachanzi naMwari vakarurama, kunesu vanotenda kwaari iye akamutsa Jesu Ishe wedu kubva kuvakafa.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.24",
            "verseOrgIds": [
              "ROM.4.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ROM 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaiswa kurufu nokuda kwezvivi zvedu uye akamutswa kuvapenyu nokuda kwokururamisirwa kwedu.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.4.25",
            "verseOrgIds": [
              "ROM.4.25"
            ]
          }
        }
      ]
    }
  ],
