  "verseCount": 47,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "15",
        "style": "c",
        "sid": "MRK 15"
      },
      "items": [
        {
          "text": "15",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jesu Pamberi paPirato",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MRK 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mangwanani-ngwanani, vaprista vakuru navakuru, vadzidzisi vomurayiro uye neDare Guru rose, vakaita sarudzo. Vakasunga Jesu, vakaenda naye vakandomuisa mumaoko aPirato.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.1",
            "verseOrgIds": [
              "MRK.15.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MRK 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pirato akamubvunza akati, \"Ndiwe mambo wavaJudha here?\" Jesu akapindura akati, \"Hongu, ndizvo sokutaura kwamaita.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.2",
            "verseOrgIds": [
              "MRK.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MRK 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vaprista vakuru vakamupomera zvinhu zvizhinji kwazvo.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.3",
            "verseOrgIds": [
              "MRK.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MRK 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Pirato akabvunzazve akati, \"Ko, haupinduri here? Tarira kuwanda kwezvinhu zvavanokupomera.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.4",
            "verseOrgIds": [
              "MRK.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MRK 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi Jesu haana kupindura, uye Pirato akashamiswa nazvo.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.5",
            "verseOrgIds": [
              "MRK.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MRK 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino yakanga iri tsika yapaMutambo kuti asunungure musungwa anenge akumbirwa navanhu.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.6",
            "verseOrgIds": [
              "MRK.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MRK 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Murume ainzi Bharabhasi akanga ari mutorongo pamwe chete navamwe vakanga vamutsa bope vakauraya munhu.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.7",
            "verseOrgIds": [
              "MRK.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MRK 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanhu vazhinji vakauya vakakumbira Pirato kuti avaitire zvaaisiita.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.8",
            "verseOrgIds": [
              "MRK.15.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MRK 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pirato akabvunza akati, \"Munoda kuti ndikusunungurirei mambo wavaJudha here?\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.9",
            "verseOrgIds": [
              "MRK.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MRK 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "achiziva kuti zvaingova zvegodo ravaprista vakuru kuti vakaisa Jesu mumaoko ake.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.10",
            "verseOrgIds": [
              "MRK.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MRK 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi vaprista vakuru vakamutsa mwoyo yavazhinji kuti vaite kuti Pirato asunungure Bharabhasi pachinzvimbo chaJesu.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.11",
            "verseOrgIds": [
              "MRK.15.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MRK 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pirato akabvunza akati, \"Ndichaiteiko, zvino, nouyo wamunoti mambo wavaJudha?\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.12",
            "verseOrgIds": [
              "MRK.15.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MRK 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakadanidzira vachiti, \"Murovererei pamuchinjikwa!\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.13",
            "verseOrgIds": [
              "MRK.15.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MRK 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pirato akavabvunza akati, \"Nemhaka yeiko? Akapara mhosva yeiko?\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.14",
            "verseOrgIds": [
              "MRK.15.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MRK 15:14"
      },
      "items": [
        {
          "text": "Asi vakanyanya kudanidzira vachiti, \"Murovererei pamuchinjikwa!\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.14",
            "verseOrgIds": [
              "MRK.15.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MRK 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achida kufadza vanhu, Pirato akasunungura Bharabhasi. Akaita kuti Jesu arohwe, uye akamuendesa kuti andorovererwa.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.15",
            "verseOrgIds": [
              "MRK.15.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Varwi Vanodadira Jesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MRK 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Varwi vakatora Jesu vakapinda naye mumuzinda, Piritoriamu, uye vakaunganidza pamwe chete boka rose ravarwi.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.16",
            "verseOrgIds": [
              "MRK.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MRK 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakamupfekedza nguo dzepepuru, ipapo vakamurukira korona yeminzwa vakaigadzika pamusoro wake.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.17",
            "verseOrgIds": [
              "MRK.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MRK 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye vakatanga kudanidzira kwaari vachiti, \"Kwaziwaika, mambo wavaJudha!\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.18",
            "verseOrgIds": [
              "MRK.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MRK 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakaramba vachingomurova mumusoro netsvimbo uye vachimupfira mate. Vachipfugama namabvi avo, vakaita savanomunamata.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.19",
            "verseOrgIds": [
              "MRK.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MRK 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye vakati vamudadira, vakabvisa nguo yepepuru vakamupfekedza dzake. Ipapo vakabuda naye kundomuroverera pamuchinjikwa.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.20",
            "verseOrgIds": [
              "MRK.15.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kurovererwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MRK 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumwe murume aibva kuKurini, Simoni baba vaArekizanda naRufasi, akanga achipfuura achibva kumaruwa, vakamumanikidza kuti atakure muchinjikwa.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.21",
            "verseOrgIds": [
              "MRK.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MRK 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakaenda naJesu kunzvimbo yainzi Gorogota (kureva kuti Nzvimbo yeDehenya).",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.22",
            "verseOrgIds": [
              "MRK.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MRK 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo vakamupa waini yakavhenganiswa nemura, asi haana kuinwa.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.23",
            "verseOrgIds": [
              "MRK.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MRK 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye vakamuroverera pamuchinjikwa. Vakagovana nguo dzake, vakakanda mijenya kuti vaone kuti mumwe nomumwe angawanei.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.24",
            "verseOrgIds": [
              "MRK.15.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MRK 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakanga iri nguva yechitatu pavakamuroverera.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.25",
            "verseOrgIds": [
              "MRK.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MRK 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvakanga zvakanyorwa pamusoro pake zvaiti:",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.26",
            "verseOrgIds": [
              "MRK.15.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "sc"
          },
          "items": [
            {
              "text": "mambo wavajudha",
              "type": "text",
              "attrs": {
                "verseId": "MRK.15.26",
                "verseOrgIds": [
                  "MRK.15.26"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.26",
            "verseOrgIds": [
              "MRK.15.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MRK 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakamuroverera pamwe chete namakororo maviri, mumwe kurudyi uye mumwe kuruboshwe.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.27",
            "verseOrgIds": [
              "MRK.15.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MRK 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye rugwaro rwakazadziswa runoti, \"Akaverengwa pamwe chete navadariki.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.28",
            "verseOrgIds": [
              "MRK.15.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MRK 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vaya vakanga vachipfuura vaimutuka, vachidzungudza misoro yavo vachiti, \"Saka! Iwe uri kuzoputsa temberi nokuivaka mumazuva matatu,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.29",
            "verseOrgIds": [
              "MRK.15.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MRK 15:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "chiburuka pamuchinjikwa uzviponese!\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.30",
            "verseOrgIds": [
              "MRK.15.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MRK 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nenzira imwe cheteyo vaprista vakuru navadzidzisi vomurayiro vakamuseka pakati pavo, vakati, \"Akaponesa vamwe, asi haagoni kuzviponesa!",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.31",
            "verseOrgIds": [
              "MRK.15.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MRK 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kristu uyu, Mambo wavaIsraeri uyu, ngaaburuke iye zvino pamuchinjikwa, kuti tione tigotenda.\" Navaya vakanga vakarovererwa pamwe chete naye vakamutukawo.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.32",
            "verseOrgIds": [
              "MRK.15.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kufa kwaJesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MRK 15:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nenguva yechitanhatu rima rakauya pamusoro penyika yose kusvikira panguva yepfumbamwe.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.33",
            "verseOrgIds": [
              "MRK.15.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MRK 15:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye panguva yepfumbamwe, Jesu akadanidzira nenzwi guru achiti, \"Eroi, Eroi, rama sabhakitani?\" zvinoreva kuti \"Mwari wangu, Mwari wangu, mandisiyireiko?\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.34",
            "verseOrgIds": [
              "MRK.15.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MRK 15:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vaya vakanga vamire pedyo vakati vanzwa izvi, vakati, \"Inzwai, ari kudana Eria.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.35",
            "verseOrgIds": [
              "MRK.15.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MRK 15:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumwe murume akamhanya, akazadza chipanje newaini yaivava, akachiisa parutanda, akachipa kuna Jesu kuti anwe, akati \"Zvino musiyei akadaro. Regai tione kana Eria achiuya kuzomuburutsa.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.36",
            "verseOrgIds": [
              "MRK.15.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MRK 15:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Jesu akadanidzira nenzwi guru, akabudisa mweya wake.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.37",
            "verseOrgIds": [
              "MRK.15.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MRK 15:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chidzitiro chapatemberi chakabvaruka napakati kubva kumusoro kusvikira pasi.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.38",
            "verseOrgIds": [
              "MRK.15.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MRK 15:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye mukuru wezana, akanga amirepo, pamberi paJesu, akati anzwa kudanidzira kwake uye aona mafiro aakaita, akati, \"Zvirokwazvo murume uyu anga ari Mwanakomana waMwari!\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.39",
            "verseOrgIds": [
              "MRK.15.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "MRK 15:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vamwe vakadzi vakanga vachitarira vari kure. Pakati pavo paiva naMaria Magadharena, Maria mai vaJakobho, mununʼuna waJosesi, naSarome.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.40",
            "verseOrgIds": [
              "MRK.15.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MRK 15:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakadzi ava vomuGarirea ndivo vaimutevera uye vachimushandira. Vakadzi vazhinji vakanga vauya naye kuJerusarema vakanga varipowo.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.41",
            "verseOrgIds": [
              "MRK.15.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kuvigwa kwaJesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "MRK 15:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rakanga riri Zuva roKugadzirira (ndiro rinotangira Sabata.) Saka kwovira,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.42",
            "verseOrgIds": [
              "MRK.15.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "MRK 15:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Josefa weArimatea, nhengo yeDare Guru yaiva nomukurumbira, uyo akanga akamirirawo umambo hwaMwari, akatsunga kuenda kuna Pirato kundokumbira mutumbi waJesu.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.43",
            "verseOrgIds": [
              "MRK.15.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "MRK 15:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pirato akashamiswa kunzwa kuti akanga atofa. Akatuma mukuru wezana, akamubvunza kana Jesu akanga afa.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.44",
            "verseOrgIds": [
              "MRK.15.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "MRK 15:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati anzwa kubva kumukuru wezana kuti zvakanga zviri izvo, akapa mutumbi kuna Josefa.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.45",
            "verseOrgIds": [
              "MRK.15.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "MRK 15:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka akauya nemimwe micheka, akaburutsa mutumbi, akauputira nomucheka, akauisa muguva rakanga rakacherwa paruware. Ipapo akakungurutsira ibwe pamuromo weguva.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.46",
            "verseOrgIds": [
              "MRK.15.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "MRK 15:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maria Magadharena naMaria mai vaJosesi vakaona paakavigwa.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.47",
            "verseOrgIds": [
              "MRK.15.47"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "MRK.16",
