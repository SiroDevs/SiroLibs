    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tumirai mutero",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.1",
            "verseOrgIds": [
              "ISA.16.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:1"
      },
      "items": [
        {
          "text": "wamakwayana kumutongi wenyika,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.1",
            "verseOrgIds": [
              "ISA.16.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 16:1"
      },
      "items": [
        {
          "text": "kubva kuSera, zvichiyambukira kurenje,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.1",
            "verseOrgIds": [
              "ISA.16.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:1"
      },
      "items": [
        {
          "text": "kugomo roMwanasikana weZioni.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.1",
            "verseOrgIds": [
              "ISA.16.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kufanana neshiri dzadzungaira",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.2",
            "verseOrgIds": [
              "ISA.16.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:2"
      },
      "items": [
        {
          "text": "dzichisundidzirwa kubva mudendere,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.2",
            "verseOrgIds": [
              "ISA.16.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 16:2"
      },
      "items": [
        {
          "text": "ndizvo zvakaita vakadzi veMoabhu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.2",
            "verseOrgIds": [
              "ISA.16.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:2"
      },
      "items": [
        {
          "text": "pamazambuko eAmoni.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.2",
            "verseOrgIds": [
              "ISA.16.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Tipeiwo zano,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.3",
            "verseOrgIds": [
              "ISA.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:3"
      },
      "items": [
        {
          "text": "ruramisirai.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.3",
            "verseOrgIds": [
              "ISA.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 16:3"
      },
      "items": [
        {
          "text": "Ita mumvuri wako kuti ufanane nousiku,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.3",
            "verseOrgIds": [
              "ISA.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:3"
      },
      "items": [
        {
          "text": "pamasikati makuru.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.3",
            "verseOrgIds": [
              "ISA.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 16:3"
      },
      "items": [
        {
          "text": "Viga vatizi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.3",
            "verseOrgIds": [
              "ISA.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:3"
      },
      "items": [
        {
          "text": "usapandukira vapoteri.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.3",
            "verseOrgIds": [
              "ISA.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rega vatizi veMoabhu vagare newe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.4",
            "verseOrgIds": [
              "ISA.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:4"
      },
      "items": [
        {
          "text": "iva utiziro hwavo kubva kumuparadzi.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.4",
            "verseOrgIds": [
              "ISA.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "ISA 16:4"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 16:4"
      },
      "items": [
        {
          "text": "Mutambudzi achasvika kumagumo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.4",
            "verseOrgIds": [
              "ISA.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:4"
      },
      "items": [
        {
          "text": "uye kuparadza kuchapera;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.4",
            "verseOrgIds": [
              "ISA.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:4"
      },
      "items": [
        {
          "text": "mudenhi achatsakatika panyika.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.4",
            "verseOrgIds": [
              "ISA.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Murudo, chigaro choushe chichasimbiswa;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.5",
            "verseOrgIds": [
              "ISA.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:5"
      },
      "items": [
        {
          "text": "mukutendeka, munhu achagarapo, mumwe anobva kuimba yaDhavhidhi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.5",
            "verseOrgIds": [
              "ISA.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 16:5"
      },
      "items": [
        {
          "text": "uyo anoti achitonga anotsvaka kururamisira,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.5",
            "verseOrgIds": [
              "ISA.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:5"
      },
      "items": [
        {
          "text": "uye achikurumidza kuita zvakarurama.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.5",
            "verseOrgIds": [
              "ISA.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Takanzwa nezvokuzvikudza kwaMoabhu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.6",
            "verseOrgIds": [
              "ISA.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:6"
      },
      "items": [
        {
          "text": "namanyawi ake makuru uye kuzvida kwake,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.6",
            "verseOrgIds": [
              "ISA.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 16:6"
      },
      "items": [
        {
          "text": "kuzvikudza kwake nokuvirima kwake,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.6",
            "verseOrgIds": [
              "ISA.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:6"
      },
      "items": [
        {
          "text": "asi kuzvirumbidza kwake hakuna maturo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.6",
            "verseOrgIds": [
              "ISA.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo vaMoabhu voungudza,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.7",
            "verseOrgIds": [
              "ISA.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:7"
      },
      "items": [
        {
          "text": "vanoungudzira Moabhu pamwe chete.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.7",
            "verseOrgIds": [
              "ISA.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 16:7"
      },
      "items": [
        {
          "text": "Chemai musuwe",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.7",
            "verseOrgIds": [
              "ISA.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:7"
      },
      "items": [
        {
          "text": "nokuda kwavarume veKiri Hareseti.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.7",
            "verseOrgIds": [
              "ISA.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Minda yeHeshibhoni yaoma",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.8",
            "verseOrgIds": [
              "ISA.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:8"
      },
      "items": [
        {
          "text": "uye mazambiringa eSibhima aomawo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.8",
            "verseOrgIds": [
              "ISA.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 16:8"
      },
      "items": [
        {
          "text": "Vatongi vendudzi vatsika-tsika",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.8",
            "verseOrgIds": [
              "ISA.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:8"
      },
      "items": [
        {
          "text": "mizambiringa yakaisvonaka,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.8",
            "verseOrgIds": [
              "ISA.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 16:8"
      },
      "items": [
        {
          "text": "iyo yaimbosvika kuJazeri",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.8",
            "verseOrgIds": [
              "ISA.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:8"
      },
      "items": [
        {
          "text": "uye yaitandira yakananga kurenje.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.8",
            "verseOrgIds": [
              "ISA.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 16:8"
      },
      "items": [
        {
          "text": "Mabukira ayo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.8",
            "verseOrgIds": [
              "ISA.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:8"
      },
      "items": [
        {
          "text": "aitandira kusvika kugungwa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.8",
            "verseOrgIds": [
              "ISA.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka ndinochema, sokuchema kweJazeri,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.9",
            "verseOrgIds": [
              "ISA.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:9"
      },
      "items": [
        {
          "text": "nokuda kwemizambiringa yeSibhima.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.9",
            "verseOrgIds": [
              "ISA.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 16:9"
      },
      "items": [
        {
          "text": "Haiwa Heshibhoni, haiwa Ereare,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.9",
            "verseOrgIds": [
              "ISA.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:9"
      },
      "items": [
        {
          "text": "ndichakudiridza nemisodzi!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.9",
            "verseOrgIds": [
              "ISA.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 16:9"
      },
      "items": [
        {
          "text": "Ruzha rwomufaro pamusoro pemizambiringa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.9",
            "verseOrgIds": [
              "ISA.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:9"
      },
      "items": [
        {
          "text": "yakaibva napamusoro pezvamakakohwa rwanyaradzwa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.9",
            "verseOrgIds": [
