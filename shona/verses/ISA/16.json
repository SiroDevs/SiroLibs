      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:10"
      },
      "items": [
        {
          "text": "hapana anoimba kana kuita ruzha muminda yemizambiringa;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.10",
            "verseOrgIds": [
              "ISA.16.10"
            ]
          }
        }
