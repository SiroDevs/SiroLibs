      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:11"
      },
      "items": [
        {
          "text": "mukati kati mangu munorira nokuda kweKiri Hareseti.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.11",
            "verseOrgIds": [
              "ISA.16.11"
            ]
          }
        }
      ]
