              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mufaro nokufarisisa zvabviswa paminda yemizambiringa;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.10",
            "verseOrgIds": [
              "ISA.16.10"
            ]
          }
        }
      ]
