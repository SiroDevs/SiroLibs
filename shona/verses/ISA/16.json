              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino kana Moabhu achizviratidza panzvimbo dzake dzakakwirira,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.12",
            "verseOrgIds": [
