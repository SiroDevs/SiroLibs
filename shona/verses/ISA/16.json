          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwoyo wangu unorira nokuda kwaMoabhu, kufanana nokurira kwembira,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.11",
            "verseOrgIds": [
              "ISA.16.11"
            ]
          }
        }
