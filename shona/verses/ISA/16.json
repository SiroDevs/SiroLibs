              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iri ndiro shoko rakataurwa kare naJehovha pamusoro peMoabhu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.13",
            "verseOrgIds": [
              "ISA.16.13"
            ]
