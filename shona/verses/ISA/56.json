    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ruponeso rwaVamwe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 56:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvanzi naJehovha:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.1",
            "verseOrgIds": [
              "ISA.56.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 56:1"
      },
      "items": [
        {
          "text": "\"Chengetedzai kururamisira",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.1",
            "verseOrgIds": [
              "ISA.56.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 56:1"
      },
      "items": [
        {
          "text": "mugoita zvakanaka,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.1",
            "verseOrgIds": [
              "ISA.56.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 56:1"
      },
      "items": [
        {
          "text": "nokuti ruponeso rwangu rwava pedyo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.1",
            "verseOrgIds": [
              "ISA.56.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 56:1"
      },
      "items": [
        {
          "text": "uye kururama kwangu kuchakurumidza kuratidzwa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.1",
            "verseOrgIds": [
              "ISA.56.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 56:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaropafadzwa munhu anoita izvi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.2",
            "verseOrgIds": [
              "ISA.56.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 56:2"
      },
      "items": [
        {
          "text": "munhu anozvibatisisa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.2",
            "verseOrgIds": [
              "ISA.56.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 56:2"
      },
      "items": [
        {
          "text": "anochengeta Sabata asingarisvibisi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.2",
            "verseOrgIds": [
              "ISA.56.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 56:2"
      },
      "items": [
        {
          "text": "uye anodzivisa ruoko rwake kuita chinhu chakaipa.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.2",
            "verseOrgIds": [
              "ISA.56.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 56:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutorwa akanamatira kuna Jehovha ngaarege kuti,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.3",
            "verseOrgIds": [
              "ISA.56.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 56:3"
      },
      "items": [
        {
          "text": "\"Zvirokwazvo Jehovha achandiparadzanisa navanhu vake.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.3",
            "verseOrgIds": [
              "ISA.56.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 56:3"
      },
      "items": [
        {
          "text": "Uye nomuyunaki ngaarege kugununʼuna achiti,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.3",
            "verseOrgIds": [
              "ISA.56.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 56:3"
      },
      "items": [
        {
          "text": "\"Ndinongova zvangu muti wakaoma.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.3",
            "verseOrgIds": [
              "ISA.56.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 56:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti zvanzi naJehovha:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.4",
            "verseOrgIds": [
              "ISA.56.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 56:4"
      },
      "items": [
        {
          "text": "\"Kuvayunaki vanochengeta maSabata angu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.4",
            "verseOrgIds": [
              "ISA.56.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 56:4"
      },
      "items": [
        {
          "text": "vanosarudza zvinondifadza,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.4",
            "verseOrgIds": [
              "ISA.56.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 56:4"
      },
      "items": [
        {
          "text": "uye vanobatirira pasungano yangu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.4",
            "verseOrgIds": [
              "ISA.56.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 56:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwavari ndichapa, mukati metemberi yangu namasvingo ayo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.5",
            "verseOrgIds": [
              "ISA.56.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 56:5"
      },
      "items": [
        {
          "text": "chirangaridzo nezita riri nani kupfuura vanakomana navanasikana;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.5",
            "verseOrgIds": [
              "ISA.56.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 56:5"
      },
      "items": [
        {
          "text": "ndichavapa zita risingaperi, risingazoparadzwi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.5",
            "verseOrgIds": [
              "ISA.56.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 56:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye vatorwa vakazvipira kuna Jehovha",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.6",
            "verseOrgIds": [
              "ISA.56.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 56:6"
      },
      "items": [
        {
          "text": "kuti vamushumire,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.6",
            "verseOrgIds": [
              "ISA.56.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 56:6"
      },
      "items": [
        {
          "text": "kuti vade zita raJehovha,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.6",
            "verseOrgIds": [
              "ISA.56.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 56:6"
      },
      "items": [
        {
          "text": "uye vamunamate,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.6",
            "verseOrgIds": [
              "ISA.56.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 56:6"
      },
      "items": [
        {
          "text": "vose vanochengeta Sabata",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.6",
            "verseOrgIds": [
              "ISA.56.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 56:6"
      },
      "items": [
        {
          "text": "vasingarisvibisi vachibatisisa sungano yangu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.6",
            "verseOrgIds": [
              "ISA.56.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 56:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "ivava ndichavauyisa kugomo rangu dzvene",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.7",
            "verseOrgIds": [
              "ISA.56.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 56:7"
      },
      "items": [
        {
          "text": "ndigovapa mufaro muimba yangu yokunyengetera.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.7",
            "verseOrgIds": [
              "ISA.56.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 56:7"
      },
      "items": [
        {
          "text": "Zvipiriso zvavo zvinopiswa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.7",
            "verseOrgIds": [
              "ISA.56.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 56:7"
      },
      "items": [
        {
          "text": "nezvibayiro zvichagamuchirwa paaritari yangu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.7",
            "verseOrgIds": [
              "ISA.56.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 56:7"
      },
      "items": [
        {
          "text": "nokuti imba yangu ichanzi",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.7",
            "verseOrgIds": [
              "ISA.56.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 56:7"
      },
      "items": [
        {
          "text": "imba yokunyengetera yendudzi dzose.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.7",
            "verseOrgIds": [
              "ISA.56.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 56:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ishe Jehovha anoti,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.8",
            "verseOrgIds": [
              "ISA.56.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 56:8"
      },
      "items": [
        {
          "text": "iye anounganidza vakatapwa vaIsraeri,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.8",
            "verseOrgIds": [
              "ISA.56.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 56:8"
      },
      "items": [
        {
          "text": "\"Ndichaunganidzazve vamwe kwavari,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.8",
            "verseOrgIds": [
              "ISA.56.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 56:8"
      },
      "items": [
        {
          "text": "tisingaverengeri avo vakaunganidzwa kare.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.8",
            "verseOrgIds": [
              "ISA.56.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mwari anopa mhosva kuna Vakaipa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 56:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyai, imi mose zvikara zvesango,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.9",
            "verseOrgIds": [
              "ISA.56.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 56:9"
      },
      "items": [
        {
          "text": "uyai mudye, imi mose zvikara zvesango!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.9",
            "verseOrgIds": [
              "ISA.56.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 56:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nharirire dzeIsraeri mapofu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.10",
            "verseOrgIds": [
              "ISA.56.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 56:10"
      },
      "items": [
        {
          "text": "vose vanoshayiwa zivo;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.10",
            "verseOrgIds": [
              "ISA.56.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 56:10"
      },
      "items": [
        {
          "text": "vose imbwa dzisingahukuri,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.10",
            "verseOrgIds": [
              "ISA.56.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 56:10"
      },
      "items": [
        {
          "text": "hadzigoni kuhukura;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.10",
            "verseOrgIds": [
              "ISA.56.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 56:10"
      },
      "items": [
        {
          "text": "dzinovata pose pose dzichingorota,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.10",
            "verseOrgIds": [
              "ISA.56.10"
            ]
          }
        }
      ]
    },
