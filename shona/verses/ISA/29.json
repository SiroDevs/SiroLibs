  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "29",
        "style": "c",
        "sid": "ISA 29"
      },
      "items": [
        {
          "text": "29",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nhamo kuGuta raDhavhidhi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 29:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Une nhamo iwe Arieri, Arieri,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.1",
            "verseOrgIds": [
              "ISA.29.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:1"
      },
      "items": [
        {
          "text": "guta raigara Dhavhidhi!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.1",
            "verseOrgIds": [
              "ISA.29.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 29:1"
      },
      "items": [
        {
          "text": "Wedzera gore pagore;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.1",
            "verseOrgIds": [
              "ISA.29.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:1"
      },
      "items": [
        {
          "text": "uye regai nguva dzemitambo yenyu dzirambe dziripo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.1",
            "verseOrgIds": [
              "ISA.29.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunyange zvakadaro, ndichakomba Arieri;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.2",
            "verseOrgIds": [
              "ISA.29.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:2"
      },
      "items": [
        {
          "text": "pachava nokuungudza uye nokuchema,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.2",
            "verseOrgIds": [
              "ISA.29.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:2"
      },
      "items": [
        {
          "text": "richafanana nechoto chearitari kwandiri.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.2",
            "verseOrgIds": [
              "ISA.29.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndichakukomba kumativi ose;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.3",
            "verseOrgIds": [
              "ISA.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:3"
      },
      "items": [
        {
          "text": "ndichakukomberedza neshongwe",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.3",
            "verseOrgIds": [
              "ISA.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:3"
      },
      "items": [
        {
          "text": "uye ndichavaka nhare dzokurwa newe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.3",
            "verseOrgIds": [
              "ISA.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 29:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uchadzikisirwa pasi, uchataura uri pasi;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.4",
            "verseOrgIds": [
              "ISA.29.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:4"
      },
      "items": [
        {
          "text": "kutaura kwako kuchabva muguruva.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.4",
            "verseOrgIds": [
              "ISA.29.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 29:4"
      },
      "items": [
        {
          "text": "Inzwi rako richava seresvikiro rinobva pasi muvhu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.4",
            "verseOrgIds": [
              "ISA.29.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:4"
      },
      "items": [
        {
          "text": "kutaura kwako kuchaita zevezeve kuchibva muguruva.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.4",
            "verseOrgIds": [
              "ISA.29.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi vavengi vako vazhinji vachava seguruva rakatsetseka,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.5",
            "verseOrgIds": [
              "ISA.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:5"
      },
      "items": [
        {
          "text": "vane utsinye vachafanana nehundi inopepereswa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.5",
            "verseOrgIds": [
              "ISA.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 29:5"
      },
      "items": [
        {
          "text": "Pakarepo, nokukurumidza",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.5",
            "verseOrgIds": [
              "ISA.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 29:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha Wamasimba Ose achauya",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.6",
            "verseOrgIds": [
              "ISA.29.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 29:6"
      },
      "items": [
        {
          "text": "nokutinhira nokudengenyeka kwenyika, uye nemheremhere huru,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.6",
            "verseOrgIds": [
              "ISA.29.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:6"
      },
      "items": [
        {
          "text": "nechamupupuri, nedutu guru uye nomurazvo womoto unoparadza zvose.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.6",
            "verseOrgIds": [
              "ISA.29.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 29:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo mhomho dzendudzi dzose dzakawanda dzinorwa neArieri,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.7",
            "verseOrgIds": [
              "ISA.29.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:7"
      },
      "items": [
        {
          "text": "dzinorirwisa iro nenhare dzaro uye dzinorikomba,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.7",
            "verseOrgIds": [
              "ISA.29.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 29:7"
      },
      "items": [
        {
          "text": "zvichaita sokurota,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.7",
            "verseOrgIds": [
              "ISA.29.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:7"
      },
      "items": [
        {
          "text": "nechiratidzo chinoonekwa usiku,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.7",
            "verseOrgIds": [
              "ISA.29.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 29:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "sezvinoitwa nomunhu ane nzara anorota achidya,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.8",
            "verseOrgIds": [
              "ISA.29.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:8"
      },
      "items": [
        {
          "text": "asi apepuka, anowana nzara yake ichiripo;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.8",
            "verseOrgIds": [
              "ISA.29.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 29:8"
      },
      "items": [
        {
          "text": "sezvinoita munhu ane nyota anorota achinwa mvura,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.8",
            "verseOrgIds": [
              "ISA.29.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:8"
      },
      "items": [
        {
          "text": "asi omuka achiziya, nyota yake isina kupera.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.8",
            "verseOrgIds": [
              "ISA.29.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 29:8"
      },
      "items": [
        {
          "text": "Naizvozvo ndizvo zvichaitawo marudzi ose akawanda",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.8",
            "verseOrgIds": [
              "ISA.29.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:8"
      },
      "items": [
        {
          "text": "anorwa neGomo reZioni.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.8",
            "verseOrgIds": [
              "ISA.29.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katyamarai uye mushamiswe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.9",
            "verseOrgIds": [
              "ISA.29.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:9"
      },
      "items": [
        {
          "text": "zvipofumadzei muve vasingaoni;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.9",
            "verseOrgIds": [
              "ISA.29.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 29:9"
      },
      "items": [
        {
          "text": "dhakwai asi kwete newaini;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.9",
            "verseOrgIds": [
              "ISA.29.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:9"
      },
      "items": [
        {
          "text": "dzedzerekai asi kwete nedoro.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.9",
            "verseOrgIds": [
              "ISA.29.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 29:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha akauyisa pamusoro penyu hope huru;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.10",
            "verseOrgIds": [
              "ISA.29.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:10"
      },
      "items": [
        {
          "text": "Akafukidza meso enyu, vaprofita;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.10",
            "verseOrgIds": [
              "ISA.29.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:10"
      },
      "items": [
        {
          "text": "akafukidza misoro yenyu, vaoni.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.10",
            "verseOrgIds": [
              "ISA.29.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti kwamuri, chiratidzo ichi hachizi chinhu asi mashoko akanamirwa murugwaro. Uye kana mukapa rugwaro kuno mumwe munhu anogona kuverenga, mukati kwaari, \"Ndapota, verenga izvi,\" achapindura achiti, \"Handikwanisi, nokuti rwakanamirwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.11",
            "verseOrgIds": [
              "ISA.29.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 29:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana kuti mukapa rugwaro kuno mumwe asingagoni kuverenga, mukati kwaari, \"Ndapota, verenga izvi,\" achapindura achiti, \"Handigoni kuverenga.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.12",
            "verseOrgIds": [
              "ISA.29.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 29:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ishe anoti:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.13",
            "verseOrgIds": [
              "ISA.29.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 29:13"
      },
      "items": [
        {
          "text": "\"Vanhu ava vanoswedera kwandiri nemiromo yavo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.13",
            "verseOrgIds": [
              "ISA.29.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
