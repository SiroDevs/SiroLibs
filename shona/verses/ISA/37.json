          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo Senakeribhi mambo weAsiria akaputsa musasa. Akadzokera kuNinevhe akandogara ikoko.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.37",
            "verseOrgIds": [
              "ISA.37.37"
            ]
          }
        }
