  "verseCount": 11,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "57",
        "style": "c",
        "sid": "PSA 57"
      },
      "items": [
        {
          "text": "57",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Pisarema 57",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Kumutungamiri wokuimba namaimbiro okuti, \"Musaparadza.\" Pisarema raDhavhidhi. Rwiyo rweMikitami. Paakatiza kubva kuna Sauro akapinda mubako.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 57:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinzwirei ngoni, imi Mwari, ndinzwirei ngoni,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.1",
            "verseOrgIds": [
              "PSA.57.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 57:1"
      },
      "items": [
        {
          "text": "nokuti mweya wangu unovanda mamuri.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.1",
            "verseOrgIds": [
              "PSA.57.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 57:1"
      },
      "items": [
        {
          "text": "Ndichavanda mumumvuri wamapapiro enyu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.1",
            "verseOrgIds": [
              "PSA.57.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 57:1"
      },
      "items": [
        {
          "text": "kusvikira njodzi yapfuura.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.1",
            "verseOrgIds": [
              "PSA.57.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 57:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinodanidzira kuna Mwari Wokumusoro-soro,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.2",
            "verseOrgIds": [
              "PSA.57.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 57:2"
      },
      "items": [
        {
          "text": "kuna Mwari anozadzisa chinangwa chake kwandiri.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.2",
            "verseOrgIds": [
              "PSA.57.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 57:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anotuma kubva kudenga agondiponesa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.3",
            "verseOrgIds": [
              "PSA.57.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 57:3"
      },
      "items": [
        {
          "text": "achituka vaya vanondidzingirira nehasha;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.3",
            "verseOrgIds": [
              "PSA.57.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sera",
              "type": "text",
              "attrs": {
                "verseId": "PSA.57.3",
                "verseOrgIds": [
                  "PSA.57.4"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 57:3"
      },
      "items": [
        {
          "text": "Mwari anotumira rudo rwake nokutendeka kwake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.3",
            "verseOrgIds": [
              "PSA.57.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 57:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndiri pakati peshumba;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.4",
            "verseOrgIds": [
              "PSA.57.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 57:4"
      },
      "items": [
        {
          "text": "ndinovata pakati pemhuka dzinokara,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.4",
            "verseOrgIds": [
              "PSA.57.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 57:4"
      },
      "items": [
        {
          "text": "ivo vanhu vane meno amapfumo nemiseve,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.4",
            "verseOrgIds": [
              "PSA.57.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 57:4"
      },
      "items": [
        {
          "text": "vane ndimi dzinopinza seminondo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.4",
            "verseOrgIds": [
              "PSA.57.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 57:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kudzwai, imi Mwari, pamusoro pamatenga;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.5",
            "verseOrgIds": [
              "PSA.57.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 57:5"
      },
      "items": [
        {
          "text": "kubwinya kwenyu ngakuve pamusoro penyika yose.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.5",
            "verseOrgIds": [
              "PSA.57.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sera",
              "type": "text",
              "attrs": {
                "verseId": "PSA.57.5",
                "verseOrgIds": [
                  "PSA.57.6"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 57:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanowaririra tsoka dzangu mimbure,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.6",
            "verseOrgIds": [
              "PSA.57.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 57:6"
      },
      "items": [
        {
          "text": "ndakakotamiswa pasi nenhamo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.6",
            "verseOrgIds": [
              "PSA.57.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 57:6"
      },
      "items": [
        {
          "text": "Vakachera gomba panzira yangu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.6",
            "verseOrgIds": [
              "PSA.57.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 57:6"
      },
      "items": [
        {
          "text": "asi vakawiramo vamene.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.6",
            "verseOrgIds": [
              "PSA.57.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sera",
              "type": "text",
              "attrs": {
                "verseId": "PSA.57.6",
                "verseOrgIds": [
                  "PSA.57.7"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 57:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwoyo wangu wakasimba, Mwari wangu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.7",
            "verseOrgIds": [
              "PSA.57.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 57:7"
      },
      "items": [
        {
          "text": "mwoyo wangu wakasimba;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.7",
            "verseOrgIds": [
              "PSA.57.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 57:7"
      },
      "items": [
        {
          "text": "ndichaimba uye ndichaimba rwiyo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.7",
            "verseOrgIds": [
              "PSA.57.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 57:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chimuka iwe mweya wangu!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.8",
            "verseOrgIds": [
              "PSA.57.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 57:8"
      },
      "items": [
        {
          "text": "Mukai imi mutengeranwa nembira!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.8",
            "verseOrgIds": [
              "PSA.57.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 57:8"
      },
      "items": [
        {
          "text": "Ini ndichamutsa mambakwedza.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.8",
            "verseOrgIds": [
              "PSA.57.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 57:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndichakurumbidzai imi, iyemi Ishe, pakati pendudzi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.9",
            "verseOrgIds": [
              "PSA.57.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 57:9"
      },
      "items": [
        {
          "text": "ndichakuimbirai pakati pamarudzi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.9",
            "verseOrgIds": [
              "PSA.57.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 57:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti rudo rwenyu rukuru, runosvika kudenga denga;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.10",
            "verseOrgIds": [
              "PSA.57.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 57:10"
      },
      "items": [
        {
          "text": "kutendeka kwenyu kunosvika kumusoro.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.57.10",
            "verseOrgIds": [
              "PSA.57.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
