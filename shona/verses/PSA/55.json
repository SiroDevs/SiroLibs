  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "55",
        "style": "c",
        "sid": "PSA 55"
      },
      "items": [
        {
          "text": "55",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Pisarema 55",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Kumutungamiri wokuimba nemitengeranwa ine hungiso. Rwiyo rweMasikiri rwaDhavhidhi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 55:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rerekerai nzeve yenyu kumunyengetero wangu, imi Mwari;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.1",
            "verseOrgIds": [
              "PSA.55.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 55:1"
      },
      "items": [
        {
          "text": "regai kushaya hanya nokukumbira kwangu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.1",
            "verseOrgIds": [
              "PSA.55.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 55:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndinzwei, uye ndipindureiwo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.2",
            "verseOrgIds": [
              "PSA.55.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 55:2"
      },
      "items": [
        {
          "text": "Pfungwa dzangu dzinondinetsa uye ndiri kushushikana,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.2",
            "verseOrgIds": [
              "PSA.55.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 55:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "pandinonzwa inzwi romuvengi wangu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.3",
            "verseOrgIds": [
              "PSA.55.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 55:3"
      },
      "items": [
        {
          "text": "pandinodzvokorwa navakaipa; nokuti vanodururira matambudziko pamusoro pangu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.3",
            "verseOrgIds": [
              "PSA.55.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 55:3"
      },
      "items": [
        {
          "text": "uye vanondituka mukutsamwa kwavo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.3",
            "verseOrgIds": [
              "PSA.55.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 55:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwoyo wangu unorwadziwa mukati mangu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.4",
            "verseOrgIds": [
              "PSA.55.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 55:4"
      },
      "items": [
        {
          "text": "kutyisa kworufu kunondiwira.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.4",
            "verseOrgIds": [
              "PSA.55.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 55:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutya nokudedera zvakandibata;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.5",
            "verseOrgIds": [
              "PSA.55.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 55:5"
      },
      "items": [
        {
          "text": "kutya kukuru kwakandifukidza.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.5",
            "verseOrgIds": [
              "PSA.55.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 55:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ini ndakati, \"Haiwa, dai ndina mapapiro enjiva!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.6",
            "verseOrgIds": [
              "PSA.55.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 55:6"
      },
      "items": [
        {
          "text": "Ndaibhururukira kure ndikandozorora hangu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.6",
            "verseOrgIds": [
              "PSA.55.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 55:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndaitizira kure kwazvo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.7",
            "verseOrgIds": [
              "PSA.55.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 55:7"
      },
      "items": [
        {
          "text": "ndikandogara mugwenga;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.7",
            "verseOrgIds": [
              "PSA.55.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sera",
              "type": "text",
              "attrs": {
                "verseId": "PSA.55.7",
                "verseOrgIds": [
                  "PSA.55.8"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 55:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndaikurumidza kundovanda panzvimbo yangu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.8",
            "verseOrgIds": [
              "PSA.55.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 55:8"
      },
      "items": [
        {
          "text": "kure nemafungu nedutu.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.8",
            "verseOrgIds": [
              "PSA.55.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 55:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyonganisai vakaipa, imi Ishe, kanganisai mutauro wavo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.9",
            "verseOrgIds": [
              "PSA.55.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 55:9"
      },
      "items": [
        {
          "text": "nokuti ndinoona mhirizhonga nokurwa muguta.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.9",
            "verseOrgIds": [
              "PSA.55.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 55:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Masikati nousiku vanopoterera masvingo aro chinyararire;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.10",
            "verseOrgIds": [
              "PSA.55.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 55:10"
      },
      "items": [
        {
          "text": "utsinye nokumanikidza zviri mukati maro.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.10",
            "verseOrgIds": [
              "PSA.55.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 55:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Masimba okuparadza azere muguta;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.11",
            "verseOrgIds": [
              "PSA.55.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 55:11"
      },
      "items": [
        {
          "text": "kutyisidzira nenhema hazvibvi munzira dzaro.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.11",
            "verseOrgIds": [
              "PSA.55.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 55:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dai ndatukwa nomuvengi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.12",
            "verseOrgIds": [
              "PSA.55.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 55:12"
      },
      "items": [
        {
          "text": "ndaigona kushinga hangu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.12",
            "verseOrgIds": [
              "PSA.55.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 55:12"
      },
      "items": [
        {
          "text": "dai muvengi aindimukira,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.12",
            "verseOrgIds": [
              "PSA.55.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 55:12"
      },
      "items": [
        {
          "text": "ndaigona kumuvanda hangu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.12",
            "verseOrgIds": [
              "PSA.55.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 55:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi ndiwe, munhu akaita seni,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.13",
            "verseOrgIds": [
              "PSA.55.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 55:13"
      },
      "items": [
        {
          "text": "mumwe wangu, shamwari yangu yapedyo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.13",
            "verseOrgIds": [
              "PSA.55.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 55:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "yandaimbofarira kuwadzana nayo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.14",
            "verseOrgIds": [
              "PSA.55.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 55:14"
      },
      "items": [
        {
          "text": "pataifamba navazhinji mumba maMwari.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.14",
            "verseOrgIds": [
              "PSA.55.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 55:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rufu ngaruwane vavengi vangu vasingafungiri;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.15",
            "verseOrgIds": [
              "PSA.55.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 55:15"
      },
      "items": [
        {
          "text": "ngavaburukire muguva vari vapenyu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.15",
            "verseOrgIds": [
              "PSA.55.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 55:15"
      },
      "items": [
        {
          "text": "nokuti kuipa kwakawana pokugara pakati pavo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.15",
            "verseOrgIds": [
              "PSA.55.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 55:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi ini ndinodana kuna Mwari,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.16",
            "verseOrgIds": [
              "PSA.55.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 55:16"
      },
      "items": [
        {
          "text": "uye Jehovha anondiponesa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.16",
            "verseOrgIds": [
              "PSA.55.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
