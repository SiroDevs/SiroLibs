    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndudzi dzinoitireiko bope?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.1",
            "verseOrgIds": [
              "PSA.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 2:1"
      },
      "items": [
        {
          "text": "Uye vanhu vanofungireiko zvisina maturo?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.1",
            "verseOrgIds": [
              "PSA.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Madzimambo enyika azvigadzirira",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.2",
            "verseOrgIds": [
              "PSA.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 2:2"
      },
      "items": [
        {
          "text": "uye vabati vanoungana pamwe chete",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.2",
            "verseOrgIds": [
              "PSA.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 2:2"
      },
      "items": [
        {
          "text": "kuti vazorwa naJehovha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.2",
            "verseOrgIds": [
              "PSA.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 2:2"
      },
      "items": [
        {
          "text": "uye kuti vazorwisa Muzodziwa Wake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.2",
            "verseOrgIds": [
              "PSA.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanoti, \"Ngatidamburei ngetani dzavo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.3",
            "verseOrgIds": [
              "PSA.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 2:3"
      },
      "items": [
        {
          "text": "tigorasa mabote avo.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.3",
            "verseOrgIds": [
              "PSA.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye agere pachigaro choushe chokudenga anoseka;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.4",
            "verseOrgIds": [
              "PSA.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 2:4"
      },
      "items": [
        {
          "text": "Ishe anovadadira.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.4",
            "verseOrgIds": [
              "PSA.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo anovatuka mukutsamwa kwake",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.5",
            "verseOrgIds": [
              "PSA.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 2:5"
      },
      "items": [
        {
          "text": "uye anovavhundutsa muhasha dzake, achiti,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.5",
            "verseOrgIds": [
              "PSA.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndakagadza Mambo wangu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.6",
            "verseOrgIds": [
              "PSA.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 2:6"
      },
      "items": [
        {
          "text": "paZioni, gomo rangu dzvene.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.6",
            "verseOrgIds": [
              "PSA.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndichaparidza chirevo chaJehovha, ndichiti:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.7",
            "verseOrgIds": [
              "PSA.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 2:7"
      },
      "items": [
        {
          "text": "Iye akati kwandiri, \"Ndiwe Mwanakomana wangu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.7",
            "verseOrgIds": [
              "PSA.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 2:7"
      },
      "items": [
        {
          "text": "nhasi ndava Baba vako.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.7",
            "verseOrgIds": [
              "PSA.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumbira kwandiri,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.8",
            "verseOrgIds": [
              "PSA.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 2:8"
      },
      "items": [
        {
          "text": "uye ndichaita kuti ndudzi dzive nhaka yako,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.8",
            "verseOrgIds": [
              "PSA.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 2:8"
      },
      "items": [
        {
          "text": "migumo yenyika ive yako.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.8",
            "verseOrgIds": [
              "PSA.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uchavatonga netsvimbo yesimbi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.9",
            "verseOrgIds": [
              "PSA.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 2:9"
      },
      "items": [
        {
          "text": "uchavaputsa kuita zvimedu zvimedu sehari.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.9",
            "verseOrgIds": [
              "PSA.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo, imi madzimambo, ngwarai;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.10",
            "verseOrgIds": [
              "PSA.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 2:10"
      },
      "items": [
        {
          "text": "munyeverwe, imi vabati venyika.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.10",
            "verseOrgIds": [
              "PSA.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shumirai Jehovha nokutya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.11",
            "verseOrgIds": [
              "PSA.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 2:11"
      },
      "items": [
        {
          "text": "uye mufare nokudedera.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.11",
            "verseOrgIds": [
              "PSA.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsvodai Mwanakomana, kuti arege kutsamwa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.12",
            "verseOrgIds": [
              "PSA.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 2:12"
      },
      "items": [
        {
          "text": "mukazoparadzwa munzira yenyu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.12",
            "verseOrgIds": [
              "PSA.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 2:12"
      },
      "items": [
        {
          "text": "nokuti hasha dzake dzingakurumidza kumuka.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.12",
            "verseOrgIds": [
              "PSA.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 2:12"
      },
      "items": [
        {
          "text": "Vakaropafadzwa vose vanovanda maari.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.12",
            "verseOrgIds": [
              "PSA.2.12"
            ]
          }
        }
      ]
    }
