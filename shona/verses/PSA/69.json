  "verseCount": 36,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "69",
        "style": "c",
        "sid": "PSA 69"
      },
      "items": [
        {
          "text": "69",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Pisarema 69",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Kumutungamiri wokuimba namaimbirwo a\"Maruva eMahapa.\" Pisarema raDhavhidhi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 69:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndiponesei, imi Mwari,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.1",
            "verseOrgIds": [
              "PSA.69.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 69:1"
      },
      "items": [
        {
          "text": "nokuti mvura zhinji yakwira kusvikira pamutsipa wangu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.1",
            "verseOrgIds": [
              "PSA.69.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 69:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinonyura munhope yakadzika,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.2",
            "verseOrgIds": [
              "PSA.69.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 69:2"
      },
      "items": [
        {
          "text": "pasina pangatsika makumbo angu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.2",
            "verseOrgIds": [
              "PSA.69.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 69:2"
      },
      "items": [
        {
          "text": "Ndapinda mumvura yakadzika;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.2",
            "verseOrgIds": [
              "PSA.69.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 69:2"
      },
      "items": [
        {
          "text": "ndafukidzwa namafashamu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.2",
            "verseOrgIds": [
              "PSA.69.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 69:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndaneta nokuridza mhere yokuti ndibatsirwe;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.3",
            "verseOrgIds": [
              "PSA.69.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 69:3"
      },
      "items": [
        {
          "text": "huro dzangu dzaoma,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.3",
            "verseOrgIds": [
              "PSA.69.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 69:3"
      },
      "items": [
        {
          "text": "meso angu aneta",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.3",
            "verseOrgIds": [
              "PSA.69.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 69:3"
      },
      "items": [
        {
          "text": "nokumirira Mwari wangu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.3",
            "verseOrgIds": [
              "PSA.69.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 69:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanondivenga ndisina mhosva vakawanda",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.4",
            "verseOrgIds": [
              "PSA.69.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 69:4"
      },
      "items": [
        {
          "text": "kupfuura bvudzi romusoro wangu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.4",
            "verseOrgIds": [
              "PSA.69.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 69:4"
      },
      "items": [
        {
          "text": "vanondivenga ndisina mhosva vazhinji, avo vanotsvaka kundiparadza. Ndinomanikidzwa kudzosera zvandisina kuba.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.4",
            "verseOrgIds": [
              "PSA.69.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 69:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munoziva upenzi hwangu, imi Mwari;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.5",
            "verseOrgIds": [
              "PSA.69.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 69:5"
      },
      "items": [
        {
          "text": "mhaka yangu haina kuvanzika kwamuri.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.5",
            "verseOrgIds": [
              "PSA.69.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 69:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vaya vane tariro mamuri",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.6",
            "verseOrgIds": [
              "PSA.69.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 69:6"
      },
      "items": [
        {
          "text": "ngavarege kunyadziswa nokuda kwangu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.6",
            "verseOrgIds": [
              "PSA.69.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 69:6"
      },
      "items": [
        {
          "text": "haiwa Ishe, Jehovha Wamasimba Ose;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.6",
            "verseOrgIds": [
              "PSA.69.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 69:6"
      },
      "items": [
        {
          "text": "vanokutsvakai",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.6",
            "verseOrgIds": [
              "PSA.69.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 69:6"
      },
      "items": [
        {
          "text": "ngavarege kunyadziswa nokuda kwangu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.6",
            "verseOrgIds": [
              "PSA.69.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 69:6"
      },
      "items": [
        {
          "text": "haiwa Mwari waIsraeri.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.6",
            "verseOrgIds": [
              "PSA.69.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 69:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti ndinotsunga kusekwa hangu nokuda kwenyu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.7",
            "verseOrgIds": [
              "PSA.69.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 69:7"
      },
      "items": [
        {
          "text": "uye nyadzi dzafukidza chiso changu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.7",
            "verseOrgIds": [
              "PSA.69.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 69:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndiri mutorwa kuhama dzangu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.8",
            "verseOrgIds": [
              "PSA.69.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 69:8"
      },
      "items": [
        {
          "text": "nomweni kuvanakomana vamai vangu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.8",
            "verseOrgIds": [
              "PSA.69.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 69:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "nokuti kushingairira imba yenyu kwandipedza,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.9",
            "verseOrgIds": [
              "PSA.69.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 69:9"
      },
      "items": [
        {
          "text": "uye kutuka kwaavo vanokutukai kunowira pamusoro pangu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.9",
            "verseOrgIds": [
              "PSA.69.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 69:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pandinochema uye ndichitsanya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.10",
            "verseOrgIds": [
              "PSA.69.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 69:10"
      },
      "items": [
        {
          "text": "ndinofanira kushinga pakusekwa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.10",
            "verseOrgIds": [
              "PSA.69.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 69:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "pandinofuka nguo dzamasaga,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.11",
            "verseOrgIds": [
              "PSA.69.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 69:11"
      },
      "items": [
        {
          "text": "vanhu vanondiita shumo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.11",
            "verseOrgIds": [
              "PSA.69.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 69:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vaya vanogara pasuo vanondiseka,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.12",
            "verseOrgIds": [
              "PSA.69.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 69:12"
      },
      "items": [
        {
          "text": "uye ndiri rwiyo rwezvidhakwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.12",
            "verseOrgIds": [
              "PSA.69.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 69:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi ndinonyengetera kwamuri, imi Mwari,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.13",
            "verseOrgIds": [
              "PSA.69.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 69:13"
      },
      "items": [
        {
          "text": "panguva inokufadzai;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.13",
            "verseOrgIds": [
              "PSA.69.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 69:13"
      },
      "items": [
        {
          "text": "murudo rwenyu rukuru, imi Mwari,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.13",
            "verseOrgIds": [
              "PSA.69.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 69:13"
      },
      "items": [
        {
          "text": "ndipindurei noruponeso rwenyu rwechokwadi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.13",
            "verseOrgIds": [
              "PSA.69.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 69:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinunurei mumatope,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.14",
            "verseOrgIds": [
              "PSA.69.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 69:14"
      },
      "items": [
        {
          "text": "musandirega ndichinyura;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.14",
            "verseOrgIds": [
              "PSA.69.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 69:14"
      },
