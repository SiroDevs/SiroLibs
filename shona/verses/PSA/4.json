  "verseCount": 8,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "PSA 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Pisarema 4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Kumutungamiri wenziyo nemitengeranwa. Pisarema raDhavhidhi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipindurei pandinodana kwamuri,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.1",
            "verseOrgIds": [
              "PSA.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 4:1"
      },
      "items": [
        {
          "text": "imi Mwari wangu makarurama.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.1",
            "verseOrgIds": [
              "PSA.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 4:1"
      },
      "items": [
        {
          "text": "Ndisunungurei pakutambudzika kwangu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.1",
            "verseOrgIds": [
              "PSA.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 4:1"
      },
      "items": [
        {
          "text": "ndinzwirei ngoni uye munzwe munyengetero wangu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.1",
            "verseOrgIds": [
              "PSA.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nhai imi vanhu, muchashandura kukudzwa kwangu kukava chinyadziso kusvikira riniko?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.2",
            "verseOrgIds": [
              "PSA.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 4:2"
      },
      "items": [
        {
          "text": "Muchada kutsauswa nokutsvaka vamwari venhema kusvikira riniko?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.2",
            "verseOrgIds": [
              "PSA.4.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sera",
              "type": "text",
              "attrs": {
                "verseId": "PSA.4.2",
                "verseOrgIds": [
                  "PSA.4.3"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zivai kuti Jehovha akazvitsaurira vanomuda;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.3",
            "verseOrgIds": [
              "PSA.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 4:3"
      },
      "items": [
        {
          "text": "Jehovha achandinzwa pandinodana kwaari.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.3",
            "verseOrgIds": [
              "PSA.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakutsamwa kwenyu, regai kutadza;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.4",
            "verseOrgIds": [
              "PSA.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 4:4"
      },
      "items": [
        {
          "text": "pamunenge muri pamibhedha yenyu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.4",
            "verseOrgIds": [
              "PSA.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 4:4"
      },
      "items": [
        {
          "text": "nzverai mwoyo yenyu uye munyarare.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.4",
            "verseOrgIds": [
              "PSA.4.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sera",
              "type": "text",
              "attrs": {
                "verseId": "PSA.4.4",
                "verseOrgIds": [
                  "PSA.4.5"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipai zvibayiro zvakarurama",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.5",
            "verseOrgIds": [
              "PSA.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 4:5"
      },
      "items": [
        {
          "text": "uye muvimbe naJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.5",
            "verseOrgIds": [
              "PSA.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vazhinji vanobvunza vachiti, \"Ndianiko angatiratidza chakanaka?\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.6",
            "verseOrgIds": [
              "PSA.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 4:6"
      },
      "items": [
        {
          "text": "Chiedza chechiso chenyu ngachipenye pamusoro pedu, imi Jehovha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.6",
            "verseOrgIds": [
              "PSA.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makazadza mwoyo wangu nomufaro mukuru",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.7",
            "verseOrgIds": [
              "PSA.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 4:7"
      },
      "items": [
        {
          "text": "kupfuura zviyo zvavo newaini yavo itsva yakawanda.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.7",
            "verseOrgIds": [
              "PSA.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndichavata pasi ndigokotsira norugare,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.8",
            "verseOrgIds": [
              "PSA.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 4:8"
      },
      "items": [
        {
          "text": "nokuti imi moga, Jehovha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.8",
            "verseOrgIds": [
              "PSA.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 4:8"
      },
      "items": [
        {
          "text": "munoita kuti ndigare pakasimba.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.8",
            "verseOrgIds": [
              "PSA.4.9"
            ]
          }
        }
      ]
    }
  ],
