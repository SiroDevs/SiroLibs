    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Pisarema 90",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Munyengetero waMozisi munhu waMwari.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 90:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha, imi makava ugaro hwedu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.1",
            "verseOrgIds": [
              "PSA.90.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 90:1"
      },
      "items": [
        {
          "text": "kuzvizvarwa zvose.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.1",
            "verseOrgIds": [
              "PSA.90.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 90:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makomo asati azvarwa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.2",
            "verseOrgIds": [
              "PSA.90.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 90:2"
      },
      "items": [
        {
          "text": "uye musati mabudisa nyika nepasi rose,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.2",
            "verseOrgIds": [
              "PSA.90.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 90:2"
      },
      "items": [
        {
          "text": "kubva pakusingaperi kusvikira pakusingaperi muri Mwari.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.2",
            "verseOrgIds": [
              "PSA.90.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 90:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munodzosera vanhu kuguruva zvakare, muchiti,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.3",
            "verseOrgIds": [
              "PSA.90.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 90:3"
      },
      "items": [
        {
          "text": "\"Dzokerai kuguruva, imi vanakomana vavanhu.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.3",
            "verseOrgIds": [
              "PSA.90.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 90:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti pamberi penyu makore chiuru",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.4",
            "verseOrgIds": [
              "PSA.90.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 90:4"
      },
      "items": [
        {
          "text": "akangofanana nezuva richangopfuura,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.4",
            "verseOrgIds": [
              "PSA.90.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 90:4"
      },
      "items": [
        {
          "text": "kana senguva yokurinda usiku.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.4",
            "verseOrgIds": [
              "PSA.90.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 90:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munokukura vanhu pakuvata kworufu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.5",
            "verseOrgIds": [
              "PSA.90.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 90:5"
      },
      "items": [
        {
          "text": "vakaita sebundo idzva ramangwanani,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.5",
            "verseOrgIds": [
              "PSA.90.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 90:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "kunyange richimera riri idzva mangwanani,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.6",
            "verseOrgIds": [
              "PSA.90.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 90:6"
      },
      "items": [
        {
          "text": "nenguva yamadekwana rinenge raoma uye rasvava.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.6",
            "verseOrgIds": [
              "PSA.90.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 90:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tapera nokutsamwa kwenyu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.7",
            "verseOrgIds": [
              "PSA.90.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 90:7"
      },
      "items": [
        {
          "text": "uye tinovhundutswa nehasha dzenyu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.7",
            "verseOrgIds": [
              "PSA.90.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 90:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makaisa zvakaipa zvedu pamberi penyu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.8",
            "verseOrgIds": [
              "PSA.90.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 90:8"
      },
      "items": [
        {
          "text": "makaisa zvivi zvedu zvakavanzika muchiedza chokuvapo kwenyu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.8",
            "verseOrgIds": [
              "PSA.90.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 90:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mazuva edu ose anopfuura napasi pehasha dzenyu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.9",
            "verseOrgIds": [
              "PSA.90.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 90:9"
      },
      "items": [
        {
          "text": "tinopedza makore edu nokuchema.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.9",
            "verseOrgIds": [
              "PSA.90.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 90:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwandu hwamazuva edu hunosvika makore makumi manomwe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.10",
            "verseOrgIds": [
              "PSA.90.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 90:10"
      },
      "items": [
        {
          "text": "kana makumi masere, kana tiine simba;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.10",
            "verseOrgIds": [
              "PSA.90.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 90:10"
      },
      "items": [
        {
          "text": "kunyange zvakadaro uwandu hwawo hunongova nhamo nokusuwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.10",
            "verseOrgIds": [
              "PSA.90.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 90:10"
      },
      "items": [
        {
          "text": "nokuti anokurumidza kupfuura, uye isu tobhururuka toenda.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.10",
            "verseOrgIds": [
              "PSA.90.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 90:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndianiko anoziva simba rokutsamwa kwenyu?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.11",
            "verseOrgIds": [
              "PSA.90.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 90:11"
      },
      "items": [
        {
          "text": "Nokuti hasha dzenyu dzakakura sokutyiwa kwakakufanirai imi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.11",
            "verseOrgIds": [
              "PSA.90.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 90:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tidzidzisei kuverenga mazuva edu zvakanaka,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.12",
            "verseOrgIds": [
              "PSA.90.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 90:12"
      },
      "items": [
        {
          "text": "kuti tiwane mwoyo wouchenjeri.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.12",
            "verseOrgIds": [
              "PSA.90.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 90:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dzokai, imi Jehovha! Zvichadaro kusvikira riniko?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.13",
            "verseOrgIds": [
              "PSA.90.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 90:13"
      },
      "items": [
        {
          "text": "Ivai netsitsi pamusoro pavaranda venyu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.13",
            "verseOrgIds": [
              "PSA.90.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 90:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tigutsei mangwanani norudo rwenyu rusingaperi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.14",
            "verseOrgIds": [
              "PSA.90.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 90:14"
      },
      "items": [
        {
          "text": "kuti tigoimba nomufaro tigofara mazuva edu ose.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.14",
            "verseOrgIds": [
              "PSA.90.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 90:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tifadzei zvinoenzana namazuva amakatitambudza,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.15",
            "verseOrgIds": [
              "PSA.90.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 90:15"
      },
      "items": [
        {
          "text": "samakore mazhinji atakaona nhamo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.15",
            "verseOrgIds": [
              "PSA.90.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 90:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mabasa enyu ngaaratidzwe kuvaranda venyu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.16",
            "verseOrgIds": [
              "PSA.90.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 90:16"
      },
      "items": [
        {
          "text": "nokubwinya kwenyu kuvana vavo.",
          "type": "text",
