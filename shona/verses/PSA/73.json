        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Pisarema raAsafi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 73:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvirokwazvo Mwari akanaka kuna Israeri,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.1",
            "verseOrgIds": [
              "PSA.73.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 73:1"
      },
      "items": [
        {
          "text": "kuna avo vakachena pamwoyo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.1",
            "verseOrgIds": [
              "PSA.73.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 73:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi kana ndirini, tsoka dzangu dzakapotsa dzatsvedza;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.2",
            "verseOrgIds": [
              "PSA.73.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 73:2"
      },
      "items": [
        {
          "text": "ndakasara paduku kupunzika.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.2",
            "verseOrgIds": [
              "PSA.73.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 73:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti ndakaitira shanje vanozvikudza,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.3",
            "verseOrgIds": [
              "PSA.73.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 73:3"
      },
      "items": [
        {
          "text": "pandakaona kubudirira kwavakaipa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.3",
            "verseOrgIds": [
              "PSA.73.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 73:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Havatambudziki;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.4",
            "verseOrgIds": [
              "PSA.73.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 73:4"
      },
      "items": [
        {
          "text": "miviri yavo ino utano uye vakasimba.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.4",
            "verseOrgIds": [
              "PSA.73.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 73:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakasununguka pamitoro inowanikwa muvanhu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.5",
            "verseOrgIds": [
              "PSA.73.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 73:5"
      },
      "items": [
        {
          "text": "havatambudzwi nezvinotambudza vanhu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.5",
            "verseOrgIds": [
              "PSA.73.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 73:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo kuzvikudza ndiko ruketani rwemitsipa yavo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.6",
            "verseOrgIds": [
              "PSA.73.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 73:6"
      },
      "items": [
        {
          "text": "vanozvishongedza nechisimba.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.6",
            "verseOrgIds": [
              "PSA.73.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 73:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumwoyo yavo makasindimara munobuda chitadzo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.7",
            "verseOrgIds": [
              "PSA.73.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 73:7"
      },
      "items": [
        {
          "text": "mifungo yakaipa yendangariro dzavo haina magumo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.7",
            "verseOrgIds": [
              "PSA.73.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 73:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanoseka, uye vanotaura noutsinye mukuzvikudza kwavo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.8",
            "verseOrgIds": [
              "PSA.73.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 73:8"
      },
      "items": [
        {
          "text": "vanoti vachadzvinyirira vamwe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.8",
            "verseOrgIds": [
              "PSA.73.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 73:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miromo yavo inoti denga nderavo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.9",
            "verseOrgIds": [
              "PSA.73.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 73:9"
      },
      "items": [
        {
          "text": "uye ndimi dzavo dzinotora nyika.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.9",
            "verseOrgIds": [
              "PSA.73.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 73:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo vanhu vavo vanodzokera kwavari,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.10",
            "verseOrgIds": [
              "PSA.73.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 73:10"
      },
      "items": [
        {
          "text": "uye vanonwa mvura yakawanda.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.10",
            "verseOrgIds": [
              "PSA.73.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 73:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanoti, \"Mwari angazviziva sei?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.11",
            "verseOrgIds": [
              "PSA.73.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 73:11"
      },
      "items": [
        {
          "text": "Ko, Wokumusoro-soro ane ruzivo here?\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.11",
            "verseOrgIds": [
              "PSA.73.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 73:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndizvo zvakaita vakaipa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.12",
            "verseOrgIds": [
              "PSA.73.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 73:12"
      },
      "items": [
        {
          "text": "havana hanya nguva dzose, vanowedzera pfuma yavo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.12",
            "verseOrgIds": [
              "PSA.73.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 73:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvirokwazvo ndakanatsa mwoyo wangu, asi pasina;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.13",
            "verseOrgIds": [
              "PSA.73.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 73:13"
      },
      "items": [
        {
          "text": "ndakashamba maoko angu ndisina mhosva, asi pasina.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.13",
            "verseOrgIds": [
              "PSA.73.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 73:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zuva rose ndanga ndichitambudzwa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.14",
            "verseOrgIds": [
              "PSA.73.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 73:14"
      },
      "items": [
        {
          "text": "ndinorangwa mangwanani ose.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.14",
            "verseOrgIds": [
              "PSA.73.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 73:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dai ndakanga ndati, \"Ndichataura zvakadai,\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.15",
            "verseOrgIds": [
              "PSA.73.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 73:15"
      },
      "items": [
        {
          "text": "ndingadai ndakapandukira vana venyu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.15",
            "verseOrgIds": [
              "PSA.73.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 73:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pandakaedza kunzwisisa izvi zvose,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.16",
            "verseOrgIds": [
              "PSA.73.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 73:16"
      },
      "items": [
        {
          "text": "zvakandiremera kwazvo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.16",
            "verseOrgIds": [
              "PSA.73.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 73:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "kusvikira ndapinda munzvimbo tsvene yaMwari;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.17",
            "verseOrgIds": [
              "PSA.73.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 73:17"
      },
      "items": [
        {
          "text": "ipapo ndikazonzwisisa magumo avo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.17",
            "verseOrgIds": [
              "PSA.73.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PSA 73:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
