    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Pisarema 95",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 95:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyai, tiimbire Jehovha nomufaro;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.1",
            "verseOrgIds": [
              "PSA.95.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 95:1"
      },
      "items": [
        {
          "text": "ngatidanidzirei kuDombo roruponeso rwedu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.1",
            "verseOrgIds": [
              "PSA.95.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 95:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngatisvikei pamberi pake nokuvonga",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.2",
            "verseOrgIds": [
              "PSA.95.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 95:2"
      },
      "items": [
        {
          "text": "uye timukudze nenziyo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.2",
            "verseOrgIds": [
              "PSA.95.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 95:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti Jehovha ndiye Mwari mukuru,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.3",
            "verseOrgIds": [
              "PSA.95.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 95:3"
      },
      "items": [
        {
          "text": "Mambo mukuru pamusoro pavamwari vose.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.3",
            "verseOrgIds": [
              "PSA.95.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 95:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzvimbo dzakadzika dzapanyika dziri muruoko rwake,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.4",
            "verseOrgIds": [
              "PSA.95.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 95:4"
      },
      "items": [
        {
          "text": "uye misoro yamakomo ndeyake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.4",
            "verseOrgIds": [
              "PSA.95.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 95:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gungwa nderake, nokuti ndiye akariita,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.5",
            "verseOrgIds": [
              "PSA.95.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 95:5"
      },
      "items": [
        {
          "text": "uye maoko ake akaumba nyika yakaoma.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.5",
            "verseOrgIds": [
              "PSA.95.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 95:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyai tikotame, tinamate,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.6",
            "verseOrgIds": [
              "PSA.95.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 95:6"
      },
      "items": [
        {
          "text": "ngatipfugamei pamberi paJehovha Muiti wedu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.6",
            "verseOrgIds": [
              "PSA.95.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 95:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "nokuti ndiye Mwari wedu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.7",
            "verseOrgIds": [
              "PSA.95.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 95:7"
      },
      "items": [
        {
          "text": "uye isu tiri vanhu vanofudzwa naye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.7",
            "verseOrgIds": [
              "PSA.95.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 95:7"
      },
      "items": [
        {
          "text": "makwai anochengetwa naye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.7",
            "verseOrgIds": [
              "PSA.95.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "PSA 95:7"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 95:7"
      },
      "items": [
        {
          "text": "Nhasi kana muchinzwa inzwi rake,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.7",
            "verseOrgIds": [
              "PSA.95.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 95:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "musaomesa mwoyo yenyu sezvamakaita paMeribha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.8",
            "verseOrgIds": [
              "PSA.95.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 95:8"
      },
      "items": [
        {
          "text": "sezvamakaita pazuva riya paMasa mugwenga,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.8",
            "verseOrgIds": [
              "PSA.95.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 95:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "pandakaedzwa namadzibaba enyu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.9",
            "verseOrgIds": [
              "PSA.95.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 95:9"
      },
      "items": [
        {
          "text": "kunyange vakanga vaona zvandakanga ndaita.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.9",
            "verseOrgIds": [
              "PSA.95.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 95:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakatsamwira rudzi urwu kwamakore makumi mana;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.10",
            "verseOrgIds": [
              "PSA.95.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 95:10"
      },
      "items": [
        {
          "text": "ndakati, \"Ava vanhu vane mwoyo yakatsauka,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.10",
            "verseOrgIds": [
              "PSA.95.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 95:10"
      },
      "items": [
        {
          "text": "uye havana kuziva nzira dzangu.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.10",
            "verseOrgIds": [
              "PSA.95.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 95:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka ndakapika pakutsamwa kwangu ndikati,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.11",
            "verseOrgIds": [
              "PSA.95.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 95:11"
      },
      "items": [
        {
          "text": "\"Havangazombopindi pazororo rangu.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.11",
            "verseOrgIds": [
              "PSA.95.11"
            ]
          }
        }
      ]
    }
  ],
