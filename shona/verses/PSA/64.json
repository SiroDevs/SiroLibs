  "verseCount": 10,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "64",
        "style": "c",
        "sid": "PSA 64"
      },
      "items": [
        {
          "text": "64",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Pisarema 64",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Kumutungamiri wokuimba. Pisarema raDhavhidhi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 64:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinzweiwo, imi Mwari, pandinotaura chichemo changu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.1",
            "verseOrgIds": [
              "PSA.64.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 64:1"
      },
      "items": [
        {
          "text": "dzivirirai upenyu hwangu pakutyisidzira kwavavengi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.1",
            "verseOrgIds": [
              "PSA.64.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 64:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndivanzei pakurangana kwavakaipa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.2",
            "verseOrgIds": [
              "PSA.64.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 64:2"
      },
      "items": [
        {
          "text": "ndibve pazhowezhowe yeungano yavaiti vezvakaipa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.2",
            "verseOrgIds": [
              "PSA.64.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 64:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanorodza ndimi dzavo seminondo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.3",
            "verseOrgIds": [
              "PSA.64.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 64:3"
      },
      "items": [
        {
          "text": "uye vanonanga namashoko avo semiseve inouraya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.3",
            "verseOrgIds": [
              "PSA.64.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 64:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanopfura vari pakavanda munhu asina mhosva;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.4",
            "verseOrgIds": [
              "PSA.64.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 64:4"
      },
      "items": [
        {
          "text": "vanomupfura pakarepo, vasingatyi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.4",
            "verseOrgIds": [
              "PSA.64.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 64:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanokurudzira mumwe nomumwe wavo pakufunga zvakaipa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.5",
            "verseOrgIds": [
              "PSA.64.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 64:5"
      },
      "items": [
        {
          "text": "vanotaura pamusoro pokuteya misungo yavo, uye vanoti,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.5",
            "verseOrgIds": [
              "PSA.64.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 64:5"
      },
      "items": [
        {
          "text": "\"Ndianiko achaiona?\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.5",
            "verseOrgIds": [
              "PSA.64.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 64:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanorangana kusaruramisira vachiti,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.6",
            "verseOrgIds": [
              "PSA.64.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 64:6"
      },
      "items": [
        {
          "text": "\"Tafunga zano rakakwana!\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.6",
            "verseOrgIds": [
              "PSA.64.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 64:6"
      },
      "items": [
        {
          "text": "Zvirokwazvo mwoyo nomurangariro womunhu zvinonyengera.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.6",
            "verseOrgIds": [
              "PSA.64.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 64:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi Mwari achavapfura nemiseve;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.7",
            "verseOrgIds": [
              "PSA.64.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 64:7"
      },
      "items": [
        {
          "text": "pakarepo vachawira pasi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.7",
            "verseOrgIds": [
              "PSA.64.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 64:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achaita kuti ndimi dzavo dzivashandukire,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.8",
            "verseOrgIds": [
              "PSA.64.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 64:8"
      },
      "items": [
        {
          "text": "uye achavaisa pakuparadzwa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.8",
            "verseOrgIds": [
              "PSA.64.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 64:8"
      },
      "items": [
        {
          "text": "vose vanovaona vachavadzungudzira misoro vachivaseka.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.8",
            "verseOrgIds": [
              "PSA.64.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 64:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Marudzi ose avanhu achatya;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.9",
            "verseOrgIds": [
              "PSA.64.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 64:9"
      },
      "items": [
        {
          "text": "achaparidza mabasa aMwari,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.9",
            "verseOrgIds": [
              "PSA.64.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 64:9"
      },
      "items": [
        {
          "text": "uye achafungisisa zvaakaita.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.9",
            "verseOrgIds": [
              "PSA.64.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 64:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakarurama ngavafare muna Jehovha",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.10",
            "verseOrgIds": [
              "PSA.64.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 64:10"
      },
      "items": [
        {
          "text": "uye vavande maari;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.10",
            "verseOrgIds": [
              "PSA.64.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 64:10"
      },
      "items": [
        {
          "text": "vose vakarurama mumwoyo ngavamurumbidze!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.64.10",
            "verseOrgIds": [
              "PSA.64.11"
            ]
          }
        }
      ]
    }
  ],
