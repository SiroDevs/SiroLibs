      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Pisarema raDhavhidhi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 103:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rumbidza Jehovha, iwe mweya wangu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.1",
            "verseOrgIds": [
              "PSA.103.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 103:1"
      },
      "items": [
        {
          "text": "zvose zviri mukati mangu, ngazvirumbidze zita rake dzvene.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.1",
            "verseOrgIds": [
              "PSA.103.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 103:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rumbidza Jehovha, iwe mweya wangu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.2",
            "verseOrgIds": [
              "PSA.103.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 103:2"
      },
      "items": [
        {
          "text": "uye urege kukanganwa mikomborero yake yose,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.2",
            "verseOrgIds": [
              "PSA.103.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 103:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "iye anokanganwira zvivi zvako zvose,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.3",
            "verseOrgIds": [
              "PSA.103.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 103:3"
      },
      "items": [
        {
          "text": "uye anoporesa kurwara kwako kwose,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.3",
            "verseOrgIds": [
              "PSA.103.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 103:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "anodzikinura upenyu hwako kubva pagomba,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.4",
            "verseOrgIds": [
              "PSA.103.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 103:4"
      },
      "items": [
        {
          "text": "uye anokushongedza korona yorudo netsitsi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.4",
            "verseOrgIds": [
              "PSA.103.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 103:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "anogutsa zvido zvako nezvinhu zvakanaka,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.5",
            "verseOrgIds": [
              "PSA.103.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 103:5"
      },
      "items": [
        {
          "text": "kuti uduku hwako huvandudzwe sohwegondo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.5",
            "verseOrgIds": [
              "PSA.103.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 103:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha anoita zvakarurama,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.6",
            "verseOrgIds": [
              "PSA.103.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 103:6"
      },
      "items": [
        {
          "text": "uye anoruramisira vose vakadzvinyirirwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.6",
            "verseOrgIds": [
              "PSA.103.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 103:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akazivisa nzira dzake kuna Mozisi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.7",
            "verseOrgIds": [
              "PSA.103.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 103:7"
      },
      "items": [
        {
          "text": "namabasa ake kuvanhu veIsraeri:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.7",
            "verseOrgIds": [
              "PSA.103.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 103:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha ane tsitsi nenyasha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.8",
            "verseOrgIds": [
              "PSA.103.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 103:8"
      },
      "items": [
        {
          "text": "anononoka kutsamwa, azere norudo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.8",
            "verseOrgIds": [
              "PSA.103.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 103:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haangarambi achipomera mhosva,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.9",
            "verseOrgIds": [
              "PSA.103.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 103:9"
      },
      "items": [
        {
          "text": "uye haangarambi akatsamwa nokusingaperi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.9",
            "verseOrgIds": [
              "PSA.103.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 103:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "haatiitiri sezvakafanira zvivi zvedu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.10",
            "verseOrgIds": [
              "PSA.103.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 103:10"
      },
      "items": [
        {
          "text": "kana kutipa mubayiro sezvakafanira zvakaipa zvedu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.10",
            "verseOrgIds": [
              "PSA.103.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 103:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti sokukwirira kwaakaita kudenga kumusoro kwenyika,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.11",
            "verseOrgIds": [
              "PSA.103.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 103:11"
      },
      "items": [
        {
          "text": "ndizvo zvakaita kukura kworudo rwake kuna vanomutya;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.11",
            "verseOrgIds": [
              "PSA.103.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 103:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "sokuva kure kwamabvazuva namavirira,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.12",
            "verseOrgIds": [
              "PSA.103.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 103:12"
      },
      "items": [
        {
          "text": "saizvozvo akabvisa kudarika kwedu kwatiri.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.12",
            "verseOrgIds": [
              "PSA.103.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 103:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sokunzwira tsitsi kunoita baba vana vavo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.13",
            "verseOrgIds": [
              "PSA.103.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 103:13"
      },
      "items": [
        {
          "text": "saizvozvo Jehovha ane tsitsi pamusoro pavanomutya;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.13",
            "verseOrgIds": [
              "PSA.103.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 103:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "nokuti anoziva kuti takaumbwa sei,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.14",
            "verseOrgIds": [
              "PSA.103.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 103:14"
      },
      "items": [
        {
          "text": "anorangarira kuti tiri guruva.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.14",
            "verseOrgIds": [
              "PSA.103.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 103:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana ari munhu zvake, mazuva ake akaita souswa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.15",
            "verseOrgIds": [
              "PSA.103.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 103:15"
      },
      "items": [
        {
          "text": "anokura seruva resango;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.15",
            "verseOrgIds": [
              "PSA.103.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 103:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "mhepo inorova napamusoro paro onei raenda,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.16",
            "verseOrgIds": [
              "PSA.103.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 103:16"
      },
      "items": [
        {
          "text": "uye nzvimbo yaranga riri haicharirangaririzve.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.16",
            "verseOrgIds": [
              "PSA.103.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 103:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi kubva pakusingaperi kusvikira pakusingaperi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.17",
            "verseOrgIds": [
              "PSA.103.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 103:17"
      },
      "items": [
        {
          "text": "rudo rwaJehovha rwuri pane avo vanomutya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.17",
            "verseOrgIds": [
              "PSA.103.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 103:17"
      },
      "items": [
        {
          "text": "nokururama kwake kuvana vavana vavo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.17",
            "verseOrgIds": [
              "PSA.103.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PSA 103:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "naavo vanochengeta sungano yake",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.18",
            "verseOrgIds": [
              "PSA.103.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 103:18"
      },
      "items": [
        {
          "text": "uye vanorangarira kuita zvaakatema.",
          "type": "text",
          "attrs": {
