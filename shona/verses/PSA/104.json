    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 104:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rumbidza Jehovha, mweya wangu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.1",
            "verseOrgIds": [
              "PSA.104.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "PSA 104:1"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 104:1"
      },
      "items": [
        {
          "text": "Haiwa Jehovha Mwari wangu, muri mukuru kwazvo; makashongedzwa nokubwinya noumambo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.1",
            "verseOrgIds": [
              "PSA.104.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 104:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anozviputira muchiedza seanozviputira nenguo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.2",
            "verseOrgIds": [
              "PSA.104.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 104:2"
      },
      "items": [
        {
          "text": "anotatamura matenga kunge tende",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.2",
            "verseOrgIds": [
              "PSA.104.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 104:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye anogadzika matanda edzimba dzake dzapamusoro pamusoro pemvura yadzo zhinji.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.3",
            "verseOrgIds": [
              "PSA.104.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 104:3"
      },
      "items": [
        {
          "text": "Anoita makore ngoro dzake,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.3",
            "verseOrgIds": [
              "PSA.104.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 104:3"
      },
      "items": [
        {
          "text": "uye anokwira pamapapiro emhepo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.3",
            "verseOrgIds": [
              "PSA.104.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 104:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anoita mhepo nhume dzake,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.4",
            "verseOrgIds": [
              "PSA.104.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 104:4"
      },
      "items": [
        {
          "text": "namazhenje omoto varanda vake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.4",
            "verseOrgIds": [
              "PSA.104.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 104:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akamisa nyika pamusoro penheyo dzayo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.5",
            "verseOrgIds": [
              "PSA.104.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 104:5"
      },
      "items": [
        {
          "text": "haingatongozungunuswi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.5",
            "verseOrgIds": [
              "PSA.104.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 104:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makaifukidza nokwakadzika somunofukidza nenguo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.6",
            "verseOrgIds": [
              "PSA.104.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 104:6"
      },
      "items": [
        {
          "text": "mvura zhinji yakamira pamusoro pamakomo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.6",
            "verseOrgIds": [
              "PSA.104.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 104:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi pakutsiura kwenyu mvura zhinji yakatiza,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.7",
            "verseOrgIds": [
              "PSA.104.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 104:7"
      },
      "items": [
        {
          "text": "pakunzwa kutinhira wenyu yakatiza;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.7",
            "verseOrgIds": [
              "PSA.104.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 104:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "yakayerera napamusoro pamakomo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.8",
            "verseOrgIds": [
              "PSA.104.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 104:8"
      },
      "items": [
        {
          "text": "ikadzika nomumipata,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.8",
            "verseOrgIds": [
              "PSA.104.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 104:8"
      },
      "items": [
        {
          "text": "ichienda kunzvimbo yamakairayira.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.8",
            "verseOrgIds": [
              "PSA.104.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 104:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makatara muganhu waisingadariki;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.9",
            "verseOrgIds": [
              "PSA.104.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 104:9"
      },
      "items": [
        {
          "text": "haichazombofukidzizve nyika.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.9",
            "verseOrgIds": [
              "PSA.104.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 104:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anoita kuti matsime adire mvura mumipata;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.10",
            "verseOrgIds": [
              "PSA.104.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 104:10"
      },
      "items": [
        {
          "text": "inoyerera napakati pamakomo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.10",
            "verseOrgIds": [
              "PSA.104.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 104:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anonwisa mhuka dzose dzesango mvura;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.11",
            "verseOrgIds": [
              "PSA.104.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 104:11"
      },
      "items": [
        {
          "text": "mbizi dzinopedza nyota yadzo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.11",
            "verseOrgIds": [
              "PSA.104.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 104:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shiri dzedenga dzinovaka matendere adzo pedyo nemvura;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.12",
            "verseOrgIds": [
              "PSA.104.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 104:12"
      },
      "items": [
        {
          "text": "dzinorira dziri pakati pamatavi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.12",
            "verseOrgIds": [
              "PSA.104.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 104:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anodiridza makomo ari padzimba dzake dzapamusoro;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.13",
            "verseOrgIds": [
              "PSA.104.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 104:13"
      },
      "items": [
        {
          "text": "nyika inogutswa nezvibereko zvebasa rake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.13",
            "verseOrgIds": [
              "PSA.104.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 104:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anomeresa uswa hwemombe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.14",
            "verseOrgIds": [
              "PSA.104.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 104:14"
      },
      "items": [
        {
          "text": "nembeu kuti vanhu vasakure,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.14",
            "verseOrgIds": [
              "PSA.104.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 104:14"
      },
      "items": [
        {
          "text": "achibudisa zvokudya kubva pasi:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.14",
            "verseOrgIds": [
              "PSA.104.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 104:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "iyo waini inofadza mwoyo womunhu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.15",
            "verseOrgIds": [
              "PSA.104.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 104:15"
      },
      "items": [
        {
          "text": "namafuta anopenyesa chiso chake,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.15",
            "verseOrgIds": [
              "PSA.104.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 104:15"
      },
      "items": [
        {
          "text": "nechingwa chinosimbisa mwoyo wake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.15",
            "verseOrgIds": [
              "PSA.104.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 104:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miti yaJehovha inodiridzwa zvakanaka,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.16",
            "verseOrgIds": [
              "PSA.104.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 104:16"
      },
      "items": [
        {
          "text": "iyo misidhari yeRebhanoni yaakasima.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.16",
            "verseOrgIds": [
              "PSA.104.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 104:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shiri dzinoruka matendere adzo ipapo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.17",
            "verseOrgIds": [
              "PSA.104.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 104:17"
      },
      "items": [
        {
          "text": "dambiramurove rakaita imba yaro mumiti yomupaini.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.17",
            "verseOrgIds": [
              "PSA.104.17"
            ]
