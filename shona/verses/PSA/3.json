      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Pisarema 3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Pisarema raDhavhidhi. Panguva yaakatiza Abhusaromu mwanakomana wake.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haiwa Jehovha, vadzivisi vangu vakawanda sei!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.3.1",
            "verseOrgIds": [
              "PSA.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 3:1"
      },
      "items": [
        {
          "text": "Vakawanda sei vanondimukira!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.3.1",
            "verseOrgIds": [
              "PSA.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vazhinji vanoti kwandiri,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.3.2",
            "verseOrgIds": [
              "PSA.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 3:2"
      },
      "items": [
        {
          "text": "\"Mwari haangamudzikinuri.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.3.2",
            "verseOrgIds": [
              "PSA.3.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sera",
              "type": "text",
              "attrs": {
                "verseId": "PSA.3.2",
                "verseOrgIds": [
                  "PSA.3.3"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi imi Jehovha, muri nhoo yakandipoteredza;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.3.3",
            "verseOrgIds": [
              "PSA.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 3:3"
      },
      "items": [
        {
          "text": "munoisa rukudzo pandiri uye munosimudza musoro wangu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.3.3",
            "verseOrgIds": [
              "PSA.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuna Jehovha ndinodana nenzwi guru,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.3.4",
            "verseOrgIds": [
              "PSA.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 3:4"
      },
      "items": [
        {
          "text": "uye anondipindura ari pagomo rake dzvene.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.3.4",
            "verseOrgIds": [
              "PSA.3.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sera",
              "type": "text",
              "attrs": {
                "verseId": "PSA.3.4",
                "verseOrgIds": [
                  "PSA.3.5"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinovata pasi ndigokotsira;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.3.5",
            "verseOrgIds": [
              "PSA.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 3:5"
      },
      "items": [
        {
          "text": "ndinomukazve, nokuti Jehovha anonditsigira.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.3.5",
            "verseOrgIds": [
              "PSA.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Handizotyi makumi ezviuru",
          "type": "text",
          "attrs": {
            "verseId": "PSA.3.6",
            "verseOrgIds": [
              "PSA.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 3:6"
      },
      "items": [
        {
          "text": "vakandikomba kuti vandirwise.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.3.6",
            "verseOrgIds": [
              "PSA.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simukai, imi Jehovha!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.3.7",
            "verseOrgIds": [
              "PSA.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 3:7"
      },
      "items": [
        {
          "text": "Ndirwirei, imi Mwari wangu!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.3.7",
            "verseOrgIds": [
              "PSA.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 3:7"
      },
      "items": [
        {
          "text": "Rovai vavengi vangu vose pashaya;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.3.7",
            "verseOrgIds": [
              "PSA.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 3:7"
      },
      "items": [
        {
          "text": "gurai meno avakaipa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.3.7",
            "verseOrgIds": [
              "PSA.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rusununguko runobva kuna Jehovha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.3.8",
            "verseOrgIds": [
              "PSA.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 3:8"
      },
      "items": [
        {
          "text": "Maropafadzo enyu ngaave pamusoro pavanhu venyu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.3.8",
            "verseOrgIds": [
              "PSA.3.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sera",
              "type": "text",
              "attrs": {
                "verseId": "PSA.3.8",
                "verseOrgIds": [
                  "PSA.3.9"
                ]
              }
            }
          ]
        }
      ]
    }
