  "verseCount": 16,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "81",
        "style": "c",
        "sid": "PSA 81"
      },
      "items": [
        {
          "text": "81",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Pisarema 81",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Kumutungamiri wokuimba. Namaimbirwo egititi. Pisarema raAsafi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 81:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imbirai Mwari nomufaro iye simba redu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.1",
            "verseOrgIds": [
              "PSA.81.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 81:1"
      },
      "items": [
        {
          "text": "danidzirai kuna Mwari waJakobho!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.1",
            "verseOrgIds": [
              "PSA.81.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 81:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vambai rwiyo, muridze tambureni,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.2",
            "verseOrgIds": [
              "PSA.81.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 81:2"
      },
      "items": [
        {
          "text": "ridzai mbira dzinonakidza nomutengeranwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.2",
            "verseOrgIds": [
              "PSA.81.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 81:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ridzai runyanga rwehwai paKugara kwoMwedzi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.3",
            "verseOrgIds": [
              "PSA.81.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 81:3"
      },
      "items": [
        {
          "text": "uye pakuchena kwomwedzi, pazuva roMutambo wedu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.3",
            "verseOrgIds": [
              "PSA.81.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 81:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ichi ndicho chirevo chaIsraeri,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.4",
            "verseOrgIds": [
              "PSA.81.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 81:4"
      },
      "items": [
        {
          "text": "chakatarwa naMwari waJakobho.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.4",
            "verseOrgIds": [
              "PSA.81.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 81:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akachisimbisa somutemo wakanyorwa waJosefa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.5",
            "verseOrgIds": [
              "PSA.81.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 81:5"
      },
      "items": [
        {
          "text": "panguva yaakandorwa neIjipiti,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.5",
            "verseOrgIds": [
              "PSA.81.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 81:5"
      },
      "items": [
        {
          "text": "uko kwatakanzwa mutauro watakanga tisinganzwisisi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.5",
            "verseOrgIds": [
              "PSA.81.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 81:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anoti, \"Ndakabvisa mutoro pamapfudzi avo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.6",
            "verseOrgIds": [
              "PSA.81.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 81:6"
      },
      "items": [
        {
          "text": "maoko avo akasunungurwa padengu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.6",
            "verseOrgIds": [
              "PSA.81.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 81:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakutambudzika kwako wakadana ini ndikakununura,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.7",
            "verseOrgIds": [
              "PSA.81.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 81:7"
      },
      "items": [
        {
          "text": "ndakakupindura ndiri mugore rokutinhira;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.7",
            "verseOrgIds": [
              "PSA.81.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 81:7"
      },
      "items": [
        {
          "text": "ndakakuedza pamvura zhinji yeMeribha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.7",
            "verseOrgIds": [
              "PSA.81.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sera",
              "type": "text",
              "attrs": {
                "verseId": "PSA.81.7",
                "verseOrgIds": [
                  "PSA.81.8"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 81:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Inzwai, imi vanhu vangu, uye ndichakuyambirai,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.8",
            "verseOrgIds": [
              "PSA.81.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 81:8"
      },
      "items": [
        {
          "text": "kana mukada chete kunditeerera, imi Israeri!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.8",
            "verseOrgIds": [
              "PSA.81.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 81:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakati penyu ngaparege kuva namwari wavatorwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.9",
            "verseOrgIds": [
              "PSA.81.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 81:9"
      },
      "items": [
        {
          "text": "musapfugamira mwari wokumwe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.9",
            "verseOrgIds": [
              "PSA.81.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 81:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndini Jehovha Mwari wako,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.10",
            "verseOrgIds": [
              "PSA.81.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 81:10"
      },
      "items": [
        {
          "text": "akakubudisa kubva munyika yeIjipiti.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.10",
            "verseOrgIds": [
              "PSA.81.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 81:10"
      },
      "items": [
        {
          "text": "Shamisa muromo wako kwazvo, ndigouzadza.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.10",
            "verseOrgIds": [
              "PSA.81.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 81:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Asi vanhu vangu havana kuda kundinzwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.11",
            "verseOrgIds": [
              "PSA.81.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 81:11"
      },
      "items": [
        {
          "text": "Israeri haana kuda kuzviisa pasi pangu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.11",
            "verseOrgIds": [
              "PSA.81.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 81:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka ndakavaregera paukukutu hwemwoyo yavo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.12",
            "verseOrgIds": [
              "PSA.81.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 81:12"
      },
      "items": [
        {
          "text": "kuti vatevere mano avo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.12",
            "verseOrgIds": [
              "PSA.81.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 81:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kana vanhu vangu vakada kunditeerera,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.13",
            "verseOrgIds": [
              "PSA.81.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 81:13"
      },
      "items": [
        {
          "text": "kana Israeri akada kutevera nzira dzangu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.13",
            "verseOrgIds": [
              "PSA.81.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 81:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndaikurumidza kukunda sei vavengi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.14",
            "verseOrgIds": [
              "PSA.81.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 81:14"
      },
      "items": [
        {
          "text": "vavo nokurova vavengi vavo noruoko rwangu!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.14",
            "verseOrgIds": [
              "PSA.81.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 81:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vaya vanovenga Jehovha vachatya pamberi pake,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.15",
            "verseOrgIds": [
              "PSA.81.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 81:15"
      },
      "items": [
        {
          "text": "uye kurangwa kwavo kuchagara nokusingaperi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.15",
            "verseOrgIds": [
              "PSA.81.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 81:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi imi muchagutswa nezviyo zvakaisvonaka;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.16",
            "verseOrgIds": [
              "PSA.81.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 81:16"
      },
      "items": [
        {
          "text": "uye ndichakugutsai nouchi hunobva padombo.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.81.16",
            "verseOrgIds": [
              "PSA.81.17"
            ]
          }
        }
      ]
    }
  ],
