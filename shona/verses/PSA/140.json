  "verseCount": 13,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "140",
        "style": "c",
        "sid": "PSA 140"
      },
      "items": [
        {
          "text": "140",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Pisarema 140",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Kumutungamiri wokuimba. Pisarema raDhavhidhi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 140:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndirwirei, imi Jehovha, pavanhu vakaipa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.1",
            "verseOrgIds": [
              "PSA.140.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 140:1"
      },
      "items": [
        {
          "text": "ndidzivirirei pavanhu vanoita nechisimba.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.1",
            "verseOrgIds": [
              "PSA.140.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 140:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivo vanofunga urongwa hwakaipa mumwoyo yavo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.2",
            "verseOrgIds": [
              "PSA.140.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 140:2"
      },
      "items": [
        {
          "text": "uye vanomutsa hondo mazuva ose.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.2",
            "verseOrgIds": [
              "PSA.140.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 140:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanorodza ndimi dzavo kuti dzipinze sedzenyoka;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.3",
            "verseOrgIds": [
              "PSA.140.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 140:3"
      },
      "items": [
        {
          "text": "uturu hwenyoka yechiva huri pamiromo yavo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.3",
            "verseOrgIds": [
              "PSA.140.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sera",
              "type": "text",
              "attrs": {
                "verseId": "PSA.140.3",
                "verseOrgIds": [
                  "PSA.140.4"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 140:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndichengetei, imi Jehovha, kubva mumaoko avakaipa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.4",
            "verseOrgIds": [
              "PSA.140.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 140:4"
      },
      "items": [
        {
          "text": "ndidzivirirei pavanhu vanoita nechisimba",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.4",
            "verseOrgIds": [
              "PSA.140.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 140:4"
      },
      "items": [
        {
          "text": "vanoronga kupinga tsoka dzangu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.4",
            "verseOrgIds": [
              "PSA.140.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 140:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanhu vanozvikudza vakandivanzira misungo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.5",
            "verseOrgIds": [
              "PSA.140.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 140:5"
      },
      "items": [
        {
          "text": "vakatambanudza mabote emimbure yavo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.5",
            "verseOrgIds": [
              "PSA.140.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 140:5"
      },
      "items": [
        {
          "text": "uye vakateya ugombe munzira yandinofamba nayo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.5",
            "verseOrgIds": [
              "PSA.140.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sera",
              "type": "text",
              "attrs": {
                "verseId": "PSA.140.5",
                "verseOrgIds": [
                  "PSA.140.6"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 140:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haiwa Jehovha, ndinoti kwamuri, \"Ndimi Mwari wangu.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.6",
            "verseOrgIds": [
              "PSA.140.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 140:6"
      },
      "items": [
        {
          "text": "Haiwa Jehovha, inzwai kuchemera nyasha kwangu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.6",
            "verseOrgIds": [
              "PSA.140.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 140:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haiwa Ishe Jehovha, imi mudzikinuri wangu ane simba,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.7",
            "verseOrgIds": [
              "PSA.140.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 140:7"
      },
      "items": [
        {
          "text": "anofukidza musoro wangu pazuva rehondo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.7",
            "verseOrgIds": [
              "PSA.140.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 140:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "regai kupa vakaipa zvavanoda, imi Jehovha;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.8",
            "verseOrgIds": [
              "PSA.140.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 140:8"
      },
      "items": [
        {
          "text": "musarega urongwa hwavo huchibudirira,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.8",
            "verseOrgIds": [
              "PSA.140.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 140:8"
      },
      "items": [
        {
          "text": "kuti varege kuzvikudza.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.8",
            "verseOrgIds": [
              "PSA.140.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sera",
              "type": "text",
              "attrs": {
                "verseId": "PSA.140.8",
                "verseOrgIds": [
                  "PSA.140.9"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 140:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Misoro yaavo vakandipoteredza",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.9",
            "verseOrgIds": [
              "PSA.140.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 140:9"
      },
      "items": [
        {
          "text": "ngaifukidzwe nenhamo yakaparwa nemiromo yavo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.9",
            "verseOrgIds": [
              "PSA.140.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 140:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mazimbe anopfuta ngaawire pamusoro pavo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.10",
            "verseOrgIds": [
              "PSA.140.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 140:10"
      },
      "items": [
        {
          "text": "ngavakandwe mumoto,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.10",
            "verseOrgIds": [
              "PSA.140.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 140:10"
      },
      "items": [
        {
          "text": "mumakomba amatope, vasambomukazve.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.10",
            "verseOrgIds": [
              "PSA.140.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 140:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vane makuhwa ngavarege kusimbiswa panyika;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.11",
            "verseOrgIds": [
              "PSA.140.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 140:11"
      },
      "items": [
        {
          "text": "njodzi ngaivhime vanhu vanoita zvinhu nechisimba.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.11",
            "verseOrgIds": [
              "PSA.140.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 140:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinoziva kuti Jehovha akachengetera varombo kururamisirwa kwavo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.12",
            "verseOrgIds": [
              "PSA.140.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 140:12"
      },
      "items": [
        {
          "text": "uye anotsigira vanoshayiwa pamhaka dzavo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.12",
            "verseOrgIds": [
              "PSA.140.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 140:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvirokwazvo vakarurama vacharumbidza zita renyu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.13",
            "verseOrgIds": [
              "PSA.140.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 140:13"
      },
      "items": [
        {
          "text": "uye vakarurama vachagara pamberi penyu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.140.13",
            "verseOrgIds": [
              "PSA.140.14"
            ]
          }
        }
      ]
    }
  ],
