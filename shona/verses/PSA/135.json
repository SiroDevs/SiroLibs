          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rumbidzai Jehovha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.1",
            "verseOrgIds": [
              "PSA.135.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "PSA 135:1"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 135:1"
      },
      "items": [
        {
          "text": "Rumbidzai zita raJehovha;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.1",
            "verseOrgIds": [
              "PSA.135.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 135:1"
      },
      "items": [
        {
          "text": "murumbidzei, imi varanda vaJehovha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.1",
            "verseOrgIds": [
              "PSA.135.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 135:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "imi munoshumira muimba yaJehovha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.2",
            "verseOrgIds": [
              "PSA.135.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 135:2"
      },
      "items": [
        {
          "text": "muvanze dzeimba yaMwari wedu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.2",
            "verseOrgIds": [
              "PSA.135.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 135:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rumbidzai Jehovha, nokuti Jehovha akanaka;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.3",
            "verseOrgIds": [
              "PSA.135.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 135:3"
      },
      "items": [
        {
          "text": "imbirai zita rake nziyo dzokurumbidza, nokuti ndizvo zvakanaka.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.3",
            "verseOrgIds": [
              "PSA.135.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 135:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti Jehovha akasarudza Jakobho kuti ave wake,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.4",
            "verseOrgIds": [
              "PSA.135.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 135:4"
      },
      "items": [
        {
          "text": "naIsraeri kuti ave pfuma yake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.4",
            "verseOrgIds": [
              "PSA.135.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 135:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinoziva kuti Jehovha mukuru,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.5",
            "verseOrgIds": [
              "PSA.135.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 135:5"
      },
      "items": [
        {
          "text": "uye kuti Ishe wedu mukuru kupfuura vamwari vose.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.5",
            "verseOrgIds": [
              "PSA.135.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 135:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha anoita zvose zvinomufadza,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.6",
            "verseOrgIds": [
              "PSA.135.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 135:6"
      },
      "items": [
        {
          "text": "kudenga napasi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.6",
            "verseOrgIds": [
              "PSA.135.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 135:6"
      },
      "items": [
        {
          "text": "nomumakungwa napakadzika pose.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.6",
            "verseOrgIds": [
              "PSA.135.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 135:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anoita kuti makore akwire kubva kumagumo enyika;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.7",
            "verseOrgIds": [
              "PSA.135.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 135:7"
      },
      "items": [
        {
          "text": "anotumira mheni nemvura,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.7",
            "verseOrgIds": [
              "PSA.135.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 135:7"
      },
      "items": [
        {
          "text": "uye anobudisa mhepo kubva mumatura ake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.7",
            "verseOrgIds": [
              "PSA.135.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 135:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndiye akaparadza matangwe eIjipiti,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.8",
            "verseOrgIds": [
              "PSA.135.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 135:8"
      },
      "items": [
        {
          "text": "matangwe avanhu neemhuka.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.8",
            "verseOrgIds": [
              "PSA.135.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 135:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akatumira zviratidzo nezvishamiso zvake mukati mako,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.9",
            "verseOrgIds": [
              "PSA.135.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 135:9"
      },
      "items": [
        {
          "text": "iwe Ijipiti, pamusoro paFaro navaranda vake vose.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.9",
            "verseOrgIds": [
              "PSA.135.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 135:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaparadza ndudzi dzakawanda",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.10",
            "verseOrgIds": [
              "PSA.135.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 135:10"
      },
      "items": [
        {
          "text": "uye akauraya madzimambo ane simba,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.10",
            "verseOrgIds": [
              "PSA.135.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 135:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sihoni mambo weAmori,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.11",
            "verseOrgIds": [
              "PSA.135.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 135:11"
      },
      "items": [
        {
          "text": "Ogi mambo weBhashani",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.11",
            "verseOrgIds": [
              "PSA.135.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 135:11"
      },
      "items": [
        {
          "text": "namadzimambo ose eKenani,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.11",
            "verseOrgIds": [
              "PSA.135.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 135:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "akapa nyika yavo kuti ive nhaka,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.12",
            "verseOrgIds": [
              "PSA.135.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 135:12"
      },
      "items": [
        {
          "text": "nhaka yavanhu vake Israeri.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.12",
            "verseOrgIds": [
              "PSA.135.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 135:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haiwa Jehovha, zita renyu rinogara nokusingaperi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.13",
            "verseOrgIds": [
              "PSA.135.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 135:13"
      },
      "items": [
        {
          "text": "mukurumbira wenyu, imi Jehovha, kuzvizvarwa zvose.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.13",
            "verseOrgIds": [
              "PSA.135.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 135:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti Jehovha achapupurira vanhu vake",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.14",
            "verseOrgIds": [
              "PSA.135.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 135:14"
      },
      "items": [
        {
          "text": "uye achava nenyasha pamusoro pavaranda vake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.14",
            "verseOrgIds": [
              "PSA.135.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 135:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvifananidzo zvendudzi isirivha negoridhe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.15",
            "verseOrgIds": [
              "PSA.135.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 135:15"
      },
      "items": [
        {
          "text": "zvakaitwa namaoko avanhu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.15",
            "verseOrgIds": [
              "PSA.135.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 135:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvine miromo, asi hazvigoni kutaura,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.16",
            "verseOrgIds": [
              "PSA.135.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 135:16"
      },
      "items": [
        {
          "text": "zvina meso, asi hazvigoni kuona;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.16",
            "verseOrgIds": [
              "PSA.135.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 135:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "nenzeve, asi hazvigoni kunzwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.17",
            "verseOrgIds": [
              "PSA.135.17"
            ]
          }
        }
      ]
