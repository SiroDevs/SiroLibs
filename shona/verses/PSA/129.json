      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 129:1"
      },
      "items": [
        {
          "text": "Israeri ngaati,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.129.1",
            "verseOrgIds": [
              "PSA.129.1"
            ]
          }
        }
      ]
    },
