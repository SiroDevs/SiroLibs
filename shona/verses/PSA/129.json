          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Varimi vakarima musana wangu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.129.3",
            "verseOrgIds": [
              "PSA.129.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 129:3"
      },
      "items": [
        {
          "text": "vakaita miforo yavo mirefu.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.129.3",
            "verseOrgIds": [
              "PSA.129.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 129:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi Jehovha akarurama,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.129.4",
            "verseOrgIds": [
              "PSA.129.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 129:4"
      },
      "items": [
        {
          "text": "akandisunungura pamabote avakaipa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.129.4",
            "verseOrgIds": [
              "PSA.129.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
