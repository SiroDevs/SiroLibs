{
  "id": "JHN.8",
  "number": "8",
  "bookId": "JHN",
  "reference": "Johani 8",
  "copyright": "Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi™ Kopakodzero © 2005, 2018 ne Biblica, Inc. Biblica® Open Shona Contemporary Bible™ Copyright © 2005, 2018 by Biblica, Inc.",
  "verseCount": 59,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "JHN 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JHN 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi Jesu akaenda kuGomo reMiorivhi.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.1",
            "verseOrgIds": [
              "JHN.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panguva dzamambakwedza akazviratidzazve mutemberi, vanhu vakamuunganira, uye akagara pasi kuti avadzidzise.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.2",
            "verseOrgIds": [
              "JHN.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vadzidzisi vomurayiro navaFarisi vakapinda nomukadzi akanga abatwa achiita upombwe. Vakamuita kuti amire pamberi peboka",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.3",
            "verseOrgIds": [
              "JHN.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye vakati kuna Jesu, \"Mudzidzisi, mukadzi uyu abatwa achiita upombwe.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.4",
            "verseOrgIds": [
              "JHN.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "MuMurayiro Mozisi akatirayira kuti titake namabwe vakadzi vakadai. Zvino imi munoti kudii?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.5",
            "verseOrgIds": [
              "JHN.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakanga vachishandisa mubvunzo uyu kuti vamuteye, vawane hwaro hwokumupa mhosva.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.6",
            "verseOrgIds": [
              "JHN.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 8:6"
      },
      "items": [
        {
          "text": "Asi Jesu akakotama akatanga kunyora pasi nomunwe wake.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.6",
            "verseOrgIds": [
              "JHN.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakati varamba vachimubvunza, akatwasuka akati kwavari, \"Kana pane asina chivi pakati penyu, ngaave iye wokutanga kupotsera dombo kwaari.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.7",
            "verseOrgIds": [
              "JHN.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akakotamazve akanyora pasi.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.8",
            "verseOrgIds": [
              "JHN.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakati vanzwa izvi, vose vakatanga kubva vachiita mumwe mumwe, kutanga vakuru, kusvikira Jesu asara oga, uye mukadzi achakangomirapo.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.9",
            "verseOrgIds": [
              "JHN.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akatwasuka akati kwaari, \"Mai, varipiko vaya vanga vachikupomera mhosva? Hapana akutonga here?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.10",
            "verseOrgIds": [
              "JHN.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye akati, \"Hapana, Ishe.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.11",
            "verseOrgIds": [
              "JHN.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 8:11"
      },
      "items": [
        {
          "text": "Jesu akati, \"Neniwo handikupi mhosva. Zvino chienda, uye usiye upenyu hwako hwechivi.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.11",
            "verseOrgIds": [
              "JHN.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kukosha kwoUchapupu hwaJesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu achitaurazve navanhu, akati, \"Ndini chiedza chenyika. Ani naani anonditevera haangatongofambi murima, asi achava nechiedza choupenyu.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.12",
            "verseOrgIds": [
              "JHN.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "VaFarisi vakamupikisa vachiti, \"Hezvo, uri kuratidza wani kuti unozvipupurira pachako; uchapupu hwako hahuna maturo.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.13",
            "verseOrgIds": [
              "JHN.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akapindura akati, \"Kunyange dai ndikazvipupurira pachangu, uchapupu hwangu ndohwechokwadi, nokuti ndinoziva kwandakabva uye nokwandinoenda. Asi imi hamuzivi kwandinobva kana kwandinoenda.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.14",
            "verseOrgIds": [
              "JHN.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munotonga nameso enyama; ini handitongi munhu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.15",
            "verseOrgIds": [
              "JHN.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi kana ndikatonga, kutonga kwangu kwakarurama, nokuti handisi ndoga. Ndinotonga naBaba, vakandituma.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.16",
            "verseOrgIds": [
              "JHN.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumurayiro wenyu makanyorwa kuti kupupura kwavanhu vaviri ndokwechokwadi.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.17",
            "verseOrgIds": [
              "JHN.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ini ndini ndinozvipupurira pachangu; mumwe anondipupurira ndiBaba, vakandituma.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.18",
            "verseOrgIds": [
              "JHN.8.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo vakamubvunza vakati, \"Baba vako varipiko?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.19",
            "verseOrgIds": [
              "JHN.8.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 8:19"
      },
      "items": [
        {
          "text": "Jesu akapindura akati, \"Hamundizivi ini kana Baba vangu. Dai maindiziva mungadai maizivawo Baba vangu.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.19",
            "verseOrgIds": [
              "JHN.8.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akataura mashoko aya paakanga achidzidzisa ari mutemberi pedyo nenzvimbo yaiiswa zvipo. Asi hapana munhu akamubata, nokuti nguva yake yakanga isati yasvika.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.20",
            "verseOrgIds": [
              "JHN.8.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akatizve kwavari, \"Ndiri kuenda, uye imi muchanditsvaka, uye muchafira muzvivi zvenyu. Kwandinoenda, imi hamungauyiko.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.21",
            "verseOrgIds": [
              "JHN.8.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izvi zvakaita kuti vaJudha vabvunzane vachiti, \"Achazviuraya here? Ndizvo zvaanoreva here zvaanoti, 'Kwandinoenda, imi hamungauyiko?' \"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.22",
            "verseOrgIds": [
              "JHN.8.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi akaenderera mberi achiti, \"Imi muri vapasi; ini ndinobva kumusoro. Muri venyika ino; ini handisi wenyika ino.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.23",
            "verseOrgIds": [
              "JHN.8.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakuudzai kuti muchafira muzvivi zvenyu; kana musingatendi kuti ndini iye, zvirokwazvo muchafira muzvivi zvenyu.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.24",
            "verseOrgIds": [
              "JHN.8.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakati kwaari, \"Ndiwe aniko?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.25",
            "verseOrgIds": [
              "JHN.8.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 8:25"
      },
      "items": [
        {
          "text": "Jesu akapindura akati, \"Izvozvo zvandanguri ndataura kare kuti ndini iye.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.25",
            "verseOrgIds": [
              "JHN.8.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndine zvizhinji zvandinoda kutonga pamusoro penyu. Asi uyo akandituma akavimbika, uye zvandakanzwa kwaari ndizvo zvandinoudza nyika.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.26",
            "verseOrgIds": [
              "JHN.8.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Havana kunzwisisa kuti akanga achivaudza nezvaBaba.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.27",
            "verseOrgIds": [
              "JHN.8.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JHN 8:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Jesu akati kwavari, \"Pamuchasimudza Mwanakomana woMunhu, ipapo ndipo pamuchaziva kuti ndini iye, uye kuti handina chinhu chandinoita ndoga asi ndinotaura zvandakadzidziswa naBaba zvoga.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.28",
            "verseOrgIds": [
              "JHN.8.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyo akandituma aneni; haana kundisiya ndiri ndoga, nokuti ndinogara ndichiita zvinomufadza.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.29",
            "verseOrgIds": [
              "JHN.8.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunyange panguva yaakanga achitaura, vazhinji vakatenda kwaari.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.30",
            "verseOrgIds": [
              "JHN.8.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Vana vaAbhurahama",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JHN 8:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akati kuvaJudha vakanga vatenda kwaari, \"Kana muchiramba muri mudzidziso yangu, muri vadzidzi vangu zvirokwazvo.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.31",
            "verseOrgIds": [
              "JHN.8.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JHN 8:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo muchaziva zvokwadi, uye zvokwadi ichakusunungurai.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.32",
            "verseOrgIds": [
              "JHN.8.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JHN 8:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivo vakamupindura vachiti, \"Isu tiri zvizvarwa zvaAbhurahama uye hatina kumbova varanda vomumwe munhu. Ungareva sei kuti tichasunungurwa?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.33",
            "verseOrgIds": [
              "JHN.8.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JHN 8:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akapindura akati, \"Ndinokuudzai chokwadi kuti, mumwe nomumwe anotadza ndiye muranda wechivi.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.34",
            "verseOrgIds": [
              "JHN.8.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JHN 8:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino muranda haagari mumhuri nokusingaperi, asi mwanakomana ndiye anogaramo nokusingaperi.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.35",
            "verseOrgIds": [
              "JHN.8.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JHN 8:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka kana Mwanakomana achikusunungurai, muchava vakasununguka kwazvo.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.36",
            "verseOrgIds": [
              "JHN.8.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JHN 8:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinoziva kuti muri zvizvarwa zvaAbhurahama. Asi munotsvaka kundiuraya, nokuti shoko rangu harina nzvimbo mamuri.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.37",
            "verseOrgIds": [
              "JHN.8.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JHN 8:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndiri kukuudzai zvandakaona pamberi paBaba vangu, uye imi munoita zvamakanzwa kuna baba venyu.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.38",
            "verseOrgIds": [
              "JHN.8.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JHN 8:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivo vakati, \"Abhurahama ndivo baba vedu.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.39",
            "verseOrgIds": [
              "JHN.8.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 8:39"
      },
      "items": [
        {
          "text": "Jesu akati, \"Dai maiva vana vaAbhurahama, maidai muchiita zvinhu zvakanga zvichiitwa naAbhurahama.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.39",
            "verseOrgIds": [
              "JHN.8.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JHN 8:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izvozvi muri kutsvaka kundiuraya, munhu akuudzai chokwadi chandakanzwa kuna Mwari. Abhurahama haana kuita zvinhu zvakadai.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.40",
            "verseOrgIds": [
              "JHN.8.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JHN 8:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muri kuita zvinhu zvinoitwa nababa venyu.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.41",
            "verseOrgIds": [
              "JHN.8.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 8:41"
      },
      "items": [
        {
          "text": "Vakapindura vakati, \"Isu hatisi vana vakaberekwa muupombwe. Baba vatinavo isu ndiye Mwari bedzi.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.41",
            "verseOrgIds": [
              "JHN.8.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Vana vaDhiabhori",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JHN 8:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akati kwavari, \"Dai Mwari aiva Baba venyu, mungadai maindida, nokuti ndakabva kuna Mwari uye iye zvino ndiri pano. Handina kungouya pachangu; asi ndivo vakandituma.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.42",
            "verseOrgIds": [
              "JHN.8.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JHN 8:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Seiko musinganzwisisi kutaura kwangu? Nokuti hamugoni kunzwa zvandinotaura.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.43",
            "verseOrgIds": [
              "JHN.8.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JHN 8:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imi muri vababa venyu, dhiabhori, uye munoda kuita kuda kwababa venyu. Akanga ari muurayi kubva pakutanga, haamiri muzvokwadi, nokuti maari hamuna zvokwadi. Kana achireva nhema, ndiwo mutauro wokwake iwoyo, nokuti ndiye murevi wenhema uye Baba vadzo.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.44",
            "verseOrgIds": [
              "JHN.8.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "JHN 8:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi nokuda kwokuti ndinotaura chokwadi, imi hamutendi kwandiri!",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.45",
            "verseOrgIds": [
              "JHN.8.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "JHN 8:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndiani pakati penyu angaratidza kukanganisa kwangu? Kana ndichitaura chokwadi, seiko musinganditendi?",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.46",
            "verseOrgIds": [
              "JHN.8.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "JHN 8:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyo ari waMwari anonzwa zvinorehwa naMwari. Chinoita kuti murege kunzwa ndechokuti imi hamusi vaMwari.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.47",
            "verseOrgIds": [
              "JHN.8.47"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Zvakarehwa naJesu pamusoro poUpenyu Hwake",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "JHN 8:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "VaJudha vakamupindura vakati, \"Hatina kutaura chokwadi here patakati uri muSamaria uye kuti une dhimoni?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.48",
            "verseOrgIds": [
              "JHN.8.48"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "JHN 8:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akati, \"Handina kubatwa nedhimoni ini, asi ndinokudza Baba vangu uye imi munondizvidza.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.49",
            "verseOrgIds": [
              "JHN.8.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "JHN 8:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Handizvitsvakiri kukudzwa; asi aripo mumwe anotsvaka kukudzwa, uye ndiye mutongi.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.50",
            "verseOrgIds": [
              "JHN.8.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "JHN 8:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinokuudzai chokwadi, kana munhu akachengeta shoko rangu, haangatongooni rufu.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.51",
            "verseOrgIds": [
              "JHN.8.51"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "JHN 8:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo vaJudha vakati kwaari, \"Tinoziva zvino kuti une dhimoni iwe! Abhurahama akafa navaprofita vakafawo, asi iwe unoti kana munhu akachengeta shoko rako, haangatongoraviri rufu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.52",
            "verseOrgIds": [
              "JHN.8.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "JHN 8:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ko, iwe uri mukuru kuna baba vedu Abhurahama here? Ivo vakafa, uye vaprofita vakafawo. Unofunga kuti iwe ndiwe ani?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.53",
            "verseOrgIds": [
              "JHN.8.53"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "JHN 8:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akapindura akati, \"Kana ini ndichizvirumbidza, kuzvikudza kwangu hakuna maturo. Baba vangu, avo vamunoti ndivo Mwari wenyu, ndivo vanondikudza.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.54",
            "verseOrgIds": [
              "JHN.8.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "JHN 8:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunyange musingavazivi, ini ndinovaziva. Dai ndanga ndati handivazivi, ndingadai ndava murevi wenhema semi, asi ndinovaziva uye ndinochengeta shoko ravo.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.55",
            "verseOrgIds": [
              "JHN.8.55"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "JHN 8:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baba venyu Abhurahama vakafara pavakafunga kuti vachaona zuva rangu; vakariona uye vakafara.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.56",
            "verseOrgIds": [
              "JHN.8.56"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "57",
            "style": "v",
            "sid": "JHN 8:57"
          },
          "items": [
            {
              "text": "57",
              "type": "text"
            }
          ]
        },
        {
          "text": "VaJudha vakati, \"Iwe hausati watombova namakore makumi mashanu okuzvarwa, asi unoti iwe wakaona Abhurahama!\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.57",
            "verseOrgIds": [
              "JHN.8.57"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "58",
            "style": "v",
            "sid": "JHN 8:58"
          },
          "items": [
            {
              "text": "58",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akapindura akati, \"Ndinokuudzai chokwadi, Abhurahama asati azvarwa ini ndiripo!\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.58",
            "verseOrgIds": [
              "JHN.8.58"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "59",
            "style": "v",
            "sid": "JHN 8:59"
          },
          "items": [
            {
              "text": "59",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo, vakanonga matombo kuti vamutake, asi Jesu akazvivanza, akabuda mutemberi.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.8.59",
            "verseOrgIds": [
              "JHN.8.59"
            ]
          }
        }
      ]
    }
  ],
