{
  "id": "JHN.9",
  "number": "9",
  "bookId": "JHN",
  "reference": "Johani 9",
  "copyright": "Biblica® Bhaibheri Dzvene Rakasununguka MuChiShona Chanhasi™ Kopakodzero © 2005, 2018 ne Biblica, Inc. Biblica® Open Shona Contemporary Bible™ Copyright © 2005, 2018 by Biblica, Inc.",
  "verseCount": 41,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "JHN 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jesu Anoporesa Munhu Akaberekwa Ari Bofu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JHN 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati achifamba, akaona murume akanga aberekwa ari bofu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.1",
            "verseOrgIds": [
              "JHN.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vadzidzi vake vakamubvunza vakati, \"Rabhi, ndianiko akatadza, murume uyu kana kuti vabereki vake, zvaakaberekwa ari bofu?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.2",
            "verseOrgIds": [
              "JHN.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akapindura akati, \"Hakusi kutadza kwomurume uyu kana kwavabereki vake kwakaita kuti zvidai, asi izvi zvakaitika kuti basa raMwari riratidzwe muupenyu hwake.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.3",
            "verseOrgIds": [
              "JHN.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana achiri masikati kudai, tinofanira kubata basa raiye akandituma. Usiku huri kuuya, husina munhu angagona kushanda basa nahwo.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.4",
            "verseOrgIds": [
              "JHN.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndichiri munyika, ndiri chiedza chenyika.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.5",
            "verseOrgIds": [
              "JHN.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati ataura izvozvo, akapfira mate pasi, akakanya dope namate, uye akariisa pameso omurume uya.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.6",
            "verseOrgIds": [
              "JHN.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati kwaari, \"Enda undoshamba mudziva reSiroami\" (shoko iri rinoreva kuti Kutumwa). Saka murume uya akaenda akandoshamba, akadzoka ava kuona.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.7",
            "verseOrgIds": [
              "JHN.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vavakidzani vake navaya vakanga vambomuona achipemha vakati, \"Ko, uyu haasi iye murume uya aisimbogara achipemha here?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.8",
            "verseOrgIds": [
              "JHN.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vamwe vakati, \"Ndiye.\" Vamwe vakati, \"Kwete, anenge akangofanana naye chete.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.9",
            "verseOrgIds": [
              "JHN.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 9:9"
      },
      "items": [
        {
          "text": "Asi iye pachake akaramba achiti, \"Ndini iye.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.9",
            "verseOrgIds": [
              "JHN.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakamubvunza vakati, \"Meso ako akasvinudzwa sei?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.10",
            "verseOrgIds": [
              "JHN.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akapindura akati, \"Murume anonzi Jesu akakanya dope akarizora pameso angu. Akandiudza kuti ndiende kuSiroami ndinoshamba. Saka ndakaenda ndikandoshamba, uye ipapo ndakagona kuona.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.11",
            "verseOrgIds": [
              "JHN.9.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakamubvunza vakati, \"Aripiko murume wacho?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.12",
            "verseOrgIds": [
              "JHN.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 9:12"
      },
      "items": [
        {
          "text": "Iye akati, \"Handizivi.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.12",
            "verseOrgIds": [
              "JHN.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "VaFarisi vanobvunzisisa pamusoro poKuporeswa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakauyisa murume uya aimbova bofu kuvaFarisi.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.13",
            "verseOrgIds": [
              "JHN.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino zuva iro rakakanyiwa dope rikazorwa pameso omurume uya naJesu, raiva zuva reSabata.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.14",
            "verseOrgIds": [
              "JHN.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo vaFarisi vakamubvunzawo kuti akasvinudzwa sei. Murume uya akapindura akati, \"Azora dope pameso angu uye ndikandoshamba, zvino ndava kuona.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.15",
            "verseOrgIds": [
              "JHN.9.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vamwe vaFarisi vakati, \"Murume uyu haabvi kuna Mwari, nokuti haachengeti Sabata.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.16",
            "verseOrgIds": [
              "JHN.9.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 9:16"
      },
      "items": [
        {
          "text": "Asi vamwe vakati, \"Ko, mutadzi angaita zviratidzo zvakadai seiko?\" Nokudaro vakabva vapesana.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.16",
            "verseOrgIds": [
              "JHN.9.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakupedzisira vakadzokerazve kumurume uya akaberekwa ari bofu vakati, \"Ko, iwe unoti kudini naye, sezvo akasvinudza meso ako.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.17",
            "verseOrgIds": [
              "JHN.9.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 9:17"
      },
      "items": [
        {
          "text": "Murume uya akapindura akati, \"Muprofita.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.17",
            "verseOrgIds": [
              "JHN.9.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunyange zvakadaro, vaJudha havana kubvuma kuti akanga ari bofu uye kuti akanga asvinudzwa meso ake, kusvikira vadana vabereki vake.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.18",
            "verseOrgIds": [
              "JHN.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakati kwavari, \"Mwanakomana wenyu here uyu? Ndiye here wamunoti akaberekwa ari bofu? Seiko ava kuona iye zvino?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.19",
            "verseOrgIds": [
              "JHN.9.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vabereki vake vakati, \"Tinoziva kuti ndiye mwanakomana wedu, uye tinoziva kuti akaberekwa ari bofu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.20",
            "verseOrgIds": [
              "JHN.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi kuti ari kuona sei nhasi kana kuti ndiani asvinudza meso ake, isu hatizivi. Mubvunzei. Akura; achazvidavirira oga.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.21",
            "verseOrgIds": [
              "JHN.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vabereki vake vakataura izvi nokuti vaitya vaJudha, nokuti vaJudha vakanga vatotenderana kuti ani naani anenge angopupura kuti Jesu ndiye Kristu aizofanira kubudiswa musinagoge.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.22",
            "verseOrgIds": [
              "JHN.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndokusaka vabereki vake vakati, \"Akura mubvunzei iye.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.23",
            "verseOrgIds": [
              "JHN.9.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakadanazve murume uya akambenge ari bofu kechipiri. Vakati kwaari, \"Ipa mbiri kuna Mwari. Isu tinoziva kuti murume uyu mutadzi.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.24",
            "verseOrgIds": [
              "JHN.9.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akapindura akati, \"Kana ari mutadzi kana asiri, ini handizvizivi. Ndinoziva chinhu chimwe chete. Ndakanga ndiri bofu asi zvino ndoona!\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.25",
            "verseOrgIds": [
              "JHN.9.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo vakamubvunza vakati, \"Akaiteiko kwauri? Akasvinudza meso ako seiko?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.26",
            "verseOrgIds": [
              "JHN.9.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akapindura akati, \"Ndanguri ndakuudzai, asi hamuna kuteerera. Munodireiko kuzvinzwazve? Munoda kuva vadzidzi vakewo here?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.27",
            "verseOrgIds": [
              "JHN.9.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JHN 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo vakamutuka vakati, \"Iwe hako ndiwe mudzidzi wake munhu uyu! Isu tiri vadzidzi vaMozisi!",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.28",
            "verseOrgIds": [
              "JHN.9.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tinoziva kuti Mwari akataura naMozisi, asi kana ari munhu uyu, hatimbozivi kwaanobva.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.29",
            "verseOrgIds": [
              "JHN.9.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 9:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Murume uya akapindura akati, \"Zvino, izvi zvinoshamisa chose! Hamuzivi kwaanobva, asi iye akasvinudza meso angu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.30",
            "verseOrgIds": [
              "JHN.9.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JHN 9:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tinoziva kuti Mwari haanzwi vatadzi. Anonzwa munhu anomutya uye anoita kuda kwake.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.31",
            "verseOrgIds": [
              "JHN.9.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JHN 9:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuna munhu akatombonzwa nezvokusvinudzwa kwameso omunhu akaberekwa ari bofu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.32",
            "verseOrgIds": [
              "JHN.9.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JHN 9:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dai murume uyu asina kubva kuna Mwari, haaigona kuita chinhu.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.33",
            "verseOrgIds": [
              "JHN.9.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JHN 9:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo vakapindura vakati, \"Iwe wakaberekerwa muchivi; unoda seiko kutidzidzisa!\" Ipapo vakamubudisa kunze.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.34",
            "verseOrgIds": [
              "JHN.9.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ubofu hwapamweya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JHN 9:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akanzwa kuti vakanga vamudzingira kunze, uye akati amuwana, akati kwaari, \"Unotenda here kuMwanakomana woMunhu?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.35",
            "verseOrgIds": [
              "JHN.9.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JHN 9:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Murume uya akapindura akati, \"Iye ndianiko nhai, Ishe? Ndiudzei kuti ndigotenda kwaari.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.36",
            "verseOrgIds": [
              "JHN.9.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JHN 9:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akati, \"Wamuona zvino; uye ndiye ari kutaura newe.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.37",
            "verseOrgIds": [
              "JHN.9.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JHN 9:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo murume uya akati, \"Ishe, ndinotenda,\" akabva amunamata.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.38",
            "verseOrgIds": [
              "JHN.9.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JHN 9:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akati, \"Kutonga ndiko kwandakavinga munyika ino, kuitira kuti mapofu aone uye avo vanoona vave mapofu.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.39",
            "verseOrgIds": [
              "JHN.9.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JHN 9:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vamwe vaFarisi vaiva naye vakamunzwa achitaura izvi vakati, \"Watii? Nesuwo tiri mapofu here?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.40",
            "verseOrgIds": [
              "JHN.9.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JHN 9:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu akati, \"Dai maiva mapofu, mungadai musina mhosva yechivi; asi zvino zvamunoti munoona, mhosva yenyu inoramba iripo.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.41",
            "verseOrgIds": [
              "JHN.9.41"
            ]
          }
        }
      ]
    }
  ],
