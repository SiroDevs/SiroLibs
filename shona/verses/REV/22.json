  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "22",
        "style": "c",
        "sid": "REV 22"
      },
      "items": [
        {
          "text": "22",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Rwizi rwoUpenyu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "REV 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo mutumwa akandiratidza rwizi rwemvura youpenyu, inoonekera sekristaro, ruchiyerera kubva pachigaro chaMwari necheGwayana",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.1",
            "verseOrgIds": [
              "REV.22.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "pakati penzira huru yeguta. Parutivi rumwe norumwe rwerwizi pakanga pano muti woupenyu, waibereka mhando gumi nembiri dzomuchero, ichibereka michero yayo pamwedzi woga woga. Mashizha omuti uyu ndeokuporesa ndudzi.",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.2",
            "verseOrgIds": [
              "REV.22.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuchazovazve nokutukwa. Chigaro choushe chaMwari necheGwayana zvichava muguta, uye varanda vake vachamushumira.",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.3",
            "verseOrgIds": [
              "REV.22.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vachaona chiso chake, uye zita rake richava pahuma dzavo.",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.4",
            "verseOrgIds": [
              "REV.22.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usiku hahuchazovapozve. Havachazotsvaki chiedza chomwenje kana chiedza chezuva, nokuti Ishe Mwari achavapa chiedza. Uye vachatonga nokusingaperi-peri.",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.5",
            "verseOrgIds": [
              "REV.22.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutumwa akati kwandiri, \"Mashoko aya akatendeka uye ndeechokwadi. Ishe, Mwari wemweya yavaprofita, akatuma mutumwa wake kuzoratidza varanda vake zvinhu zvinofanira kukurumidza kuitika.\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.6",
            "verseOrgIds": [
              "REV.22.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jesu ari kuuya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Tarirai, ndinokurumidza kuuya! Akaropafadzwa uyo anochengeta mashoko ouprofita huri mubhuku iri.\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.7",
            "verseOrgIds": [
              "REV.22.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ini Johani, ndini ndakanzwa uye ndikaona zvinhu izvi. Uye ndakati ndazvinzwa uye ndazviona, ndakawira pasi kuti ndinamate ndiri patsoka dzomutumwa akanga andiratidza zvinhu izvi.",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.8",
            "verseOrgIds": [
              "REV.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi akati kwandiri, \"Rega kudaro! Ndiri muranda pamwe chete newe uye nehama dzako vaprofita navose vanochengeta mashoko ebhuku iri. Namata Mwari!\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.9",
            "verseOrgIds": [
              "REV.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo akati kwandiri, \"Usanamira mashoko ouprofita hwebhuku iri, nokuti nguva yaswedera.",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.10",
            "verseOrgIds": [
              "REV.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anotadza ngaarambe achitadza, anonyangadza ngaarambe achinyangadza; anoita zvakarurama ngaarambe achiita zvakarurama; uye mutsvene ngaarambe ari mutsvene.\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.11",
            "verseOrgIds": [
              "REV.22.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Tarirai, ndiri kukurumidza kuuya! Mubayiro wangu ndinawo, uye ndichapa mumwe nomumwe maererano nezvaakaita.",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.12",
            "verseOrgIds": [
              "REV.22.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndini Arifa naOmega, wokutanga newokupedzisira, kutanga nokuguma.",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.13",
            "verseOrgIds": [
              "REV.22.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Vakaropafadzwa avo vanosuka nguo dzavo, kuti vave nesimba rokuuya kumuti woupenyu uye vagopinda muguta napasuo.",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.14",
            "verseOrgIds": [
              "REV.22.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunze ndiko kune imbwa, vaya vanoita zvouroyi, mhombwe, mhondi, vanonamata zvifananidzo navose vanoda nhema uye vachidziita.",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.15",
            "verseOrgIds": [
              "REV.22.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ini Jesu, ndatuma mutumwa wangu kuti akupe uchapupu uhu hwekereke. Ndini mudzi worudzi rwaDhavhidhi, Nyamasase inopenya.\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.16",
            "verseOrgIds": [
              "REV.22.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "REV 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mweya nomwenga vanoti, \"Uya!\" Uye anonzwa ngaati, \"Uyai!\" Ani naani ane nyota, ngaauye; uye ani naani anoda, ngaatore chipo chemvura youpenyu asingatengi.",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.17",
            "verseOrgIds": [
              "REV.22.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "REV 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinoyambira mumwe nomumwe anonzwa mashoko ouprofita hwebhuku iri ndichiti: Kana munhu upi zvake akawedzera chinhu chipi zvacho kwaari, Mwari achawedzera kwaari matambudziko akanyorwa mubhuku iri.",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.18",
            "verseOrgIds": [
              "REV.22.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "REV 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye, kana munhu upi zvake akatapudza mashoko kubva mubhuku iri rouprofita, Mwari achabvisa kubva kwaari mugove wake pamuti woupenyu nomuguta dzvene, izvo zvakanyorwa mubhuku iri.",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.19",
            "verseOrgIds": [
              "REV.22.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "REV 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyo anopupura zvinhu izvi anoti, \"Hongu, ndinokurumidza kuuya.\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.20",
            "verseOrgIds": [
              "REV.22.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "REV 22:20"
      },
      "items": [
        {
          "text": "Ameni. Uyai, Ishe Jesu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.20",
            "verseOrgIds": [
              "REV.22.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "REV 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasha dzaIshe Jesu ngadzive navanhu vaMwari. Ameni.",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.21",
            "verseOrgIds": [
              "REV.22.21"
            ]
          }
        }
      ]
    }
  ],
  "previous": {
    "id": "REV.21",
    "number": "21",
    "bookId": "REV"
  }
}