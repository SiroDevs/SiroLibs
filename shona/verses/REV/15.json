      },
      "items": [
        {
          "text": "15",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Vatumwa Vanomwe naMatenda Manomwe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "REV 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakaona kudenga chimwe chiratidzo chikuru chinoshamisa ichi: vatumwa vanomwe namatambudziko manomwe okupedzisira, nokuti nawo hasha dzaMwari dzakapera.",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.1",
            "verseOrgIds": [
              "REV.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye ndakaona chairatidzika segungwa regirazi rakavhenganiswa nomoto uye parutivi rwegungwa pakanga pamire, avo vakanga vakunda chikara nomufananidzo wacho nechiverengo chezita racho. Vakabata madimbwa avakanga vapiwa naMwari",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.2",
            "verseOrgIds": [
              "REV.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye vakaimba rwiyo rwaMozisi muranda waMwari norwiyo rweGwayana, vachiti:",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.3",
            "verseOrgIds": [
              "REV.15.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 15:3"
      },
      "items": [
        {
          "text": "\"Mabasa enyu makuru uye anoshamisa,",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.3",
            "verseOrgIds": [
              "REV.15.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 15:3"
      },
      "items": [
        {
          "text": "Ishe Mwari Wamasimba Ose.",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.3",
            "verseOrgIds": [
              "REV.15.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 15:3"
      },
      "items": [
        {
          "text": "Nzira dzenyu dzakarurama uye ndedzechokwadi,",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.3",
            "verseOrgIds": [
              "REV.15.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 15:3"
      },
      "items": [
        {
          "text": "imi Mambo wamakore.",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.3",
            "verseOrgIds": [
              "REV.15.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndianiko angarega kukutyai, imi Ishe,",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.4",
            "verseOrgIds": [
              "REV.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 15:4"
      },
      "items": [
        {
          "text": "kana kukudza zita renyu?",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.4",
            "verseOrgIds": [
              "REV.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 15:4"
      },
      "items": [
        {
          "text": "Nokuti ndimi moga mutsvene.",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.4",
            "verseOrgIds": [
              "REV.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 15:4"
      },
      "items": [
        {
          "text": "Ndudzi dzose dzichauya",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.4",
            "verseOrgIds": [
              "REV.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 15:4"
      },
      "items": [
        {
          "text": "dzigonamata pamberi penyu,",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.4",
            "verseOrgIds": [
              "REV.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 15:4"
      },
      "items": [
        {
          "text": "nokuti mabasa enyu akarurama akaratidzwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.4",
            "verseOrgIds": [
              "REV.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shure kwaizvozvi ndakatarira kudenga, uye temberi, iyo tabhenakeri yeChipupuriro, yakanga yakazaruka.",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.5",
            "verseOrgIds": [
              "REV.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutemberi makabuda vatumwa vanomwe vana matambudziko manomwe. Vakanga vakapfeka nguo dzomucheka wakachena, unopenya uye vakamonera mabhanhire egoridhe pazvipfuva zvavo.",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.6",
            "verseOrgIds": [
              "REV.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo chimwe chezvisikwa zvipenyu zvina chakapa kuvatumwa vanomwe ndiro nomwe dzizere nehasha dzaMwari, iye anogara nokusingaperi-peri.",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.7",
            "verseOrgIds": [
              "REV.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye temberi yakazadzwa noutsi hunobva pakubwinya kwaMwari napasimba rake, uye hakuna munhu aigona kupinda mutemberi kusvikira matambudziko manomwe avatumwa vanomwe apera.",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.8",
            "verseOrgIds": [
              "REV.15.8"
            ]
          }
        }
      ]
    }
  ],
