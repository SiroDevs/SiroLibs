  "verseCount": 40,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "11",
        "style": "c",
        "sid": "HEB 11"
      },
      "items": [
        {
          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kutenda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HEB 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino kutenda ndiko kuva nechokwadi nezvinhu zvatinotarisira, nechiratidzo chezvinhu zvatisingaoni.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.1",
            "verseOrgIds": [
              "HEB.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti izvi ndizvo zvakaita kuti vanhu vekare vapupurirwe zvakanaka.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.2",
            "verseOrgIds": [
              "HEB.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokutenda tinonzwisisa kuti nyika yakaitwa nokurayira kwaMwari, zvokuti zvinhu zvinoonekwa zvakaitwa kubva pane zvinhu zvisingaonekwi.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.3",
            "verseOrgIds": [
              "HEB.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokutenda Abheri akapa Mwari chibayiro chiri nani pane chaKaini. Nokutenda akapupurirwa kuti akanga ari munhu akarurama, Mwari paakataura zvakanaka pamusoro pezvipo zvake. Uye nokutenda achiri kutaura nazvino kunyange zvake akafa.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.4",
            "verseOrgIds": [
              "HEB.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HEB 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokutenda Enoki akatorwa kubva paupenyu huno, zvokuti haana kuona rufu; akasaonekwa, nokuti Mwari akanga amutora; nokuti asati atorwa, akanga achipupurirwa somunhu aifadza Mwari.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.5",
            "verseOrgIds": [
              "HEB.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HEB 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye pasina kutenda hazvibviri kufadza Mwari, nokuti ani naani anouya kwaari anofanira kutenda kuti ariko uye kuti anopa vanomutsvaka nomwoyo wose mubayiro wavo.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.6",
            "verseOrgIds": [
              "HEB.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HEB 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokutenda Noa, akati anyeverwa pamusoro pezvinhu zvakanga zvichigere kuonekwa, akavaka areka nokutya Mwari kuti aponese mhuri yake. Nokutenda kwake akapa nyika mhosva uye akava mugari wenhaka yokururama kunouya nokutenda.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.7",
            "verseOrgIds": [
              "HEB.11.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HEB 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokutenda Abhurahama, akati adanwa kuti aende kunzvimbo iyo yaaizogamuchira kuti ive nhaka yake, akateerera akaenda, kunyange zvazvo akanga asingazivi kwaaienda.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.8",
            "verseOrgIds": [
              "HEB.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HEB 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokutenda akandogara somutorwa munyika yechipikirwa, saanogara munyika yavamwe; akagara mumatende, sezvakaita Isaka naJakobho, vakanga vari vadyi venhaka yechipikirwa pamwe chete naye.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.9",
            "verseOrgIds": [
              "HEB.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HEB 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti akanga achitarisira guta rine nheyo, Mwari ari mhizha nomuvaki waro.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.10",
            "verseOrgIds": [
              "HEB.11.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HEB 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokutenda Abhurahama, kunyange zvake akanga apfuura zera, uye Sara pachake akanga asingabereki, akapiwa simba rokuva baba, nokuti akati iye akamupikira akatendeka.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.11",
            "verseOrgIds": [
              "HEB.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HEB 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye nokudaro kubva pamunhu mumwe, akanga oita seafa, kwakava nezvizvarwa zvakawanda senyeredzi dzokudenga, zvisingaverengeki sejecha pamahombekombe egungwa.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.12",
            "verseOrgIds": [
              "HEB.11.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanhu ava vose vakanga vachirarama nokutenda kusvikira panguva yokufa. Havana kuwana zvinhu zvavakavimbiswa; vakangozviona chete vakazvigamuchira zviri kure. Uye vakabvuma kuti ivo vakanga vari vaeni navatorwa panyika.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.13",
            "verseOrgIds": [
              "HEB.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HEB 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanhu vanotaura zvinhu zvakadai vanoratidza kuti vari kutsvaka nyika yavo chaiyo.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.14",
            "verseOrgIds": [
              "HEB.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HEB 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dai vakanga vachifunga nyika yavakabva kwairi vangadai vakawana mukana wokudzokera.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.15",
            "verseOrgIds": [
              "HEB.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HEB 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi vakanga vachishuva nyika yakanaka, iyo yokudenga. Naizvozvo Mwari haana nyadzi pamusoro pavo kuti anzi Mwari wavo, nokuti akavagadzirira guta.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.16",
            "verseOrgIds": [
              "HEB.11.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "HEB 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokutenda Abhurahama, paakaedzwa naMwari, akapa Isaka sechibayiro. Iye akanga agamuchira zvipikirwa akanga obayira mwanakomana wake mumwe oga,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.17",
            "verseOrgIds": [
              "HEB.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "HEB 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "kunyange zvazvo Mwari akanga akati kwaari, \"Nokuna Isaka zvizvarwa zvako zvichazovapo.\"",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.18",
            "verseOrgIds": [
              "HEB.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "HEB 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abhurahama akafunga akati Mwari aigona kumutsa vakafa, uye tichitaura nomufananidzo, akagamuchira Isaka kubva kuvakafa.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.19",
            "verseOrgIds": [
              "HEB.11.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "HEB 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokutenda Isaka akaropafadza Jakobho naEsau pamusoro pezvaizoitika.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.20",
            "verseOrgIds": [
              "HEB.11.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "HEB 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokutenda Jakobho, paakanga ava kufa akaropafadza mwanakomana mumwe nomumwe waJosefa, uye akanamata akazendamira pamusoro pomudonzvo wake.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.21",
            "verseOrgIds": [
              "HEB.11.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "HEB 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokutenda, Josefa, magumo ake ava pedyo, akataura zvokubuda kwavaIsraeri kubva muIjipiti uye akarayira pamusoro pamapfupa ake.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.22",
            "verseOrgIds": [
              "HEB.11.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "HEB 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokutenda Mozisi paakaberekwa, vabereki vake vakamuviga kwemwedzi mitatu, nokuti vakaona kuti akanga ari mwana akanaka uye havana kutya murayiro wamambo.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.23",
            "verseOrgIds": [
              "HEB.11.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "HEB 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokutenda Mozisi akati akura, akaramba kunzi mwanakomana womwanasikana waFaro.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.24",
            "verseOrgIds": [
              "HEB.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "HEB 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akasarudza kutambudzwa pamwe chete navanhu vaMwari pano kufadzwa kwenguva duku namafaro ezvivi.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.25",
            "verseOrgIds": [
              "HEB.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "HEB 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati kuzvidzwa nokuda kwaKristu ipfuma huru kupfuura kupfuma kwose kweIjipiti, nokuti akanga achitarira mberi kumubayiro.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.26",
            "verseOrgIds": [
              "HEB.11.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "HEB 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokutenda akabva muIjipiti asingatyi kutsamwa kwamambo; akatsungirira nokuti akanga aona iye asingaonekwi.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.27",
            "verseOrgIds": [
              "HEB.11.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "HEB 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokutenda akavamba Pasika nokusasa ropa, kuitira kuti muurayi wamatangwe arege kuuraya matangwe eIsraeri.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.28",
            "verseOrgIds": [
              "HEB.11.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "HEB 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokutenda vanhu vakayambuka Gungwa Dzvuku, sapanyika yakaoma; asi vaIjipita pavakaedza kuzviita vakanyura.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.29",
            "verseOrgIds": [
              "HEB.11.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "HEB 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokutenda masvingo eJeriko akawira pasi, mushure mokunge vanhu vafamba vachiapoteredza kwamazuva manomwe.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.30",
            "verseOrgIds": [
              "HEB.11.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "HEB 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokutenda Rahabhi chifeve, haana kufa pamwe chete navasina kuteerera, nokuti akanga agamuchira vasori norugare.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.31",
            "verseOrgIds": [
              "HEB.11.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "HEB 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye ndichataureiko zvimwe? Handichina nguva yokutaura pamusoro paGidheoni, Bharaki, Samusoni, Jefuta, Dhavhidhi, Samueri, navaprofita,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.32",
            "verseOrgIds": [
              "HEB.11.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "HEB 11:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "vakakunda ushe nokutenda, vakatonga nokururamisira, uye vakawana zvakanga zvavimbiswa; vakadzivira miromo yeshumba,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.33",
            "verseOrgIds": [
              "HEB.11.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "HEB 11:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "vakadzima simba romoto, uye vakapunyuka kubva pamunondo unopinza, utera hwavo hwakashandurwa hukava simba uye vakava nesimba guru pakurwa vakakunda hondo dzamamwe marudzi.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.34",
            "verseOrgIds": [
              "HEB.11.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "HEB 11:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakadzi vakagamuchirazve vakanga vafa vavo vamutswa kuti vave vapenyu zvakare. Vamwe vakatambudzwa vakaramba kusunungurwa, kuitira kuti vagozopiwa kumuka kuri nani pakunaka.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.35",
            "verseOrgIds": [
              "HEB.11.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "HEB 11:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vamwe vakasekwa uye vakarohwa, uyezve vamwe vakasungwa vakaiswa mutorongo.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.36",
            "verseOrgIds": [
              "HEB.11.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "HEB 11:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakatakwa namabwe; vamwe vakaitwa zvidimbu zviviri; vakaurayiwa nomunondo. Vakafamba vakapfeka matehwe amakwai namatehwe embudzi, vasina chinhu, vakatambudzwa uye vakaitirwa zvakaipa,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.37",
            "verseOrgIds": [
              "HEB.11.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "HEB 11:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "nyika yakanga isina kufanirwa navo. Vaidzungaira murenje nomumakomo, mumapako nomumakomba enyika.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.38",
            "verseOrgIds": [
              "HEB.11.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "HEB 11:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vose ava vakapupurirwa kutenda kwavo, asi hapana kana mumwe wavo akagamuchira zvakanga zvavimbiswa.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.39",
            "verseOrgIds": [
              "HEB.11.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "HEB 11:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwari akanga atigadzirira chimwe chinhu chiri nani pakunaka, kuitira kuti ivo pamwe chete nesu tigoitwa vakakwana.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.40",
            "verseOrgIds": [
              "HEB.11.40"
            ]
          }
        }
      ]
    }
