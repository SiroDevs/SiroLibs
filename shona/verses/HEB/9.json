  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "HEB 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kunamata muTabhenakeri Yapanyika",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HEB 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino sungano yokutanga yakanga ine mirayiro yokunamata Mwari uye neyeimba tsvene yapanyika.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.1",
            "verseOrgIds": [
              "HEB.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tabhenakeri yakamiswa. Mukamuri rayo rokutanga makanga mune chigadziko chomwenje, netafura uye nezvingwa zvitsvene; iyi ndiyo yainzi Nzvimbo Tsvene.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.2",
            "verseOrgIds": [
              "HEB.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mberi kwechidzitiro chechipiri kwakanga kune kamuri yainzi Nzvimbo Tsvene-tsvene,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.3",
            "verseOrgIds": [
              "HEB.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "yakanga ine ndiro yegoridhe yezvinonhuhwira uye neareka yesungano yakanga yakafukidzirwa negoridhe. Muareka iyi ndimo makanga mune hari yegoridhe yakanga ine mana, netsvimbo yaAroni yakanga yatungira, uye namahwendefa esungano.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.4",
            "verseOrgIds": [
              "HEB.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HEB 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamusoro peareka pakanga paina makerubhi okubwinya, aidzikatidza chifunhiro chengoni. Asi hatingatauri nezvezvinhu zvose izvi zvizere iye zvino.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.5",
            "verseOrgIds": [
              "HEB.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HEB 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvinhu zvose zvakati zvagadzirwa saizvozvi, vaprista vaizopinda mukamuri yokutanga nguva dzose vachiita ushumiri hwavo.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.6",
            "verseOrgIds": [
              "HEB.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HEB 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi muprista mukuru oga ndiye aipinda mukamuri yomukati, kamwe chete pagore, uye asingatongopindi asina ropa, raaizvibayira iye pachake nezvivi zvavanhu zvavakanga vaita mukusaziva.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.7",
            "verseOrgIds": [
              "HEB.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HEB 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mweya Mutsvene airatidza nechinhu ichi, kuti nzira inoenda kunzvimbo Tsvene-tsvene yakanga isati yaratidzwa sezvo tabhenakeri yakanga ichimire.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.8",
            "verseOrgIds": [
              "HEB.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HEB 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyu mufananidzo wenguva ino, zvichireva kuti zvipo nezvibayiro zvaibayirwa zvakanga zvisingagoni kuchenesa hana yaiye ainamata.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.9",
            "verseOrgIds": [
              "HEB.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HEB 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvinongova zvokudya nezvokunwa uye nokushamba kuzhinji zvapanyama, zvavakatemerwa kusvikira panguva yokuvandudzwa.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.10",
            "verseOrgIds": [
              "HEB.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ropa raKristu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HEB 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kristu paakauya somuprista mukuru wezvinhu zvakanaka zvatova pano kare, akapinda nomutabhenakeri yakapfuura pakukura uye napakukwana isina kugadzirwa nomunhu, zvichireva kuti yakanga isiri chikamu chokusikwa kuno.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.11",
            "verseOrgIds": [
              "HEB.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HEB 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haana kupinda nokuda kweropa rembudzi neremhuru; asi akapinda muNzvimbo Tsvene-tsvene neropa rake chairo akatiwanira rudzikinuro rusingaperi.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.12",
            "verseOrgIds": [
              "HEB.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ropa rembudzi nerenzombe namadota etsiru zvaisaswa pamusoro paavo vakanga vakasvibiswa, zvaiita kuti vatsvene vanatswe panyama.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.13",
            "verseOrgIds": [
              "HEB.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HEB 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ko, kuzoti zvino iro ropa raKristu, uyo kubudikidza noMweya unogara nokusingaperi, akazvipa, asina chaangapomerwa kuna Mwari, akachenesa hana dzedu kubva pamabasa ose anotungamirira kurufu, kuitira kuti tigoshumira Mwari Mupenyu!",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.14",
            "verseOrgIds": [
              "HEB.9.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HEB 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuda kwaizvozvi Kristu ndiye murevereri wesungano itsva, kuitira kuti vaya vakadanwa vagogamuchira chipikirwa chenhaka isingaperi zvino, sezvo akafa sedzikinuro kuti avasunungure kubva pazvivi zvavakaita vari pasi pesungano yokutanga.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.15",
            "verseOrgIds": [
              "HEB.9.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HEB 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti kana iri nhaka yakanyorwa, panofanira kuvapowo nechokwadi chorufu rwaiye akaiita,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.16",
            "verseOrgIds": [
              "HEB.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "HEB 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "nokuti nhaka yakanyorwa ine simba chete kana munhu afa; haina simba kana akaiita achiri mupenyu.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.17",
            "verseOrgIds": [
              "HEB.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "HEB 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndokusaka sungano yokutanga isina kushanda pasina ropa.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.18",
            "verseOrgIds": [
              "HEB.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "HEB 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mozisi paakaparidza mirayiro yose kuvanhu vose, akatora ropa remhuru, pamwe chete nemvura, neshinda tsvuku uye namapazi ehisopi, akasasa pabhuku rakapetwa uye napavanhu.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.19",
            "verseOrgIds": [
              "HEB.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "HEB 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati, \"Iri iropa resungano, yamakarayirwa naMwari kuti muchengete.\"",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.20",
            "verseOrgIds": [
              "HEB.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "HEB 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nenzira imwe cheteyo, akasasa neropa tabhenakeri nezvinhu zvose zvaishandiswa pakushumira mairi.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.21",
            "verseOrgIds": [
              "HEB.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "HEB 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvirokwazvo, murayiro unoda kuti zvinhu zvinenge zvose zvinatswe neropa, uye pasina kuteurwa kweropa hapana kuregererwa.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.22",
            "verseOrgIds": [
              "HEB.9.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "HEB 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naizvozvo zvaifanira kuti mifananidzo yezvinhu zvokudenga inatswe nezvibayiro izvi, asi zvinhu zvokudenga zvacho zvaifanira kunatswa nechibayiro chinopfuura izvi.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.23",
            "verseOrgIds": [
              "HEB.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "HEB 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti Kristu haana kupinda panzvimbo tsvene yakagadzirwa nomunhu yakanga ichingova mufananidzo waiyo yechokwadi chaiyo; akapinda kudenga chaiko, kuti atimiririre pamberi paMwari.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.24",
            "verseOrgIds": [
              "HEB.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "HEB 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye haana kupinda kudenga kuti azviite chibayiro kakawanda, somuprista mukuru anopinda muNzvimbo Tsvene-tsvene, gore negore, neropa risiri rake.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.25",
            "verseOrgIds": [
              "HEB.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "HEB 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino Kristu angadai akazotambudzika kakawanda kubva pakuvambwa kwenyika. Asi zvino akaonekwa kamwe chete pamagumo enguva kuti aparadze chivi nokuzviita chibayiro iye pachake.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.26",
            "verseOrgIds": [
              "HEB.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "HEB 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sezvo munhu akatemerwa kufa kamwe chete uye shure kwaizvozvo agotongwa,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.27",
            "verseOrgIds": [
              "HEB.9.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "HEB 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "saizvozvowo Kristu akabayirwa kamwe chete kuti atakure zvivi zvavanhu vazhinji; uye achazoonekwa kechipiri, asingatakuri zvivi, asi kuti auyise ruponeso kuna avo vakamumirira.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.28",
            "verseOrgIds": [
              "HEB.9.28"
            ]
          }
        }
      ]
    }
  ],
