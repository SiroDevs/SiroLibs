  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "28",
        "style": "c",
        "sid": "1CH 28"
      },
      "items": [
        {
          "text": "28",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Urongwa hwaDhavhidhi pamusoro peTemberi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 28:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi akarayira vabati veIsraeri vose kuti vaungane paJerusarema: vabati pamusoro pamarudzi, vatungamiri vamapoka aishandira mambo, vatungamiri vezviuru navatungamiri vamazana, navabati vaichengeta zvinhu nezvipfuwo zvamambo uye navanakomana vake, pamwe chete navabati vomumuzinda wamambo, varume vane simba nemhare dzose dzakashinga.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.1",
            "verseOrgIds": [
              "1CH.28.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 28:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo Dhavhidhi akasimuka akamira akati, \"Teererai kwandiri, hama dzangu navanhu vangu. Zvakanga zviri mumwoyo mangu kuti ndivake imba senzvimbo yokuzororera yeareka yesungano yaJehovha, kuti zvive chitsiko chetsoka dzaMwari wedu, uye ndakaita urongwa hwokuivaka.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.2",
            "verseOrgIds": [
              "1CH.28.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 28:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi Mwari akati kwandiri, 'Iwe hausi kuzovakira Zita rangu imba, nokuti uri murwi uye wakateura ropa.'",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.3",
            "verseOrgIds": [
              "1CH.28.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Asi Jehovha, Mwari waIsraeri, akandisarudza kubva kumhuri yangu yose kuti ndive mambo pamusoro paIsraeri nokusingaperi. Akasarudza Judha kuti ave mhuri yangu, uye kubva muvanakomana vababa vangu akafadzwa nokundiita mambo pamusoro peIsraeri.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.4",
            "verseOrgIds": [
              "1CH.28.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 28:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pavanakomana vangu vose, uye Jehovha akandipa vakawanda kwazvo, iye akasarudza mwanakomana wangu Soromoni kuti agare pachigaro choumambo hwaJehovha pamusoro paIsraeri.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.5",
            "verseOrgIds": [
              "1CH.28.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 28:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati kwandiri, 'Soromoni mwanakomana wako ndiye achavaka imba yangu nezvivanze zvangu, ndichava baba vake.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.6",
            "verseOrgIds": [
              "1CH.28.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndichasimbisa umambo hwake nokusingaperi kana iye akatsungirira mukuita zvandakarayira nemitemo yangu sezviri kuitwa panguva ino.'",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.7",
            "verseOrgIds": [
              "1CH.28.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Saka zvino ndinokurayira pamberi peIsraeri yose uye napamberi peungano yaJehovha, uye Mwari wedu achinzwa: Chenjerera kuti utevere kurayira kwose kwaJehovha senhaka kuvana vako nokusingaperi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.8",
            "verseOrgIds": [
              "1CH.28.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 28:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Newewo mwanakomana wangu Soromoni, ziva Mwari wababa vako, uye umushumire nomwoyo wose uye nepfungwa dzako dzose, nokuti Jehovha anonzvera mwoyo uye anonzwisisa chinangwa chipi nechipi chiri mupfungwa. Ukamutsvaga achawanikwa newe, asi kana ukamurasa, iye achakuramba nokusingaperi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.9",
            "verseOrgIds": [
              "1CH.28.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Funga zvino, nokuti Jehovha akusarudza kuti uvake temberi senzvimbo tsvene. Iva nesimba uye uite basa iri.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.10",
            "verseOrgIds": [
              "1CH.28.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 28:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Dhavhidhi akapa mwanakomana wake Soromoni urongwa hwebiravira retemberi, dzimba dzayo, matura ayo, makamuri ayo okumusoro, makamuri ayo omukati uye nenzvimbo yokuyananisira.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.11",
            "verseOrgIds": [
              "1CH.28.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 28:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akamupa urongwa hwazvose zvakanga zvaiswa noMweya mupfungwa make pamusoro pezvivanze zvetemberi yaJehovha namakamuri ose akapoteredza, pamusoro pamatura epfuma yetemberi yaMwari napamusoro pamatura ezvinhu zvakakumikidzwa.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.12",
            "verseOrgIds": [
              "1CH.28.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 28:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akamurayira zvokuita pamusoro pamapoka avaprista navaRevhi uye napamusoro pebasa rose rokushumira mutemberi yaJehovha, uyewo napamusoro pemidziyo yaizoshandiswa mubasa rayo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.13",
            "verseOrgIds": [
              "1CH.28.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 28:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akarayira uremu hwegoridhe remidziyo yose yaizoshandiswa mumhando dzose dzokushumira, nouremu hwesirivha yemidziyo yose yaizoshandiswa mumhando dzose dzokushumira:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.14",
            "verseOrgIds": [
              "1CH.28.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 28:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uremu hwegoridhe rezvigadziko zvemwenje zvegoridhe nemwenje yazvo, nouremu hwechigadziko chomwenje chimwe nechimwe, nemwenje yacho, maererano nokushandiswa kwechigadziko chemwenje chimwe nechimwe.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.15",
            "verseOrgIds": [
              "1CH.28.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 28:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uremu hwegoridhe retafura imwe neimwe yechingwa chakatsaurwa; uremu hwesirivha yetafura dzesirivha;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.16",
            "verseOrgIds": [
              "1CH.28.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 28:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "uremu hwegoridhe rakanatswa reforogo, ndiro dzokusasa nemikombe; uremu hwegoridhe nedhishi rimwe nerimwe regoridhe; uremu hwesirivha yedhishi rimwe nerimwe resirivha;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.17",
            "verseOrgIds": [
              "1CH.28.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 28:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye uremu hwegoridhe rakanatswa nearitari yezvinonhuhwira. Akamupawo mufananidzo wengoro iyo ina makerubhi egoridhe akatambanudza mapapiro awo achifukidza areka yesungano yaJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.18",
            "verseOrgIds": [
              "1CH.28.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 28:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi akati, \"Zvose izvi ndakazviziviswa zvanyorwa noruoko rwaJehovha uye akaita ndinzwisise urongwa hwake hwose.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.19",
            "verseOrgIds": [
              "1CH.28.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 28:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhavhidhi akatiwo kumwanakomana wake Soromoni, \"Simba utsunge mwoyo, uye uite basa iri. Usatya kana kuora mwoyo, nokuti Jehovha Mwari, Mwari wangu, anewe. Haachazokusiyi kana kukurasa, kusvikira basa rose rokushandira temberi yaJehovha rapera.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.20",
            "verseOrgIds": [
              "1CH.28.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 28:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mapoka avaprista navaRevhi akagadzirira kuita basa rose rapatemberi yaMwari, uye murume wose anoda uye ane umhizha hupi nehupi pamabasa amaoko achakubatsira pabasa iri rose. Vabati vose navanhu vose vachateerera kurayira kwako kwose.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.21",
            "verseOrgIds": [
              "1CH.28.21"
            ]
          }
        }
      ]
    }
  ],
