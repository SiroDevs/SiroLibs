  "verseCount": 43,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "1CH 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Dzimwe Dzimba dzaJudha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvizvarwa zvaJudha zvaiva:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.1",
            "verseOrgIds": [
              "1CH.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 4:1"
      },
      "items": [
        {
          "text": "Perezi, Hezironi, Karimi, Huri naShobhari.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.1",
            "verseOrgIds": [
              "1CH.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Reaya mwanakomana waShobhari aiva baba vaJahati, uye Jahati ari baba vaAhumai naRahadhi. Idzi ndidzo dzaiva dzimba dzavaZorati.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.2",
            "verseOrgIds": [
              "1CH.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ava ndivo vaiva vanakomana vaEtami:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.3",
            "verseOrgIds": [
              "1CH.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 4:3"
      },
      "items": [
        {
          "text": "Jezireeri, Ishima naIdhibashi. Hanzvadzi yavo yainzi Hazereriponi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.3",
            "verseOrgIds": [
              "1CH.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Penueri aiva baba vaGedhori uye Ezeri aiva baba vaHusha.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.4",
            "verseOrgIds": [
              "1CH.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 4:4"
      },
      "items": [
        {
          "text": "Izvi ndizvo zvaiva zvizvarwa zvaHuri dangwe raEfurata baba vaBheterehema.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.4",
            "verseOrgIds": [
              "1CH.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ashuri baba vaTekoa vaiva navakadzi vaviri, Hera naNaara.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.5",
            "verseOrgIds": [
              "1CH.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naara akamuberekera Ahuzami, Heferi, Temeni naHaahashitari. Izvi ndizvo zvaiva zvizvarwa zvaNaara.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.6",
            "verseOrgIds": [
              "1CH.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanakomana vaHera vaiva:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.7",
            "verseOrgIds": [
              "1CH.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 4:7"
      },
      "items": [
        {
          "text": "Zareti, Zohari, Etinani",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.7",
            "verseOrgIds": [
              "1CH.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "naKozi uyo aiva baba vaAnubhi naHazobhebha nevedzimba dzaAhareri mwanakomana waHaruni.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.8",
            "verseOrgIds": [
              "1CH.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jabhezi aikudzwa zvikuru kukunda vanunʼuna vake. Mai vake vakamutumidza kuti Jabhezi vachiti, \"Ndakamubereka mukurwadziwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.9",
            "verseOrgIds": [
              "1CH.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jabhezi akachema kuna Mwari waIsraeri achiti, \"Haiwa, dai mandiropafadza mukakurisa nyika yangu! Ruoko rwenyu ngaruve neni, rundichengete kune zvinokuvadza kuitira kuti ndisarwadziwa.\" Uye Mwari akamupa zvaakakumbira.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.10",
            "verseOrgIds": [
              "1CH.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kerubhi, mununʼuna waShuha aiva baba vaMehiri uyo aiva baba vaEshitoni.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.11",
            "verseOrgIds": [
              "1CH.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eshitoni aiva baba vaBheti Rafa, Pasea naTehina baba vaIri Nahashi. Ava ndivo vaiva varume veReka.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.12",
            "verseOrgIds": [
              "1CH.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanakomana vaKenazi vaiva:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.13",
            "verseOrgIds": [
              "1CH.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 4:13"
      },
      "items": [
        {
          "text": "Otinieri naSeraya.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.13",
            "verseOrgIds": [
              "1CH.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 4:13"
      },
      "items": [
        {
          "text": "Vanakomana vaOtinieri vaiva:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.13",
            "verseOrgIds": [
              "1CH.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 4:13"
      },
      "items": [
        {
          "text": "Hatati naMeonotai.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.13",
            "verseOrgIds": [
              "1CH.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meonotai aiva baba vaOfira.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.14",
            "verseOrgIds": [
              "1CH.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 4:14"
      },
      "items": [
        {
          "text": "Seraya aiva baba vaJoabhu,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.14",
            "verseOrgIds": [
              "1CH.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 4:14"
      },
      "items": [
        {
          "text": "baba vaGe Harashimi. Vakapiwa zita iri nokuti vaiva mhizha.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.14",
            "verseOrgIds": [
              "1CH.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanakomana vaKarebhu mwanakomana waJefune vaiva:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.15",
            "verseOrgIds": [
              "1CH.4.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 4:15"
      },
      "items": [
        {
          "text": "Iru, Era naNaami.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.15",
            "verseOrgIds": [
              "1CH.4.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 4:15"
      },
      "items": [
        {
          "text": "Mwanakomana waEra",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.15",
            "verseOrgIds": [
              "1CH.4.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 4:15"
      },
      "items": [
        {
          "text": "ainzi Kenazi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.15",
            "verseOrgIds": [
              "1CH.4.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanakomana vaJehareri vaiva:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.16",
            "verseOrgIds": [
              "1CH.4.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 4:16"
      },
      "items": [
        {
          "text": "Zifi, Zifa, Tiria naAsareri.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.16",
            "verseOrgIds": [
              "1CH.4.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanakomana vaEzira vaiva:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.17",
            "verseOrgIds": [
              "1CH.4.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 4:17"
      },
      "items": [
        {
          "text": "Jeteri, Meredhi, Eferi, naJaroni.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.17",
            "verseOrgIds": [
              "1CH.4.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 4:17"
      },
      "items": [
        {
          "text": "Mumwe wavakadzi vaMeredhi akavaberekera Miriamu, Shamai naIshibha baba vaEshitemoa.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.17",
            "verseOrgIds": [
              "1CH.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ava ndivo vaiva vana vomwanasikana waFaro ainzi Bhitia akanga aroorwa naMeredhi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.18",
            "verseOrgIds": [
              "1CH.4.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 4:18"
      },
      "items": [
        {
          "text": "Mukadzi wake wechiJudha akabereka Jeredhi baba vaGedhori, Hebheri baba vaSoko, naJekutieri baba vaZanoa.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.18",
            "verseOrgIds": [
              "1CH.4.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanakomana vomukadzi waHodhia, hanzvadzi yaNahamu vaiva:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.19",
            "verseOrgIds": [
              "1CH.4.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 4:19"
      },
      "items": [
        {
          "text": "baba vaKeira muGarimi naEshitemoa muMaakati.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.19",
            "verseOrgIds": [
              "1CH.4.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanakomana vaShimoni vaiva:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.20",
            "verseOrgIds": [
              "1CH.4.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 4:20"
      },
      "items": [
        {
          "text": "Amunoni, Rina, Bheni-Hanani naTironi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.20",
            "verseOrgIds": [
              "1CH.4.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 4:20"
      },
      "items": [
        {
          "text": "Zvizvarwa zvaIshi zvaiva:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.20",
            "verseOrgIds": [
              "1CH.4.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 4:20"
      },
      "items": [
        {
          "text": "Zoheti naBheni-Zoheti.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.20",
            "verseOrgIds": [
              "1CH.4.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanakomana vaShera mwanakomana waJudha vaiva:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.21",
            "verseOrgIds": [
              "1CH.4.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 4:21"
      },
      "items": [
        {
          "text": "Eri baba vaReka, Raadha baba vaMaresha nedzimba dzavairuka mucheka wakaisvonaka paBheti Ashibhea.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.21",
            "verseOrgIds": [
              "1CH.4.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jokimi, varume veKozebha naJoashi naSarafi vaitonga muMoabhu naJashubhi Rehemi. (Zvinyorwa izvi ndezvakare.)",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.22",
            "verseOrgIds": [
              "1CH.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vaiva vaumbi vehari vaigara paNetaimi nepaGedhera; vaigarapo vachishandira mambo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.23",
            "verseOrgIds": [
              "1CH.4.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s2"
      },
      "items": [
        {
          "text": "Simeoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvizvarwa zvaSimeoni zvaiva:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.24",
            "verseOrgIds": [
              "1CH.4.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 4:24"
      },
      "items": [
        {
          "text": "Nemueri, Jamini, Jaribhi, Zera naShauri;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.24",
            "verseOrgIds": [
              "1CH.4.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sharumi aiva mwanakomana waShauri, Mibhisami ari mwanakomana wake naMishima mwanakomana wake.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.25",
            "verseOrgIds": [
              "1CH.4.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 4:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvizvarwa zvaMishima zvaiva:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.26",
            "verseOrgIds": [
              "1CH.4.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 4:26"
      },
      "items": [
        {
          "text": "Hamueri mwanakomana wake, Zakuri mwanakomana wake naShimei mwanakomana wake.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.26",
            "verseOrgIds": [
              "1CH.4.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 4:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shimei aiva navanakomana gumi navatanhatu navanasikana vatanhatu, asi vanunʼuna vake vaiva vasina vana vakawanda; saka rudzi rwavo haruna kuwanda sokuwanda kwavanhu vavaJudha.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.27",
            "verseOrgIds": [
              "1CH.4.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 4:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vaigara muBheerishebha Moradha, Hazari Shuari,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.28",
            "verseOrgIds": [
              "1CH.4.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 4:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhiriha, Ezemi, Toradhi,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.29",
            "verseOrgIds": [
              "1CH.4.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 4:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhetueri, Horima, Zikiragi,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.30",
            "verseOrgIds": [
              "1CH.4.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CH 4:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bheti Makabhoti, Hazari Susimi, Bheti Bhiri neSharaimi. Aya ndiwo aiva maguta avo kusvikira pakutonga kwaDhavhidhi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.31",
            "verseOrgIds": [
              "1CH.4.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CH 4:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Misha yaiva yakaapoteredza yaiva: Etami, Aini, Rimoni, Tokeni neAshani, maguta mashanu",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.32",
            "verseOrgIds": [
              "1CH.4.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CH 4:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "nemisha yose yakanga yakaapoteredza kusvika kuBhaarati. Idzi ndidzo nzvimbo dzavaigara.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.33",
            "verseOrgIds": [
              "1CH.4.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "1CH 4:33"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4",
        "vid": "1CH 4:33"
      },
      "items": [
        {
          "text": "Uye vakachengeta nhoroondo yezvizvarwa zvavo:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CH 4:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meshobhabhi, Jamireki,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.34",
            "verseOrgIds": [
              "1CH.4.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 4:34"
      },
      "items": [
        {
          "text": "Josha mwanakomana waAmazia,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.34",
            "verseOrgIds": [
              "1CH.4.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1CH 4:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joere,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.35",
            "verseOrgIds": [
              "1CH.4.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 4:35"
      },
      "items": [
        {
          "text": "Jehu mwanakomana waJoshibhia, mwanakomana waSeraya, mwanakomana waAsieri,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.35",
            "verseOrgIds": [
              "1CH.4.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1CH 4:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye Erioenai, Jaakobha, Jeshohaya,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.36",
            "verseOrgIds": [
              "1CH.4.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 4:36"
      },
      "items": [
        {
          "text": "Asaya, Adhieri, Jesimieri, Bhenaya,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.36",
            "verseOrgIds": [
              "1CH.4.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1CH 4:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "naZiza mwanakomana waShifi, mwanakomana waAroni mwanakomana waJedhaya, mwanakomana waShimiri, mwanakomana waShemaya.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.37",
            "verseOrgIds": [
              "1CH.4.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CH 4:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Varume vakanyorwa pamusoro namazita avo vaiva vatungamiri vedzimba dzavo.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "1CH 4:38"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1CH 4:38"
      },
      "items": [
        {
          "text": "Mhuri dzavo dzakakura kwazvo",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.38",
            "verseOrgIds": [
              "1CH.4.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1CH 4:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye vakaenda kumucheto kweGedhori kurutivi rwokumabvazuva nomupata vachitsvakira makwai avo mafuro.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.39",
            "verseOrgIds": [
              "1CH.4.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CH 4:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakawana mafuro akanaka kwazvo akapfuma, uye nyika yakanaka ine nzvimbo huru ine runyararo norugare. VaHamu ndivo vakanga vachimbogaramo kare.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.40",
            "verseOrgIds": [
              "1CH.4.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1CH 4:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Varume vane mazita akanyorwa vakauya pamazuva aHezekia mambo waJudha. Vakarwisa vaHamu mumatende avo navaMeuniwo vaivapo vakavaparadza zvachose kusvikira nhasi. Ipapo vakazogarapo munzvimbo yavo nokuti paiva namafuro amakwai avo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.41",
            "verseOrgIds": [
              "1CH.4.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1CH 4:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye mazana mashanu avo vaiva vaSimeoni vachitungamirirwa naPeratia, Nearia, Refaya naUzieri, vanakomana vaIshi, vakandorwisa nyika yamakomo yeSeiri.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.42",
            "verseOrgIds": [
              "1CH.4.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1CH 4:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakauraya vaAmareki vakanga vasara avo vakanga vapunyuka, uye vakagarapo kusvikira nhasi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.43",
            "verseOrgIds": [
              "1CH.4.43"
            ]
          }
        }
      ]
    }
  ],
