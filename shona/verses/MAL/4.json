    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Zuva raJehovha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAL 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Zvirokwazvo zuva rinouya; richapisa sechoto. Vose vanozvikudza navaiti vezvakaipa vachava mashanga, uye zuva iro rinouya richavapisa,\" ndizvo zvinotaura Jehovha Wamasimba Ose. \"Hapana mudzi kana davi zvichasara.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.1",
            "verseOrgIds": [
              "MAL.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAL 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi kunemi munotya zita rangu, zuva rokururama richabuda rino kuporesa mumapapiro aro. Uye muchabuda muchisvetuka semhuru dzabudiswa muchirugu.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.2",
            "verseOrgIds": [
              "MAL.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAL 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo muchatsikira pasi vakaipa; vachava madota pasi petsoka dzenyu pazuva iro pandichaita zvinhu izvi,\" ndizvo zvinotaura Jehovha Wamasimba Ose.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.3",
            "verseOrgIds": [
              "MAL.3.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAL 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Rangarirai murayiro womuranda wangu Mozisi, mitemo nemirayiro yandakamupa paHorebhi kuti ipiwe vaIsraeri vose.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.4",
            "verseOrgIds": [
              "MAL.3.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAL 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Tarirai, ndichakutumirai muprofita Eria, zuva iro guru raJehovha, uye rinotyisa risati rasvika.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.5",
            "verseOrgIds": [
              "MAL.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAL 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye achadzosera mwoyo yamadzibaba kuvana vavo, nemwoyo yavana kumadzibaba avo; kana kuti ndichauya ndigorova nyika nechituko.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.6",
            "verseOrgIds": [
              "MAL.3.24"
            ]
          }
        }
      ]
    }
  ],
