  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "EZR 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ezira anouya kuJerusarema",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZR 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shure kwaizvozvo, panguva yokutonga kwaAtazekisesi mambo wePezhia, Ezira mwanakomana waSeraya, mwanakomana waAzaria, mwanakomana waHirikia,",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.1",
            "verseOrgIds": [
              "EZR.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZR 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "mwanakomana waSharumi, mwanakomana waZodhaki, mwanakomana waAhitubhi,",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.2",
            "verseOrgIds": [
              "EZR.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZR 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "mwanakomana waAmaria, mwanakomana waAzaria, mwanakomana waMerayoti,",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.3",
            "verseOrgIds": [
              "EZR.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZR 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "mwanakomana waZerahia, mwanakomana waUzi, mwanakomana waBhuki,",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.4",
            "verseOrgIds": [
              "EZR.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZR 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "mwanakomana waAbhishua, mwanakomana waFinehasi, mwanakomana waEreazari, mwanakomana waAroni muprista mukuru,",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.5",
            "verseOrgIds": [
              "EZR.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZR 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezira uyu akauya kubva kuBhabhironi. Akanga ari mudzidzisi aiziva kwazvo Murayiro waMozisi, wakanga wapiwa naJehovha, Mwari waIsraeri. Mambo akanga amupa zvose zvaakanga akumbira, nokuti ruoko rwaJehovha Mwari wake rwakanga rwuri pamusoro pake.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.6",
            "verseOrgIds": [
              "EZR.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZR 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vamwe vavaIsraeri, vaisanganisira vaprista, vaRevhi, vaimbi, varindi vamasuo navaranda vomutemberi, vakauyawo kuJerusarema mugore rechinomwe rokutonga kwaMambo Atazekisesi.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.7",
            "verseOrgIds": [
              "EZR.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZR 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezira akasvika muJerusarema mumwedzi wechishanu wegore rechinomwe ramambo.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.8",
            "verseOrgIds": [
              "EZR.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZR 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akanga atanga rwendo rwake kubva kuBhabhironi zuva rokutanga romwedzi wokutanga akasvika muJerusarema pazuva rokutanga romwedzi wechishanu, nokuti ruoko rwenyasha rwaMwari wake rwakanga rwuri pamusoro pake.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.9",
            "verseOrgIds": [
              "EZR.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZR 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti Ezira akanga akazvipira kunzvera nokutevera Murayiro waJehovha, uye nokudzidzisa mitemo nemirayiro yawo muIsraeri.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.10",
            "verseOrgIds": [
              "EZR.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Tsamba yaMambo Atazekisesi kuna Ezira",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZR 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aya ndiwo mashoko etsamba yaMambo Atazekisesi yaakapa Ezira muprista nomudzidzisi, murume akanga akadzidza pamusoro pezvemirayiro nemitemo yaJehovha kuIsraeri:",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.11",
            "verseOrgIds": [
              "EZR.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pmo"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZR 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atazekisesi mambo wamadzimambo, kuna Ezira muprista nomudzidzisi woMurayiro waMwari wokudenga:",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.12",
            "verseOrgIds": [
              "EZR.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pmo",
        "vid": "EZR 7:12"
      },
      "items": [
        {
          "text": "Kwaziwa.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.12",
            "verseOrgIds": [
              "EZR.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZR 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ini ndinotema chirevo kuti ani naani muIsraeri ari muumambo hwangu, kusanganisira vaprista navaRevhi, avo vanoda zvavo kuenda newe kuJerusarema, ngavaende.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.13",
            "verseOrgIds": [
              "EZR.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZR 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uri kutumwa namambo navapi vake vamazano vanomwe kundobvunzisisa pamusoro peJudha neJerusarema maererano noMurayiro waMwari wako, uri muruoko rwako.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.14",
            "verseOrgIds": [
              "EZR.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZR 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamusoro pezvo unofanira kutora sirivha negoridhe rakapiwa namambo namakurukota ake nokuda kwavo kuna Mwari waIsraeri, iye agere muJerusarema,",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.15",
            "verseOrgIds": [
              "EZR.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZR 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "pamwe chete nesirivha negoridhe rose raungawana kubva kudunhu reBhabhironi, pamwe chetewo nezvipo zvavanhu zvavachapa nokuda kwavo nezvavaprista, zvetemberi yaMwari wavo muJerusarema.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.16",
            "verseOrgIds": [
              "EZR.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZR 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nemari iyi unofanira kutenga hando, makondobwe, namakwayana makono, pamwe chete nezvipiriso zvazvo zvezviyo nezvinonwiwa, uye mugozvibayira paaritari yetemberi yaMwari muJerusarema.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.17",
            "verseOrgIds": [
              "EZR.7.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZR 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo iwe nehama dzako vaJudha mungaita zvenyu zvose zvamunoona zvakafanira nesirivha negoridhe rose rinenge rasara maererano nokuda kwaMwari wenyu.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.18",
            "verseOrgIds": [
              "EZR.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZR 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipai midziyo yose kuna Mwari weJerusarema iyo yamakapiwa kuti mushumire nayo mutemberi yaMwari wenyu.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.19",
            "verseOrgIds": [
              "EZR.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZR 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye zvimwe zvose zvinodiwa patemberi yaMwari wako zvaunofanira kuendesa kutemberi, unofanira kuzvitora kubva papfuma yamambo.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.20",
            "verseOrgIds": [
              "EZR.7.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZR 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino ini, Mambo Atazekisesi, ndinorayira vabati vose vehomwe dzemari mhiri kwaYufuratesi kuti mupe nokushingairira zvose zvingakumbirwa naEzira muprista nomudzidzisi woMurayiro waMwari wokudenga,",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.21",
            "verseOrgIds": [
              "EZR.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZR 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "kusvikira pamatarenda esirivha zana, nezviyero zana zvezviyo namabhati zana ewaini, namabhati zana amafuta amaorivhi, uye nomunyu wose unodiwa.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.22",
            "verseOrgIds": [
              "EZR.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZR 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chinhu chipi nechipi chakarayirwa naMwari wokudenga, ngachiitwe nokushingaira kutemberi yaMwari wokudenga. Ko, ushe hwamambo nohwavanakomana vake huchatsamwireiko?",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.23",
            "verseOrgIds": [
              "EZR.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZR 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinokuzivisaiwo kuti hamufaniri kuripisa mitero, nemhando dzose dzemitero, mutero womunhu mumwe nomumwe, kana mutero wokumuganhu kwenyika, kuvaprista, vaRevhi, vaimbi, varindi vemikova, navaranda vomutemberi kana vamwe vashandi vapaimba yaMwari.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.24",
            "verseOrgIds": [
              "EZR.7.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZR 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye iwe, Ezira, maererano nouchenjeri hwaMwari wako, hwaunahwo, ugadze vaongorori vemhosva, navatongi kuti vatonge nokururamisira vanhu vose vari mhiri kwaYufuratesi, vose vanoziva mirayiro yaMwari wako. Uye unofanira kudzidzisa vose vasingaizivi.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.25",
            "verseOrgIds": [
              "EZR.7.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZR 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani naani asingateereri murayiro waMwari wako uye nomurayiro wamambo, zvirokwazvo anofanira kurangwa norufu, kana kudzingwa, kana kutorerwa pfuma, kana kuiswa mutorongo.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.26",
            "verseOrgIds": [
              "EZR.7.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZR 7:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha ngaarumbidzwe, Mwari wamadzibaba edu, uyo akaisa izvi mumwoyo mamambo, kuti auyise kukudzwa kuimba yaJehovha muJerusarema nenzira yakadai,",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.27",
            "verseOrgIds": [
              "EZR.7.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZR 7:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye akandiitira nyasha dzake dzakanaka pamberi pamambo namakurukota ake namachinda ake ose ane simba. Nokuti ruoko rwaJehovha Mwari wangu rwakanga rwuri pamusoro pangu, ndikashinga uye ndikakoka varume vaikudzwa pakati pavaIsraeri kuti vaende neni.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.28",
            "verseOrgIds": [
              "EZR.7.28"
            ]
          }
        }
      ]
    }
  ],
