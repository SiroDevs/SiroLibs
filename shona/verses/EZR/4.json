  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "EZR 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Vavengi vanodzivisa kuvakwa kweTemberi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZR 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vavengi veJudha neBhenjamini vakati vanzwa kuti vatapwa vakanga vachivaka temberi yaJehovha, Mwari weIsraeri,",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.1",
            "verseOrgIds": [
              "EZR.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZR 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "vakauya kuna Zerubhabheri nokuvakuru vedzimba vakati, \"Titenderei kuti tikubatsirei kuvaka nokuti tinotsvaka Mwari wenyu, sezvamunoitawo, uye tinomubayira kubva pamazuva aEsarihadhoni mambo weAsiria, akatisvitsa pano.\"",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.2",
            "verseOrgIds": [
              "EZR.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZR 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi Zerubhabheri, Jeshua navamwe vose vakuru vedzimba dzeIsraeri vakapindura vakati, \"Hamuna mugove nesu mukuvaka temberi yaMwari wedu. Isu pachedu ndisu tichaivakira Jehovha, Mwari waIsraeri, sezvatakarayirwa naMambo Sirasi, mambo wePezhia.\"",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.3",
            "verseOrgIds": [
              "EZR.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZR 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo marudzi akanga akavakomberedza akauya kuzoodza mwoyo yavanhu veJudha uye nokuvaita kuti vatye kuramba vachivaka.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.4",
            "verseOrgIds": [
              "EZR.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZR 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakapa mari vapi vamazano kuti vavapikise uye vavakanganise paurongwa hwavo panguva yose yokutonga kwaSirasi mambo wePezhia uye kusvikira pakutonga kwaDhariasi mambo wePezhia.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.5",
            "verseOrgIds": [
              "EZR.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kumwe kudziviswa kwakazotevera panguva yokutonga kwaZekisesi napanguva yokutonga kwaAtazekisesi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZR 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakutanga kwokubata ushe kwaZekisesi vakapomera mhosva kuvanhu veJudha neveJerusarema.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.6",
            "verseOrgIds": [
              "EZR.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZR 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye napamazuva aAtazekisesi mambo wePezhia, Bhishirami, Mitiredhati, Tabheeri navamwe vake vose vakanyora tsamba kuna Atazekisesi. Tsamba yacho yakanga yakanyorwa namavara echiAramu uye nomutauro wechiAramu.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.7",
            "verseOrgIds": [
              "EZR.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZR 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rehumi muchinda mukuru naShimishai munyori vakanyora tsamba kuna mambo Atazekisesi vachipomera Jerusarema vachiti:",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.8",
            "verseOrgIds": [
              "EZR.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZR 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rehumi muchinda mukuru naShimishai munyori, pamwe chete navamwe vavo vose, vatongi namakurukota vanotungamirira vanhu veTiriporisi, nevePezhia, neveEreki neBhabhironi, navaEramu veSusa,",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.9",
            "verseOrgIds": [
              "EZR.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZR 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye navamwe vanhu avo vakadzingwa naAshuribhanipari mukuru uye anokudzwa, uye vakandogara muguta reSamaria nokune dzimwe nzvimbo dziri mhiri kwaYufuratesi.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.10",
            "verseOrgIds": [
              "EZR.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZR 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aya ndiwo mashoko etsamba yavakatumira kwaari:",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.11",
            "verseOrgIds": [
              "EZR.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pmo",
        "vid": "EZR 4:11"
      },
      "items": [
        {
          "text": "Kuna Mambo Atazekisesi,",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.11",
            "verseOrgIds": [
              "EZR.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pmo",
        "vid": "EZR 4:11"
      },
      "items": [
        {
          "text": "Kubva kuvaranda venyu, varume vagere mhiri kwaYufuratesi:",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.11",
            "verseOrgIds": [
              "EZR.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZR 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo ngaazvizive kuti vaJudha vakabva kwenyu vakauya kwatiri kuno vakaenda kuJerusarema uye vava kuvakazve guta riya rokumukira uye rakaipa. Vari kuvakazve masvingo aro uye vari kugadziridza nheyo dzayo.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.12",
            "verseOrgIds": [
              "EZR.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZR 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamusoro pezvo, mambo ngaazive kuti kana guta iri rikavakwa uye masvingo aro akavakwazve, hakuchazova nemhando dzose dzemitero, mutero womunhu mumwe nomumwe, kana mutero wokumuganhu kwenyika, uye mari inoripwa kuna mambo ichava shoma.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.13",
            "verseOrgIds": [
              "EZR.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZR 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino isu zvatinokudza imba yamambo, taona zvisina kufanira kuona mambo achininipiswa, naizvozvo tatumira mashoko aya kuti tizivise mambo,",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.14",
            "verseOrgIds": [
              "EZR.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZR 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuitira kuti kutsvagisiswe mumabhuku enhoroondo avakakutangirai. Mumabhuku aya muchaona kuti guta iri iguta rinomukira, rinotambudza madzimambo namatunhu, inzvimbo inomukira kubva kare. Ndokusaka guta iri rakaparadzwa.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.15",
            "verseOrgIds": [
              "EZR.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZR 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tinozivisa mambo kuti kana guta iri rikavakwa uye masvingo aro akamiswazve, muchasara musina chinhu mhiri kwaYufuratesi.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.16",
            "verseOrgIds": [
              "EZR.4.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZR 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo akatumira mhinduro iyi:",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.17",
            "verseOrgIds": [
              "EZR.4.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pmo",
        "vid": "EZR 4:17"
      },
      "items": [
        {
          "text": "Kuna Rehumi muchinda mukuru, naShimishai munyori navamwe vavo vose vagere muSamaria uye navagere mune dzimwe nzvimbo mhiri kwaYufuratesi:",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.17",
            "verseOrgIds": [
              "EZR.4.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pmo",
        "vid": "EZR 4:17"
      },
      "items": [
        {
          "text": "Kwaziwai.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.17",
            "verseOrgIds": [
              "EZR.4.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZR 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsamba yamakatitumira yakaverengwa uye ikadudzirwa pamberi pangu.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.18",
            "verseOrgIds": [
              "EZR.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZR 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakarayira uye zvikatsvakwa, zvikaonekwa kuti guta iri rine nhoroondo yokumukira madzimambo kubva kare uye raiva nzvimbo yokumukira madzimambo nokurangana zvakaipa.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.19",
            "verseOrgIds": [
              "EZR.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZR 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jerusarema rakanga rine madzimambo ane simba akanga achitonga nzvimbo yose iri mhiri kwaYufuratesi, uye mitero, nemhando dzose dzemitero, mutero womunhu mumwe nomumwe, kana mutero wokumuganhu kwenyika, yairipirwa kwavari.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.20",
            "verseOrgIds": [
              "EZR.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZR 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino rayirai vanhu ava kuti varege basa, kuti guta iri rirege kuvakwa, kusvikira ini ndazorayira kuti zviitwe.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.21",
            "verseOrgIds": [
              "EZR.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZR 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chenjererai kuti musarega nyaya iyi. Mungaregereiko chakaipa ichi chichikura, kuti chigokanganisa zvido zvamambo?",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.22",
            "verseOrgIds": [
              "EZR.4.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZR 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakangoverengwa tsamba yaMambo Atazekisesi kuna Rehumi naShimishai munyori navamwe vavo, vakabva vaenda pakarepo kuvaJudha vaiva muJerusarema vakavamanikidza nechisimba kuti varege kuvaka.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.23",
            "verseOrgIds": [
              "EZR.4.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZR 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokudaro basa reimba yaMwari rakamira kuitwa muJerusarema kusvikira gore rechipiri rokutonga kwaDhariasi mambo wePezhia.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.24",
            "verseOrgIds": [
              "EZR.4.24"
            ]
          }
        }
      ]
    }
  ],
