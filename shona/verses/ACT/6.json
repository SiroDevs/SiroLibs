  "verseCount": 15,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "ACT 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kusarudzwa kwaVanomwe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumazuva iwayo vadzidzi zvavakanga vachiwedzerwa pauwandu, vaJudha vaitaura chiGiriki vaiva pakati pavo vakagununʼuna pamusoro pavaJudha vaitaura chiHebheru nokuti chirikadzi dzavo dzaidarikwa pakugoverwa kwezvokudya zvemisi yose.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.1",
            "verseOrgIds": [
              "ACT.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka vane gumi navaviri vakaunganidza vadzidzi vose pamwe chete vakati, \"Hazvingavi zvakanaka kwatiri kuti tirege ushumiri hweshoko raMwari kuti tishande pamatafura.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.2",
            "verseOrgIds": [
              "ACT.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hama, sarudzai varume vanomwe pakati penyu vanozivikanwa kuti vakazadzwa noMweya nouchenjeri. Isu tichaisa basa iri kwavari,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.3",
            "verseOrgIds": [
              "ACT.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye ticharamba tiri pakunyengetera napaushumiri hweshoko.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.4",
            "verseOrgIds": [
              "ACT.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shoko iri rakafadza boka rose. Vakasarudza Sitefani, murume akanga azere nokutenda uye noMweya Mutsvene; uyezve Firipi, Pirokorasi, Nikano, Timoni, Pamenasi, naNikorasi aibva kuAndioki, akanga akatendeukira kuchitendero chechiJudha.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.5",
            "verseOrgIds": [
              "ACT.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakaisa varume ava kuvapostori, ivo vakavanyengeterera vakaisa maoko pamusoro pavo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.6",
            "verseOrgIds": [
              "ACT.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka shoko raMwari rakapararira. Vadzidzi vakawanda kwazvo paJerusarema, uye boka guru ravaprista rakagamuchira kutenda.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.7",
            "verseOrgIds": [
              "ACT.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kubatwa kwaSitefani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino Sitefani, murume akanga azere nenyasha dzaMwari nesimba, akaita zvishamiso zvikuru nezviratidzo pakati pavanhu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.8",
            "verseOrgIds": [
              "ACT.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kusapindirana kwakamuka, kuchibva kunhengo dzeSinagoge reVokusununguka (ndiro raiva zita ravo), vaJudha vokuSairini nevokuArekizandiria pamwe chete namatunhu eKirikia neEzhia. Varume ava vakatanga kukakavadzana naSitefani,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.9",
            "verseOrgIds": [
              "ACT.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "asi havana kugona kukunda uchenjeri hwake kana Mweya waaitaura nawo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.10",
            "verseOrgIds": [
              "ACT.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo vakakurudzira vamwe varume muchivande kuti vati, \"Tanzwa Sitefani achitaura mashoko okumhura Mozisi naMwari.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.11",
            "verseOrgIds": [
              "ACT.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokudaro vakamutsa mwoyo yavanhu navakuru uye navadzidzisi vomurayiro. Vakabata Sitefani vakamuuyisa pamberi peDare Guru.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.12",
            "verseOrgIds": [
              "ACT.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakabudisa zvapupu zvenhema, zvikati, \"Munhu uyu haamboregi kutaura zvakaipa pamusoro penzvimbo tsvene ino uye napamusoro pomurayiro.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.13",
            "verseOrgIds": [
              "ACT.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti takamunzwa achiti Jesu uyu weNazareta achaparadza nzvimbo ino uye agoshandura tsika dzatakapiwa naMozisi.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.14",
            "verseOrgIds": [
              "ACT.6.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vose vakanga vagere muDare Guru vakatarisisa Sitefani vakaona kuti chiso chake chakanga chaita sechiso chomutumwa.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.6.15",
            "verseOrgIds": [
              "ACT.6.15"
            ]
          }
        }
      ]
    }
  ],
