  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "25",
        "style": "c",
        "sid": "ACT 25"
      },
      "items": [
        {
          "text": "25",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Pauro anotongwa pamberi paFesitasi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwakati kwapera mazuva matatu mushure mokusvika kwake munyika iyo, Fesitasi akakwira kubva kuKesaria akaenda kuJerusarema,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.1",
            "verseOrgIds": [
              "ACT.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "vaprista vakuru navakuru vavaJudha vakamira pamberi pake vakapira mhosva yaPauro kwaari.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.2",
            "verseOrgIds": [
              "ACT.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vakakumbira zvikuru kuna Fesitasi, sechinhu chinofadza kwavari, kuti Pauro aendeswe kuJerusarema, nokuti vakanga vachigadzirira kumuvandira kuti vagomuuraya munzira imomo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.3",
            "verseOrgIds": [
              "ACT.25.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fesitasi akapindura akati, \"Pauro akachengetwa paKesaria, uye ini pachangu ndichaendako nokukurumidza.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.4",
            "verseOrgIds": [
              "ACT.25.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vamwe vavakuru venyu ngavaende neni vagondokwirira munhu uyu ikoko, kana akaita chinhu chipi zvacho chakaipa.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.5",
            "verseOrgIds": [
              "ACT.25.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akati apedza mazuva masere kana gumi navo, akaburuka akaenda kuKesaria, uye zuva rakatevera akaunganidza vedare akarayira kuti Pauro auyiswe pamberi pake.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.6",
            "verseOrgIds": [
              "ACT.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pauro akati asvika, vaJudha vakanga vabva kuJerusarema vakamira vakamukomberedza, vachimupomera mhosva dzakaipisisa, dzavakanga vasingakwanisi kusimbisa.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.7",
            "verseOrgIds": [
              "ACT.25.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Pauro akazvidavirira achiti, \"Ini handina kuita chinhu chakaipa pamusoro pomurayiro wavaJudha kana temberi kana Kesari.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.8",
            "verseOrgIds": [
              "ACT.25.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fesitasi achida kufadza vaJudha, akati kuna Pauro, \"Unoda here kuenda kuJerusarema kuti undomira pamberi pangu uchitongwa neni ikoko pamusoro pemhosva dzaunopomerwa idzi?\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.9",
            "verseOrgIds": [
              "ACT.25.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pauro akapindura akati, \"Iye zvino ndimire pamberi pedare raKesari, munova ndimo mandinofanira kutongwa. Handina kuita chinhu chakaipa kuvaJudha, sezvamunonyatsoziva imi pachenyu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.10",
            "verseOrgIds": [
              "ACT.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunyange zvakadaro hazvo, kana ndine mhosva yokuita chinhu chipi zvacho chinokodzera rufu, handingarambi kufa. Asi kana mhosva dzandinopomerwa navaJudha dzisina chokwadi, hakuna munhu ane mvumo yokundiisa kwavari. Ndinozviisa kuna Kesari!\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.11",
            "verseOrgIds": [
              "ACT.25.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shure kwokunge Fesitasi ataurirana namakurukota ake, akati, \"Wazviisa kuna Kesari. Kuna Kesari uchaenda!\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.12",
            "verseOrgIds": [
              "ACT.25.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Fesitasi anobvunza Mambo Agiripa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shure kwamazuva mashoma, Mambo Agiripa naBhenisi vakasvika paKesaria kuti vandopa ruremekedzo rwavo kuna Fesitasi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.13",
            "verseOrgIds": [
              "ACT.25.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sezvo vakanga vachipedza mazuva mazhinji ikoko, Fesitasi akakurukura nyaya yaPauro namambo. Akati, \"Pane murume ari pano akasiyiwa ari musungwa naFerikisi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.14",
            "verseOrgIds": [
              "ACT.25.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pandakaenda kuJerusarema, vaprista vakuru navakuru vavaJudha vakauya vachimupomera mhosva vakakumbira kuti atongwe.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.15",
            "verseOrgIds": [
              "ACT.25.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndakavaudza kuti haisi tsika yavaRoma, yokuendesa munhu upi zvake kuti andofa asati asangana navapomeri vake, uye apiwa mukana wokuzvidavirira pamusoro pemhosva yavanomupomera.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.16",
            "verseOrgIds": [
              "ACT.25.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pavakauya pano neni, handina kunonotsa nyaya iyi, asi ndakadana dare pazuva rakatevera ndikarayira kuti munhu uyu apinzwe mudare.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.17",
            "verseOrgIds": [
              "ACT.25.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vaimupomera vakati vasimuka kuti vataure, havana kumupomera mhosva ipi zvayo yandaitarisira.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.18",
            "verseOrgIds": [
              "ACT.25.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi, vaingova namashoko okukakavadzana naye pamusoro pechitendero chavo uye napamusoro pomurume akafa anonzi Jesu, uyo anonzi naPauro mupenyu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.19",
            "verseOrgIds": [
              "ACT.25.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 25:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakashaya ruzivo rwokuferefeta nyaya dzakadai; saka ndakabvunza kana aida hake kuenda kuJerusarema kuti andotongwa ikoko pamusoro pemhosva idzi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.20",
            "verseOrgIds": [
              "ACT.25.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 25:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pauro akati azvisarudzira kuti achengetwe kuti azotongwa pamberi paMambo Kesari, ndakarayira kuti achengetwe kusvikira ndazomutumira kuna Kesari.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.21",
            "verseOrgIds": [
              "ACT.25.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 25:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Agiripa akati kuna Fesitasi, \"Ndingada kunzwa munhu uyu pachangu.\" Akapindura akati, \"Muchamunzwa mangwana.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.22",
            "verseOrgIds": [
              "ACT.25.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Pauro pamberi paAgiripa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 25:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zuva rakatevera, Agiripa naBhenisi vakauya nokukudzwa kukuru vakapinda mumba maitambirwa mhaka vane machinda ezvigaro zvapamusoro uye navarume vaitungamirira guta. Varayirwa naFesitasi, Pauro akapinzwa mukati.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.23",
            "verseOrgIds": [
              "ACT.25.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 25:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fesitasi akati, \"Mambo Agiripa nemi mose muri pano nesu, muri kuona murume uyu! Ungano yose yavaJudha yakandikumbira pamusoro pake muJerusarema uye nomuno muKesaria, vachidanidzira vachiti haafaniri kutongoramba ari mupenyu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.24",
            "verseOrgIds": [
              "ACT.25.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 25:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ini ndakawana asina kuita chinhu chingafanira rufu, asi nokuda kwokuti akazviisa kuna Kesari, ndakafunga kumutumira kuRoma.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.25",
            "verseOrgIds": [
              "ACT.25.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 25:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi handina chinhu chandinganyatsorondedzera chokuti ndinyorere kuna Changamire pamusoro pake. Naizvozvo ndamuuyisa pamberi penyu iyemi mose, kunyanya pamberi penyu, Mambo Agiripa, kuitira kuti zvichabuda pakuferefeta uku zvigondiwanisa zvokunyora.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.26",
            "verseOrgIds": [
              "ACT.25.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 25:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokuti ndinofunga kuti hazvina ungwaru kutumira musungwa pasina rondedzero chaiyo yemhosva yake.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.27",
            "verseOrgIds": [
              "ACT.25.27"
            ]
          }
        }
      ]
    }
  ],
