      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EXO 15:10"
      },
      "items": [
        {
          "text": "gungwa rikavafukidza.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.10",
            "verseOrgIds": [
              "EXO.15.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EXO 15:10"
      },
      "items": [
        {
          "text": "Vakanyura somutobvu",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.10",
            "verseOrgIds": [
              "EXO.15.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EXO 15:10"
      },
      "items": [
        {
          "text": "mukati memvura ine simba.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.10",
            "verseOrgIds": [
              "EXO.15.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
