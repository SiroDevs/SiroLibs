          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndianiko pakati pavamwari akaita semi, imi Jehovha?",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.11",
            "verseOrgIds": [
              "EXO.15.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EXO 15:11"
      },
      "items": [
        {
          "text": "Ndiani akaita semi,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.11",
            "verseOrgIds": [
              "EXO.15.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q3",
        "vid": "EXO 15:11"
      },
      "items": [
        {
          "text": "paumambo noutsvene,",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q3",
        "vid": "EXO 15:11"
      },
      "items": [
        {
          "text": "mukubwinya kunotyisa,",
          "type": "text"
        }
      ]
