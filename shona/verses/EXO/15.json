            "sid": "EXO 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mvura yakadzika yakavafukidza;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.5",
            "verseOrgIds": [
              "EXO.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EXO 15:5"
      },
      "items": [
        {
          "text": "vakanyura kwakadzika sedombo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.5",
            "verseOrgIds": [
              "EXO.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ruoko rwenyu rworudyi, imi Jehovha,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.6",
            "verseOrgIds": [
              "EXO.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EXO 15:6"
      },
      "items": [
        {
          "text": "rwakakudzwa nesimba.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.6",
            "verseOrgIds": [
              "EXO.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EXO 15:6"
      },
      "items": [
        {
          "text": "Ruoko rwenyu rworudyi, imi Jehovha,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.6",
            "verseOrgIds": [
              "EXO.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EXO 15:6"
      },
      "items": [
        {
          "text": "rwakaparadza muvengi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.6",
            "verseOrgIds": [
              "EXO.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Muukuru hwoumambo hwenyu",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.7",
            "verseOrgIds": [
              "EXO.15.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EXO 15:7"
      },
      "items": [
        {
          "text": "makakanda pasi vaya vaikupikisai.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.7",
            "verseOrgIds": [
              "EXO.15.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EXO 15:7"
      },
      "items": [
        {
          "text": "Makasunungura kutsamwa kwenyu kunopisa,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.7",
            "verseOrgIds": [
              "EXO.15.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EXO 15:7"
      },
      "items": [
        {
          "text": "kukavapisa sehundi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.7",
            "verseOrgIds": [
              "EXO.15.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokufema kwemhino dzenyu",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.8",
            "verseOrgIds": [
              "EXO.15.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EXO 15:8"
      },
      "items": [
        {
          "text": "mvura zhinji yakaita murwi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.8",
            "verseOrgIds": [
              "EXO.15.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EXO 15:8"
      },
      "items": [
        {
          "text": "Mvura yamasaisai yakamira yakasimba semadziro;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.8",
            "verseOrgIds": [
              "EXO.15.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EXO 15:8"
      },
      "items": [
        {
          "text": "mvura yakadzika yakaungana mukati megungwa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.8",
            "verseOrgIds": [
              "EXO.15.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
