    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EXO 15:9"
      },
      "items": [
        {
          "text": "'Ndichavatevera, ndichavabata.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.9",
            "verseOrgIds": [
              "EXO.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EXO 15:9"
      },
      "items": [
        {
          "text": "Ndichagova zvakapambwa;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.9",
            "verseOrgIds": [
              "EXO.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EXO 15:9"
      },
      "items": [
        {
          "text": "ndichazvimbirwa navo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.9",
            "verseOrgIds": [
              "EXO.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EXO 15:9"
      },
      "items": [
        {
          "text": "Ndichavhomora munondo wangu",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.9",
            "verseOrgIds": [
              "EXO.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EXO 15:9"
      },
      "items": [
        {
          "text": "uye ruoko rwangu ruchavaparadza.'",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.9",
            "verseOrgIds": [
              "EXO.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
