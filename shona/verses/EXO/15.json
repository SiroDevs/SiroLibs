          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Muvengi akazvikudza achiti,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.9",
            "verseOrgIds": [
              "EXO.15.9"
            ]
          }
        }
      ]
