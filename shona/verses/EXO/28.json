  "verseCount": 43,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "28",
        "style": "c",
        "sid": "EXO 28"
      },
      "items": [
        {
          "text": "28",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nguo dzoUprista",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 28:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Uite kuti Aroni mukoma wako pamwe chete navanakomana vake vanoti Nadhabhi naAbhihu, Ereazari naItamari vauyiswe kwandiri kubva pakati pavaIsraeri kuti vandishumire savaprista.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.1",
            "verseOrgIds": [
              "EXO.28.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 28:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uitire mukoma wako nguo tsvene, kuti apiwe ruremekedzo uye kukudzwa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.2",
            "verseOrgIds": [
              "EXO.28.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 28:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utaurire varume voumhizha vose vandakapa uchenjeri hwokuita zvakadaro kuti vanofanira kusonera Aroni nguo, dzokutsaurwa kwake, kuti agondishumira somuprista.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.3",
            "verseOrgIds": [
              "EXO.28.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Idzi ndidzo nguo dzavanofanira kuita: chidzitiro chapachipfuva, efodhi, jasi, nenguo yakarukwa, nguwani nendaza. Vanofanira kuitira mukoma wako Aroni navanakomana vake, nguo tsvene idzi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.4",
            "verseOrgIds": [
              "EXO.28.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 28:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uvaite kuti vashandise wuru yegoridhe, nebhuruu, pepuru netsvuku uye mucheka wakaisvonaka.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.5",
            "verseOrgIds": [
              "EXO.28.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Efodhi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 28:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Vaite efodhi yewuru yegoridhe, nebhuruu, pepuru netsvuku, nomucheka wakarukwa zvakaisvonaka, basa romunhu ano umhizha.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.6",
            "verseOrgIds": [
              "EXO.28.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngaive namapenga maviri apamapfudzi akabatanidzwa pamakona ayo maviri, kuitira kuti igogona kubatanidzwa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.7",
            "verseOrgIds": [
              "EXO.28.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bhanhire rayo rakarukwa noumhizha rinofanira kufanana nayo, rive rebenga rimwe chete neefodhi uye rakagadzirwa newuru yegoridhe, nebhuruu, pepuru netsvuku, uye nomucheka wakarukwa zvakaisvonaka.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.8",
            "verseOrgIds": [
              "EXO.28.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 28:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Utore mabwe maviri eonikisi ugonyora runyoro rwakatemwa pamusoro pawo mazita avanakomana vaIsraeri",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.9",
            "verseOrgIds": [
              "EXO.28.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "zvichienderana nokuberekwa kwavo, mazita matanhatu padombo rimwe chete uye mamwe matanhatu asara anyorwe pane rimwe dombo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.10",
            "verseOrgIds": [
              "EXO.28.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 28:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyora mazita avanakomana vaIsraeri pamatombo maviri nenzira inoitwa nomuvezi wamatombo achitema runyoro pachisimbiso. Ipapo ugoamisa muzvirukwa zvegoridhe",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.11",
            "verseOrgIds": [
              "EXO.28.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 28:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye ugoasungirira pamapenga apapfudzi eefodhi ave matombo echirangaridzo kuvana vaIsraeri. Aroni anofanira kutakura mazita aya pamapfudzi ake chive chirangaridzo pamberi paJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.12",
            "verseOrgIds": [
              "EXO.28.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 28:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uite zvirukwa zvegoridhe",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.13",
            "verseOrgIds": [
              "EXO.28.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 28:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye nengetani mbiri dzakarukwa setambo negoridhe rakaisvonaka, ugobatanidza ngetani nezvirukwa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.14",
            "verseOrgIds": [
              "EXO.28.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Chidzitiro chapaChipfuva",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 28:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Uite chidzitiro chapachipfuva chokutanga, basa romunhu woumhizha. Uchiite chifanane neefodhi yewuru yegoridhe, nebhuruu, pepuru netsvuku, uye mucheka wakarukwa zvakaisvonaka.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.15",
            "verseOrgIds": [
              "EXO.28.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 28:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngachienzane mativi ose ari mana, kureba kwacho sechanza choruoko",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.16",
            "verseOrgIds": [
              "EXO.28.16"
            ]
          }
        },
        {
          "text": "uye upamhi hwakaita sechanza choruoko, uye chipetwe kaviri.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.16",
            "verseOrgIds": [
              "EXO.28.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 28:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo uronge mitsara mina yamatombo anokosha pamusoro pacho. Mumutsara wokutanga muchava nerubhi, netopazi uye bheriri;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.17",
            "verseOrgIds": [
              "EXO.28.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 28:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "mumutsara wechipiri muchava neturikoisi, safire neemaradhi;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.18",
            "verseOrgIds": [
              "EXO.28.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 28:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "mumutsara wechitatu muchava nejasindi, agati neametisiti;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.19",
            "verseOrgIds": [
              "EXO.28.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 28:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "mumutsara wechina muchava nekirisoriti, onekisi uye nejasipa. Uaise muzvirukwa zvegoridhe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.20",
            "verseOrgIds": [
              "EXO.28.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 28:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panofanira kuva namatombo gumi namaviri, rimwe chete richimirira zita rimwe nerimwe ravanakomana vaIsraeri, rimwe nerimwe rakatemwa runyoro padombo sezvinoita chisimbiso chezita romumwe wavamarudzi gumi namaviri.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.21",
            "verseOrgIds": [
              "EXO.28.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 28:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Uite ngetani dzechidzitiro chapachipfuva dzakarukwa negoridhe rakaisvonaka, uzvimone setambo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.22",
            "verseOrgIds": [
              "EXO.28.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 28:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uite mhete mbiri dzegoridhe ugodzisungirira pamakona maviri echidzitiro chapachipfuva.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.23",
            "verseOrgIds": [
              "EXO.28.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 28:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usungirire ngetani mbiri dzegoridhe pamhete dziri pamakona echidzitiro chapachipfuva,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.24",
            "verseOrgIds": [
              "EXO.28.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 28:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "nemimwe micheto yengetani inoenda kuzvirukwa zviviri uchizvibatanidza, kuzvipenga zvapamapfudzi zveefodhi nechokumberi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.25",
            "verseOrgIds": [
              "EXO.28.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 28:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uite mhete mbiri dzegoridhe ugodzibatanidza kuna mamwe makona echidzitiro chapachipfuva pamupendero wechomukati kunotevererana neefodhi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.26",
            "verseOrgIds": [
              "EXO.28.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 28:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uitezve dzimwe mhete dzegoridhe ugodzibatanidza pasi pemapenga apamapfudzi nechokumberi kweefodhi, pedyo nomusono uri nechapamusoro pebhanhire romuchiuno reefodhi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.27",
            "verseOrgIds": [
              "EXO.28.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 28:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mhete dzepachidzitiro chechipfuva dzinofanira kusungirirwa pamhete dzeefodhi netambo yebhuruu, dzichibatanidzwa nebhanhire romuchiuno, kuitira kuti chidzitiro chapachipfuva chirege kubva paefodhi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.28",
            "verseOrgIds": [
              "EXO.28.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 28:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nguva dzose Aroni paanenge achipinda muNzvimbo Tsvene, achange akatakura mazita avanakomana vaIsraeri pamwoyo wake pachidzitiro chechipfuva chokutonga sechirangaridzo chenguva dzose pamberi paJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.29",
            "verseOrgIds": [
              "EXO.28.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 28:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyezve uise Urimi neTumimi muchidzitiro chechipfuva, kuitira kuti vagare vari pamwoyo waAroni pose paanenge achipinda pamberi paJehovha. Nokudaro Aroni acharamba akatakura zvinhu zvokutonga nazvo vaIsraeri pamwoyo wake pamberi paJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.30",
            "verseOrgIds": [
              "EXO.28.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Dzimwe Nguo dzoUprista",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 28:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Uite jasi rose zvaro reefodhi nomucheka webhuruu,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.31",
            "verseOrgIds": [
              "EXO.28.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 28:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "neburi romusoro pakati paro. Panofanira kuzova nomupendero wakarukwa wakaita sekora unopoteredza buri iri, kuitira kuti rirege kubvaruka.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.32",
            "verseOrgIds": [
              "EXO.28.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 28:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uite matamba ewuru yebhuruu, yepepuru netsvuku akapoteredza mupendero wejasi, namatare egoridhe pakati pawo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.33",
            "verseOrgIds": [
              "EXO.28.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 28:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Matare egoridhe namatamba zvinofanira kukayana zvichipoteredza mupendero wejasi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.34",
            "verseOrgIds": [
              "EXO.28.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 28:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aroni anofanira kuripfeka paanenge achishumira. Kurira kwamatare kuchanzwikwa paanenge achipinda muNzvimbo Tsvene pamberi paJehovha uye nepaanenge achibuda, kuitira kuti arege kufa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.35",
            "verseOrgIds": [
              "EXO.28.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EXO 28:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Uite ndiro yegoridhe ugotema runyoro pairi sezvinoitwa pachisimbiso kuti: MUTSVENE KUNA JEHOVHA.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.36",
            "verseOrgIds": [
              "EXO.28.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "EXO 28:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usungire tambo yebhuruu pairi kuti ibatanidzwe nenguwani; inofanira kuva mberi kwenguwani.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.37",
            "verseOrgIds": [
              "EXO.28.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "EXO 28:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichava pahuma yaAroni, uye iye achatakura mhosva dzingava pazvipo zvitsvene zvinotsaurwa navaIsraeri, zvingava zvipo zvipi hazvo. Zvichava pahuma yaAroni nguva dzose kuitira kuti zvigamuchirwe naJehovha.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.38",
            "verseOrgIds": [
              "EXO.28.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "EXO 28:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Uruke jasi romucheka wakaisvonaka ugoita nguwani yomucheka wakaisvonaka. Ndaza inofanira kuva basa romuruki.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.39",
            "verseOrgIds": [
              "EXO.28.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "EXO 28:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uite majasi, ndaza namabhanhire omumusoro avanakomana vaAroni, kuti vapiwe ruremekedzo nokukudzwa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.40",
            "verseOrgIds": [
              "EXO.28.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "EXO 28:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shure kwokunge wapfekedza mukoma wako Aroni navanakomana vake, uvazodze uye ugovagadza. Uvatsaure kuti vagondishumira savaprista.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.41",
            "verseOrgIds": [
              "EXO.28.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "EXO 28:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Uite nguo dzapasi dzomucheka dzive chifukidzo chomuviri, dzinobva muchiuno kusvikira kumabvi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.42",
            "verseOrgIds": [
              "EXO.28.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "EXO 28:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aroni navanakomana vake vanofanira kudzipfeka pose pavanenge vachipinda muTende roKusangana kana kuswedera paaritari kuti vashumire vari muNzvimbo Tsvene, kuitira kuti varege kuva nemhosva vakafa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.43",
            "verseOrgIds": [
              "EXO.28.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EXO 28:43"
      },
      "items": [
        {
          "text": "\"Uchava mutemo wokusingaperi kuna Aroni nezvizvarwa zvake.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.43",
            "verseOrgIds": [
              "EXO.28.43"
            ]
          }
        }
      ]
    }
  ],
