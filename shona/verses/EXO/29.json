        "sid": "EXO 29"
      },
      "items": [
        {
          "text": "29",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kunatswa kwaVaprista",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 29:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Izvi ndizvo zvaunofanira kuita kuti uvanatse, kuti vandishumire savaprista: Utore hando duku namakondobwe maviri asina chinongo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.1",
            "verseOrgIds": [
              "EXO.29.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye ubike chingwa noupfu hwakatsetseka hwegorosi, husina mbiriso, uye ubike makeke akavhenganiswa namafuta, nezvingwa zvitete zvakazorwa mafuta.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.2",
            "verseOrgIds": [
              "EXO.29.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzviise mudengu uye ugozvikumikidza zviri imomo, pamwe chete nehando uye makondobwe maviri.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.3",
            "verseOrgIds": [
              "EXO.29.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 29:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo ugouya naAroni navanakomana vake kumukova wokupinda nawo kuTende Rokusangana ugovashambidza nemvura.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.4",
            "verseOrgIds": [
              "EXO.29.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tora hanzu ugopfekedza Aroni jasi, nguo yeefodhi neefodhi pachayo uye nechidzitiro chapachipfuva. Usungire efodhi paari nebhanhire romuchiuno rakarukwa nounyanzvi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.5",
            "verseOrgIds": [
              "EXO.29.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 29:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uise nguwani pamusoro wake uye ugoibatanidza nekorona tsvene.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.6",
            "verseOrgIds": [
              "EXO.29.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 29:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utore mafuta okuzodza ugomuzodza uchiita zvokuadira pamusoro pake.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.7",
            "verseOrgIds": [
              "EXO.29.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 29:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye vanakomana vake ugovapfekedza majasi",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.8",
            "verseOrgIds": [
              "EXO.29.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye ugoisa mabhanhire omumusoro pamusoro pavo. Ipapo ugosungira ndaza pana Aroni navanakomana vake. Uprista ndohwavo nomutemo usingaperi. Nenzira iyi uchagadza Aroni navanakomana vake.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.9",
            "verseOrgIds": [
              "EXO.29.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 29:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Uuye nehando pamberi peTende Rokusangana, uye Aroni navanakomana vake vachaisa maoko avo pamusoro payo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.10",
            "verseOrgIds": [
              "EXO.29.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uiuraye pamberi pomukova wokupinda kuTende Rokusangana.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.11",
            "verseOrgIds": [
              "EXO.29.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 29:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utore rimwe reropa rehando ugoriisa panyanga dzearitari nomunwe wako, uye ugodira rasara racho pahwaro hwearitari.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.12",
            "verseOrgIds": [
              "EXO.29.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 29:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo ugotora mafuta ose akapoteredza zvomukati, zvinoti chiropa, neitsvo dziri mbiri namafuta ari pamusoro padzo, ugoapisa pamusoro pearitari.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.13",
            "verseOrgIds": [
              "EXO.29.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 29:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi upise nyama yehando nedehwe rayo namazvizvi ayo kunze kwomusasa. Ndicho chipiriso chechivi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.14",
            "verseOrgIds": [
              "EXO.29.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 29:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Utore rimwe regondobwe, uye Aroni navanakomana vake vagoisa maoko avo pamusoro paro.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.15",
            "verseOrgIds": [
              "EXO.29.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 29:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uriuraye ugotora ropa raro urisase pamativi ose earitari.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.16",
            "verseOrgIds": [
              "EXO.29.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 29:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ucheke gondobwe kuita muzvidimbu zvidimbu uye ugosuka zvomukati, uye makumbo, uchiaisa pamwe chete nomusoro nezvimwe zvidimbu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.17",
            "verseOrgIds": [
              "EXO.29.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 29:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo ugopisa gondobwe rose paaritari. Ndicho chipiriso chinopiswa kuna Jehovha, chinonhuhwira zvinofadza, chipiriso chinoitirwa Jehovha nomoto.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.18",
            "verseOrgIds": [
              "EXO.29.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 29:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Utore rimwe gondobwe, uye Aroni navanakomana vake vachaisa maoko avo pamusoro waro.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.19",
            "verseOrgIds": [
              "EXO.29.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 29:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uriuraye, utore rimwe ropa raro ugoriisa pamucheto wenzeve dzorudyi dzavanakomana vaAroni, napazvigunwe zvikuru zvamaoko avo orudyi, nokuzvigunwe zvikuru zvokutsoka dzavo dzorudyi. Ipapo ugosasa ropa pamativi ose earitari.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.20",
            "verseOrgIds": [
              "EXO.29.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 29:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye ugotora rimwe ropa riri paaritari namamwe mafuta okuzodza usase pana Aroni napanguo dzake uye napavanakomana vake napanguo dzavo. Ipapo iye navanakomana vake nenguo dzavo vachanatswa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.21",
            "verseOrgIds": [
              "EXO.29.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 29:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Utore pagondobwe iri mafuta, mafuta apamuswe, mafuta akapoteredza zvomukati, akafukidza chiropa, itsvo dzose dziri mbiri namafuta ari padziri, uye nechidya chokurudyi. (Iri ndiro gondobwe rokugadzwa.)",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.22",
            "verseOrgIds": [
              "EXO.29.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 29:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubva padengu rechingwa chakabikwa chisina mbiriso, chiri pamberi paJehovha, utore chimwe chete, nekeke rakavhenganiswa namafuta, uye nechingwa chitete.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.23",
            "verseOrgIds": [
              "EXO.29.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 29:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uise izvi zvose mumaoko aAroni navanakomana vake ugozvininira pamberi paJehovha sechipiriso chokuninira.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.24",
            "verseOrgIds": [
              "EXO.29.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 29:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo uzvitore kubva mumaoko avo ugozvipisa paaritari pamwe chete nechipiriso chinopiswa chinonhuhwira zvinofadza kuna Jehovha, chipiriso chinoitirwa Jehovha nomoto.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.25",
            "verseOrgIds": [
              "EXO.29.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 29:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shure kwokunge watora chityu chegondobwe rokugadzwa kwaAroni, uchininire pamberi paJehovha sechipiriso chokuninira uye chichava mugove wako.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.26",
            "verseOrgIds": [
              "EXO.29.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 29:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Unatse mitezo iyo yegondobwe rokugadza raAroni navanakomana vake: chityu chakaninirwa uye chakakumikidzwa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.27",
            "verseOrgIds": [
              "EXO.29.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 29:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyu unofanira kuva mugove wenguva dzose unobva kuvaIsraeri, waAroni navanakomana vake. Uyu ndiwo mugove unofanira kupiwa navaIsraeri kuna Jehovha kubva pazvipiriso zvavo zvokuwadzana.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.28",
            "verseOrgIds": [
              "EXO.29.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 29:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nguo tsvene dzaAroni dzichava dzezvizvarwa zvake kuitira kuti vazodzwe uye vagogadzwa vakadzipfeka.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.29",
            "verseOrgIds": [
              "EXO.29.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 29:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanakomana wake achamutevera pauprista uye anouya kuTende Rokusangana kuti azoshumira ari muNzvimbo Tsvene, anofanira kudzipfeka kwamazuva manomwe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.30",
            "verseOrgIds": [
              "EXO.29.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 29:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Utore gondobwe rokugadzwa ugobika nyama yaro munzvimbo tsvene.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.31",
            "verseOrgIds": [
              "EXO.29.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 29:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aroni navanakomana vake vanofanira kudya nyama yegondobwe uye nechingwa chiri mudengu vari pamukova wokupinda paTende Rokusangana.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.32",
            "verseOrgIds": [
              "EXO.29.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 29:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vanofanira kudya zvipiriso izvi zvavakaitirwa yananiso yokugadzwa kwavo uye nokunatswa kwavo nazvo. Asi hakuna mumwe munhu anofanira kuzvidya nokuti zvitsvene.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.33",
            "verseOrgIds": [
              "EXO.29.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 29:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye kana pakava nenyama yegondobwe rokugadzwa inosara kana chingwa chipi zvacho chinosara kusvikira mangwana mangwanani, muzvipise. Hazvifaniri kudyiwa, nokuti zvitsvene.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.34",
            "verseOrgIds": [
              "EXO.29.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 29:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Uitire Aroni navanakomana vake zvinhu zvose zvandakakurayira, uchitora mazuva manomwe okuvagadza.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.35",
            "verseOrgIds": [
              "EXO.29.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EXO 29:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubayire hando zuva rimwe nerimwe sechipiriso chechivi chive chokuyananisa. Unatse aritari nokuiitira yananiso, uye ugoizodza kuti uiite tsvene.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.36",
            "verseOrgIds": [
              "EXO.29.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "EXO 29:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mazuva manomwe uyananisire aritari uye uinatse. Ipapo aritari ichava tsvene-tsvene, uye chose chichaigunzva chichava chitsvene.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.37",
            "verseOrgIds": [
              "EXO.29.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "EXO 29:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Izvi ndizvo zvaunofanira kupa paaritari nguva dzose zuva rimwe nerimwe: makwayana maviri egore rimwe chete.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.38",
            "verseOrgIds": [
              "EXO.29.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "EXO 29:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubayire rimwe chete mangwanani uye nerimwe chete madekwana.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.39",
            "verseOrgIds": [
              "EXO.29.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "EXO 29:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Negwayana rokutanga ubayire nechegumi cheefa",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.40",
            "verseOrgIds": [
              "EXO.29.40"
            ]
          }
        },
        {
          "text": "choupfu hwakatsetseka hwakasanganiswa nechikamu chimwe chete kubva muzvina chehini",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.40",
            "verseOrgIds": [
              "EXO.29.40"
            ]
          }
        },
        {
          "text": "chamafuta akabva mumaorivhi akasvinwa, uye chikamu chimwe chete kubva muzvina chehini yewaini chive chipiriso chinonwiwa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.40",
            "verseOrgIds": [
              "EXO.29.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "EXO 29:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubayire rimwe gwayana zuva richangovira pamwe chete nechipiriso chimwe chetecho chezviyo nechipiriso chacho chinonwiwa sechamangwanani, chive chinonhuhwira zvinofadza, chipiriso chakaitirwa Jehovha nomoto.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.41",
            "verseOrgIds": [
              "EXO.29.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "EXO 29:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Chipiriso chinopiswa ichi chinofanira kuitwa nguva dzose pamukova weTende Rokusangana pamberi paJehovha kuzvizvarwa zvose.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.42",
            "verseOrgIds": [
              "EXO.29.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "EXO 29:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo ndipo pandichasangana newe uye ndigotaura kwauri, ndipozve pandichasangana navaIsraeri, uye nzvimbo iyi ichatsaurwa nokubwinya kwangu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.43",
            "verseOrgIds": [
              "EXO.29.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "EXO 29:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Saka ndichatsaura Tende Rokusangana nearitari uye ndichatsaura Aroni navanakomana vake kuti vandishumire savaprista.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.44",
            "verseOrgIds": [
              "EXO.29.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "EXO 29:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo ndichagara pakati pavaIsraeri uye ndigova Mwari wavo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.45",
            "verseOrgIds": [
              "EXO.29.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "EXO 29:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vachaziva kuti ndini Jehovha Mwari wavo, akavabudisa kubva muIjipiti kuitira kuti ndigogara pakati pavo. Ndini Jehovha Mwari wavo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.46",
            "verseOrgIds": [
              "EXO.29.46"
            ]
          }
        }
      ]
    }
  ],
