  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "EXO 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Zviratidzo zvaMozisi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mozisi akapindura akati, \"Ko, kana vakasanditenda kana kunditeerera uye vakati, 'Jehovha haana kuzviratidza kwauri'?\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.1",
            "verseOrgIds": [
              "EXO.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Jehovha akati kwaari, \"Chiiko icho chiri muruoko rwako?\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.2",
            "verseOrgIds": [
              "EXO.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EXO 4:2"
      },
      "items": [
        {
          "text": "Akapindura akati, \"Itsvimbo.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.2",
            "verseOrgIds": [
              "EXO.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha akati, \"Ikande pasi.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.3",
            "verseOrgIds": [
              "EXO.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EXO 4:3"
      },
      "items": [
        {
          "text": "Mozisi akaikanda pasi ikava nyoka, uye akaitiza.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.3",
            "verseOrgIds": [
              "EXO.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Jehovha akati kwaari, \"Tambanudza ruoko ugoibata nokumuswe.\" Saka Mozisi akatambanudza ruoko ndokubata nyoka uye ikadzokera pakare pakuva tsvimbo muruoko rwake.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.4",
            "verseOrgIds": [
              "EXO.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha akati, \"Izvi ndezvokuti vagotenda kuti Jehovha, Mwari wamadzibaba avo, Mwari waAbhurahama, Mwari waIsaka, naMwari waJakobho, azviratidza kwauri.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.5",
            "verseOrgIds": [
              "EXO.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Jehovha akati, \"Isa ruoko rwako muchipfuva chako.\" Saka Mozisi akaisa ruoko rwake muchipfuva chake, uye paakarubudisa, rwakanga rwachena maperembudzi, sechando.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.6",
            "verseOrgIds": [
              "EXO.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye akati, \"Zvino chirudzorerazve muchipfuva chako,\" uye paakarubudisa, rwakanga rwavandudzwa, rwaita somuviri wake wose.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.7",
            "verseOrgIds": [
              "EXO.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Jehovha akati, \"Kana vasingakutendi kana kuteerera kuchiratidzo chokutanga, vangangotendawo chechipiri.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.8",
            "verseOrgIds": [
              "EXO.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi kana vasingatendi zviratidzo zviviri izvi kana kukuteerera, utore mvura kubva muna Nairi ugoidira pasi. Mvura yaunotora kubva murwizi ichava ropa pamusoro pevhu.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.9",
            "verseOrgIds": [
              "EXO.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mozisi akati kuna Jehovha, \"Haiwa Jehovha, handina kumbogona kutaura, kunyange nakare, kana kubva pamataura nomuranda wenyu. Ndinokakama pakutaura uye rurimi rwangu runononoka.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.10",
            "verseOrgIds": [
              "EXO.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha akati kwaari, \"Ndianiko akapa munhu muromo? Ndianiko anomuita matsi kana mbeveve? Ndiani anomusvinudza kana kumuita bofu? Handisini here, Jehovha?",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.11",
            "verseOrgIds": [
              "EXO.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino chienda, ini ndichakubatsira kutaura uye ndichakudzidzisa zvokutaura.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.12",
            "verseOrgIds": [
              "EXO.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi Mozisi akati, \"Haiwa Jehovha, ndapota hangu, tumai henyu mumwe kuti aite izvozvo.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.13",
            "verseOrgIds": [
              "EXO.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo kutsamwa kwaJehovha kwakapisa pamusoro paMozisi uye akati, \"Ko, mukoma wako, Aroni muRevhi? Ndinoziva kuti anogona kutaura zvakanaka. Ari munzira kuzokuchingamidza izvozvi, uye mwoyo wake uchafara paachakuona.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.14",
            "verseOrgIds": [
              "EXO.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uchataura naye ugoisa mashoko mumuromo make; ndichakubatsirai mose uye ndichakudzidzisai zvokuita.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.15",
            "verseOrgIds": [
              "EXO.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uye achataura kuvanhu panzvimbo yako, uye zvichaita sokunge iye ndiye muromo wako uye sokunge iwe ndiwe Mwari kwaari.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.16",
            "verseOrgIds": [
              "EXO.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi takura tsvimbo iyi muruoko rwako yauchaita zviratidzo nayo.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.17",
            "verseOrgIds": [
              "EXO.4.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mozisi anodzokera kuIjipiti",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Mozisi akadzokera kuna Jeturo tezvara wake akati kwaari, \"Regai ndidzokere kuvanhu vokwangu kuIjipiti kuti ndinoona kana vachiri vapenyu.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.18",
            "verseOrgIds": [
              "EXO.4.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EXO 4:18"
      },
      "items": [
        {
          "text": "Jeturo akati, \"Enda hako, ufambe zvakanaka.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.18",
            "verseOrgIds": [
              "EXO.4.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zvino Jehovha akanga ati kuna Mozisi ari muMidhiani, \"Dzokera kuIjipiti, nokuti vanhu vose vaida kukuuraya vakafa.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.19",
            "verseOrgIds": [
              "EXO.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Mozisi akatora mukadzi wake navanakomana vake akavakwidza pambongoro akasimuka akadzokera kuIjipiti. Uye akatakura tsvimbo yaMwari muruoko rwake.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.20",
            "verseOrgIds": [
              "EXO.4.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha akati kuna Mozisi, \"Paunodzokera kuIjipiti, uone kuti waita zvishamiso zvose pamberi paFaro, ndakupa simba rokuita izvozvo. Asi ndichaomesa mwoyo wake zvokuti haazotenderi vanhu kuenda.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.21",
            "verseOrgIds": [
              "EXO.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo uti kuna Faro, 'Zvanzi naJehovha: Israeri ndiye mwanakomana wangu wedangwe,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.22",
            "verseOrgIds": [
              "EXO.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "uye ndinoti kwauri, \"Rega mwanakomana wangu aende, kuti anondinamata.\" Asi kana ukaramba kumutendera kuti aende, ndichauraya mwanakomana wako wedangwe.' \"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.23",
            "verseOrgIds": [
              "EXO.4.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ari paimba yavaeni pavakavata, Jehovha akasangana naMozisi uye akada kumuuraya.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.24",
            "verseOrgIds": [
              "EXO.4.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asi Zipora akatora banga rebwe romusarasara akacheka chikanda chapamberi chomwanakomana wake uye akabata tsoka dzaMozisi nacho. Akati, \"Zvirokwazvo uri murume weropa kwandiri.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.25",
            "verseOrgIds": [
              "EXO.4.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 4:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saka Jehovha akamurega. Panguva iyoyo Zipora akati kwaari, \"Murume weropa,\" achireva nezvokudzingiswa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.26",
            "verseOrgIds": [
              "EXO.4.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 4:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehovha akati kuna Aroni, \"Enda kurenje undosangana naMozisi.\" Saka akasangana naMozisi pagomo raMwari uye akamutsvoda.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.27",
            "verseOrgIds": [
              "EXO.4.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 4:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipapo Mozisi akaudza Aroni zvinhu zvose zvaakanga atumwa naJehovha kuti azozvitaura, uyewo pamusoro pezvishamiso zvose zvaakanga amurayira kuti aite.",
