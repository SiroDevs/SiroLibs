  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "1TI 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nagaa Gaafachuu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "po"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1TI 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phaawulos isa ajaja fayyisaa keenya Waaqaatii fi abdii keenya Kiristoos Yesuusiin ergamaa Kiristoos Yesuus taʼe irraa,",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "po"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1TI 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gara Xiimotewos isa amantiidhaan ilma koo dhugaa taʼeetti:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "po",
        "vid": "1TI 1:2"
      },
      "items": [
        {
          "text": "Waaqa Abbaa fi Gooftaa keenya Kiristoos Yesuus irraa ayyaanni, araarrii fi nagaan siif haa taʼu.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Barsiistota Sobaatiin Mormuu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1TI 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkuma ani yeroo Maqedooniyaa dhaqetti si gorse sana ati akka namoonni tokko tokko barsiisa addaa hin barsiifne akka ajajjuuf achuma Efesoon turi;",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.3",
            "verseOrgIds": [
              "1TI.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1TI 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "akkasumas akka isaan oduu hundee hin qabnee fi hidda dhalootaa kan dhuma hin qabne sanaan hin fudhatamne isaan ajaji. Wanni kun hojii Waaqaa kan amantiin taʼu guddisuu irra mormii kakaasaatii.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.4",
            "verseOrgIds": [
              "1TI.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1TI 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaayyoon ajaja kanaas jaalala garaa qulqulluu, qalbii gaarii fi amantii itti fakkeessuu hin qabne keessaa baʼuu dha.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.5",
            "verseOrgIds": [
              "1TI.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1TI 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoonni tokko tokko karaa kana irraa badanii gara dubbii faayidaa hin qabneetti gara galaniiru.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.6",
            "verseOrgIds": [
              "1TI.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1TI 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis maal akka jedhan yookaan akka waaʼee maalii cimsanii dubbatan utuu hin hubatin barsiistota seeraa taʼuu barbaadu.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.7",
            "verseOrgIds": [
              "1TI.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1TI 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoo namni sirriitti itti fayyadame seerri gaarii akka taʼe ni beekna.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.8",
            "verseOrgIds": [
              "1TI.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1TI 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Seerri warra seera cabsanii fi finciltootaaf, warra Waaqa malee jiraatanii fi cubbamootaaf, warra qulqulluu hin taʼinii fi xuraaʼotaaf, warra abbaa isaaniitii fi haadha isaanii ajjeesanii fi warra nama ajjeesaniif malee akka qajeeltotaaf hin tumamin ni beekna;",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.9",
            "verseOrgIds": [
              "1TI.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1TI 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "akkanumas seerri ejjitootaa fi dhiirota dhiira wajjin sagaagalaniif, warra garba daldalanii fi warra soba dubbataniif, warra sobaan dhugaa baʼanii fi warra barsiisa dhugaatiin morman hundumaaf akka tumame ni beekna;",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.10",
            "verseOrgIds": [
              "1TI.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1TI 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "kunis wangeela ulfina qabeessa kan Waaqa eebbifamaa irraa imaanaa natti kenname sana wajjin walii gala.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.11",
            "verseOrgIds": [
              "1TI.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ayyaana Gooftaa Kan Phaawulosiif kenname",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1TI 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan inni tajaajila isaatiif na filatee akka nama amanamaatti na lakkaaʼeef, ani Gooftaa keenya Kiristoos Yesuus isa jabina naa kenne sana nan galateeffadha.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.12",
            "verseOrgIds": [
              "1TI.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1TI 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani kanaan dura nama nama arrabsu, kan nama ariʼatuu fi kan nama miidhu taʼu iyyuu sababii ani wallaalummaa fi amantii dhabuun waan kana hojjedheef araara argadhe.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.13",
            "verseOrgIds": [
              "1TI.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1TI 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayyaanni Gooftaa keenyaas amantii fi jaalala Kiristoos Yesuusiin argamu wajjin baayʼinaan narratti dhangalaafame.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.14",
            "verseOrgIds": [
              "1TI.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1TI 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dubbiin, \"Kiristoos Yesuus cubbamoota fayyisuudhaaf gara addunyaa dhufe\" jedhu sun amanamaa dha; namni hundinuus kana fudhachuu qaba; cubbamoota sana keessaas cubbamaan cubbamoota hunda caalu ana.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.15",
            "verseOrgIds": [
              "1TI.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1TI 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taʼus sababuma kanaaf Yesuus Kiristoos akka ani warra jireenya bara baraa argachuuf isatti amananiif fakkeenya taʼuuf ana nama cubbamoota hunda caalaa cubbamaa taʼeen obsa isaa kan dhuma hin qabne sana mulʼisuuf jedhee naa araarame.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.16",
            "verseOrgIds": [
              "1TI.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1TI 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egaa Mootii bara baraa, isa hin duune, isa ijatti hin mulʼanne Waaqa tokkicha sanaaf bara baraa hamma bara baraatti ulfinnii fi galanni haa taʼu. Ameen.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.17",
            "verseOrgIds": [
              "1TI.1.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Qajeelchi Xiimotewosiif Kenname Cimsamuu Isaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1TI 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa ilma koo Xiimotewos, akkuma raajii kanaan dura waaʼee kee dubbatame sanaatti, akka ati lola gaarii loltuuf ani ajaja kana siifin kenna;",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.18",
            "verseOrgIds": [
              "1TI.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1TI 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "waan kanas amantii fi qalbii qajeelaa qabaachuudhaan godhi. Namoonni tokko tokko waan kana gochuu didanii amantii isaanii balleessaniiru.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.19",
            "verseOrgIds": [
              "1TI.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1TI 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Himenewoosii fi Iskindiroos warri ani akka isaan Waaqa arrabsuu dhiisuu barataniif dabarsee Seexanatti kenne sun isaan keessatti argamu.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.20",
            "verseOrgIds": [
              "1TI.1.20"
            ]
          }
        }
      ]
    }
  ],
