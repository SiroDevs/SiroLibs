      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JON 2:3"
      },
      "items": [
        {
          "text": "garaa galaanaatti gad na darbatte;",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.3",
            "verseOrgIds": [
              "JON.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JON 2:3"
      },
      "items": [
