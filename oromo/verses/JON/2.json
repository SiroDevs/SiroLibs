      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JON 2:2"
      },
      "items": [
        {
          "text": "Ani gargaarsa barbaacha garaa siiʼool keessaa nan iyye;",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.2",
            "verseOrgIds": [
              "JON.2.3"
            ]
          }
        }
      ]
    },
