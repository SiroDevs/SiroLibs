          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergamaan",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.32",
            "verseOrgIds": [
              "NUM.22.32"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "NUM.22.32",
                "verseOrgIds": [
                  "NUM.22.32"
                ]
              }
            }
          ]
        },
        {
          "text": "sun akkana jedhee isa gaafate; \"Ati maaliif yeroo sadan kana harree kee rukutte? Kunoo ani waan karaan kee fuula koo duratti jalʼaa taʼeef siin mormuudhaafan dhufe.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.32",
            "verseOrgIds": [
              "NUM.22.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 22:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Harreen kun na argitee yeroo kana sadanuu narraa gorte. Utuu isheen narraa goruu baattee silaa ani yoona si ajjeesee ishee immoo hambisa ture.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.33",
            "verseOrgIds": [
              "NUM.22.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
