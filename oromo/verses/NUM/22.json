          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balaʼaamis harree sanaan, \"Ati na gowwoomsite; ani utuu goraadee of harkaa qabaadhee silaa ammuman si ajjeesa\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.29",
            "verseOrgIds": [
              "NUM.22.29"
            ]
          }
        }
      ]
