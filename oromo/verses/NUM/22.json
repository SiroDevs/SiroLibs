              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "NUM.22.25",
                "verseOrgIds": [
                  "NUM.22.25"
                ]
              }
            }
          ]
        },
        {
          "text": "arginaan, dallaatti maxxantee miilla Balaʼaam dallaatti buufte. Inni ammas harree sana rukute.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.25",
