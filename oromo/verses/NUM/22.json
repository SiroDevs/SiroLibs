    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 22:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Harreen sun amma illee Balaʼaamiin akkana jette; \"Ani harree kee kan ati hamma harʼaatti guyyaa hunda yaabbattu mitii? Ani takkumaa waan akkasii sitti hojjedhee beekaa?\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.30",
            "verseOrgIds": [
              "NUM.22.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "NUM 22:30"
      },
      "items": [
        {
          "text": "Innis, \"Lakkii\" jedhee deebiseef.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.30",
            "verseOrgIds": [
              "NUM.22.30"
            ]
          }
        }
      ]
    },
