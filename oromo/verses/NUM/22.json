          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana irratti",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.28",
            "verseOrgIds": [
              "NUM.22.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "NUM.22.28",
                "verseOrgIds": [
                  "NUM.22.28"
                ]
              }
            }
          ]
        },
        {
          "text": "afaan harree sanaa banee harreen sun Balaʼaamiin, \"Ani maal si yakkinaan ati akkas yeroo sadii na rukutte?\" jette.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.28",
            "verseOrgIds": [
              "NUM.22.28"
            ]
          }
        }
      ]
