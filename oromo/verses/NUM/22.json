                  "NUM.22.26"
                ]
              }
            }
          ]
        },
        {
          "text": "fuula duratti hiiqee daandii dhiphaa iddoo ittiin mirgatti yookaan bitaatti goran hin qabne tokko irra dhaabate.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.26",
            "verseOrgIds": [
