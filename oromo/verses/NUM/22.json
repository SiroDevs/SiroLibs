          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "NUM.22.27",
                "verseOrgIds": [
                  "NUM.22.27"
                ]
              }
            }
          ]
        },
        {
          "text": "arginaan Balaʼaam jalaa gad ciifte; innis aaree ulee ofiitiin harree sana rukute.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.27",
            "verseOrgIds": [
              "NUM.22.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
