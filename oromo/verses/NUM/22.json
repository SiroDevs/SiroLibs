                "verseId": "NUM.22.31",
                "verseOrgIds": [
                  "NUM.22.31"
                ]
              }
            }
          ]
        },
        {
          "text": "ija Balaʼaam bane; Balaʼaamis ergamaa",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.31",
            "verseOrgIds": [
              "NUM.22.31"
            ]
          }
        },
        {
          "name": "char",
