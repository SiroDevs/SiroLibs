              "type": "text",
              "attrs": {
                "verseId": "NUM.22.31",
                "verseOrgIds": [
                  "NUM.22.31"
                ]
              }
            }
          ]
        },
        {
          "text": "kan goraadee luqqifatee karaa irra dhaabatu arge. Kana irratti inni addaan lafatti gombifamee sagade.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.31",
            "verseOrgIds": [
              "NUM.22.31"
            ]
          }
        }
      ]
