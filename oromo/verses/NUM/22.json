                "verseOrgIds": [
                  "NUM.22.24"
                ]
              }
            }
          ]
        },
        {
          "text": "sun garuu daandii dhiphoo, iddoo dhaabaa wayinii lama kanneen gama lamaan dallaa qaban gidduu baatu irra dhaabate.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.24",
            "verseOrgIds": [
