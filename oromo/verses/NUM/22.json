              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Harreen sun ergamaa",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.25",
            "verseOrgIds": [
              "NUM.22.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
