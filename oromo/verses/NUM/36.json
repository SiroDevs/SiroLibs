    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 36:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abbootiin maatii ilmaan Giliʼaad ilma Maakiir, ilma Minaasee kanneen maatiiwwan ilmaan Yoosef keessaa dhufan sun fuula Museetii fi fuula hooggantoota abbootii maatiiwwan saba Israaʼel duratti dhiʼaatanii dubbatan;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.1",
            "verseOrgIds": [
              "NUM.36.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 36:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "akkanas jedhan; \"Akka ati biyyattii dhaala gootee ixaadhaan saba Israaʼeliif kennituuf",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.2",
            "verseOrgIds": [
              "NUM.36.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "NUM.36.2",
                "verseOrgIds": [
                  "NUM.36.2"
                ]
              }
            }
          ]
        },
        {
          "text": "Gooftaa koo ajajeera; akkasumas akka ati dhaala obboleessi keenya Zelofehaad intallan isaatiif kennitu inni si ajajeera.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.2",
            "verseOrgIds": [
              "NUM.36.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 36:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu yoo isaan ilmaan gosoota saba Israaʼel kaanitti heeruman dhaalli isaanii dhaala abbootii keenyaa keessaa fuudhamee dhaala gosa isaan itti heerumaniitti dabalama. Yoos dhaala ixaadhaan nuu qoodame irraa gariin isaa ni fuudhama.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.3",
            "verseOrgIds": [
              "NUM.36.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 36:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yommuu Waggaan Iyyoobeeliyyuu kan saba Israaʼel dhufutti dhaalli isaanii sun dhaala gosa isaan itti heerumaniitti dabalama; dhaalli isaaniis dhaala gosa abbootii keenyaa irraa fudhatama.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.4",
            "verseOrgIds": [
              "NUM.36.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 36:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana irratti Museen akkuma",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.5",
            "verseOrgIds": [
              "NUM.36.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "NUM.36.5",
                "verseOrgIds": [
                  "NUM.36.5"
                ]
              }
            }
          ]
        },
        {
          "text": "dubbate sana akkana jedhee saba Israaʼel ajaje: \"Wanni gosti ilmaan Yoosef jedhu sirrii dha.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.5",
            "verseOrgIds": [
              "NUM.36.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 36:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wanni",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.6",
            "verseOrgIds": [
              "NUM.36.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "NUM.36.6",
                "verseOrgIds": [
                  "NUM.36.6"
                ]
              }
            }
          ]
        },
        {
          "text": "waaʼee intallan Zelofehaad ajaje kanaa dha: Isaan gosa abbaa isaanii qofa keessaa haa taʼu malee nama jaallatanitti haa heeruman.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.6",
            "verseOrgIds": [
              "NUM.36.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 36:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sababii tokkoon tokkoon ilmaan Israaʼel dhaala gosa abbaa isaa irraa argatu jabeessee qabatuuf, dhaalli ilmaan Israaʼel gosa tokko irraa gosa kaanitti hin darbin.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.7",
            "verseOrgIds": [
              "NUM.36.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 36:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka tokkoon tokkoon ilmaan Israaʼel dhaala abbootii isaa argatuuf, gosa ilmaan Israaʼel keessaa intalli dhaala argattu kam iyyuu gosa abbaa ishee keessaa nama tokkotti heerumuu qabdi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.8",
            "verseOrgIds": [
              "NUM.36.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 36:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sababii tokkoon tokkoon gosa ilmaan Israaʼel dhaala ofii isaa jabeessee qabatuuf, dhaalli tokko iyyuu gosa tokko irraa gosa kaanitti hin darbin.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.9",
            "verseOrgIds": [
              "NUM.36.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 36:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Intallan Zelofehaad akkuma",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.10",
            "verseOrgIds": [
              "NUM.36.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "NUM.36.10",
                "verseOrgIds": [
                  "NUM.36.10"
                ]
              }
            }
          ]
        },
        {
          "text": "Musee ajaje sana godhan.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.10",
            "verseOrgIds": [
              "NUM.36.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 36:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Intallan Zelofehaad Mahilaan, Tiirzaan, Hoglaan, Miilkaa fi Nohi ilmaan obboloota abbaa isaaniitti heeruman.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.11",
            "verseOrgIds": [
              "NUM.36.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 36:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis maatiiwwan ilmaan Minaasee ilma Yoosef keessatti waan heerumaniif dhaalli isaanii gosa maatii abbaa isaanii harkatti hafe.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.12",
            "verseOrgIds": [
              "NUM.36.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 36:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ajajawwanii fi murtiiwwan",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.13",
            "verseOrgIds": [
              "NUM.36.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "NUM.36.13",
                "verseOrgIds": [
                  "NUM.36.13"
                ]
              }
            }
          ]
        },
        {
          "text": "dirreewwan Moʼaab irratti, Yordaanos biratti, Yerikoo gamatti karaa Museetiin ilmaan Israaʼeliif kenne kanneenii dha.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.13",
            "verseOrgIds": [
              "NUM.36.13"
            ]
          }
        }
      ]
    }
  ],
