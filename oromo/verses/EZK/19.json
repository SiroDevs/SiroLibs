    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Faaruu Booʼichaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Waaʼee ilmaan mootota Israaʼeliif faarsii booʼi;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.1",
            "verseOrgIds": [
              "EZK.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "akkanas jedhi:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.2",
            "verseOrgIds": [
              "EZK.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 19:2"
      },
      "items": [
        {
          "text": "\" 'Haati kee leencota gidduutti,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.2",
            "verseOrgIds": [
              "EZK.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 19:2"
      },
      "items": [
        {
          "text": "leenca akkamii turte!",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.2",
            "verseOrgIds": [
              "EZK.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 19:2"
      },
      "items": [
        {
          "text": "Isheen leencota gidduu ciiftee",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.2",
            "verseOrgIds": [
              "EZK.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 19:2"
      },
      "items": [
        {
          "text": "ilmoolee ishee guddifatte.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.2",
            "verseOrgIds": [
              "EZK.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilmoolee ishee keessaas tokko guddifatte;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.3",
            "verseOrgIds": [
              "EZK.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 19:3"
      },
      "items": [
        {
          "text": "innis leenca jabaa taʼe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.3",
            "verseOrgIds": [
              "EZK.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 19:3"
      },
      "items": [
        {
          "text": "Inni waa adamsee ciccirachuu barate;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.3",
            "verseOrgIds": [
              "EZK.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 19:3"
      },
      "items": [
        {
          "text": "namootas nyaate.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.3",
            "verseOrgIds": [
              "EZK.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saboonni waaʼee isaa dhagaʼan;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.4",
            "verseOrgIds": [
              "EZK.19.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 19:4"
      },
      "items": [
        {
          "text": "inni boolla isaanii keessatti qabame.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.4",
            "verseOrgIds": [
              "EZK.19.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 19:4"
      },
      "items": [
        {
          "text": "Isaan hokkoodhaan harkisanii",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.4",
            "verseOrgIds": [
              "EZK.19.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 19:4"
      },
      "items": [
        {
          "text": "gara biyya Gibxitti isa geessan.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.4",
            "verseOrgIds": [
              "EZK.19.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Isheen yommuu akka abdiin ishee hin guutamin,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.5",
            "verseOrgIds": [
              "EZK.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 19:5"
      },
      "items": [
        {
          "text": "akka wanni isheen yaaddes hin milkaaʼin argitetti,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.5",
            "verseOrgIds": [
              "EZK.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 19:5"
      },
      "items": [
        {
          "text": "ilmoolee ishee keessaa kan biraa fudhattee",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.5",
            "verseOrgIds": [
              "EZK.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 19:5"
      },
      "items": [
        {
          "text": "leenca jabaa gootee guddifte.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.5",
            "verseOrgIds": [
              "EZK.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni leencota gidduu biddiiqe;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.6",
            "verseOrgIds": [
              "EZK.19.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 19:6"
      },
      "items": [
        {
          "text": "leenca jabaa taʼeeraatii.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.6",
            "verseOrgIds": [
              "EZK.19.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 19:6"
      },
      "items": [
        {
          "text": "Inni waa adamsee ciccirachuu barate;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.6",
            "verseOrgIds": [
              "EZK.19.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 19:6"
      },
      "items": [
        {
          "text": "namootas nyaate.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.6",
            "verseOrgIds": [
              "EZK.19.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni daʼannoo isaanii diige;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.7",
            "verseOrgIds": [
              "EZK.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 19:7"
      },
      "items": [
        {
          "text": "magaalaawwan isaaniis onse.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.7",
            "verseOrgIds": [
              "EZK.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 19:7"
      },
      "items": [
        {
          "text": "Biyyattii fi kanneen ishee keessa jiraatan hundi",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.7",
            "verseOrgIds": [
              "EZK.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 19:7"
      },
      "items": [
        {
          "text": "aaduu isaatiin raafaman.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.7",
            "verseOrgIds": [
              "EZK.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasii saboonni warri kutaalee biyya naannoo",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.8",
            "verseOrgIds": [
              "EZK.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 19:8"
      },
      "items": [
        {
          "text": "sanaa jiran isatti kaʼan.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.8",
            "verseOrgIds": [
              "EZK.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 19:8"
      },
      "items": [
        {
          "text": "Isaanis kiyyoo isaanii isa duratti diriirsan;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.8",
            "verseOrgIds": [
              "EZK.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 19:8"
      },
      "items": [
        {
          "text": "innis boolla isaanii keessatti qabame.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.8",
            "verseOrgIds": [
              "EZK.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan hokkoodhaan qabanii mana shiboo keessa isa kaaʼan;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.9",
            "verseOrgIds": [
              "EZK.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 19:9"
      },
      "items": [
        {
          "text": "gara mootii Baabilonitti isa fidan.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.9",
            "verseOrgIds": [
              "EZK.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 19:9"
      },
      "items": [
        {
          "text": "Mana hidhaatti isa galchan;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.9",
            "verseOrgIds": [
              "EZK.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 19:9"
      },
      "items": [
        {
          "text": "kanaafuu aaduun isaa",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.9",
            "verseOrgIds": [
              "EZK.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 19:9"
      },
      "items": [
        {
          "text": "tulluuwwan Israaʼel irratti ergasii hin dhagaʼamne.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.9",
            "verseOrgIds": [
              "EZK.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Haati kee akkuma wayinii",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.10",
            "verseOrgIds": [
              "EZK.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 19:10"
      },
      "items": [
        {
          "text": "lafa qotiisaa kee keessa bishaan bira dhaabatee ti;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.10",
            "verseOrgIds": [
              "EZK.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 19:10"
      },
      "items": [
        {
          "text": "biqiltuun sunis sababii bishaan baayʼee argatteef",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.10",
            "verseOrgIds": [
              "EZK.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 19:10"
      },
      "items": [
        {
          "text": "mistee damee hedduu baaffatte.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.10",
            "verseOrgIds": [
              "EZK.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dameewwan isaas jajjaboo",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.11",
            "verseOrgIds": [
              "EZK.19.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 19:11"
      },
      "items": [
        {
          "text": "bokkuu bulchaatiif taʼan turan.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.19.11",
            "verseOrgIds": [
              "EZK.19.11"
