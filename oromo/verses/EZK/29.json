  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "29",
        "style": "c",
        "sid": "EZK 29"
      },
      "items": [
        {
          "text": "29",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Raajii Gibxiin Mormuudhaan Dubbatame",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 29:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waggaa kurnaffaatti, jiʼa kurnaffaa keessa, guyyaa kudha lammaffaatti dubbiin",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.1",
            "verseOrgIds": [
              "EZK.29.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "EZK.29.1",
                "verseOrgIds": [
                  "EZK.29.1"
                ]
              }
            }
          ]
        },
        {
          "text": "akkana jedhee gara koo dhufe:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.1",
            "verseOrgIds": [
              "EZK.29.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Yaa ilma namaa, fuula kee gara Faraʼoon mooticha Gibxitti garagalfadhuutii isaa fi warra Gibxi hundaan mormuudhaan raajii dubbadhu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.2",
            "verseOrgIds": [
              "EZK.29.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isatti dubbadhuutii akkana jedhiin: '",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.3",
            "verseOrgIds": [
              "EZK.29.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "EZK.29.3",
                "verseOrgIds": [
                  "EZK.29.3"
                ]
              }
            }
          ]
        },
        {
          "text": "Gooftaan akkana jedha:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.3",
            "verseOrgIds": [
              "EZK.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 29:3"
      },
      "items": [
        {
          "text": "\" 'Ati bineensi guddichi, kan lageen kee gidduu ciiftu,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.3",
            "verseOrgIds": [
              "EZK.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 29:3"
      },
      "items": [
        {
          "text": "yaa Faraʼoon mooticha Gibxi, ani sitti nan kaʼa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.3",
            "verseOrgIds": [
              "EZK.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 29:3"
      },
      "items": [
        {
          "text": "Ati, \"Lagni Abbayyaa kan koo ti;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.3",
            "verseOrgIds": [
              "EZK.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 29:3"
      },
      "items": [
        {
          "text": "anatu ofuma kootiif isa uummate\" jetta.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.3",
            "verseOrgIds": [
              "EZK.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 29:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani garuu haʼoo kee keessa hokkoo kaaʼee",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.4",
            "verseOrgIds": [
              "EZK.29.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 29:4"
      },
      "items": [
        {
          "text": "akka qurxummiiwwan lageen keetii qola keetti maxxanan nan godha.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.4",
            "verseOrgIds": [
              "EZK.29.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 29:4"
      },
      "items": [
        {
          "text": "Ani qurxummiiwwan qola keetti maxxanan hunda wajjinis",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.4",
            "verseOrgIds": [
              "EZK.29.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 29:4"
      },
      "items": [
        {
          "text": "lageen kee keessaa harkiseen si baasa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.4",
            "verseOrgIds": [
              "EZK.29.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siʼii fi qurxummiiwwan lageen keetii hunda",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.5",
            "verseOrgIds": [
              "EZK.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 29:5"
      },
      "items": [
        {
          "text": "gammoojjiitti nan gata.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.5",
            "verseOrgIds": [
              "EZK.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 29:5"
      },
      "items": [
        {
          "text": "Ati dirree duwwaa irratti ni kufta;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.5",
            "verseOrgIds": [
              "EZK.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 29:5"
      },
      "items": [
        {
          "text": "walitti hin qabamtu; hin awwaalamtus.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.5",
            "verseOrgIds": [
              "EZK.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 29:5"
      },
      "items": [
        {
          "text": "Ani bineensota lafaatii fi allaattii samiitiif",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.5",
            "verseOrgIds": [
              "EZK.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 29:5"
      },
      "items": [
        {
          "text": "nyaata godheen si kenna.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.5",
            "verseOrgIds": [
              "EZK.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 29:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Warri Gibxi keessa jiraatan hundis akka ani",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.6",
            "verseOrgIds": [
              "EZK.29.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "EZK.29.6",
                "verseOrgIds": [
                  "EZK.29.6"
                ]
              }
            }
          ]
        },
        {
          "text": "taʼe ni beeku.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.6",
            "verseOrgIds": [
              "EZK.29.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "EZK 29:6"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EZK 29:6"
      },
      "items": [
        {
          "text": "\" 'Ati mana Israaʼeliif ulee shambaqqoo taateerta.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.6",
            "verseOrgIds": [
              "EZK.29.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 29:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yommuu isaan harkaan si qabatanitti baqaqxee gatiittii isaanii waraante; yommuu isaan sitti irkatanittis ati caccabdee akka dugdi isaanii hollatu goote.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.7",
            "verseOrgIds": [
              "EZK.29.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 29:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Kanaafuu",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.8",
            "verseOrgIds": [
              "EZK.29.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "EZK.29.8",
                "verseOrgIds": [
                  "EZK.29.8"
                ]
              }
            }
          ]
        },
        {
          "text": "Gooftaan akkana jedha: Ani goraadee sitti fidee namoota keetii fi horii isaanii nan fixa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.8",
            "verseOrgIds": [
              "EZK.29.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gibxi duwwaa fi ona taati; isaanis akka ani",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.9",
            "verseOrgIds": [
              "EZK.29.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "EZK.29.9",
                "verseOrgIds": [
                  "EZK.29.9"
                ]
              }
            }
          ]
        },
        {
          "text": "taʼe ni beeku.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.9",
            "verseOrgIds": [
              "EZK.29.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EZK 29:9"
      },
      "items": [
        {
          "text": "\" 'Ati, \"Lagni Abbayyaa kan koo ti; anatu isa uume\" jetteertaatii;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.9",
            "verseOrgIds": [
              "EZK.29.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 29:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "kanaafuu ani sitti kaʼeera; lageen keettis kaʼeera; biyya Gibxis Migdoolii jalqabee hamma Aswaanitti, hamma daarii Itoophiyaatti diigamtuu fi ontuu nan godha.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.10",
            "verseOrgIds": [
              "EZK.29.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miilli namaa yookaan kotteen horii karaa sana hin darbu; namni tokko iyyuu hamma waggaa afurtamaatti ishee keessa hin jiraatu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.11",
            "verseOrgIds": [
              "EZK.29.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 29:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani biyyoota onan gidduutti biyya Gibxi nan onsa; magaalaawwan ishees magaalaawwan diigaman gidduutti waggaa afurtama ni onu. Namoota Gibxi immoo saboota keessa nan faffacaasa; biyyoota keessas isaan nan bittinneessa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.12",
            "verseOrgIds": [
              "EZK.29.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 29:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ammas",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.13",
            "verseOrgIds": [
              "EZK.29.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "EZK.29.13",
                "verseOrgIds": [
                  "EZK.29.13"
                ]
              }
            }
          ]
        },
        {
          "text": "Gooftaan akkana jedha: Dhuma waggaa afurtamaatti ani namoota Gibxi saboota isaan itti bittinneeffaman keessaa walitti nan qaba.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.13",
            "verseOrgIds": [
              "EZK.29.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 29:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani boojuudhaa isaan deebisee Phaxroos biyya abbootii isaaniitti isaan nan galcha. Achittis isaan mootummaa gad aanaa ni taʼu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.14",
            "verseOrgIds": [
              "EZK.29.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 29:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isheenis mootummoota keessaa gad aantuu ni taati; deebitees saboota kaaniin olitti gonkumaa ol of hin kaaftu. Anis akka isheen lammata saboota kaan hin bulchineef ishee nan dadhabsiisa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.15",
            "verseOrgIds": [
              "EZK.29.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 29:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biyyi Gibxi siʼachi uummata Israaʼeliif irkoo hin taatu; yoo isaan gargaarsaaf gara isheetti deebiʼan garuu isheen yaadannoo cubbuu isaanii taati. Ergasii isaan akka ani",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.16",
            "verseOrgIds": [
              "EZK.29.16"
            ]
