                "verseOrgIds": [
                  "EZK.29.19"
                ]
              }
            }
          ]
        },
        {
          "text": "Gooftaan akkana jedha: Ani biyya Gibxi Nebukadnezar mootii Baabiloniif nan kenna; innis ishee boojiʼee qabeenya ishee saama. Kunis mindaa loltoota isaa taʼa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.19",
            "verseOrgIds": [
              "EZK.29.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 29:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani Gibxiin gatii dadhabbii isaa godhee isaaf kenneera; innii fi loltoonni isaa waan kana anaaf hojjetaniiruutii, jedha",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.20",
            "verseOrgIds": [
              "EZK.29.20"
            ]
          }
        },
        {
          "name": "char",
