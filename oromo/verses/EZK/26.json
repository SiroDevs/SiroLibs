  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "26",
        "style": "c",
        "sid": "EZK 26"
      },
      "items": [
        {
          "text": "26",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Raajii Xiiroosiin Mormuudhaan Dubbatame",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 26:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waggaa kudha tokkoffaatti, jiʼa sana keessaa guyyaa jalqabaatti dubbiin",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.1",
            "verseOrgIds": [
              "EZK.26.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "EZK.26.1",
                "verseOrgIds": [
                  "EZK.26.1"
                ]
              }
            }
          ]
        },
        {
          "text": "akkana jedhee gara koo dhufe:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.1",
            "verseOrgIds": [
              "EZK.26.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Yaa ilma namaa, Xiiroos waaʼee Yerusaalem, 'Baga! Karri sabootaa cabeera; balbalawwan ishees naaf banamaniiru; egaa amma waan isheen onteef ani nan sooroma' jetteertii;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.2",
            "verseOrgIds": [
              "EZK.26.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kanaafuu",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.3",
            "verseOrgIds": [
              "EZK.26.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "EZK.26.3",
                "verseOrgIds": [
                  "EZK.26.3"
                ]
              }
            }
          ]
        },
        {
          "text": "Gooftaan akkana jedha: Yaa Xiiroos, kunoo ani sitti kaʼeera; akkuma galaanni dambalii isaa kaasu sana anis saboota baayʼee sitti nan kaasa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.3",
            "verseOrgIds": [
              "EZK.26.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan dallaa Xiiroos ni diigu; gamoo ishees ni jigsu; ani biyyoo ishee irraa haxaaʼee kattaa qullaa hafe ishee nan godha.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.4",
            "verseOrgIds": [
              "EZK.26.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isheen galaana keessatti iddoo itti kiyyoo qurxummii diriirsan ni taati; ani dubbadheeraatii, jedha",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.5",
            "verseOrgIds": [
              "EZK.26.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "EZK.26.5",
                "verseOrgIds": [
                  "EZK.26.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Gooftaan. Isheen sabootaaf boojuu taati;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.5",
            "verseOrgIds": [
              "EZK.26.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "intallan ishee kanneen walakkaa biyyaa jiranis goraadeedhaan ajjeefamu. Ergasii isaan akka ani",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.6",
            "verseOrgIds": [
              "EZK.26.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "EZK.26.6",
                "verseOrgIds": [
                  "EZK.26.6"
                ]
              }
            }
          ]
        },
        {
          "text": "taʼe ni beeku.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.6",
            "verseOrgIds": [
              "EZK.26.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.7",
            "verseOrgIds": [
              "EZK.26.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "EZK.26.7",
                "verseOrgIds": [
                  "EZK.26.7"
                ]
              }
            }
          ]
        },
        {
          "text": "Gooftaan akkana jedhaatii: Ani karaa kaabaatii Nebukadnezar mooticha Baabilon, mootii moototaa sana fardeenii fi gaariiwwan wajjin, abbootii fardaatii fi raayyaa waraanaa guddaa isaa wajjin Xiiroositti nan fida.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.7",
            "verseOrgIds": [
              "EZK.26.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis intallan kee kanneen biyya walakkaa jiran goraadeedhaan fixa; dallaa ittiin si marsu ijaarrata; hamma dallaa keetiitti biyyoo ol tuula; gaachana isaas sitti ol kaafata.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.8",
            "verseOrgIds": [
              "EZK.26.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis jirma ittiin waa diigan dallaa keetti garagalfata; gamoowwan kees miʼa lolaatiin diiga.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.9",
            "verseOrgIds": [
              "EZK.26.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fardeen isaas hamma awwaaraan si haguuguu dandaʼanitti gar malee baayʼee taʼu. Yeroo inni akkuma namoota magaalaa dallaan ishee diigame seenaniitti karrawwan keetiin ol seenutti dallaan kee didichuu fardeen waraanaatiin, kan gaariiwwan waraanaatii fi kan gaariiwwan kaaniitiin ni raafama.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.10",
            "verseOrgIds": [
              "EZK.26.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotteewwan fardeen isaa daandiiwwan kee hunda ni dhidhiitu; innis namoota kee goraadeedhaan ajjeesa; utubaawwan kee jajjaboonis ni jigu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.11",
            "verseOrgIds": [
              "EZK.26.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan qabeenya kee boojiʼu; miʼa kee kan daldalaa ni saamu; dallaa kee ni jigsu; manneen kee mimmiidhagoo ni diigu; dhagaa kee, jirmaa fi biyyoo kee galaanatti naqu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.12",
            "verseOrgIds": [
              "EZK.26.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani sirba kee nan hambisa; sagaleen baganaa keetii siʼachi hin dhagaʼamu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.13",
            "verseOrgIds": [
              "EZK.26.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani kattaa qullaa hafe si taasisa; atis iddoo itti kiyyoo qurxummii diriirsan taata. Ati gonkumaa deebifamtee hin ijaaramtu; ani",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.14",
            "verseOrgIds": [
              "EZK.26.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "EZK.26.14",
                "verseOrgIds": [
                  "EZK.26.14"
                ]
              }
            }
          ]
        },
        {
          "text": "dubbadheeraatii, jedha",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.14",
            "verseOrgIds": [
              "EZK.26.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "EZK.26.14",
                "verseOrgIds": [
                  "EZK.26.14"
                ]
              }
            }
          ]
        },
        {
          "text": "Gooftaan.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.14",
            "verseOrgIds": [
              "EZK.26.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.15",
            "verseOrgIds": [
              "EZK.26.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "EZK.26.15",
                "verseOrgIds": [
                  "EZK.26.15"
                ]
              }
            }
          ]
        },
        {
          "text": "Gooftaan Xiiroosiin akkana jedha: Yeroo warri madaaʼan aadanii fi yeroo namni si keessatti qalamutti biyyoonni qarqara galaanaa sagalee jiguu keetiitiin hin hollatanii?",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.15",
            "verseOrgIds": [
              "EZK.26.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 26:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilmaan moototaa kanneen qarqara galaanaa jiraatan hundi teessoo isaanii irraa ni buʼu; uffata isaanii lafa kaaʼu; wayyaa isaanii kan faayeffames of irraa baasu. Isaan sodaadhaan guutamanii daaraa irra taaʼanii utuu addaan hin kutin waan sirra gaʼe sanaan naasuudhaan hollatu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.16",
            "verseOrgIds": [
              "EZK.26.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 26:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis waaʼee keetiif akkana jedhanii faarsanii siif booʼu:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.17",
            "verseOrgIds": [
              "EZK.26.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 26:17"
      },
      "items": [
        {
          "text": "\" 'Yaa magaalaa beekamtuu,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.17",
            "verseOrgIds": [
              "EZK.26.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 26:17"
      },
      "items": [
        {
          "text": "kan namoota galaanaatiin guutamte ati akkamitti barbadoofte!",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.17",
            "verseOrgIds": [
              "EZK.26.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 26:17"
      },
      "items": [
        {
          "text": "Ati lammiiwwan kee wajjin",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.17",
            "verseOrgIds": [
              "EZK.26.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 26:17"
      },
      "items": [
        {
          "text": "galaana irratti irree jabeettii turte;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.17",
            "verseOrgIds": [
              "EZK.26.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 26:17"
      },
      "items": [
        {
          "text": "warra achi jiraatan hundas",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.17",
            "verseOrgIds": [
              "EZK.26.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 26:17"
      },
      "items": [
        {
          "text": "sodaa keetiin guutte.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.17",
            "verseOrgIds": [
              "EZK.26.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 26:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaafa ati jigdutti,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.18",
            "verseOrgIds": [
              "EZK.26.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 26:18"
      },
      "items": [
        {
          "text": "biyyoonni qarqara galaanaa ni hollatu;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.18",
            "verseOrgIds": [
              "EZK.26.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 26:18"
      },
      "items": [
        {
          "text": "jigaatii keetiinis biyyoonni bishaan gidduu",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.18",
            "verseOrgIds": [
              "EZK.26.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 26:18"
