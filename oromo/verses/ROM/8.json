        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Hafuura Jireenyaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ROM 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egaa amma murtiin warra Kiristoos Yesuus keessa jiraatanitti muramu hin jiru;",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.1",
            "verseOrgIds": [
              "ROM.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ROM 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "seerri Hafuura jireenyaa karaa Kiristoos Yesuusiin seera cubbuutii fi seera duʼaa jalaa na bilisoomseeraatii.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.2",
            "verseOrgIds": [
              "ROM.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ROM 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan seerri sababii fooniitiin dadhabsiifameef hojjechuu hin dandaʼin, Waaqni Ilma ofii isaa bifa foon cubbamaatiin aarsaa cubbuu akka taʼuuf erguun hojjeteeraatii. Kanaanis inni fooniin cubbuutti mure.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.3",
            "verseOrgIds": [
              "ROM.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunis akka qajeelummaan seeraa sun nu warra utuu akka namummaa cubbamaatti hin taʼin akka Hafuuraatti jiraannu keessatti raawwatamuufii dha.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.4",
            "verseOrgIds": [
              "ROM.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Warri akka fooniitti jiraatan waan foonii yaadu; warri akka Hafuuraatti jiraatan garuu waan Hafuuraa yaadu.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.5",
            "verseOrgIds": [
              "ROM.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaadni foonii duʼa; yaadni Hafuuraa garuu jireenyaa fi nagaa dha.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.6",
            "verseOrgIds": [
              "ROM.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaadni foonii diina Waaqaa ti; seera Waaqaatiifis hin bulu. Buluus hin dandaʼu.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.7",
            "verseOrgIds": [
              "ROM.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ROM 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Warri akka fooniitti jiraatan Waaqa gammachiisuu hin dandaʼan.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.8",
            "verseOrgIds": [
              "ROM.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ROM 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isin garuu yoo Hafuurri Waaqaa isin keessa jiraate akka Hafuuraatti jiraattu malee akka fooniitti hin jiraattan. Eenyu iyyuu yoo Hafuura Kiristoos qabaachuu baate inni kan Kiristoos miti.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.9",
            "verseOrgIds": [
              "ROM.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoo Kiristoos isin keessa jiraate garuu dhagni keessan sababii cubbuutiin duʼaa dha; hafuurri keessan immoo sababii qajeelummaatiin jiraataa dha.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.10",
            "verseOrgIds": [
              "ROM.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ROM 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hafuurri Waaqaa inni Yesuusin warra duʼan keessaa kaase sun yoo isin keessa jiraate garuu, inni Kiristoos Yesuusin warra duʼan keessaa kaase sun karaa Hafuura isaa kan isin keessa jiruutiin dhagna keessan isa duʼuufis jireenya kenna.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.11",
            "verseOrgIds": [
              "ROM.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egaa yaa obboloota, nu gatii of irraa qabna; garuu fooniif miti; akka fooniitti jiraachuufis miti.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.12",
            "verseOrgIds": [
              "ROM.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isin yoo akka fooniitti jiraattan ni duutuutii; yoo Hafuuraan hojii foon keessanii ajjeeftan garuu ni jiraattu.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.13",
            "verseOrgIds": [
              "ROM.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Warri Hafuura Waaqaatiin qajeelfaman hundinuu ilmaan Waaqaatii.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.14",
            "verseOrgIds": [
              "ROM.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isin Hafuura ilmummaa isa nu ittiin, \"",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.15",
            "verseOrgIds": [
              "ROM.8.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "tl"
          },
          "items": [
            {
              "text": "Aabbaa,",
              "type": "text",
              "attrs": {
                "verseId": "ROM.8.15",
                "verseOrgIds": [
                  "ROM.8.15"
                ]
              }
            }
          ]
        },
        {
          "text": "yaa Abbaa\" jennee waammannu sana argattan malee Hafuura garbummaa kan gara sodaatti isin deebisu hin arganne.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.15",
            "verseOrgIds": [
              "ROM.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ROM 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka nu ijoollee Waaqaa taane kan hafuura keenya wajjin dhugaa baʼus Hafuuruma sana.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.16",
            "verseOrgIds": [
              "ROM.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoo ijoollee taane immoo nu dhaaltota; akka hirmaattota ulfina isaa taanuufis yoo hirmaattota dhiphina isaa taane, nu dhaaltota Waaqaa ti; Kiristoos wajjinis ni dhaalla.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.17",
            "verseOrgIds": [
              "ROM.8.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ulfina Fuul duraa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ROM 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhiphinni keenya kan ammaa kun ulfina nutti mulʼachuuf jiruun yommuu wal bira qabamu akka waan tokkottuu hin lakkaaʼamne ani nan yaada.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.18",
            "verseOrgIds": [
              "ROM.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ROM 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uumamni mulʼachuu ijoollee Waaqaa hawwiidhaan eeggachaa jira.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.19",
            "verseOrgIds": [
              "ROM.8.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ROM 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uumamni utuu filannoo isaatiin hin taʼin, fedhii isa dabarsee isa kenne sanaatiin abdiidhaan waan faayidaa hin qabnetti saaxilameeraatii;",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.20",
            "verseOrgIds": [
              "ROM.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ROM 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "kunis akka uumamni mataan isaa garbummaa tortoruu jalaa baʼee bilisummaa ulfina qabeessa ijoollee Waaqaatti galuuf.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.21",
            "verseOrgIds": [
              "ROM.8.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ROM 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uumamni hundinuu hamma ammaatti akkuma dhiphina yeroo ciniinsuutti akka aadaa jiru ni beekna.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.22",
            "verseOrgIds": [
              "ROM.8.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ROM 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uumama qofa utuu hin taʼin nu mataan keenya warri ija Hafuuraa kan jalqabaa qabnu iyyuu furii dhagna keenyaa ilmummaatti guddifamuu eeggachaa of keessatti ni aadna.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.23",
            "verseOrgIds": [
              "ROM.8.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ROM 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nu abdii kanaan fayyineetii. Abdiin argamu garuu abdii miti; namni waan amma iyyuu qabu abdatu eenyu ree?",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.24",
            "verseOrgIds": [
              "ROM.8.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ROM 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nu yoo waan amma hin qabne abdanne garuu obsaan eegganna.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.25",
            "verseOrgIds": [
              "ROM.8.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ROM 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkasumas Hafuurri dadhabbii keenya irratti nu gargaara. Nu waan kadhachuu qabnu hin beeknuutii; hafuurri mataan isaa garuu aaduu ibsamuu hin dandaʼamneen nuuf kadhata.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.26",
            "verseOrgIds": [
              "ROM.8.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ROM 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni garaa keenya qoru sun yaada Hafuuraas ni beeka; Hafuurri akka fedhii Waaqaatti qulqullootaaf kadhataatii.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.27",
            "verseOrgIds": [
              "ROM.8.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Moʼattoota Caaluu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ROM 8:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqni warra isa jaallatanii akka kaayyoo isaatti waamamaniif akka wanti hundinuu gaarii taʼuuf hojjetu ni beekna.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.28",
            "verseOrgIds": [
              "ROM.8.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ROM 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka inni obboloota baayʼee keessatti hangafa taʼuuf Waaqni warra duraan dursee beeke akka bifa ilma isaa fakkaataniif duraan dursee murteesseeraatii.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.29",
            "verseOrgIds": [
              "ROM.8.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ROM 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni warra duraan dursee murteesse sana ni waame; warra waame sanas qajeeltota taasise; warra qajeeltota taasiseef immoo ulfina kenne.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.30",
            "verseOrgIds": [
              "ROM.8.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ROM 8:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egaa kana irratti maal jenna ree? Erga Waaqni nu wajjin taʼee eenyutu nuun mormuu dandaʼa?",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.31",
            "verseOrgIds": [
              "ROM.8.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ROM 8:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqni Ilma isaa illee utuu hin mararfatin hunduma keenyaaf dabarsee kenne sun akkamitti waan biraa hundumas isa wajjin akkasuma arjummaan nuuf hin kennu ree?",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.32",
            "verseOrgIds": [
              "ROM.8.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ROM 8:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Warra Waaqni filate eenyutu himata? Kan qajeelaa nama taasisu Waaqa.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.33",
            "verseOrgIds": [
              "ROM.8.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ROM 8:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kan itti muru eenyu? Kiristoos Yesuus isuma nuuf duʼee, kana caalaa immoo warra duʼan keessaa kaʼee mirga Waaqaa jiruu fi nuuf kadhatu sanaa dha.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.34",
            "verseOrgIds": [
              "ROM.8.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ROM 8:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jaalala Kiristoos irraa eenyutu gargar nu baasa? Dhiphina moo rakkina, ariʼatama moo beela, daaruu moo balaa yookaan goraadee?",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.35",
            "verseOrgIds": [
              "ROM.8.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "ROM 8:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunis akkuma,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.36",
            "verseOrgIds": [
              "ROM.8.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ROM 8:36"
      },
      "items": [
        {
          "text": "\"Nu siif jennee guyyaa guutuu ni ajjeefamna;",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.36",
            "verseOrgIds": [
              "ROM.8.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ROM 8:36"
      },
      "items": [
        {
          "text": "akka hoolota qalamuuf jiraniittis lakkaaʼamneerra\"",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.36",
            "verseOrgIds": [
              "ROM.8.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m",
        "vid": "ROM 8:36"
      },
      "items": [
        {
          "text": "jedhamee barreeffamee dha.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.36",
            "verseOrgIds": [
              "ROM.8.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ROM 8:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana hunda keessatti garuu nu isa nu jaallate sanaan moʼattoota ni caalla.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.37",
            "verseOrgIds": [
              "ROM.8.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "ROM 8:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuti yookaan jireenyi, ergamoonni yookaan bulchitoonni, hangafoonni, wanni ammaa yookaan wanni dhufuuf jiru yookaan humni tokko iyyuu,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.38",
            "verseOrgIds": [
              "ROM.8.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "ROM 8:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "ol dheerinni yookaan gad fageenyi yookaan uumamni biraa kam iyyuu jaalala Waaqaa kan Kiristoos Yesuus Gooftaa keenyaa irraa akka gargar nu baasuu hin dandeenye ani amaneera.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.39",
            "verseOrgIds": [
              "ROM.8.39"
            ]
          }
        }
      ]
