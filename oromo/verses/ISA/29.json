          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu ani amma illee dinqii irratti dinqii dabalee",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.14",
            "verseOrgIds": [
              "ISA.29.14"
            ]
          }
        }
      ]
    },
