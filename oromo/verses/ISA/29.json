          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Warra karoora isaanii",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.15",
            "verseOrgIds": [
              "ISA.29.15"
            ]
          }
