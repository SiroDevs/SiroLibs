      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:20"
      },
      "items": [
        {
          "text": "warri namatti qoosan ni barbadaaʼu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.20",
            "verseOrgIds": [
              "ISA.29.20"
            ]
          }
        }
      ]
