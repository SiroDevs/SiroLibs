      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 29:21"
      },
      "items": [
        {
          "text": "sobaan dhugaa baʼuudhaan",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.21",
            "verseOrgIds": [
              "ISA.29.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:21"
      },
      "items": [
        {
          "text": "murtii qajeelaa nama yakka hin qabnee jalʼisan ni balleeffamu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.21",
            "verseOrgIds": [
              "ISA.29.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 29:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.22",
            "verseOrgIds": [
              "ISA.29.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "ISA.29.22",
                "verseOrgIds": [
                  "ISA.29.22"
                ]
              }
            }
          ]
        },
        {
          "text": "inni Abrahaamin fure sun mana Yaaqoobiin akkana jedha:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.22",
            "verseOrgIds": [
              "ISA.29.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 29:22"
      },
      "items": [
        {
          "text": "\"Yaaqoob siʼachi deebiʼee hin qaanaʼu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.22",
            "verseOrgIds": [
              "ISA.29.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:22"
      },
      "items": [
        {
          "text": "fuulli isaas siʼachi hin dukkanaaʼu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.22",
            "verseOrgIds": [
              "ISA.29.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ISA 29:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan yeroo gidduu isaaniitti ijoollee isaanii",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.23",
            "verseOrgIds": [
              "ISA.29.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:23"
      },
      "items": [
        {
          "text": "hojii harka kootii sana arganitti,",
