      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:13"
      },
      "items": [
        {
          "text": "hidhii isaatiinis na kabaja;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.13",
            "verseOrgIds": [
              "ISA.29.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:13"
      },
      "items": [
        {
          "text": "garaan isaa garuu narraa fagoo jira.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.13",
            "verseOrgIds": [
              "ISA.29.13"
            ]
          }
        }
      ]
    },
    {
