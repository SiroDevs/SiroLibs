      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:14"
      },
      "items": [
        {
          "text": "uummata kana nan dinqisiisa;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.14",
            "verseOrgIds": [
              "ISA.29.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 29:14"
      },
      "items": [
        {
          "text": "ogummaan nama ogeessaa ni bada;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.14",
            "verseOrgIds": [
              "ISA.29.14"
            ]
          }
        }
      ]
    },
    {
