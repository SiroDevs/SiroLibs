                "verseId": "ISA.29.15",
                "verseOrgIds": [
                  "ISA.29.15"
                ]
              }
            }
          ]
        },
        {
          "text": "duraa dhokfachuuf jedhanii",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.15",
            "verseOrgIds": [
              "ISA.29.15"
            ]
          }
        },
        {
          "name": "optbreak",
          "type": "tag",
          "attrs": {},
          "items": []
        },
        {
          "text": "qileetti gad buʼaniif,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.15",
            "verseOrgIds": [
              "ISA.29.15"
            ]
          }
        }
      ]
