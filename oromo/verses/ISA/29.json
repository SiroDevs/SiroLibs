          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni gad of qabu ammas",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.19",
            "verseOrgIds": [
              "ISA.29.19"
            ]
          }
        },
