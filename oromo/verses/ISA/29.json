      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:17"
      },
      "items": [
        {
          "text": "Lafti qonnaa gabbataan sunis bosona hin fakkaattuu?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.17",
            "verseOrgIds": [
              "ISA.29.17"
            ]
          }
