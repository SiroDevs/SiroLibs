      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:20"
      },
      "items": [
        {
          "text": "warri hammina hojjechuu jaallatan hundinuu ni balleeffamu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.20",
            "verseOrgIds": [
              "ISA.29.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
