      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:14"
      },
      "items": [
        {
          "text": "hubannaan hubattootaas ni dhokata.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.14",
            "verseOrgIds": [
              "ISA.29.14"
            ]
          }
        }
      ]
    },
    {
