              "attrs": {
                "verseId": "ISA.29.19",
                "verseOrgIds": [
                  "ISA.29.19"
                ]
              }
            }
          ]
        },
        {
          "text": "ni gammada;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.19",
            "verseOrgIds": [
              "ISA.29.19"
            ]
          }
        }
      ]
