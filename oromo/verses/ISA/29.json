      },
      "items": [
        {
          "text": "29",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Magaalaa Daawitiif Wayyoo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 29:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa Ariiʼeel, yaa Ariiʼeel,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.1",
            "verseOrgIds": [
              "ISA.29.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:1"
      },
      "items": [
        {
          "text": "magaalaa Daawit keessa jiraate, siif wayyoo!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.1",
            "verseOrgIds": [
              "ISA.29.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 29:1"
      },
      "items": [
        {
          "text": "Waggaa irratti waggaa dabalaa;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.1",
            "verseOrgIds": [
              "ISA.29.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:1"
      },
      "items": [
        {
          "text": "ayyaanonni waggaas ittuma haa fufan.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.1",
            "verseOrgIds": [
              "ISA.29.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taʼus ani Ariiʼeelin marsee nan qaba;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.2",
            "verseOrgIds": [
              "ISA.29.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:2"
      },
      "items": [
        {
          "text": "isheen boossee ni wawwaatti;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.2",
            "verseOrgIds": [
              "ISA.29.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:2"
      },
      "items": [
        {
          "text": "isheen anaaf akka Ariiʼeel taati.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.2",
            "verseOrgIds": [
              "ISA.29.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani karaa hundaan naannoo kee nan qubadha;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.3",
            "verseOrgIds": [
              "ISA.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:3"
      },
      "items": [
        {
          "text": "gamoowwaniinis sin marsa;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.3",
            "verseOrgIds": [
              "ISA.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:3"
      },
      "items": [
        {
          "text": "tuullaa biyyoos sitti naannessee nan dhaaba.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.3",
            "verseOrgIds": [
              "ISA.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 29:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati gad deebifamtee lafa irraa ni dubbatta;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.4",
            "verseOrgIds": [
              "ISA.29.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:4"
      },
      "items": [
        {
          "text": "haasaan kee biyyoo keessaa guunguma.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.4",
            "verseOrgIds": [
              "ISA.29.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 29:4"
      },
      "items": [
        {
          "text": "Sagaleen kee akka sagalee ekeraa lafa keessaa baʼa;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.4",
            "verseOrgIds": [
              "ISA.29.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:4"
      },
      "items": [
        {
          "text": "haasaan kees biyyoo keessaa hasaasa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.4",
            "verseOrgIds": [
              "ISA.29.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Diinonni kee hedduun garuu akka awwaara bullaaʼee,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.5",
            "verseOrgIds": [
              "ISA.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:5"
      },
      "items": [
        {
          "text": "gara jabeeyyiin baayʼeenis akka habaqii bubbeen fudhatee taʼu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.5",
            "verseOrgIds": [
              "ISA.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 29:5"
      },
      "items": [
        {
          "text": "Akkuma tasaa utuu hin beekaminis,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.5",
            "verseOrgIds": [
              "ISA.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 29:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text",
              "attrs": {
                "verseId": "ISA.29.6",
                "verseOrgIds": [
                  "ISA.29.6"
                ]
              }
            }
          ]
        },
        {
          "text": "Waan Hunda Dandaʼu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.6",
            "verseOrgIds": [
              "ISA.29.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 29:6"
      },
      "items": [
        {
          "text": "bakakkaadhaan, sochii lafaatii fi waca guddaadhaan,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.6",
            "verseOrgIds": [
              "ISA.29.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:6"
      },
      "items": [
        {
          "text": "bubbeedhaan, bubbee hamaa fi arraba ibidda waa fixuutiin ni dhufa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.6",
            "verseOrgIds": [
              "ISA.29.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 29:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasii tuunni saboota hundaa kan Ariiʼeeliin lolu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.7",
            "verseOrgIds": [
              "ISA.29.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:7"
      },
      "items": [
        {
          "text": "kan ishee fi daʼoo ishee jajjaboo dhaʼee marsee qabu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.7",
            "verseOrgIds": [
              "ISA.29.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 29:7"
      },
      "items": [
        {
          "text": "akkuma abjuu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.7",
            "verseOrgIds": [
              "ISA.29.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:7"
      },
      "items": [
        {
          "text": "akkuma mulʼata halkan keessaa taʼa;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.7",
            "verseOrgIds": [
              "ISA.29.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 29:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "kunis akkuma namni beelaʼe tokko akka waa nyaachaa jiru abjuudhaan argee",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.8",
            "verseOrgIds": [
              "ISA.29.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:8"
      },
      "items": [
        {
          "text": "yeroo dammaqutti garuu amma illee beela qabu sana,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.8",
            "verseOrgIds": [
              "ISA.29.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 29:8"
      },
      "items": [
        {
          "text": "yookaan akkuma namni dheebote tokko akka waa dhugaa jiru abjuudhaan argee",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.8",
            "verseOrgIds": [
              "ISA.29.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:8"
      },
      "items": [
        {
          "text": "yeroo dammaqutti garuu amma illee dheebuudhaan gaggabu sana taʼa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.8",
            "verseOrgIds": [
              "ISA.29.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 29:8"
      },
      "items": [
        {
          "text": "Tuuta saboota hundaa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.8",
            "verseOrgIds": [
              "ISA.29.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:8"
      },
      "items": [
        {
          "text": "kan Tulluu Xiyoon lolu irrattis akkasuma taʼa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.8",
            "verseOrgIds": [
              "ISA.29.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rifadhaa; dinqisiifadhaas;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.9",
            "verseOrgIds": [
              "ISA.29.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:9"
      },
      "items": [
        {
          "text": "of jaamsaatii nama waa hin argine taʼaa;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.9",
            "verseOrgIds": [
              "ISA.29.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 29:9"
      },
      "items": [
        {
          "text": "machaaʼaa; garuu daadhii wayiniitiin hin taʼin;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.9",
            "verseOrgIds": [
              "ISA.29.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:9"
      },
      "items": [
        {
          "text": "gatantaraa; garuu dhugaatii jabaadhaan hin taʼin.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.9",
            "verseOrgIds": [
              "ISA.29.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 29:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "ISA.29.10",
                "verseOrgIds": [
                  "ISA.29.10"
                ]
              }
            }
          ]
        },
        {
          "text": "hirriba cimaa isinitti buuseera;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.10",
            "verseOrgIds": [
              "ISA.29.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:10"
      },
      "items": [
        {
          "text": "ija keessan raajota, cufeera;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.10",
            "verseOrgIds": [
              "ISA.29.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 29:10"
      },
      "items": [
        {
          "text": "mataa keessan ilaaltootas, haguugeera.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.10",
            "verseOrgIds": [
              "ISA.29.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulʼanni kun hundi isiniif dubbii kitaaba maramaa irratti chaappeffame malee homaa miti. Yoo isin kitaaba kana nama dubbisuu dandaʼu tokkotti kennitanii, \"Maaloo mee waan kana dubbisi\" jettaniin inni, \"Sababii kitaabichi chaappeffameef ani dubbisuu hin dandaʼu\" jedhee deebisa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.11",
            "verseOrgIds": [
              "ISA.29.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 29:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yookaan yoo isin kitaaba maramaa kana nama dubbisuu hin dandeenye tokkotti kennitanii, \"Maaloo mee waan kana dubbisi\" jettaniin inni, \"Ani akkamitti akkan dubbisu hin beeku\" jedhee deebisa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.12",
            "verseOrgIds": [
              "ISA.29.12"
            ]
          }
        }
      ]
    },
    {
