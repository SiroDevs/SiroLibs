    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Damee Isseey",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lataan tokko jirma Isseey irraa ni lata;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.1",
            "verseOrgIds": [
              "ISA.11.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:1"
      },
      "items": [
        {
          "text": "hidda isaa irraas dameen tokko ija naqata.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.1",
            "verseOrgIds": [
              "ISA.11.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hafuurri",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.2",
            "verseOrgIds": [
              "ISA.11.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "ISA.11.2",
                "verseOrgIds": [
                  "ISA.11.2"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.2",
            "verseOrgIds": [
              "ISA.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:2"
      },
      "items": [
        {
          "text": "Hafuurri ogummaatii fi hubannaa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.2",
            "verseOrgIds": [
              "ISA.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:2"
      },
      "items": [
        {
          "text": "Hafuurri gorsaatii fi humnaa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.2",
            "verseOrgIds": [
              "ISA.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:2"
      },
      "items": [
        {
          "text": "Hafuurri beekumsaatii fi kan",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.2",
            "verseOrgIds": [
              "ISA.11.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text",
              "attrs": {
                "verseId": "ISA.11.2",
                "verseOrgIds": [
                  "ISA.11.2"
                ]
              }
            }
          ]
        },
        {
          "text": "sodaachuu isa irra qubata;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.2",
            "verseOrgIds": [
              "ISA.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "inni",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.3",
            "verseOrgIds": [
              "ISA.11.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text",
              "attrs": {
                "verseId": "ISA.11.3",
                "verseOrgIds": [
                  "ISA.11.3"
                ]
              }
            }
          ]
        },
        {
          "text": "sodaachuutti ni gammada.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.3",
            "verseOrgIds": [
              "ISA.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "ISA 11:3"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 11:3"
      },
      "items": [
        {
          "text": "Inni waanuma iji isaa arguun murtii hin kennu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.3",
            "verseOrgIds": [
              "ISA.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:3"
      },
      "items": [
        {
          "text": "yookaan waanuma gurra isaatiin dhagaʼuun hin murteessu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.3",
            "verseOrgIds": [
              "ISA.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "garuu nama rakkataaf qajeelummaadhaan murteessa;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.4",
            "verseOrgIds": [
              "ISA.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:4"
      },
      "items": [
        {
          "text": "hiyyeeyyii lafa irraatiifis murtii qajeelaadhaan murtii kenna.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.4",
            "verseOrgIds": [
              "ISA.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 11:4"
      },
      "items": [
        {
          "text": "Inni ulee afaan isaatiin lafa rukuta;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.4",
            "verseOrgIds": [
              "ISA.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:4"
      },
      "items": [
        {
          "text": "hafuura afaan isaatii baʼuun hamoota ni fixa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.4",
            "verseOrgIds": [
              "ISA.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qajeelummaan teepha mudhii isaa ti;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.5",
            "verseOrgIds": [
              "ISA.11.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:5"
      },
      "items": [
        {
          "text": "amanamummaan immoo sabbata mudhii isaa ti.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.5",
            "verseOrgIds": [
              "ISA.11.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeeyyiin xobbaallaa hoolaa wajjin jiraata;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.6",
            "verseOrgIds": [
              "ISA.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:6"
      },
      "items": [
        {
          "text": "qeerransi ilmoo reʼee bira ciisa;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.6",
            "verseOrgIds": [
              "ISA.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 11:6"
      },
      "items": [
        {
          "text": "jabbiin, leencii fi horiin gabbataan walii wajjin bobbaʼu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.6",
            "verseOrgIds": [
              "ISA.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:6"
      },
      "items": [
        {
          "text": "mucaan xinnaan isaan bobbaasa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.6",
            "verseOrgIds": [
              "ISA.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saan amaaketa wajjin soorata;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.7",
            "verseOrgIds": [
              "ISA.11.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:7"
      },
      "items": [
        {
          "text": "ilmaan isaanii wal cina ciciisu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.7",
            "verseOrgIds": [
              "ISA.11.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:7"
      },
      "items": [
        {
          "text": "leencis akka sangaa cidii nyaata.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.7",
            "verseOrgIds": [
              "ISA.11.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daaʼimni boolla bofaa irra taphata;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.8",
            "verseOrgIds": [
              "ISA.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:8"
      },
      "items": [
        {
          "text": "mucaan xinnaan boolla buutii keessa harka kaaʼa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.8",
            "verseOrgIds": [
              "ISA.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan tulluuwwan koo qulqulloota hunda irratti",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.9",
            "verseOrgIds": [
              "ISA.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:9"
      },
      "items": [
        {
          "text": "waa hin miidhan yookaan waa hin balleessan;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.9",
            "verseOrgIds": [
              "ISA.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 11:9"
      },
      "items": [
        {
          "text": "akkuma bishaan galaana guutu sana",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.9",
            "verseOrgIds": [
              "ISA.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:9"
      },
      "items": [
        {
          "text": "lafti",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.9",
            "verseOrgIds": [
              "ISA.11.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text",
              "attrs": {
                "verseId": "ISA.11.9",
                "verseOrgIds": [
                  "ISA.11.9"
                ]
              }
            }
          ]
        },
        {
          "text": "beekuudhaan guutamtiitii.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.9",
            "verseOrgIds": [
              "ISA.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bara sana keessa hiddi Isseey akkuma faajjiitti uummataaf dhaabata; saboonni gara isaatti walitti qabamu; lafti inni boqotus ulfina qabeessa taʼa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.10",
            "verseOrgIds": [
              "ISA.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaafas Gooftaan yeroo lammaffaaf harka isaa diriirsee Asoor irraa, Gibxi Gadii irraa, Gibxi Olii irraa, Itoophiyaa irraa, Eelaam irraa, Baabilon irraa, Hamaatii fi biyyoota bishaan gidduu galaanaa irraa hambaawwan saba isaa walitti qabata.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.11",
            "verseOrgIds": [
              "ISA.11.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni sabootaaf faajjii ol kaasee",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.12",
            "verseOrgIds": [
              "ISA.11.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:12"
      },
      "items": [
        {
          "text": "boojiʼamtoota Israaʼel walitti qaba;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.12",
            "verseOrgIds": [
              "ISA.11.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 11:12"
      },
      "items": [
        {
          "text": "inni roga laafaa afran irraa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.12",
            "verseOrgIds": [
              "ISA.11.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:12"
      },
      "items": [
        {
          "text": "saba Yihuudaa kan bittinnaaʼee ture walitti qaba.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.12",
            "verseOrgIds": [
              "ISA.11.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
