              "attrs": {
                "verseId": "ISA.13.9",
                "verseOrgIds": [
                  "ISA.13.9"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.9",
            "verseOrgIds": [
              "ISA.13.9"
            ]
          }
        }
      ]
