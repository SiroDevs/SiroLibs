      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:5"
      },
      "items": [
        {
          "text": "guutummaa biyyattii balleessuuf dhufu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.5",
            "verseOrgIds": [
              "ISA.13.5"
            ]
