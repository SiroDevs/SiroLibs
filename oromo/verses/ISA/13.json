          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan biyya fagoodhaa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.5",
            "verseOrgIds": [
              "ISA.13.5"
            ]
          }
        }
