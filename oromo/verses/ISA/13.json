                "verseId": "ISA.13.5",
                "verseOrgIds": [
                  "ISA.13.5"
                ]
              }
            }
          ]
        },
        {
          "text": "fi miʼa lolaa kan dheekkamsa isaatiin",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.5",
            "verseOrgIds": [
              "ISA.13.5"
            ]
          }
