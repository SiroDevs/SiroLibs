      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:5"
      },
      "items": [
        {
          "text": "daarii samiiwwaniitii dhufan;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.5",
            "verseOrgIds": [
              "ISA.13.5"
            ]
          }
        }
      ]
    },
    {
