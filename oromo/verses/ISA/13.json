          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waca tulluuwwan irraa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.4",
            "verseOrgIds": [
              "ISA.13.4"
            ]
          }
        }
      ]
    },
