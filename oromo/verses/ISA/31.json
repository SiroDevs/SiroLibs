    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Warra Gibxin Abdataniif Wayyoo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 31:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Warra gargaarsa barbaacha gara Gibxitti gad buʼaniif,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.1",
            "verseOrgIds": [
              "ISA.31.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:1"
      },
      "items": [
        {
          "text": "warra fardeen abdataniif",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.1",
            "verseOrgIds": [
              "ISA.31.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 31:1"
      },
      "items": [
        {
          "text": "warra gaariiwwan isaaniitii fi",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.1",
            "verseOrgIds": [
              "ISA.31.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:1"
      },
      "items": [
        {
          "text": "jabina abbootii fardeen isaanii amanatanii",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.1",
            "verseOrgIds": [
              "ISA.31.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 31:1"
      },
      "items": [
        {
          "text": "garuu gara Qulqullicha Israaʼel hin ilaalle",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.1",
            "verseOrgIds": [
              "ISA.31.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:1"
      },
      "items": [
        {
          "text": "yookaan gargaarsa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.1",
            "verseOrgIds": [
              "ISA.31.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "ISA.31.1",
                "verseOrgIds": [
                  "ISA.31.1"
                ]
              }
            }
          ]
        },
        {
          "text": "hin barbaanneef wayyoo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.1",
            "verseOrgIds": [
              "ISA.31.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 31:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taʼus inni ogeessa; balaas fiduu dandaʼa;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.2",
            "verseOrgIds": [
              "ISA.31.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:2"
      },
      "items": [
        {
          "text": "inni waan jedhe irraa duubatti hin deebiʼu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.2",
            "verseOrgIds": [
              "ISA.31.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 31:2"
      },
      "items": [
        {
          "text": "Inni mana hamootaatti,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.2",
            "verseOrgIds": [
              "ISA.31.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:2"
      },
      "items": [
        {
          "text": "warra namoota hammina hojjetan gargaaraniitti ni kaʼa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.2",
            "verseOrgIds": [
              "ISA.31.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 31:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Warri Gibxi namootuma malee Waaqa miti;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.3",
            "verseOrgIds": [
              "ISA.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:3"
      },
      "items": [
        {
          "text": "fardeen isaaniis foonuma malee hafuura miti.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.3",
            "verseOrgIds": [
              "ISA.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 31:3"
      },
      "items": [
        {
          "text": "Yeroo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.3",
            "verseOrgIds": [
              "ISA.31.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "ISA.31.3",
                "verseOrgIds": [
                  "ISA.31.3"
                ]
              }
            }
          ]
        },
        {
          "text": "harka isaa diriirfatutti,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.3",
            "verseOrgIds": [
              "ISA.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:3"
      },
      "items": [
        {
          "text": "inni gargaaru ni gufata;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.3",
            "verseOrgIds": [
              "ISA.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:3"
      },
      "items": [
        {
          "text": "inni gargaaramus ni kufa;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.3",
            "verseOrgIds": [
              "ISA.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:3"
      },
      "items": [
        {
          "text": "isaan lachuu walii wajjin badu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.3",
            "verseOrgIds": [
              "ISA.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 31:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "ISA.31.4",
                "verseOrgIds": [
                  "ISA.31.4"
                ]
              }
            }
          ]
        },
        {
          "text": "akkana naan jedha:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.4",
            "verseOrgIds": [
              "ISA.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 31:4"
      },
      "items": [
        {
          "text": "\"Akkuma leenci,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.4",
            "verseOrgIds": [
              "ISA.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:4"
      },
      "items": [
        {
          "text": "leenci guddaan tokko waan qabate irratti aadu sana,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.4",
            "verseOrgIds": [
              "ISA.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:4"
      },
      "items": [
        {
          "text": "tuunni tiksootaa guutuun isatti wal waammatan iyyuu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.4",
            "verseOrgIds": [
              "ISA.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 31:4"
      },
      "items": [
        {
          "text": "inni iyya isaanii hin sodaatu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.4",
            "verseOrgIds": [
              "ISA.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:4"
      },
      "items": [
        {
          "text": "yookaan waca isaaniitiin hin raafamu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.4",
            "verseOrgIds": [
              "ISA.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 31:4"
      },
      "items": [
        {
          "text": "akkasuma",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.4",
            "verseOrgIds": [
              "ISA.31.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text",
              "attrs": {
                "verseId": "ISA.31.4",
                "verseOrgIds": [
                  "ISA.31.4"
                ]
              }
            }
          ]
        },
        {
          "text": "Waan Hunda Dandaʼu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.4",
            "verseOrgIds": [
              "ISA.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:4"
      },
      "items": [
        {
          "text": "Tulluu Xiyoon irratti waraana banuuf gad buʼa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.4",
            "verseOrgIds": [
              "ISA.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 31:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkuma simbirroon mataa namaa irra naannoftu sana",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.5",
            "verseOrgIds": [
              "ISA.31.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:5"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text",
              "attrs": {
                "verseId": "ISA.31.5",
                "verseOrgIds": [
                  "ISA.31.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Waan Hunda Dandaʼu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.5",
            "verseOrgIds": [
              "ISA.31.5"
            ]
          }
        },
        {
          "name": "optbreak",
          "type": "tag",
          "attrs": {},
          "items": []
        },
        {
          "text": "Yerusaalemiif gaachana taʼa;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.5",
            "verseOrgIds": [
              "ISA.31.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 31:5"
      },
      "items": [
        {
          "text": "inni gaachana taʼeefii ishee baraara;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.5",
            "verseOrgIds": [
              "ISA.31.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:5"
      },
      "items": [
        {
          "text": "ishee bira darba; ishee oolchas.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.5",
            "verseOrgIds": [
              "ISA.31.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 31:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa saba Israaʼel, gara Isa akka malee itti finciltan sanaatti deebiʼaa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.6",
            "verseOrgIds": [
              "ISA.31.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 31:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bara sana tokkoon tokkoon keessan waaqota tolfamoo harki keessan cubbamaan sun meetii fi warqee irraa hojjetee ture sana ni gattuutii.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.7",
            "verseOrgIds": [
              "ISA.31.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 31:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Asoor goraadee kan namaa hin taʼiniin kufti;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.8",
            "verseOrgIds": [
              "ISA.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:8"
      },
      "items": [
        {
          "text": "goraadeen nama duʼa hin oollees isaan fixa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.8",
            "verseOrgIds": [
              "ISA.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 31:8"
      },
      "items": [
        {
          "text": "Isaan goraadee duraa baqatu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.8",
            "verseOrgIds": [
              "ISA.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:8"
      },
      "items": [
        {
          "text": "dargaggoonni isaaniis dirqamaan hojii humnaa hojjetu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.8",
            "verseOrgIds": [
              "ISA.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 31:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daʼoon isaanii sababii sodaatiif ni jiga;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.9",
            "verseOrgIds": [
              "ISA.31.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:9"
      },
      "items": [
        {
          "text": "ajajjoonni isaaniis faajjii waraanaa arganii hollatu\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.9",
            "verseOrgIds": [
              "ISA.31.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 31:9"
      },
      "items": [
        {
          "text": "jedha",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.9",
            "verseOrgIds": [
              "ISA.31.9"
            ]
          }
        },
        {
          "name": "char",
