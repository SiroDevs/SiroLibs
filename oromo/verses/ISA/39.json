    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 39:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo sanatti Meroodak Baladaan ilmi Baladaan mootiin Baabilon sababii akka Hisqiyaas dhukkubsatee fayye dhagaʼeef xalayootaa fi kennaa ergeef.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.1",
            "verseOrgIds": [
              "ISA.39.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 39:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hisqiyaasis ergamoota sana gammachuudhaan simatee waan mankuusa isaa keessa ture meetii, warqee, urgooftuu, zayitii qulqulluu akkasumas kuusaa miʼa lolaa isaa guutuu fi waan mankuusa isaa keessatti argamu hunda isaanitti argisiise. Wanni Hisqiyaas masaraa mootummaa isaa keessaa yookaan mootummaa isaa hunda keessaa isaanitti hin argisiisin tokko iyyuu hin turre.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.2",
            "verseOrgIds": [
              "ISA.39.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 39:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana irratti Isaayyaas raajichi gara Hisqiyaas mootichaa dhaqee, \"Namoonni sun maal jedhan? Isaan eessaa dhufan?\" jedhee gaafate.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.3",
            "verseOrgIds": [
              "ISA.39.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ISA 39:3"
      },
      "items": [
        {
          "text": "Hisqiyaasis, \"Isaan Baabilonii biyya fagoodhaa na bira dhufan\" jedhee deebise.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.3",
            "verseOrgIds": [
              "ISA.39.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 39:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Raajichi, \"Jarri masaraa mootummaa keetii keessatti maal argan?\" jedhee gaafate.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.4",
            "verseOrgIds": [
              "ISA.39.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ISA 39:4"
      },
      "items": [
        {
          "text": "Hisqiyaas immoo, \"Isaan waan masaraa mootummaa koo keessa jiru hunda argan; wanni ani mankuusa koo keessaa isaanitti hin argisiisin tokko iyyuu hin jiru\" jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.4",
            "verseOrgIds": [
              "ISA.39.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 39:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaayyaasis kana irratti Hisqiyaasiin akkana jedhe; \"Dubbii",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.5",
            "verseOrgIds": [
              "ISA.39.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "ISA.39.5",
                "verseOrgIds": [
                  "ISA.39.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Waan Hunda Dandaʼuu dhagaʼi:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.5",
            "verseOrgIds": [
              "ISA.39.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 39:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroon itti wanni masaraa mootummaa keetii keessa jiru hundii fi wanni abbootiin kee hamma harʼaatti kuusan hundinuu saamamee gara Baabilonitti geeffamu tokko dhugumaan ni dhufa. Wanni tokko iyyuu hin hafu, jedha",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.6",
            "verseOrgIds": [
              "ISA.39.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "ISA.39.6",
                "verseOrgIds": [
                  "ISA.39.6"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.6",
            "verseOrgIds": [
              "ISA.39.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 39:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sanyii kee keessaa namoonni tokko tokko, foonii fi dhiigni kee kanneen siif dhalatan boojiʼamanii masaraa mootummaa mooticha Baabilon keessatti xuʼaashiiwwan taʼu.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.7",
            "verseOrgIds": [
              "ISA.39.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 39:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hisqiyaasis, \"Dubbiin",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.8",
            "verseOrgIds": [
              "ISA.39.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "ISA.39.8",
                "verseOrgIds": [
                  "ISA.39.8"
                ]
              }
            }
          ]
        },
        {
          "text": "kan ati dubbatte kun gaarii dha\" jedhee deebise. Inni, \"Bara jireenya koo keessa nagaa fi tasgabbiin ni jiraata\" jedhee yaadee tureetii.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.8",
            "verseOrgIds": [
              "ISA.39.8"
            ]
          }
        }
      ]
    }
  ],
