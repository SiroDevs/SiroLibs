  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "17",
        "style": "c",
        "sid": "JOS 17"
      },
      "items": [
        {
          "text": "17",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gosti Minaasees qooda argatte; inni ilma Yoosef hangafa tureetii. Maakiir ilmi Minaasee hangaftichi abbaan Giliʼaadotaa sun sababii loltuu jabaa taʼeef Giliʼaadii fi Baashaan isaaf kennaman.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.1",
            "verseOrgIds": [
              "JOS.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu qoodni kun saba Minaasee warra hafaniif jechuunis balbala Abiiʼezer, Heleq, Asriiʼeel, Sheekem, Heeferii fi Shemiidaaf kenname. Kunneenis balbala balbala isaaniitiin ilmaan Minaasee ilma Yoosef kanneen biraa ti.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.2",
            "verseOrgIds": [
              "JOS.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zelofehaad ilmi Heefer, ilmi Giliʼaad, ilma Maakiir, ilmi Minaasee sun intallan malee ilmaan hin qabu ture. Maqaan intallan isaas Mahilaa, Nohii, Hoglaa, Miilkaa fi Tiirzaa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.3",
            "verseOrgIds": [
              "JOS.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis gara Eleʼaazaar lubichaa, gara Iyyaasuu ilma Nuunitii fi gara hooggantootaa dhaqanii \"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.4",
            "verseOrgIds": [
              "JOS.17.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JOS.17.4",
                "verseOrgIds": [
                  "JOS.17.4"
                ]
              }
            }
          ]
        },
        {
          "text": "akka inni obboloota keenya gidduutti dhaala nuu kennuuf Musee ajajeera\" jedhan. Kanaafuu Iyyaasuun akkuma ajaja",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.4",
            "verseOrgIds": [
              "JOS.17.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyootti",
              "type": "text",
              "attrs": {
                "verseId": "JOS.17.4",
                "verseOrgIds": [
                  "JOS.17.4"
                ]
              }
            }
          ]
        },
        {
          "text": "obboloota abbaa isaanii wajjin dhaala kenneef.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.4",
            "verseOrgIds": [
              "JOS.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Minaaseen Giliʼaadii fi Baashaan keessaa gama baʼa Yordaanositti lafa iddoo kudhanitti hiramu qaba ture.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.5",
            "verseOrgIds": [
              "JOS.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunis sababii intallan gosa Minaasee sun ilmaan dhiiraa gidduutti qooda argataniif. Lafti Giliʼaad ilmaan Minaasee kanneen hafaniif kennamte.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.6",
            "verseOrgIds": [
              "JOS.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daangaan gosa Minaasee Aasheerii kaʼee hamma Mikmetaati kan karaa baʼa Sheekem jirtu sanaatti balʼata. Daangaan sunis achii kaʼee kibbaan gad buʼee saba Een Tafuuʼaa keessa jiraatus dabalata.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.7",
            "verseOrgIds": [
              "JOS.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biyyi Tafuuʼaa kan Minaasee turte; Tafuuʼaan mataan ishee garuu karaa daangaa Minaaseetiin kan ilmaan Efreem turte.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.8",
            "verseOrgIds": [
              "JOS.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daangaan sun karaa kibbaatiin ittuma fufee Laga Qaanaa bira gaʼa. Magaalaawwan Efreem kanneen magaalaawwan Minaasee gidduutti argamanitu ture; daangaan Minaasee garuu Kaaba lagichaa irra darbee galaana bira gaʼee dhaabata.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.9",
            "verseOrgIds": [
              "JOS.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biyyi sun karaa kibbaatiin kan gosa Efreemiiti; karaa kaabaatiin immoo kan gosa Minaasee ti. Biyyi Minaasee hamma galaanaatti deemee karaa kaabaatiin Aasheerin, karaa baʼaatiin immoo Yisaakorin daangeessa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.10",
            "verseOrgIds": [
              "JOS.17.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Minaaseenis Yisaakorii fi Aasheer keessaa Beet Sheʼaan, Yibleʼaamii fi saba Door, Eendoor, Taʼanaakii fi Megidoo qubatawwan naannoo isaanii jiran wajjin qaba ture; sadaffaan immoo Naafootii dha.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.11",
            "verseOrgIds": [
              "JOS.17.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taʼus sababii Kanaʼaanonni biyya sana jiraachuuf kutatanii turaniif gosti Minaasee magaalaawwan kanneen qabachuu hin dandeenye.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.12",
            "verseOrgIds": [
              "JOS.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu Israaʼeloonni yommuu jabina argachaa dhufanitti akka isaan hojii humnaa hojjetan godhan malee Kanaʼaanota achii hin baafne.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.13",
            "verseOrgIds": [
              "JOS.17.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoonni Yoosefis Iyyaasuudhaan, \"Ati maaliif ixaa tokkoo fi qooda tokko qofa dhaala nuu kennite? Nu saba akka malee baayʼee fi saba",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.14",
            "verseOrgIds": [
              "JOS.17.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JOS.17.14",
                "verseOrgIds": [
                  "JOS.17.14"
                ]
              }
            }
          ]
        },
        {
          "text": "guddisee eebbisee dha\" jedhan.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.14",
            "verseOrgIds": [
              "JOS.17.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyyaasuunis, \"Yoo isin akka malee baayʼattanii biyyi gaaraa Efreem kun isinitti dhiphatte bosona seenaatii biyya Feerzotaatii fi Refaayimootaa keessatti iddoo jireenyaa qopheeffadhaa\" jedhee deebiseef.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.15",
            "verseOrgIds": [
              "JOS.17.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoonni Yoosefis, \"Biyyi gaaraa kun nu hin gaʼu; Kanaʼaanonni lafa diriiraa irra jiraatan hundi, warri Beet Sheʼaanii fi qubatawwan ishee akkasumas warri Sulula Yizriʼeel keessa jiraatan hundi gaariiwwan sibiilaa qaban\" jedhanii deebisan.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.16",
            "verseOrgIds": [
              "JOS.17.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyyaasuun garuu mana Yoosefiin jechuunis Efreemii fi Minaaseedhaan akkana jedhe; \"Isin saba akka malee baayʼee kan humna guddaa qabuu dha. Ixaa tokko qofa hin qabaattan.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.17",
            "verseOrgIds": [
              "JOS.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biyya gaaraa kan bosonaa garuu ni qabaattu; bosona ciraa; biyyattiinis hamma qarqara daangaa isheetti kanuma keessan taati; Kanaʼaanonni yoo gaariiwwan sibiilaa qabaatanii jajjaboo taʼanis isin ariitanii isaan baasuu dandeessu.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.18",
            "verseOrgIds": [
              "JOS.17.18"
            ]
          }
        }
      ]
    }
  ],
