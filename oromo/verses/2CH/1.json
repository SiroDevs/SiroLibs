      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sababii",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.1",
            "verseOrgIds": [
              "2CH.1.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.1.1",
                "verseOrgIds": [
                  "2CH.1.1"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni isaa isa wajjin turee fi sababii inni akka malee guddaa isa godheef Solomoon ilmi Daawit jabaatee mootummaa isaa irra bule.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.1",
            "verseOrgIds": [
              "2CH.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasiis Solomoon Israaʼeloota hundatti, ajajjoota kumaatti, ajajjoota dhibbaatti, abbootii murtiitti, hooggantoota Israaʼel hundattii fi hangafoota abbootiitti dubbate;",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.2",
            "verseOrgIds": [
              "2CH.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "sababii dunkaanni wal gaʼii kan Waaqaa inni Museen garbichi",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.3",
            "verseOrgIds": [
              "2CH.1.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.1.3",
                "verseOrgIds": [
                  "2CH.1.3"
                ]
              }
            }
          ]
        },
        {
          "text": "sun gammoojjii keessatti hojjete achi tureef Solomoonii fi yaaʼiin guutuun gara iddoo sagadaa kan gaara irraa kan Gibeʼoon jiru sanaa ni dhaqan.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.3",
            "verseOrgIds": [
              "2CH.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daawitis taabota Waaqaa Kiriyaati Yeʼaariimii gara iddoo qopheesseef sanaatti ni fide; inni Yerusaalem keessatti dunkaana dhaabeefii tureetii.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.4",
            "verseOrgIds": [
              "2CH.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu iddoon aarsaa kan Bezaliʼeel ilmi Uuri, ilmi Huuri naasii irraa hojjete sun fuula dunkaana qulqulluu",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.5",
            "verseOrgIds": [
              "2CH.1.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.1.5",
                "verseOrgIds": [
                  "2CH.1.5"
                ]
              }
            }
          ]
        },
        {
          "text": "sanaa dura ture; kanaafuu Solomoonii fi yaaʼiin sun achitti Waaqa kadhatan.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.5",
            "verseOrgIds": [
              "2CH.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoonis gara iddoo aarsaa kan naasii irraa hojjetamee dunkaana wal gaʼii keessa fuula",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.6",
            "verseOrgIds": [
              "2CH.1.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.1.6",
                "verseOrgIds": [
                  "2CH.1.6"
                ]
              }
            }
          ]
        },
        {
          "text": "dura jiru sanaatti ol baʼee aarsaa gubamu 1,000 achi irratti ni dhiʼeesse.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.6",
            "verseOrgIds": [
              "2CH.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqnis halkan sana Solomoonitti mulʼatee, \"Waan akka ani siif kennu feetu kam iyyuu na kadhadhu\" jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.7",
            "verseOrgIds": [
              "2CH.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoon immoo akkana jedhee Waaqaaf deebise; \"Ati abbaa koo Daawitiif arjummaa guddaa goote; anas iddoo isaa buuftee mootii gooteerta.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.8",
            "verseOrgIds": [
              "2CH.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egaa yaa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.9",
            "verseOrgIds": [
              "2CH.1.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2CH.1.9",
                "verseOrgIds": [
                  "2CH.1.9"
                ]
              }
            }
          ]
        },
        {
          "text": ", yaa Waaqi, abdiin ati abbaa koo Daawitiif kennite sun fiixaan haa baʼu; ati saba akka biyyoo lafaa baayʼatu irratti mootii na gooteertaatii.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.9",
            "verseOrgIds": [
              "2CH.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka ani saba kana hoogganuuf ogummaa fi beekumsa naaf kenni. Yoo akkas taʼuu baate eenyutu saba kee guddaa kana bulchuu dandaʼa?\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.10",
            "verseOrgIds": [
              "2CH.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqnis Solomooniin akkana jedhe; \"Sababii wanni kun fedhii garaa keetii taʼee atis qabeenya, badhaadhummaa yookaan ulfina yookaan akka diinonni kee dhuman hin kadhatinii fi sababii ati bara dheeraa jiraachuuf utuu hin taʼin saba koo kan ani irratti mootii si godhe bulchuuf jettee ogummaa fi beekumsa kadhatteef,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.11",
            "verseOrgIds": [
              "2CH.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "ogummaa fi beekumsi siif ni kennama. Ani qabeenya, badhaadhummaa fi ulfina mootonni si duraan turan tokko iyyuu takkumaa hin qabaatin yookaan kan mootonni siin duubaa tokko iyyuu hin qabaanne siifin kenna.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.12",
            "verseOrgIds": [
              "2CH.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoon ergasii iddoo sagadaa kan Gibeʼoon keessaa sanaa, fuula dunkaana wal gaʼii duraa kaʼee Yerusaalem dhaqe. Innis Israaʼel irratti mootii taʼe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.13",
            "verseOrgIds": [
              "2CH.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoonis gaariiwwanii fi fardeen walitti ni kuufate; innis gaariiwwan kuma tokkoo fi dhibba afurii fi fardeen kuma kudha lama qaba ture; isaan kanneenis magaalaawwan gaariiwwanii keessaa fi Yerusaalem keessa of bira ni kaaʼate.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.14",
            "verseOrgIds": [
              "2CH.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootichi akka meetii fi warqeen Yerusaalem keessatti akkuma dhagaa baayʼatu, akka mukni birbirsaas akkuma mukkeen harbuu kanneen gaarran jalaatti baayʼatu ni godhe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.15",
            "verseOrgIds": [
              "2CH.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fardeen Solomoon Gibxii fi Qaweedhaa fidaman; daldaltoota mootummaatu Qaweedhaa gatii yerootiin isaan bite.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.16",
            "verseOrgIds": [
              "2CH.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis gaarii tokko meetii saqilii dhibba jaʼaan, farda immoo meetii saqilii dhibba tokkoo fi shantamaan Gibxii bitanii fidan. Akkasumas gaariiwwanii fi fardeen kanneen erganii mootota Heetotaatii fi mootota Sooriyaa hundatti gurguru turan.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.17",
            "verseOrgIds": [
              "2CH.1.17"
            ]
          }
        }
      ]
    }
  ],
