                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ulfinni warqee kan wagguma waggaan Solomooniif galu taalaantii 666 ture;",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.13",
            "verseOrgIds": [
              "2CH.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "kunis gibira daldaltoota qabeenya gurguddaatii fi kan warra qabeenya xixinnaa irraa argamuu hin dabalatu. Akkasumas mootonni Arabaa fi bulchitoonni biyyaa hundi Solomooniif warqee fi meetii ni fidan.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.14",
            "verseOrgIds": [
              "2CH.9.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoon Mootichis warqee tumame irraa gaachanawwan gurguddaa dhibba lama ni tolche; tokkoon tokkoon gaachanawwan sanaas warqee saqilii dhibba jaʼa fixe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.15",
            "verseOrgIds": [
              "2CH.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkasumas warqee tumame irraa gaachana xixinnaa dhibba sadii ni tolche. Tokkoon tokkoon gaachana sanaas warqee saqilii dhibba sadii fixe. Mootichis gaachanawwan kanneen Masaraa mootummaa kan Bosona Libaanoon keessa ni kaaʼe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.16",
            "verseOrgIds": [
              "2CH.9.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootichis teessoo guddaa tokko ilka arbaa irraa hojjetee warqee qulqulluu itti uffise.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.17",
            "verseOrgIds": [
              "2CH.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Teessoon sun gulantaawwan jaʼa qaba ture; ejjenni miillaa kan warqee irraa hojjetame tokkos itti qabsiifamee ture. Karaa teessoo sanaa lamaaniinis waan harka irra kaaʼatanitu ture; tokkoo tokkoo waan harka irra kaaʼatan sanaa biras fakkii leencaa tokko tokkotu dhaabatee ture.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.18",
            "verseOrgIds": [
              "2CH.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gulantaawwan jaʼaan sana irras leenconni kudha lama tokko fiixee tokkoon, fakkiin kaan immoo fiixee kaaniin dhadhaabachaa turan. Wanni akkasii takkumaa mootummaa biraa kamiif iyyuu hin tolfamne.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.19",
            "verseOrgIds": [
              "2CH.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miʼi Solomoon Mootichi ittiin dhugu hundinuu warqee irraa hojjetame; miʼi Masaraa mootummaa kan Bosona Libaanoon jedhamu sanaa hundi immoo warqee qulqulluu irraa hojjetame. Sababii bara Solomoon keessa meetiin akka waan gatii hin qabne tokkootti ilaalamaa tureef wanni tokko iyyuu meetii irraa hin hojjetamne.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.20",
            "verseOrgIds": [
              "2CH.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootichis dooniiwwan daldalaa kanneen namoonni Huuraam oofan qaba ture. Isaanis waggaa sadii sadiitti yeroo tokko warqee, meetii fi ilka arbaa, qamalee fi jaldeessa fidanii ni dhufu ture.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.21",
            "verseOrgIds": [
              "2CH.9.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoon Mootichi badhaadhummaa fi ogummaadhaan mootota addunyaa hunda ni caala ture.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.22",
            "verseOrgIds": [
              "2CH.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootonni addunyaa hundi ogummaa Waaqni garaa isaa keessa kaaʼe dhagaʼuuf Solomoon bira dhufuu barbaadu ture.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.23",
            "verseOrgIds": [
              "2CH.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni waggaa waggaatti isa bira dhufu hundinuu kennaa miʼa meetii fi kan warqee, uffata, miʼa lolaa, urgooftuu, fardeenii fi gaangolii fidaafii ture.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.24",
            "verseOrgIds": [
              "2CH.9.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoon gola fardeenii fi gaariiwwanii kuma afur akkasumas fardeen kuma kudha lama kanneen magaalaawwan gaariiwwanii keessaa fi of bira Yerusaalem keessa kaaʼate qaba ture.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.25",
            "verseOrgIds": [
              "2CH.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis mootota Laga Efraaxiisiitii hamma biyya Filisxeemotaattii fi hamma daarii Gibxitti jiran hunda ni bulche.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.26",
            "verseOrgIds": [
              "2CH.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootichi akka meetiin Yerusaalem keessatti akkuma dhagaa baayʼatu, akka mukni birbirsaas akkuma mukkeen harbuu kanneen gaarran jalaatti baayʼatu ni godhe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.27",
            "verseOrgIds": [
              "2CH.9.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CH 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fardeen Solomoon Gibxii fi biyyoota biraa hunda irraa bitamanii dhufan.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.28",
            "verseOrgIds": [
              "2CH.9.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Solomoon Duʼuu Isaa",
          "type": "text"
        }
      ]
    },
