        "style": "s1"
      },
      "items": [
        {
          "text": "Aarsaa Cubbuu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "LEV.6.24",
                "verseOrgIds": [
                  "LEV.6.17"
                ]
              }
            }
          ]
        },
        {
          "text": "Museedhaan akkana jedhe;",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.24",
            "verseOrgIds": [
              "LEV.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Aroonii fi ilmaan isaatiin akkana jedhi: 'Seerri aarsaan cubbuu ittiin dhiʼeeffamu kanaa dha: Aarsaan cubbuu iddoo aarsaan gubamu itti qalamutti fuula",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.25",
            "verseOrgIds": [
              "LEV.6.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "LEV.6.25",
                "verseOrgIds": [
                  "LEV.6.18"
                ]
              }
            }
          ]
        },
        {
          "text": "duratti haa qalamu; aarsaan kun waan hunda caalaa qulqulluu dha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.25",
            "verseOrgIds": [
              "LEV.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lubni isa dhiʼeessu aarsaa kana haa nyaatu; kunis oobdii dunkaana wal gaʼii keessatti iddoo qulqulluutti nyaatamuu qaba.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.26",
            "verseOrgIds": [
              "LEV.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni foon sana tuqu kam iyyuu ni qulqullaaʼa; yoo dhiigni isaa tokko iyyuu uffatatti facaʼe uffata sana iddoo qulqulluutti miicuu qabda.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.27",
            "verseOrgIds": [
              "LEV.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 6:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okkoteen suphee kan foon sun itti affeelame haa cabsamu; yoo okkotee naasiitti affeelame garuu haqamee bishaaniin haa dhiqamu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.28",
            "verseOrgIds": [
              "LEV.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 6:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhiirri gosa lubootaa taʼe kam iyyuu foon kana nyaachuu ni dandaʼa; kun waan hunda caalaa qulqulluu dha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.29",
            "verseOrgIds": [
              "LEV.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 6:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu aarsaan cubbuu kan araara buusuudhaaf dhiigni isaa gara dunkaana wal gaʼii Iddoo Qulqulluutti fidamu kam iyyuu nyaatamuu hin qabu; inni gubamuu qaba.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.30",
            "verseOrgIds": [
              "LEV.6.23"
            ]
          }
        }
      ]
