    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ramadamuu lubootaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilmaan Aroon akka armaan gadiitti ramadaman:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.1",
            "verseOrgIds": [
              "1CH.24.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1CH 24:1"
      },
      "items": [
        {
          "text": "Ilmaan Aroon Naadaab, Abiihuu, Eleʼaazaarii fi Iitaamaar turan.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.1",
            "verseOrgIds": [
              "1CH.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naadaabii fi Abiihuu garuu utuu ijoollee hin dhalchin abbaa isaanii dursanii duʼan; kanaafuu Eleʼaazaarii fi Iitaamaar luboota taʼanii tajaajilan.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.2",
            "verseOrgIds": [
              "1CH.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daawitis gargaarsa Zaadoq sanyii Eleʼaazaar sanaatii fi Ahiimelek sanyii Iitaamaariin akkuma tajaajila isaaniitti garee gareen isaan ramade.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.3",
            "verseOrgIds": [
              "1CH.24.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sanyiiwwan Iitaamaarii caalaa sanyiiwwan Eleʼaazaar keessaa hooggantoonni hedduun ni argaman; isaanis akkanatti ramadaman: sanyiiwwan Eleʼaazaar keessaa abbootii maatii kudha jaʼa, sanyiiwwan Iitaamaar keessaa immoo abbootii maatii saddeet.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.4",
            "verseOrgIds": [
              "1CH.24.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan sababii sanyiiwwan Eleʼaazaarii fi sanyiiwwan Iitaamaar keessa qondaaltonni mana qulqullummaatii fi qondaaltonni Waaqaa turaniif loogii malee ixaadhaan isaan ramadan.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.5",
            "verseOrgIds": [
              "1CH.24.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shemaaʼiyaan ilmi Naatnaaʼel namicha gosa Lewwii barreessaan sun fuula mootichaatii fi qondaaltotaa duratti maqaa isaanii Zaadoq lubicha, Ahiimelek ilma Abiyaataar, abbootii maatiiwwan lubootaatii fi Lewwotaa, innis gosa Eleʼaazaar keessaa maatii tokko, gosa Iitaamaar keessaa immoo maatii tokko fuudhee barreesse.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.6",
            "verseOrgIds": [
              "1CH.24.6"
            ]
          }
        }
      ]
    },
