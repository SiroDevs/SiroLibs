    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daawit ajajjoota loltootaa wajjin akka isaan kiraaraan, baganaa fi kililleetti fayyadamanii raajii dubbataniif maatii Asaaf, Heemaanii fi Yeduutuun keessaa namoota addaan baafate. Maqaan namoota tajaajila kana kennaa turaniis:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.1",
            "verseOrgIds": [
              "1CH.25.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilmaan Asaaf keessaa:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.2",
            "verseOrgIds": [
              "1CH.25.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 25:2"
      },
      "items": [
        {
          "text": "Zakuur, Yoosef, Naataaniyaa fi Asareelaa. Ilmaan Asaaf qajeelcha Asaaf jala turan. Asaaf immoo qajeelcha mootichaa jalatti raajii dubbachaa ture.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.2",
            "verseOrgIds": [
              "1CH.25.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilmaan Yeduutuun keessaa:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.3",
            "verseOrgIds": [
              "1CH.25.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 25:3"
      },
      "items": [
        {
          "text": "Gedaaliyaas, Zerii, Isaayyaas, Sameeʼi, Hashabiyaa fi Matiitiyaa. Isaan kunneen jaʼan qajeelcha abbaa isaanii Yeduutuun isa kiraaraan",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.3",
            "verseOrgIds": [
              "1CH.25.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "1CH.25.3",
                "verseOrgIds": [
                  "1CH.25.3"
                ]
              }
            }
          ]
        },
        {
          "text": "galateeffachaa fi jajachaa raajii dubbachaa ture sanaa jala turan.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.3",
            "verseOrgIds": [
              "1CH.25.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilmaan Heemaan keessaa:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.4",
            "verseOrgIds": [
              "1CH.25.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 25:4"
      },
      "items": [
        {
          "text": "Bukiyaa, Mataaniyaa, Uziiʼeel, Shebuuʼeelii fi Yeriimooti; Hanaaniyaa, Hanaanii, Eliiʼaataa, Gidaltii fi Roomaamti-Ezer; Yoshibqaashaa, Malootii, Hootiirii fi Mahaaziyoo ti.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.4",
            "verseOrgIds": [
              "1CH.25.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan kunneen hundi ilmaan Heemaan namicha mootichaaf mulʼata argu sanaa turan. Isaan akka isa kabajaniif akkuma Waaqni abdachiise sanatti isaa ni kennaman. Waaqnis ilmaan kudha afurii fi intallan sadii Heemaaniif ni kenne.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.5",
            "verseOrgIds": [
              "1CH.25.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoonni kunneen hundi tajaajila mana Waaqaa keessatti faarfannaa kililleedhaan, kiraaraa fi baganaadhaan mana qulqullummaa",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.6",
            "verseOrgIds": [
              "1CH.25.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "1CH.25.6",
                "verseOrgIds": [
                  "1CH.25.6"
                ]
              }
            }
          ]
        },
        {
          "text": "keessatti faarfatamu sanaaf qajeelcha abbootii isaanii jala turan.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.6",
            "verseOrgIds": [
              "1CH.25.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1CH 25:6"
      },
      "items": [
        {
          "text": "Asaaf, Yeduutuunii fi Heemaan immoo qajeelcha mootichaa jala turan.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.6",
            "verseOrgIds": [
              "1CH.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanii fi firoonni isaanii kanneen hundi isaanii faarfannaa",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.7",
            "verseOrgIds": [
              "1CH.25.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoof",
              "type": "text",
              "attrs": {
                "verseId": "1CH.25.7",
                "verseOrgIds": [
                  "1CH.25.7"
                ]
              }
            }
          ]
        },
        {
          "text": "faarfatamuun leenjifamanii ogummaa qaban walumaa galatti 288 turan.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.7",
            "verseOrgIds": [
              "1CH.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jarris ramaddii isaanii beekuudhaaf xinnaa fi guddaan, barsiisaa fi barataan haaluma wal fakkaatuun ixaa buufatan.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.8",
            "verseOrgIds": [
              "1CH.25.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
