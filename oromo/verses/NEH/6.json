  "verseCount": 19,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "NEH 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mormiin Ijaarsaa Ittuma Fufe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NEH 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani hamma yeroo sanaatti cuftuu balbalaa itti galchuu baadhu illee Sanbalaax, Xoobbiyaan, Gesheem namicha Arabaa sanaa fi diinonni keenya biraan akka ani dallaa sana deebisee ijaaree iddoon hin ijaaramin tokko iyyuu hin hafin dhageenyaan",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.1",
            "verseOrgIds": [
              "NEH.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NEH 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sanbalaaxii fi Gesheem, \"Kottu mee gandoota dirree Oonoo irra jiran keessaa isa tokko keessatti wal arginaa\" jedhanii ergaa kana natti ergan.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.2",
            "verseOrgIds": [
              "NEH.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "NEH 6:2"
      },
      "items": [
        {
          "text": "Isaan garuu na miidhuuf malachaa turan;",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.2",
            "verseOrgIds": [
              "NEH.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NEH 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kanaafuu ani akkana jedhee ergamoota isaanittin erge; \"Ani waan hojii guddaa hojjechaa jiruuf gad buʼuu hin dandaʼu. Yeroo ani hojii dhiisee gara keessanitti gad buʼuutti hojiin maaliif dhaabata?\"",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.3",
            "verseOrgIds": [
              "NEH.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NEH 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan ergaadhuma tokko siʼa afur natti ergan; anis siʼa afranuu deebiidhuma tokkon kenneef.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.4",
            "verseOrgIds": [
              "NEH.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NEH 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sanbalaaxis ergaadhuma sana garbicha isaa tokkoon yeroo shanaffaa natti erge; garbichi sunis xalayaa hin cufamin tokko harkaa qaba ture.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.5",
            "verseOrgIds": [
              "NEH.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NEH 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Xalayichis akkana jedha:",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.6",
            "verseOrgIds": [
              "NEH.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "NEH 6:6"
      },
      "items": [
        {
          "text": "\"Akka atii fi Yihuudoonni finciluu barbaaddan uummata keessatti odeeffameera; Gesheemis kanuma mirkaneessa. Wanni isin dallaa ijaartaniifis kanuma; akka oduu kanaatti ati mootii isaanii taʼuu barbaadda;",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.6",
            "verseOrgIds": [
              "NEH.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NEH 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "ati akka isaan, 'Yihuudaa keessa mootii tokkotu jira!' jedhanii waaʼee kee Yerusaalem keessatti labsaniif raajota muudatteerta. Oduun kun gara mootichaatti ni deebiʼa; kanaafuu kottu wajjin ni mariʼannaa.\"",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.7",
            "verseOrgIds": [
              "NEH.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NEH 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana irratti ani, \"Wanni akka waan ati dubbattu kanaa tokko illee hin hojjetamne; ati matuma kee keessaa fuutee dubbattaa\" jedheen deebiseef.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.8",
            "verseOrgIds": [
              "NEH.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NEH 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan hundi, \"Harki jara kanaa hojii hojjechuu ni dadhaba; hojiin kunis hin dhumu\" jedhanii yaaduudhaan nu sodaachisuu yaalaa turan.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.9",
            "verseOrgIds": [
              "NEH.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "NEH 6:9"
      },
      "items": [
        {
          "text": "Ani garuu, \"Amma harka koo naa jajjabeessi\" jedheen Waaqa kadhadhe.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.9",
            "verseOrgIds": [
              "NEH.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NEH 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anis gaaf tokko mana Shemaaʼiyaa ilma Delaayaa, ilma Maheexabiʼeel kan manuma ofii isaa keessatti itti cufame sanaa nan dhaqe. Innis akkana jedhe; \"Sababii namoonni si ajjeesuuf dhufaa jiraniif, sababii isaan si ajjeesuuf halkaniin dhufaa jiraniif kottu mana Waaqaatti, mana qulqullummaa keessatti wal arginee balbalawwan mana qulqullummaa haa cufannu.\"",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.10",
            "verseOrgIds": [
              "NEH.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NEH 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani immoo, \"Namni akka kootii kun baqachuu qabaa? Yookaan namni na fakkaatu tokko lubbuu ofii isaa oolfachuudhaaf jedhee mana qulqullummaa seenuu qabaa? Ani hin deemu!\" jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.11",
            "verseOrgIds": [
              "NEH.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NEH 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani akka Waaqni isa natti hin ergin beekkadheera; inni garuu sababii Xoobbiyaa fi Sanbalaaxi isa bitataniif waaʼee koo waan hamaa raaje.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.12",
            "verseOrgIds": [
              "NEH.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NEH 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni na sodaachisee akka ani waan kana hojjechuudhaan cubbuu hojjedhuuf, akka isaanis akkasiin maqaa hamaa naa kennanii maqaa na balleessaniif bitame.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.13",
            "verseOrgIds": [
              "NEH.6.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NEH 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa Waaqa ko, sababii waan isaan hojjetan sanaaf jedhiitii Xoobbiyaa fi Sanbalaaxin yaadadhu; raajjuu Nooʼadiyaa jedhamtuu fi raajota na sodaachisuu yaalan kaanis yaadadhu.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.14",
            "verseOrgIds": [
              "NEH.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NEH 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkasiinis dallaan sun bultii shantamii lamatti, jiʼa Eeluuli jedhamu keessa bultii digdamii shanaffaatti ijaaramee dhume.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.15",
            "verseOrgIds": [
              "NEH.6.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ijaarsi Dallaa Xumuramuu Isaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NEH 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yommuu diinonni keenya hundi oduu kana dhagaʼanitti, saboonni naannoo keenyaa hundi sodaatanii abdii kutatan; isaan akka hojiin kun gargaarsa Waaqa keenyaan hojjetame hubataniiruutii.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.16",
            "verseOrgIds": [
              "NEH.6.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NEH 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bara sana keessa namoonni Yihuudaa bebeekamoon xalayoota hedduu gara Xoobbiyaatti ergaa turan; Xoobbiyaanis deebii isaaniif ni erga ture.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.17",
            "verseOrgIds": [
              "NEH.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NEH 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sababii inni soddaa Shekaaniyaa ilma Aaraa tureef namoonni Yihuudaa keessa jiraatan hedduun isaaf kakatan; akkasumas ilmi isaa Yehohaanaan intala Meshulaam ilma Berekiyaa fuudhee ture.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.18",
            "verseOrgIds": [
              "NEH.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NEH 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana malees isaan hojii isaa gaarii natti odeessaa, waan ani jedhe illee isatti himaa turan. Xoobbiyaan immoo na sodaachisuuf jedhee xalayoota natti ergaa ture.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.19",
            "verseOrgIds": [
              "NEH.6.19"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "NEH.7",
