              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa Waaqa koo ati isaan yaadadhu; isaan lubummaa, kakuu lubummaatii fi Lewwotaa xureessaniiruutii.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.29",
