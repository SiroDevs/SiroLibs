    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kadhannaa Nahimiyaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NEH 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dubbii Nahimiyaa ilma Hakaaliyaa:",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.1",
            "verseOrgIds": [
              "NEH.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "NEH 1:1"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "NEH 1:1"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "NEH 1:1"
      },
      "items": [
        {
          "text": "Waggaa digdammaffaatti jiʼa Kaaseluu jedhamu keessa utuu ani gamoo Suusaa keessa jiruu,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.1",
            "verseOrgIds": [
              "NEH.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NEH 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "obboloota koo keessaa Hanaaniin namoota biraa wajjin Yihuudaadhaa dhufe; anis waaʼee hambaa Yihuudoota boojuu jalaa baʼanii fi waaʼee Yerusaalem isaan nan gaafadhe.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.2",
            "verseOrgIds": [
              "NEH.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NEH 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis akkana naan jedhan; \"Warri boojuudhaa deebiʼanii kutaa biyyaa kana keessa jiraatan rakkinaa fi salphina guddaa keessa jiru. Dallaan Yerusaalem diigamee karraawwan ishees ibiddaan gubamaniiru.\"",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.3",
            "verseOrgIds": [
              "NEH.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NEH 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anis waan kana dhageenyaan gad taaʼee booʼee guyyoota muraasaaf nan gadde; soomees fuula Waaqa samii durattin kadhadhe.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.4",
            "verseOrgIds": [
              "NEH.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NEH 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkanas nan jedhe:",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.5",
            "verseOrgIds": [
              "NEH.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "NEH 1:5"
      },
      "items": [
        {
          "text": "\"Yaa",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.5",
            "verseOrgIds": [
              "NEH.1.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "NEH.1.5",
                "verseOrgIds": [
                  "NEH.1.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa samii, Waaqa guddichaa fi sodaachisaa, kan warra si jaallatanii ajaja kee eeganiif kakuu jaalala keetii eegdu,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.5",
            "verseOrgIds": [
              "NEH.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NEH 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "akka kadhannaa ani garbichi kee halkanii fi guyyaa fuula kee duratti waaʼee garboota kee saba Israaʼel kadhadhu dhageessuuf gurri kee haa banamu; iji kees haa ilaalu. Ani cubbuu nu Israaʼeloonni, ani mataan koo fi manni abbaa koo sitti hojjenne nan hima.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.6",
            "verseOrgIds": [
              "NEH.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NEH 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nu akka malee hammina sitti hojjenneerra. Nu ajaja, labsii fi seera ati garbicha kee Museetti kennite sana hin eegne.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.7",
            "verseOrgIds": [
              "NEH.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NEH 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Qajeelfama garbicha kee Museetti kennite sana yaadadhu; innis akkana jedha; 'Yoo isin amanamuu baattan ani saboota keessa isin nan bittinneessa;",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.8",
            "verseOrgIds": [
              "NEH.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NEH 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "garuu yoo isin gara kootti deebitanii ajaja koo eegdan, yoo namoonni keessan kanneen boojiʼaman daarii lafaa jiraatan illee ani achii walitti isaanin qabee gara iddoo ani akka Maqaan koo achi jiraatuuf filadhe sanaatti isaan nan fida.'",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.9",
            "verseOrgIds": [
              "NEH.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NEH 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Isaan garboota kee fi saba kee warra ati humna kee guddaa fi harka kee jabaa sanaan furtee dha.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.10",
            "verseOrgIds": [
              "NEH.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NEH 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa Gooftaa, gurri kee kadhannaa garbicha kee kanaa fi kadhannaa garboota kee warra maqaa kee sodaachuutti gammadanii sirriitti haa dhagaʼu. Fuula namicha kanaa duratti surraa isaaf kennuudhaan harʼa garbicha kee milkeessi.\"",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.11",
            "verseOrgIds": [
              "NEH.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "NEH 1:11"
      },
      "items": [
        {
          "text": "Ani nama mootichaaf daadhii buusun ture.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.11",
            "verseOrgIds": [
              "NEH.1.11"
            ]
          }
        }
      ]
    }
  ],
