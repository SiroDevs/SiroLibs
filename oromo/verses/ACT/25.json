  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "25",
        "style": "c",
        "sid": "ACT 25"
      },
      "items": [
        {
          "text": "25",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Phaawulos Fuula Fesxoos Duratti Qorame",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fesxoosis biyya sana gaʼee guyyaa sadii booddee Qiisaariyaadhaa Yerusaalemitti ol baʼe;",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.1",
            "verseOrgIds": [
              "ACT.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "achittis luboonni hangafoonnii fi dura buʼoonni Yihuudootaa fuula isaa duratti dhiʼaatanii himata Phaawulos irraa qaban dhiʼeeffatan.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.2",
            "verseOrgIds": [
              "ACT.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis waan karaatti riphanii Phaawulosin ajjeesuuf qophaaʼaa turaniif akka Fesxoos isaan deeggaree nama ergee gara Yerusaalem isa fichisiisu kadhatan.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.3",
            "verseOrgIds": [
              "ACT.25.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fesxoos immoo akkana jedhee deebise; \"Phaawulos Qiisaariyaatti eegamaa jira; ani mataan koo iyyuu dhiʼeenyatti achi nan dhaqa.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.4",
            "verseOrgIds": [
              "ACT.25.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu abbootii taayitaa keessan keessaa tokko tokko na wajjin deemanii yoo namichi sun balleessaa wayii qabaate achitti isa haa himatan.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.5",
            "verseOrgIds": [
              "ACT.25.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis erga guyyaa saddeeti yookaan kudhan isaan bira bubbulee booddee Qiisaariyaatti gad buʼe; guyyaa itti aanuttis barcuma murtii irra taaʼee akka Phaawulos fuula isaa duratti dhiʼeeffamu ajaje.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.6",
            "verseOrgIds": [
              "ACT.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yommuu Phaawulos dhiʼaatettis Yihuudoonni Yerusaalemii gad buʼan sun isatti naannaʼanii dhaabachuun himata ciccimaa hedduu isa irratti dhiʼeessan; garuu amansiisuu hin dandeenye.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.7",
            "verseOrgIds": [
              "ACT.25.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phaawulosis, \"Ani seera Yihuudootaa irratti yookaan mana qulqullummaa irratti yookaan Qeesaar irratti yakka tokko illee hin hojjenne\" jedhee falmate.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.8",
            "verseOrgIds": [
              "ACT.25.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fesxoosis Yihuudoota gammachiisuuf jedhee Phaawulosiin, \"Ati Yerusaalemitti ol baatee himata kana irratti fuula koo duratti qoratamuu ni feetaa?\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.9",
            "verseOrgIds": [
              "ACT.25.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phaawulos garuu akkana jedhee deebise; \"Ani amma barcuma murtii Qeesaar dura, iddoo itti qoratamuu qabu dhaabadheen jira; akkuma ati mataan kee iyyuu sirriitti beektu ani yakka tokko illee Yihuudoota irratti hin hojjenne.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.10",
            "verseOrgIds": [
              "ACT.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taʼus ani utuu balleessaa duʼa natti mursiisu tokko illee hojjedhee silaa duʼa jalaa baʼuuf hin carraaqu; garuu yoo wanni Yihuudoonni kunneen ittiin na himatan dhugaa hin taʼin, namni tokko iyyuu dabarsee harka isaaniitti na kennuuf mirga hin qabu. Ani Qeesaaritti oli nan iyyadha!\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.11",
            "verseOrgIds": [
              "ACT.25.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fesxoosis erga gorsitoota isaa wajjin mariʼatee booddee, \"Ati Qeesaaritti ol iyyatteerta; gara Qeesaar ni dhaqxa!\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.12",
            "verseOrgIds": [
              "ACT.25.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Fesxoos Gorsa Agriiphaa Gaafate",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bultii muraasa booddee Agriiphaa mootichii fi Barniiqeen",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.13",
            "verseOrgIds": [
              "ACT.25.13"
            ]
          }
        },
        {
          "text": "Fesxoos simachuuf Qiisaariyaa dhaqan.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.13",
            "verseOrgIds": [
              "ACT.25.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fesxoosis isaan guyyaa hedduu achi bubbullaan akkana jedhee waaʼee himata Phaawulos mooticha wajjin dubbate; \"Namichi Feeliksi mana hidhaa keessatti dhiisee deeme tokko as jira.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.14",
            "verseOrgIds": [
              "ACT.25.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo ani Yerusaalem turetti luboonni hangafoonnii fi maanguddoonni Yihuudootaa isa himatanii akka itti muramu kadhatan.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.15",
            "verseOrgIds": [
              "ACT.25.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Anis akka namni kam iyyuu akka seera biyya Roomaatti utuu fuula himattoota isaa duratti dhiʼaatee himata sana mormachuuf carraa hin argatin dabarfamee kennamuu hin qabne isaanitti himeera.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.16",
            "verseOrgIds": [
              "ACT.25.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu ani yommuu isaan na wajjin as dhufanitti barcuma murtii irra taaʼeen akka namicha natti fidan ajaje malee dubbii sana lafa irra hin harkifne.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.17",
            "verseOrgIds": [
              "ACT.25.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Himattoonni isaas yommuu dubbachuuf kaʼanitti yakka ani ittiin isa himatu jedhee eege keessaa tokko illee isa irratti hin dhiʼeessine.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.18",
            "verseOrgIds": [
              "ACT.25.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu isaan waaʼee amantaa isaaniitii fi waaʼee namicha duʼe kan Yesuus jedhamu isa Phaawulos immoo, 'Inni jiraataa dha' jedhee falmuu tokkoo irratti wal dhaban.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.19",
            "verseOrgIds": [
              "ACT.25.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 25:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anis akka itti dubbii sana qoradhu wallaale; kanaaf inni Yerusaalem dhaqee himata kana irratti qoratamuuf fedhii qabuu fi akka inni hin qabne isa gaafadhe.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.20",
            "verseOrgIds": [
              "ACT.25.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 25:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu yommuu Phaawulos murtii Awugisxoos Qeesaar argachuuf jedhee turfamuu kadhatetti ani akka inni hamma ani Qeesaaritti isa ergutti eegamu nan ajaje.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.21",
            "verseOrgIds": [
              "ACT.25.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 25:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agriiphaanis Fesxoosiin, \"Ani mataan koo namicha kana dhagaʼuu nan barbaada\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.22",
            "verseOrgIds": [
              "ACT.25.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ACT 25:22"
      },
      "items": [
        {
          "text": "Inni immoo deebisee, \"Bori isa dhageessa\" jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.22",
            "verseOrgIds": [
              "ACT.25.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Phaawulos Fuula Agriiphaa Duratti",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "ACT.26.12-ACT.26.18"
          },
          "items": [
            {
              "text": "26:12‑18",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwf –",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "xt"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "id": "ACT.9.3-ACT.9.8"
              },
              "items": [
                {
                  "text": "Hoj 9:3‑8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ";",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "id": "ACT.22.6-ACT.22.11"
              },
              "items": [
                {
                  "text": "22:6‑11",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 25:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyyaa itti aanuttis Agriiphaa fi Barniiqeen ulfina guddaan dhufanii Ajajjuuwwan kumaatii fi gurguddoota magaalaa wajjin galma wal gaʼii seenan. Fesxoos ajajnaan Phaawulosin ol galchan.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.23",
            "verseOrgIds": [
              "ACT.25.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 25:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fesxoosis akkana jedhe; \"Yaa Agriiphaa mooticha, warri nu wajjin as jirtan hundinuus isin namicha kana ni argitu! Hawaasni Yihuudootaa guutummaatti, 'Namichi kun siʼachi jiraachuu hin qabu' jedhanii waaʼee isaa Yerusaalemittii fi as Qiisaariyaatti iyyanii na kadhatan.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.24",
            "verseOrgIds": [
              "ACT.25.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 25:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani waan duʼaan isa gaʼu kan inni hojjete tokko illee hin argine; ani garuu sababii inni Awugisxoositti ol iyyateef gara Roomaatti isa erguu nan murteesse.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.25",
            "verseOrgIds": [
              "ACT.25.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 25:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani waaʼee namicha kanaa waan ifatti baʼe kan gooftaa kootiif barreessu tokko illee hin qabu; kanaafuu ani erga isa qorannee booddee akka waan barreessu argadhuuf jedhee fuula hunda keessanii duratti, keessumattuu yaa Agriiphaa mooticha, fuula kee duratti isa dhiʼeesseera.",
          "type": "text",
