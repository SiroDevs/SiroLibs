  "verseCount": 34,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "17",
        "style": "c",
        "sid": "ACT 17"
      },
      "items": [
        {
          "text": "17",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Phaawulosii fi Siilaas Tasaloniiqee Keessatti",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis Amfiipholiisii fi Apholooniyaa keessa darbanii Tasaloniiqee iddoo manni sagadaa Yihuudootaa ture dhufan.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.1",
            "verseOrgIds": [
              "ACT.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phaawulosis akkuma amala isaa mana sagadaa seenee guyyaa Sanbataa sadii dubbii kitaabaa irratti isaan wajjin dudubbachaa,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.2",
            "verseOrgIds": [
              "ACT.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "akka Kiristoos",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.3",
            "verseOrgIds": [
              "ACT.17.3"
            ]
          }
        },
        {
          "text": "dhiphachuu fi warra duʼan keessaa kaʼuu qabu addeessaa, mirkaneessaas ture. Innis, \"Yesuus ani amma isinitti himu kun Kiristoosii dha\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.3",
            "verseOrgIds": [
              "ACT.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yihuudoota keessaa tokko tokko, Giriikota Waaqa sodaatan keessaas namoonni akka malee baayʼatanii fi dubartoonni bebeekamoon hedduun amananii Phaawulosii fi Siilaasitti dabalaman.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.4",
            "verseOrgIds": [
              "ACT.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yihuudoonni garuu hinaaffaan guutaman; isaanis iddoo gabaatii kashlabboota tokko tokko walitti qabatanii, uummatas kakaasanii magaalaa keessatti goolii uuman; Phaawulosii fi Siilaasinis fuula uummataa duratti dhiʼeessuuf jedhanii isaan barbaacha mana Yaasonitti fiigan.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.5",
            "verseOrgIds": [
              "ACT.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yommuu jara dhabanitti immoo Yaasonii fi obboloota tokko tokko harkisaa fuula qondaaltota magaalaa duratti dhiʼeessanii akkana jedhanii iyyan; \"Namoonni addunyaa hunda rakkisaa turan kunneen amma kunoo as dhufaniiru;",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.6",
            "verseOrgIds": [
              "ACT.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaasonis mana isaatti isaan simateera. Hundi isaaniis, 'Mootiin biraa kan Yesuus jedhamu tokko jira' jedhanii labsii Qeesaariin mormu.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.7",
            "verseOrgIds": [
              "ACT.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uummannii fi qondaaltonni magaalaa sanaas yommuu waan kana dhagaʼanitti ni raafaman.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.8",
            "verseOrgIds": [
              "ACT.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis Yaasonii fi warra kaan irraa qabsiisa fuudhanii gad isaan dhiisan.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.9",
            "verseOrgIds": [
              "ACT.17.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Phaawulosii fi Siilaas Beeriyaa Keessatti",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obboloonnis yeruma sana Phaawulosii fi Siilaasin halkaniin Beeriyaatti ergan; isaanis yommuu achi gaʼanitti mana sagadaa Yihuudootaa seenan.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.10",
            "verseOrgIds": [
              "ACT.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yihuudoonni Beeriyaa Yihuudoota Tasaloniiqee irra qalbii qabeeyyii turan; isaanis fedhii guddaan dubbii sana fudhatanii akka wanni Phaawulos jedhe sun dhugaa taʼee fi akka dhugaa hin taʼin ilaaluuf jedhanii guyyuma guyyaan Katabbiiwwan Qulqulluu qorachaa turaniitii.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.11",
            "verseOrgIds": [
              "ACT.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaaf Yihuudoota keessaa baayʼeen ni amanan; akkasumas dubartoonni Giriik beekamoon hedduunii fi dhiironni Giriik hedduun ni amanan.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.12",
            "verseOrgIds": [
              "ACT.17.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yihuudoonni Tasaloniiqee yommuu akka Phaawulos Beeriyaa keessattis dubbii Waaqaa lallabaa ture dhagaʼanitti achis dhaqanii rakkoo uumanii uummata kakaasan.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.13",
            "verseOrgIds": [
              "ACT.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obboloonni immoo yommusuma Phaawulosin gara qarqara galaanaatti ergan; Siilaasii fi Xiimotewos garuu Beeriyaatti hafan.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.14",
            "verseOrgIds": [
              "ACT.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoonni Phaawulosin geggeessanis Ateenaan isa gaʼanii akka Siilaasii fi Xiimotewos hamma isaanii dandaʼametti dafanii Phaawulos bira dhaqaniif ajaja fuudhaniifii deebiʼan.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.15",
            "verseOrgIds": [
              "ACT.17.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Phaawulosii fi Siilaas Ateenaa Keessatti",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phaawulos utuu Ateenaa keessatti isaan eegaa jiruu akka magaalaan sun waaqota tolfamoodhaan guutamte argee akka malee gadde.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.16",
            "verseOrgIds": [
              "ACT.17.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaaf mana sagadaa keessatti Yihuudootaa fi Giriikota Waaqa sodaatan wajjin, iddoo gabaatti immoo guyyuma guyyaan warra achitti argaman wajjin falmaa ture.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.17",
            "verseOrgIds": [
              "ACT.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gareen falaasamtoota Efiiqoroosiitii",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.18",
            "verseOrgIds": [
              "ACT.17.18"
            ]
          }
        },
        {
          "text": "fi Istoʼiki",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.18",
            "verseOrgIds": [
              "ACT.17.18"
            ]
          }
        },
        {
          "text": "tokkos isaan falmaa ture; isaan keessaa tokko tokko, \"Namichi legellegaan kun maal jedha?\" jedhan. Warri kaan immoo, \"Inni waaʼee waaqota ormaa labsa fakkaata\" jedhan. Phaawulos waaʼee Yesuusii fi waaʼee duʼaa kaʼuu lallabaa tureetii.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.18",
            "verseOrgIds": [
              "ACT.17.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis isa qabanii gara wal gaʼii Ariyoosphaagositti geessan; achittis akkana jedhaniin; \"Barsiisni haaraan ati fidde kun maal akka taʼe beekuu dandeenyaa?",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.19",
            "verseOrgIds": [
              "ACT.17.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 17:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati waan nu takkumaa hin dhagaʼin nutti himaa jirta; kanaaf nu akka wanni kun maal jechuu taʼe beekuu feena.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.20",
            "verseOrgIds": [
              "ACT.17.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 17:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Warri Ateenaa hundii fi namoonni biyya ormaa kanneen achi jiraatan yeroo isaanii waan haaraa dhagaʼuu fi odeessuu irratti malee waan biraa irratti hin balleessan ture.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.21",
            "verseOrgIds": [
              "ACT.17.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 17:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phaawulosis wal gaʼii Ariyoosphaagos walakkaa dhaabatee akkana jedhe; \"Yaa namoota Ateenaa! Ani akka isin karaa hundaanuu warra amantaa taatan nan hubadha.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.22",
            "verseOrgIds": [
              "ACT.17.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 17:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani yommuun nanaannaʼee waan isin waaqeffattan ilaaletti iddoo aarsaa kan katabbii,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.23",
            "verseOrgIds": [
              "ACT.17.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pc",
        "vid": "ACT 17:23"
      },
      "items": [
        {
          "text": "Waaqa hin Beekamneef,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.23",
            "verseOrgIds": [
              "ACT.17.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m",
        "vid": "ACT 17:23"
      },
      "items": [
        {
          "text": "jedhu of irraa qabu argeeraatii. Egaa amma waan isin utuu hin beekin waaqeffattan kana isinittin hima.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.23",
            "verseOrgIds": [
              "ACT.17.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 17:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Waaqni addunyaa fi waan ishee keessa jiru hunda uume sun Gooftaa samiitii fi lafaa ti; inni mana qulqullummaa kan harka namaatiin hojjetame keessa hin jiraatu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.24",
            "verseOrgIds": [
              "ACT.17.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 17:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni mataan isaa sababii jireenya hafuura baafatamuu fi waan biraa hunda nama hundaaf kennuuf akka waan waa dhabeetti harka namaatiin hin tajaajilamu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.25",
            "verseOrgIds": [
              "ACT.17.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 17:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni saboota hunda nama tokko irraa uumee akka isaan lafa hunda irra jiraatan godhe; bara jireenyaa kan isaanii kennamee fi daarii lafa isaan jiraatanii murteesse.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.26",
            "verseOrgIds": [
              "ACT.17.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 17:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqni yoo tokkoo tokkoo keenya irraa fagoo jiraachuu baate iyyuu akka namoonni isa barbaadanii, tarii carraaqaniis isa argataniif jedhee waan kana godhe.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.27",
            "verseOrgIds": [
              "ACT.17.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 17:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkuma beektonni keessan tokko tokko, 'Nu ilmaan isaa ti' jedhan sana 'Nu isa keessa jiraanna; isa keessa sochoona; eenyummaa keenya illee isa keessatti qabaannaatii.'",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.28",
            "verseOrgIds": [
              "ACT.17.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 17:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kanaafuu nu waan ilmaan Waaqaa taaneef Waaqni waan akka warqee yookaan meetii yookaan dhagaa jechuunis waan ogummaa fi beekumsa namaatiin hojjetame fakkaata jennee yaaduu hin qabnu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.29",
            "verseOrgIds": [
              "ACT.17.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 17:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqni bara wallaalummaa durii hin ilaalu ture; amma garuu akka namni iddoo hunda jiru hundi qalbii jijjiirratu ajaja.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.30",
            "verseOrgIds": [
              "ACT.17.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 17:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis guyyaa itti harka namicha filate sanaatiin qajeelummaadhaan addunyaatti muru murteesseeraatii; kanas warra duʼan keessaa isa kaasuun nama hundumaaf mirkaneesseera.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.31",
            "verseOrgIds": [
              "ACT.17.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 17:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan keessaa namoonni tokko tokko yommuu waaʼee duʼaa kaʼuu warra duʼanii dhagaʼanitti ni qoosan; warri kaan immoo, \"Nu ammas dubbii kana sirraa dhagaʼuu barbaanna\" jedhan.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.32",
            "verseOrgIds": [
              "ACT.17.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ACT 17:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana irratti Phaawulos isaan keessaa baʼee deeme.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.33",
            "verseOrgIds": [
              "ACT.17.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 17:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoonni tokko tokko garuu gama Phaawulos goranii amanan; isaan keessaas namichi Diiyonaasiyoos jedhamu kan miseensa Ariyoosphaagos ture tokko, dubartiin Damaariis jedhamtuu fi namoonni biraas isaan wajjin turan.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.34",
            "verseOrgIds": [
              "ACT.17.34"
            ]
          }
        }
      ]
    }
