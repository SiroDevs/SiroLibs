          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Beetʼeel dhaqaatii cubbuu hojjedhaa;",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.4",
            "verseOrgIds": [
              "AMO.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:4"
      },
      "items": [
        {
          "text": "Gilgaal dhaqaatii cubbuu baayʼee hojjedhaa.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.4",
            "verseOrgIds": [
              "AMO.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 4:4"
      },
      "items": [
        {
          "text": "Ganama ganama aarsaa keessan dhiʼeessaa;",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.4",
            "verseOrgIds": [
              "AMO.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:4"
      },
      "items": [
        {
          "text": "waggaa sadii sadiitti immoo kennaa keessan harka kudhan keessaa",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.4",
            "verseOrgIds": [
              "AMO.4.4"
            ]
          }
        },
        {
          "name": "optbreak",
          "type": "tag",
          "attrs": {},
          "items": []
        },
        {
          "text": "harka tokko fidaa.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.4",
            "verseOrgIds": [
              "AMO.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
