            "style": "v",
            "sid": "AMO 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isin tokko tokkoon qajeeltanii",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.3",
            "verseOrgIds": [
              "AMO.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 4:3"
      },
      "items": [
        {
          "text": "qaawwa dallaatiin ni baatu;",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.3",
            "verseOrgIds": [
              "AMO.4.3"
            ]
          }
        }
      ]
    },
    {
