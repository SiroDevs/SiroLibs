              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uummanni bishaan barbaacha magaalaadhaa gara magaalaatti joore;",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.8",
            "verseOrgIds": [
              "AMO.4.8"
            ]
          }
        }
