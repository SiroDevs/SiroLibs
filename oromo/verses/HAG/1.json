        },
        {
          "text": "Ijaaruuf Godhame",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HAG 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bara bulchiinsa Daariyoos Mootichaa keessaa waggaa lammaffaatti, guyyaa tokkoffaa jiʼa jaʼaffaatti, dubbiin",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.1",
            "verseOrgIds": [
              "HAG.1.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "HAG.1.1",
                "verseOrgIds": [
                  "HAG.1.1"
                ]
              }
            }
          ]
        },
        {
          "text": "karaa Haagee Raajichaatiin gara ilma Sheʼaltiiʼeel gara Zarubaabel bulchaa Yihuudaatii fi gara Iyyaasuu ilma Yehoozaadaaq lubicha ol aanaa akkana jedhee dhufe:",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.1",
            "verseOrgIds": [
              "HAG.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HAG 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "HAG.1.2",
                "verseOrgIds": [
                  "HAG.1.2"
                ]
              }
            }
          ]
        },
        {
          "text": "Waan Hunda Dandaʼu akkana jedha: \"Sabni kun, 'Yeroon itti manni",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.2",
            "verseOrgIds": [
              "HAG.1.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "HAG.1.2",
                "verseOrgIds": [
                  "HAG.1.2"
                ]
              }
            }
          ]
        },
        {
          "text": "ijaaramu amma illee hin geenye' jedha.\"",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.2",
            "verseOrgIds": [
              "HAG.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HAG 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasii dubbiin",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.3",
            "verseOrgIds": [
              "HAG.1.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "HAG.1.3",
                "verseOrgIds": [
                  "HAG.1.3"
                ]
              }
            }
          ]
        },
        {
          "text": "karaa Haagee Raajichaatiin akkana jedhee dhufe:",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.3",
            "verseOrgIds": [
              "HAG.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HAG 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Yeroon kun yeroo isin utuu manni kun diigamee jiruu manneen keessan kanneen miidhagfaman keessa jiraattaniidhaa?\"",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.4",
            "verseOrgIds": [
              "HAG.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HAG 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammas",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.5",
            "verseOrgIds": [
              "HAG.1.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "HAG.1.5",
                "verseOrgIds": [
                  "HAG.1.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Waan Hunda Dandaʼu akkana jedha: \"Yaada keessan karaa keessan irra kaaʼadhaa.",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.5",
            "verseOrgIds": [
              "HAG.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HAG 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isin sanyii baayʼee facaafattanii waan xinnoo haammattaniirtu. Isin ni nyaattu; garuu hin quuftan. Ni dhugdu; garuu dheebuu hin baatan. Wayyaa ni uffattu; garuu isinitti hin hoʼu. Namni mindaa fudhatu akkuma nama mindaa isaa korojoo tarsaʼaa keessa kaaʼatuu ti.\"",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.6",
            "verseOrgIds": [
              "HAG.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HAG 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "HAG.1.7",
                "verseOrgIds": [
                  "HAG.1.7"
                ]
              }
            }
          ]
        },
        {
          "text": "Waan Hunda Dandaʼu akkana jedha: \"Karaa keessan hubadhaa.",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.7",
            "verseOrgIds": [
              "HAG.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HAG 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tulluutti ol baʼaa; muka fidaa; manicha ijaaraa; anis isatti nan gammada; nan kabajamas\" jedha",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.8",
            "verseOrgIds": [
              "HAG.1.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "HAG.1.8",
                "verseOrgIds": [
                  "HAG.1.8"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.8",
            "verseOrgIds": [
              "HAG.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HAG 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Isin waan baayʼee abdattan; garuu ni xinnaate. Isin manatti galfattan ani immoo nan afuufe. Kun maaliif taʼee?\" jedha",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.9",
            "verseOrgIds": [
              "HAG.1.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "HAG.1.9",
                "verseOrgIds": [
                  "HAG.1.9"
                ]
              }
            }
          ]
        },
        {
          "text": "Waan Hunda Dandaʼu. \"Kun sababii utuu manni koo diigamee jiruu tokkoon tokkoon keessan gara mana keessaniitti fiigdaniif.",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.9",
            "verseOrgIds": [
              "HAG.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HAG 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu sababii keessaniif samiiwwan fixeensa isaanii dhowwatan; laftis midhaan ishee dhowwatte.",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.10",
            "verseOrgIds": [
              "HAG.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HAG 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anis lafa qotiisaa fi tulluuwwaniitti, midhaanii fi daadhii wayinii haaraatti, zayitii fi waan lafti kennitu hundatti, namaa fi loonitti, hojii dadhabbii harka keessaniittis hongee waameera.\"",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.11",
            "verseOrgIds": [
              "HAG.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HAG 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zarubaabel ilmi Sheʼaltiiʼeel, Iyyaasuun ilmi Yehoozaadaaq lubichi ol aanaanii fi hambaawwan uummataa hundi sagalee",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.12",
            "verseOrgIds": [
              "HAG.1.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "HAG.1.12",
                "verseOrgIds": [
                  "HAG.1.12"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa isaaniitii fi ergaa Haagee raajichaatiif ajajaman;",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.12",
            "verseOrgIds": [
              "HAG.1.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "HAG.1.12",
                "verseOrgIds": [
                  "HAG.1.12"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni isaanii isa ergeeraatii. Uummannis",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.12",
            "verseOrgIds": [
              "HAG.1.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text",
              "attrs": {
                "verseId": "HAG.1.12",
                "verseOrgIds": [
                  "HAG.1.12"
                ]
              }
            }
          ]
        },
        {
          "text": "sodaate.",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.12",
            "verseOrgIds": [
              "HAG.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HAG 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasii Haageen ergamaan",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.13",
            "verseOrgIds": [
              "HAG.1.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "HAG.1.13",
                "verseOrgIds": [
                  "HAG.1.13"
                ]
              }
            }
          ]
        },
        {
          "text": "sun akkana jedhee ergaa",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.13",
            "verseOrgIds": [
              "HAG.1.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "HAG.1.13",
                "verseOrgIds": [
                  "HAG.1.13"
                ]
              }
            }
          ]
        },
        {
          "text": "kana sabatti hime: \"Ani isin wajjinan jira\" jedha",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.13",
            "verseOrgIds": [
              "HAG.1.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "HAG.1.13",
                "verseOrgIds": [
                  "HAG.1.13"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.13",
            "verseOrgIds": [
              "HAG.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HAG 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkasiin",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.14",
            "verseOrgIds": [
              "HAG.1.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "HAG.1.14",
                "verseOrgIds": [
                  "HAG.1.14"
                ]
              }
            }
          ]
        },
        {
          "text": "hafuura Zarubaabel ilma Sheʼaltiiʼeel bulchaa Yihuudaa, hafuura Iyyaasuu ilma Yehoozaadaaq lubicha ol aanaatii fi hafuura hambaa uummata hundaa kakaase. Isaanis dhufanii mana",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.14",
            "verseOrgIds": [
              "HAG.1.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "HAG.1.14",
                "verseOrgIds": [
                  "HAG.1.14"
                ]
              }
            }
          ]
        },
        {
          "text": "Waan Hunda Dandaʼuu, mana Waaqa isaanii ijaaruu jalqaban;",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.14",
            "verseOrgIds": [
              "HAG.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HAG 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "kunis bara Daariyoos mootichaa keessaa waggaa lammaffaatti, bultii digdamii afuraffaa jiʼa jaʼaffaatti taʼe.",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.15",
            "verseOrgIds": [
              "HAG.1.15"
            ]
          }
        }
      ]
    }
