    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ani utuu gadameessa keessatti si hin uumin dura si beeke;",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.5",
            "verseOrgIds": [
              "JER.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 1:5"
      },
      "items": [
        {
          "text": "utuu ati hin dhalatin dura addaan si baafadhe;",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.5",
            "verseOrgIds": [
              "JER.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 1:5"
      },
      "items": [
        {
          "text": "akka ati sabootaaf raajii taatuufis si muude.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.5",
            "verseOrgIds": [
              "JER.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anis, \"Wayyoo, yaa",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.6",
            "verseOrgIds": [
              "JER.1.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JER.1.6",
                "verseOrgIds": [
                  "JER.1.6"
                ]
              }
            }
          ]
        },
        {
          "text": "Gooftaa ani akkamitti akkan dubbadhu hin beeku; ani mucaa xinnoo dha\" nan jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.6",
            "verseOrgIds": [
              "JER.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JER.1.7",
                "verseOrgIds": [
                  "JER.1.7"
                ]
              }
            }
          ]
        },
        {
          "text": "garuu akkana naan jedhe; \"Ati, 'Ani mucaa xinnoo dha' hin jedhin. Ati gara nama ani itti si ergu hundaa dhaqxee waan ani si ajaju hunda dubbachuu qabda.",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.7",
            "verseOrgIds": [
              "JER.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati jara hin sodaatin; ani si baasuuf si wajjinan jiraatii\" jedha",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.8",
            "verseOrgIds": [
              "JER.1.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JER.1.8",
                "verseOrgIds": [
                  "JER.1.8"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.8",
            "verseOrgIds": [
              "JER.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasiis",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.9",
            "verseOrgIds": [
              "JER.1.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JER.1.9",
                "verseOrgIds": [
                  "JER.1.9"
                ]
              }
            }
          ]
        },
        {
          "text": "harka isaa hiixatee afaan koo tuqee akkana naan jedhe; \"Kunoo, ani dubbii koo afaan kee keessa kaaʼeera.",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.9",
            "verseOrgIds": [
              "JER.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaa, ani akka ati buqqiftuu fi diigduuf, akka barbadeessituu fi garagalchituuf, akka ijaartuu fi dhaabduuf harʼa sabootaa fi mootummoota irratti si muudeera.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.10",
            "verseOrgIds": [
              "JER.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dubbiin",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.11",
            "verseOrgIds": [
              "JER.1.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "JER.1.11",
                "verseOrgIds": [
                  "JER.1.11"
                ]
              }
            }
          ]
        },
        {
          "text": "gara koo dhufee, \"Ermiyaas, ati maal argaa jirta?\" naan jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.11",
            "verseOrgIds": [
              "JER.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JER 1:11"
      },
      "items": [
        {
          "text": "Anis deebisee, \"Damee muka lawuzii arguuttin jira\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.11",
            "verseOrgIds": [
              "JER.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JER.1.12",
                "verseOrgIds": [
                  "JER.1.12"
                ]
              }
            }
          ]
        },
        {
          "text": "immoo, \"Ati sirriitti argite; ani akka dubbiin koo fiixaan baʼuuf kutadhee kaʼeeraatii\" naan jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.12",
            "verseOrgIds": [
              "JER.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dubbiin",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.13",
            "verseOrgIds": [
              "JER.1.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "JER.1.13",
                "verseOrgIds": [
                  "JER.1.13"
                ]
              }
            }
          ]
        },
        {
          "text": "amma illee gara koo dhufee, \"Ati maal argaa jirta?\" naan jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.13",
            "verseOrgIds": [
              "JER.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JER 1:13"
      },
      "items": [
        {
          "text": "Anis deebisee, \"Xuwwee danfaa jiru kan kaaba irraa as garagalee jiru tokko nan arga\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.13",
            "verseOrgIds": [
              "JER.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JER.1.14",
                "verseOrgIds": [
                  "JER.1.14"
                ]
              }
            }
          ]
        },
        {
          "text": "akkana naan jedhe; \"Gara kaabaatii balaan warra biyyattii keessa jiraatan hundatti ni buʼa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.14",
            "verseOrgIds": [
              "JER.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunoo saboota mootummoota kaabaa hunda walitti nan waama\" jedha",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.15",
            "verseOrgIds": [
              "JER.1.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JER.1.15",
                "verseOrgIds": [
                  "JER.1.15"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.15",
            "verseOrgIds": [
              "JER.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 1:15"
      },
      "items": [
        {
          "text": "\"Mootonni isaanii dhufanii karrawwan Yerusaalem dura",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.15",
            "verseOrgIds": [
              "JER.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 1:15"
      },
      "items": [
        {
          "text": "teessoowwan isaanii ni dhaabbatu;",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.15",
            "verseOrgIds": [
              "JER.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 1:15"
      },
      "items": [
        {
          "text": "isaan dallaawwan naannoo ishee",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.15",
            "verseOrgIds": [
              "JER.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 1:15"
      },
      "items": [
        {
          "text": "hundaa fi magaalaawwan Yihuudaa hunda marsu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.15",
            "verseOrgIds": [
              "JER.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sababii isaan na dhiisanii",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.16",
            "verseOrgIds": [
              "JER.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
