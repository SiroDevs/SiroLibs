                  "JER.33.17"
                ]
              }
            }
          ]
        },
        {
          "text": "akkana jedhaatii: 'Daawit gonkumaa nama teessoo mana Israaʼel irra taaʼu hin dhabu;",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.17",
            "verseOrgIds": [
              "JER.33.17"
            ]
          }
        },
