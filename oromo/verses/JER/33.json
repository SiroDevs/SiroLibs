                "verseOrgIds": [
                  "JER.33.19"
                ]
              }
            }
          ]
        },
        {
          "text": "akkana jedhee gara Ermiyaas dhufe:",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.19",
            "verseOrgIds": [
              "JER.33.19"
            ]
          }
        },
