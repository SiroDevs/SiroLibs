          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.20",
            "verseOrgIds": [
              "JER.33.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JER.33.20",
                "verseOrgIds": [
                  "JER.33.20"
                ]
              }
            }
          ]
        },
        {
          "text": "akkana jedha; 'Yoo isin akka halkanii fi guyyaan yeroo isaanii kennametti hin dhufneef kakuu ani halkan wajjin galee fi kakuu ani guyyaa wajjin gale sana cabsuu dandeessan,",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.20",
            "verseOrgIds": [
              "JER.33.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 33:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "kakuun ani garbicha koo Daawit wajjin galee fi kakuun ani Lewwota luboota taʼanii fuula koo dura tajaajilan wajjin gale sun cabuu dandaʼa; Daawitis siʼachi sanyii teessoo isaa irra taaʼee bulchu hin qabaatu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.21",
            "verseOrgIds": [
              "JER.33.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 33:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani sanyii garbicha koo Daawitii fi Lewwota fuula koo dura tajaajilan akkuma urjiiwwan samiitii fi akkuma cirracha qarqara galaanaa kan madaalamuu hin dandeenyee nan baayʼisa.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.22",
            "verseOrgIds": [
              "JER.33.22"
            ]
          }
        }
      ]
    },
