          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ati akka uummanni kun, '",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.24",
            "verseOrgIds": [
              "JER.33.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JER.33.24",
                "verseOrgIds": [
                  "JER.33.24"
                ]
              }
            }
          ]
        },
        {
          "text": "mootummoota filatee ture lamaan gateera' jechaa jiru hin qalbeeffannee? Kanaafuu isaan saba koo tuffataniiru; siʼachis akka saba tokkootti isa hin ilaalan.",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.24",
            "verseOrgIds": [
              "JER.33.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
