              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JER.33.25",
                "verseOrgIds": [
                  "JER.33.25"
                ]
              }
            }
          ]
        },
        {
          "text": "akkana jedha: 'Ani utuu halkanii fi guyyaa wajjin kakuu koo jabeessee dhaabuu baadhee, samii fi lafaafis seera kaaʼuu baadhee,",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.25",
            "verseOrgIds": [
              "JER.33.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 33:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "silaa sanyii Yaaqoobii fi sanyii tajaajilaa koo Daawit gatee akka inni sanyii Abrahaam, sanyii Yisihaaqii fi kan Yaaqoob bulchuuf ilmaan isaa keessaa nama tokko hin filadhu ture. Anis boojiʼamtoota isaanii nan deebisa; garaa illee nan laafaaf.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.26",
            "verseOrgIds": [
              "JER.33.26"
            ]
          }
        }
