          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "yookaan luboonni warri Lewwota taʼan gonkumaa nama aarsaa gubamu dhiʼeessuuf, kennaa midhaanii gubuu fi qalma dhiʼeessuuf ittuma fufee fuula koo dura dhaabatu hin dhaban.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.18",
            "verseOrgIds": [
              "JER.33.18"
            ]
          }
        }
