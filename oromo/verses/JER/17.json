          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Cubbuun Yihuudaa meeshaa sibiilaatiin qirixaameera;",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.1",
            "verseOrgIds": [
              "JER.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:1"
      },
      "items": [
        {
          "text": "qara dhagaatiinis",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.1",
            "verseOrgIds": [
              "JER.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 17:1"
      },
      "items": [
        {
          "text": "gabatee garaa isaanii irrattii fi",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.1",
            "verseOrgIds": [
              "JER.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:1"
      },
      "items": [
        {
          "text": "gaanfa iddoo aarsaa isaanii irratti barreeffameera.",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.1",
            "verseOrgIds": [
              "JER.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ijoolleen isaanii iyyuu",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.2",
            "verseOrgIds": [
              "JER.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:2"
      },
      "items": [
        {
          "text": "iddoowwan aarsaa isaaniitii fi siidaa Aasheeraa",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.2",
            "verseOrgIds": [
              "JER.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 17:2"
      },
      "items": [
        {
          "text": "kanneen mukkeen lalisaa cinaatii fi",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.2",
            "verseOrgIds": [
              "JER.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:2"
      },
      "items": [
        {
          "text": "gaarran ol dheeroo irraa sana yaadatan.",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.2",
            "verseOrgIds": [
              "JER.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani sababii cubbuu biyya kee guute sanaatiif",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.3",
            "verseOrgIds": [
              "JER.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:3"
      },
      "items": [
        {
          "text": "tulluu koo kan biyya keessaa,",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.3",
            "verseOrgIds": [
              "JER.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 17:3"
      },
      "items": [
        {
          "text": "qabeenya keetii fi badhaadhummaa kee hunda",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.3",
            "verseOrgIds": [
              "JER.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:3"
      },
      "items": [
        {
          "text": "iddoo ol kaʼaa kee wajjin",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.3",
            "verseOrgIds": [
              "JER.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:3"
      },
      "items": [
        {
          "text": "dabarsee boojuuf nan kenna.",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.3",
            "verseOrgIds": [
              "JER.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati dogoggora mataa keetiitiin",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.4",
            "verseOrgIds": [
              "JER.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:4"
      },
      "items": [
        {
          "text": "dhaala ani siif kenne ni dhabda.",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.4",
            "verseOrgIds": [
              "JER.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 17:4"
      },
      "items": [
        {
          "text": "Ani biyya ati hin beekne keessatti",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.4",
            "verseOrgIds": [
              "JER.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:4"
      },
      "items": [
        {
          "text": "diinota keetiif sin garboomsa;",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.4",
            "verseOrgIds": [
              "JER.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 17:4"
      },
      "items": [
        {
          "text": "ati dheekkamsa koo qabsiifteertaatii;",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.4",
            "verseOrgIds": [
              "JER.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:4"
      },
      "items": [
        {
          "text": "innis bara baraan ni bobaʼa.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.4",
            "verseOrgIds": [
              "JER.17.4"
            ]
          }
        }
      ]
    },
