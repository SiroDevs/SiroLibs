          "text": "Inni akkuma muka qarqara bishaanii dhaabame,",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.8",
            "verseOrgIds": [
              "JER.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:8"
      },
      "items": [
        {
          "text": "kan hidda isaa ededa lagaa irra yaafatuu taʼa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.8",
            "verseOrgIds": [
              "JER.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 17:8"
      },
      "items": [
        {
          "text": "Yommuu hoʼi dhufu hin sodaatu;",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.8",
            "verseOrgIds": [
              "JER.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:8"
      },
      "items": [
        {
          "text": "baalli isaa yeroo hunda lalisaa dha.",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.8",
            "verseOrgIds": [
              "JER.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 17:8"
      },
      "items": [
        {
          "text": "Mukni sun bara hongee illee hin yaaddaʼu;",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.8",
            "verseOrgIds": [
              "JER.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:8"
      },
      "items": [
        {
          "text": "ija naqachuus hin dhiisu.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.8",
            "verseOrgIds": [
              "JER.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
