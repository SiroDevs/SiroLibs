              "attrs": {
                "verseId": "JER.17.7",
                "verseOrgIds": [
                  "JER.17.7"
                ]
              }
            }
          ]
        },
        {
          "text": "amanatu,",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.7",
            "verseOrgIds": [
              "JER.17.7"
            ]
          }
        }
