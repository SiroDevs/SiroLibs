                "verseId": "JER.17.5",
                "verseOrgIds": [
                  "JER.17.5"
                ]
              }
            }
          ]
        },
        {
          "text": "akkana jedha:",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.5",
            "verseOrgIds": [
              "JER.17.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 17:5"
      },
      "items": [
        {
          "text": "\"Namni nama amanatu,",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.5",
            "verseOrgIds": [
              "JER.17.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:5"
      },
      "items": [
        {
          "text": "kan jabina foonii irree isaa godhatu,",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.5",
            "verseOrgIds": [
              "JER.17.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:5"
      },
      "items": [
        {
          "text": "kan garaan isaa",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.5",
            "verseOrgIds": [
              "JER.17.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JER.17.5",
                "verseOrgIds": [
                  "JER.17.5"
                ]
              }
            }
          ]
        },
        {
          "text": "irraa garagalu abaaramaa dha.",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.5",
            "verseOrgIds": [
              "JER.17.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni akka daggala gammoojjii keessaa taʼa;",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.6",
            "verseOrgIds": [
              "JER.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:6"
      },
      "items": [
        {
          "text": "yeroo wanni gaariin dhufutti hin argu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.6",
            "verseOrgIds": [
              "JER.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 17:6"
      },
      "items": [
        {
          "text": "Inni gammoojjii keessaa iddoo gogaa",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.6",
            "verseOrgIds": [
              "JER.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:6"
      },
      "items": [
        {
          "text": "biyya soogiddaa kan namni tokko iyyuu hin jiraanne keessa jiraata.",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.6",
            "verseOrgIds": [
              "JER.17.6"
            ]
          }
        }
      ]
    },
