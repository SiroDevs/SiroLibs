      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:7"
      },
      "items": [
        {
          "text": "kan abdiin isaas isuma taʼe garuu eebbifamaa dha.",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.7",
            "verseOrgIds": [
              "JER.17.7"
            ]
          }
        }
