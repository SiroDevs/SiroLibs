      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 17:9"
      },
      "items": [
        {
          "text": "Eenyutu isa hubachuu dandaʼa?",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.9",
            "verseOrgIds": [
              "JER.17.9"
            ]
          }
        }
