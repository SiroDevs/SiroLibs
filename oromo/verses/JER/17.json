          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garaan namaa waan hunda caalaa haxxee dha;",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.9",
            "verseOrgIds": [
              "JER.17.9"
            ]
          }
        }
