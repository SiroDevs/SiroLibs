        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yihuudaan Nebukadnezar Tajaajila",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 27:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jalqaba bara Zedeqiyaa ilmi Yosiyaas mootii Yihuudaa turetti dubbiin kun",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.1",
            "verseOrgIds": [
              "JER.27.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JER.27.1",
                "verseOrgIds": [
                  "JER.27.1"
                ]
              }
            }
          ]
        },
        {
          "text": "biraa gara Ermiyaas dhufe:",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.1",
            "verseOrgIds": [
              "JER.27.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JER.27.2",
                "verseOrgIds": [
                  "JER.27.2"
                ]
              }
            }
          ]
        },
        {
          "text": "akkana naan jedhe; \"Teephaa fi danqaraadhaan waanjoo tolchiitii morma keetti kaaʼadhu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.2",
            "verseOrgIds": [
              "JER.27.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasii karaa ergamoota Zedeqiyaa mooticha Yihuudaa bira gara Yerusaalem dhufaniitiin gara mootii Edoom, mootii Moʼaab, mootii Amoon, mootii Xiiroosii fi mootii Siidoonaatti dhaamsa ergi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.3",
            "verseOrgIds": [
              "JER.27.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gooftota isaaniitiif dhaamsa kana dabarsii akkana jedhiin; '",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.4",
            "verseOrgIds": [
              "JER.27.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JER.27.4",
                "verseOrgIds": [
                  "JER.27.4"
                ]
              }
            }
          ]
        },
        {
          "text": "Waan Hunda Dandaʼu, Waaqni Israaʼel akkana jedha; \"Waan kana gooftota keessanitti himaa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.4",
            "verseOrgIds": [
              "JER.27.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani humna koo guddaa fi irree koo diriirfameen lafa, uummata isheetii fi bineensota ishee irra jiraatan uumeera; abbaa fedheef illee nan kenna.",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.5",
            "verseOrgIds": [
              "JER.27.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani amma biyyoota keessan hunda harka garbicha koo Nebukadnezar mooticha Baabiloniitti dabarsee nan kenna. Akka bineensonni bosonaa iyyuu isa jalatti bulan nan godha.",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.6",
            "verseOrgIds": [
              "JER.27.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamma guyyaan biyya isaa gaʼutti saboonni hundi isa, ilmaan isaatii fi ilmaan ilmaan isaa tajaajilu; ergasii immoo saboonni hedduunii fi mootonni gurguddaan isa garboomfatu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.7",
            "verseOrgIds": [
              "JER.27.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" ' \"Garuu yoo sabni yookaan mootummaan kam iyyuu Nebukadnezar mooticha Baabilon hin tajaajille yookaan yoo morma isaa waanjoo mootichaatiif gad hin qabanne ani hamman harkuma isaatiin isaan balleessutti saba sana goraadeedhaan, beelaa fi dhaʼichaan nan adaba, jedha",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.8",
            "verseOrgIds": [
              "JER.27.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JER.27.8",
                "verseOrgIds": [
                  "JER.27.8"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.8",
            "verseOrgIds": [
              "JER.27.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu isin raajota keessan, ilaaltota keessan, warra abjuu isiniif hiikan, eker dubbistoota keessanii fi falfaltoota keessan kanneen, 'Isin mootii Baabilon hin tajaajiltan' isiniin jedhan sana hin dhagaʼinaa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.9",
            "verseOrgIds": [
              "JER.27.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan akka isin biyya keessan keessaa buqqifamtanii fagaattaniif soba isiniif raaju; anis ariʼee isin nan baasa; isinis ni baddu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.10",
            "verseOrgIds": [
              "JER.27.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu yoo sabni kam iyyuu morma isaa waanjoo mootii Baabiloniitiif gad qabatee isa tajaajile, ani akka sabni sun biyya ofii isaa keessatti hafee lafa qotatee achi jiraatu nan dhiisa, jedha",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.11",
            "verseOrgIds": [
              "JER.27.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JER.27.11",
                "verseOrgIds": [
                  "JER.27.11"
                ]
              }
            }
          ]
        },
        {
          "text": ".\" ' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.11",
            "verseOrgIds": [
              "JER.27.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anis Zedeqiyaa mooticha Yihuudaatti ergaadhuma kana nan hime. Akkanan jedheen; \"Morma keessan waanjoo mootii Baabiloniitiif gad qabadhaa; isaa fi saba isaa tajaajilaa; isinis ni jiraattu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.12",
            "verseOrgIds": [
              "JER.27.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atii fi sabni kee maaliif goraadee, beelaa fi dhaʼicha",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.13",
            "verseOrgIds": [
              "JER.27.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JER.27.13",
                "verseOrgIds": [
                  "JER.27.13"
                ]
              }
            }
          ]
        },
        {
          "text": "ittiin saba mootii Baabilon hin tajaajille kam iyyuu sodaachiseen duutu?",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.13",
            "verseOrgIds": [
              "JER.27.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dubbii raajota, 'Isin mootii Baabilon hin tajaajiltan' isiniin jedhanii hin dhagaʼinaa; isaan raajii sobaa isinitti dubbatuutii.",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.14",
            "verseOrgIds": [
              "JER.27.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "'Ani isaan hin ergine' jedha",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.15",
            "verseOrgIds": [
              "JER.27.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JER.27.15",
                "verseOrgIds": [
                  "JER.27.15"
                ]
              }
            }
          ]
        },
        {
          "text": ". 'Jarri maqaa kootiin soba raaju. Kanaafuu ani isinii fi raajota isinii raajan illee ariʼee nan baasa; isinis ni baddu.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.15",
            "verseOrgIds": [
              "JER.27.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 27:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anis lubootaa fi namoota kana hundaan akkanan jedhe, \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.16",
            "verseOrgIds": [
              "JER.27.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JER.27.16",
                "verseOrgIds": [
                  "JER.27.16"
                ]
              }
            }
          ]
        },
        {
          "text": "akkana jedha: raajota, 'Miʼi mana",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.16",
            "verseOrgIds": [
              "JER.27.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "JER.27.16",
                "verseOrgIds": [
                  "JER.27.16"
                ]
              }
            }
          ]
        },
        {
          "text": "ammuma Baabilonii ni deebifama' jedhan hin dhagaʼinaa. Isaan soba isiniif raaju.",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.16",
            "verseOrgIds": [
              "JER.27.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 27:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isin jara hin dhaggeeffatinaa. Mootii Baabilon tajaajilaa; ni jiraattuutii. Magaalaan kun maaliif diigamti?",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.17",
            "verseOrgIds": [
              "JER.27.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 27:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan yoo raajota taʼanii fi yoo dubbii",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.18",
            "verseOrgIds": [
              "JER.27.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "JER.27.18",
                "verseOrgIds": [
                  "JER.27.18"
                ]
              }
            }
          ]
        },
        {
          "text": "of keessaa qabaatan mee akka miʼi mana",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.18",
            "verseOrgIds": [
              "JER.27.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "JER.27.18",
                "verseOrgIds": [
                  "JER.27.18"
                ]
              }
            }
          ]
        },
        {
          "text": "kan masaraa mootii Yihuudaatii fi Yerusaalem keessatti hafe sun gara Baabilonitti hin fudhatamneef",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.18",
            "verseOrgIds": [
              "JER.27.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JER.27.18",
                "verseOrgIds": [
                  "JER.27.18"
                ]
              }
            }
          ]
        },
        {
          "text": "Waan Hunda Dandaʼu haa kadhatan.",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.18",
            "verseOrgIds": [
              "JER.27.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 27:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "JER.27.19",
                "verseOrgIds": [
                  "JER.27.19"
                ]
              }
            }
          ]
        },
        {
          "text": "Waan Hunda Dandaʼu waaʼee utubootaa, waaʼee miʼa bishaan itti kuusanii, waaʼee baattuuwwaniitii fi waaʼee miʼoota magaalaa kanatti hafan kanneen biraa akkana jedhaatii;",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.19",
            "verseOrgIds": [
              "JER.27.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 27:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebukadnezar mootiin Baabilon sun gaafa Yehooyaakiin ilma Yehooyaaqiim mooticha Yihuudaa sana namoota Yihuudaatii fi Yerusaalem ulfaatoo hunda wajjin Yerusaalemii gara Baabilonitti boojiʼe sana miʼoota kanneen hin fudhanne.",
