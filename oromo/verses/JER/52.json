        "style": "p",
        "vid": "JER 52:27"
      },
      "items": [
        {
          "text": "Yihuudaanis akkasiin boojiʼamee biyya isheetii baate.",
          "type": "text",
          "attrs": {
            "verseId": "JER.52.27",
            "verseOrgIds": [
              "JER.52.27"
