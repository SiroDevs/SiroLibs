  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "32",
        "style": "c",
        "sid": "JOB 32"
      },
      "items": [
        {
          "text": "32",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Eeliihuu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 32:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sababii Iyyoob nama qajeelaa of seʼeef namoonni sadan kunneen deebii kennuufii dhiisan.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.1",
            "verseOrgIds": [
              "JOB.32.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 32:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliihuun ilmi Barakeel Buuzichi maatiin Raamii sun garuu sababii Iyyoob qooda Waaqaa qajeelaa of godheef akka malee itti aare.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.2",
            "verseOrgIds": [
              "JOB.32.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 32:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkasumas sababii isaan Iyyoobitti muruu malee deebii hin qabaatiniif Eeliihuun michoota Iyyoob sadanitti akka malee aare.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.3",
            "verseOrgIds": [
              "JOB.32.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 32:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliihuun waan namoonni sun umuriidhaan isa caalaniif utuu dursee Iyyoobitti hin dubbatin ture.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.4",
            "verseOrgIds": [
              "JOB.32.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 32:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu yeroo akka namoonni sun sadan waan dubbatan dhaban argetti aariin isaa ittuma caale.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.5",
            "verseOrgIds": [
              "JOB.32.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 32:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu Eliihuun ilmi Barakeel Buuzichaa sun akkana jedhe:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.6",
            "verseOrgIds": [
              "JOB.32.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 32:6"
      },
      "items": [
        {
          "text": "\"Ani umuriidhaan xinnaa dha;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.6",
            "verseOrgIds": [
              "JOB.32.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 32:6"
      },
      "items": [
        {
          "text": "isin garuu jaarsolii dha;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.6",
            "verseOrgIds": [
              "JOB.32.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 32:6"
      },
      "items": [
        {
          "text": "kanaafuu ani yaada koo isinitti himuu",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.6",
            "verseOrgIds": [
              "JOB.32.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 32:6"
      },
      "items": [
        {
          "text": "nan saalfadhe; nan sodaadhes.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.6",
            "verseOrgIds": [
              "JOB.32.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 32:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani, 'Umuriin ni dubbata;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.7",
            "verseOrgIds": [
              "JOB.32.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 32:7"
      },
      "items": [
        {
          "text": "barri dheeraanis ogummaa barsiisa' jedhee yaadeen ture.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.7",
            "verseOrgIds": [
              "JOB.32.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 32:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu hafuura nama keessa jiru,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.8",
            "verseOrgIds": [
              "JOB.32.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 32:8"
      },
      "items": [
        {
          "text": "hafuura Waaqni Waan Hunda Dandaʼu itti baafatutu hubannaa kennaaf.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.8",
            "verseOrgIds": [
              "JOB.32.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 32:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogeessi jaarsa qofa miti;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.9",
            "verseOrgIds": [
              "JOB.32.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 32:9"
      },
      "items": [
        {
          "text": "kan waan qajeelaa hubatus, nama umurii dheeraa qofa miti.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.9",
            "verseOrgIds": [
              "JOB.32.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 32:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kanaafuu ani akkana nan jedhaa na dhaggeeffadhaa;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.10",
            "verseOrgIds": [
              "JOB.32.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 32:10"
      },
      "items": [
        {
          "text": "anis waanan beeku isinitti nan hima.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.10",
            "verseOrgIds": [
              "JOB.32.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 32:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani yeroo isin dubbattan nan obse;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.11",
            "verseOrgIds": [
              "JOB.32.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 32:11"
      },
      "items": [
        {
          "text": "yeroo isin jechoota filattanitti illee",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.11",
            "verseOrgIds": [
              "JOB.32.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 32:11"
      },
      "items": [
        {
          "text": "ani dubbii ogummaa kan isin dubbattan nan dhaggeeffadhe;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.11",
            "verseOrgIds": [
              "JOB.32.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 32:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "ani qalbeeffadheen isin dhagaʼe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.12",
            "verseOrgIds": [
              "JOB.32.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 32:12"
      },
      "items": [
        {
          "text": "Garuu isin keessaa namni tokko iyyuu akka inni dogoggore",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.12",
            "verseOrgIds": [
              "JOB.32.12"
            ]
          }
        },
        {
          "name": "optbreak",
          "type": "tag",
          "attrs": {},
          "items": []
        },
        {
          "text": "Iyyoobin hin amansiifne;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.12",
            "verseOrgIds": [
              "JOB.32.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 32:12"
      },
      "items": [
        {
          "text": "namni tokko iyyuu falmii isaatiif deebii hin kennine.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.12",
            "verseOrgIds": [
              "JOB.32.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 32:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isin, 'Nu ogummaa arganneerra;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.13",
            "verseOrgIds": [
              "JOB.32.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 32:13"
      },
      "items": [
        {
          "text": "nama utuu hin taʼin, Waaqni isa irra haa aanu' hin jedhinaa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.13",
            "verseOrgIds": [
              "JOB.32.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 32:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyyoob garuu dubbii isaatiin na hin tuqne;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.14",
            "verseOrgIds": [
              "JOB.32.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 32:14"
      },
      "items": [
        {
          "text": "anis falmii keessaniin deebii isaaf hin kennu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.14",
            "verseOrgIds": [
              "JOB.32.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 32:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Isaan abdii kutatanii waan jedhan dhaban;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.15",
            "verseOrgIds": [
              "JOB.32.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 32:15"
      },
      "items": [
        {
          "text": "dubbiinis isaan harkaa badde.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.15",
            "verseOrgIds": [
              "JOB.32.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 32:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erga isaan calʼisanii,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.16",
            "verseOrgIds": [
              "JOB.32.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 32:16"
      },
      "items": [
        {
          "text": "erga isaan deebii kennan tokko illee dhabanii achi dhadhaabatanii,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.16",
            "verseOrgIds": [
              "JOB.32.16"
            ]
          }
        },
        {
          "name": "optbreak",
          "type": "tag",
          "attrs": {},
          "items": []
        },
        {
          "text": "ani eeguun qabaa?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.16",
            "verseOrgIds": [
              "JOB.32.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 32:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani deebii koo nan kenna;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.17",
            "verseOrgIds": [
              "JOB.32.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 32:17"
      },
      "items": [
        {
          "text": "waanan beeku nan hima.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.17",
            "verseOrgIds": [
              "JOB.32.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 32:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dubbiin na keessa guuteeraatii;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.18",
            "verseOrgIds": [
              "JOB.32.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 32:18"
      },
      "items": [
        {
          "text": "hafuurri na keessa jirus na kakaasa;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.18",
            "verseOrgIds": [
