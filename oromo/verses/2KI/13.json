  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
        "style": "c",
        "sid": "2KI 13"
      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yehooʼaahaaz Mooticha Israaʼel",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bara mootummaa Yooʼaash ilma Ahaaziyaa mooticha Yihuudaa keessa waggaa digdamii sadaffaatti Yehooʼaahaaz ilmi Yehuu Samaariyaa keessatti mootii Israaʼel taʼee waggaa kudha torba bulche.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.1",
            "verseOrgIds": [
              "2KI.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni cubbuu Yerobiʼaam ilma Nebaat kan inni akka sabni Israaʼel hojjetu godhe sana duukaa buʼuudhaan fuula",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.2",
            "verseOrgIds": [
              "2KI.13.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.13.2",
                "verseOrgIds": [
                  "2KI.13.2"
                ]
              }
            }
          ]
        },
        {
          "text": "duratti waan hamaa hojjete; cubbuu sana irraas hin deebine.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.2",
            "verseOrgIds": [
              "2KI.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu dheekkamsi",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.3",
            "verseOrgIds": [
              "2KI.13.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.13.3",
                "verseOrgIds": [
                  "2KI.13.3"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqaa Israaʼelitti ni bobaʼe; innis yeroo dheeraadhaaf dabarsee harka Hazaaʼeel mooticha Sooriyaattii fi harka ilma isaa Ben-Hadaadiitti isaan kenne.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.3",
            "verseOrgIds": [
              "2KI.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehooʼaahaaz fuula",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.4",
            "verseOrgIds": [
              "2KI.13.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.13.4",
                "verseOrgIds": [
                  "2KI.13.4"
                ]
              }
            }
          ]
        },
        {
          "text": "barbaaddate;",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.4",
            "verseOrgIds": [
              "2KI.13.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyos",
              "type": "text",
              "attrs": {
                "verseId": "2KI.13.4",
                "verseOrgIds": [
                  "2KI.13.4"
                ]
              }
            }
          ]
        },
        {
          "text": "akka mootiin Sooriyaa sun akka malee Israaʼelin cunqurse argee kadhaa isaa dhagaʼeef.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.4",
            "verseOrgIds": [
              "2KI.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyos",
              "type": "text",
              "attrs": {
                "verseId": "2KI.13.5",
                "verseOrgIds": [
                  "2KI.13.5"
                ]
              }
            }
          ]
        },
        {
          "text": "nama isaan baraaru tokko Israaʼeliif kenne; akkasiin isaan harka warra Sooriyaa jalaa ni baʼan. Kanaafuu Israaʼeloonni akkuma duraatti dunkaana isaanii keessa jiraatan.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.5",
            "verseOrgIds": [
              "2KI.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan garuu cubbuu mana Yerobiʼaam kan inni akka Israaʼel hojjetu godhe sana irraa hin deebine; ittuma fufanii keessa jiraatan. Siidaan Aasheeraas Samaariyaa keessa dhaabatee hafe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.6",
            "verseOrgIds": [
              "2KI.13.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Loltoota Yehooʼaahaaz keessaa loltoota fardaa shantama, gaariiwwan kudhanii fi loltoota lafoo kuma kudhan malee tokko iyyuu hin hafne; mootiin Sooriyaa warra kaan hunda balleessee akkuma awwaara yeroo midhaan dhaʼanii isaan godhee tureetii.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.7",
            "verseOrgIds": [
              "2KI.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wanni bara mootummaa Yehooʼaahaaz keessa hojjetame biraa, wanni inni hojjete hundii fi jabinni isaa kitaaba seenaa mootota Israaʼel keessatti barreeffameera mitii?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.8",
            "verseOrgIds": [
              "2KI.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehooʼaahaaz abbootii isaa wajjin boqotee Samaariyaa keessatti ni awwaalame. Yooʼaash ilmi isaa iddoo isaa buʼee mootii taʼe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.9",
            "verseOrgIds": [
              "2KI.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yooʼaash Mooticha Israaʼel",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bara Yooʼaash mooticha Yihuudaa keessa waggaa soddomii torbaffaatti Yooʼaash ilmi Yehooʼaahaaz Samaariyaa keessatti mootii Israaʼel taʼee waggaa kudha jaʼa isaan bulche.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.10",
            "verseOrgIds": [
              "2KI.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni fuula",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.11",
            "verseOrgIds": [
              "2KI.13.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.13.11",
                "verseOrgIds": [
                  "2KI.13.11"
                ]
              }
            }
          ]
        },
        {
          "text": "duratti cubbuu hojjetee cubbuu Yerobiʼaam ilma Nebaat kan inni akka sabni Israaʼel hojjetu godhe sana keessaa tokko irraa iyyuu hin deebine; innis ittuma fufee cubbuu keessa jiraate.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.11",
            "verseOrgIds": [
              "2KI.13.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wantoonni bara mootummaa Yooʼaash keessa hojjetaman biraa, wanni inni hojjete hundii fi jabinni isaa, waraanni inni Amasiyaa mooticha Yihuudaa irratti deemsises kitaaba seenaa mootota Israaʼel keessatti barreeffamaniiru mitii?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.12",
            "verseOrgIds": [
              "2KI.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yooʼaash abbootii isaa wajjin boqotee Yerobiʼaam iddoo isaa buʼee teessoo irra taaʼe. Yooʼaash Samaariyaa keessatti mootota Israaʼel biratti ni awwaalame.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.13",
            "verseOrgIds": [
              "2KI.13.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo kanatti Elsaaʼi dhukkuba duʼaan isa gaʼuun dhiphachaa ture. Yooʼaash mootichi Israaʼel isa ilaaluu gad buʼee isatti booʼe. Innis, \"Yaa abbaa koo! Yaa abbaa koo! Yaa gaariiwwanii fi yaa abbootii fardaa Israaʼel!\" jedhee iyye.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.14",
            "verseOrgIds": [
              "2KI.13.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elsaaʼi, \"Iddaa fi xiyya wayii fudhadhu\" jedheen; innis ni fudhate.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.15",
            "verseOrgIds": [
              "2KI.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elsaaʼi immoo mooticha Israaʼeliin, \"Iddaa harkatti qabadhu\" jedhe; inni fuunaan Elsaaʼi harka ofii isaa fuudhee harka mootichaa irra kaaʼe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.16",
            "verseOrgIds": [
              "2KI.13.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elsaaʼi, \"Foddaa karaa baʼa biiftuu bani\" jedheen; innis ni bane. Elsaaʼi, \"Xiyya darbadhu!\" jedhe; mootichis ni darbate. Elsaaʼis, \"Xiyya moʼannoo",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.17",
            "verseOrgIds": [
              "2KI.13.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.13.17",
                "verseOrgIds": [
                  "2KI.13.17"
                ]
              }
            }
          ]
        },
        {
          "text": ", xiyya warra Sooriyaa moʼatu!\" jedhe. Elsaaʼis, \"Ati Afeeqitti warra Sooriyaa guutumaan guutuutti ni barbadeessita\" jedhee labse.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.17",
            "verseOrgIds": [
              "2KI.13.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis ergasii, \"Xiyya fudhadhu\" jedheen; mootichis ni fudhate. Elsaaʼis \"Lafa rukuti\" jedheen; mootichis yeroo sadii lafa rukute.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.18",
            "verseOrgIds": [
              "2KI.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni Waaqaa sunis isatti aaree akkana jedhe; \"Ati yeroo shan yookaan jaʼa lafa rukutuu qabda; silaa warra Sooriyaa moʼattee guutumaan guutuutti isaan balleessita turte. Amma garuu yeroo sadii qofa isaan moʼatta.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.19",
            "verseOrgIds": [
              "2KI.13.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elsaaʼi duʼee awwaalame.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.20",
            "verseOrgIds": [
              "2KI.13.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 13:20"
      },
      "items": [
        {
          "text": "Yeroo sana Moʼaabonni saamtonni birraa birraa dhufanii biyyattii saamu ture.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.20",
            "verseOrgIds": [
              "2KI.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaaf tokko warri Israaʼel utuu namicha duʼe tokko awwaaluutti jiranuu garee saamtotaa tokko argan; kanaafuu reeffa namichaa awwaala Elsaaʼitti darbatan. Reeffi sun lafee Elsaaʼi tuqnaan namichi sun duʼaa kaʼee miiluma ofii isaatiin dhaabate.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.21",
            "verseOrgIds": [
              "2KI.13.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
