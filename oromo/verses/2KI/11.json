    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ataaliyaan haati Ahaaziyaa yommuu akka ilmi ishee duʼe argitetti kaatee maatii mootii guutumaan guutuutti balleessite.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.1",
            "verseOrgIds": [
              "2KI.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehooshebaati intalli Yooraam mootichaa obboleettiin Ahaaziyaa sun garuu ilmaan moototaa kanneen ajjeefamuuf turan keessaa Yooʼaash ilma Ahaaziyaa hattee fudhatte. Isheenis Ataaliyaa jalaa isa dhoksuuf jettee isaa fi guddiftuu isaa kutaa hirribaa keessa teessifte. Kanaafuu inni hin ajjeefamne.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.2",
            "verseOrgIds": [
              "2KI.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis bara Ataaliyaan biyya bulchaa turte hunda guddiftuu isaa wajjin mana qulqullummaa",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.3",
            "verseOrgIds": [
              "2KI.11.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.11.3",
                "verseOrgIds": [
                  "2KI.11.3"
                ]
              }
            }
          ]
        },
        {
          "text": "keessatti dhokfamee waggaa jaʼa jiraate.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.3",
            "verseOrgIds": [
              "2KI.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehooyaadaan waggaa torbaffaatti ajajjuuwwan dhibbaa, namoota Kaariittii fi eegdotatti nama ergee akka isaan mana qulqullummaa",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.4",
            "verseOrgIds": [
              "2KI.11.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyootii",
              "type": "text",
              "attrs": {
                "verseId": "2KI.11.4",
                "verseOrgIds": [
                  "2KI.11.4"
                ]
              }
            }
          ]
        },
        {
          "text": "gara isaa dhufan godhe. Innis mana qulqullummaa",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.4",
            "verseOrgIds": [
              "2KI.11.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.11.4",
                "verseOrgIds": [
                  "2KI.11.4"
                ]
              }
            }
          ]
        },
        {
          "text": "keessatti isaan wajjin kakuu seene. Ergasiis ilma mootii isaanitti argisiise.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.4",
            "verseOrgIds": [
              "2KI.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkana jedhees isaan ajaje; \"Wanni isin gochuu qabdan isa kana: Isin warri garee sadii keessa jirtan kanneen guyyaa Sanbataatiin hojiitti bobbaatan harka sadii keessaa harki tokko mana mootii,",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.5",
            "verseOrgIds": [
              "2KI.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "harka sadii keessaa harkii tokko Karra Suur, harka sadii keessaa harkii tokko immoo karra eegdota dabaree dabareedhaan mana qulqullummaa eegan dugda duubaan jiru haa eegu;",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.6",
            "verseOrgIds": [
              "2KI.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "isin warri garee lamaan kaan keessa jirtan kanneen guyyaa Sanbataatiin hojii irraa boqottan hundinuu immoo mana qulqullummaa mootiidhaaf eeguu qabdu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.7",
            "verseOrgIds": [
              "2KI.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tokkoon tokkoon keessan miʼa lolaa harkatti qabadhaatii mootichatti naannaʼaa dhadhaabadhaa. Namni naannoo isin jirtanitti dhiʼaatu kam iyyuu haa ajjeefamu. Lafa inni dhaqu hundatti mootichatti dhiʼoo jiraadhaa.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.8",
            "verseOrgIds": [
              "2KI.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ajajjuuwwan dhibbaa sunis akkuma Yehooyaadaan lubichi ajaje sana ni godhan. Tokkoon tokkoon isaaniis namoota isaanii warra guyyaa Sanbataatiin hojiitti bobbaʼanii fi warra hojii irraa boqotan fudhatanii Yehooyaadaa lubicha bira dhufan.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.9",
            "verseOrgIds": [
              "2KI.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis eeboowwanii fi gaachanawwan Daawit Mootichaa kanneen mana qulqullummaa",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.10",
            "verseOrgIds": [
              "2KI.11.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.11.10",
                "verseOrgIds": [
                  "2KI.11.10"
                ]
              }
            }
          ]
        },
        {
          "text": "keessa turan ajajjoota sanaaf ni kenne.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.10",
            "verseOrgIds": [
              "2KI.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eegdonni sunis, tokkoon tokkoon isaanii miʼa lolaa harkatti qabatanii karaa kibbaatii fi karaa kaaba mana qulqullummaatiin iddoo aarsaatii fi mana qulqullummaa biratti mootichatti naannaʼanii ni dhadhaabatan.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.11",
            "verseOrgIds": [
              "2KI.11.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehooyaadaanis ilma mootichaa fidee mataa isaa irra gonfoo kaaʼe; inni garagalcha kakuu itti kennee, \"Inni mootii dha\" jedhee labse. Isaanis isa diban; harka dhaʼaniis, \"Mootichi bara baraan haa jiraatu!\" jedhanii iyyan.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.12",
            "verseOrgIds": [
              "2KI.11.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ataaliyaan yommuu waca eegdotaatii fi namootaa dhageessetti gara namoota sanaa mana qulqullummaa",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.13",
            "verseOrgIds": [
              "2KI.11.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.11.13",
                "verseOrgIds": [
                  "2KI.11.13"
                ]
              }
            }
          ]
        },
        {
          "text": "dhaqxe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.13",
            "verseOrgIds": [
              "2KI.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo isheen ilaaltetti mootichi akkuma baratame sanatti utubaa bira dhaabatee ture. Qondaaltonnii fi warri malakata afuufan mooticha bira turan; namoonni biyya sanaa hundinuus gammadanii malakata afuufaa turan. Kana irratti Ataaliyaan uffata ishee tarsaaftee, \"Kun maltummaa dha! Kun maltummaa dha!\" jettee iyyite.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.14",
            "verseOrgIds": [
              "2KI.11.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehooyaadaan lubichis, \"Hiriira gidduudhaa baasaatii ishee fidaa; nama ishee irra dhufu kam iyyuu goraadeedhaan ajjeesaa\" jedhee ajajjuuwwan dhibbaa kanneen kutaawwan loltootaa sana irratti ramadaman ajaje. Lubichi, \"Isheen mana qulqullummaa",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.15",
            "verseOrgIds": [
              "2KI.11.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.11.15",
                "verseOrgIds": [
                  "2KI.11.15"
                ]
              }
            }
          ]
        },
        {
          "text": "keessatti ajjeefamuu hin qabdu\" jedhee tureetii.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.15",
            "verseOrgIds": [
              "2KI.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu isaan akkuma isheen balbala fardeen ittiin masaraa mootii seenan geesseen ishee qabanii achumatti ishee ni ajjeesan.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.16",
            "verseOrgIds": [
              "2KI.11.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasiis Yehooyaadaan akka isaan saba",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.17",
            "verseOrgIds": [
              "2KI.11.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.11.17",
                "verseOrgIds": [
                  "2KI.11.17"
                ]
              }
            }
          ]
        },
        {
          "text": "taʼaniif jedhee",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.17",
            "verseOrgIds": [
              "2KI.11.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2KI.11.17",
                "verseOrgIds": [
                  "2KI.11.17"
                ]
              }
            }
          ]
        },
        {
          "text": "fi mootii fi saba gidduutti kakuu dhaabe. Akkasumas mootichaa fi saba gidduutti kakuu ni dhaabe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.17",
            "verseOrgIds": [
              "2KI.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sabni biyyattii hundinuu gara galma Baʼaal dhaqee diige. Isaanis iddoowwan aarsaatii fi waaqota tolfamoo caccabsanii hurreessanii Mataan lubicha Baʼaal sana illee iddoowwan aarsaa duratti ni ajjeesan.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.18",
            "verseOrgIds": [
              "2KI.11.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 11:18"
      },
      "items": [
        {
          "text": "Ergasii Yehooyaadaan lubichi mana qulqullummaa",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.18",
            "verseOrgIds": [
              "2KI.11.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyotti",
              "type": "text",
              "attrs": {
                "verseId": "2KI.11.18",
                "verseOrgIds": [
                  "2KI.11.18"
                ]
              }
            }
          ]
        },
        {
          "text": "eegdota ni ramade.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.18",
            "verseOrgIds": [
              "2KI.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis ajajjuuwwan dhibbaa, warra Kaarii, eegdotaa fi namoota biyyattii hunda fudhatee dhaqee isaan wajjinis mana qulqullummaa",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.19",
            "verseOrgIds": [
              "2KI.11.19"
