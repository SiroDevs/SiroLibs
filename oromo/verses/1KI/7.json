    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoon mootichi Xiiroositti nama ergee Huuraamin fichisiise;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.13",
            "verseOrgIds": [
              "1KI.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "haati Huuraam haadha hiyyeessaa kan gosa Niftaalem turte; abbaan isaa immoo nama gosa Xiiroos kan ogummaa hojii naasii qabu ture. Huuraam kun nama ogummaa guddaa qabu kan hojii naasii hunda keessatti muuxannoo qabu ture. Innis gara Solomoon mootichaa dhufee hojii isatti kenname hunda hojjete.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.14",
            "verseOrgIds": [
              "1KI.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiiraam utubaa naasii lama kanneen tokkoon tokkoon isaanii dhundhuma kudha saddeet ol dheeratanii dhundhuma kudha lama furdatan hojjete.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.15",
            "verseOrgIds": [
              "1KI.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fiixee utubaawwan sanaa irra kaaʼuudhaafis naasii baqfame irraa guutuu lama tolche; tokkoon tokkoon guutuu sanaas dhundhuma shan shan ol dheerata ture.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.16",
            "verseOrgIds": [
              "1KI.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasiis guutuuwwan fiixee utubaawwan irraa sanaaf foncaa wal keessa loofame akka gingilchaatti hojjetame lama tolche; tokkoo tokkoo guutuu sanaatiifis gingilchaa torba torbatu qoodame.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.17",
            "verseOrgIds": [
              "1KI.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis guutuuwwan fiixee utubaawwanii irra jiran sana miidhagsuuf jedhee tokkoo tokkoo gingilchaa sanaatti naannessee toora lamaan roomaanota tolche. Tokkoo tokkoo guutuwwaniitiifis akkasuma tolche.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.18",
            "verseOrgIds": [
              "1KI.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guutuuwwan gardaafoo keessa fiixee utubaawwanii irra jiranis daraaraa fakkaatanii dhundhuma afur afur ol dheeratu ture.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.19",
            "verseOrgIds": [
              "1KI.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guutuuwwan fiixee utubaawwan lamaanii irra kutaa waciitii fakkaatu kan gingilchaawwanitti aanuun gara irraa roomaanoota dhibba lamatu tooraan itti naannaʼee ture.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.20",
            "verseOrgIds": [
              "1KI.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis utubaawwan sana gardaafoo mana qulqullummaa dura dhadhaabe. Utubaa karaa kibbaatiin \"Yaakiin\" kan karaa kaabaatiin immoo \"Boʼeez\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.21",
            "verseOrgIds": [
              "1KI.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guutuuwwan fiixee sana irra jiran daraaraa fakkaatu turan. Hojiin utubaawwan irraas akkasiin dhume.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.22",
            "verseOrgIds": [
              "1KI.7.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis sibiila baqfame irraa Gaanii geengoo afaan isaa qarqara tokkoo hamma qarqara kaaniitti dhundhuma kudhan balʼatee dhundhuma shan ol dheeratu tolche. Naannoon isaas funyoodhaan safaramee dhundhuma soddoma taʼe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.23",
            "verseOrgIds": [
              "1KI.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hidhii isaa jalaanis dhundhuma tokko tokko irratti wiillee kudhan kudhanitu naanneffamee ture. Willeewwan sunis Gaanii sana wajjin tarree lamaan walumatti baqfamanii hojjetaman.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.24",
            "verseOrgIds": [
              "1KI.7.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaanichis korommii kudha lama kanneen isaan keessaa sadii gara kaabaatti, sadii gara dhiʼaatti, sadii gara kibbaatti, sadii immoo gara baʼaatti garagalan irra dhaabate. Gaaniin sun dugda isaanii irra dhaabatee eegeen hunda isaanii gara walakkaatti garagalee ture.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.25",
            "verseOrgIds": [
              "1KI.7.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaaniin sun hamma barruu harkaa yabbata ture; hidhiin isaas akkuma hidhii kubbaayyaa yookaan daraaraa hadaa fakkaata ture. Innis baadoosii kuma lama qabata ture.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.26",
            "verseOrgIds": [
              "1KI.7.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 7:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkasumas baattuuwwan naasii kanneen iddoo tokkoo sochoʼuu dandaʼan kudhan tolche; tokkoon tokkoon isaanii dhundhuma afur afur lafa irra dheeratanii balʼina dhundhuma afur afuriitii fi ol dheerina dhundhuma sadii sadii qabu turan.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.27",
            "verseOrgIds": [
              "1KI.7.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 7:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haalli itti baattuuwwan kunneen hojjetamanis kana: Isaanis sibiila babalʼaa michichilaan marfame qabu ture.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.28",
            "verseOrgIds": [
              "1KI.7.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 7:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibiilawwan michichilaan marfaman sana irras fakkii leencawwanii, kan jibootaatii fi kan kiirubeeliitu ture; michichilawwan sana irras akkasuma ture. Fakkii leencawwaniitii fi jiboota sana jalaa fi gubbaanis fakkii daraaraa foʼamaa kan sibiila tumameen tolfame tokkotu ture.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.29",
            "verseOrgIds": [
              "1KI.7.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 7:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tokkoon tokkoon baattuu sanaa goommaa naasii afur afurii fi somaa naasii qaba ture; goleewwan afraniinis utubaawwanitu ture; utubaawwan kunneenis baqfamanii daraaraa foʼamaadhaan miidhagfamanii tolfaman.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.30",
            "verseOrgIds": [
              "1KI.7.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 7:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gara keessa baattuu sanaatiin uraa geengoo kan dhundhuma tokko gad fagaatutu ture. Uraan kunis geengoo taʼee jalli isaa dhundhuma tokkoo fi walakkaa balʼata ture. Naannoo uraa isaatti waan soofamee faayeffame tokkotu ture. Sibiilli baattuu sanaa balʼaan roga afuriin wal qixxee ture malee geengoo hin turre.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.31",
            "verseOrgIds": [
              "1KI.7.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 7:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Goommaawwan afran sun sibiila babalʼaa jala turan; somaan goommaawwaniis baattuu sanaan walitti qabsiifamee ture. Balʼinni tokkoo tokkoo goommaa sanaas dhundhuma tokkoo fi walakkaa ture.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.32",
            "verseOrgIds": [
              "1KI.7.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 7:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Goommaawwan sunis akkuma goommaawwan gaariitti hojjetaman. Somaan isaanii, hidhiin isaanii, hokkoon isaaniitii fi handhuurri isaanii hundinuu sibiila baqfame irraa hojjetame.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.33",
            "verseOrgIds": [
              "1KI.7.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 7:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tokkoo tokkoo goleewwan baattuu sanaa afran irra michichilawwan afurtu ture; michichilawwan isaas baattuudhuma sanaan walitti hojjetaman.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.34",
            "verseOrgIds": [
              "1KI.7.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1KI 7:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fiixee baattuu sanaa irra geengoo maramaa dhundhuma walakkaa dheeratu tokkotu ture. Michichilawwanii fi sibiilli babalʼaan sun fiixee baattuu sanaatti qabsiifamanii turan.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.35",
            "verseOrgIds": [
              "1KI.7.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1KI 7:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis michichilawwanii fi sibiila babalʼaa irratti iddoo hundatti fakkii kiirubeelii, kan leencotaatii fi kan mukkeen meexxii soofee fakkii daraaraa foʼamees naannoo isaanii guutuutti marse.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.36",
            "verseOrgIds": [
              "1KI.7.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1KI 7:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haalli inni ittiin baattuuwwan kurnan sana hojjetes kanaa dha. Isaan hundinuu haaluma tokkoon baqfamanii hojjetaman; wal qixxaataniis bifa tokko qabaatan.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.37",
            "verseOrgIds": [
              "1KI.7.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1KI 7:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasiis caabiiwwan naasii kudhan kanneen tokkoon tokkoon isaanii safartuu baadoos afurtama qabaatee balʼinni isaas dhundhuma afur taʼu hojjete; tokkoo tokkoo baattuuwwan kurnan sanaa irras caabii tokko tokkotu ture.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.38",
            "verseOrgIds": [
              "1KI.7.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1KI 7:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis baattuuwwan sana keessaa shan karaa kibba mana qulqullummaatiin, shan immoo karaa kaaba mana qulqullummaatiin dhaabe. Gaanii sana immoo karaa kibbaatiin, kibba baʼa golee mana qulqullummaatiin dhaabe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.39",
            "verseOrgIds": [
              "1KI.7.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1KI 7:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni okkoteewwan, waan daaraan ittiin hammaaramuu fi caabiiwwan ittiin dhiiga facaasanis ni tolche.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.40",
            "verseOrgIds": [
              "1KI.7.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 7:40"
      },
      "items": [
        {
          "text": "Hiiroomis akkasiin hojii mana qulqullummaa",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.40",
            "verseOrgIds": [
              "1KI.7.40"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "1KI.7.40",
                "verseOrgIds": [
                  "1KI.7.40"
                ]
              }
            }
          ]
        },
        {
          "text": "keessatti Solomoon mootichaaf hojjechaa ture hunda fixe; hojiin kunis:",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.40",
            "verseOrgIds": [
              "1KI.7.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1KI 7:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utubaawwan lamaan;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.41",
            "verseOrgIds": [
              "1KI.7.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1KI 7:41"
      },
      "items": [
        {
          "text": "guutuuwwan waciitii fakkaatan kanneen fiixee utubaawwanii irra jiran lamaan;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.41",
            "verseOrgIds": [
              "1KI.7.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1KI 7:41"
      },
      "items": [
        {
          "text": "wantoota akka gingilchaa wal keessa loofaman lamaan guutuuwwan waciitii fakkaatanii fiixee utubaawwanii irra jiran sana lamaan miidhagsan;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.41",
            "verseOrgIds": [
              "1KI.7.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1KI 7:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "wantoota akka gingilchaa wal keessa loofaman lamaan sanaafis roomaanota dhibba afur, tokkoo tokkoo wantoota sanaatiif roomaanota tarree lamaa waciitiiwwan lamaan guutuuwwanii kanneen fiixee utubaawwanii irraa sana ni miidhagsan;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.42",
            "verseOrgIds": [
              "1KI.7.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1KI 7:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "baattuuwwan kurnan, caabii isaanii kurnan wajjin;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.43",
            "verseOrgIds": [
              "1KI.7.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "1KI 7:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "gaanii fi korommii loonii kudha lamaan isa jalaan jiru;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.44",
            "verseOrgIds": [
              "1KI.7.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "1KI 7:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "okkoteewwan, waan ittiin daaraa hammaaranii fi caabiiwwan.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.45",
            "verseOrgIds": [
              "1KI.7.45"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "1KI 7:45"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 7:45"
      },
      "items": [
        {
          "text": "Miʼi Huuraam mana qulqullummaa",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.45",
            "verseOrgIds": [
              "1KI.7.45"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyootiif",
              "type": "text",
              "attrs": {
                "verseId": "1KI.7.45",
                "verseOrgIds": [
                  "1KI.7.45"
                ]
              }
            }
          ]
        },
        {
          "text": "jedhee Solomoon mootichaaf hojjete sun hundinuu naasii cululuqaa irraa tolfame.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.45",
            "verseOrgIds": [
              "1KI.7.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "1KI 7:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootichis miʼoota kanneen dirree Yordaanositti iddoo suphee kan Sukootii fi Zaaretaan gidduu jirutti baqsiisee hojjechiise.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.46",
            "verseOrgIds": [
              "1KI.7.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "1KI 7:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoon waan isaan akka malee baayʼee taʼaniif miʼoota kanneen hunda hin madaalle; ulfinni naasiis hammam akka taʼe hin beekamne.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.47",
            "verseOrgIds": [
              "1KI.7.47"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "1KI 7:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkasumas Solomoon miʼoota mana qulqullummaa",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.48",
            "verseOrgIds": [
              "1KI.7.48"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "1KI.7.48",
                "verseOrgIds": [
                  "1KI.7.48"
                ]
              }
            }
          ]
        },
        {
          "text": "keessa jiran hunda ni hojjechiise:",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.48",
            "verseOrgIds": [
              "1KI.7.48"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "1KI 7:48"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1KI 7:48"
      },
      "items": [
        {
          "text": "Isaanis iddoo aarsaa kan warqee irraa hojjetame;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.48",
            "verseOrgIds": [
              "1KI.7.48"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1KI 7:48"
      },
      "items": [
        {
          "text": "minjaala warqee kan buddeenni ilaalchaa irra ture;",
