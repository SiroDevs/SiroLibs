  "verseCount": 51,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "1KI 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Solomoon Masaraa Mootummaa Ijaarrate",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoon masaraa mootummaa isaa ijaaree fixachuuf waggaa kudha sadii itti fudhate.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.1",
            "verseOrgIds": [
              "1KI.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis Masaraa Bosona Libaanoon jedhamu ijaarrate; masaraan sunis dhundhuma dhibba tokko dalga dheeratee balʼina dhundhuma shantamaa fi ol dheerina dhundhuma soddoma qaba ture; innis toora afuriin utubaawwan birbirsaa kanneen dareeraawwan birbirsaa baatan qaba ture.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.2",
            "verseOrgIds": [
              "1KI.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manni sunis dareeraawwan utubaawwan irra naqaman sanaan olitti bantii birbirsi hojjetame qaba ture; innis toorawwan tokkoon tokkoon isaanii utubaawwan kudha shan qabatan walumaa galatti utubaawwan afurtamii shan qaba ture.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.3",
            "verseOrgIds": [
              "1KI.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Foddaawwan isaas ol kaafamanii toora sadii sadiin walitti garagalfamanii hojjetaman.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.4",
            "verseOrgIds": [
              "1KI.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balballii fi michichilli balbalaa hundinuu roga afur afur qabu turan; isaanis karaa fuula duraatiin sadii sadiin walitti garagalfamanii turan.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.5",
            "verseOrgIds": [
              "1KI.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis galma utubaawwan hedduu qabu kan dhundhuma shantama lafa irra dheeratee dhundhuma soddoma balʼatu ijaare. Fuula galma sanaa duraanis gardaafoo tokkotu ture; gardaafoo sana duraan immoo utubaawwanii fi bantii utubaawwan sana irratti diriirfame tokkotu ture.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.6",
            "verseOrgIds": [
              "1KI.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis galma teessoo, iddoo itti murtii kennu galma laaftoo ijaaree lafa isaatii jalqabee hamma bantii isaatti muka birbirsaa itti uffise.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.7",
            "verseOrgIds": [
              "1KI.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Masaraan mootummaa kan akka inni keessa jiraatuuf ijaarame sunis gara dugda duubaatti hiiqee karooruma wal fakkaatuun hojjetame. Solomoon intala Faraʼoon kan fuudhe sanaaf illee masaraa mootummaa kan akkuma galma kanaa ijaare.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.8",
            "verseOrgIds": [
              "1KI.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ijaarsi sun hundinuu alaa jalqabee hamma oobdii guddichaatti, hundee irraa jalqabee hamma mataa keenyan manaatti dhagaa gatii guddaa kan safaramee muramee fi kan keessii fi duubni isaa magaaziidhaan miidhagfameen hojjetame.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.9",
            "verseOrgIds": [
              "1KI.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hundeen isaas dhagoota gurguddaa gatii guddaa qaban kanneen gariin isaanii dhundhuma kudhan gariin isaanii immoo dhundhuma saddeeti taʼaniin buufame.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.10",
            "verseOrgIds": [
              "1KI.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hundee kana irraanis dhagoota gatii guddaa kanneen safaramanii murmuramanii fi birbirsatu ture.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.11",
            "verseOrgIds": [
              "1KI.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oobdiin guddichis akkuma oobdii mana qulqullummaa",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.12",
            "verseOrgIds": [
              "1KI.7.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "1KI.7.12",
                "verseOrgIds": [
                  "1KI.7.12"
                ]
              }
            }
          ]
        },
        {
          "text": "kan keessaatii fi gardaafoo isaa sanaa keenyan manaa kan toora dhagaa soofamee ijaarame sadii fi toora saanqaa birbirsaa kan miidhagfamee hojjetame tokkoon marfame.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.12",
            "verseOrgIds": [
              "1KI.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Miʼa Mana Qulqullummaa",
          "type": "text"
        }
      ]
    },
