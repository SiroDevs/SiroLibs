    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiiraam mootichi Xiiroos yommuu akka Solomoon abbaa isaa Daawitin iddoo buʼuuf dibame dhagaʼetti ergamoota isaa gara Solomoonitti erge; Hiiraam yeroo kam iyyuu michuu Daawit tureetii.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.1",
            "verseOrgIds": [
              "1KI.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoonis akkana jedhee Hiiraamiif ergaa kana deebisee erge:",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.2",
            "verseOrgIds": [
              "1KI.5.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Akka Abbaan koo Daawit sababii waraana karaa hundaan isa marsee ture sanaatiif hamma",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.3",
            "verseOrgIds": [
              "1KI.5.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "1KI.5.3",
                "verseOrgIds": [
                  "1KI.5.17"
                ]
              }
            }
          ]
        },
        {
          "text": "diinota isaa miilla isaa jala galchuufitti Maqaa",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.3",
            "verseOrgIds": [
              "1KI.5.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "1KI.5.3",
                "verseOrgIds": [
                  "1KI.5.17"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa isaatiif mana qulqullummaa ijaaruu hin dandaʼin atuu beekta.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.3",
            "verseOrgIds": [
              "1KI.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amma garuu",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.4",
            "verseOrgIds": [
              "1KI.5.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "1KI.5.4",
                "verseOrgIds": [
                  "1KI.5.18"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni koo karaa hundaan boqonnaa naa kenneera; diinni yookaan balaan tokko iyyuu hin jiru.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.4",
            "verseOrgIds": [
              "1KI.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu ani amma akkuma",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.5",
            "verseOrgIds": [
              "1KI.5.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "1KI.5.5",
                "verseOrgIds": [
                  "1KI.5.19"
                ]
              }
            }
          ]
        },
        {
          "text": "abbaa koo Daawitiin, 'Ilmi kee kan ani iddoo kee teessoo kee irra teessisu Maqaa kootiif mana qulqullummaa ni ijaara' jedhe sanatti Maqaa",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.5",
            "verseOrgIds": [
              "1KI.5.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "1KI.5.5",
                "verseOrgIds": [
                  "1KI.5.19"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa kootiif mana qulqullummaa ijaaruu yaadeera.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.5",
            "verseOrgIds": [
              "1KI.5.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kanaafuu akka birbirsi Libaanoon naaf muramu ajaji. Namoonni koo namoota kee wajjin hojjetu; anis mindaa ati hojjettoota keetiif murteessitu kam iyyuu siifin kaffala. Akka nu muka baqaqsuu irratti akka Siidoonotaa ogeeyyii hin taʼin atuu beekta.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.6",
            "verseOrgIds": [
              "1KI.5.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiiraamis yommuu dhaamsa Solomoon sana dhagaʼetti akka malee gammadee, \"Harʼa",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.7",
            "verseOrgIds": [
              "1KI.5.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "1KI.5.7",
                "verseOrgIds": [
                  "1KI.5.21"
                ]
              }
            }
          ]
        },
        {
          "text": "haa eebbifamu; inni akka Solomoon saba guddaa kana bulchuuf ilma ogeessa kana Daawitiif kenneeraatii\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.7",
            "verseOrgIds": [
              "1KI.5.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu Hiiraam akkana jedhee Solomoonitti ergaa erge:",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.8",
            "verseOrgIds": [
              "1KI.5.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "1KI 5:8"
      },
      "items": [
        {
          "text": "\"Ani ergaa ati naa ergite argadheera; birbirsaa fi jirma birbirsaa dhiʼeessuudhaan waan ati barbaaddu hunda siifan godha.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.8",
            "verseOrgIds": [
              "1KI.5.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoonni koo Libaanoon irraa gara galaanaatti gad fidu; anis walitti hidhee lafa ati filattutti galaana irra siifan erga; achittis gargari nan hiika. Atis muka sana ni fudhatta; warra mana koo jiraataniif immoo nyaata dhiʼeessuudhaan fedhii koo guutta.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.9",
            "verseOrgIds": [
              "1KI.5.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiiroomis akkasiin birbirsaa fi jirma birbirsaa kan Solomooniif barbaachisu dhiʼeessaafii ture.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.10",
            "verseOrgIds": [
              "1KI.5.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoonis akka warra mana Hiiraam jiraataniif nyaata taʼuuf qamadii safartuu qoroosii kuma digdamaa fi zayitii ejersaa kan cuunfame koorii kuma digdama kenne. Solomoon ittuma fufee wagguma waggaan waan kana Hiiraamiif kennaa ture.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.11",
            "verseOrgIds": [
              "1KI.5.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyos",
              "type": "text",
              "attrs": {
                "verseId": "1KI.5.12",
                "verseOrgIds": [
                  "1KI.5.26"
                ]
              }
            }
          ]
        },
        {
          "text": "akkuma isa abdachiisetti Solomooniif ogummaa ni kenne. Hiiraamii fi Solomoon gidduu walitti dhufeenya nagaatu ture; isaan lamaanuu walii galtee godhatan.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.12",
            "verseOrgIds": [
              "1KI.5.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoon mootichis Israaʼel hunda keessaa namoota dirqiidhaan hojii humnaa hojjetan kuma soddoma walitti qabe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.13",
            "verseOrgIds": [
              "1KI.5.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis akka isaan jiʼa tokko Libaanoon keessa, jiʼa lamaa immoo mana isaanii turaniif jedhee, jiʼa tokko tokkoof nama kuma kudhan qoodee Libaanoonitti erge. Adooniiraam immoo itti gaafatamaa namoota dirqiidhaan hojii humnaa hojjetanii ture.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.14",
            "verseOrgIds": [
              "1KI.5.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoon namoota baʼaa baatan kuma torbaatamaa fi warra dhagaa cabsan kuma saddeettama gaarran keessaa qaba ture;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.15",
            "verseOrgIds": [
              "1KI.5.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "akkasumas namoota hojii hojjechiisanii hojjettoota illee toʼatan kuma sadii fi dhibba sadii qaba ture.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.16",
            "verseOrgIds": [
              "1KI.5.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis mootichi ajaja kenninaan dhagoota soofamaniin hundee mana qulqullummaa buusuudhaaf dhagoota gurguddaa fi dhagoota gatii guddaa fidan.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.17",
            "verseOrgIds": [
              "1KI.5.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogeeyyiin hojii harkaa Solomoonii fi Hiiroom akkasumas namoonni Gebaal mana qulqullummaa ijaaruuf mukaa fi dhagaa cabsanii qopheessan.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.18",
            "verseOrgIds": [
              "1KI.5.32"
            ]
          }
        }
      ]
    }
  ],
