  "verseCount": 44,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "EZR 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Uummanni Cubbuu Isaa Himate",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZR 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utuma Izraan mana Waaqaa duratti lafaan of dhaʼee booʼaa, cubbuu himachaa, kadhachaa jiruu Israaʼeloonni akka malee hedduun dhiironni, dubartoonnii fi ijoolleen naannoo isaatti walitti ni qabaman. Isaanis hiqqifatanii booʼan.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.1",
            "verseOrgIds": [
              "EZR.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZR 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasiis sanyii Eelaam keessaa Shekaaniyaan ilmi Yehiiʼeel Izraadhaan akkana jedhe; \"Nu waan saboota naannoo keenya jiraatan keessaa dubartoota ormaa fuuneef Waaqa keenyaaf hin amanamne. Wanni kun taʼu illee amma iyyuu Israaʼeliif abdiin jira.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.2",
            "verseOrgIds": [
              "EZR.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZR 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu kottaa akkuma gorsa gooftaa koo fi kan warra ajaja Waaqa keenyaa sodaatanitti dubartoota kanneenii fi ijoollee isaanii hunda of irraa geggeessuuf fuula Waaqa keenyaa duratti kakuu ni galla. Kunis akkuma Seeraatti haa raawwatamu.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.3",
            "verseOrgIds": [
              "EZR.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZR 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaʼi; wanni kun suma harka jira. Nu si deeggarra; egaa jabaadhuu hojjedhu.\"",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.4",
            "verseOrgIds": [
              "EZR.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZR 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu Izraan kaʼee akka isaan waan jedhame sana raawwataniif luboota hangafoota, Lewwotaa fi Israaʼel hunda ni kakachiise; isaanis ni kakatan.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.5",
            "verseOrgIds": [
              "EZR.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZR 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasii Izraan fuula mana Waaqaa duraa kaʼee kutaa manaa kan Yehohaanaan ilma Eliyaashiib seene. Inni yeroo achi turetti nyaata tokko illee hin nyaanne; bishaanis hin dhugne; sababii amanamummaa dhabiisa warra boojuudhaa deebiʼaniif gaddaa tureetii.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.6",
            "verseOrgIds": [
              "EZR.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZR 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasii akka warri boojuudhaa deebiʼan hundi Yerusaalem keessatti walitti qabamaniif Yihuudaa fi Yerusaalem guutuu keessatti labsiin ni labsame.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.7",
            "verseOrgIds": [
              "EZR.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZR 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni kam iyyuu bultii sadii keessatti yoo dhiʼaachuu baate akkuma murtii qondaaltotaa fi maanguddootaatti qabeenyi isaa hundi irraa ni fudhatama; inni mataan isaas waldaa warra boojuudhaa deebiʼee keessaa ni ariʼama.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.8",
            "verseOrgIds": [
              "EZR.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZR 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bultii sadan sana keessatti namoonni Yihuudaa fi Beniyaam hundi Yerusaalem keessatti walitti qabaman. Bultii digdammaffaa jiʼa saglaffaatti namoonni hundi sababii waan kanaa fi sababii rooba guddaatiif akka malee raafamanii oobdii mana Waaqaa dura jiru irra ni tataaʼan.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.9",
            "verseOrgIds": [
              "EZR.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZR 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izraan lubichi ol kaʼee akkana isaaniin jedhe; \"Isin amanamoo hin turre; dubartoota ormaa fuudhuudhaanis Israaʼel irratti yakka dabaltaniirtu.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.10",
            "verseOrgIds": [
              "EZR.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZR 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egaa amma cubbuu keessan",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.11",
            "verseOrgIds": [
              "EZR.10.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "EZR.10.11",
                "verseOrgIds": [
                  "EZR.10.11"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa abbootii keessanitti himadhaatii fedhii isaa guutaa. Saboota naannoo keessan jiraatanii fi niitota warra ormaa keessaa fuutaniin gargar baʼaa.\"",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.11",
            "verseOrgIds": [
              "EZR.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZR 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guutummaan waldaa sanaa akkana jedhee sagalee guddaadhaan deebise: \"Ati sirrii dha! Nu akkuma ati jette gochuu qabna.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.12",
            "verseOrgIds": [
              "EZR.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZR 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu nama hedduutu as jira; yeroon kunis yeroo roobaa ti; kanaafuu nu ala dhaabachuu hin dandeenyu. Sababii nu waan kana keessatti cubbuu guddaa hojjenneef wanni kun guyyaa tokkotti yookaan guyyaa lamatti fala argachuu hin dandaʼu.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.13",
            "verseOrgIds": [
              "EZR.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZR 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qondaaltonni keenya iddoo waldaa guutuu haa buʼan. Ergasii namni magaalaawwan keenyaa kan dubartii ormaa fuudhe kam iyyuu hamma dheekkamsi Waaqa keenyaa sodaachisaan sababii waan kanaatiif dhufe sun nurraa deebiʼutti maanguddootaa fi abbootii murtii tokkoo tokkoo magaalaa wajjin yeroo murteeffametti haa dhufu.\"",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.14",
            "verseOrgIds": [
              "EZR.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZR 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoonaataan ilma Asaaheelii fi Yahizeyaa ilma Tiqwaa qofatu waan kana morme; Meshulaamii fi Shaabetaayi Lewwichi immoo isaan deeggaran.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.15",
            "verseOrgIds": [
              "EZR.10.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZR 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Warri boojuudhaa deebiʼan sunis akkasuma godhan. Izraan lubichis namoota hangafoota maatii taʼan tokkoo tokkoo garee maatii keessaa nama tokko filatee hunduma isaanii maqaa maqaan ramade. Isaanis bultii tokkoffaa jiʼa kurnaffaatti dhimma sana qorachuudhaaf tataaʼanii",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.16",
            "verseOrgIds": [
              "EZR.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZR 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "guyyaa tokkoffaa jiʼa jalqabaatti waaʼee namoota dubartoota ormaa fuudhan hundaa qoratanii fixan.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.17",
            "verseOrgIds": [
              "EZR.10.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Namoota Dubartoota Ormaa Fuudhan",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "lh"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZR 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sanyii lubootaa keessaa namoonni dubartoonni ormaa fuudhan kanneenii dha:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "EZR 10:18"
      },
      "items": [
        {
          "text": "Sanyii Iyyaasuu ilma Yoozaadaaqii fi obboloota isaa keessaa:",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.18",
            "verseOrgIds": [
              "EZR.10.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "EZR 10:18"
      },
      "items": [
        {
          "text": "Maʼaseyaa, Eliiʼezer, Yaariibii fi Gedaaliyaas.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.18",
            "verseOrgIds": [
              "EZR.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZR 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan hundinuu niitota isaanii hiikuudhaaf waadaa ni galan; tokkoon tokkoon isaanii balleessaa ofii isaaniitiif bushaayee keessaa korbeessa hoolaa tokko aarsaa yakkaatiif ni dhiʼeessan.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.19",
            "verseOrgIds": [
              "EZR.10.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZR 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sanyii Imeer keessaa:",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.20",
            "verseOrgIds": [
              "EZR.10.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "EZR 10:20"
      },
      "items": [
        {
          "text": "Hanaanii fi Zebaadiyaa.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.20",
            "verseOrgIds": [
              "EZR.10.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZR 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sanyii Haariim keessaa:",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.21",
            "verseOrgIds": [
              "EZR.10.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "EZR 10:21"
      },
      "items": [
        {
          "text": "Maʼaseyaa, Eeliyaas, Shemaaʼiyaa, Yehiiʼeelii fi Uziyaa.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.21",
            "verseOrgIds": [
              "EZR.10.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZR 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sanyii Phaashihuur keessaa:",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.22",
            "verseOrgIds": [
              "EZR.10.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "EZR 10:22"
      },
      "items": [
        {
          "text": "Eliiyooʼeenayi, Maʼaseyaa, Ishmaaʼeel, Naatnaaʼel, Yoozaabaadii fi Eleʼaasaa.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.22",
            "verseOrgIds": [
              "EZR.10.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "lh"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZR 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lewwota keessaa immoo:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "EZR 10:23"
      },
      "items": [
        {
          "text": "Yoozaabaad, Shimeʼii, Qeelaayaa isa Qeliixaa jedhamu sana, Phetaayaa, Yihuudaa fi Eliiʼezer.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.23",
            "verseOrgIds": [
