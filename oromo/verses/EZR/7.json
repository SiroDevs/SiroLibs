  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "EZR 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Izraan Yerusaalem Dhufe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZR 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wantoota kanneen booddee bara Arxeksis mooticha Faares keessa Izraan ilmi Seraayaa, ilmi Azaariyaa ilmi Hilqiyaa,",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.1",
            "verseOrgIds": [
              "EZR.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZR 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ilmi Shaluum, ilmi Zaadoq, ilmi Ahiixuub,",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.2",
            "verseOrgIds": [
              "EZR.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZR 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ilmi Amariyaa, ilmi Azaariyaa, ilmi Meraayoot,",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.3",
            "verseOrgIds": [
              "EZR.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZR 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ilmi Zeraayaa, ilmi Uzii, ilmi Bukii,",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.4",
            "verseOrgIds": [
              "EZR.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZR 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ilmi Abiishuuwaa, ilmi Fiinehaas, ilmi Eleʼaazaar, ilmi Aroon lubicha ol aanaa",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.5",
            "verseOrgIds": [
              "EZR.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZR 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izraan kun Baabilonii dhufe. Innis barsiisaa Seera Musee kan",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.6",
            "verseOrgIds": [
              "EZR.7.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "EZR.7.6",
                "verseOrgIds": [
                  "EZR.7.6"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni Israaʼel kenne sana sirriitti beekuu dha. Sababii harki",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.6",
            "verseOrgIds": [
              "EZR.7.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "EZR.7.6",
                "verseOrgIds": [
                  "EZR.7.6"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa isaa isa irra tureef mootichi waan inni kadhate hunda ni kenneef.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.6",
            "verseOrgIds": [
              "EZR.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZR 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkasumas waggaa torbaffaa bara Arxeksis Mootichaa keessa Israaʼeloonni tokko tokko jechuunis luboonni, Lewwonni, faarfattoonni, eegdonni karraa fi tajaajiltoonni mana qulqullummaa gara Yerusaalemitti ol baʼan.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.7",
            "verseOrgIds": [
              "EZR.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZR 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izraanis waggaa torbaffaa bara mootii sanaa keessa jiʼa shanaffaatti Yerusaalem gaʼe.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.8",
            "verseOrgIds": [
              "EZR.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZR 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis bultii tokkoffaa jiʼa jalqabaatti karaa isaa Baabilonii jalqabee bultii tokkoffaa jiʼa shanaffaatti Yerusaalem gaʼe; harki Waaqa isaa tolaan sun isa irra tureetii.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.9",
            "verseOrgIds": [
              "EZR.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZR 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izraan Seera",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.10",
            "verseOrgIds": [
              "EZR.7.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "EZR.7.10",
                "verseOrgIds": [
                  "EZR.7.10"
                ]
              }
            }
          ]
        },
        {
          "text": "quʼachuu fi eeguudhaaf akkasumas labsii fi ajaja seerichaa Israaʼel keessatti barsiisuudhaaf of kennee tureetii.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.10",
            "verseOrgIds": [
              "EZR.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Xalayaa Arxeksis Mootichi Izraatti Erge",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZR 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kun garagalcha xalayaa Arxeksis Mootichi Izraa lubichaa fi barsiisaa, namicha waaʼee ajajaa fi labsiiwwan",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.11",
            "verseOrgIds": [
              "EZR.7.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "EZR.7.11",
                "verseOrgIds": [
                  "EZR.7.11"
                ]
              }
            }
          ]
        },
        {
          "text": "Israaʼeliif kenne sanaa baratetti ergee ti:",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.11",
            "verseOrgIds": [
              "EZR.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pmo"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZR 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arxeksis mootii moototaa irraa;",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.12",
            "verseOrgIds": [
              "EZR.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pmo",
        "vid": "EZR 7:12"
      },
      "items": [
        {
          "text": "Gara Izraa lubicha, barsiisaa Seera Waaqa samiitti:",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.12",
            "verseOrgIds": [
              "EZR.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pmo",
        "vid": "EZR 7:12"
      },
      "items": [
        {
          "text": "Nagaan siif haa taʼu.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.12",
            "verseOrgIds": [
              "EZR.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZR 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani amma akka namni Israaʼel kan mootummaa koo keessa jiraatu kam iyyuu luboonnii fi Lewwonni illee abbaan si wajjin Yerusaalem dhaquu barbaadu dhaquu dandaʼu labseera.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.13",
            "verseOrgIds": [
              "EZR.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZR 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati akka akkuma Seera Waaqa keetii kan harka kee jiru sanaatti waaʼee Yihuudaa fi Yerusaalem qorattuuf mootichaa fi gorsitoota isaa torbaan ergamteerta.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.14",
            "verseOrgIds": [
              "EZR.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZR 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana irrattis meetii fi warqee mootichii fi gorsitoonni isaa Waaqa Israaʼel kan Yerusaalem keessa jiraatuuf toluma kennan sana fuudhii deemi;",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.15",
            "verseOrgIds": [
              "EZR.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZR 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "waan kanas meetii fi warqee kutaa biyya Baabiloniitii walitti qabde hundaa fi kennaa sabnii fi luboonni mana qulqullummaa Waaqa isaanii kan Yerusaalem keessaaf fedhiidhaan kennan wajjin fuudhii dhaqi.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.16",
            "verseOrgIds": [
              "EZR.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZR 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maallaqa kanaanis jiboota, korbeeyyii hoolaa fi xobbaallaa hoolaa, kennaa midhaanii fi dhibaayyuu isaanii wajjin bitaatii iddoo aarsaa mana qulqullummaa Waaqa keessanii kan Yerusaalem sana irratti dhiʼeessaa.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.17",
            "verseOrgIds": [
              "EZR.7.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZR 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasii atii fi obboloonni kee Yihuudoonni meetii fi warqee hafe akkuma fedhii Waaqa keessaniitti waanuma gaarii isinitti fakkaate irra oolchaa.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.18",
            "verseOrgIds": [
              "EZR.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZR 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miʼa waaqeffannaa mana qulqullummaa Waaqa keetii keessaaf imaanaa sitti kenname hunda Waaqa Yerusaalem duratti dhiʼeessi.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.19",
            "verseOrgIds": [
              "EZR.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZR 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan mana qulqullummaa Waaqa keetiif barbaadamu kan kennuu feetu hunda mankuusa mootii keessaa fuudhii kenni.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.20",
            "verseOrgIds": [
              "EZR.7.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZR 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egaa ani Arxeksis Mootichi akka qabdoonni maallaqaa kanneen Gama Laga Efraaxiis jiran waan Izraan lubichi, barsiisaan Seera Waaqa samii kun isin gaafatu hunda arjummaadhaan isaaf kennan ajajeera;",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.21",
            "verseOrgIds": [
              "EZR.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZR 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "kunis hamma meetii taalaantii dhibba tokko, qamadii qoroosii",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.22",
            "verseOrgIds": [
              "EZR.7.22"
            ]
          }
        },
        {
          "text": "dhibba tokko, daadhii wayinii baadoosii",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.22",
            "verseOrgIds": [
              "EZR.7.22"
            ]
          }
        },
        {
          "text": "dhibba tokko, zayitii ejersaa baadoosii dhibba tokkoo fi soogidda hamma hin qabne haa taʼu.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.22",
            "verseOrgIds": [
              "EZR.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZR 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wanni Waaqni samii ajaje kam iyyuu mana qulqullummaa Waaqa samiitiif of eeggannaadhaan haa godhamu. Maaliif dheekkamsi mootichaa fi ilmaan mootichaatti dhufa?",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.23",
            "verseOrgIds": [
              "EZR.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZR 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amma illee isin akka luboota, Lewwota, faarfattoota, eegdota karraa, tajaajiltoota mana qulqullummaa yookaan hojjettoota mana Waaqaa kana keessa hojjetan kamitti iyyuu gibira, qaraxaa fi ashuuraa murteessuuf aangoo hin qabne beekaa.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.24",
            "verseOrgIds": [
              "EZR.7.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
