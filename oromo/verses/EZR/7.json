          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqa fuula mootichaa, fuula gorsitoota mootichaa fi fuula qondaaltota mootichaa ciccimoo hundaa duratti gaarummaa ofii isaa na argisiiseef galanni haa gaʼu. Sababii harki",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.28",
            "verseOrgIds": [
              "EZR.7.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "EZR.7.28",
                "verseOrgIds": [
                  "EZR.7.28"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa koo anarra tureef ani jajjabaadheen akka isaan na wajjin deemaniif Israaʼel keessaa namoota bebeekamoo walitti nan qabadhe.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.28",
