                "verseId": "EZR.7.27",
                "verseOrgIds": [
                  "EZR.7.27"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni abbootii keenyaa kan akka inni karaa kanaan mana",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.27",
            "verseOrgIds": [
              "EZR.7.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "EZR.7.27",
                "verseOrgIds": [
                  "EZR.7.27"
                ]
              }
            }
          ]
        },
        {
          "text": "kan Yerusaalem keessa jiruuf ulfina kennuuf garaa mootichaa keessa yaada kana kaaʼe sun haa galateeffamu;",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.27",
            "verseOrgIds": [
              "EZR.7.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
