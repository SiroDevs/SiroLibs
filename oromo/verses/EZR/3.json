    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Iddoo Aarsaa Deebisanii Tolchuu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZR 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo jiʼi torbaffaan dhufee Israaʼeloonni magaalaawwan isaanii keessa qubatanitti uummanni akkuma nama tokkootti Yerusaalem keessatti walitti qabame.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.1",
            "verseOrgIds": [
              "EZR.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZR 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasiis Yeeshuuʼaan ilmi Yoozaadaaq firoota isaa luboota wajjin, Zarubaabel ilmi Sheʼaltiiʼeel firoota isaa wajjin akkuma Seera Musee nama Waaqaa sanaa keessatti barreeffametti aarsaa gubamu achi irratti dhiʼeessuudhaaf iddoo aarsaa Waaqa Israaʼel ijaaran.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.2",
            "verseOrgIds": [
              "EZR.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZR 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis sababii namoota naannoo isaanii sodaataniif iddoo aarsaa sana hundee isaa irratti ijaaranii achi irratti aarsaa gubamu",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.3",
            "verseOrgIds": [
              "EZR.3.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoof",
              "type": "text",
              "attrs": {
                "verseId": "EZR.3.3",
                "verseOrgIds": [
                  "EZR.3.3"
                ]
              }
            }
          ]
        },
        {
          "text": "dhiʼeessan; aarsaa kanas ganamaa fi galgala dhiʼeessan.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.3",
            "verseOrgIds": [
              "EZR.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZR 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasii akkuma barreeffametti Ayyaana Daasii ni ayyaaneffatan; akkuma baayʼina aarsaa guyyaa guyyaaf ramadameettis aarsaa gubamu ni dhiʼeessan.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.4",
            "verseOrgIds": [
              "EZR.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZR 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana booddees isaan aarsaa gubamu kan yeroo yerootti dhiʼeeffamu, aarsaa Baatii Haaraa fi aarsaawwan ayyaanota",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.5",
            "verseOrgIds": [
              "EZR.3.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoof",
              "type": "text",
              "attrs": {
                "verseId": "EZR.3.5",
                "verseOrgIds": [
                  "EZR.3.5"
                ]
              }
            }
          ]
        },
        {
          "text": "qulqulleeffaman hundaaf, akkasumas kanneen fedhiidhaan",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.5",
            "verseOrgIds": [
              "EZR.3.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoof",
              "type": "text",
              "attrs": {
                "verseId": "EZR.3.5",
                "verseOrgIds": [
                  "EZR.3.5"
                ]
              }
            }
          ]
        },
        {
          "text": "dhiʼeeffaman ni kennan.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.5",
            "verseOrgIds": [
              "EZR.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZR 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyyaa jalqaba jiʼa torbaffaattis aarsaa gubamu",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.6",
            "verseOrgIds": [
              "EZR.3.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoof",
              "type": "text",
              "attrs": {
                "verseId": "EZR.3.6",
                "verseOrgIds": [
                  "EZR.3.6"
                ]
              }
            }
          ]
        },
        {
          "text": "dhiʼeessuu jalqaban; garuu hundeen mana qulqullummaa",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.6",
            "verseOrgIds": [
              "EZR.3.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "EZR.3.6",
                "verseOrgIds": [
                  "EZR.3.6"
                ]
              }
            }
          ]
        },
        {
          "text": "amma illee hin buufamne ture.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.6",
            "verseOrgIds": [
              "EZR.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mana Qulqullummaa Deebisanii Ijaaruu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZR 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasii isaan warra dhagaa cabsanii fi ogeeyyii hojii mukaatiif maallaqa kennan; warra Siidoonaa fi Xiiroosiif immoo akka isaan akkuma Qiiros mootichi Faares ajaje sanatti Libaanoonii gara Yoopheetti galaana irra birbirsa gad erganiif nyaata, dhugaatii fi zayitii kennan.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.7",
            "verseOrgIds": [
              "EZR.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZR 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis erga mana Waaqaa kan Yerusaalem keessaa sana gaʼanii booddee jiʼa lammaffaa waggaa lammaffaatti Zarubaabel ilmi Sheʼaltiiʼeel, Yeeshuuʼaan ilmi Yoozaadaaqii fi obboloonni isaanii kaan jechuunis luboonni, Lewwonnii fi warri boojuudhaa Yerusaalemitti deebiʼan hundinuu akka isaan ijaarsa mana",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.8",
            "verseOrgIds": [
              "EZR.3.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "EZR.3.8",
                "verseOrgIds": [
                  "EZR.3.8"
                ]
              }
            }
          ]
        },
        {
          "text": "toʼataniif Lewwota umuriin isaanii Waggaa digdamaa fi hammasii olii muudanii hojii sana jalqaban.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.8",
            "verseOrgIds": [
              "EZR.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZR 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeeshuuʼaan ilmaan isaa fi obboloota isaa wajjin, Qadmiiʼeelii fi ilmaan isaa, ilmaan Yihuudaa, ilmaan Heenaadaadii fi Lewwota, ilmaan isaanii fi firoota isaanii wajjin warra mana Waaqaa ijaaran toʼachuuf tokko taʼan.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.9",
            "verseOrgIds": [
              "EZR.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZR 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yommuu ijaartonni sun hundee mana qulqullummaa",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.10",
            "verseOrgIds": [
              "EZR.3.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "EZR.3.10",
                "verseOrgIds": [
                  "EZR.3.10"
                ]
              }
            }
          ]
        },
        {
          "text": "buusanitti luboonni uffata isaanii uffatanii malakata qabatan; Lewwonni immoo jechuunis ilmaan Asaaf kilillee qabatanii akkuma Daawit Mootichi Israaʼel ajajetti",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.10",
            "verseOrgIds": [
              "EZR.3.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text",
              "attrs": {
                "verseId": "EZR.3.10",
                "verseOrgIds": [
                  "EZR.3.10"
                ]
              }
            }
          ]
        },
        {
          "text": "jajachuuf iddoo ofii isaanii qabatan.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.10",
            "verseOrgIds": [
              "EZR.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZR 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis,",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.11",
            "verseOrgIds": [
              "EZR.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZR 3:11"
      },
      "items": [
        {
          "text": "\"Inni gaarii dha;",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.11",
            "verseOrgIds": [
              "EZR.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZR 3:11"
      },
      "items": [
        {
          "text": "jaalalli inni Israaʼeliif qabu bara baraan jiraata\"",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.11",
            "verseOrgIds": [
              "EZR.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m",
        "vid": "EZR 3:11"
      },
      "items": [
        {
          "text": "jedhanii leellisuu fi galateeffachuudhaan",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.11",
            "verseOrgIds": [
              "EZR.3.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text",
              "attrs": {
                "verseId": "EZR.3.11",
                "verseOrgIds": [
                  "EZR.3.11"
                ]
              }
            }
          ]
        },
        {
          "text": "faarfatan. Sabni hundinuu sababii hundeen mana qulqullummaa",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.11",
            "verseOrgIds": [
              "EZR.3.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "EZR.3.11",
                "verseOrgIds": [
                  "EZR.3.11"
                ]
              }
            }
          ]
        },
        {
          "text": "buufameef iyyee sagalee guddaadhaan",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.11",
            "verseOrgIds": [
              "EZR.3.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text",
              "attrs": {
                "verseId": "EZR.3.11",
                "verseOrgIds": [
                  "EZR.3.11"
                ]
              }
            }
          ]
        },
        {
          "text": "galateeffate.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.11",
            "verseOrgIds": [
              "EZR.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZR 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu luboonni, Lewwonnii fi hangafoonni maatii warri durii kanneen mana qulqullummaa isa duraa sana argan hedduun yeroo hundeen mana qulqullummaa kanaa buufamu arganitti sagalee ol fudhatanii booʼan; warri kaan hedduun immoo gammachuudhaan iyyan.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.12",
            "verseOrgIds": [
              "EZR.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZR 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sababii namoonni akka malee wacaniif namni tokko iyyuu iyya gammachuu fi iyya booʼichaa gargar baasuu hin dandeenye; sagaleen sunis fagootti dhagaʼama ture.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.13",
            "verseOrgIds": [
              "EZR.3.13"
            ]
          }
        }
      ]
    }
  ],
