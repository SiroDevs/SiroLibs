                "verseId": "DEU.6.22",
                "verseOrgIds": [
                  "DEU.6.22"
                ]
              }
            }
          ]
        },
        {
          "text": "fuuluma keenya duratti biyya Gibxitti, Faraʼoonii fi namoota mana isaa keessa jiraatan hunda irratti mallattoo fi dinqiiwwan sodaachisaa fi gurguddaa hojjete.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.22",
            "verseOrgIds": [
              "DEU.6.22"
            ]
          }
        },
        {
