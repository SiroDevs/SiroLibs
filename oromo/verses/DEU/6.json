              "type": "text",
              "attrs": {
                "verseId": "DEU.6.20",
                "verseOrgIds": [
                  "DEU.6.20"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni keenya isin ajaje kanaa maali?\" jedhee si gaafate,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.20",
            "verseOrgIds": [
              "DEU.6.20"
            ]
          }
        },
        {
