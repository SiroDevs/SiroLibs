              "attrs": {
                "verseId": "DEU.6.21",
                "verseOrgIds": [
                  "DEU.6.21"
                ]
              }
            }
          ]
        },
        {
          "text": "garuu harka jabaadhaan Gibxii baasee nu fide.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.21",
            "verseOrgIds": [
              "DEU.6.21"
            ]
          }
        },
        {
