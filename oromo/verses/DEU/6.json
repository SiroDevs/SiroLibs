                "verseOrgIds": [
                  "DEU.6.24"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa keenya sodaannu nu ajaje.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.24",
            "verseOrgIds": [
              "DEU.6.24"
            ]
