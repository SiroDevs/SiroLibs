                "verseOrgIds": [
                  "DEU.6.24"
                ]
              }
            }
          ]
        },
        {
          "text": "akka nu akkuma amma jirru kanatti yeroo hunda nutti tolee jiraannuuf akka nu ajajawwan kanneen hunda eegnuu fi akka",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.24",
            "verseOrgIds": [
