                ]
              }
            }
          ]
        },
        {
          "text": "garuu waan sababii keessaniif natti dheekkameef, na dhagaʼuu dide.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.26",
            "verseOrgIds": [
