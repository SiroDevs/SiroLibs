    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hin Dagatin",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isin akka lubbuun jiraattan, akka baayʼattanii fi akka biyya",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.1",
            "verseOrgIds": [
              "DEU.8.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.8.1",
                "verseOrgIds": [
                  "DEU.8.1"
                ]
              }
            }
          ]
        },
        {
          "text": "kakuudhaan abbootii keessan abdachiise sanatti galtanii dhaaltaniif ajaja ani harʼa siif kennu hunda of eeggannaadhaan duukaa buʼaa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.1",
            "verseOrgIds": [
              "DEU.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.8.2",
                "verseOrgIds": [
                  "DEU.8.2"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni kee gad si qabee si qoruudhaan waan garaa kee keessa jiru jechuunis akka ati ajajawwan isaa eegduu fi hin eegne beekuuf karaa inni waggoota afurtamman kanneen guutuu gammoojjii keessa si qajeelche yaadadhu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.2",
            "verseOrgIds": [
              "DEU.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis gad si deebisee si beelessee \"mannaa\" ati yookaan abbootiin kee hin beekin si soore; kunis akka namni dubbii afaan",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.3",
            "verseOrgIds": [
              "DEU.8.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyootii",
              "type": "text",
              "attrs": {
                "verseId": "DEU.8.3",
                "verseOrgIds": [
                  "DEU.8.3"
                ]
              }
            }
          ]
        },
        {
          "text": "baʼu hundaan malee buddeena qofaan hin jiraanne si barsiisuuf.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.3",
            "verseOrgIds": [
              "DEU.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waggoota afurtamman kanneen keessa uffanni kee hin dhumne; miilli kees hin iitofne.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.4",
            "verseOrgIds": [
              "DEU.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.5",
            "verseOrgIds": [
              "DEU.8.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.8.5",
                "verseOrgIds": [
                  "DEU.8.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni kee akkuma abbaan ilma isaa adabatu akka si adabu beeki.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.5",
            "verseOrgIds": [
              "DEU.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daandiiwwan isaa irra deemuu fi isa sodaachuudhaan ajajawwan",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.6",
            "verseOrgIds": [
              "DEU.8.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.8.6",
                "verseOrgIds": [
                  "DEU.8.6"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa keetii eegi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.6",
            "verseOrgIds": [
              "DEU.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.8.7",
                "verseOrgIds": [
                  "DEU.8.7"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni kee biyya gaarii kan lageen, haroowwanii fi burqaawwan sululootaa fi gaarran keessaa yaaʼaniitti si galchaatii.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.7",
            "verseOrgIds": [
              "DEU.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biyya qamadii fi garbuu, wayinii fi harbuu, roomaanii, zayitii ejersaatii fi damma baasutti,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.8",
            "verseOrgIds": [
              "DEU.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "biyya ati hirʼina malee buddeena nyaattuu fi biyya ati keessaa homaa hin dhabne, biyya kattaan sibiila taʼe, biyya ati gaarran keessaa sibiila diimaa baasuu dandeessuu dha.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.9",
            "verseOrgIds": [
              "DEU.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo nyaattee quuftutti, sababii",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.10",
            "verseOrgIds": [
              "DEU.8.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.8.10",
                "verseOrgIds": [
                  "DEU.8.10"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqni kee biyya gaarii akkasii siif kenneef isa jajadhu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.10",
            "verseOrgIds": [
              "DEU.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati akka ajajawwan, qajeelfamawwanii fi seerawwan isaa kanneen ani harʼa siif kennu eeguu baachuudhaan",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.11",
            "verseOrgIds": [
              "DEU.8.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.8.11",
                "verseOrgIds": [
                  "DEU.8.11"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa kee hin daganne of eeggadhu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.11",
            "verseOrgIds": [
              "DEU.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoo kanaa achii yommuu nyaattee quuftutti, yommuu mana gaarii ijaarrattee keessa jiraattutti,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.12",
            "verseOrgIds": [
              "DEU.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "yommuu loonii fi bushaayeen kee wal horanii meetii fi warqeen kee dabaluu fi yommuu wanni ati qabdu hundi baayʼatutti,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.13",
            "verseOrgIds": [
              "DEU.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ati of tuultee",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.14",
            "verseOrgIds": [
              "DEU.8.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.8.14",
                "verseOrgIds": [
                  "DEU.8.14"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa kee isa biyya Gibxi, biyya garbummaatii baasee si fide sana ni dagatta.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.14",
            "verseOrgIds": [
              "DEU.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni gammoojjii balʼaa fi sodaachisaa, biyya dheebuutii fi kan bishaan hin qabne, biyya bofa hadhaa qabuu fi torbaanqabaan keessa guute sana keessa si deemsise. Kattaa jabaa keessaas bishaan siif burqisiise.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.15",
            "verseOrgIds": [
              "DEU.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka dhuma irratti sitti toluuf jedhee gad si qabuu fi si qoruudhaaf, waan takkumaa abbootiin kee hin beekin gammoojjii keessatti \"mannaa\" ati nyaattu siif kenne.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.16",
            "verseOrgIds": [
              "DEU.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati, \"Humna kootii fi jabina harka kootu qabeenya kana naaf argamsiise jettee\" yaadda taʼa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.17",
            "verseOrgIds": [
              "DEU.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.18",
            "verseOrgIds": [
              "DEU.8.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.8.18",
                "verseOrgIds": [
                  "DEU.8.18"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa kee yaadadhu; kan akkuma harʼa jiru kanatti akka ati qabeenya horattuuf dandeettii siif kennee waadaa kakuudhaan abbootii keetiif gale sana siif eege isaatii.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.18",
            "verseOrgIds": [
              "DEU.8.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoo ati",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.19",
            "verseOrgIds": [
              "DEU.8.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.8.19",
                "verseOrgIds": [
                  "DEU.8.19"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa kee irraanfattee waaqota biraa duukaa buute, yoo isaan waaqeffattee fi isaaniif sagadde akka isin dhugumaan baddan ani harʼa dhugaa isinitti nan baʼa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.19",
            "verseOrgIds": [
              "DEU.8.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkuma Saboota",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.20",
            "verseOrgIds": [
              "DEU.8.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.8.20",
                "verseOrgIds": [
                  "DEU.8.20"
                ]
              }
            }
          ]
        },
        {
          "text": "fuula keessan duraa balleesse sanaa",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.20",
            "verseOrgIds": [
              "DEU.8.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "DEU.8.20",
                "verseOrgIds": [
                  "DEU.8.20"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa keessaniif waan ajajamuu didaniif akkasuma isinis ni balleeffamtu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.8.20",
            "verseOrgIds": [
              "DEU.8.20"
            ]
          }
        }
      ]
    }
  ],
