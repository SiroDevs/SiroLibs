  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "GAL 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nama Hundumaaf Waan Gaarii Gochuu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GAL 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa obboloota, yoo namni tokko cubbuu keessa seene, isin warri hafuuraan jiraattan garraamummaan isa deebisuu qabdu. Garuu atis akka hin qoramneef of eeggadhu.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.1",
            "verseOrgIds": [
              "GAL.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GAL 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isin baʼaa walii baadhaa; akkasiin isin seera Kiristoos ni eegdu.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.2",
            "verseOrgIds": [
              "GAL.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GAL 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni tokko utuu waan tokko iyyuu hin taʼin, waan waa tokko taʼe yoo of seʼe, inni of gowwoomsa.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.3",
            "verseOrgIds": [
              "GAL.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GAL 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tokkoon tokkoon namaa hojii mataa isaa haa qoru. Ergasiis utuu nama kaanitti of hin madaalin of qofa jajuu ni dandaʼa;",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.4",
            "verseOrgIds": [
              "GAL.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GAL 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "tokkoon tokkoon namaa baʼaa ofii isaa baadhachuu qabaatii.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.5",
            "verseOrgIds": [
              "GAL.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GAL 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni dubbicha baratu kam iyyuu waan gaarii hundumaa barsiisaa isaa wajjin haa qoodatu.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.6",
            "verseOrgIds": [
              "GAL.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GAL 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hin gowwoominaa; Waaqaatti qoosuun hin dandaʼamu. Namni waanuma facaafate haammataatii.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.7",
            "verseOrgIds": [
              "GAL.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GAL 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni foonitti facaasu foon irraa badiisa galfata; namni Hafuuratti facaasu immoo Hafuura irraa jireenya bara baraa haammata.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.8",
            "verseOrgIds": [
              "GAL.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GAL 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kottaa waan gaarii hojjechuu hin dadhabnu; yoo abdii kutachuu baanne gaafa yeroon isaa gaʼe midhaan isaa ni haammannaatii.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.9",
            "verseOrgIds": [
              "GAL.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GAL 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaaf kottaa, carraa qabnuun nama hundaaf, keessumattuu warra maatii amantootaa taʼaniif waan gaarii goonaa.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.10",
            "verseOrgIds": [
              "GAL.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Uumama Haaraa Taʼuu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GAL 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka ani harkuma kootiin qubee gurguddaa hammam gaʼuun isinii barreesse mee ilaalaa!",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.11",
            "verseOrgIds": [
              "GAL.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GAL 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Warri fooniin gaarii taʼanii mulʼachuu barbaadan akka isin dhagna qabattan isin dirqisiisuu yaalu. Isaanis fannoo Kiristoosiif jedhanii akka hin ariʼatamne qofaaf waan kana godhu.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.12",
            "verseOrgIds": [
              "GAL.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GAL 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Warri dhagna qabatan mataan isaanii iyyuu seera hin eegan; taʼus isaan dhagna qabaa keessan kan fooniitiin boonuuf jedhanii akka isin dhagna qabattan barbaadu.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.13",
            "verseOrgIds": [
              "GAL.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GAL 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fannoo Gooftaa keenya Yesuus Kiristoos kan ittiin addunyaan naaf fannifame, kan anis ittiin addunyaaf fannifame sana malee waan biraatiin of jajuun narraa haa fagaatu.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.14",
            "verseOrgIds": [
              "GAL.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GAL 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uumama haaraa taʼuutu faayidaa qaba malee dhagna qabachuun yookaan qabachuu baachuun faayidaa hin qabu.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.15",
            "verseOrgIds": [
              "GAL.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GAL 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nagaa fi araarri warra seera kana duukaa buʼan hundaaf, Israaʼel Waaqaatiifis haa taʼu.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.16",
            "verseOrgIds": [
              "GAL.6.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GAL 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani dhagna koo irraa godaannisa Yesuus qabaatii siʼachi namni tokko iyyuu na hin rakkisin.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.17",
            "verseOrgIds": [
              "GAL.6.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GAL 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa obboloota, ayyaanni Gooftaa keenya Yesuus Kiristoos hafuura keessan wajjin haa taʼu. Ameen.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.18",
            "verseOrgIds": [
              "GAL.6.18"
            ]
          }
        }
      ]
    }
  ],
