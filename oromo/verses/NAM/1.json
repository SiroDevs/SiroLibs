      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 1:10"
      },
      "items": [
        {
          "text": "daadhii wayinii isaaniitiin machaaʼu;",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.10",
            "verseOrgIds": [
              "NAM.1.10"
            ]
          }
        }
      ]
    },
