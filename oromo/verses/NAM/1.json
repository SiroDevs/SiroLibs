                "verseOrgIds": [
                  "NAM.1.2"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa hinaafuu fi Waaqa haaloo baʼuu dha;",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.2",
            "verseOrgIds": [
              "NAM.1.2"
            ]
          }
        }
      ]
    },
    {
