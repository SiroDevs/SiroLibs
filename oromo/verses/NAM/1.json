              "attrs": {
                "verseId": "NAM.1.9",
                "verseOrgIds": [
                  "NAM.1.9"
                ]
              }
            }
          ]
        },
        {
          "text": "yaaddan maali?",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.9",
            "verseOrgIds": [
              "NAM.1.9"
            ]
          }
        }
      ]
    },
