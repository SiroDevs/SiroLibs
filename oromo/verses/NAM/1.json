      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 1:10"
      },
      "items": [
        {
          "text": "akkuma cidii gogeetti gubatanii dhumu.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.10",
            "verseOrgIds": [
              "NAM.1.10"
            ]
          }
        }
      ]
    },
    {
