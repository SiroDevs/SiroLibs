                "verseOrgIds": [
                  "EXO.40.25"
                ]
              }
            }
          ]
        },
        {
          "text": "dura dhadhaabe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.25",
            "verseOrgIds": [
              "EXO.40.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
