              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Israaʼeloonni karaa isaanii hunda keessatti yommuu duumessi dunkaana qulqulluu irraa kaʼu hunda kaʼanii deemsa isaanii itti fufu turan.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.36",
            "verseOrgIds": [
