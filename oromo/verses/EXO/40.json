                "verseId": "EXO.40.27",
                "verseOrgIds": [
                  "EXO.40.27"
                ]
              }
            }
          ]
        },
        {
          "text": "isa ajajettis ixaana urgaaʼaa isa irratti aarse.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.27",
            "verseOrgIds": [
              "EXO.40.27"
