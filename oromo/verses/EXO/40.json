          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 40:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Museen, Aroonii fi ilmaan Arooniis harka isaaniitii fi miilla isaanii dhiqachuuf itti fayyadamu turan.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.31",
            "verseOrgIds": [
              "EXO.40.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 40:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis akkuma",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.32",
            "verseOrgIds": [
              "EXO.40.32"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "EXO.40.32",
                "verseOrgIds": [
                  "EXO.40.32"
                ]
              }
            }
          ]
        },
        {
          "text": "Musee ajajetti yeroo dunkaana wal gaʼii seenan yookaan yeroo iddoo aarsaatti dhiʼaatan hunda ni dhiqatu turan.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.32",
            "verseOrgIds": [
              "EXO.40.32"
            ]
          }
        }
      ]
    },
