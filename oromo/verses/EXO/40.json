          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Museenis sababii duumessi sun dunkaana wal gaʼii irra buʼee fi sababii ulfinni",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.35",
            "verseOrgIds": [
