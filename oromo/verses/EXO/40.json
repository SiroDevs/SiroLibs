          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoo duumessi irraa kaʼuu baate garuu hamma gaafa duumessi sun irraa kaʼuutti hin deeman ture.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.37",
            "verseOrgIds": [
              "EXO.40.37"
            ]
          }
        },
