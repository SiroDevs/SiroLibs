          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balbala dunkaana qulqulluu irrattis golgaa fannise.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.28",
            "verseOrgIds": [
              "EXO.40.28"
            ]
