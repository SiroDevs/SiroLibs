          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Museenis iddoo aarsaa kan warqee irraa hojjetame sana fuula golgaa duraan dunkaana wal gaʼii keessa dhaabe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.26",
            "verseOrgIds": [
              "EXO.40.26"
            ]
