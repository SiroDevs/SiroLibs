              "attrs": {
                "verseId": "EXO.40.34",
                "verseOrgIds": [
                  "EXO.40.34"
                ]
              }
            }
          ]
        },
        {
          "text": "dunkaana qulqulluu sana guute.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.34",
            "verseOrgIds": [
              "EXO.40.34"
            ]
          }
        },
