          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "EXO 40:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu karaa isaanii hunda keessatti fuula saba Israaʼel hundaa duratti guyyaa guyyaa duumessi",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.38",
            "verseOrgIds": [
              "EXO.40.38"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "EXO.40.38",
                "verseOrgIds": [
                  "EXO.40.38"
                ]
              }
            }
          ]
        },
        {
          "text": "dunkaana qulqulluu irra ture; halkan halkan immoo ibiddi duumessa sana keessa ture.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.38",
