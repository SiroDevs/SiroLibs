                "verseId": "EXO.40.35",
                "verseOrgIds": [
                  "EXO.40.35"
                ]
              }
            }
          ]
        },
        {
          "text": "dunkaana qulqulluu guuteef dunkaana wal gaʼii seenuu hin dandeenye.",
