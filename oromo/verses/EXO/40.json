          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni akkuma",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.29",
            "verseOrgIds": [
              "EXO.40.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "EXO.40.29",
                "verseOrgIds": [
                  "EXO.40.29"
                ]
              }
            }
          ]
        },
        {
          "text": "isa ajajetti iddoo aarsaa qalma gubamuu sana balbala dunkaana qulqulluu kan dunkaana wal gaʼii bira dhaabee qalma gubamuu fi kennaa midhaanii isa irratti dhiʼeesse.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.29",
            "verseOrgIds": [
              "EXO.40.29"
            ]
          }
        }
      ]
