    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Dunkaana Qulqulluu Dhaabuu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 40:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "EXO.40.1",
                "verseOrgIds": [
                  "EXO.40.1"
                ]
              }
            }
          ]
        },
        {
          "text": "Museedhaan akkana jedhe:",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.1",
            "verseOrgIds": [
              "EXO.40.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 40:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Guyyaa jalqaba jiʼa jalqabaatti dunkaana qulqulluu jechuunis dunkaana wal gaʼii dhaabi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.2",
            "verseOrgIds": [
              "EXO.40.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 40:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taabota kakuu seeraa isa keessa kaaʼiitii taaboticha golgaadhaan daʼeessi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.3",
            "verseOrgIds": [
              "EXO.40.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 40:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Minjaala ol galchiitii miʼa isaa tottolchi. Ergasiis baattuu ibsaa ol galchiitii ibsaa isaa irra dhaabi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.4",
            "verseOrgIds": [
              "EXO.40.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 40:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iddoo aarsaa ixaanaa kan warqee irraa hojjetame fuula taabota kakuu seeraa dura dhaabiitii balbala dunkaana qulqulluutti immoo golgaa fannisi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.5",
            "verseOrgIds": [
              "EXO.40.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 40:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Iddoo aarsaa qalma gubamuu sanas fuula balbala dunkaana qulqulluu jechuunis dunkaana wal gaʼii dura dhaabi;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.6",
            "verseOrgIds": [
              "EXO.40.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 40:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "gabatee itti dhiqatanis dunkaana wal gaʼiitii fi iddoo aarsaa gidduu dhaabiitii bishaan itti naqi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.7",
            "verseOrgIds": [
              "EXO.40.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 40:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naannoo isaattis oobdii hojjedhuutii balbala isaatti golgaa kaaʼi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.8",
            "verseOrgIds": [
              "EXO.40.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 40:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Zayitii ittiin diban fuudhiitii dunkaana qulqulluu fi waan isa keessa jiru hunda dibi; dunkaanichaa fi miʼa isaa hunda qulqulleessi; innis ni qulqullaaʼa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.9",
            "verseOrgIds": [
              "EXO.40.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 40:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasiis iddoo aarsaa qalma gubamuutii fi miʼa isaa hunda dibi; iddoo aarsaa sana qulqulleessi; innis waan hunda caalaa qulqullaaʼaa taʼa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.10",
            "verseOrgIds": [
              "EXO.40.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 40:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gabatee itti dhiqatanii fi miilla isaa dibiitii isaan qulqulleessi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.11",
            "verseOrgIds": [
              "EXO.40.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 40:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Aroonii fi ilmaan isaa gara balbala dunkaana wal gaʼiitti fidiitii bishaaniin isaan dhiqi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.12",
            "verseOrgIds": [
              "EXO.40.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 40:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasii Aroonitti wayyaa qulqulluu uffisi; akka inni lubummaadhaan na tajaajiluufis dibiitii isa qulqulleessi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.13",
            "verseOrgIds": [
              "EXO.40.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 40:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilmaan isaas fidiitii kittaa itti uffisi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.14",
            "verseOrgIds": [
              "EXO.40.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 40:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka isaan lubummaadhaan na tajaajilaniifis akkuma abbaa isaanii dibde sanatti isaan dibi; dibamuun isaanii kunis dhaloota dhufu hunda keessatti lubummaa itti fufu taʼa.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.15",
            "verseOrgIds": [
              "EXO.40.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 40:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Museenis akkuma",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.16",
            "verseOrgIds": [
              "EXO.40.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "EXO.40.16",
                "verseOrgIds": [
                  "EXO.40.16"
                ]
              }
            }
          ]
        },
        {
          "text": "isa ajajetti waan hunda hojjete.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.16",
            "verseOrgIds": [
              "EXO.40.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 40:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu dunkaanni qulqulluun sun waggaa lamaffaa keessa guyyaa jalqabaa kan jiʼa jalqabaatti dhaabame.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.17",
            "verseOrgIds": [
              "EXO.40.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 40:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Museen yeroo dunkaana qulqulluu sana dhaabetti miillawwan dunkaanichaa itti kaaʼe; tuggeewwan isaa dhadhaabe; dagaleewwan isaa loose; utuboota isaa dhadhaabe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.18",
            "verseOrgIds": [
              "EXO.40.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 40:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis akkuma",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.19",
            "verseOrgIds": [
              "EXO.40.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "EXO.40.19",
                "verseOrgIds": [
                  "EXO.40.19"
                ]
              }
            }
          ]
        },
        {
          "text": "isa ajajetti dunkaana qulqulluu irraan dunkaana diriirsee dunkaana sanatti immoo irra buusa uffise.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.19",
            "verseOrgIds": [
              "EXO.40.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 40:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhuga baʼumsa sana fuudhee taabota keessa kaaʼe; danqaraawwanis taabotatti hidhe; teessoo araaraa immoo taabota gubbaa kaaʼe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.20",
            "verseOrgIds": [
              "EXO.40.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 40:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Museen akkuma",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.21",
            "verseOrgIds": [
              "EXO.40.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "EXO.40.21",
                "verseOrgIds": [
                  "EXO.40.21"
                ]
              }
            }
          ]
        },
        {
          "text": "isa ajajetti taabota sana dunkaana qulqulluutti ol galchee golgaa daʼeessu fanniseef; taabota kakuu seeraa sanas daʼeesse.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.21",
            "verseOrgIds": [
              "EXO.40.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 40:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Museenis minjaala sana gama kaaba dunkaana qulqulluutiin dunkaana wal gaʼii keessa golgaa sanaan ala kaaʼe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.22",
            "verseOrgIds": [
              "EXO.40.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 40:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkuma",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.23",
            "verseOrgIds": [
              "EXO.40.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "EXO.40.23",
                "verseOrgIds": [
                  "EXO.40.23"
                ]
              }
            }
          ]
        },
        {
          "text": "isa ajajettis fuula",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.23",
            "verseOrgIds": [
              "EXO.40.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "EXO.40.23",
                "verseOrgIds": [
                  "EXO.40.23"
                ]
              }
            }
          ]
        },
        {
          "text": "duratti buddeena achi irra kaaʼe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.23",
            "verseOrgIds": [
              "EXO.40.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 40:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baattuu ibsaa immoo gama kibbaa dunkaana qulqulluutiin dunkaana wal gaʼii keessa fuullee minjaalaatiin kaaʼe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.24",
            "verseOrgIds": [
              "EXO.40.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 40:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkuma",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.25",
            "verseOrgIds": [
              "EXO.40.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "EXO.40.25",
                "verseOrgIds": [
                  "EXO.40.25"
                ]
              }
            }
          ]
        },
        {
          "text": "isa ajajettis ibsaawwan sana fuula",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.25",
            "verseOrgIds": [
              "EXO.40.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
