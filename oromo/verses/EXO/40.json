          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gabatee sanas dunkaana wal gaʼiitii fi iddoo aarsaa gidduu kaaʼee bishaan dhiqataa itti naqe;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.30",
            "verseOrgIds": [
              "EXO.40.30"
            ]
