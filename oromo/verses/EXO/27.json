    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Dunkaana qulqulluu sanaaf oobdii hojjedhu. Oobdichis gama kibbaatiin dhundhuma dhibba tokko haa dheeratu; innis golgaa quncee talbaa gaarii foʼame irraa hojjetamee",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.9",
            "verseOrgIds": [
              "EXO.27.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "utubaawwan digdamaa fi miilla naasii digdama qaban haa qabaatu; hokkoowwanii fi somaawwan utubaawwan kanneenis meetii irraa haa hojjetaman.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.10",
            "verseOrgIds": [
              "EXO.27.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gama kaabaatiinis akkasuma dhundhuma dhibba tokko dheeratee golgaawwan utubaawwan digdamaa fi miilla naasii digdama qaban haa qabaatu; hokkoowwanii fi somaawwan utubaawwan kanaas meetii irraa haa tolfaman.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.11",
            "verseOrgIds": [
              "EXO.27.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Oobdiin kun gama lixaatiin dhundhuma shantama balʼatee golgaawwan, utubaa kudhanii fi miilla kudhan qaban haa qabaatu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.12",
            "verseOrgIds": [
              "EXO.27.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oobdiin kun fiixee baʼaatiin karaa baʼa biiftuutiin akkasuma dhundhuma shantama haa balʼatu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.13",
            "verseOrgIds": [
              "EXO.27.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Golgaawwan dhundhuma kudha shan dhedheeratanii utubaa sadii fi miilla sadii qabanis karaa balbala tokkoo irra haa jiraatan.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.14",
            "verseOrgIds": [
              "EXO.27.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Golgaawwan dhundhuma kudha shan dhedheeratanii utubaa sadii fi miilla sadii qabanis gama kaaniin haa jiraatan.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.15",
            "verseOrgIds": [
              "EXO.27.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 27:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Balbala oobdii sanaatiifis golgaa dhundhuma digdama dheeratee utubaa afurii fi miilla afur qabu kan kirrii bifa cuquliisaa, dhiilgee, bildiimaa fi quncee talbaa kan qalʼifamee foʼameen dhaʼamee irratti faayeffamee hojjetame tokko tolchi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.16",
            "verseOrgIds": [
              "EXO.27.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 27:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utuboonni naannoo oobdii sanaa hundinuu somaawwanii fi hokkoowwan meetiitii fi miillawwan naasii haa qabaatan.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.17",
            "verseOrgIds": [
              "EXO.27.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 27:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oobdiin sun dheerina dhundhuma dhibba tokkoo fi balʼina dhundhuma shantamaa haa qabaatu; golgaa quncee talbaa gaarii foʼamee dhundhuma shan ol dheeratuu fi miillawwan naasii irraa hojjetame haa qabaatu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.18",
            "verseOrgIds": [
              "EXO.27.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 27:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miʼi tajaajila dunkaana qulqulluu sanaatiif fayyadu biraa hundi, tajaajila kam iyyuu taanaan, qofoo dunkaanichaatii fi qofoo oobdii sanaa hunda dabalatee naasii irraa haa hojjetamu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.19",
            "verseOrgIds": [
              "EXO.27.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Zayitii Baattuu Ibsaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "EXO.27.20-EXO.27.21"
          },
          "items": [
