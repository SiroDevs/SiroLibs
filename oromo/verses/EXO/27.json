    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 27:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Akka ibsaan ittuma fufee bobaʼuuf akka isaan zayitii ejersa cuunfame taliila isaa ibsaadhaaf siif fidan saba Israaʼel ajaji.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.20",
            "verseOrgIds": [
              "EXO.27.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 27:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aroonii fi ilmaan isaa dunkaana wal gaʼii keessatti golgaa fuula taabota kakuu seeraa dura jiruun alatti akka ibsaan sun galgalaa hamma ganamaatti fuula",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.21",
            "verseOrgIds": [
              "EXO.27.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "EXO.27.21",
                "verseOrgIds": [
                  "EXO.27.21"
                ]
              }
            }
          ]
        },
        {
          "text": "duratti bobaʼuu haa godhan. Wanni kunis saba Israaʼel keessatti dhaloota dhufuuf seera bara baraa haa taʼu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.21",
            "verseOrgIds": [
              "EXO.27.21"
            ]
          }
        }
      ]
    }
