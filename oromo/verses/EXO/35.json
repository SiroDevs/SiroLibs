              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "dunkaana qulqulluu fi qofoowwan oobdii dunkaana qulqulluutii fi funyoowwan isaanii,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.18",
