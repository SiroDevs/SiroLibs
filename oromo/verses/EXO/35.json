        "style": "s1"
      },
      "items": [
        {
          "text": "Sirna Sanbataa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 35:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Museen waldaa Israaʼel guutuu walitti qabee akkana jedheen; \"Wanni",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.1",
            "verseOrgIds": [
              "EXO.35.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "EXO.35.1",
                "verseOrgIds": [
                  "EXO.35.1"
                ]
              }
            }
          ]
        },
        {
          "text": "akka isin hojjettan isin ajaje kana:",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.1",
            "verseOrgIds": [
              "EXO.35.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 35:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyyaa jaʼa hojiin haa hojjetamu; guyyaan torbaffaan garuu isiniif guyyaa qulqulluu dha;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.2",
            "verseOrgIds": [
              "EXO.35.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoof",
              "type": "text",
              "attrs": {
                "verseId": "EXO.35.2",
                "verseOrgIds": [
                  "EXO.35.2"
                ]
              }
            }
          ]
        },
        {
          "text": "immoo sanbata boqonnaa taʼa. Namni guyyaa kana hojii hojjetu kam iyyuu haa ajjeefamu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.2",
            "verseOrgIds": [
              "EXO.35.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 35:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyyaa Sanbataatiin lafa jiraattan kamitti iyyuu ibidda hin qabsiisinaa.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.3",
            "verseOrgIds": [
              "EXO.35.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Miʼa Dunkaana Qulqulluu",
          "type": "text"
        }
      ]
    },
