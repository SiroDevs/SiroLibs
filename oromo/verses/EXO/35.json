          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "wayyaawwan foʼamanii dhaʼaman kanneen isaan yeroo iddoo qulqulluu keessa tajaajilan uffataman jechuunis wayyaawwan Aroon lubichaaf qulqulleeffamanii fi wayyaawwan ilmaan isaa yeroo lubummaadhaan tajaajilanitti uffatan haa hojjetan.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.19",
            "verseOrgIds": [
              "EXO.35.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
