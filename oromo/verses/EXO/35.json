    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 35:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Museenis waldaa Israaʼel guutuudhaan akkana jedhe; \"Wanni",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.4",
            "verseOrgIds": [
              "EXO.35.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "EXO.35.4",
                "verseOrgIds": [
                  "EXO.35.4"
                ]
              }
            }
          ]
        },
        {
          "text": "ajaje kana:",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.4",
            "verseOrgIds": [
              "EXO.35.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 35:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan qabdan irraa",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.5",
            "verseOrgIds": [
              "EXO.35.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoof",
              "type": "text",
              "attrs": {
                "verseId": "EXO.35.5",
                "verseOrgIds": [
                  "EXO.35.5"
                ]
              }
            }
          ]
        },
        {
          "text": "kennaa dhiʼeessaa. Namni fedhii qabu hundinuu:",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.5",
            "verseOrgIds": [
              "EXO.35.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "EXO 35:5"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "EXO 35:5"
      },
      "items": [
        {
          "text": "\"kennaa warqee, meetii fi naasii",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.5",
            "verseOrgIds": [
              "EXO.35.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoof",
              "type": "text",
              "attrs": {
                "verseId": "EXO.35.5",
                "verseOrgIds": [
                  "EXO.35.5"
                ]
              }
            }
          ]
        },
        {
          "text": "haa fidu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.5",
            "verseOrgIds": [
              "EXO.35.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 35:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kirrii bifa cuquliisaa, dhiilgee, bildiimaa fi quncee talbaa gaarii,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.6",
            "verseOrgIds": [
              "EXO.35.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "EXO 35:6"
      },
      "items": [
        {
          "text": "rifeensa reʼee,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.6",
            "verseOrgIds": [
              "EXO.35.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 35:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "gogaa korbeessa hoolaa kan halluu diimaa cuuphamee fi gogaa duugame,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.7",
            "verseOrgIds": [
              "EXO.35.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "EXO 35:7"
      },
      "items": [
        {
          "text": "muka laaftoo,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.7",
            "verseOrgIds": [
              "EXO.35.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 35:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "ibsaadhaaf zayitii ejersaa,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.8",
            "verseOrgIds": [
              "EXO.35.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "EXO 35:8"
      },
      "items": [
        {
          "text": "zayitii ittiin dibanii fi ixaana urgaaʼuuf immoo urgooftuuwwan,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.8",
            "verseOrgIds": [
              "EXO.35.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 35:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "dhagaawwan sardooniksii, dooqa gati jabeessa, dirataa fi qomee irratti kaaʼatamu kan biraa haa fidu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.9",
            "verseOrgIds": [
              "EXO.35.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 35:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Isin keessaa namoonni ogeeyyiin hundi dhufanii waan",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.10",
            "verseOrgIds": [
              "EXO.35.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "EXO.35.10",
                "verseOrgIds": [
                  "EXO.35.10"
                ]
              }
            }
          ]
        },
        {
          "text": "ajaje hunda haa hojjetan:",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.10",
            "verseOrgIds": [
              "EXO.35.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 35:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kunis dunkaana qulqulluu dunkaana isaatii fi irra buusaa isaa wajjin, hokkoowwan isaa, tuggee isaa, dagalee isaa, utubaa isaa, miilla isaa,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.11",
            "verseOrgIds": [
              "EXO.35.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 35:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "taabota danqaraa isaa wajjin, teessoo araaraatii fi golgaa isa dhoksus,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.12",
            "verseOrgIds": [
              "EXO.35.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 35:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "minjaala danqaraa isaatii fi miʼa isaa hunda wajjin, buddeena ilaalchaa;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.13",
            "verseOrgIds": [
              "EXO.35.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 35:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "baattuu ibsaa kan ifaaf taʼu miʼa isaa wajjin, ifa sanaafis ibsaa fi zayitii,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.14",
            "verseOrgIds": [
              "EXO.35.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 35:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "iddoo aarsaa ixaanaa danqaraa isaa wajjin, zayitii ittiin dibanii fi ixaana urgaaʼu,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.15",
            "verseOrgIds": [
              "EXO.35.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "EXO 35:15"
      },
      "items": [
        {
          "text": "karra ittiin dunkaana qulqulluu seenaniifis golgaa balbalaa,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.15",
            "verseOrgIds": [
              "EXO.35.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 35:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "iddoo aarsaa kan qalma gubamuu gingilchaa isaa kan naasii irraa hojjetame wajjin, danqaraawwan isaatii fi miʼa isaa hunda,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.16",
            "verseOrgIds": [
              "EXO.35.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "EXO 35:16"
      },
      "items": [
        {
          "text": "caabii naasii miilla isaa wajjin,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.16",
            "verseOrgIds": [
              "EXO.35.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 35:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "golgaawwan oobdii utubaawwanii fi miillawwan isaanii wajjin, golgaa karra oobdii sanaa,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.17",
            "verseOrgIds": [
              "EXO.35.17"
            ]
          }
        }
      ]
    },
    {
