  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "55",
        "style": "c",
        "sid": "PSA 55"
      },
      "items": [
        {
          "text": "55",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Faarfannaa 55",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "ms1"
      },
      "items": [
        {
          "text": "Kadhannaa Yeroo Ariʼatamaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Dura buʼaa faarfattootaatiif. Miʼa ribuutiin.",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "tl"
          },
          "items": [
            {
              "text": "Maskiilii",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daawit.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 55:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa Waaqi, kadhannaa koo dhagaʼi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.1",
            "verseOrgIds": [
              "PSA.55.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 55:1"
      },
      "items": [
        {
          "text": "waammata koo jalaas hin didin.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.1",
            "verseOrgIds": [
              "PSA.55.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 55:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na dhagaʼiitii deebii naa kenni;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.2",
            "verseOrgIds": [
              "PSA.55.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 55:2"
      },
      "items": [
        {
          "text": "komiin koo na dhiphisa; anis nagaa dhabeera.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.2",
            "verseOrgIds": [
              "PSA.55.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 55:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sagalee diinaatiin,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.3",
            "verseOrgIds": [
              "PSA.55.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 55:3"
      },
      "items": [
        {
          "text": "cunqursa namoota hamoos dhufe;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.3",
            "verseOrgIds": [
              "PSA.55.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 55:3"
      },
      "items": [
        {
          "text": "isaan dhiphina natti fiduutii;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.3",
            "verseOrgIds": [
              "PSA.55.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 55:3"
      },
      "items": [
        {
          "text": "aariidhaanis na jibbu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.3",
            "verseOrgIds": [
              "PSA.55.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 55:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lapheen koo na keessatti dhiphatte;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.4",
            "verseOrgIds": [
              "PSA.55.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 55:4"
      },
      "items": [
        {
          "text": "sodaan duʼaas na qabate.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.4",
            "verseOrgIds": [
              "PSA.55.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 55:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sodaa fi hollannaan natti dhufeera;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.5",
            "verseOrgIds": [
              "PSA.55.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 55:5"
      },
      "items": [
        {
          "text": "naasuunis na fudhateera.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.5",
            "verseOrgIds": [
              "PSA.55.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 55:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anis akkana nan jedhe;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.6",
            "verseOrgIds": [
              "PSA.55.7"
            ]
          }
        },
        {
          "name": "optbreak",
          "type": "tag",
          "attrs": {},
          "items": []
        },
        {
          "text": "\"Utuu ani akkuma gugee qoochoo qabaadhee!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.6",
            "verseOrgIds": [
              "PSA.55.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 55:6"
      },
      "items": [
        {
          "text": "Silaa asii barrisee nan boqodhan ture.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.6",
            "verseOrgIds": [
              "PSA.55.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 55:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Silaa fagootti baqadhee",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.7",
            "verseOrgIds": [
              "PSA.55.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 55:7"
      },
      "items": [
        {
          "text": "gammoojjii keessa nan bubbula ture;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.7",
            "verseOrgIds": [
              "PSA.55.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 55:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "silaa bubbee hamaa fi qilleensa jabaa irraa fagaadhee",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.8",
            "verseOrgIds": [
              "PSA.55.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 55:8"
      },
      "items": [
        {
          "text": "gara iddoo boqonnaa kootti nan ariifadhan ture.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.8",
            "verseOrgIds": [
              "PSA.55.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 55:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa Gooftaa, namoota hamoo burjaajessi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.9",
            "verseOrgIds": [
              "PSA.55.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 55:9"
      },
      "items": [
        {
          "text": "dubbii isaaniis waliin dhaʼi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.9",
            "verseOrgIds": [
              "PSA.55.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 55:9"
      },
      "items": [
        {
          "text": "ani magaalaa keessatti goolii fi lola argeeraatii.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.9",
            "verseOrgIds": [
              "PSA.55.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 55:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan halkanii guyyaa ol baʼanii dallaa ishee irra naannaʼu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.10",
            "verseOrgIds": [
              "PSA.55.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 55:10"
      },
      "items": [
        {
          "text": "jalʼinnii fi rakkinni ishee keessa jira.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.10",
            "verseOrgIds": [
              "PSA.55.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 55:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ishee keessa badiisatu jira;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.11",
            "verseOrgIds": [
              "PSA.55.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 55:11"
      },
      "items": [
        {
          "text": "nama cunqursuu fi gowwoomsuun daandii ishee irraa hin dhabamu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.11",
            "verseOrgIds": [
              "PSA.55.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 55:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utuu diinni na arrabsee,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.12",
            "verseOrgIds": [
              "PSA.55.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 55:12"
      },
      "items": [
        {
          "text": "silaa obsuu nan dandaʼa ture;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.12",
            "verseOrgIds": [
              "PSA.55.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 55:12"
      },
      "items": [
        {
          "text": "utuu amajaajiin natti kaʼee,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.12",
            "verseOrgIds": [
              "PSA.55.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 55:12"
      },
      "items": [
        {
          "text": "silaa jalaa dhokachuu nan dandaʼa ture.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.12",
            "verseOrgIds": [
              "PSA.55.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 55:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu siʼi namuma akka kootii,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.13",
            "verseOrgIds": [
              "PSA.55.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 55:13"
      },
      "items": [
        {
          "text": "hiriyaa koo, michuu koo kan natti dhiʼaatutu waan kana godhe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.13",
            "verseOrgIds": [
              "PSA.55.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 55:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tokkummaadhaan mana Waaqaa walii wajjin deemne;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.14",
            "verseOrgIds": [
              "PSA.55.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 55:14"
      },
      "items": [
        {
          "text": "haasaa miʼaawaas walii wajjin haasofne.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.14",
            "verseOrgIds": [
              "PSA.55.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 55:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuti tasa isaanitti haa dhufu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.15",
            "verseOrgIds": [
              "PSA.55.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 55:15"
      },
      "items": [
        {
          "text": "utuma lubbuudhaan jiranuu siiʼool keessa haa buʼan;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.55.15",
            "verseOrgIds": [
              "PSA.55.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
