        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoon",
              "type": "text",
              "attrs": {
                "verseId": "PSA.46.7",
                "verseOrgIds": [
                  "PSA.46.8"
                ]
              }
            }
          ]
        },
        {
          "text": "Waan Hunda Dandaʼu nu wajjin jira;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.7",
            "verseOrgIds": [
              "PSA.46.8"
            ]
          }
        }
