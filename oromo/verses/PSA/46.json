          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Calʼisaa; akka ani Waaqa taʼes beekaa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.10",
            "verseOrgIds": [
              "PSA.46.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 46:10"
      },
      "items": [
        {
          "text": "ani saboota gidduutti ol ol nan jedha;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.10",
            "verseOrgIds": [
              "PSA.46.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 46:10"
      },
      "items": [
        {
          "text": "lafa irrattis ol ol nan jedha.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.10",
            "verseOrgIds": [
              "PSA.46.11"
            ]
          }
        }
