        {
          "text": "Faarfannaa 46",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "ms1"
      },
      "items": [
        {
          "text": "Waaqayyo nu wajjin jira",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Dura buʼaa faarfattootaatiif. Faarfannaa Ilmaan Qooraahi. Haala",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "tl"
          },
          "items": [
            {
              "text": "Alaamootiitiin",
              "type": "text"
            }
          ]
        },
        {
          "text": ".",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 46:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqni daʼoo fi jabina keenya;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.1",
            "verseOrgIds": [
              "PSA.46.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 46:1"
      },
      "items": [
        {
          "text": "inni gargaarsa yeroo hunda rakkina keessatti nu wajjin jiruu dha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.1",
            "verseOrgIds": [
              "PSA.46.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 46:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu yoo lafti raafamtee",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.2",
            "verseOrgIds": [
              "PSA.46.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 46:2"
      },
      "items": [
        {
          "text": "tulluuwwanis garaa galaanaa keessa gadi buʼan iyyuu nu hin sodaannu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.2",
            "verseOrgIds": [
              "PSA.46.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 46:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utuu bishaan isaas huursee hoomachaaʼee",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.3",
            "verseOrgIds": [
              "PSA.46.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 46:3"
      },
      "items": [
        {
          "text": "tulluuwwanis raafama isaatiin sochoʼan iyyuu nu hin sodaannu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.3",
            "verseOrgIds": [
              "PSA.46.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 46:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lagni yaaʼaan isaa magaalaa Waaqaa gammachiisu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.4",
            "verseOrgIds": [
              "PSA.46.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 46:4"
      },
      "items": [
        {
          "text": "kan iddoo qulqulluu Waaqni Waan Hundaa Olii jiraatuuf",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.4",
            "verseOrgIds": [
              "PSA.46.5"
            ]
          }
        },
        {
          "name": "optbreak",
          "type": "tag",
          "attrs": {},
          "items": []
        },
        {
          "text": "gammachuu kennu tokko jira.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.4",
            "verseOrgIds": [
              "PSA.46.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 46:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqni magaalattii keessa jira; isheenis hin raafamtu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.5",
            "verseOrgIds": [
              "PSA.46.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 46:5"
      },
      "items": [
        {
          "text": "ganama barii Waaqni ishee gargaara.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.5",
            "verseOrgIds": [
              "PSA.46.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 46:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saboonni ni raafaman; mootummoonnis ni kufan;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.6",
            "verseOrgIds": [
              "PSA.46.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 46:6"
      },
      "items": [
        {
          "text": "inni sagalee isaa dhageessise; laftis ni baqxe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.46.6",
            "verseOrgIds": [
              "PSA.46.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
