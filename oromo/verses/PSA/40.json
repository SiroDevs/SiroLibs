          "type": "text",
          "attrs": {
            "verseId": "PSA.40.9",
            "verseOrgIds": [
              "PSA.40.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
