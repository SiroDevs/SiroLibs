      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 40:5"
      },
      "items": [
        {
          "text": "baayʼinni isaanii hamma hin qabu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.5",
            "verseOrgIds": [
              "PSA.40.6"
            ]
          }
