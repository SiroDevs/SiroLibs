      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 40:3"
      },
      "items": [
        {
          "text": "faarfannaa galataas afaan koo keessa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.3",
            "verseOrgIds": [
              "PSA.40.4"
            ]
          }
        },
        {
          "name": "optbreak",
          "type": "tag",
          "attrs": {},
          "items": []
        },
        {
          "text": "Waaqa keenyaaf kaaʼe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.40.3",
            "verseOrgIds": [
              "PSA.40.4"
            ]
          }
        }
