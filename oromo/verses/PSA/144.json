      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:2"
      },
      "items": [
        {
          "text": "iddoo ani itti daʼadhuu fi fayyisaa koo ti.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.2",
            "verseOrgIds": [
              "PSA.144.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 144:2"
      },
      "items": [
        {
          "text": "Gaachana koo, iddoo ani itti kooluu galu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.2",
            "verseOrgIds": [
              "PSA.144.2"
            ]
          }
        }
      ]
    },
    {
