          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni Waaqa na jaallatuu fi daʼoo koo ti;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.2",
            "verseOrgIds": [
              "PSA.144.2"
            ]
          }
        }
