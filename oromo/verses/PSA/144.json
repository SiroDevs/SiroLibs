        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "PSA.144.3",
                "verseOrgIds": [
                  "PSA.144.3"
                ]
              }
            }
          ]
        },
        {
          "text": ", akka ati waaʼee isaa yaadduuf, namni maali?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.3",
            "verseOrgIds": [
              "PSA.144.3"
            ]
          }
        }
