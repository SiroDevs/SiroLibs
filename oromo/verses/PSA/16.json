      "attrs": {
        "style": "q2",
        "vid": "PSA 16:5"
      },
      "items": [
        {
          "text": "ixaa koos situ naa jiraachisa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.5",
            "verseOrgIds": [
              "PSA.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
