      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 16:1"
      },
      "items": [
        {
          "text": "ati na eegi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.1",
            "verseOrgIds": [
              "PSA.16.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
