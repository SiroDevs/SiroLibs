          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati karaa jireenyaa na barsiifta; fuula kee durattis",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.11",
            "verseOrgIds": [
              "PSA.16.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 16:11"
      },
      "items": [
        {
          "text": "gammachuudhaan na guutta;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.11",
            "verseOrgIds": [
              "PSA.16.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 16:11"
      },
      "items": [
        {
          "text": "gara mirga keetii gammachuu bara baraatu jira.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.11",
            "verseOrgIds": [
              "PSA.16.11"
            ]
          }
        }
