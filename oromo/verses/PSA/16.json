          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Funyoon daangaa iddoo gaarii naa buʼeera;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.6",
            "verseOrgIds": [
              "PSA.16.6"
            ]
          }
        }
      ]
    },
    {
