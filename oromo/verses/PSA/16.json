              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa Waaqi, ani kooluu sitti galeeraatii,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.1",
            "verseOrgIds": [
              "PSA.16.1"
            ]
          }
        }
      ]
    },
    {
