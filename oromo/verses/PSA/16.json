                "verseOrgIds": [
                  "PSA.16.5"
                ]
              }
            }
          ]
        },
        {
          "text": "qooda dhaala kootii fi qooda xoofoo koo ti;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.5",
            "verseOrgIds": [
              "PSA.16.5"
            ]
          }
        }
      ]
    },
