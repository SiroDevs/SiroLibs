                "verseOrgIds": [
                  "PSA.16.7"
                ]
              }
            }
          ]
        },
        {
          "text": "isa na gorsu sana ani nan jajadha;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.7",
            "verseOrgIds": [
              "PSA.16.7"
            ]
          }
        }
      ]
    },
