          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaaf garaan koo ni gammada; arrabni koos ni ililcha;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.9",
            "verseOrgIds": [
              "PSA.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 16:9"
      },
      "items": [
        {
          "text": "foon koos nagaadhaan jiraata;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.9",
            "verseOrgIds": [
              "PSA.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ati siiʼool keessatti na hin dhiiftuutii,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.10",
            "verseOrgIds": [
              "PSA.16.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 16:10"
      },
      "items": [
        {
          "text": "yookaan amanamaan kee akka tortoru hin gootu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.10",
            "verseOrgIds": [
              "PSA.16.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
