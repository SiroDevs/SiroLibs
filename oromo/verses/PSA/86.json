          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.6",
            "verseOrgIds": [
              "PSA.86.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "PSA.86.6",
                "verseOrgIds": [
                  "PSA.86.6"
                ]
              }
            }
          ]
        },
        {
          "text": ", kadhannaa koo dhagaʼi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.6",
            "verseOrgIds": [
              "PSA.86.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 86:6"
      },
      "items": [
        {
          "text": "iyya waammata koos dhaggeeffadhu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.6",
            "verseOrgIds": [
              "PSA.86.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
