          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "PSA.138.1",
                "verseOrgIds": [
                  "PSA.138.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", ani garaa koo guutuudhaan sin galateeffadha;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.1",
            "verseOrgIds": [
              "PSA.138.1"
            ]
