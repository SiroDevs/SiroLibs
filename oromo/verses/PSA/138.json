      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 138:1"
      },
      "items": [
        {
          "text": "fuula \"waaqotaa\" durattis galata kee nan faarfadha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.1",
            "verseOrgIds": [
              "PSA.138.1"
            ]
          }
