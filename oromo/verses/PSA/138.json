          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sababii ati maqaa keetii fi dubbii kee waan hundaa olitti guddifteef,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.2",
            "verseOrgIds": [
              "PSA.138.2"
            ]
          }
        }
      ]
    },
    {
