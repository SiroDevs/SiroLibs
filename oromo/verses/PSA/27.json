          "text": "Yaa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.7",
            "verseOrgIds": [
              "PSA.27.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "PSA.27.7",
                "verseOrgIds": [
                  "PSA.27.7"
                ]
              }
            }
          ]
        },
        {
          "text": ", yommuu ani si waammadhu, sagalee koo dhagaʼi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.7",
            "verseOrgIds": [
              "PSA.27.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 27:7"
      },
      "items": [
        {
          "text": "naaf araarami; deebiis naaf kenni.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.7",
            "verseOrgIds": [
              "PSA.27.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yommuu ati, \"Fuula koo barbaadaa!\" jettetti,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.8",
            "verseOrgIds": [
              "PSA.27.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 27:8"
      },
      "items": [
        {
          "text": "garaan koo, \"Yaa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.8",
            "verseOrgIds": [
              "PSA.27.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "PSA.27.8",
                "verseOrgIds": [
                  "PSA.27.8"
                ]
              }
            }
          ]
        },
        {
          "text": ", ani fuula kee nan barbaada\" siin jedha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.8",
            "verseOrgIds": [
              "PSA.27.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fuula kee na duraa hin dhoksin;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.9",
            "verseOrgIds": [
              "PSA.27.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 27:9"
      },
      "items": [
        {
          "text": "aartee tajaajilaa kee of irraa hin deebisin;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.9",
            "verseOrgIds": [
