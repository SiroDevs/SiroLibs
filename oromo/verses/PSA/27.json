      "attrs": {
        "style": "q2",
        "vid": "PSA 27:6"
      },
      "items": [
        {
          "text": "mataan koo ol jedha;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.6",
            "verseOrgIds": [
              "PSA.27.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 27:6"
      },
      "items": [
        {
          "text": "dunkaana isaa keessatti illee ililleedhaan aarsaa nan dhiʼeessa;",
