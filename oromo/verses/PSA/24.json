      "attrs": {
        "style": "q2",
        "vid": "PSA 24:1"
      },
      "items": [
        {
          "text": "addunyaa fi wanni ishee keessa jiraatu hundinuus kan",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.1",
            "verseOrgIds": [
              "PSA.24.1"
            ]
          }
        },
