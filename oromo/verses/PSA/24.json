          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nama harka qulqulluu fi garaa qulqulluu qabu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.24.4",
            "verseOrgIds": [
              "PSA.24.4"
