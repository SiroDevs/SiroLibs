      },
      "items": [
        {
          "text": "Faarfannaa 67",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "ms1"
      },
      "items": [
        {
          "text": "Faarfannaa Yeroo Midhaan Galfamuu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Dura Buʼaa Faarfattootaatiif. Miʼa ribuutiin. Faarfannaa.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 67:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqni garaa nuuf laafu; nu haa eebbisus;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.67.1",
            "verseOrgIds": [
              "PSA.67.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 67:1"
      },
      "items": [
        {
          "text": "fuula isaas nurratti haa ibsu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.67.1",
            "verseOrgIds": [
              "PSA.67.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 67:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "kunis akka karaan kee lafa irratti,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.67.2",
            "verseOrgIds": [
              "PSA.67.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 67:2"
      },
      "items": [
        {
          "text": "fayyisuun kee immoo saboota hundumaa biratti beekamuuf.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.67.2",
            "verseOrgIds": [
              "PSA.67.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 67:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa Waaqayyo, saboonni si haa jajatan;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.67.3",
            "verseOrgIds": [
              "PSA.67.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 67:3"
      },
      "items": [
        {
          "text": "saboonni hundii si haa jajatan.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.67.3",
            "verseOrgIds": [
              "PSA.67.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 67:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati waan qajeelummaadhaan namoota bulchituuf,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.67.4",
            "verseOrgIds": [
              "PSA.67.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 67:4"
      },
      "items": [
        {
          "text": "saboota lafa irraas waan geggeessituuf,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.67.4",
            "verseOrgIds": [
              "PSA.67.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 67:4"
      },
      "items": [
        {
          "text": "saboonni haa gammadanis; ililchaniis haa faarfatan.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.67.4",
            "verseOrgIds": [
              "PSA.67.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 67:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaa Waaqayyo, saboonni si haa jajatan;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.67.5",
            "verseOrgIds": [
              "PSA.67.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 67:5"
      },
      "items": [
        {
          "text": "saboonni hundii si haa jajatan.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.67.5",
            "verseOrgIds": [
              "PSA.67.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 67:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lafti midhaan kenniteerti;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.67.6",
            "verseOrgIds": [
              "PSA.67.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 67:6"
      },
      "items": [
        {
          "text": "Waaqayyo Waaqni keenyas nu eebbiseera.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.67.6",
            "verseOrgIds": [
              "PSA.67.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 67:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqni nu eebbiseera;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.67.7",
            "verseOrgIds": [
              "PSA.67.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 67:7"
      },
      "items": [
        {
          "text": "handaarri lafaa hundi isa haa sodaatu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.67.7",
            "verseOrgIds": [
              "PSA.67.8"
            ]
          }
        }
      ]
    }
