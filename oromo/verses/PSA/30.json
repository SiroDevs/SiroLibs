                "verseId": "PSA.30.4",
                "verseOrgIds": [
                  "PSA.30.5"
                ]
              }
            }
          ]
        },
        {
          "text": "jajadhaa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.4",
            "verseOrgIds": [
              "PSA.30.5"
            ]
          }
        }
      ]
