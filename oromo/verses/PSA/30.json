      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 30:1"
      },
      "items": [
        {
          "text": "ani sin jajadha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.1",
            "verseOrgIds": [
              "PSA.30.2"
            ]
          }
