                "verseOrgIds": [
                  "PSA.30.4"
                ]
              }
            }
          ]
        },
        {
          "text": ", ati lubbuu koo siiʼoolii baafte;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.3",
            "verseOrgIds": [
              "PSA.30.4"
            ]
          }
        }
