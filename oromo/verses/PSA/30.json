    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "ms1"
      },
      "items": [
        {
          "text": "Galata Nama Afaan Duʼaatii Deebiʼee",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Faarfannaa eebba mana qulqullummaatiif Faarfatame. Faarfannaa Daawit.",
          "type": "text"
        }
      ]
    },
    {
