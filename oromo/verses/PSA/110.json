            "number": "5",
            "style": "v",
            "sid": "PSA 110:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gooftaan karaa harka kee mirgaa jira;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.5",
            "verseOrgIds": [
              "PSA.110.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 110:5"
      },
      "items": [
        {
          "text": "inni guyyaa dheekkamsa isaatti mootota ni burkuteessa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.5",
            "verseOrgIds": [
              "PSA.110.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 110:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni reeffa tuuluudhaan, bulchitoota guutummaa lafaa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.6",
            "verseOrgIds": [
              "PSA.110.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 110:6"
      },
      "items": [
        {
          "text": "barbadeessuudhaan sabootatti mura.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.6",
            "verseOrgIds": [
              "PSA.110.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 110:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis laga karaa cina jiru keessaa ni dhuga;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.7",
            "verseOrgIds": [
              "PSA.110.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 110:7"
      },
      "items": [
        {
          "text": "kanaafuu mataa ol qabata.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.7",
            "verseOrgIds": [
              "PSA.110.7"
            ]
          }
        }
