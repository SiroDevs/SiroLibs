                "verseId": "PSA.110.2",
                "verseOrgIds": [
                  "PSA.110.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", \"Diinota kee gidduutti moʼi\" jedhee",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.2",
            "verseOrgIds": [
              "PSA.110.2"
            ]
          }
        }
