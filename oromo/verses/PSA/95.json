      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 95:5"
      },
      "items": [
        {
          "text": "lafa gogaa illee harka isaatu uume.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.5",
            "verseOrgIds": [
              "PSA.95.5"
            ]
          }
        }
      ]
