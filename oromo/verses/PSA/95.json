                "verseOrgIds": [
                  "PSA.95.6"
                ]
              }
            }
          ]
        },
        {
          "text": "duratti ni jilbeenfannaa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.6",
            "verseOrgIds": [
              "PSA.95.6"
            ]
          }
        }
