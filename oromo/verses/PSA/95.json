                "verseId": "PSA.95.3",
                "verseOrgIds": [
                  "PSA.95.3"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa guddaadhaatii;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.3",
            "verseOrgIds": [
              "PSA.95.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 95:3"
      },
      "items": [
        {
          "text": "inni waaqota hundaa olitti Mootii guddaa dha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.3",
            "verseOrgIds": [
              "PSA.95.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
