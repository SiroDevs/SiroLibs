      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 95:2"
      },
      "items": [
        {
          "text": "faarfannaadhaanis isa haa leellifnu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.2",
            "verseOrgIds": [
              "PSA.95.2"
            ]
          }
        }
      ]
    },
