          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "abbootiin keessan utuma hojii koo arganuu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.9",
            "verseOrgIds": [
              "PSA.95.9"
            ]
          }
        }
      ]
    },
