      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 7:27"
      },
      "items": [
        {
          "text": "\"Mala isaa beekuuf waan tokko fuudhanii waan kaanitti dabaluu dha;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.27",
            "verseOrgIds": [
              "ECC.7.27"
            ]
          }
        }
      ]
    },
