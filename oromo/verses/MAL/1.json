  "verseCount": 14,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "MAL 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAL 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Raajii dubbii",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.1",
            "verseOrgIds": [
              "MAL.1.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "MAL.1.1",
                "verseOrgIds": [
                  "MAL.1.1"
                ]
              }
            }
          ]
        },
        {
          "text": "kan karaa Miilkiyaasiin gara Israaʼel dhufe.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.1",
            "verseOrgIds": [
              "MAL.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Israaʼel Jaalala Waaqaa Shakke",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAL 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ani isin jaalladheera\" jedha",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.2",
            "verseOrgIds": [
              "MAL.1.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "MAL.1.2",
                "verseOrgIds": [
                  "MAL.1.2"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.2",
            "verseOrgIds": [
              "MAL.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MAL 1:2"
      },
      "items": [
        {
          "text": "\"Isin immoo, 'Ati akkamitti nu jaallatte?' jettanii gaafattu.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.2",
            "verseOrgIds": [
              "MAL.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MAL 1:2"
      },
      "items": [
        {
          "text": "\"Esaawu obboleessa Yaaqoob hin turree?\" jedha",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.2",
            "verseOrgIds": [
              "MAL.1.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "MAL.1.2",
                "verseOrgIds": [
                  "MAL.1.2"
                ]
              }
            }
          ]
        },
        {
          "text": ". \"Taʼus ani Yaaqoobin jaalladhee,",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.2",
            "verseOrgIds": [
              "MAL.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAL 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esaawun garuu jibbeera; ani tulluuwwan isaa lafa onaa godhee dhaala isaas waangoo gammoojjiitiif kenneera.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.3",
            "verseOrgIds": [
              "MAL.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAL 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Edoomiyaas, \"Nu caccabnu iyyuu, diigama sana deebisnee ni ijaarra\" jedha taʼa.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.4",
            "verseOrgIds": [
              "MAL.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MAL 1:4"
      },
      "items": [
        {
          "text": "Garuu",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.4",
            "verseOrgIds": [
              "MAL.1.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "MAL.1.4",
                "verseOrgIds": [
                  "MAL.1.4"
                ]
              }
            }
          ]
        },
        {
          "text": "Waan Hunda Dandaʼu akkana jedha: \"Isaan ni ijaaru taʼa; ani garuu nan diiga. Isaan Biyya Hamaa, saba yeroo hunda dheekkamsa",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.4",
            "verseOrgIds": [
              "MAL.1.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "MAL.1.4",
                "verseOrgIds": [
                  "MAL.1.4"
                ]
              }
            }
          ]
        },
        {
          "text": "jala jiraatu jedhamanii ni waamamu.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.4",
            "verseOrgIds": [
              "MAL.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAL 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isin waan kana ija keessaniin argitanii, 'Daarii biyya Israaʼeliin gamatti iyyuu",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.5",
            "verseOrgIds": [
              "MAL.1.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "MAL.1.5",
                "verseOrgIds": [
                  "MAL.1.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Guddaa dha!' jettu.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.5",
            "verseOrgIds": [
              "MAL.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aarsaa Mudaa Qabuun Kakuu Cabsuu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAL 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ilmi abbaa isaa, garbichis gooftaa isaa ulfeessa. Egaa ergan abbaa taʼe, ulfinni naaf malu meerre ree? Ergan gooftaa taʼe, kabajni naaf malu meerree ree?\" jedha",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.6",
            "verseOrgIds": [
              "MAL.1.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "MAL.1.6",
                "verseOrgIds": [
                  "MAL.1.6"
                ]
              }
            }
          ]
        },
        {
          "text": "Waan Hunda Dandaʼu.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.6",
            "verseOrgIds": [
              "MAL.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MAL 1:6"
      },
      "items": [
        {
          "text": "\"Yaa luboota; isintu maqaa koo tuffata.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.6",
            "verseOrgIds": [
              "MAL.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MAL 1:6"
      },
      "items": [
        {
          "text": "\"Isin garuu, 'Nu akkamiin maqaa kee tuffanne?' jettanii gaafattu.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.6",
            "verseOrgIds": [
              "MAL.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAL 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Isin nyaata xuraaʼaa iddoo aarsaa koo irratti dhiʼeessitu.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.7",
            "verseOrgIds": [
              "MAL.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MAL 1:7"
      },
      "items": [
        {
          "text": "\"Isin garuu, 'Nu akkamiin si xureessine' jettanii gaafattu.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.7",
            "verseOrgIds": [
              "MAL.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MAL 1:7"
      },
      "items": [
        {
          "text": "\"Maaddiin",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.7",
            "verseOrgIds": [
              "MAL.1.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "MAL.1.7",
                "verseOrgIds": [
                  "MAL.1.7"
                ]
              }
            }
          ]
        },
        {
          "text": "tuffatamaa dha jechuudhaan.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.7",
            "verseOrgIds": [
              "MAL.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAL 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isin yoo horii jaamaa aarsaadhaaf dhiʼeessitan, sun balleessaa mitii? Isin yoo horii naafa yookaan horii dhukkubsataa naaf qaltan, sun balleessaa mitii? Mee horii sana bulchaa keessaniif kennuu yaalaa! Inni isinitti ni gammadaa? Inni isin harkaa ni fudhataa?\" jedha",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.8",
            "verseOrgIds": [
              "MAL.1.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "MAL.1.8",
                "verseOrgIds": [
                  "MAL.1.8"
                ]
              }
            }
          ]
        },
        {
          "text": "Waan Hunda Dandaʼu.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.8",
            "verseOrgIds": [
              "MAL.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAL 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Egaa mee akka inni garaa nuu laafuuf Waaqa nuuf kadhadhaa. Isin yoo aarsaa akkasii qabattanii dhiʼaattan inni isin harkaa ni fudhataa?\" jedha",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.9",
            "verseOrgIds": [
              "MAL.1.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "MAL.1.9",
                "verseOrgIds": [
                  "MAL.1.9"
                ]
              }
            }
          ]
        },
        {
          "text": "Waan Hunda dandaʼu.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.9",
            "verseOrgIds": [
              "MAL.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAL 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Isin keessaa namni tokko akka isin ibidda faayidaa hin qabne iddoo aarsaa koo irratti hin bobeessineef utuu balbala mana qulqullummaa cufee jiraatee! Ani isinitti hin gammadu; aarsaa tokko iyyuu isin harkaa hin fudhu\" jedha",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.10",
            "verseOrgIds": [
              "MAL.1.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "MAL.1.10",
                "verseOrgIds": [
                  "MAL.1.10"
                ]
              }
            }
          ]
        },
        {
          "text": "Waan Hunda Dandaʼu.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.10",
            "verseOrgIds": [
              "MAL.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAL 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Maqaan koo baʼa aduutii kaasee hamma lixa aduutti saboota gidduutti guddaa ni taʼa. Iddoo hundatti ixaannii fi aarsaan qulqulluun ni kennama; maqaan koo saboota gidduutti guddaa ni taʼaatii\" jedha",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.11",
            "verseOrgIds": [
              "MAL.1.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "MAL.1.11",
                "verseOrgIds": [
                  "MAL.1.11"
                ]
              }
            }
          ]
        },
        {
          "text": "Waan Hunda Dandaʼu.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.11",
            "verseOrgIds": [
              "MAL.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAL 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Isin garuu maaddiin Gooftaa 'xuraaʼaa dha' nyaanni isaas 'tuffatamaa dha' jechuudhaan maqaa koo xureessitu.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.12",
            "verseOrgIds": [
              "MAL.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAL 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "'Kun dadhabbii dha!' jettaniis tuffiidhaan itti cirriiqfattu\" jedha",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.13",
            "verseOrgIds": [
              "MAL.1.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "MAL.1.13",
                "verseOrgIds": [
                  "MAL.1.13"
                ]
              }
            }
          ]
        },
        {
          "text": "Waan Hunda Dandaʼu.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.13",
            "verseOrgIds": [
              "MAL.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MAL 1:13"
      },
      "items": [
        {
          "text": "\"Isin yoo horii hatame, kan naafate yookaan kan dhukkuba qabu fiddanii aarsaa gootanii dhiʼeessitan, ani isin harkaa fudhachuutu narra jiraa?\" jedha",
