              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yommuu inni Israaʼelin tuttuqettis, Yoonaataan ilmi Shimeʼii obboleessi Daawit isa ajjeese.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.21",
