  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "21",
        "style": "c",
        "sid": "2SA 21"
      },
      "items": [
        {
          "text": "21",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Haaloo Baafachuu Gibeʼoonotaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jabana Daawit keessa beelli waggaa sadii walitti aansee buʼe; kanaafuu Daawit fuula",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.1",
            "verseOrgIds": [
              "2SA.21.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2SA.21.1",
                "verseOrgIds": [
                  "2SA.21.1"
                ]
              }
            }
          ]
        },
        {
          "text": "barbaade.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.1",
            "verseOrgIds": [
              "2SA.21.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyos",
              "type": "text",
              "attrs": {
                "verseId": "2SA.21.1",
                "verseOrgIds": [
                  "2SA.21.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", \"Sababii Saaʼol Gibeʼoonota ajjeeseef isaa fi mana isaa irra yakka dhiigaatu jira\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.1",
            "verseOrgIds": [
              "2SA.21.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootichis Gibeʼoonota walitti qabee isaan wajjin haasaʼe. Gibeʼoononni hambaa Amoorotaa turan malee ilmaan Israaʼelootaa miti; Israaʼeloonni akka isaan eegan kakuu seenaniif; Saaʼol garuu hinaaffaa Israaʼelii fi Yihuudaaf qabuun Gibeʼoonota balleessuu barbaadee ture.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.2",
            "verseOrgIds": [
              "2SA.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daawitis, \"Ani maalin isiniif godha? Akka isin dhaala",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.3",
            "verseOrgIds": [
              "2SA.21.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2SA.21.3",
                "verseOrgIds": [
                  "2SA.21.3"
                ]
              }
            }
          ]
        },
        {
          "text": "eebbiftaniif ani akkamittin araara buusuu dandaʼa?\" jedhee Gibeʼoonota gaafate.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.3",
            "verseOrgIds": [
              "2SA.21.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gibeʼoononni immoo, \"Nu Saaʼol irraa meetii yookaan warqee gaafachuuf mirga hin qabnu; yookaan akka namni tokko iyyuu Israaʼel keessatti duʼu gochuuf nu mirga qabnaa?\" jedhanii deebisaniif.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.4",
            "verseOrgIds": [
              "2SA.21.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 21:4"
      },
      "items": [
        {
          "text": "Daawitis, \"Akka ani maal isiniif godhu barbaaddu?\" jedhee gaafate.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.4",
            "verseOrgIds": [
              "2SA.21.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis akkana jedhanii mootichaaf deebii kennan; \"Nama akka nu diigamnuu fi akka nu Israaʼel keessattis iddoo tokko illee hin arganne nu godhe sana,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.5",
            "verseOrgIds": [
              "2SA.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "sanyii isaa keessaa dhiirri torba nuuf haa kennaman; nus dhaqnee biyya Saaʼol namicha",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.6",
            "verseOrgIds": [
              "2SA.21.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "2SA.21.6",
                "verseOrgIds": [
                  "2SA.21.6"
                ]
              }
            }
          ]
        },
        {
          "text": "filate sanaa, Gibeʼaatti fuula",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.6",
            "verseOrgIds": [
              "2SA.21.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2SA.21.6",
                "verseOrgIds": [
                  "2SA.21.6"
                ]
              }
            }
          ]
        },
        {
          "text": "duratti isaan fannifnaa.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.6",
            "verseOrgIds": [
              "2SA.21.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 21:6"
      },
      "items": [
        {
          "text": "Kanaafuu mootichi, \"Tole isiniifin kenna\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.6",
            "verseOrgIds": [
              "2SA.21.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootichi garuu sababii kakuu",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.7",
            "verseOrgIds": [
              "2SA.21.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2SA.21.7",
                "verseOrgIds": [
                  "2SA.21.7"
                ]
              }
            }
          ]
        },
        {
          "text": "kan Daawitii fi Yoonaataan ilma Saaʼol gidduutti godhame sanaatiif jedhee Mefiibooshet ilma Yoonaataan ilma Saaʼol duʼa jalaa baase.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.7",
            "verseOrgIds": [
              "2SA.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootichis Armoonii fi Mefiibooshet ilmaan Riixiphaan intalli Ayyaa Saaʼoliif deesse lamaanii fi ilmaan Meerob intalli Saaʼol Adriiʼeel ilma Barzilaay namicha gosa Mehoolaatiif deesse shanan geesse.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.8",
            "verseOrgIds": [
              "2SA.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis dabarsee Gibeʼoonotatti isaan kenne. Jarris isaan ajjeesanii gaara gubbaatti fuula",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.9",
            "verseOrgIds": [
              "2SA.21.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "2SA.21.9",
                "verseOrgIds": [
                  "2SA.21.9"
                ]
              }
            }
          ]
        },
        {
          "text": "duratti isaan fannisan. Torbaan isaanii iyyuu walumaan dhuman; isaanis akkuma garbuun haamamuu jalqabeen yeroo midhaan haamamutti guyyoota jalqabaatti ajjeefaman.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.9",
            "verseOrgIds": [
              "2SA.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Riixiphaan intalli Ayyaa sun wayyaa gaddaa fudhattee kattaa irra afatte. Isheenis yeroo midhaan itti haamamuu jalqabdee hamma bokkaan reeffa jara ajjeefamanii sanatti samiidhaa roobutti akka guyyaa guyyaa allaattiin samii halkan immoo bineensonni bosonaa reeffa sana tuqan hin eeyyamne.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.10",
            "verseOrgIds": [
              "2SA.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wanni Riixiphaan intalli Ayyaa saajjatoon Saaʼol sun hojjette Daawititti himame;",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.11",
            "verseOrgIds": [
              "2SA.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "innis dhaqee lafee Saaʼolii fi lafee ilma isaa Yoonaataan namoota Yaabeesh Giliʼaad biraa fide. Isaan oobdii Beet Shaan iddoo Filisxeemonni gaafa Gilboʼaatti Saaʼolin ajjeesan itti jara fannisan sanaa isaan hatanii turaniitii.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.12",
            "verseOrgIds": [
              "2SA.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daawitis lafee Saaʼolii fi lafee Yoonaataan ilma Saaʼol achii fide; lafeen warra ajjeefamanii fannifamaniis walitti qabame.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.13",
            "verseOrgIds": [
              "2SA.21.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis lafee Saaʼolii fi lafee ilma isaa Yoonaataan biyya Beniyaam keessatti, iddoo Zeelaa jedhamutti awwaala Qiish abbaa Saaʼol keessatti awwaalanii waan mootichi ajaje hunda godhan. Sana booddee Waaqni kadhannaa waaʼee biyyattiif dhiʼaate ni dhagaʼe.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.14",
            "verseOrgIds": [
              "2SA.21.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Waraana Filisxeemotatti Baname",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "2SA.21.15-2SA.21.22"
          },
          "items": [
            {
              "text": "21:15‑22",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwf –",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "xt"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "id": "1CH.20.4-1CH.20.8"
              },
              "items": [
                {
                  "text": "1Sn 20:4‑8",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammas Filisxeemotaa fi Israaʼel gidduutti waraanni ni kaʼe. Daawitis namoota isaa wajjin Filisxeemota waraanuuf duule; innis akka malee dadhabe.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.15",
            "verseOrgIds": [
              "2SA.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namichi gosa Raafaa kan Yishbii-Benoob jedhamu tokko eeboo naasii kan kiiloo giraamii sadii fi walakkaa ulfaatuu fi goraadee haaraa hidhatee ture; innis Daawitin ajjeesuu barbaade.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.16",
            "verseOrgIds": [
              "2SA.21.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abiishaayi ilmi Zeruuyaa garuu Daawitin baraaruu dhufe; namicha Filisxeem sanas dhaʼee ajjeese. Namoonni Daawitis, \"Akka ibsaan Israaʼel hin dhaamneef ati siʼachi nu wajjin waraana hin dhaqxu\" jedhanii kakataniif.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.17",
            "verseOrgIds": [
              "2SA.21.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasii immoo lafa Goob jedhamutti Filisxeemota wajjin waraanni biraa kaʼe. Yeroo sanattis Siibekaay namichi biyya Hushaa namicha Saaf jedhamu tokko sanyii Raafaa keessaa ajjeese.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.18",
            "verseOrgIds": [
              "2SA.21.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waraana biraa kan Filisxeemota wajjin Goobitti godhame keessatti immoo Elhaanaan ilmi Yaʼiree Oregiim namichi biyya Beetlihem Gooliyaad namicha Gitii kan somaan eeboo isaa loosaa wayya dhooftuu gaʼu sana ni ajjeese.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.19",
