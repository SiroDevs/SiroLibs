      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2SA 1:21"
      },
      "items": [
        {
          "text": "fixeensi isin irra hin buʼin yookaan bokkaan isinitti hin roobin;",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.21",
            "verseOrgIds": [
              "2SA.1.21"
            ]
          }
        }
      ]
    },
