        "style": "q1",
        "vid": "2SA 1:20"
      },
      "items": [
        {
          "text": "yoo kanaa achii intallan Filisxeemotaa ni gammadu;",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.20",
            "verseOrgIds": [
              "2SA.1.20"
            ]
