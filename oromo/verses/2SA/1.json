        "style": "s1"
      },
      "items": [
        {
          "text": "Daawit Akka Saaʼol Duʼe Dhagaʼe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
