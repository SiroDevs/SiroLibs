        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "GEN.26.25",
                "verseOrgIds": [
                  "GEN.26.25"
                ]
              }
            }
          ]
        },
        {
          "text": "waammate. Dunkaana isaas achi dhaabbate; tajaajiltoonni isaas iddoo sanatti boolla bishaanii qotatan.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.25",
            "verseOrgIds": [
              "GEN.26.25"
            ]
          }
        }
      ]
