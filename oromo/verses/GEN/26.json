          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis Yisihaaqii fi Ribqaa gaddisiisan.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.35",
            "verseOrgIds": [
              "GEN.26.35"
