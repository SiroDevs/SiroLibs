          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esaawu yeroo umuriin isaa waggaa afurtama guuteetti Yoodiiti intala Biʼeer namicha gosa Heeti akkasumas Baasmati intala Eeloon namicha gosa Heeti fuudhe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.34",
            "verseOrgIds": [
              "GEN.26.34"
            ]
