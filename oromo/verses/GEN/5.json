              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Addaam erga Seeti dhalatee booddee waggaa 800 jiraate; innis ilmaanii fi intallan biraa dhalche.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.4",
            "verseOrgIds": [
              "GEN.5.4"
            ]
