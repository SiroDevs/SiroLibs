  "verseCount": 38,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "19",
        "style": "c",
        "sid": "GEN 19"
      },
      "items": [
        {
          "text": "19",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Badiisa Sodoomiitii fi Gomoraa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergamoonni Waaqayyoo sun lamaan galgala sana Sodoom gaʼan; Looxis karra Sodoomii dura taaʼaa ture. Innis yeroo jara argetti, isaan simachuuf kaʼee isaanitti deeme; gad jedhees adda isaatiin lafatti gombifame.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.1",
            "verseOrgIds": [
              "GEN.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis, \"Yaa gooftota ko, maaloo mana garbicha keessaniitti goraatii miilla dhiqadhaa bulaa; barii barraaqaan kaatanii karaa keessan itti fufuu dandeessu\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.2",
            "verseOrgIds": [
              "GEN.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 19:2"
      },
      "items": [
        {
          "text": "Isaan immoo, \"Hin taʼu; nu waltajjii karaa irra bullaa\" jedhaniin.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.2",
            "verseOrgIds": [
              "GEN.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni garuu akka malee isaan dirqisiise; kanaafuu goranii mana isaa seenan; innis maxinoo tolchee nyaata qopheesseef; isaanis ni nyaatan.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.3",
            "verseOrgIds": [
              "GEN.19.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utuu isaan hin rafin namoonni kutaalee magaalaa Sodoom hunda keessaa dhufan hundi dargaggoonnii fi jaarsoliin mana sana marsan.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.4",
            "verseOrgIds": [
              "GEN.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis Looxin waamanii, \"Namoonni galgala kana gara kee dhufan eessa jiru? Akka nu isaan wajjin ciifnuuf gad nuu yaasi\" jedhan.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.5",
            "verseOrgIds": [
              "GEN.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Looxis jara sanatti gad baʼee balbala of duubaan cufe;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.6",
            "verseOrgIds": [
              "GEN.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkanas jedhe; \"Yaa obboloota ko, waan hamaa kana hin hojjetinaa!",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.7",
            "verseOrgIds": [
              "GEN.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunoo ani intallan lama kanneen takkumaa dhiira wajjin hin ciisin qaba. Lamaanuu gad isinii nan baasa; isinis waan feetan isaan gochuu dandeessu. Namoota kanneen garuu waan isaan bantii mana koo jala jiraniif homaa isaan hin godhinaa.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.8",
            "verseOrgIds": [
              "GEN.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis, \"Badi asii!\" jedhaniin. Ittuma fufaniis, \"Namichi kun nama ormaa kan nu keessa jiraachuu dhufee dha; amma immoo abbaa murtii nutti taʼuu fedha! Nu waan hamaa jara irratti hojjennu caalaa sirratti hojjenna\" jedhaniin. Isaanis Looxin humnaan dhiibanii balbala sana cabsuu gaʼan.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.9",
            "verseOrgIds": [
              "GEN.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoonni sunis hiixatanii Looxin harkisanii manatti ol deebisan; balbalichas ni cufan.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.10",
            "verseOrgIds": [
              "GEN.19.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasii immoo namoota balbala manaa dura turan sana akka isaan balbalicha hin argineef xinnaa fi guddaa isaanii dhaʼichaan ija jaamsan.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.11",
            "verseOrgIds": [
              "GEN.19.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoonni lamaan sun Looxiin akkana jedhan; \"Ati nama biraa tokko illee jechuunis soddoota, ilmaan yookaan intallan yookaan nama kan kee taʼe tokko illee magaalaa kana keessaa qabdaa? Asi keessa isaan baafadhu;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.12",
            "verseOrgIds": [
              "GEN.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "nu iddoo kana balleessuuf deemnaatii. Sababii iyyi saba ishee irratti iyyame fuula",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.13",
            "verseOrgIds": [
              "GEN.19.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "GEN.19.13",
                "verseOrgIds": [
                  "GEN.19.13"
                ]
              }
            }
          ]
        },
        {
          "text": "duratti guddaa taʼeef, Waaqni akka nu ishee balleessinuuf nu ergeera.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.13",
            "verseOrgIds": [
              "GEN.19.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu Loox gad baʼee soddoota isaa warra intallan isaa fuudhuuf jiraniin, \"Sababii",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.14",
            "verseOrgIds": [
              "GEN.19.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "GEN.19.14",
                "verseOrgIds": [
                  "GEN.19.14"
                ]
              }
            }
          ]
        },
        {
          "text": "magaalaa kana balleessuuf kaʼeef, dafaatii asii baʼaa!\" jedhe. Soddoonni isaa garuu waan inni qoosu seʼan.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.14",
            "verseOrgIds": [
              "GEN.19.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo boruun diimatetti ergamoonni Waaqayyoo sun Looxin jarjarsanii, \"Niitii keetii fi intallan kee lamaan as jiran fudhadhuutii dafii baʼi! Yoo kanaa achii yeroo magaalattiin adabamtutti atis ni baddaa\" jedhaniin.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.15",
            "verseOrgIds": [
              "GEN.19.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni garuu duubatti harkifate; waan",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.16",
            "verseOrgIds": [
              "GEN.19.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "GEN.19.16",
                "verseOrgIds": [
                  "GEN.19.16"
                ]
              }
            }
          ]
        },
        {
          "text": "isaaniif garaa laafeef namoonni sun harka isaatii fi harka niitii isaa, intallan isaa lamaanis harka qabanii magaalattii keessaa isaan baasan.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.16",
            "verseOrgIds": [
              "GEN.19.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkuma gad isaan baasaniinis ergamoota sana keessaa inni tokko, \"Lubbuu kee oolfachuuf baqadhu! Of duuba hin milʼatin! Dirree irra iddoo tokko illee hin dhaabatin! Tulluuwwanitti ol baqadhu; yoo kanaa achii ni baddaa!\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.17",
            "verseOrgIds": [
              "GEN.19.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Loox garuu akkana isaaniin jedhe; \"Yaa gooftota ko, maaloo akkas miti!",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.18",
            "verseOrgIds": [
              "GEN.19.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunoo garbichi kee fuula kee duratti fudhatama argateera; ati lubbuu koo oolchitee gara laafina guddaa na argisiifteerta. Ani garuu gara tulluutti ol baqachuu hin dandaʼu; balaan kun na argata; anis nan duʼa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.19",
            "verseOrgIds": [
              "GEN.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunoo, magaalaan itti baqachuun dandaʼamu tokko as dhiʼoo jirti; isheen xinnoo dha. Ani gara isheetti nan baqadha; isheen baayʼee xinnoo dha mitii? Akkasitti lubbuun koo ni baraaramti.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.20",
            "verseOrgIds": [
              "GEN.19.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergamaan sunis akkana jedheen; \"Kunoo, ani kadhaa kana siif nan dhagaʼa; magaalaa ati waaʼee ishee dubbattu kana ani hin balleessu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.21",
            "verseOrgIds": [
              "GEN.19.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu sababii ani hamma ati achi geessutti homaa gochuu hin dandeenyeef dafii achitti baqadhu!\" Wanni magaalaan sun Zoʼaar jedhamteefis kanuma.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.22",
            "verseOrgIds": [
              "GEN.19.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 19:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo Loox Zoʼaar gaʼetti aduun baatee turte.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.23",
            "verseOrgIds": [
              "GEN.19.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 19:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "GEN.19.24",
                "verseOrgIds": [
                  "GEN.19.24"
                ]
              }
            }
          ]
        },
        {
          "text": "samiiwwan keessaa",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.24",
            "verseOrgIds": [
              "GEN.19.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "GEN.19.24",
                "verseOrgIds": [
                  "GEN.19.24"
                ]
              }
            }
          ]
        },
        {
          "text": "biraa, dinyii bobaʼu Sodoomii fi Gomoraa irratti roobse.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.24",
            "verseOrgIds": [
              "GEN.19.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 19:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis akkasiin magaalaawwan kanneenii fi dirreewwan sana guutuu, warra magaalaawwan sana keessa jiraatan hundaa fi biqiltuu biyya sanaa balleesse.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.25",
            "verseOrgIds": [
              "GEN.19.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 19:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niitiin Looxi garuu of duuba ilaaltee utubaa soogiddaa taatee hafte.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.26",
            "verseOrgIds": [
              "GEN.19.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 19:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abrahaamis guyyaa itti aanu ganama obboroon kaʼee iddoo duraan fuula",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.27",
            "verseOrgIds": [
              "GEN.19.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "GEN.19.27",
                "verseOrgIds": [
                  "GEN.19.27"
                ]
              }
            }
          ]
        },
        {
          "text": "dura dhaabachaa ture sanatti deebiʼe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.27",
            "verseOrgIds": [
              "GEN.19.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 19:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis gara magaalaawwan Sodoomii fi Gomoraa, gara lafa dirree sanaa hundaas ilaalee aara akka aara boolla ibiddaa keessaa baʼuu tokko isaa biyya sana keessaa ol kaʼu arge.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.28",
            "verseOrgIds": [
              "GEN.19.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 19:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqni yeroo magaalaawwan dirree sanaa balleessetti Abrahaamin yaadate; kanaafuu yommuu magaalaawwan Loox keessa jiraachaa ture balleessetti Looxin balaa sana keessaa baase.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.29",
            "verseOrgIds": [
              "GEN.19.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Looxii fi Intallan Isaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 19:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Loox waan Zoʼaar keessa jiraachuu sodaateef intallan isaa lamaan wajjin Zoʼaarii baʼee gaarran irra qubate. Innis intallan isaa lamaan wajjin holqa tokko keessa jiraate.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.30",
            "verseOrgIds": [
              "GEN.19.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 19:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaaf tokko intalli isaa isheen hangafti ishee quxisuudhaan akkana jette; \"Abbaan keenya dulloomeera; akka bartee lafa hunda irra jiruutti dhiirri nu wajjin ciisu tokko iyyuu naannoo kan hin jiru.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.31",
            "verseOrgIds": [
              "GEN.19.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 19:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kottu mee abbaa keenya daadhii wayinii obaasnee isa wajjin ciifnaa; akkasiin sanyiin abbaa keenyaa lafa irratti akka hafu goona.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.32",
            "verseOrgIds": [
              "GEN.19.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 19:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis halkan sana abbaa isaanii daadhii wayinii obaasan; intalli isheen hangafti ol seentee isa wajjin ciifte. Inni yeroo isheen ciiste yookaan yeroo isheen kaate hin beekne.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.33",
            "verseOrgIds": [
              "GEN.19.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "GEN 19:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyyaa itti aanutti intalli hangafti ishee quxisuudhaan akkana jette; \"Kunoo ani eda abbaa koo wajjin ciiseera. Kottu edanas daadhii wayinii isa obaasnaa; atis ol seenii isa wajjin ciisi; akkasitti sanyiin abbaa keenyaa akka hafu goona.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.34",
            "verseOrgIds": [
              "GEN.19.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "GEN 19:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan halkan sanas abbaa isaanii daadhii wayinii obaasan; intalli quxisuun dhaqxee isa wajjin ciiste. Inni ammas yeroo isheen ciiste yookaan yeroo isheen kaate hin beekne.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.35",
            "verseOrgIds": [
              "GEN.19.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "GEN 19:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkasiin intallan Loox lamaanuu abbaa isaaniitiif ulfaaʼan.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.36",
            "verseOrgIds": [
              "GEN.19.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "GEN 19:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Intalli isheen hangafti ilma deessee maqaa isaa Moʼaab jettee moggaafte. Inni abbaa Moʼaabota harʼaa ti.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.37",
            "verseOrgIds": [
              "GEN.19.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "GEN 19:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Intalli isheen quxisuunis ilma deessee maqaa isaa Ben-Amii jettee moggaafte; inni immoo abbaa Amoonota harʼaa ti.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.38",
            "verseOrgIds": [
              "GEN.19.38"
            ]
          }
        }
      ]
    }
  ],
