  "verseCount": 40,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "11",
        "style": "c",
        "sid": "HEB 11"
      },
      "items": [
        {
          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Hojii Amantiin Hojjetu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HEB 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amantiin waan abdannu tokko dhugumaan ni taʼa jennee fudhachuu dha; waan ijaan hin argine tokko immoo qabatamaadha jennee heduu dha.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.1",
            "verseOrgIds": [
              "HEB.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jaarsoliifis kanaan dhugaa baʼameetii.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.2",
            "verseOrgIds": [
              "HEB.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Addunyaawwan akka ajaja Waaqaatiin uumaman, wanni mulʼatus akka waan mulʼatu irraa hin hojjetamin nu amantiidhaan hubanna.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.3",
            "verseOrgIds": [
              "HEB.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abeel amantiidhaan aarsaa isa Qaayin dhiʼeesse caalu Waaqaaf dhiʼeesse. Inni yommuu Waaqni waaʼee kennaa isaa dhugaa baʼameefitti nama qajeelaa taʼuun isaa amantiidhaan dhugaa baʼameef. Abeel duʼu iyyuu hamma ammaatti amantiidhaan dubbachaa jira.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.4",
            "verseOrgIds": [
              "HEB.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HEB 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Henook akka duʼa hin argineef amantiidhaan fudhatame; waan Waaqni isa fudhateef inni hin argamne.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.5",
            "verseOrgIds": [
              "HEB.11.5"
            ]
          }
        },
        {
          "text": "Inni utuu hin fudhatamin dura akka nama Waaqa gammachiiseetti dhugaa baʼameefii tureetii.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.5",
            "verseOrgIds": [
              "HEB.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HEB 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amantiidhaan malee Waaqa gammachiisuun hin dandaʼamu; sababiin isaas namni gara isaa dhufu kam iyyuu akka inni jiruu fi akka inni warra isa barbaadaniif gatii kennu amanuu qaba.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.6",
            "verseOrgIds": [
              "HEB.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HEB 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nohi waaʼee waan amma illee ijaan hin argaminii Waaqni isa akeekkachiifnaan sodaatee warra mana isaa jiraatan oolfachuuf jedhee amantiin doonii tolche. Amantii isaatiinis addunyaatti mure; dhaaltu qajeelummaa amantiin argamuus taʼe.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.7",
            "verseOrgIds": [
              "HEB.11.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HEB 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abrahaam gara iddoo dhaaluuf jiruu akka dhaqu yommuu waamametti, amantiidhaan ajajame; eessa akka dhaqu iyyuu utuu hin beekin kaʼee deeme.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.8",
            "verseOrgIds": [
              "HEB.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HEB 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis akka keessummaa biyya ormaa jiruutti biyya isaaf waadaa galame sana keessa amantiidhaan qubate; akkuma warra isa wajjin waadaadhuma sana dhaalan, akkuma Yisihaaqii fi Yaaqoob dunkaana keessa jiraate.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.9",
            "verseOrgIds": [
              "HEB.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HEB 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni magaalaa hundee qabdu kan Waaqni ijaaree fi tolche eeggachaa tureetii.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.10",
            "verseOrgIds": [
              "HEB.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HEB 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saaraan yoo umurii daʼumsaa dabartee, dhabduu turte illee isheen waan Waaqa waadaa isheef gale sana amanamaa gootee fudhatteef, amantiidhaan mucaa daʼu dandeesse.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.11",
            "verseOrgIds": [
              "HEB.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HEB 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaaf namicha akka waan duʼeetti ilaalamu tokkicha kana irraa sanyiin akka urjii samii baayʼattuu fi akka cirracha qarqara galaanaa kan hin lakkaaʼamne dhalate.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.12",
            "verseOrgIds": [
              "HEB.11.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoonni kunneen hundinuu utuu waan waadaa galameef sana hin argatin amantii isaanii immoo utuu hin dhiisin duʼan. Waadaa sanas fagootti ilaalanii simatan. Isaanis lafa irratti akka keessummootaa fi godaantota turan beekaniiru.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.13",
            "verseOrgIds": [
              "HEB.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HEB 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Warri waan akkasii jedhan kunneen akka biyya ofii isaanii eeggachaa jiran mulʼisu.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.14",
            "verseOrgIds": [
              "HEB.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HEB 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan utuu waaʼee biyya keessaa baʼan sanaa yaadaa turanii silaa, biyya isaaniitti deebiʼuuf carraa ni argatu turan.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.15",
            "verseOrgIds": [
              "HEB.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HEB 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qooda kanaa isaan biyya wayyu tokko jechuunis biyya samii irraa sana hawwaa turan. Kanaafuu Waaqayyo Waaqa isaanii jedhamee waamamuutti hin qaanaʼu; inni magaalaa isaaniif qopheesseeraatii.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.16",
            "verseOrgIds": [
              "HEB.11.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "HEB 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abrahaam yeroo Waaqni isa qoretti amantiidhaan Yisihaaqin aarsaadhaaf dhiʼeesse. Isuma waadaa argate sanatu ilma isaa tokkicha aarsaa godhee dhiʼeessuuf qophaaʼe;",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.17",
            "verseOrgIds": [
              "HEB.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "HEB 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "innis isuma Waaqni, \"Sanyiin kee Yisihaaqiin siif waamama\"",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.18",
            "verseOrgIds": [
              "HEB.11.18"
            ]
          }
        },
        {
          "text": "jedheen sana.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.18",
            "verseOrgIds": [
              "HEB.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "HEB 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abrahaam akka Waaqni warra duʼan keessaa nama kaasuu dandaʼu illee hubatee ture; kunis karaa tokkoon inni ilma isaa Yisihaaqin warra duʼan keessaa deebisee argate jechuu dha.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.19",
            "verseOrgIds": [
              "HEB.11.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "HEB 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yisihaaq amantiidhaan waan dhufuuf jiru irratti Yaaqoobii fi Esaawun eebbise.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.20",
            "verseOrgIds": [
              "HEB.11.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "HEB 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaaqoob yeroo duʼetti amantiidhaan ilmaan Yoosef tokko tokkoon eebbise; mataa ulee isaatti irkatees sagade.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.21",
            "verseOrgIds": [
              "HEB.11.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "HEB 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoosefis yeroo duʼetti amantiidhaan waaʼee Gibxi keessaa baʼuu ijoollee Israaʼel dubbate; waaʼee lafee isaas ajaja kenne.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.22",
            "verseOrgIds": [
              "HEB.11.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "HEB 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo Museen dhalatetti abbaa fi haati isaa mucaa miidhagaa taʼuu isaa arganii utuu labsii mootichaa hin sodaatin amantiidhaan jiʼa sadii isa dhoksan.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.23",
            "verseOrgIds": [
              "HEB.11.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "HEB 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Museen yeroo guddatetti ilma intala Faraʼoon jedhamee waamamuu amantiidhaan dide.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.24",
            "verseOrgIds": [
              "HEB.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "HEB 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni gammachuu cubbuutiin yeroo gabaabaaf gammaduu irra saba Waaqaa wajjin dhiphachuu filate.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.25",
            "verseOrgIds": [
              "HEB.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "HEB 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni waan badhaasa isaa of duratti ilaaleef, Kiristoosiif jedhee salphachuu akka qabeenya Gibxi caalaa gatii guddaa qabuutti fudhate.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.26",
            "verseOrgIds": [
              "HEB.11.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "HEB 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis utuu dheekkamsa mootichaa hin sodaatin amantiidhaan Gibxi keessaa baʼe; isa hin mulʼanne sana akka waan argeetti obsee eeggate.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.27",
            "verseOrgIds": [
              "HEB.11.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "HEB 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka ergamaan hangafa ajjeesu sun hangafoota saba Israaʼel hin tuqneefis amantiidhaan akka Faasiikaan ayyaaneffamu, dhiignis akka facaafamu godhe.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.28",
            "verseOrgIds": [
              "HEB.11.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "HEB 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sabni Israaʼel akkuma nama lafa gogaa irra deemuutti amantiin Galaana Diimaa ceʼe; warri Gibxi garuu yommuu akkuma sanatti ceʼuu yaalanitti ni liqimfaman.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.29",
            "verseOrgIds": [
              "HEB.11.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "HEB 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dallaan Yerikoo erga guyyaa torba marfamee booddee amantiidhaan jige.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.30",
            "verseOrgIds": [
              "HEB.11.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "HEB 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sagaagaltuun Rahaab jedhamtu basaastota simachuu isheetiin amantiidhaan hafte malee warra hin amanin wajjin hin ajjeefamne.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.31",
            "verseOrgIds": [
              "HEB.11.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "HEB 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani egaa kana caalaa maalin jedha ree? Waaʼee Gedewoon, waaʼee Baaraq, waaʼee Saamsoon, waaʼee Yiftaa, waaʼee Daawit, waaʼee Saamuʼeelii fi waaʼee raajotaa odeessuuf ani yeroo hin qabu;",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.32",
            "verseOrgIds": [
              "HEB.11.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "HEB 11:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "isaan amantiidhaan mootummoota moʼatan; murtii qajeelaa kennan; waan waadaa galame argatan; afaan leencotaa cufan;",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.33",
            "verseOrgIds": [
              "HEB.11.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "HEB 11:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "amantiidhaan ibidda jabaa dhaamsan; qara goraadee jalaa baʼan; dadhabbiin isaanii jabinatti geeddarame; waraana keessatti humna argatanii loltoota diinaa ariʼan.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.34",
            "verseOrgIds": [
              "HEB.11.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "HEB 11:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dubartoonnis namoonni isaanii kanneen duʼan duʼaa kaafamaniifii deebisanii fudhatan. Warri kaanis duʼaa kaʼuu wayyu argachuuf jedhanii gad dhiifamuu didanii dhiphatan.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.35",
            "verseOrgIds": [
              "HEB.11.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "HEB 11:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Warra kaanitti ni qoosame; ni garafamanis; akkasumas foncaan hidhamanii mana hidhaatti darbataman.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.36",
            "verseOrgIds": [
              "HEB.11.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "HEB 11:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhagaadhaanis ni tumaman; iddoo lamatti baqaqfaman; goraadeedhaan ajjeefaman. Deeguudhaan, ariʼatamuu fi dhiphachuudhaan gogaa hoolotaatii fi reʼootaa uffatanii jooran;",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.37",
            "verseOrgIds": [
              "HEB.11.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "HEB 11:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "addunyaan isaaniif hin maleetii. Isaanis gammoojjii fi gaara irra, holqaa fi boolla keessa jooraa turan.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.38",
            "verseOrgIds": [
              "HEB.11.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "HEB 11:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Warri kunneen hundinuu yoo sababii amantii isaaniitiif jajaman iyyuu isaan keessaa namni tokko iyyuu waan waadaa galame sana hin arganne.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.39",
            "verseOrgIds": [
              "HEB.11.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "HEB 11:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqni akka isaan nu qofa wajjin warra mudaa hin qabne taʼaniif duraan dursee waan nuuf wayyu argeera.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.11.40",
            "verseOrgIds": [
              "HEB.11.40"
            ]
          }
        }
      ]
    }
  ],
