  "verseCount": 16,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "HEB 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Boqonnaa Guyyaa Sanbataa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HEB 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaaf waadaan boqonnaa isaatti galuu sun amma iyyuu waan jiruuf isin keessaa namni kam iyyuu utuu boqonnaa sanatti hin galin akka hin hafne of haa eeggannu.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.1",
            "verseOrgIds": [
              "HEB.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wangeelli isaanitti lallabame nuttis lallabameeraatii; garuu dubbiin lallabame sun waan amantii isaaniitiin wal hin fudhanneef warra dhagaʼan sanaaf faayidaa tokko illee hin kennine.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.2",
            "verseOrgIds": [
              "HEB.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nu warri amanne boqonnaa sanatti ni galla; kunis akkuma inni,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.3",
            "verseOrgIds": [
              "HEB.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HEB 4:3"
      },
      "items": [
        {
          "text": "\"Kanaafuu ani dheekkamsa kootiin,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.3",
            "verseOrgIds": [
              "HEB.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 4:3"
      },
      "items": [
        {
          "text": "'Isaan boqonnaa kootti",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.3",
            "verseOrgIds": [
              "HEB.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 4:3"
      },
      "items": [
        {
          "text": "hin galan' jedhee kakadhe\"",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.3",
            "verseOrgIds": [
              "HEB.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m",
        "vid": "HEB 4:3"
      },
      "items": [
        {
          "text": "jedhu sanaa dha. Taʼus hojiin isaa uumama addunyaatii jalqabee xumurameera.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.3",
            "verseOrgIds": [
              "HEB.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis iddoo tokkotti waaʼee guyyaa torbaffaa; \"Waaqni guyyaa torbaffaatti hojii isaa hundumaa irraa boqote\"",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.4",
            "verseOrgIds": [
              "HEB.4.4"
            ]
          }
        },
        {
          "text": "jedhee dubbate.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.4",
            "verseOrgIds": [
              "HEB.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HEB 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammas inni iddoodhuma kanatti, \"Isaan boqonnaa kootti hin galan\"",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.5",
            "verseOrgIds": [
              "HEB.4.5"
            ]
          }
        },
        {
          "text": "jedha.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.5",
            "verseOrgIds": [
              "HEB.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HEB 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amma iyyuu akka namoonni tokko tokko itti galaniif iddoon boqonnaa sun hambifameera; warri duraan wangeelli itti lallabame sun immoo sababii ajajamuu didaniif boqonnaa sanatti hin galle.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.6",
            "verseOrgIds": [
              "HEB.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HEB 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu Waaqni deebisee guyyaa tokko \"Harʼa\" jedhee waamuudhaan murteesse. Innis akkuma kanaan dura dubbatame sana bara dheeraa booddee karaa Daawitiitiin,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.7",
            "verseOrgIds": [
              "HEB.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HEB 4:7"
      },
      "items": [
        {
          "text": "\"Isin yoo harʼa sagalee isaa dhageessan,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.7",
            "verseOrgIds": [
              "HEB.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 4:7"
      },
      "items": [
        {
          "text": "mataa hin jabaatinaa\"",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.7",
            "verseOrgIds": [
              "HEB.4.7"
            ]
          }
        },
        {
          "text": "jedha.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.7",
            "verseOrgIds": [
              "HEB.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HEB 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utuu Iyyaasuun boqonnaa sanatti isaan galchee jiraatee, silaa Waaqni ergasii waaʼee guyyaa biraa hin dubbatu tureetii.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.8",
            "verseOrgIds": [
              "HEB.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HEB 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu boqonnaan Sanbataa saba Waaqaatiif kaaʼameera;",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.9",
            "verseOrgIds": [
              "HEB.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HEB 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "namni boqonnaa Waaqaatti galu kam iyyuu akkuma Waaqni hojii isaa irraa boqote sana, innis hojii isaa irraa ni boqota.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.10",
            "verseOrgIds": [
              "HEB.4.10"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.10",
            "verseOrgIds": [
              "HEB.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HEB 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu akka namni tokko illee fakkeenya ajajamuu diduu jara sanaa duukaa buʼee boqonnaa sanatti galuu hin dhabneef kottaa boqonnaa sanatti galuuf ni tattaaffannaa.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.11",
            "verseOrgIds": [
              "HEB.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HEB 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dubbiin Waaqaa jiraataa fi kan hojjetuudhaatii. Goraadee qara lama qabu kam iyyuu caalaa qaramaa dha; hamma lubbuu fi hafuura, buusaa fi dhuka gargar baasutti waraanee seena; yaadaa fi fedhii garaa namaas ni qora.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.12",
            "verseOrgIds": [
              "HEB.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uumama hunda keessaa wanti fuula Waaqaa duraa dhokatu tokko illee hin jiru. Wanti hundi ija isaa duratti qullaa fi saaqamaa dha; nus waaʼee mataa keenyaa deebii kennuufii qabna.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.13",
            "verseOrgIds": [
              "HEB.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesuus Luba Ol Aanaa Guddicha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HEB 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egaa luba ol aanaa guddicha isa samiiwwan keessa darbe, Yesuus Ilma Waaqaa waan qabnuuf kottaa amantii keenya jabeessinee qabannaa.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.14",
            "verseOrgIds": [
              "HEB.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HEB 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nu luba ol aanaa dadhabbii keenya keessatti garaa nuu hin laafne hin qabnuutii; garuu kan waan hundaan akkuma keenya qorame qabna; taʼus inni cubbuu hin hojjenne.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.15",
            "verseOrgIds": [
              "HEB.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HEB 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu akka araara argannuu fi akka ayyaana yeroo nu barbaachisutti nu gargaaru argannuuf kottaa gara teessoo ayyaanaatti sodaa malee dhiʼaannaa.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.16",
            "verseOrgIds": [
              "HEB.4.16"
            ]
          }
        }
      ]
    }
  ],
