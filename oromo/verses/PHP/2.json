{
  "id": "PHP.2",
  "number": "2",
  "bookId": "PHP",
  "reference": "Fiiliphisiyuus 2",
  "copyright": "Biblica® Hiikkaa Ammayyaa Banamaa Haaraa™, Loqoda Dhiʼaa Mirgi seeraan eegama © 2022 Biblica, Inc. Biblica® Open New Oromo Contemporary Version™, Western Copyright © 2022 by Biblica, Inc. \"Biblica\" jechuun mallattoo eenyummaa kan Biblica, Inc., Waajjira Eeyyamaa fi Mallattoo Eenyummaa kan Ameerikaa keessaatti galmeessee dha. Eeyyamaan itti fayyadamu. \"Biblica\" is trademark registered in the United States Patent and Trademark Office by Biblica, Inc. Used with permission.",
  "verseCount": 30,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "PHP 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gad Of qabuu Kiristoos Duukaa Buʼuu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PHP 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu gorsa Kiristoosiin qabdan kam iyyuu taanaan, jaalalaan wal jajjabeessuu kam iyyuu taanaan, tokkummaa Hafuuraa kam iyyuu taanaan, araaraa fi gara laafina kam iyyuu taanaan,",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.1",
            "verseOrgIds": [
              "PHP.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PHP 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "gammachuu koo naa guutaa; yaadaan tokko taʼaa; jaalala tokko qabaadhaa; hafuuraa fi kaayyoon tokko taʼaa.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.2",
            "verseOrgIds": [
              "PHP.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PHP 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isin gad of qabuudhaan akka waan warri kaan isin caalaniitti ilaalaa malee fedhii ofittummaatiin yookaan of tuulummaatiin waanuma tokko illee hin hojjetinaa.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.3",
            "verseOrgIds": [
              "PHP.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PHP 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tokkoon tokkoon keessan waan warra kaaniifis taʼu malee waan isin qofaaf taʼu hin ilaalinaa.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.4",
            "verseOrgIds": [
              "PHP.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PHP 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaadni Kiristoos Yesuus keessa ture sun, isin keessas haa jiraatu.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.5",
            "verseOrgIds": [
              "PHP.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PHP 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni utuma bifa Waaqaatiin jiruu,",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.6",
            "verseOrgIds": [
              "PHP.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PHP 2:6"
      },
      "items": [
        {
          "text": "wal qixxummaa Waaqa wajjin qabu",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.6",
            "verseOrgIds": [
              "PHP.2.6"
            ]
          }
        },
        {
          "name": "optbreak",
          "type": "tag",
          "attrs": {},
          "items": []
        },
        {
          "text": "akka waan irraa fudhatameetti hin lakkoofne;",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.6",
            "verseOrgIds": [
              "PHP.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PHP 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "qooda kanaa inni bifa garbaa uffatee",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.7",
            "verseOrgIds": [
              "PHP.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PHP 2:7"
      },
      "items": [
        {
          "text": "fakkaattii namaa fudhachuudhaan duwwaa of godhe.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.7",
            "verseOrgIds": [
              "PHP.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PHP 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bifa namaa uffatee argamuudhaanis,",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.8",
            "verseOrgIds": [
              "PHP.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PHP 2:8"
      },
      "items": [
        {
          "text": "gad of deebise;",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.8",
            "verseOrgIds": [
              "PHP.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q3",
        "vid": "PHP 2:8"
      },
      "items": [
        {
          "text": "duʼaaf jechuunis duʼa fannoo irraatiif iyyuu ni ajajame!",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PHP 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu Waaqni akka malee ol isa qabe;",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.9",
            "verseOrgIds": [
              "PHP.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PHP 2:9"
      },
      "items": [
        {
          "text": "maqaa maqaa hunda caalus isaaf kenne.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.9",
            "verseOrgIds": [
              "PHP.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PHP 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunis akka jilbi hundinuu samii fi lafa irratti,",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.10",
            "verseOrgIds": [
              "PHP.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PHP 2:10"
      },
      "items": [
        {
          "text": "lafa jalattis, maqaa Yesuusiif jilbeenfatuuf.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.10",
            "verseOrgIds": [
              "PHP.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PHP 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka arrabni hundinuus",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.11",
            "verseOrgIds": [
              "PHP.2.11"
            ]
          }
        },
        {
          "name": "optbreak",
          "type": "tag",
          "attrs": {},
          "items": []
        },
        {
          "text": "ulfina Waaqa Abbaatiif jedhee",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.11",
            "verseOrgIds": [
              "PHP.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PHP 2:11"
      },
      "items": [
        {
          "text": "Yesuus Kiristoos Gooftaa taʼuu isaa dhugaa baʼuuf.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.11",
            "verseOrgIds": [
              "PHP.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Waan Hunda Guungummii Malee Hojjechuu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PHP 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu yaa jaallatamoo, akkuma yeroo hunda ajajamtan sana, yeroo ani isin bira jiru qofa utuu hin taʼin amma yeroo ani isin bira hin jirretti caalchisaatii sodaa fi hollannaan fayyina keessan fiixaan baasuuf itti fufaa;",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.12",
            "verseOrgIds": [
              "PHP.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PHP 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "akkuma kaayyoo isaa gaarii sanaatti fedhuu fi hojjechuu isin keessatti kan raawwatu Waaqaatii.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.13",
            "verseOrgIds": [
              "PHP.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PHP 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan hunda guungummii fi falmii malee hojjedhaa;",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.14",
            "verseOrgIds": [
              "PHP.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PHP 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "kunis akka isin dhaloota micciiramaa fi jalʼaa kana gidduutti akkuma ifaa addunyaa keessatti ibsitaniif, akka warra mudaa hin qabnee fi qulqullaaʼoo, ijoollee Waaqaa warra yakka hin qabnes taataniif,",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.15",
            "verseOrgIds": [
              "PHP.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PHP 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "yoo isin dubbii jireenyaa jabeessitanii qabattan ani akkasumaan akka hin fiigin yookaan akkasumaan akka hin dadhabin guyyaa Kiristoositti of jajuu nan dandaʼa.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.16",
            "verseOrgIds": [
              "PHP.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PHP 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani utuu aarsaa fi tajaajila amantii keessanii irratti akka dhibaayyuutti dhangalaafamee iyyuu nan gammada; hunda keessan wajjinis nan gammada.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.17",
            "verseOrgIds": [
              "PHP.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PHP 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu isinis na wajjin gammaduu fi ililchuu qabdu.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.18",
            "verseOrgIds": [
              "PHP.2.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Xiimotewosii fi Afrodiixuu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PHP 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani oduu waaʼee keessanii dhagaʼee gammaduuf, akka ani dafee Xiimotewosin gara keessanitti erguu dandaʼu Gooftaa Yesuusin nan abdadha.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.19",
            "verseOrgIds": [
              "PHP.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PHP 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani nama biraa kan akka isaa waaʼee keessan garaa qulqulluun yaadu tokko illee hin qabu.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.20",
            "verseOrgIds": [
              "PHP.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PHP 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sababiin isaas warri kaan hundi utuu fedhii Yesuus Kiristoosiif hin taʼin fedhii mataa isaaniitiif yaaduutii.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.21",
            "verseOrgIds": [
              "PHP.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PHP 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Xiimotewos garuu akkuma ilmi abbaa isaa tajaajilutti hojii wangeelaa keessatti na wajjin tajaajiluu isaa akka of mirkaneesse isinuu beektu.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.22",
            "verseOrgIds": [
              "PHP.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PHP 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaaf ani akkuma haala koo hubadheen isa erguuf nan abdadha.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.23",
            "verseOrgIds": [
              "PHP.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "PHP 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani mataan koo iyyuu dafee dhufuuf Gooftaa nan amanadha.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.24",
            "verseOrgIds": [
              "PHP.2.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "PHP 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani garuu obboleessa koo Ephafroodiixuu hojjetaa hidhata koo taʼee fi loltuu hidhata koo taʼe, ergamaa keessan kan isin akka inni waan na barbaachisuun na tajaajiluuf ergitan sana deebisee gara keessan erguun barbaachisaa natti fakkaata.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.25",
            "verseOrgIds": [
              "PHP.2.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "PHP 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni hunda keessan yaadaatii; isin akka inni dhukkubsatee ture waan dhageessaniifis dhiphachaa jira.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.26",
            "verseOrgIds": [
              "PHP.2.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "PHP 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni dhugumaan dhukkubsatee duʼuu gaʼee ture. Waaqni garuu isa maareera; utuu isa qofa hin taʼin akka gaddi gadda irratti natti hin dabalamneef anas baraareera.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.27",
            "verseOrgIds": [
              "PHP.2.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "PHP 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu isin akka yommuu lammata isa argitanitti gammaddanii fi akka yaaddoon koos naa salphatuuf dafee gara keessanitti isa erguu guddaa nan hawwa.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.28",
            "verseOrgIds": [
              "PHP.2.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "PHP 2:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isinis Gooftaadhaan gammachuu guddaan isa simadhaa; namoota akkasiis kabajaa;",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.29",
            "verseOrgIds": [
              "PHP.2.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "PHP 2:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "inni gargaarsa isin naa kennuu hin dandaʼin naa kennuuf, jireenya isaa illee dabarsee kennuun, hojii Kiristoosiif jedhee duʼuu iyyuu gaʼee tureetii.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.30",
            "verseOrgIds": [
              "PHP.2.30"
            ]
          }
        }
      ]
    }
