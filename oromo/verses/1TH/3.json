    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1TH 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu nu waan hammana caalaa obsuu dadhabneef kophaa keenya Ateenaatti hafuun gaarii nutti fakkaate.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.1",
            "verseOrgIds": [
              "1TH.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1TH 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nus obboleessa keenya Xiimotewos, tajaajilaa Waaqaa isa wangeela Kiristoosiitti hojjetaa hidhata keenya taʼe sana, akka inni amantii keessanitti isin cimsuu fi isin jajjabeessuuf ergineerra;",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.2",
            "verseOrgIds": [
              "1TH.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1TH 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kunis akka namni tokko iyyuu dhiphina kanaan hin jeeqamneef. Isinis akka nu waan kanaaf filatamne sirriitti beektu.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.3",
            "verseOrgIds": [
              "1TH.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1TH 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo isin bira turretti akka dhiphinni nurra gaʼu isinitti himaa turreetii. Innis akkuma isin beektan sana taʼe.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.4",
            "verseOrgIds": [
              "1TH.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1TH 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sababii kanaaf ani yommuun kana caalaa obsuu dadhabetti waaʼee amantii keessanii baruuf jedheen isa erge. Tarii inni nama qoru sun isin qoree dadhabbiin keenyas faayidaa malee hafeera jedheen sodaadhe.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.5",
            "verseOrgIds": [
              "1TH.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Xiimotewos Oduu Gaarii Fide",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1TH 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amma garuu Xiimotewos isin biraa gara keenya dhufee waaʼee amantii keessaniitii fi waaʼee jaalala keessanii oduu gaarii nutti himeera. Akkasumas akka isin yeroo hunda yaada gaariidhaan nu yaaddanii fi akkuma nu isin arguu hawwinu sana akka isinis nu arguu hawwitan nutti himeera.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.6",
            "verseOrgIds": [
              "1TH.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1TH 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaaf yaa obboloota, nu dhiphinaa fi ariʼatama keenya hunda keessatti amantii keessaniin waaʼee keessan jajjabaanneerra.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.7",
            "verseOrgIds": [
              "1TH.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1TH 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoo isin Gooftaatti cimtanii dhaabatan nu dhugumaan ni jiraannaatii.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.8",
            "verseOrgIds": [
              "1TH.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1TH 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gammachuu sababii keessaniin fuula Waaqa keenyaa duratti qabnu hundaaf waaʼee keessaniif hammam Waaqa galateeffachuu dandeenya?",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.9",
            "verseOrgIds": [
              "1TH.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1TH 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nu akka deebinee isin arginuu fi waan amantii keessan keessaa hirʼates akka isinii guutuu dandeenyuuf halkanii guyyaa cimsinee kadhanna.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.10",
            "verseOrgIds": [
              "1TH.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1TH 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammas Waaqni keenyaa fi Abbaan keenya mataan isaa, Gooftaan keenya Yesuusis akka nu gara keessan dhufnu karaa nuuf haa qajeelchu.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.11",
            "verseOrgIds": [
              "1TH.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1TH 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkuma jaalalli nu isinii qabnu dabalaa deemu sana Gooftaan jaalala isin walii keessanii fi nama hundaaf qabdan isinii haa guddisuu; haa baayʼisus.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.12",
            "verseOrgIds": [
              "1TH.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1TH 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka isin yommuu Gooftaan keenya Yesuus qulqulloota isaa hunda wajjin dhufutti fuula Waaqa keenyaatii fi Abbaa keenyaa duratti warra mudaa hin qabnee fi qulqulloota taataniifis inni garaa keessan haa jajjabeessu.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.13",
            "verseOrgIds": [
              "1TH.3.13"
            ]
          }
        }
      ]
    }
  ],
