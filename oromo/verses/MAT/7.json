        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Guyyaa sana namoonni hedduun, 'Yaa Gooftaa, yaa Gooftaa, nu maqaa keetiin raajii dubbanneerra mitii? Maqaa keetiin hafuurota hamoo baafneerra mitii? Maqaa keetiin dinqii hedduu hojjenneerra mitii?' naan jedhu.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.22",
