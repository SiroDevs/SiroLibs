              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Namni dubbii koo kana dhagaʼee hojiidhaan hin argisiifne hundi garuu nama gowwaa mana isaa cirracha irratti ijaarrate fakkaata.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.26",
                "verseOrgIds": [
