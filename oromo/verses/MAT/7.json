            "id": "MAT.7.3-MAT.7.5"
          },
          "items": [
            {
              "text": "7:3‑5",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwf –",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "xt"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "id": "LUK.6.41"
              },
              "items": [
                {
                  "text": "Luq 6:41",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "id": "LUK.6.42"
              },
              "items": [
                {
                  "text": "42",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Akka isinitti hin muramneef namoota kaanitti hin murinaa.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.1",
                "verseOrgIds": [
                  "MAT.7.1"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.1",
            "verseOrgIds": [
              "MAT.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Murtiidhuma isin namatti murtaniin isinitti muramaatii; safartuu ittiin safartaniinis isiniif safarama.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.2",
                "verseOrgIds": [
                  "MAT.7.2"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ati maaliif jirma ija kee keessa jiru arguu dhiiftee huuba ija obboleessa keetii keessa jiru ilaalta?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.3",
                "verseOrgIds": [
                  "MAT.7.3"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.3",
            "verseOrgIds": [
              "MAT.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ati utuu jirmi ija kee keessa jiruu akkamitti obboleessa keetiin, 'Kottu mee ani huuba ija kee keessa jiru siif nan baasa' jechuu dandeessa?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.4",
                "verseOrgIds": [
                  "MAT.7.4"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.4",
            "verseOrgIds": [
              "MAT.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Fakkeessituu nana; duraan dursiitii jirma ija kee keessa jiru baafadhu; ergasiis huuba ija obboleessa keetii keessa jiru baasuudhaaf sirriitti argita.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.5",
                "verseOrgIds": [
                  "MAT.7.5"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Waan qulqulluu sarootaaf hin kenninaa; lula keessanis booyyee dura hin buusinaa. Yoo kana gootan isaan miilla isaaniitiin dhidhiitu; gara galanis isin cicciru.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.6",
                "verseOrgIds": [
                  "MAT.7.6"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kadhadhaa, Barbaadaa, Balbala Rurrukutaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "MAT.7.7-MAT.7.11"
          },
          "items": [
            {
              "text": "7:7‑11",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwf –",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "xt"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "id": "LUK.11.9-LUK.11.13"
              },
              "items": [
                {
                  "text": "Luq 11:9‑13",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kadhadhaa, isiniif ni kennamaa; barbaadaa, ni argattuu; rurrukutaa, balballi isiniif ni banamaa.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.7",
                "verseOrgIds": [
                  "MAT.7.7"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.7",
            "verseOrgIds": [
              "MAT.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Namni kadhatu hundi ni argataatii; namni barbaadu ni argata; nama rurrukutuufis balballi ni banama.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.8",
                "verseOrgIds": [
                  "MAT.7.8"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Isin keessaa namni yoo ilmi isaa buddeena isa kadhate, dhagaa kennuuf eenyu?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.9",
                "verseOrgIds": [
                  "MAT.7.9"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.9",
            "verseOrgIds": [
              "MAT.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Yookaan yoo inni qurxummii isa kadhate, bofa kennuuf eenyu?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.10",
                "verseOrgIds": [
                  "MAT.7.10"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.10",
            "verseOrgIds": [
              "MAT.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Erga isin warri hamoon iyyuu kennaa gaarii ijoollee keessaniif kennuu beektanii, abbaan keessan inni samii irraa immoo hammam caalchisee warra isa kadhataniif kennaa gaarii haa kennuu ree!",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.11",
                "verseOrgIds": [
                  "MAT.7.11"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.11",
            "verseOrgIds": [
              "MAT.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kanaafuu waan akka namoonni isiniif godhan barbaaddan hundumaa isinis akkasuma isaaniif godhaa; Seerris Raajonnis kanumaatii.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.12",
                "verseOrgIds": [
                  "MAT.7.12"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Karra Dhiphaa fi Karra Balʼaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Karra dhiphaadhaan seenaa. Karaan badiisatti geessu balʼaadhaatii; karri isaas balʼaa dha; namoonni ittiin seenanis baayʼee dha.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.13",
                "verseOrgIds": [
                  "MAT.7.13"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.13",
            "verseOrgIds": [
              "MAT.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Garuu karri isaa dhiphaa dha; karaan jireenyatti nama geessu qalʼaa dha; warri isa argatanis muraasa.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.14",
                "verseOrgIds": [
                  "MAT.7.14"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mukaa fi Ija Isaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Raajota sobaa warra kalʼee hoolaa uffatanii gara keessan dhufan, kanneen keessi isaanii garuu yeeyyii akka malee beelaʼee waa cicciratu taʼe irraa of eeggadhaa.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.15",
                "verseOrgIds": [
                  "MAT.7.15"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.15",
            "verseOrgIds": [
              "MAT.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Isin ija isaaniitiin isaan beektu. Namoonni qoraattii irraa wayinii yookaan sokorruu irraa harbuu ni ciruu?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.16",
                "verseOrgIds": [
                  "MAT.7.16"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.16",
            "verseOrgIds": [
              "MAT.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Akkasumas mukni gaariin hundumtuu ija gaarii naqata; mukni gadheen immoo ija gadhee naqata.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.17",
                "verseOrgIds": [
                  "MAT.7.17"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.17",
            "verseOrgIds": [
              "MAT.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mukni gaariin ija gadhee naqachuu hin dandaʼu; mukni gadheenis ija gaarii naqachuu hin dandaʼu.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.18",
                "verseOrgIds": [
                  "MAT.7.18"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.18",
            "verseOrgIds": [
              "MAT.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mukni ija gaarii hin naqanne hundi muramee ibiddatti naqama.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.19",
                "verseOrgIds": [
                  "MAT.7.19"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.19",
            "verseOrgIds": [
              "MAT.7.19"
            ]
          }
