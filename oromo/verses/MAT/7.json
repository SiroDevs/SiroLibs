        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Bokkaan roobee, lolaan lolaʼee, bubbeenis bubbisee mana sana dhaʼe; manichi garuu waan kattaa irratti hundeeffameef hin jigne.",
              "type": "text",
              "attrs": {
