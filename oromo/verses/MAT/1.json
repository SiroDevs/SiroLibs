      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abrahaam Yisihaaqin dhalche;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.2",
            "verseOrgIds": [
              "MAT.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "MAT 1:2"
      },
      "items": [
        {
          "text": "Yisihaaq Yaaqoobin dhalche;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.2",
            "verseOrgIds": [
              "MAT.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "MAT 1:2"
      },
      "items": [
        {
          "text": "Yaaqoob Yihuudaa fi obboloota isaa dhalche;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.2",
            "verseOrgIds": [
              "MAT.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yihuudaan Taamaar irraa Faaresii fi Zeraa dhalche;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.3",
            "verseOrgIds": [
              "MAT.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "MAT 1:3"
      },
      "items": [
        {
          "text": "Faares Hezroonin dhalche;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.3",
            "verseOrgIds": [
              "MAT.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "MAT 1:3"
      },
      "items": [
        {
          "text": "Hezroon Arraamin dhalche;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.3",
            "verseOrgIds": [
              "MAT.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arraam Amiinaadaabin dhalche;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.4",
            "verseOrgIds": [
              "MAT.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "MAT 1:4"
      },
      "items": [
        {
          "text": "Abiinaadaab Nahishoonin dhalche;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.4",
            "verseOrgIds": [
              "MAT.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "MAT 1:4"
      },
      "items": [
        {
          "text": "Nahishoon Salmoonin dhalche;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.4",
            "verseOrgIds": [
              "MAT.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Salmoon Rahaab irraa Boʼeezin dhalche;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.5",
            "verseOrgIds": [
              "MAT.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "MAT 1:5"
      },
      "items": [
        {
          "text": "Boʼeez Ruut irraa Yoobeedin dhalche;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.5",
            "verseOrgIds": [
              "MAT.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "MAT 1:5"
      },
      "items": [
        {
          "text": "Yoobeed Isseeyin dhalche;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.5",
            "verseOrgIds": [
              "MAT.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isseey Daawit Mooticha dhalche.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.6",
            "verseOrgIds": [
              "MAT.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "MAT 1:6"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "MAT 1:6"
      },
      "items": [
        {
          "text": "Daawit niitii Uuriyaa irraa Solomoonin dhalche;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.6",
            "verseOrgIds": [
              "MAT.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoon Rehooboʼaamin dhalche;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.7",
            "verseOrgIds": [
              "MAT.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "MAT 1:7"
      },
      "items": [
        {
          "text": "Rehooboʼaam Abiyaa dhalche;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.7",
            "verseOrgIds": [
              "MAT.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "MAT 1:7"
      },
      "items": [
        {
          "text": "Abiyaan Asaafin dhalche;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.7",
            "verseOrgIds": [
              "MAT.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asaaf Yehooshaafaaxin dhalche;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.8",
            "verseOrgIds": [
              "MAT.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "MAT 1:8"
      },
      "items": [
        {
          "text": "Yehooshaafaax Yehooraamin dhalche;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.8",
            "verseOrgIds": [
              "MAT.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "MAT 1:8"
      },
      "items": [
        {
          "text": "Yehooraam Uziyaan dhalche;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.8",
            "verseOrgIds": [
              "MAT.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uziyaan Yootaamin dhalche;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.9",
            "verseOrgIds": [
              "MAT.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "MAT 1:9"
      },
      "items": [
        {
          "text": "Yootaam Akaazin dhalche;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.9",
            "verseOrgIds": [
              "MAT.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "MAT 1:9"
      },
      "items": [
        {
          "text": "Akaaz Hisqiyaasin dhalche;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.9",
            "verseOrgIds": [
              "MAT.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hisqiyaas Minaasee dhalche;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.10",
            "verseOrgIds": [
              "MAT.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "MAT 1:10"
      },
      "items": [
        {
          "text": "Minaaseen Aamoonin dhalche;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.10",
            "verseOrgIds": [
              "MAT.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "MAT 1:10"
      },
      "items": [
        {
          "text": "Aamoon Yosiyaasin dhalche;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.10",
            "verseOrgIds": [
              "MAT.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosiyaas bara boojuu Baabilon keessa, Yekooniyaanii fi obboloota isaa dhalche.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.11",
            "verseOrgIds": [
              "MAT.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "lh"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boojuu Baabilon booddee,",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "MAT 1:12"
      },
      "items": [
        {
          "text": "Yekooniyaan Sheʼaltiiʼeelin dhalche;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.12",
            "verseOrgIds": [
              "MAT.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "MAT 1:12"
      },
      "items": [
        {
          "text": "Sheʼaltiiʼeel Zarubaabelin dhalche;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.12",
            "verseOrgIds": [
              "MAT.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zarubaabel Abiyuudin dhalche;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.13",
            "verseOrgIds": [
              "MAT.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "MAT 1:13"
      },
      "items": [
        {
          "text": "Abiyuud Eliyaaqeemin dhalche;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.13",
            "verseOrgIds": [
              "MAT.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "MAT 1:13"
      },
      "items": [
        {
          "text": "Eliyaaqeem Azoorin dhalche;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.13",
            "verseOrgIds": [
              "MAT.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azoor Zaadoqin dhalche;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.14",
            "verseOrgIds": [
              "MAT.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "MAT 1:14"
      },
      "items": [
        {
          "text": "Zaadoq Akiimin dhalche;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.14",
            "verseOrgIds": [
              "MAT.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "MAT 1:14"
      },
      "items": [
        {
          "text": "Akiim Eliyuudin dhalche;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.14",
            "verseOrgIds": [
              "MAT.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliyuud Eleʼaazaarin dhalche;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.15",
            "verseOrgIds": [
              "MAT.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "MAT 1:15"
      },
      "items": [
        {
          "text": "Eleʼaazaar Maattaanin dhalche;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.15",
            "verseOrgIds": [
              "MAT.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "MAT 1:15"
      },
      "items": [
        {
          "text": "Maattaan Yaaqoobin dhalche;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.15",
            "verseOrgIds": [
              "MAT.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaaqoob Yoosefin dhalche; Yoosef kunis dhirsa Maariyaam ishee Yesuus isa Kiristoos jedhamu deesse sanaa ti.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.16",
            "verseOrgIds": [
              "MAT.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "lf"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egaa walumaa galatti Abrahaamii hamma Daawititti dhaloota kudha afur, Daawitii hamma boojuu Baabilonitti dhaloota kudha afur, boojuu Baabilonii hamma Kiristoosiitti dhaloota kudha afurtu ture.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Dhalachuu Yesuus Kiristoos",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhalachuun Yesuus Kiristoos akkana ture: Haati isaa Maariyaam kaadhima Yoosef turte; isheenis utuu Yoosef wajjin wal bira hin gaʼin Hafuura Qulqulluudhaan ulfooftee argamte.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.18",
            "verseOrgIds": [
              "MAT.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoosef kaadhimni ishee sunis nama qajeelaa waan tureef, dhoksaadhaan ishee dhiisuu murteesse malee uummata duratti ishee qaanessuu hin barbaanne.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.19",
            "verseOrgIds": [
              "MAT.1.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utuu inni waan kana yaadaa jiruu, ergamaan Gooftaa abjuu keessa itti mulʼatee akkana jedheen; \"Yaa Yoosef ilma Daawit, kaadhimni kee Maariyaam Hafuura Qulqulluudhaan waan ulfoofteef ishee fuudhuu hin sodaatin.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.20",
            "verseOrgIds": [
              "MAT.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isheen ilma deessi; atis maqaa isaa Yesuus jettee ni moggaafta; inni saba isaa cubbuu isaanii irraa ni fayyisaatii.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.21",
            "verseOrgIds": [
              "MAT.1.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kun hundinuu akka wanni Gooftaan karaa raajichaatiin dubbate sun raawwatamuuf taʼe.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.22",
            "verseOrgIds": [
              "MAT.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis, \"Kunoo, durbi tokko ni ulfoofti; ilma ni deessi; maqaa isaas Amaanuʼel jedhu\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.23",
            "verseOrgIds": [
              "MAT.1.23"
            ]
          }
        },
        {
          "text": "jedha. Amaanuʼel jechuunis, \"Waaqni nu wajjin jira\" jechuu dha.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.23",
            "verseOrgIds": [
              "MAT.1.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoosefis hirribaa dammaqee akkuma ergamaan Gooftaa isa ajajetti Maariyaamin niitummaadhaan mana isaatti fudhate.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.24",
            "verseOrgIds": [
              "MAT.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garuu inni hamma isheen ilma deessutti ishee bira hin geenye. Maqaa isaas, \"Yesuus\" jedhee moggaase.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.25",
            "verseOrgIds": [
              "MAT.1.25"
            ]
          }
        }
      ]
    }
  ],
