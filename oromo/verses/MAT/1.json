              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiddi dhaloota Yesuus Kiristoos sanyii Daawit, sanyii Abrahaam taʼe sanaa kanaa dha:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
