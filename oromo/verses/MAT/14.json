    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuus yommuu waan kana dhagaʼetti achii kaʼee kophaa isaa bidiruudhaan iddoo namni hin jirre tokko dhaqe. Namoonnis yommuu waan kana dhagaʼanitti magaalaawwanii baʼanii miillaan isa duukaa buʼan.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.13",
            "verseOrgIds": [
              "MAT.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuus yommuu bidiruu irraa buʼetti tuuta guddaa tokko arge; innis garaa laafeefii dhukkubsattoota isaanii fayyiseef.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.14",
            "verseOrgIds": [
              "MAT.14.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yommuu galgalaaʼetti barattoonni gara isaa dhufanii, \"Iddoon kun gammoojjii dha; aduunis dhiiteerti. Namoonni kunneen gara gandootaa dhaqanii akka nyaata bitataniif isaan gad dhiisi\" jedhaniin.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.15",
            "verseOrgIds": [
              "MAT.14.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuus garuu,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.16",
            "verseOrgIds": [
              "MAT.14.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Deemuun isaan hin barbaachisu. Isinuu waan isaan nyaatan kennaafii\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.14.16",
                "verseOrgIds": [
                  "MAT.14.16"
                ]
              }
            }
          ]
        },
        {
          "text": "jedhee deebise.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.16",
            "verseOrgIds": [
              "MAT.14.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis, \"Nu buddeena shanii fi qurxummii lama qofa asii qabna\" jedhanii deebisan.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.17",
            "verseOrgIds": [
              "MAT.14.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuusis,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.18",
            "verseOrgIds": [
              "MAT.14.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Isuma natti fidaa\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.14.18",
                "verseOrgIds": [
                  "MAT.14.18"
                ]
              }
            }
          ]
        },
        {
          "text": "jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.18",
            "verseOrgIds": [
              "MAT.14.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis akka namoonni marga irra tataaʼan ajajee buddeena shananii fi qurxummii lamaan sana fuudhee, gara samii ol ilaalee galata galchee buddeena sana caccabsees barattootatti kenne; barattoonni immoo namootaaf kennan.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.19",
            "verseOrgIds": [
              "MAT.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan hundi nyaatanii quufan; barattoonnis hurraaʼaa hambifame gundoo kudha lama guutuu walitti qaban.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.20",
            "verseOrgIds": [
              "MAT.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Warri nyaatanis dubartootaa fi ijoollee malee gara dhiira kuma shanii turan.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.21",
            "verseOrgIds": [
              "MAT.14.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesuus Bishaan irra Deeme",
          "type": "text"
        }
      ]
    },
