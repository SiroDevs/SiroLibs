    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bara sana Heroodis bulchaan oduu waaʼee Yesuus dhagaʼe;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.1",
            "verseOrgIds": [
              "MAT.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "innis tajaajiltoota isaatiin, \"Kun Yohannis Cuuphaa dha; inni warra duʼan keessaa kaafameera! Sababiin hojiin dinqii isaan hojjetamuufis kanuma\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.2",
            "verseOrgIds": [
              "MAT.14.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Heroodis sababii niitii obboleessa isaa Fiiliphoos, sababii Heroodiyaasiitiif jedhee Yohannisin qabee, hidhee mana hidhaatti galchee tureetii.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.3",
            "verseOrgIds": [
              "MAT.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunis sababii Yohannis Heroodisiin, \"Ati ishee fuudhuun kee seera miti\" jechaa tureef.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.4",
            "verseOrgIds": [
              "MAT.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni immoo Yohannisin ajjeesuu barbaade; garuu sababii namoonni Yohannisin akka raajiitti ilaalaa turaniif isaan sodaate.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.5",
            "verseOrgIds": [
              "MAT.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Intalli Heroodiyaas guyyaa dhaloota Heroodisitti keessummoota duratti sirbitee Heroodisin gammachiifte;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.6",
            "verseOrgIds": [
              "MAT.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "kanaafuu inni waan isheen gaafatte kam iyyuu isheef kennuuf kakuudhaan waadaa gale.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.7",
            "verseOrgIds": [
              "MAT.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isheenis haadha isheetiin gorfamtee, \"Mataa Yohannis Cuuphaa gabatee irra kaaʼii naa kenni\" jette.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.8",
            "verseOrgIds": [
              "MAT.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mootichis ni gadde; garuu sababii kakuu isaatii fi sababii warra isa wajjin maaddiitti dhiʼaataniitiif jedhee akka wanni isheen barbaadde sun isheef kennamu ajaje;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.9",
            "verseOrgIds": [
              "MAT.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "innis nama ergee mana hidhaa keessatti mataa Yohannis isa irraa kute.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.10",
            "verseOrgIds": [
              "MAT.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mataan isaas gabatee irra kaaʼamee fidamee intalattiitti kenname; isheenis haadha isheetti geessite.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.11",
            "verseOrgIds": [
              "MAT.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barattoonni Yohannisis dhufanii reeffa isaa fuudhanii awwaalan. Isaanis dhaqanii Yesuusitti himan.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.12",
            "verseOrgIds": [
              "MAT.14.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesuus Nama Kuma Shan Sooruu Isaa",
          "type": "text"
        }
      ]
    },
