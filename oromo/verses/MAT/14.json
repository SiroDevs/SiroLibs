      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuus yommusuma akka barattoonni bidiruu yaabbatanii hamma inni tuuta sana of irraa geggeessutti isa dura gamatti darbaniif isaan dirqisiise.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.22",
            "verseOrgIds": [
              "MAT.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis erga namoota of irraa geggeessee booddee kadhachuuf kophaa isaa gaaratti ol baʼe. Yommuu galgalaaʼettis kophaa isaa achi ture;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.23",
            "verseOrgIds": [
              "MAT.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "yeroo kanatti immoo bidiruun sun lafa irraa xinnoo achi hiiqxee turte; sababii bubbeen fuula duraan itti bubbiseef bidiruun sun dambaliidhaan asii fi achi raafamaa turte.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.24",
            "verseOrgIds": [
              "MAT.14.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuusis halkan keessaa kutaa afuraffaatti galaana irra deemaa gara isaanii dhufe.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.25",
            "verseOrgIds": [
              "MAT.14.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 14:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barattoonnis yommuu galaana irra deemuu isaa arganitti akka malee rifatan. Sodaataniis, \"Kun ekeraa dha\" jedhanii iyyan.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.26",
            "verseOrgIds": [
              "MAT.14.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuus garuu yommusuma,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.27",
            "verseOrgIds": [
              "MAT.14.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Jabaadhaa! Anumaatii hin sodaatinaa\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.14.27",
                "verseOrgIds": [
                  "MAT.14.27"
                ]
              }
            }
          ]
        },
        {
          "text": "jedhee isaanitti dubbate.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.27",
            "verseOrgIds": [
              "MAT.14.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phexros immoo, \"Yaa Gooftaa! Egaa si taanaan, akka ani bishaan irra deemee gara kee dhufu na ajaji\" jedhee deebiseef.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.28",
            "verseOrgIds": [
              "MAT.14.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 14:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuusis,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.29",
            "verseOrgIds": [
              "MAT.14.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kottu\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.14.29",
                "verseOrgIds": [
                  "MAT.14.29"
                ]
              }
            }
          ]
        },
        {
          "text": "jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.29",
            "verseOrgIds": [
              "MAT.14.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MAT 14:29"
      },
      "items": [
        {
          "text": "Phexros immoo bidiruu sana irraa buʼee bishaan irra deemaa gara Yesuus dhufe.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.29",
            "verseOrgIds": [
              "MAT.14.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 14:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yommuu bubbee jabaa sana argetti garuu ni sodaate; liqimfamuu jalqabnaanis, \"Yaa Gooftaa na oolchi!\" jedhee iyye.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.30",
            "verseOrgIds": [
              "MAT.14.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 14:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuus yommusuma harka isaa hiixatee isa qabee,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.31",
            "verseOrgIds": [
              "MAT.14.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Yaa namicha amantii xinnoo nana, ati maaliif mamte?\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.14.31",
                "verseOrgIds": [
                  "MAT.14.31"
                ]
              }
            }
          ]
        },
        {
          "text": "jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.31",
            "verseOrgIds": [
              "MAT.14.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 14:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yommuu isaan bidiruu yaabbatanittis bubbeen sun gab jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.32",
            "verseOrgIds": [
              "MAT.14.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 14:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Warri bidiruu sana keessa turanis, \"Ati dhuguma Ilma Waaqaa ti!\" jedhanii isaaf sagadan.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.33",
            "verseOrgIds": [
              "MAT.14.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 14:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis yommuu gama ceʼanitti Geensereexitti bidiruu irraa buʼan.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.34",
            "verseOrgIds": [
              "MAT.14.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 14:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoonni iddoo sanaas yommuu Yesuusin beekanitti biyya naannoo sanaa hundatti dhaamsa ergan. Namoonnis dhukkubsattoota isaanii hunda isatti fidan;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.35",
            "verseOrgIds": [
              "MAT.14.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MAT 14:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "akka dhukkubsattoonni sun handaara wayyaa isaa illee tuqaniif isa kadhatan; warri handaara wayyaa isaa tuqan hundinuus ni fayyan.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.36",
            "verseOrgIds": [
              "MAT.14.36"
            ]
          }
        }
      ]
    }
  ],
