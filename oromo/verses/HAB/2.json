          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani iddoo koo dhaabadhee",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.1",
            "verseOrgIds": [
              "HAB.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:1"
      },
      "items": [
        {
          "text": "dallaa eegumsaa irra nan tura;",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.1",
            "verseOrgIds": [
              "HAB.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 2:1"
      },
      "items": [
        {
          "text": "mee waan inni naan jedhu arguuf",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.1",
            "verseOrgIds": [
              "HAB.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:1"
      },
      "items": [
        {
          "text": "deebii ani guungummii kanaaf kennuu malu beekuuf nan ilaala.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.1",
            "verseOrgIds": [
              "HAB.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Deebii",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
