  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "31",
        "style": "c",
        "sid": "PRO 31"
      },
      "items": [
        {
          "text": "31",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "ms1"
      },
      "items": [
        {
          "text": "Jecha Limuuʼel Mootichaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 31:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jecha Lemuuʼeel mootichaa kan haati isaa isa barsiifte:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.1",
            "verseOrgIds": [
              "PRO.31.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 31:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Maali yaa ilma ko, maali yaa ilma gadameessa ko,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.2",
            "verseOrgIds": [
              "PRO.31.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 31:2"
      },
      "items": [
        {
          "text": "maali yaa ilma wareega ko,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.2",
            "verseOrgIds": [
              "PRO.31.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 31:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "humna kee dubartoota irratti,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.3",
            "verseOrgIds": [
              "PRO.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 31:3"
      },
      "items": [
        {
          "text": "jabina kee warra mootota balleessan irratti hin fixin.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.3",
            "verseOrgIds": [
              "PRO.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 31:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Yaa Lemuuʼeel, wanni kun moototaaf hin malu;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.4",
            "verseOrgIds": [
              "PRO.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 31:4"
      },
      "items": [
        {
          "text": "daadhii wayinii dhuguun moototaaf hin malu;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.4",
            "verseOrgIds": [
              "PRO.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 31:4"
      },
      "items": [
        {
          "text": "dhugaatii cimaatti gaggabuunis bulchitootaaf hin malu;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.4",
            "verseOrgIds": [
              "PRO.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 31:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "kunis akka isaan dhuganii waan seerri jedhu dagatanii",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.5",
            "verseOrgIds": [
              "PRO.31.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 31:5"
      },
      "items": [
        {
          "text": "warra hacuucaman hunda mirga isaanii hin dhowwanneef.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.5",
            "verseOrgIds": [
              "PRO.31.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 31:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Warra baduuf jiraniif dhugaatii cimaa,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.6",
            "verseOrgIds": [
              "PRO.31.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 31:6"
      },
      "items": [
        {
          "text": "warra jireenyi itti hadhaaʼeef daadhii wayinii kenni;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.6",
            "verseOrgIds": [
              "PRO.31.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 31:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "isaan dhuganii hiyyummaa isaanii haa irraanfatan;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.7",
            "verseOrgIds": [
              "PRO.31.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 31:7"
      },
      "items": [
        {
          "text": "rakkina isaaniis deebiʼanii hin yaadatin.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.7",
            "verseOrgIds": [
              "PRO.31.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 31:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Warra ofii isaaniitiif dubbachuu hin dandeenyeef,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.8",
            "verseOrgIds": [
              "PRO.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 31:8"
      },
      "items": [
        {
          "text": "mirga warra gatamaniitiifis falmi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.8",
            "verseOrgIds": [
              "PRO.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 31:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Afaan kee banadhu; murtii qajeelaas kenni;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.9",
            "verseOrgIds": [
              "PRO.31.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 31:9"
      },
      "items": [
        {
          "text": "mirga hiyyeeyyiitii fi rakkattootaatiif falmi.\"",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.9",
            "verseOrgIds": [
              "PRO.31.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "ms1"
      },
      "items": [
        {
          "text": "Xumura: Niitii Amala Gaarii Qabdu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 31:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niitii amala gaarii qabdu eenyutu argachuu dandaʼa?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.10",
            "verseOrgIds": [
              "PRO.31.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 31:10"
      },
      "items": [
        {
          "text": "Isheen lula diimaa caalaa gati qabeettii dha.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.10",
            "verseOrgIds": [
              "PRO.31.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 31:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhirsi ishee guddisee ishee amanata;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.11",
            "verseOrgIds": [
              "PRO.31.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 31:11"
      },
      "items": [
        {
          "text": "inni waan faayidaa qabu tokko illee hin dhabu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.11",
            "verseOrgIds": [
              "PRO.31.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 31:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isheen bara jireenya ishee guutuu",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.12",
            "verseOrgIds": [
              "PRO.31.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 31:12"
      },
      "items": [
        {
          "text": "waan gaarii isaaf fiddi malee isa hin miitu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.12",
            "verseOrgIds": [
              "PRO.31.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 31:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isheen suufii fi quncee talbaa barbaaddee",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.13",
            "verseOrgIds": [
              "PRO.31.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 31:13"
      },
      "items": [
        {
          "text": "harka ishee kan hojii jaallatuun footi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.13",
            "verseOrgIds": [
              "PRO.31.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 31:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isheen akkuma doonii daldalaatti",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.14",
            "verseOrgIds": [
              "PRO.31.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 31:14"
      },
      "items": [
        {
          "text": "lafa fagoodhaa nyaata ishee fidatti.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.14",
            "verseOrgIds": [
              "PRO.31.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 31:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isheen utuu lafti hin bariʼin hirribaa kaatee",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.15",
            "verseOrgIds": [
              "PRO.31.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 31:15"
      },
      "items": [
        {
          "text": "maatii isheetiif nyaata kenniti;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.15",
            "verseOrgIds": [
              "PRO.31.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 31:15"
      },
      "items": [
        {
          "text": "xomboreewwan isheefis hojii qooddi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.15",
            "verseOrgIds": [
              "PRO.31.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 31:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isheen lafa qotiisaa hubattee ilaaltee bitti;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.16",
            "verseOrgIds": [
              "PRO.31.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 31:16"
      },
      "items": [
        {
          "text": "waan hojjettee argattu keessaa wayinii dhaabdi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.16",
            "verseOrgIds": [
              "PRO.31.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 31:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isheen jabinaan mudhii ishee hidhattee",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.17",
            "verseOrgIds": [
              "PRO.31.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 31:17"
      },
      "items": [
        {
          "text": "hojiidhaaf irree ishee jabeeffatti.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.17",
            "verseOrgIds": [
              "PRO.31.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PRO 31:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isheen akka daldalli ishee buʼaa qabu hubatti;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.18",
            "verseOrgIds": [
              "PRO.31.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 31:18"
      },
      "items": [
        {
          "text": "ibsaan ishees halkaniin hin dhaamu.",
