            "sid": "HOS 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "HOS.3.1",
                "verseOrgIds": [
                  "HOS.3.1"
                ]
              }
            }
          ]
        },
        {
          "text": "akkana naan jedhe; \"Namni biraa ishee jaallatee isheen sagaagaltuu taatu iyyuu, ati dhaqiitii ammas niitii keetti jaalala kee argisiisi. Akkuma",
          "type": "text",
          "attrs": {
            "verseId": "HOS.3.1",
            "verseOrgIds": [
              "HOS.3.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyoo",
              "type": "text",
              "attrs": {
                "verseId": "HOS.3.1",
                "verseOrgIds": [
                  "HOS.3.1"
                ]
              }
            }
          ]
        },
        {
          "text": "utuma isaan waaqota biraatti deebiʼanii bixxillee wayinii jaallatanuu Israaʼeloota jaallate sana atis ishee jaalladhu.\"",
          "type": "text",
          "attrs": {
            "verseId": "HOS.3.1",
            "verseOrgIds": [
              "HOS.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HOS 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanaafuu ani meetii saqilii kudha shaniin, garbuu hoomeerii tokkoo fi walakkaatiin ishee nan bitadhe.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.3.2",
            "verseOrgIds": [
              "HOS.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HOS 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani ergasii akkana nan jedheen; \"Ati bara hedduu na wajjin jiraachuu qabda; ati sagaagaltuu taʼuu yookaan nama kam iyyuu wajjin tokko taʼuu hin qabdu; ani si wajjin nan jiraadha.\"",
          "type": "text",
          "attrs": {
            "verseId": "HOS.3.3",
            "verseOrgIds": [
              "HOS.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HOS 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Israaʼeloonni mootii yookaan ilma mootii malee, aarsaa yookaan utubaa waaqeffannaa malee dirata yookaan waaqota tolfamoo malee bara baayʼee ni jiraatuutii.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.3.4",
            "verseOrgIds": [
              "HOS.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HOS 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasii immoo Israaʼeloonni deebiʼanii",
          "type": "text",
          "attrs": {
            "verseId": "HOS.3.5",
            "verseOrgIds": [
              "HOS.3.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyo",
              "type": "text",
              "attrs": {
                "verseId": "HOS.3.5",
                "verseOrgIds": [
                  "HOS.3.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Waaqa isaaniitii fi Daawit mootii isaanii barbaadu. Isaan bara dhumaa keessa hollachaa gara",
          "type": "text",
          "attrs": {
            "verseId": "HOS.3.5",
            "verseOrgIds": [
              "HOS.3.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Waaqayyootii",
              "type": "text",
              "attrs": {
                "verseId": "HOS.3.5",
                "verseOrgIds": [
                  "HOS.3.5"
                ]
              }
            }
          ]
        },
        {
          "text": "fi gara eebba isaa ni dhufu.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.3.5",
            "verseOrgIds": [
              "HOS.3.5"
            ]
          }
        }
      ]
    }
  ],
