  "verseCount": 52,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "LUK 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Dhalachuu Yesuus",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bara sana keessa akka addunyaan Roomaa hundi galmeeffamuuf Awugisxoos Qeesaar biraa labsiin baʼe.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.1",
            "verseOrgIds": [
              "LUK.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakkoobsi sabaa kunis bara Qereenewoos bulchaa biyya Sooriyaa turetti yeroo jalqabaatiif taasifame.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.2",
            "verseOrgIds": [
              "LUK.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namni hundinuu galmeeffamuuf gara magaalaa itti dhalatee dhaqe.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.3",
            "verseOrgIds": [
              "LUK.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoosefis manaa fi sanyii Daawit keessaa waan dhalateef magaalaa Naazreeti ishee Galiilaa keessaatii kaʼee gara magaalaa Daawit ishee Yihuudaa keessaa kan Beetlihem jedhamtuutti ol baʼe.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.4",
            "verseOrgIds": [
              "LUK.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis kaadhima isaa Maariyaam ishee ulfa turte sana wajjin galmeeffamuu dhaqe.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.5",
            "verseOrgIds": [
              "LUK.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utuma isaan achi jiranuus yeroon daʼumsa ishee gaʼe.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.6",
            "verseOrgIds": [
              "LUK.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isheenis ilma ishee isa hangafa deesse. Waan mana bultii keessummootaa keessa iddoon hin jiraatiniif huccuudhaan martee bidiruu keessa isa ciibsite.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.7",
            "verseOrgIds": [
              "LUK.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Tiksootaa fi Ergamoota Waaqaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiksoota halkan halkan ala bulanii bushaayee isaanii tikfatanitu biyya sana ture.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.8",
            "verseOrgIds": [
              "LUK.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergamaan Gooftaa isaanitti mulʼate; ulfinni Gooftaas naannoo isaaniitti ibse; isaanis akka malee sodaatan.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.9",
            "verseOrgIds": [
              "LUK.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergamaan sun garuu akkana isaaniin jedhe; \"Hin sodaatinaa. Kunoo, ani oduu gaarii baayʼee nama gammachiisu kan saba hundumaaf taʼu isinii fideeraatii.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.10",
            "verseOrgIds": [
              "LUK.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Harʼa magaalaa Daawit keessatti fayyisaan isiniif dhalateera; innis Kiristoos Goofticha.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.11",
            "verseOrgIds": [
              "LUK.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunis mallattoo isiniif taʼa: Daaʼima huccuudhaan maramee bidiruu keessa ciisu tokko ni argitu.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.12",
            "verseOrgIds": [
              "LUK.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergamaa sana wajjinis raayyaan samii irraa baayʼeen akkuma tasaa mulʼatanii Waaqa galateeffachaa akkana jedhan;",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.13",
            "verseOrgIds": [
              "LUK.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Samii gubbaatti ulfinni Waaqaaf,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.14",
            "verseOrgIds": [
              "LUK.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LUK 2:14"
      },
      "items": [
        {
          "text": "lafa irrattis nagaan namoota inni itti gammaduuf haa taʼu.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.14",
            "verseOrgIds": [
              "LUK.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erga Ergamoonni tiksoota dhiisanii gara samiitti ol baʼanii booddee tiksoonni sun, \"Kottaa Beetlihemin dhaqnee waan taʼe kan Gooftaan nutti hime kana ilaalaa\" waliin jedhan.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.15",
            "verseOrgIds": [
              "LUK.2.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis dafanii dhaqanii Maariyaamii fi Yoosefin, daaʼima bidiruu keessa ciisus argan.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.16",
            "verseOrgIds": [
              "LUK.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yommuu isa arganitti waan waaʼee mucichaa isaanitti himame sana odeessan;",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.17",
            "verseOrgIds": [
              "LUK.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "warri waan kana dhagaʼan hundinuu waan tiksoonni isaanitti himan sana ni dinqifatan.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.18",
            "verseOrgIds": [
              "LUK.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maariyaam garuu waan kana hunda garaatti qabattee itti yaadaa turte.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.19",
            "verseOrgIds": [
              "LUK.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiksoonnis sababii waan dhagaʼanii fi arganiitiif Waaqaaf ulfina kennaa, isa jajachaas deebiʼan; wanni hundinuu akkuma isaanitti himame sana tureetii.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.20",
            "verseOrgIds": [
              "LUK.2.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesuus Mana Qulqullummaatti Dhiʼeeffame",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis guyyaa saddeettaffaatti, akkuma yeroon dhagna qabaa isaa gaʼeen maqaa utuu haati isaa iyyuu isa hin ulfaaʼiniin dura ergamaan Waaqaa isaaf baaseen Yesuus jedhamee moggaafame.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.21",
            "verseOrgIds": [
              "LUK.2.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akka Seera Museetti yeroon qulqullaaʼummaa isaanii geenyaan Yoosefii fi Maariyaam daaʼima sana Gooftaa duratti dhiʼeessuuf jedhanii isa fudhatanii Yerusaalemitti ol baʼan.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.22",
            "verseOrgIds": [
              "LUK.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akkuma Seera Gooftaa keessatti barreeffametti, \"Dhiirri hangafni hundinuu gooftaaf ni qulqulleeffama.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.23",
            "verseOrgIds": [
              "LUK.2.23"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.23",
            "verseOrgIds": [
              "LUK.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis akkuma Seerri Gooftaa jedhutti, \"Gugee lama yookaan gugee sosookkee lama\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.24",
            "verseOrgIds": [
              "LUK.2.24"
            ]
          }
        },
        {
          "text": "aarsaa dhiʼeessuu dhaqan.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.24",
            "verseOrgIds": [
              "LUK.2.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunoo, namichi qajeelaan Waaqa sodaatu kan maqaan isaa Simiʼoon jedhamu tokko Yerusaalem keessa ture. Innis jajjabeeffama Israaʼel eeggachaa ture; Hafuurri Qulqulluunis isa irra ture.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.25",
            "verseOrgIds": [
              "LUK.2.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hafuurri Qulqulluunis akka inni utuu Kiristoos Goofticha hin argin hin duune isatti mulʼisee ture.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.26",
            "verseOrgIds": [
              "LUK.2.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis Hafuuraan qajeelfamee mana qulqullummaa seene. Abbaa fi haati Yesuus yommuu akka duudhaa seerichaatti waan barbaachisu isaaf guutuuf jedhanii Yesuus mucicha baadhatanii ol seenanitti,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.27",
            "verseOrgIds": [
              "LUK.2.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simiʼoon fuudhee isa hammatee akkana jedhee Waaqa galateeffate:",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.28",
            "verseOrgIds": [
              "LUK.2.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 2:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Yaa Gooftaa, akkuma dubbii keetiitti,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.29",
            "verseOrgIds": [
              "LUK.2.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LUK 2:29"
      },
      "items": [
        {
          "text": "ati garbicha kee amma nagaan geggeessis.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.29",
            "verseOrgIds": [
              "LUK.2.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 2:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iji koo fayyina kee isa ati",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.30",
            "verseOrgIds": [
              "LUK.2.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 2:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "saba hundumaa duratti qopheessite argeera;",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.31",
            "verseOrgIds": [
              "LUK.2.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 2:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "innis mulʼata Namoota Ormaatiif ifa;",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.32",
            "verseOrgIds": [
              "LUK.2.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "LUK 2:32"
      },
      "items": [
        {
          "text": "saba kee Israaʼeliif immoo ulfina.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.32",
            "verseOrgIds": [
              "LUK.2.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 2:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abbaa fi haati isaas waan waaʼee isaa dubbatame sana ni dinqifatan.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.33",
            "verseOrgIds": [
              "LUK.2.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 2:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simiʼoonis isaan eebbise; haadha daaʼima sanaa Maariyaamiinis akkana jedhe; \"Daaʼimni kun Israaʼel keessatti kufaatiidhaa fi kaʼumsa namoota baayʼeetiif sababii, mormii isa irratti dubbatamuufis mallattoo akka taʼu murteeffameera;",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.34",
            "verseOrgIds": [
              "LUK.2.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 2:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "kunis akka yaadni garaa namoota baayʼee ifatti baʼuuf. Goraadeen lubbuu kee ni waraana.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.35",
            "verseOrgIds": [
              "LUK.2.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 2:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gosa Aasheer keessaas raajittii Haannaa jedhamtu tokkotu ture. Isheenis intala Faanuʼel turte; baayʼees jaartee turte; dhirsa ishee kan durbummaadhaan itti heerumte wajjin waggaa torba jiraatte;",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.36",
            "verseOrgIds": [
              "LUK.2.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LUK 2:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "isheenis hamma umuriin ishee waggaa 84 guuteetti haadha hiyyeessaa taatee jiraatte. Utuu mana qulqullummaatii hin dhabaminis soomaa fi kadhannaadhaan halkanii guyyaa waaqeffachaa turte.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.37",
            "verseOrgIds": [
              "LUK.2.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 2:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeruma sanas isaanitti dhiʼaattee Waaqaaf galata galchite; warra furama Yerusaalem eeggachaa turan hundattis waaʼee daaʼima sanaa odeessite.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.38",
            "verseOrgIds": [
              "LUK.2.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LUK 2:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoosefii fi Maariyaamis waan seerri Gooftaa ajaju hunda raawwatanii gara Galiilaatti gara magaalaa isaanii Naazreetitti deebiʼan.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.39",
            "verseOrgIds": [
              "LUK.2.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LUK 2:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mucichis guddatee jabaachaa deeme; ogummaadhaanis ni guutame; ayyaanni Waaqaas isa irra ture.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.40",
            "verseOrgIds": [
              "LUK.2.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesuus Mucichi Mana Qulqullummaa Keessatti",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LUK 2:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abbaa fi haati isaa wagguma waggaan Ayyaana Faasiikaatiif jedhanii Yerusaalem dhaqaa turan.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.41",
            "verseOrgIds": [
              "LUK.2.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LUK 2:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yommuu umuriin mucaa sanaa waggaa kudha lama",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.42",
            "verseOrgIds": [
              "LUK.2.42"
            ]
          }
        },
        {
          "text": "guutettis akkuma sirna Ayyaanichaatti Yerusaalemitti ol baʼan.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.42",
            "verseOrgIds": [
              "LUK.2.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LUK 2:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erga ayyaanichi raawwatee booddee utuu abbaa fi haati isaa gara mana isaaniitti deebiʼaa jiranuu, Yesuus mucichi Yerusaalemitti isaan biraa hafe; isaan garuu waan kana hin hubanne.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.43",
            "verseOrgIds": [
              "LUK.2.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LUK 2:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaanis waan inni miiltoo isaanii wajjin jiru seʼanii guyyaa tokko deeman. Ergasiis firoota isaaniitii fi michoota isaanii keessa isa barbaaduu jalqaban.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.44",
            "verseOrgIds": [
              "LUK.2.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LUK 2:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yommuu isa dhabanittis, isa barbaaduuf Yerusaalemitti deebiʼan.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.45",
            "verseOrgIds": [
              "LUK.2.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LUK 2:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyyaa sadii booddee utuu inni barsiistota gidduu taaʼee isaan dhaggeeffatuu, gaaffiis isaan gaafatuu mana qulqullummaa keessatti isa argatan.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.46",
            "verseOrgIds": [
              "LUK.2.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "LUK 2:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Warri isa dhagaʼan hundinuus hubannaa isaatii fi deebii inni kennu ni dinqifatan.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.47",
            "verseOrgIds": [
              "LUK.2.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "LUK 2:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abbaa fi haati isaas yommuu isa arganitti ni raajeffatan. Haati isaas, \"Gurbaa, maaliif akkana nu goote? Kunoo, anii fi abbaan kee yaaddoo guddaadhaan si barbaadaa turree!\" jetteen.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.48",
            "verseOrgIds": [
              "LUK.2.48"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "LUK 2:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis deebisee,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.49",
            "verseOrgIds": [
              "LUK.2.49"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Maaliif na barbaaddan? Akka ani mana Abbaa kootti argamuu qabu hin beekne moo?\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.2.49",
                "verseOrgIds": [
                  "LUK.2.49"
                ]
              }
            }
          ]
        },
        {
          "text": "isaaniin jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.49",
            "verseOrgIds": [
              "LUK.2.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "LUK 2:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaan garuu dubbii inni isaanitti dubbate hin hubanne.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.50",
            "verseOrgIds": [
              "LUK.2.50"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "LUK 2:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis isaan wajjin Naazreetitti gad buʼe; isaaniifis ni ajajama ture. Haati isaa garuu waan kana hunda garaatti qabatte.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.51",
            "verseOrgIds": [
              "LUK.2.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "LUK 2:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuusis ogummaadhaan, hojjaa fi surraadhaan fuula Waaqaatii fi fuula namaa duratti guddachaa deeme.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.52",
            "verseOrgIds": [
              "LUK.2.52"
            ]
          }
        }
      ]
    }
  ],
