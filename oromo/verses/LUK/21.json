      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Isin yommuu Yerusaalem loltootaan marfamtee argitanitti akka badiin ishee dhiʼaate beekaa.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.20",
                "verseOrgIds": [
                  "LUK.21.20"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.20",
            "verseOrgIds": [
              "LUK.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Yommus warri Yihuudaa keessa jiran gaarranitti haa baqatan; warri magaalaa keessa jiranis achii haa baʼan; warri baadiyyaa jiran immoo magaalaa hin seenin.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.21",
                "verseOrgIds": [
                  "LUK.21.21"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.21",
            "verseOrgIds": [
              "LUK.21.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Akka wanni barreeffame hundinuu raawwatamuuf yeroon kun yeroo haaloo baasuutii.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.22",
                "verseOrgIds": [
                  "LUK.21.22"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.22",
            "verseOrgIds": [
              "LUK.21.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Bara sana keessa dubartoota ulfaatii fi haadhota hoosisaniif wayyoo! Lafa irratti dhiphinni guddaan, saba kanatti immoo dheekkamsi ni dhufaatii.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.23",
                "verseOrgIds": [
                  "LUK.21.23"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.23",
            "verseOrgIds": [
              "LUK.21.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Isaanis goraadeedhaan ajjeefamu; boojiʼamaniis biyyoota ormaa hundatti ni geeffamu; hamma barri Namoota Ormaa dhumutti Yerusaalem Namoota Ormaatiin dhidhiitamti.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.24",
                "verseOrgIds": [
                  "LUK.21.24"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 21:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Aduu irratti, jiʼa irratti, urjiiwwan irrattis mallattoon ni taʼa. Lafa irrattis sababii huursaatii fi dhaʼaa galaanaatiif saboonni ni muddamu; waan taʼanis ni wallaalu.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.25",
                "verseOrgIds": [
                  "LUK.21.25"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.25",
            "verseOrgIds": [
              "LUK.21.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Namoonnis sababii humnoonni samii irraa raafamaniif, waan addunyaa kanatti dhufuuf jiru yaaddaʼanii sodaadhaan ni gaggabu.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.26",
                "verseOrgIds": [
                  "LUK.21.26"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.26",
            "verseOrgIds": [
              "LUK.21.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 21:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Isaanis yeroo sana utuu Ilmi Namaa humnaa fi ulfina guddaadhaan duumessaan dhufuu ni argu.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.27",
                "verseOrgIds": [
                  "LUK.21.27"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.27",
            "verseOrgIds": [
              "LUK.21.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 21:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Yommuu wanni kun taʼuu jalqabutti mataa keessan ol qabadhaa; olis ilaalaa; furamuun keessan dhiʼaateeraatii.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.28",
                "verseOrgIds": [
                  "LUK.21.28"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 21:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis akkana jedhee fakkeenya kana isaanitti hime;",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.29",
            "verseOrgIds": [
              "LUK.21.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mee muka harbuutii fi muka hunda ilaalaa.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.29",
                "verseOrgIds": [
                  "LUK.21.29"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.29",
            "verseOrgIds": [
              "LUK.21.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 21:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Yommuu isaan baala baafatanitti isin mataan keessan iyyuu ilaaltanii akka bonni dhiʼaate beekuu dandeessu.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.30",
                "verseOrgIds": [
                  "LUK.21.30"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.30",
            "verseOrgIds": [
              "LUK.21.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 21:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Akkasuma isinis yommuu wanni kun raawwatamuu isaa argitanitti akka mootummaan Waaqaa dhiʼaate ni beektu.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.31",
                "verseOrgIds": [
                  "LUK.21.31"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 21:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ani dhuguma isinittin hima; hamma wanni kun hundi taʼutti dhaloonni kun hin darbu.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.32",
                "verseOrgIds": [
                  "LUK.21.32"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.32",
            "verseOrgIds": [
              "LUK.21.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 21:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Samii fi lafti ni darbu; dubbiin koo garuu gonkumaa hin darbu.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.33",
                "verseOrgIds": [
                  "LUK.21.33"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 21:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Isin of eeggadhaa; yoo kanaa achii qalbiin keessan qananiidhaan, machii fi yaaddoo jireenyaatiin fudhatamee guyyaan sunis utuu isin hin beekin akkuma kiyyoo isin qabata.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.34",
                "verseOrgIds": [
                  "LUK.21.34"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.34",
            "verseOrgIds": [
              "LUK.21.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 21:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Guyyaan sun warra lafa irra jiraatan hundatti ni dhufaatii.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.35",
                "verseOrgIds": [
                  "LUK.21.35"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.35",
            "verseOrgIds": [
              "LUK.21.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 21:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kanaafuu akka waan dhufuuf jiru hunda jalaa baataniif, akka fuula Ilma Namaa duras dhaabachuu dandeessaniif yeroo hunda dammaqaa; kadhadhaas.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.36",
                "verseOrgIds": [
                  "LUK.21.36"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LUK 21:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuus guyyuma guyyaan mana qulqullummaa keessatti barsiisaa ture; halkan halkan immoo tulluu Gaara Ejersaa jedhamu irra bula ture.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.37",
            "verseOrgIds": [
              "LUK.21.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 21:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namoonni hundinuus isa dhaggeeffachuuf jedhanii barii barraaqaan mana qulqullummaa dhufu turan.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.38",
            "verseOrgIds": [
              "LUK.21.38"
            ]
          }
        }
      ]
    }
  ],
