                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuusis akkana jedhee gaafate;",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.18",
            "verseOrgIds": [
              "LUK.13.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mootummaan Waaqaa maal fakkaata? Anis maaliinan wal isa fakkeessa?",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.18",
                "verseOrgIds": [
                  "LUK.13.18"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.18",
            "verseOrgIds": [
              "LUK.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mootummaan Waaqaa sanyii sanaaficaa kan namni tokko fuudhee lafa qotiisaa isaa keessatti facaase fakkaata. Sanyiin sunis guddatee muka taʼe; simbirroonnis dameewwan isaa irra jiraatan.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.19",
                "verseOrgIds": [
                  "LUK.13.19"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amma illee akkana jedhee gaafate;",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.20",
            "verseOrgIds": [
              "LUK.13.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ani mootummaa Waaqaa maaliinan wal fakkeessa?",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.20",
                "verseOrgIds": [
                  "LUK.13.20"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.20",
            "verseOrgIds": [
              "LUK.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Inni raacitii dubartiin tokko fuutee hamma inni guutummaatti bukeessutti daakuu safartuu sadiitti makte fakkaata.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.21",
                "verseOrgIds": [
                  "LUK.13.21"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Balbala Dhiphaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuusis utuu gara Yerusaalem deemuu namoota barsiisaa magaalaawwanii fi gandoota keessa darbaa ture.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.22",
            "verseOrgIds": [
              "LUK.13.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namichi tokkos, \"Yaa Gooftaa warri fayyifaman namoota muraasa qofaa?\" jedhee isa gaafate.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.23",
            "verseOrgIds": [
              "LUK.13.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LUK 13:23"
      },
      "items": [
        {
          "text": "Innis akkana isaaniin jedhe;",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.23",
            "verseOrgIds": [
              "LUK.13.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 13:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Balbala dhiphaadhaan seenuuf tattaaffadhaa; ani isinittin hima; namoonni baayʼeen seenuu ni yaaluutii; garuu hin dandaʼan.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.24",
                "verseOrgIds": [
                  "LUK.13.24"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.24",
            "verseOrgIds": [
              "LUK.13.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Abbaan mana sanaa takkaa kaʼee balbalicha cufannaan isin ala dhaabatanii balbala rurrukutaa, 'Yaa Gooftaa balbala nuu bani' jettanii kadhattu.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.25",
                "verseOrgIds": [
                  "LUK.13.25"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LUK 13:25"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Inni garuu deebisee, 'Ani isin hin beeku yookaan eessaa akka dhuftan hin beeku' isiniin jedha.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.25",
                "verseOrgIds": [
                  "LUK.13.25"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 13:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Isin immoo, 'Nu si wajjin nyaannee dhugneerra; atis daandii keenya irratti barsiifteerta' jettuun.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.26",
                "verseOrgIds": [
                  "LUK.13.26"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 13:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Inni garuu deebisee, 'Ani isin hin beeku yookaan eessaa akka dhuftan hin beeku. Isin warri hammina hojjettan hundinuu na biraa badaa!' jedha.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.27",
                "verseOrgIds": [
                  "LUK.13.27"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 13:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Yommuu Abrahaam, Yisihaaq, Yaaqoobii fi raajota hunda mootummaa Waaqaa keessatti argitanii, ofii keessanii immoo gad darbatamtan, achitti booʼuu fi ilkaan qaruutu taʼa.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.28",
                "verseOrgIds": [
                  "LUK.13.28"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.28",
            "verseOrgIds": [
              "LUK.13.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 13:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Namoonnis baʼa biiftuutii fi lixa biiftuutii, kaabaa fi kibbaa dhufanii mootummaa Waaqaa keessatti maaddiitti ni dhiʼaatu.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.29",
                "verseOrgIds": [
                  "LUK.13.29"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.29",
            "verseOrgIds": [
              "LUK.13.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Dhugumaanuu kanneen warra dhumaa taʼan keessaa kanneen warra jalqabaa, kanneen warra jalqabaa taʼan keessaa immoo warra dhumaa taʼan jiru.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.30",
                "verseOrgIds": [
                  "LUK.13.30"
                ]
              }
            }
          ]
        }
      ]
    },
