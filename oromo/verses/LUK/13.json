    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Qalbii Jijjiirrachuu Yookaan Baduu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo sana namoonni waaʼee warra Galiilaa kanneen Phiilaaxoos dhiiga isaanii aarsaa isaaniitti make sanaa Yesuusitti himan tokko tokko achi turan.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.1",
            "verseOrgIds": [
              "LUK.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuusis deebisee akkana jedheen;",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.2",
            "verseOrgIds": [
              "LUK.13.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Sababiin namoonni Galiilaa kunneen akkas dhiphataniif waan isaan saba Galiilaa kaan hunda irra cubbamoota turaniif seetuu?",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.2",
                "verseOrgIds": [
                  "LUK.13.2"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.2",
            "verseOrgIds": [
              "LUK.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ani isinittin hima; akkas miti; garuu isinis qalbii jijjiirrachuu baannaan hundi keessan akkasuma baddu.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.3",
                "verseOrgIds": [
                  "LUK.13.3"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.3",
            "verseOrgIds": [
              "LUK.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Yookaan namoonni kudha saddeettan gamoon Saliihoom isaan irratti jigee isaan fixe sun warra Yerusaalem keessa jiraatan kaan hunda irra waan yakka hojjetan seetuu?",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.4",
                "verseOrgIds": [
                  "LUK.13.4"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.4",
            "verseOrgIds": [
              "LUK.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ani isinittin hima; akkas miti. Garuu isinis qalbii jijjiirrachuu baannaan, hundi keessan akkasuma baddu.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.5",
                "verseOrgIds": [
                  "LUK.13.5"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis akkana jedhee fakkeenya kana dubbate;",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.6",
            "verseOrgIds": [
              "LUK.13.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Namichi tokko muka harbuu kan iddoo dhaabaa wayinii isaa keessa dhaabame tokko qaba ture; innis muka sana irra ija barbaaduu dhaqee waan tokko illee dhabe.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.6",
                "verseOrgIds": [
                  "LUK.13.6"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.6",
            "verseOrgIds": [
              "LUK.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Innis hojjetaa iddoo dhaaba wayinichaatiin, 'Ani waggaa sadan darban kana muka harbuu kana irraa ija barbaadachuuf jedhee marmaaraan ture; garuu waan tokko illee irraa hin arganne; muriitii gati! Inni maaliif lafa balleessa?' jedhe.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.7",
                "verseOrgIds": [
                  "LUK.13.7"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Namichi sunis deebisee akkana jedheen; 'Yaa Gooftaa, anuu naannoo isaa qoteen xaaʼoo itti naqaatii mee wagguma tokko haa turu.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.8",
                "verseOrgIds": [
                  "LUK.13.8"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.8",
            "verseOrgIds": [
              "LUK.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Yoo inni waggaa dhufu ija naqate, gaarii dha! Yoo kanaa achii murtee gatuu dandeessa.' \"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.9",
                "verseOrgIds": [
                  "LUK.13.9"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Dubartiin Dugdi Ishee Goophate Tokko Fayyifamuu Ishee",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuus guyyaa Sanbataa tokko manneen sagadaa keessaa isa tokkotti barsiisaa ture.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.10",
            "verseOrgIds": [
              "LUK.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dubartiin hafuurri hamaan waggaa kudha saddeeti dugda ishee goophesse tokkos achi turte; isheenis waan gad gogdeef gonkumaa ol jechuu hin dandeessu turte.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.11",
            "verseOrgIds": [
              "LUK.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuusis yommuu ishee argetti ofitti ishee waamee,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.12",
            "verseOrgIds": [
              "LUK.13.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Dubartii nana, ati dhukkuba kee irraa fayyiteerta\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.12",
                "verseOrgIds": [
                  "LUK.13.12"
                ]
              }
            }
          ]
        },
        {
          "text": "jedheen,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.12",
            "verseOrgIds": [
              "LUK.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis harka isaa ishee irra kaaʼe; isheenis yeruma sana ol jettee Waaqa galateeffatte.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.13",
            "verseOrgIds": [
              "LUK.13.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bulchaan mana sagadaas sababii Yesuus guyyaa Sanbataatiin nama fayyiseef aaree namootaan, \"Guyyaan hojii jaʼatu jira; guyyoota sana kottaatii fayyifamaa malee guyyaa Sanbataa hin dhufinaa\" jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.14",
            "verseOrgIds": [
              "LUK.13.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gooftaan immoo akkana jedhee deebiseef;",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.15",
            "verseOrgIds": [
              "LUK.13.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Yaa fakkeessitoota! Isin keessaa namni guyyaa Sanbataa qotiyyoo isaa yookaan harree isaa dallaa keessaa hiikee bishaan obaasuu hin geessine jiraa?",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.15",
                "verseOrgIds": [
                  "LUK.13.15"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.15",
            "verseOrgIds": [
              "LUK.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Yoos dubartiin kun intalli Abrahaam kan Seexanni waggaa kudha saddeeti guutuu hidhee ture kun guyyaa Sanbataatiin hidhaa kana irraa hiikamuun isheef hin maluu?\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.16",
                "verseOrgIds": [
                  "LUK.13.16"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yommuu inni waan kana dubbatetti mormitoonni isaa hundi ni qaanaʼan; namoonni garuu hojjiiwwan dinqii kanneen inni hojjechaa ture hundatti ni gammadan.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.17",
            "verseOrgIds": [
              "LUK.13.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Fakkeenya Sanyii Sanaaficaatii fi Fakkeenya Raacitii",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
