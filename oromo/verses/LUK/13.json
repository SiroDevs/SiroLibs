    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroo sana Fariisota keessaa namoonni tokko tokko gara Yesuus dhufanii, \"Sababii Heroodis si ajjeesuu barbaaduuf asii deemii iddoo biraa dhaqi\" jedhaniin.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.31",
            "verseOrgIds": [
              "LUK.13.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 13:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis akkana jedhee deebise;",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.32",
            "verseOrgIds": [
              "LUK.13.32"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Dhaqaatii waangoo sanaan, 'Kunoo, ani harʼaa fi bori hafuurota hamoo nan baasa; namoota dhukkubsatanis nan fayyisa; guyyaa sadaffaatti immoo hojii koo nan fixadha' jedhaa.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.32",
                "verseOrgIds": [
                  "LUK.13.32"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.32",
            "verseOrgIds": [
              "LUK.13.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 13:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Waan fedhe iyyuu taanaan, ani harʼaa fi bori, iftaanis adeemsa koo itti fufuutu naa mala; raajiin Yerusaalemiin alatti duʼuu hin qabuutii!",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.33",
                "verseOrgIds": [
                  "LUK.13.33"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 13:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Yaa Yerusaalem, yaa Yerusaalem, ati kan raajota ajjeeftu, warra gara keetti ergamanis kan dhagaadhaan tumtu, akkuma indaanqoon cuucii ishee qoochoo ishee jalatti walitti qabattu sana anis ijoollee kee walitti qabuuf yeroo meeqan hawwe! Isin garuu hin barbaanne.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.34",
                "verseOrgIds": [
                  "LUK.13.34"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.34",
            "verseOrgIds": [
              "LUK.13.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 13:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kunoo, manni keessan onee isinii hafa. Ani isinittin hima; isin hamma, 'Inni maqaa Gooftaatiin dhufu sun eebbifamaa dha'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.35",
                "verseOrgIds": [
                  "LUK.13.35"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.35",
            "verseOrgIds": [
              "LUK.13.35"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "jettanitti lammata na hin argitan.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.13.35",
                "verseOrgIds": [
                  "LUK.13.35"
                ]
              }
            }
          ]
        }
      ]
    }
