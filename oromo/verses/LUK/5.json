              "items": [
                {
                  "text": "Mar 2:3‑12",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaaf tokko Yesuus utuu barsiisaa jiruu, Fariisonnii fi barsiistonni seeraa warri gandoota Galiilaatii fi Yihuudaa hunda keessaa akkasumas Yerusaalemii dhufan achi tataaʼaa turan. Akka inni dhukkubsattoota fayyisuufis humni Gooftaa isa wajjin ture.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.17",
            "verseOrgIds": [
              "LUK.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jarri tokko nama dhagni irratti duʼe tokko sireedhaan baatanii dhufan; isaanis fuula Yesuus dura isa kaaʼuuf jedhanii manatti ol isa galchuu yaalan.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.18",
            "verseOrgIds": [
              "LUK.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sababii baayʼina namaatiifis karaa ittiin ol isa galchan dhabnaan bantii manaatti ol baʼanii qadaada bantii manaa saaqanii walakkaa namootaatiin fuula Yesuus duratti siree isaatiin gad isa buusan.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.19",
            "verseOrgIds": [
              "LUK.5.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuusis yommuu amantii isaanii argetti,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.20",
            "verseOrgIds": [
              "LUK.5.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Namichoo, cubbuun kee siif dhiifameera\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.5.20",
                "verseOrgIds": [
                  "LUK.5.20"
                ]
              }
            }
          ]
        },
        {
          "text": "jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.20",
            "verseOrgIds": [
              "LUK.5.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fariisonnii fi barsiistonni seeraas, \"Namichi Waaqa arrabsu kun eenyu? Waaqa tokkicha malee eenyutu cubbuu namaaf dhiisuu dandaʼa?\" jedhanii garaa isaaniitti yaaduu jalqaban.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.21",
            "verseOrgIds": [
              "LUK.5.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuusis waan isaan yaadaa turan beekee akkana jedhee gaafate;",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.22",
            "verseOrgIds": [
              "LUK.5.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Isin maaliif garaa keessan keessatti waan kana yaaddu?",
              "type": "text",
              "attrs": {
                "verseId": "LUK.5.22",
                "verseOrgIds": [
                  "LUK.5.22"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.22",
            "verseOrgIds": [
              "LUK.5.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "'Cubbuun kee siif dhiifameera' jechuu moo 'Kaʼii deemi' jechuutu salphaa dha?",
              "type": "text",
              "attrs": {
                "verseId": "LUK.5.23",
                "verseOrgIds": [
                  "LUK.5.23"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.23",
            "verseOrgIds": [
              "LUK.5.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ani garuu akka Ilmi Namaa cubbuu namaaf dhiisuudhaaf lafa irratti taayitaa qabu akka beektan nan barbaada.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.5.24",
                "verseOrgIds": [
                  "LUK.5.24"
                ]
              }
            }
          ]
        },
        {
          "text": "Kanaafuu inni namicha dhagni irratti duʼe sanaan,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.24",
            "verseOrgIds": [
              "LUK.5.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ani sitti nan hima; kaʼi; siree kee fudhadhuutii mana keetti gali\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.5.24",
                "verseOrgIds": [
                  "LUK.5.24"
                ]
              }
            }
          ]
        },
        {
          "text": "jedhe.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.24",
            "verseOrgIds": [
              "LUK.5.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Innis yeruma sana kaʼee fuula isaanii dura dhaabate; waan irra ciisaa tures fudhatee Waaqa jajachaa mana ofii isaatti qajeele.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.25",
            "verseOrgIds": [
              "LUK.5.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 5:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hundi isaaniis dinqifatanii Waaqa jajan. Sodaadhaanis guutamanii, \"Nu harʼa waan takkumaa hin taʼin argine\" jedhan.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.26",
            "verseOrgIds": [
              "LUK.5.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Waamamuu Lewwii",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
