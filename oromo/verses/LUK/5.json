    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 5:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ergasii Yesuus achii baʼee qaraxxuu Lewwii jedhamu tokko utuu inni iddoo itti qaraxa walitti qaban taaʼuu arge. Yesuusis,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.27",
            "verseOrgIds": [
              "LUK.5.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Na duukaa buʼi\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.5.27",
                "verseOrgIds": [
                  "LUK.5.27"
                ]
              }
            }
          ]
        },
        {
          "text": "jedheen.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.27",
            "verseOrgIds": [
              "LUK.5.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 5:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lewwiinis waan hunda dhiisee kaʼee isa duukaa buʼe.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.28",
            "verseOrgIds": [
              "LUK.5.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 5:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lewwiinis mana isaatti cidha guddaa Yesuusiif qopheesse; qaraxxoonnii fi namoonni kaan baayʼeenis isaan wajjin nyaachaa turan.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.29",
            "verseOrgIds": [
              "LUK.5.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 5:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fariisonnii fi Barsiistonni seeraa kanneen garee isaanii taʼan garuu, \"Isin maaliif qaraxxootaa fi cubbamoota wajjin nyaattanii dhugdu?\" jedhanii barattoota isaatti guunguman.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.30",
            "verseOrgIds": [
              "LUK.5.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 5:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesuus immoo deebisee akkana isaaniin jedhe;",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.31",
            "verseOrgIds": [
              "LUK.5.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ogeessi fayyaa tokko warra dhukkubsataniif malee warra fayyaa qabaniif hin barbaachisu.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.5.31",
                "verseOrgIds": [
                  "LUK.5.31"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.31",
            "verseOrgIds": [
              "LUK.5.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 5:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ani cubbamoota gara qalbii jijjiirrannaatti waamuufin dhufe malee qajeeltota waamuuf hin dhufne.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.5.32",
                "verseOrgIds": [
                  "LUK.5.32"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesuus Waaʼee Soomaa Gaafatamuu Isaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
