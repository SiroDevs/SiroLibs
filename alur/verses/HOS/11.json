            "number": "11",
            "style": "v",
            "sid": "HOS 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.11",
            "verseOrgIds": [
              "HOS.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HOS 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Efraim utieka ku lemndra, man ot mir Israel kud abombi; ento Yuda fodi ubimo karacelo ku Mungu, man ebedo mandha karacelo ku Ng’atu Maleng’.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.12",
            "verseOrgIds": [
              "HOS.11.12"
            ]
          }
        }
      ]
    }
