        },
        {
          "text": "Lembe pa Yehova m’ubino bang’ Hoseya ma wod Beri, i nindo pa Uzia, ku Yotham, kud Ahaz, man Hezekia, gi ju m’ubimo mi Yuda, man i nindo pa Yeroboam ma wod Yoac, m’ubimo mir Israel.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.1",
            "verseOrgIds": [
              "HOS.1.1"
            ]
          }
        }
      ]
