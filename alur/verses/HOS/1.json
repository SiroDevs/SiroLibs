          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.9.26"
              },
              "items": [
                {
                  "text": "Rum 9:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento wel mi nyithindho mir Israel bibedo calu kwio mi nam, ma pore ngo ma kwandre de ngo; man ebitimbre nia, i ka ma juwacu ie igi kumae, Wu dhanu para ngo, jubiwacu igi kumae, Wun wu wot Mungu ma kwo. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.10",
            "verseOrgIds": [
              "HOS.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HOS 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man nyithindho mi Yuda ku nyithindho mir Israel jubicokogi karacelo, e gibiketho igi wie acel, man gibiai kud i ng’om; kum ceng’ pa Yezrel bibedo dit.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.11",
            "verseOrgIds": [
              "HOS.1.11"
            ]
          }
        }
      ]
    }
