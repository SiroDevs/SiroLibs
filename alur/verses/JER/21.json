          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lembe m’uai ba Yehova ubino ba Yeremia, kinde m’ubimo ma Zedekia oro Pacur ma wod Malkija, ku Zefania ma wod Maseya, ma jalam, i bang’e, m’uwacu kumae, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.1",
            "verseOrgIds": [
              "JER.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
