          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man ebitimbre nia, calu akuro wigi kara afudhgi woko man kara arwombgi man kara ang’ielgi man kara anyothgi man kara asendgi, abikuro wigi kumeca kara agomgi man kara apidhgi, Yehova wacu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.28",
            "verseOrgIds": [
              "JER.31.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
