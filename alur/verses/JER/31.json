              "attrs": {
                "loc": "EZK.18.2"
              },
              "items": [
                {
                  "text": "Eze 18:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "I ceng’ maeca gibiwacu kendo ngo kumae, Wego camu nyingulok ma wac, man lak nyithindho tho nding’. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.29",
            "verseOrgIds": [
              "JER.31.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JER 31:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento ku ba dhanu ku ba dhanu ng’atuman bitho kum kier pare gire: ku ba dhanu ku ba dhanu ma camu nyingulok ma wac, lake bitho nding’.",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.30",
            "verseOrgIds": [
              "JER.31.30"
            ]
          }
        }
