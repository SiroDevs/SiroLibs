                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.18.21"
              },
              "items": [
                {
                  "text": "Law 18:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man gigomo ka ma malu mi Tofeth, ma ni i poga pa wod Hinom, kara giwang’ wotgi ku nyiggi i mac; m’ang’olo ngo, kadi ebino i pidoia de ngo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.31",
            "verseOrgIds": [
              "JER.7.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JER 7:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka kumeno, nen, nindo bibino, Yehova wacu, ma jubilwong’e Tofeth kendo ngo, kadi Poga mi wod Hinom, ento Poga mi Nek: kum gibiyiko avu i Tofeth, maram kamoko bibedo ko mbe mi yik. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.32",
            "verseOrgIds": [
              "JER.7.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JER 7:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man avu dhanu maeni bibedo ni cemo ni winyo ma kor polo, man ni yedi m’i ng’om; e ng’atu moko mbe ma biriemogi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.33",
            "verseOrgIds": [
              "JER.7.33"
            ]
          }
        },
        {
