              "JER.7.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.18.1"
              },
              "items": [
                {
                  "text": "Yoc 18:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.78.60"
              },
              "items": [
                {
                  "text": "Zab 78:60",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.26.6"
              },
              "items": [
                {
                  "text": "Yer 26:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ento wuci kawono ba kakara ma naka ni i Cilo, ka m’aketho nyinga lar ubedo i ie, man inen gin m’atimo i kume kum dubo mi dhanu para Israel. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.12",
            "verseOrgIds": [
              "JER.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "E kawono, kum wutimo tic maeni ceke, Yehova wacu, man ayero iwu, m’aai ko pir man ayero, ento wuwinjo ngo; man alwong’owu, ento wuloko lembe ngo: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.13",
            "verseOrgIds": [
              "JER.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka kumeno abitimo ba ot m’ulwongre ku nyinga, ma wugeno ni kume, man kum ka m’amio iwu ni kwaruwu de, calu atimo kum Cilo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.14",
            "verseOrgIds": [
              "JER.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man abibayuwu woko kud i wang’a, calu abayu utumegwu ceke, en e kodhi ceke pa Efraim.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.15",
            "verseOrgIds": [
              "JER.7.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.15",
            "verseOrgIds": [
              "JER.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka kumeno kud irwo pi dhanu maeni, kadi kud iting’ ywak kadi rwo pigi, kadi kud itim kwayukwac ira; kum abiwinji ngo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.16",
            "verseOrgIds": [
              "JER.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "E ineno ngo gin ma gitimo i adhura mi Yuda man i gengi mi Yerusalemi? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.17",
            "verseOrgIds": [
              "JER.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.44.17+JER.44.18+JER.44.19"
              },
              "items": [
                {
                  "text": "Yer 44:17-19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nyithindho coko yen, e wego cwinyo mac, man mon umieno kwen, kara gitim kwen m’apada ni ubimo ma dhaku m’i polo, man kara gikonj lam m’amadha ni mungu mange, kara ginyai ng’ecwiny i ia. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.18",
            "verseOrgIds": [
              "JER.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ginyayu ng’ecwiny i ia? Yehova wacu; gin gigi ngo, ni lewic m’i wang’gi gigi? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.19",
            "verseOrgIds": [
              "JER.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka kumeno Rwoth Yehova wacu kumae; Nen, ng’ecwiny para ku kwinyo para bikonjre woko wi ka maeni, wi dhanu, man wi lim, man wi yedhi m’i thim, man wi nying’ ng’om; e ebiwang’, man jubinege ngo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.20",
            "verseOrgIds": [
              "JER.7.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.20",
            "verseOrgIds": [
              "JER.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova mir udul, Mungu mir Israel, uwacu kumae: Wumed lam m’awang’a mu kum lam mu, man wucam ring’o. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.21",
            "verseOrgIds": [
              "JER.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kum ayero ni kwaruwu ngo, kadi ang’olo igi de ngo i ceng’ m’awodhogi ie woko kud i ng’om Misiri, pi lam m’awang’a kadi lam: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.22",
            "verseOrgIds": [
              "JER.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "ento gin maeni ang’olo igi, awacu kumae, Wuwinj dwanda, e abibedo Mungu mu, man wubibedo dhanu para; man wuwoth i yo ceke m’ang’olo iwu, kara lembe bed miero iwu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.23",
            "verseOrgIds": [
              "JER.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento giwinjo ngo, kadi giciko ithgi de ngo, ento giwotho i lembapora migi gigi man i udhuko mi cwinygi ma rac, man gicoro cen, gicidho acidha de ngo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.24",
            "verseOrgIds": [
              "JER.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ugambre i ceng’ ma kwaruwu wok ie woko kud i ng’om Misiri cil i ceng’ ma tin, aoro jutic para ceke ma jubila i beng’wu, m’aai pir aorogi de ku ba rupiny ku ba rupiny: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.25",
            "verseOrgIds": [
              "JER.7.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "ento giwinjo dwanda ngo, kadi giciko ithgi de ngo, ento gidwoko ng’utgi tek: gitimo rac ma sagu kwarugi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.26",
            "verseOrgIds": [
              "JER.7.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
