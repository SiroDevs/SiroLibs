          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "jubila giewo ku ndra, man julam ubimo ni kum piny migi; e dhanu para gimaru ebed kumeno: e wubitimo ang’o i kajikne?",
          "type": "text",
          "attrs": {
