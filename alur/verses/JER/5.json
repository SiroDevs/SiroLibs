          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gin ma wang’u ic man ma rac utimbre i ng’om: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.30",
            "verseOrgIds": [
              "JER.5.30"
            ]
          }
        },
        {
          "name": "verse",
