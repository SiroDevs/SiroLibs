            "style": "v",
            "sid": "JER 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.20",
            "verseOrgIds": [
              "JER.16.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka kumeno, nen, abiketho ging’eyo, wang’ acel maeni abiketho ging’eyo cinga man tegona; e gibing’eyo nia nyinga Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.21",
            "verseOrgIds": [
              "JER.16.21"
            ]
          }
        }
