                "loc": "JER.7.34"
              },
              "items": [
                {
                  "text": "Yer 7:34",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.25.10"
