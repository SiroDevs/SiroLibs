              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.18",
            "verseOrgIds": [
              "JER.16.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "E Yehova, ma tegona, man ka ma tek para, ku ka pondo para i nindo mi can, thek bibino i beng’i gambre i tung’ ng’om, man gibiwacu kumae, Kwaruwa gamu gin moko ngo ni aba ndhu ndra, en e gin ma ie nanu man gin ma kuloka mbe i ie. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.19",
            "verseOrgIds": [
              "JER.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhanu bitimo mungu ire gire, ma gi mungu ngo?",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.20",
            "verseOrgIds": [
              "JER.16.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
