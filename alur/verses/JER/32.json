              "attrs": {
                "loc": "JER.7.30"
              },
              "items": [
                {
                  "text": "Yer 7:30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.7.31"
              },
              "items": [
                {
                  "text": "31",
