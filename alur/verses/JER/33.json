            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.17.11+1CH.17.12+1CH.17.13+1CH.17.14"
              },
              "items": [
                {
                  "text": "1 Kei 17:11-14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kum Yehova wacu kumae: Dhanu m’ujany wi komker mi ot mir Israel birem ni Daudi ki ngo; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.17",
            "verseOrgIds": [
              "JER.33.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 33:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.3.5+NUM.3.6+NUM.3.7+NUM.3.8+NUM.3.9+NUM.3.10"
              },
              "items": [
                {
                  "text": "Wel 3:5-10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "kadok julam ma Julawi de dhanu birem igi ngo i wang’a m’uthier lam m’awang’a, man m’uwang’ lam mi mogo, man m’utim lam thiri thiri.",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.18",
