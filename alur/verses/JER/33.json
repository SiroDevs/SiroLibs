          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova wacu kumae: Tek lembariba para mi dieceng’ ku diewor ucungo ngo, tek aketho lembapoka m’i polo ku ng’om ungo; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.25",
            "verseOrgIds": [
              "JER.33.25"
            ]
          }
        },
        {
          "name": "verse",
