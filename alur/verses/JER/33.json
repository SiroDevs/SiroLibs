                  "text": "136:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "dwal mi mutoro ku dwal mir anyong’a biwinjre kendo, man dwand won ambadha ku dwand mugole, dwand ju m’uwacu kumae, Wumi foc ni Yehova mir udul, kum Yehova e ber, kum mer mi bero pare bedo mi nja; man mi ju m’ukelo lam mi foyofoc i ot pa Yehova. Kum abiketho ng’eca m’i ng’ombe dwogo calu ma kwong’a, Yehova wacu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.11",
            "verseOrgIds": [
              "JER.33.11"
            ]
          }
        }
      ]
