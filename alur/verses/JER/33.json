              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "E lembe pa Yehova bino ba Yeremia, m’uwacu kumae, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.23",
            "verseOrgIds": [
              "JER.33.23"
            ]
          }
        },
