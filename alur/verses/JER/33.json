          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iparu ngo pi gin ma dhanu maeni yero, ma giwacu kumae, Wat ario ma Yehova goyo wigi, ebayugi ceni? e gicayu dhanu para kumeno, kara ku gibed thek kendo i wang’gi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.24",
            "verseOrgIds": [
              "JER.33.24"
            ]
          }
        },
        {
