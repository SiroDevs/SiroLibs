              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man Hana rwo, ewacu kumae:",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.1",
            "verseOrgIds": [
              "1SA.2.1"
            ]
          }
        }
