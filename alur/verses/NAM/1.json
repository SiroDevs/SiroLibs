            }
          ]
        },
        {
          "text": "Ewolembe ma pi Nineve. Kitabu mi ginmawokiwang’ pa Nahum ma Jaelkoci.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.1",
            "verseOrgIds": [
              "NAM.1.1"
