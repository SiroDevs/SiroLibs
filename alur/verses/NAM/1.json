        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NAM 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man Yehova mio lembang’ola piri, kara ku jucoi mi nyingi kendo: abithumo ayi gin m’acwia m’ang’ika man ayi gin m’acwia m’atwaga kud i ot pa mungu peri; abitimo liel peri; kum i ng’ic hai.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.14",
            "verseOrgIds": [
              "NAM.1.14"
            ]
          }
        }
      ]
    },
