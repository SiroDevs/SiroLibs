            "verseId": "EPH.5.20",
            "verseOrgIds": [
              "EPH.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EPH 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma wubekethru ko giwu ya wubed wor ni juwedu i lworo pa Kristu.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.21",
            "verseOrgIds": [
              "EPH.5.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
