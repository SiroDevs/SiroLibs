              "items": [
                {
                  "text": "5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.26.9+ACT.26.10+ACT.26.11"
              },
              "items": [
                {
                  "text": "26:9-11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kum wuwinjo pira i rundi m’ukadhu i kisoma mi Juyahudi, maram anyayu ko ragedo kum kanisa pa Mungu hai, man anyothe: ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.13",
            "verseOrgIds": [
              "GAL.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GAL 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.22.3"
              },
              "items": [
                {
                  "text": "Tic 22:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "man ang’eyo kisoma mi Juyahudi ma sagu juwada dupa ma rundi migi ro ku para kind dhanu m’i ng’om ma thuwa, ma ava lemkei pa wegwa nega dit apila. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.14",
            "verseOrgIds": [
              "GAL.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GAL 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.9.3+ACT.9.4+ACT.9.5+ACT.9.6"
              },
              "items": [
                {
                  "text": "Tic 9:3-6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.22.6+ACT.22.7+ACT.22.8+ACT.22.9+ACT.22.10"
              },
              "items": [
                {
                  "text": "22:6-10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.26.13+ACT.26.14+ACT.26.15+ACT.26.16+ACT.26.17+ACT.26.18"
              },
              "items": [
                {
                  "text": "26:13-18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ento kan ebedo ber ni Mungu, m’ukoya, cil kud i ma, man elwong’a ku berone, ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.15",
            "verseOrgIds": [
              "GAL.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GAL 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ya enyuth Wode i ia, kara ayer pire kind Thekdhanumange; e pio pio nica wapido lembe waku kum ku rimo de ngo: ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.16",
            "verseOrgIds": [
              "GAL.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GAL 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "kadok aidho malu Yerusalem de ngo ba ju ma gilar gibedo jukwenda i wang’a: ento acidho para i Arabia; man adwogo kendo Dameski.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.17",
            "verseOrgIds": [
              "GAL.1.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
