          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwinji man iketh cwinyi kum lembe maeni ceke m’ang’olo iri, kara ibed ber ku nyithindho peri yo ng’ei mi nja, kinde m’itimo gin ma ber ma pwe de i wang’ Yehova Mungu peri.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.28",
            "verseOrgIds": [
              "DEU.12.28"
            ]
          }
        }
      ]
    },
