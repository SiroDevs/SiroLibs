                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.1.15"
              },
              "items": [
                {
                  "text": "2 Kei 1:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.9.27"
              },
              "items": [
                {
                  "text": "9:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kadok mon de kud emedgi ire, kara cwinye kud ulokre cen: kadok mola ma tar ku mola ma kwar de kud emedgi hai ire.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.17",
            "verseOrgIds": [
              "DEU.17.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.17",
            "verseOrgIds": [
              "DEU.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man ebibedo, kinde m’ejany wi komker mi ker pare, nia ebikiewo ire wadi cik maeni i kitabu, ku i maeno ma ni i wang’ julam ma Julawi: ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.18",
            "verseOrgIds": [
              "DEU.17.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "man ebibedo kude, e ebisomo i ie i nindo ceke m’ebedo ie kwo; kara emak ng’eyo lworo Yehova Mungu pare, kara egwok lembe ceke mi cik maeni ku lembang’ola maeni, kara etimgi; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.19",
            "verseOrgIds": [
              "DEU.17.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 17:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "kara cwinye kud utingre malu wi utumin, man kara kud elokre cen kum lembang’ola, i cing’ ma yor acwic, kadi ma yor acam: kara eketh nindo pare ton hai i ker pare en ku nyithindhe, i kind Israel.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.20",
