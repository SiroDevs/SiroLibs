                "loc": "1SA.8.5"
              },
              "items": [
                {
                  "text": "1 Sam 8:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kinde m’itundo i ng’om ma Yehova Mungu peri mio iri, man imwonye, ibedo i ie de, e iwacu kumae, Abiketho ubimo i wia, calu thek ceke m’utieka gbur; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.14",
            "verseOrgIds": [
              "DEU.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "kethe ni ubimo i wii andha, ma Yehova Mungu peri bigoyo wie: keth ng’atu acel ma kind utumeru ni ubimo i wii; kud iketh jawirok i wii, ma en e umeru ngo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.15",
            "verseOrgIds": [
              "DEU.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.10.28"
              },
              "items": [
                {
                  "text": "1 Ub 10:28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.1.16"
              },
              "items": [
                {
                  "text": "2 Kei 1:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.9.28"
              },
              "items": [
                {
                  "text": "9:28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndhu riuni kud emed ire gire, kadi kud edwok dhanu i Misiri, kara eketh riuni dok dit; kum Yehova wacu iwu kumae, Ugambre kawono kud wudok kendo i yo maeno. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.16",
            "verseOrgIds": [
              "DEU.17.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.11.1+1KI.11.2+1KI.11.3+1KI.11.4+1KI.11.5+1KI.11.6+1KI.11.7+1KI.11.8"
              },
              "items": [
                {
                  "text": "1 Ub 11:1-8",
