                }
              ]
            }
          ]
        },
        {
          "text": "Wun wu nyithindho pa Yehova Mungu mu: kud wuthumbru giwu, kadi kud wuketh wiwu wang’ temyimwu pir avu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.1",
