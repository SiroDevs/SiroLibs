              },
              "items": [
                {
                  "text": "17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tek ng’atu moko nwang’u nyaku ma sumba, ma fodi jukunyome ngo, e emake, man evuto kude, man junwang’ugi; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.28",
            "verseOrgIds": [
              "DEU.22.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DEU 22:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "e ng’atu m’uvuto kude bimio cekel mi mola ma tar pier abic ni won nyakune, e ebibedo dhaku pare, kum ecide; ecopo kethe cen ungo i nindo pare ceke. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.29",
            "verseOrgIds": [
              "DEU.22.29"
            ]
          }
        },
