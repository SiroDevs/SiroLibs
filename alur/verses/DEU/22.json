              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.1",
            "verseOrgIds": [
              "DEU.22.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.23.4"
              },
              "items": [
                {
                  "text": "Ai 23:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.23.5"
              },
              "items": [
                {
                  "text": "5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tek ineno koni dhiang’ p’umeru kadi rombo pare kier, kud iuri igi: idwokgi kendo bang’ umeru andha. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.1",
            "verseOrgIds": [
              "DEU.22.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man tek umeru bedo ceng’ni kudi ngo, kadi tek ing’eye ngo, ilund itere thu ba ot peri, e ebibedo i beng’i cil m’umeru biyenye ko, e idwoke ire. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.2",
            "verseOrgIds": [
              "DEU.22.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tim kumeni kum kana pare; tim kumeni kum kendi pare de; tim kumeni bende kum gin ceke p’umeru m’urwinyo kubang’e kubang’e, m’inwang’u: icopo peli ngo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.3",
            "verseOrgIds": [
              "DEU.22.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tek ineno kana p’umeru kadi koni dhiang’ pare podho piny dhu yo, kud iuri igi; konye andha ku ting’ogi malu kendo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.4",
            "verseOrgIds": [
              "DEU.22.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.4",
            "verseOrgIds": [
              "DEU.22.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhaku kud ukend gin ma mi co, kadok co de kud ukend kendi pa dhaku; kum ng’atu ma tek utimo gin maeni en e ginmajudagu ni Yehova Mungu peri.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.5",
            "verseOrgIds": [
              "DEU.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.5",
            "verseOrgIds": [
              "DEU.22.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tek odwinyo nen i weng’i i yo, wi yen moko kadi i ng’om, ku nyithindhe kadi tonge, man min de vuto wi nyithindhe, kadi wi tonge, kud icok min ku nyithindhe: ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.6",
            "verseOrgIds": [
              "DEU.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "wek min ucidh andha, ento icopo coko nyithindhe iri; kara ibed ber, man kara iketh nindo peri ton. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.7",
            "verseOrgIds": [
              "DEU.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kinde m’igomo ot ma nyen, ilund itim gang’ kum wi ot peri, kara kud ikel rimo wi ot peri, tek ng’atu moko podho ku kuca.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.8",
            "verseOrgIds": [
              "DEU.22.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
