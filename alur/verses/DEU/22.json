            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.12",
            "verseOrgIds": [
              "DEU.22.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.15.37+NUM.15.38+NUM.15.39+NUM.15.40+NUM.15.41"
              },
              "items": [
                {
                  "text": "Wel 15:37-41",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tim ruko i dhu kendi peri ang’wen, m’ironjri kudo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.12",
            "verseOrgIds": [
              "DEU.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.12",
            "verseOrgIds": [
              "DEU.22.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tek ng’atu moko gamu dhaku, man emondo i wie, e edage, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.13",
            "verseOrgIds": [
              "DEU.22.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "man ecuko lembe mi lewic i kume, e ekelo nying’ ma rac i wie, man ewacu kumae, Agamu dhaku maeni, e kinde m’abino i bang’e, anwang’u giranyutha ngo i bang’e ma pa nyaku ma ng’won; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.14",
            "verseOrgIds": [
              "DEU.22.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "e won nyakune, ku min mire, gibigamu giranyutha mi ng’wono pa nyakune gibitero ba judongo mir adhurane i dhugang’; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.15",
            "verseOrgIds": [
              "DEU.22.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "e won nyakune biyero ni judongo kumae, Amio nyara ni ng’atu maeni ni dhaku, man edage; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.16",
            "verseOrgIds": [
              "DEU.22.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "man, nen, ecuko lemblewic i kume, ewacu kumae, Anwang’u giranyutha mi ng’wono pa nyeri ngo; ento maeni en e giranyutha mi ng’wono pa nyara. E gibipedho bongu i wang’ judongo mir adhura. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.17",
            "verseOrgIds": [
              "DEU.22.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "E judongo mir adhurane bigamu ng’atuno man gibiponje; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.18",
            "verseOrgIds": [
              "DEU.22.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "man gibing’olo cul i wie mi cekel mi mola ma tar dak acel, e gibimiogi ni won nyakune kum ecido nying’ nyaku mir Israel; e ebibedo dhaku pare; ecopo kethe cen ungo i nindo pare ceke. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.19",
            "verseOrgIds": [
              "DEU.22.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento tek ginduni andha, nia junwang’u giranyutha mi ng’wono ngo kum nyakune; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.20",
            "verseOrgIds": [
              "DEU.22.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "gibilund wodho nyakune woko dhugola mi ot pa won, e dhanu ma co ma i adhura ma thugi bicanye ku kidi m’etho ko, kum etimo kasegu i kind Israel, m’etimo ko asara i ot pa won: kab dubo woko kumeni kud i kindi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.21",
            "verseOrgIds": [
              "DEU.22.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.21",
            "verseOrgIds": [
              "DEU.22.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 22:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tek junwang’u ng’atu ma nico vuto ku dhaku ma cware nuti, e gin ario de gibitho, ng’atu m’uvuto ku dhaku, man dhakune de: kab dubo woko kumeni ku kind Israel.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.22",
            "verseOrgIds": [
              "DEU.22.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 22:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.22",
            "verseOrgIds": [
              "DEU.22.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 22:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tek nyaku moko nuti ma ng’won ma ng’atu moko benyome, e ng’atu moko nwang’e i adhura, man evuto kude; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.23",
            "verseOrgIds": [
              "DEU.22.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 22:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "wulund wuter gin ario woko ba dhugang’ mir adhura maeno, e wucanygi ku kidi ma githo ko; nyakune, kum egoyo nduru ngo, m’eni i adhura; man nicone, kum ecido dhaku pa wadi: kab dubo woko kud i kindi kumeni.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.24",
            "verseOrgIds": [
              "DEU.22.24"
            ]
          }
        }
      ]
    },
