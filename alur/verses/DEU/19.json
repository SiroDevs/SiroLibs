              "items": [
                {
                  "text": "Poi 27:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kud ikab giranyutha mi kieu pa wedu, ma ju ma con giketho, i aba peri m’ibigamu, i ng’om ma Yehova Mungu peri mio iri kara imwonye.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.14",
            "verseOrgIds": [
              "DEU.19.14"
            ]
          }
        }
      ]
