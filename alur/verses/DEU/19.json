              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.10",
            "verseOrgIds": [
              "DEU.19.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento tek ng’atu moko dagu wadi, man ekanu adhi ire, eai de i kume, man egoye mi tho ketho nia etho, man eringo i kind adhura acel maeni; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.11",
            "verseOrgIds": [
              "DEU.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "judongo mir adhura pare bilund oro kwenda man gibiwodhe ku kuca, e gibimie i cing’ jaculrimo, kara etho. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.12",
            "verseOrgIds": [
              "DEU.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngisi kud uneg weng’i i kume, ento ikab rimo m’umbe dubo ku bang’ Israel, kara ibed ber.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.13",
            "verseOrgIds": [
              "DEU.19.13"
            ]
          }
        }
      ]
    },
