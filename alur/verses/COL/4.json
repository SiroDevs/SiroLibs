                  "text": "22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lembe para ceke Tukiko biketho wung’eyo, ma en e umego ma jamer m’e jatim mandha man e jatic wakude i Rwoth: ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.7",
            "verseOrgIds": [
              "COL.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "COL 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "m’aoro i beng’wu pi lembe maeni nini, kara wung’ei bedo mwa ma wabedo ko, man kara ejuk adundewu bende; ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.8",
            "verseOrgIds": [
              "COL.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "COL 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHM.1.10+PHM.1.11+PHM.1.12"
              },
              "items": [
                {
                  "text": "Flm 1:10-12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "karacelo kud Onesimo, ma umego mandha ma jamer bende, ma en e ng’atu acel m’i kindwu. Gibiketho wung’ei gin ceke m’utimbre kuni.",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.9",
            "verseOrgIds": [
              "COL.4.9"
            ]
          }
        }
