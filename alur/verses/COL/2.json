              "COL.2.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.14.1+ROM.14.2+ROM.14.3+ROM.14.4+ROM.14.5+ROM.14.6"
              },
              "items": [
                {
                  "text": "Rum 14:1-6",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka kumeno ng’atu moko kud upok lembe iwu kum giracama, kadi kum giramadha, kadi kum ceng’ agba kadi mi dwi ma por kadi ceng’ sabatu; ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.16",
            "verseOrgIds": [
              "COL.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "COL 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "ma en e tipopiny mi gin ma bibino; endre kum en e pa Kristu. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.17",
            "verseOrgIds": [
              "COL.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "COL 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng’atu moko kud umai giragama mi kwaya mu ku yeny ma ie yenyo mi molcwiny ku rwo ma ni malaika de, m’ebedo ndhu i gin m’eneno, m’etingre mananu kum pidoic mi kum, ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.18",
            "verseOrgIds": [
              "COL.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "COL 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.4.16"
              },
              "items": [
                {
                  "text": "Ef 4:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "m’emoko kr ngo kum Wie ma kum dho gamu gin m’ucope i bang’e, m’eribre de karacelo ni kum ujonje ku ler, ebenyai de ku nyai pa Mungu.",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.19",
            "verseOrgIds": [
              "COL.2.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "COL 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.19",
            "verseOrgIds": [
              "COL.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "COL 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tek wutho ku Kristu ni ponji ma kwong’a m’i ng’om, nedi, wudong’ wumiru giwu ni lembapoka, calu ju ma gibedo i ng’om, ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.20",
            "verseOrgIds": [
              "COL.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "COL 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kud wumaki, kadok abila de, kadok amula de ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.21",
            "verseOrgIds": [
              "COL.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "COL 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "(gin ceke ma gibinyothri i tim), tok lembang’ola ku lemponji mi dhanu? ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.22",
            "verseOrgIds": [
              "COL.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "COL 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gin maeni bedo andha ni giranena mi rieko i rwo ma ijo maru, ku jwigri gijo, ku sendo kum: ento gin maeni kulokane mbe ma dhiro wi awanyakum.",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.23",
            "verseOrgIds": [
              "COL.2.23"
            ]
          }
        }
      ]
    }
