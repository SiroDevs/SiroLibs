        "sid": "COL 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "COL 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paolo, jakwenda pa Kristu Yesu ni kum yeny ma Mungu yenyo, man Timoteo m’umegwa, ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.1",
            "verseOrgIds": [
              "COL.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "COL 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ni jumaleng’ man umego mandjia i Kristu ma gini i Kolosai: Bero iwu man kwiocwiny m’uai ba Mungu ma Wegwa.",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.2",
            "verseOrgIds": [
              "COL.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "COL 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.2",
            "verseOrgIds": [
              "COL.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "COL 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wafoyo Mungu ma Won Rwoth mwa Yesu Kristu, ma warwo ko thiri thiri piwu, ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.3",
            "verseOrgIds": [
              "COL.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "COL 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ma wadaru winjo pi yioyic mu i Kristu Yesu, man pi mer mu ma wubedo ko yo ba jumaleng’ ceke, ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.4",
            "verseOrgIds": [
              "COL.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "COL 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "kum genogen ma jukanu iwu i polo, ma wular wuwinjo pire i lembe mi lemandha mi lembanyong’a ma juboth ko, ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.5",
            "verseOrgIds": [
              "COL.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "COL 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "m’uwok i beng’wu: cil calu ebedo i ng’om ceke bende m’ecego nyinge man ecikumedre, calu ma i iwu bende, ugambre i ceng’ ma wuwinjo wung’eyo de bero pa Mungu i lemandha; ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.6",
            "verseOrgIds": [
              "COL.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "COL 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.4.12"
              },
              "items": [
                {
                  "text": "Kol 4:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHM.1.23"
              },
              "items": [
                {
                  "text": "Flm 1:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "cil calu wugamu ng’eyo con bang’ Epafra ma en e jatic wadwa ma jamer mwa, m’e jatic mandha pa Kristu piwa, ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.7",
            "verseOrgIds": [
              "COL.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "COL 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "m’eyero iwa pi mer mu bende ma i Tipo.",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.8",
            "verseOrgIds": [
              "COL.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "COL 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.8",
            "verseOrgIds": [
              "COL.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "COL 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kum lembe nini wan bende, ugambre i ceng’ ma wawinjo, waweko ki ngo nirwo ku kwayu kwac piwu, kara ng’eyong’ec mi yeny ma ie yenyo uromwu i rieko ceke ku ng’eyong’ec mi tipo bende, ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.9",
            "verseOrgIds": [
              "COL.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "COL 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "kara wuwoth calu m’uromo ku Rwoth ma wubenyayu ko mutoro kwa, ku cego nyingwu i tic ma ber ceke kubang’gi kubang’gi, ku teng’ni i ng’eyong’ec pa Mungu; ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.10",
            "verseOrgIds": [
              "COL.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "COL 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "ma wudoko tek ku tego ceke, calku tek mi dwong’ pare, ni twiocwiny ceke ku mwonyolembe ma jumwonyo hai ku mutoro: ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.11",
            "verseOrgIds": [
              "COL.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "COL 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "ma wubefoyo ko Wegp, m’udwokowa dre ni jurib mi camupacu mi jumaleng’ i der; ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.12",
            "verseOrgIds": [
              "COL.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "COL 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "m’elaruwa kud i tego mi mudho, man elokowa i ker pa Wode mi mer pare; ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.13",
            "verseOrgIds": [
              "COL.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "COL 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.1.7"
              },
              "items": [
                {
                  "text": "Ef 1:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ma wanwang’u war ma juwaru kowa ni kume, ni wek mi dubo mwa:",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.14",
            "verseOrgIds": [
              "COL.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "COL 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.14",
            "verseOrgIds": [
              "COL.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "COL 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "ma en e ayi Mungu ma nen ungo, kayu mi giracwia ceke pa Mungu; ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.15",
            "verseOrgIds": [
              "COL.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "COL 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "kum gin ceke cwire ni kume, ma pi i polo ku ma wi ng’om bende, gin ma nen ku gin ma nen ungo bende, kadok komker kadi kero kadi ker kadi tego; gin ceke cwire ni kume, pire bende; ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.16",
            "verseOrgIds": [
              "COL.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "COL 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "man en e kwong’a mi gin ceke, man gin ceke de bedo karacelo ni kume. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.17",
            "verseOrgIds": [
              "COL.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "COL 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.1.22"
              },
              "items": [
                {
                  "text": "Ef 1:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.1.23"
              },
              "items": [
                {
                  "text": "23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man en e wie mi kum, ma en e kanisa: ma en e thangambere, en e kayu mi cer ma kud i kind ju m’utho; kara ebed jawipiro i gin ceke. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.18",
            "verseOrgIds": [
              "COL.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "COL 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kum ebedo ber ni Wego ya pong’ mi gin ceke bed i ie; ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.19",
            "verseOrgIds": [
              "COL.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "COL 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.2.16"
              },
              "items": [
                {
                  "text": "Ef 2:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ya ekwi gin ceke ire gire, m’edaru timo kwiocwiny ni kum rimo mi yen m’athara pare; ni kume, awacu, kadok gin ma wi ng’om, kadi gin ma ni i polo. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.20",
            "verseOrgIds": [
              "COL.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "COL 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wun de, ma naka wukoc tung’ wu jukwor de i pidoiwu i tic ma rac mu, ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.21",
            "verseOrgIds": [
              "COL.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "COL 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "ento kawono re dong’ ekwiowu i kum mi ring’kume ni kum tho, kara ethierwu i wang’e gire ma wu leng’ ma poyo de mbe adote de mbe: ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.22",
            "verseOrgIds": [
              "COL.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "COL 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "tek ebedo kumeno ya wubed i yioyic, ma ulegwu nyang’ ucungo tek de, ma wukucoro cen ungo kum genogen mi lembanyong’a ma juboth ko ma wuwinjo, ma juyero i giracwia pa Mungu ceke the polo; ma an a Paolo judwpka ni jatije.",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.23",
            "verseOrgIds": [
              "COL.1.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "COL 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.23",
            "verseOrgIds": [
              "COL.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "COL 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nie anyong’a nega i masendi m’asendra ko piwu, man appng’o gin maka para mi masendi pa Kristu m’urem i ring’kuma pi kume, ma en e kanisa; ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.24",
            "verseOrgIds": [
              "COL.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "COL 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "ma juketha ni jatije, calku tic mi pokopok pa Mungu ma jumio ira piwu, kara aketh lembe pa Mungu timbre kakare, ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.25",
            "verseOrgIds": [
              "COL.1.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "COL 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "cil giramung’a m’ugamu pandre por con ku ba dhanu m’ucikutuk de: ento kawono dong’ junyuthe ni jumaleng’ pare, ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.26",
            "verseOrgIds": [
              "COL.1.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "COL 1:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "e ebedo ber ni Mungu ya eketh ging’ei karamb lonyo mi dwong’ mi giramung’a maeni i kind Thekdhanumange, ma en e Kristu i iwu, genogen mi dwong’: ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.27",
            "verseOrgIds": [
              "COL.1.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "COL 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
