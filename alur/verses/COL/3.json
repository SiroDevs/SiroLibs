                "loc": "1PE.3.1"
              },
              "items": [
                {
                  "text": "1 Pet 3:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mon, wubed wor ni cogwu, calu m’umaku piny i Rwoth. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.18",
            "verseOrgIds": [
              "COL.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "COL 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.5.25"
              },
              "items": [
                {
                  "text": "Ef 5:25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.3.7"
              },
              "items": [
                {
                  "text": "1 Pet 3:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wu cogmon de, wumar mondwu, man kud wukecgi. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.19",
            "verseOrgIds": [
              "COL.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "COL 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.6.1"
              },
              "items": [
                {
                  "text": "Ef 6:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nyithindho, wuwor junyodo mu i gin ceke, kum maeni nyayu mutoro i Rwoth. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.20",
            "verseOrgIds": [
              "COL.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "COL 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.6.4"
              },
              "items": [
                {
                  "text": "Ef 6:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wego, kud wunyai ng’ecwiny i nyithindho mu, kara kud wukab cwinygi. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.21",
            "verseOrgIds": [
              "COL.3.21"
            ]
          }
        },
        {
