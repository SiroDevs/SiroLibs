              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.22",
            "verseOrgIds": [
              "HEB.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "HEB 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kum kumeno ayi mi gin m’i polo ukoubed alwoka be ku maeni; endre gin m’i polo gigi ku lam ma ber ma sagu maeni. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.23",
            "verseOrgIds": [
              "HEB.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "HEB 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kum Kristu kumondo i kamaleng’ ma jutimo ku cing’ ungo, ma calu ayi mi mandha; endre i polo gire, kara ewok kawono i wang’ Mungu piwa: ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.24",
            "verseOrgIds": [
              "HEB.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "HEB 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "kadi ma nia ewodhre gire wang’ udul ungo, calu jalam ma dit ma mondo i kamaleng’ ku ba rundi ku ba rundi ku rimo ma pare ngo: ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.25",
            "verseOrgIds": [
              "HEB.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "HEB 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "tek ebedo kumeni ngo kuno di esendre wang’ udul m’ugambre i thek ma ng’om uthekre ko: ento kawono enyuthre wang’ acel pii i kajik rundi m’eketho ko dubo cen ni kum lam ma en gire. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.26",
            "verseOrgIds": [
              "HEB.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "HEB 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man kum ekethre ni dhanu ya githo wang’ acel pii, man yo ng’ei maeni pokolembe; ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.27",
            "verseOrgIds": [
              "HEB.9.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "HEB 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.53.12"
              },
              "items": [
                {
                  "text": "Isa 53:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "kumeno Kristu bende, ma juwodhe wang’ acel pii eyei dubo mi dhanu dupa, ebiwok wang’ arionde, nge ku dubo, ni ju m’ukure, ni both.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.28",
            "verseOrgIds": [
              "HEB.9.28"
            ]
          }
        }
      ]
