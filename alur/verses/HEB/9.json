              "items": [
                {
                  "text": "Law 8:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man ke hema kud agulu mi timotim ceke ekiro kumeca ku rimo. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.21",
            "verseOrgIds": [
              "HEB.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "HEB 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.17.11"
              },
              "items": [
                {
                  "text": "Law 17:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man calku cik, avowaeu, ya gin ceke julwoko ku rimo, man tek rimo ku cwir ungo, nwang’u rucoruc umbe.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.22",
            "verseOrgIds": [
              "HEB.9.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
