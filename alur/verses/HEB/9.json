          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.26.31+EXO.26.32+EXO.26.33"
              },
              "items": [
                {
                  "text": "Ai 26:31-33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man yor i ng’ei kusika mi bongu mir arionde, hema m’ulwongre Leng’ mi Maleng’; ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.3",
            "verseOrgIds": [
              "HEB.9.3"
            ]
          }
        },
