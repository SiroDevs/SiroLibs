              "items": [
                {
                  "text": "Lk 9:35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "man Tipo Maleng’ uloro i wie ku kum, calu mir akuru, dwal de ai i polo kumae, In i Woda ma jamerna; ma anyong’a nega i kumi.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.22",
            "verseOrgIds": [
              "LUK.3.22"
            ]
