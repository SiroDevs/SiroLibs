        },
        {
          "text": "Ng’atu ma tek biyenyo egwok kwo pare ebirwinye: ento ng’atu ma tek birwinyo kwo pare ebigwoke. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.33",
            "verseOrgIds": [
              "LUK.17.33"
            ]
          }
        },
        {
          "name": "verse",
