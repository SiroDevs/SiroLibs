            {
              "text": "Tha 18:20-19:25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebedo kumeno cil calu etimbre i ceng’ pa Lot; gicamu, gimadhu, ging’iewo, giloko, gipidho, gigomo: ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.28",
            "verseOrgIds": [
              "LUK.17.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 17:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "ento i ceng’ ma Lot uai i ie ku i Sodom, mac ku muganga ai i polo ucwi, unyothogi ceke: ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.29",
            "verseOrgIds": [
              "LUK.17.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
