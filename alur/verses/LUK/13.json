                {
                  "text": "Mt 19:30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.20.16"
              },
              "items": [
                {
                  "text": "20:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.10.31"
              },
              "items": [
                {
                  "text": "Mk 10:31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man nen, moko m’udong’ cen bitelo yo, moko de m’utelo yo bidong’ cen.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.30",
            "verseOrgIds": [
              "LUK.13.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.30",
            "verseOrgIds": [
              "LUK.13.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "I saa maeno Jufarisayo moko bino, wacu ire kumae, Ai kakeni, ci kamange: kum Herode yenyo enegi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.31",
            "verseOrgIds": [
              "LUK.13.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 13:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man ewacu igi kumae, Ci yer ni kaki maeno, Nen, awodho pajogi man akeyo kum tin kud urwo, i ceng’ mir adege de adoko ndhu cu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.32",
            "verseOrgIds": [
              "LUK.13.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 13:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento akoacidh be i yo para tin kud urwo ku nyiceng’maca: kum ecopre ngo nia jabila rwiny woko kud i Yerusalem. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.33",
            "verseOrgIds": [
              "LUK.13.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 13:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "E Yerusalem, Yerusalem, m’unego jubila pa Mungu, man m’ucanyu ju ma juoro i bang’e ku kidi! ayenyo wang’ udul acok nyithindho peri karacelo, cil calu min gweno coko nyithindhe the bombe, ere wuyenyo ngo! ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.34",
            "verseOrgIds": [
              "LUK.13.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 13:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.118.26"
              },
              "items": [
                {
                  "text": "Zab 118:26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nen, ot peri dong’ iri ni uvuru: man awacu iwu kumae, Wubinena ngo, cil ma wubiwacu kumae, Mugisa ni ng’atu m’ubino ku nying Rwoth.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.35",
            "verseOrgIds": [
              "LUK.13.35"
            ]
          }
        }
      ]
