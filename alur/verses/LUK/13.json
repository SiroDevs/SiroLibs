                  "text": "12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "E ywak ku kayu lak bibedo nuti, ka wubineno Ibrahim, Isak, man Yakobo, ku jubila ceke, i ker pa Mungu, wun e ma jubayuwu woko. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.28",
            "verseOrgIds": [
              "LUK.13.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 13:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gibiai yo nyangu ku yo reto, man yor ariwa ma malu ku yor ariwa ma piny, e gibibedo piny i ker pa Mungu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.29",
            "verseOrgIds": [
              "LUK.13.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 13:30"
          },
          "items": [
