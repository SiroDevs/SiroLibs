          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wot Salma gi eni: Beth-lehem, man Junetofathi, Atrothbeth-yoab, man ng’et Jumanahathi ma Juzori. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.54",
            "verseOrgIds": [
              "1CH.2.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "1CH 2:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man wat mi jugorcik m’ubedo Yabez gi eni: Jutirathi, man Jucimeathi, man Jusukathi. Maeni gi Jukeni m’uai ba Hamath, ma won juot pa Rekab.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.55",
            "verseOrgIds": [
              "1CH.2.55"
            ]
          }
        }
      ]
