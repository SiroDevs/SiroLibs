              "1CH.18.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.60"
              },
              "items": [
                {
                  "text": "Zab 60",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mange ke Abicai ma wod Zeruia goyo kind Juedomi i Poga mi Kadu rubanga apar wi abora. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.12",
            "verseOrgIds": [
              "1CH.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man eketho otmatek mir ali i Edom; man Juedomi ceke gidoko jutic pa Daudi. E Yehova mio aloci ni Daudi i ka ceke ma tek ecidho i ie.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.13",
            "verseOrgIds": [
              "1CH.18.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.13",
            "verseOrgIds": [
              "1CH.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man Daudi camu ker wi Israel ceke; man etimo lembapoka ku bedopwe ni dhanu pare ceke. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.14",
            "verseOrgIds": [
              "1CH.18.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man Yoab ma wod Zeruia bedo wi udul; man Yehocafat ma wod Ahilud en e jagorlemkei; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.15",
            "verseOrgIds": [
              "1CH.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "man Zadok ma wod Ahitub, man Abimelek ma wod Abiathar, gi julam; man Cavca en e jagorcik; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.16",
            "verseOrgIds": [
              "1CH.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "man Benaya ma wod Yehoiada en e wi Jukerethi man Jupelethi; man wot Daudi gi judongo i vut ubimo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.17",
            "verseOrgIds": [
              "1CH.18.17"
            ]
          }
        }
      ]
