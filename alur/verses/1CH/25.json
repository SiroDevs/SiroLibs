              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nie gagi ma kwong’ane wodhre pi Asaf ba Yusuf; mir arionde ke ba Gedalia; en ku utumin mire man wote gin apar wi ario: ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.9",
            "verseOrgIds": [
              "1CH.25.9"
            ]
          }
        },
