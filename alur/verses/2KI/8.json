        },
        {
          "text": "I rundi apar wi arionde pa Yoram ma wod Ahab m’ubimo mir Israel, Ahazia ma wod Yehoram m’ubimo mi Yuda maku camu ker. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.25",
            "verseOrgIds": [
