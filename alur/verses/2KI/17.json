                {
                  "text": "Tha 32:28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.35.10"
              },
              "items": [
                {
                  "text": "35:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Cil i ceng’ ma tin gitimo calu kura ma kwong’a: gilworo Yehova ngo, kadok atima de gitimo ngo calku cik migi, kadi calku lembapoka migi, kadi calu cik kadi calu lembang’ola ma Yehova ng’olo ni nyithindho pa Yakobo, m’elwong’o ko nyinge Israel; ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.34",
            "verseOrgIds": [
              "2KI.17.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2KI 17:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.20.5"
              },
              "items": [
                {
                  "text": "Ai 20:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.5.9"
              },
              "items": [
                {
                  "text": "Poi 5:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ma Yehova timo lembariba kugi, man eng’olo igi, ewacu kumae, Kud wulwor mungu mange, kadi kud wurum giwu igi, kadi kud wutim igi, kadi lam de kud wulam igi: ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.35",
            "verseOrgIds": [
              "2KI.17.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2KI 17:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.6.13"
              },
              "items": [
                {
                  "text": "Poi 6:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ento Yehova, m’ukelowu malu kud i ng’om mi Misiri ku tego ma dit man ku bote m’urieire, wulwore, man wurum giwu ire, man wulam lam ire: ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.36",
            "verseOrgIds": [
              "2KI.17.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2KI 17:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "man cik ku lembapoka, man cik ku lembang’ola, m’egoro iwu, wubiketho cwinywu i kumgi kara wutim mi nja; man kud wulwor mungu mange: ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.37",
            "verseOrgIds": [
              "2KI.17.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "2KI 17:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "man lembariba ma watimo wakudu wiwu kud uwil pire; kadi mungu mange de kud wulwor: ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.38",
            "verseOrgIds": [
              "2KI.17.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "2KI 17:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "ento wulwor Yehova Mungu mu; e ebibodhowu kud i cing’ judegi mu ceke. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.39",
            "verseOrgIds": [
              "2KI.17.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "2KI 17:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento giwinjo ngo, ere gitimo calku kura migi ma kwong’a. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.40",
            "verseOrgIds": [
              "2KI.17.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "2KI 17:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kum kumeno thek maeni lworo Yehova, man gitimo ni ayi m’acwia migi m’ang’ika; nyithindho migi bende kumeca, ku nyithindho mi nyithindhgi bende, calu kwaru migi timo, e gitimo kumeca cil i ceng’ ma tin.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.41",
            "verseOrgIds": [
              "2KI.17.41"
            ]
          }
        }
