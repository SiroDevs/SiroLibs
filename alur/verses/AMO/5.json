              "AMO.5.21"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.1.11+ISA.1.12+ISA.1.13+ISA.1.14"
              },
              "items": [
                {
                  "text": "Isa 1:11-14",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adagu, acayu agba mu, man anyong’a binega ki ngo kum cokri mu mi rwo. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.21",
            "verseOrgIds": [
              "AMO.5.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "AMO 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyo, kadok wuthiero ira lam m’awang’a mu ku lam mi mogo mu, abijologi ngo; kadok lam mi kwiocwiny mu mi lim mu m’ucwe de abiparu pire ngo. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.22",
            "verseOrgIds": [
              "AMO.5.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "AMO 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kab badwal mi wer peri cen kud i kuma; kum akwero winjo badwand dongo mu. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.23",
            "verseOrgIds": [
              "AMO.5.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "AMO 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento wek pokolembe mol piny calu pi, man bedopwe calu kulo ma dit.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.24",
            "verseOrgIds": [
              "AMO.5.24"
            ]
          }
        }
      ]
    },
