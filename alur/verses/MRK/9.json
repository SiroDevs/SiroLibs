          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "E giai kuca, gikadhu ku kind Galilaya; eyenyo ngo ya ng’atu moko ng’ei. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.30",
            "verseOrgIds": [
              "MRK.9.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MRK 9:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kum eponjo julubne, ewacu igi kumae, Wod dhanu jumie i cing’ dhanu, man gibinege; ka junege de, yo ng’ei ceng’ adek ebicer kendo. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.31",
            "verseOrgIds": [
              "MRK.9.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MRK 9:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento ging’eyo thelembe nini ngo, lworo de cerogi ku penje.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.32",
            "verseOrgIds": [
              "MRK.9.32"
            ]
          }
        }
      ]
