              "items": [
                {
                  "text": "Mt 10:42",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kum ng’atu ma tek bimio iwu pi i kikombe wumadhi, kum wu ju pa Kristu, andha ayero iwu, nia sukulia pare birwinyo ire ki ngo. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.41",
            "verseOrgIds": [
