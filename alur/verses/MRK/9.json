          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man ke ng’atu ma tek biketho ng’atu acel ma kind nyithi ju maeni ma giyia ukier, ni ng’atuca cika jung’ab pom ma dit i ng’ute, jubaye ko i nam.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.42",
