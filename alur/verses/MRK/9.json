              "items": [
                {
                  "text": "Lk 11:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kum ng’atu ma tek ubedo jadhogwa ngo nwang’u en e jabang’wa. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.40",
            "verseOrgIds": [
              "MRK.9.40"
            ]
          }
        },
