          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "E gibino Kapernaum: kan eni i ot epenjogi kumae, Ande wuporo lembang’o i gengi? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.33",
            "verseOrgIds": [
              "MRK.9.33"
            ]
          }
        },
        {
