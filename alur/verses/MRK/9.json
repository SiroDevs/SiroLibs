              "items": [
                {
                  "text": "Lk 22:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ento gibedo ling’: kum ande gipiembri i yo, nia ng’a ma dit ma sagu. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.34",
            "verseOrgIds": [
