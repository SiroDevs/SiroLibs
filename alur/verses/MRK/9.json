          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "E egamu nyathin ma nyanok, ekethe i kindgi: e kan eting’e wi bote, ewacu igi kumae, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.36",
            "verseOrgIds": [
              "MRK.9.36"
            ]
          }
