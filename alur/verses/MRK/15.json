{
  "id": "MRK.15",
  "number": "15",
  "bookId": "MRK",
  "reference": "Marko 15",
  "verseCount": 47,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "15",
        "style": "c",
        "sid": "MRK 15"
      },
      "items": [
        {
          "text": "15",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MRK 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "E pio pio kugweno julam ma dongo ku judongo man jugorcik, ku dilo ceke, gipido lembe, man gitwio Yesu, gitere, gimie ni Pilato. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.1",
            "verseOrgIds": [
              "MRK.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MRK 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "E Pilato penje kumae, In i Ubimo mi Juyahudi? Man eloko lembe ewacu ire kumae, Iwacu. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.2",
            "verseOrgIds": [
              "MRK.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MRK 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man julam ma dongo gidote kum gin dupa. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.3",
            "verseOrgIds": [
              "MRK.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MRK 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "E Pilato penje kendo, ewacu kumae, Idwoko lembe moko ngo? nen maram gibedoti ko ku gin dupa. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.4",
            "verseOrgIds": [
              "MRK.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MRK 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento Yesu dwoko lembe moko kendo ngo; ketho i Pilato wang’ lii.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.5",
            "verseOrgIds": [
              "MRK.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MRK 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.5",
            "verseOrgIds": [
              "MRK.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MRK 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwang’u naka ebedegonyo igi jakol acel, ma gikwayu i bang’e i agba. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.6",
            "verseOrgIds": [
              "MRK.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MRK 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwang’u ng’atu acel nuti ma nyinge Baraba, m’evuto atwia ku ju m’uthubo ali, gi ju ma i aline ginego nek. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.7",
            "verseOrgIds": [
              "MRK.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MRK 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "E udul dhanu gicidho malu man gimaku kwaye ya etim calu ma naka ebedetimo igi. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.8",
            "verseOrgIds": [
              "MRK.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MRK 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "E Pilato dwoko lembe igi, ewacu kumae, Wuyenyo agony iwu Ubimo mi Juyahudi? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.9",
            "verseOrgIds": [
              "MRK.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MRK 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kum eng’eyo nia kumira e m’uketho julam ma dongo gimie. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.10",
            "verseOrgIds": [
              "MRK.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MRK 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento julam ma dongo gicuno lembe i udul dhanu, ya maku egony Baraba igi. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.11",
            "verseOrgIds": [
              "MRK.15.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MRK 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pilato loko lembe kendo ewacu igi kumae, Ka kumeno abitimo ang’o kum ng’atu ma wulwong’o Ubimo mi Juyahudi? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.12",
            "verseOrgIds": [
              "MRK.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MRK 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gikok kendo kumae, Gure. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.13",
            "verseOrgIds": [
              "MRK.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MRK 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "E Pilato wacu igi kumae, Nedi, etimo ang’o ma raci? Ento gikok apila kumae, Gure. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.14",
            "verseOrgIds": [
              "MRK.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MRK 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man Pilato, m’eyenyo lembe cung ber i udul dhanu, egonyo igi Baraba, emio Yesu de, kan edara fode ku del, ya jugure.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.15",
            "verseOrgIds": [
              "MRK.15.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MRK 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.15",
            "verseOrgIds": [
              "MRK.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MRK 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "E asikari gipeye woko i katitlembe, ma en e Odtiti; e gilwong’o udul juwagi ceke karacelo. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.16",
            "verseOrgIds": [
              "MRK.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MRK 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man gironye ku bongu m’uluga, gikiedo jamkermiwic mir ukudho de, gikethe i wie; ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.17",
            "verseOrgIds": [
              "MRK.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MRK 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "e gimaku mothe kumae, Moth iri, Ubimo mi Juyahudi! ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.18",
            "verseOrgIds": [
              "MRK.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MRK 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "E gigoyo wie kud undodi, ging’ulo lau i kume, girum wi cong’gi de girwo ire. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.19",
            "verseOrgIds": [
              "MRK.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MRK 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "E ka gidaru ng’ale, giwodho kendi m’uluga, man gironye ku kendi pare. E gipeye woko, gicigigure.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.20",
            "verseOrgIds": [
              "MRK.15.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MRK 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.20",
            "verseOrgIds": [
              "MRK.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MRK 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.21",
            "verseOrgIds": [
              "MRK.15.21"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.16.13"
              },
              "items": [
                {
                  "text": "Rum 16:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man gicung’o ng’atu acel m’ubekadhu akadha, Simon ma Jakurene, m’uai i thim, m’e won Iskander giku Rufo, ya gici gikugi, kara eyei yen m’athara pare. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.21",
            "verseOrgIds": [
              "MRK.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MRK 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "E gikele ka ma julwong’o Golgotha, ma ka juloke edoko kumae, Karupokowic. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.22",
            "verseOrgIds": [
              "MRK.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MRK 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "E gimio ire pigulok m’ujebre ku yath: ento egame ngo. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.23",
            "verseOrgIds": [
              "MRK.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MRK 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.22.18"
              },
              "items": [
                {
                  "text": "Zab 22:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man gigure, gipoko kendi pare i kindgi, gigoye ku jara, kara ginwang’ ju ma bigame. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.24",
            "verseOrgIds": [
              "MRK.15.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MRK 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "E kinde ma saa doko adek, gigure. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.25",
            "verseOrgIds": [
              "MRK.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MRK 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "E karamblembe mir ado te pare jugoro yo malu kumae, UBIMO MI JUYAHUDI. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.26",
            "verseOrgIds": [
              "MRK.15.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MRK 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.53.12"
              },
              "items": [
                {
                  "text": "Isa 53:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man jugure karacelo ku weg ayeki ario; acel i cinge ma yor acwic, acel ke yor acam. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.27",
            "verseOrgIds": [
              "MRK.15.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MRK 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man lembagora pa Mungu timbre kakare, m’uwacu kumae, Man jukwane karacelo ku judubo. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.28",
            "verseOrgIds": [
              "MRK.15.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MRK 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.22.7"
              },
              "items": [
                {
                  "text": "Zab 22:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.109.25"
              },
              "items": [
                {
                  "text": "109:25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.14.58"
              },
              "items": [
                {
                  "text": "Mk 14:58",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.2.19"
              },
              "items": [
                {
                  "text": "Yoh 2:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ju ma gibecikukadhu de gicaye, giyengo wigi de, giwacu kumae, Euo! in m’inyotho hekalu, m’igome de ceng’ adek, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.29",
            "verseOrgIds": [
              "MRK.15.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MRK 15:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "leri giri, ilor piny de ku wi yen m’athara. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.30",
            "verseOrgIds": [
              "MRK.15.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MRK 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Julam ma dongo de gicaye kumeca i kindgi gigi ku jugorcik, giwacu kumae, Elaru jumange; ecopo lare gire ngo. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.31",
            "verseOrgIds": [
              "MRK.15.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MRK 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wek Kristu m’Ubimo pa Israel, ulor piny ku kor yen m’athara kawono, kara wanen wayi de. Ju ma jugurogi gikugi de gicaye.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.32",
            "verseOrgIds": [
              "MRK.15.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MRK 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.32",
            "verseOrgIds": [
              "MRK.15.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MRK 15:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "E kinde ma saa mir abusiende wok, mudho yutho ng’om ceke cil i saa mir abung’wende. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.33",
            "verseOrgIds": [
              "MRK.15.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MRK 15:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.22.1"
              },
              "items": [
                {
                  "text": "Zab 22:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "E kinde ma saa doko abung’wen Yesu kok ku dwande ma dit kumae, Eloi, Eloi, lama sabakthani? ma, ka juloke edoko kumae, Munguna, Munguna, ikuna nedi? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.34",
            "verseOrgIds": [
              "MRK.15.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MRK 15:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jumoko ma gicungo i vute, ka giwinjo maeni, giwacu kumae, Nen, elwong’o Elia. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.35",
            "verseOrgIds": [
              "MRK.15.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MRK 15:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.69.21"
              },
              "items": [
                {
                  "text": "Zab 69:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "E ng’atu acel uringo, epong’o ucoi pong’ ku picwa, ekethe de wi undodi, man emio ire emadhi, ewacu kumae, Wukowuweki; wanenu tek Elia bino wodhe piny. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.36",
            "verseOrgIds": [
              "MRK.15.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MRK 15:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "E Yesu kok ku dwande ma dit, man eweko cwinye kadhu. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.37",
            "verseOrgIds": [
              "MRK.15.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MRK 15:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.26.31+EXO.26.32+EXO.26.33"
              },
              "items": [
                {
                  "text": "Ai 26:31-33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "E kusika mi bongu m’i hekalu yec dra doko ario ugambre i wie cik i there. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.38",
            "verseOrgIds": [
              "MRK.15.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MRK 15:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "E ka jego, m’ucungo keca i vute, uneno nia eweko cwinye kadhu kumeca, ewacu kumae, Andha ng’atuni en e Wod Mungu. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.39",
            "verseOrgIds": [
              "MRK.15.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "MRK 15:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.8.2"
              },
              "items": [
                {
                  "text": "Lk 8:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.8.3"
              },
              "items": [
                {
                  "text": "3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nwang’u mon moko de nuti keca ma gibenene ku cen: Mariamu Magdalene, giku Mariamu ma min Yakobo ma nok ku Yose de, man Salome de gini i kindgi; ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.40",
            "verseOrgIds": [
              "MRK.15.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MRK 15:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "ma, kinde m’eni i Galilaya, gilubo ng’eye, gibegitimo ire bende; ku mon mange de dupa ma gibino kugi malu Yerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.41",
            "verseOrgIds": [
              "MRK.15.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MRK 15:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.41",
            "verseOrgIds": [
              "MRK.15.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "MRK 15:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "E ka piny udoko uthieno, kum en e Yikopiny, en e kumeni, ceng’ m’ular uwok ni ceng’ sabatu, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.42",
            "verseOrgIds": [
              "MRK.15.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "MRK 15:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "e Yusuf ma Arimathaya, en e ng’atu m’i dilo ma won yung, ma en bende ebekuro ker pa Mungu; emondo ba Pilato ku tegocwinye, man ekwayu avuj Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.43",
            "verseOrgIds": [
              "MRK.15.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "MRK 15:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "E Pilato ie wang’ lii tek edaru tho: man elwong’o jego i bang’e epenje tek etho ande con. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.44",
            "verseOrgIds": [
              "MRK.15.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "MRK 15:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "E kan eng’eyo maeni ba jego eyio avuje ni Yusuf. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.45",
            "verseOrgIds": [
              "MRK.15.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "MRK 15:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man eng’iewo bongu ma nwang’, man efudhe piny, eboye ku bongu ma nwang’ne, man ekethe i liel ma juroko i cana; man eng’ielo kidi kum dhugola mi liel ma juroko i cana. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.46",
            "verseOrgIds": [
              "MRK.15.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "MRK 15:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "E Mariamu Magdalene giku Mariamu ma min Yose gineno ka ma jukethe i ie.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.47",
            "verseOrgIds": [
              "MRK.15.47"
            ]
          }
        }
      ]
    }
  ],
