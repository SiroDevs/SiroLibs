            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.26",
            "verseOrgIds": [
              "MRK.8.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MRK 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "E Yesu ai, ku julubne, gicidho i pacu Kaisaria Filipi: i kinde ma gini i yo epenjo julubne, ewacu igi kumae, Dhanu giwacu ya an a ng’a? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.27",
            "verseOrgIds": [
              "MRK.8.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MRK 8:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.6.14"
              },
              "items": [
                {
                  "text": "Mk 6:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.6.15"
              },
              "items": [
                {
                  "text": "15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.9.7"
              },
              "items": [
                {
                  "text": "Lk 9:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.9.8"
              },
              "items": [
                {
                  "text": "8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "E giyero ire, giwacu kumae, Yohana ma Jabaputisi; jumange de, Elia; ento jumange re, Acel ma kind jubila. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.28",
            "verseOrgIds": [
              "MRK.8.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MRK 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.6.68"
              },
              "items": [
                {
                  "text": "Yoh 6:68",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.6.69"
              },
              "items": [
                {
                  "text": "69",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man epenjogi kumae, Wun ke wuwacu ya an a ng’a? Petro dwoko lembe ewacu ire kumae, In i Kristu. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.29",
            "verseOrgIds": [
              "MRK.8.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MRK 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man eng’olo igi ya ku giyer pire ni ng’atu moko.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.30",
            "verseOrgIds": [
              "MRK.8.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MRK 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.30",
            "verseOrgIds": [
              "MRK.8.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MRK 8:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emaku ponjogi de, nia Wod dhanu bikosendre be ku gin dupa, judongo ku julam ma dongo ku jugorcik de gibikwere, jubinege de, man ka ceng’ adek ukadhu ebicer kendo. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.31",
            "verseOrgIds": [
              "MRK.8.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MRK 8:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man eyero lembene igi kele. E Petro make, emaku kwere. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.32",
            "verseOrgIds": [
              "MRK.8.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MRK 8:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento elokre, e kan eneno julubne, ejuko Petro, ewacu kumae, Dok i ng’eya Jok; kum ii pido pi gin pa Mungu ngo, ento gin mi dhanu. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.33",
            "verseOrgIds": [
              "MRK.8.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MRK 8:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.10.38"
              },
              "items": [
                {
                  "text": "Mt 10:38",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.14.27"
              },
              "items": [
                {
                  "text": "Lk 14:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "E elwong’o udul dhanu gibin i bang’e ku julubne, man ewacu igi kumae, Tek ng’atu moko yenyo elub ng’eya, wek ekwere gire, eting’ yen m’athara pare, elub ng’eya. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.34",
            "verseOrgIds": [
              "MRK.8.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MRK 8:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.10.39"
              },
              "items": [
                {
                  "text": "Mt 10:39",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.17.33"
              },
              "items": [
                {
                  "text": "Lk 17:33",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.12.25"
              },
              "items": [
                {
                  "text": "Yoh 12:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kum ng’atu ma tek uyenyo ebodh kwo pare ebirwinye; ng’atu ma tek birwinyo kwo pare de pira ku lembanyong’a ma juboth ko de e ebibodhe. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.35",
            "verseOrgIds": [
              "MRK.8.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MRK 8:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kum kuloka ang’o ni dhanu, kadok egam ng’om ngung’, ma kwo pare ke rwinyo? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.36",
            "verseOrgIds": [
              "MRK.8.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MRK 8:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kum girang’o ma ng’atu moko biwilo ko kwo pare? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.37",
            "verseOrgIds": [
              "MRK.8.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MRK 8:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kum ng’atu ma tek lewic binege i kuma kum lembe para de i kind dhanum’utuk maeni mi gier ku dubo de, Wod dhanu bende lewic binege i kume, kan ebino i dwong’ pa Won ku malaika maleng’ de.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.38",
            "verseOrgIds": [
              "MRK.8.38"
            ]
          }
        }
      ]
    }
