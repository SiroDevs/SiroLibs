                "loc": "MAT.4.13"
              },
              "items": [
                {
                  "text": "Mt 4:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo ng’ei maeni eloro piny i Kapernaum, en, ku min, ku utumin, man julubne; man gibedo kuca ceng’ dupa ngo.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.12",
            "verseOrgIds": [
              "JHN.2.12"
            ]
          }
        }
      ]
    },
    {
