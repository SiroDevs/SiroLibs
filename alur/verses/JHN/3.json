                  "text": "Lk 10:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wego maru Wod, man emio gin ceke i cinge. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.35",
            "verseOrgIds": [
              "JHN.3.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JHN 3:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng’atu m’uyio Wod ebedo ku kwo ma rondo ku rondo; ento ng’atu m’uworo Wod ungo bineno kwo ngo, ento kwinyo pa Mungu ni i wie.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.36",
            "verseOrgIds": [
              "JHN.3.36"
            ]
