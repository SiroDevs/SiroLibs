                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amio iwu cik ma nyen, ya wumeru; cil calu amaruwu, nia wun bende wumeru. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.34",
            "verseOrgIds": [
              "JHN.13.34"
            ]
          }
        },
