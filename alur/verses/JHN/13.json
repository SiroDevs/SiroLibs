          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kum jumoko wacu nyo, kum usau ni ba Yuda, Yesu wacu ire kumae, Ng’ieu gin ma cande ni kumwa mir agba; kadi nia emi gin moko ni jucan. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.29",
            "verseOrgIds": [
              "JHN.13.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
