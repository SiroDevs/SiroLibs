          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "man Mungu bidwoke dwong’ i ie gire, e ebidoko dwong’ de pio. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.32",
