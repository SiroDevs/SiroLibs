          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka kumeno kan edaru wok woko, Yesu wacu kumae, Kawono juketho Wod dhanu doko dwong’, Mungu de doko dwong’ i ie; ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.31",
            "verseOrgIds": [
