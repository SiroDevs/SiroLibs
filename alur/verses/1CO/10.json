              "items": [
                {
                  "text": "Poi 32:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kadi waketh nyeko tim Rwothi? tego mwa sagu pare?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.22",
            "verseOrgIds": [
              "1CO.10.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
