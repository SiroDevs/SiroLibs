          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Calu kanisa ceke mi jumaleng’, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.33",
            "verseOrgIds": [
              "1CO.14.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CO 14:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "wek mon gibed ling’ i kanisa: kum juyio igi ngo ya giyer; ento wek gibed wor, calu cik bende yero. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.34",
            "verseOrgIds": [
              "1CO.14.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1CO 14:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man tek giyenyo giponj ng’eyo gin moko, wek gipenj coggi gigi ku thugi: kum en e lewic ni mon tek giyero i kanisa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.35",
            "verseOrgIds": [
              "1CO.14.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1CO 14:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ang’o? lembe pa Mungu ai i beng’wu? kadi ebino i beng’wu wu kendwu?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.36",
            "verseOrgIds": [
              "1CO.14.36"
            ]
          }
        }
      ]
    },
