          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tek ng’atu moko ie pido ya e jabila, kadi e won tipo, dong’ emak ng’eyo pi gin m’agoro iwu, ya gi lembang’ola pa Rwoth. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.37",
            "verseOrgIds": [
              "1CO.14.37"
            ]
          }
