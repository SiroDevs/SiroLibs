          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "gikethogi de the tiend jukwenda: e jupoko pokne ku ba dhanu nzu, ma can pinje ni i kumgi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.35",
            "verseOrgIds": [
