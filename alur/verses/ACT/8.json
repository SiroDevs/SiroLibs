          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "E Filipo ringo i bang’e, ewinjo ebesomo Isaya ma jabila, e epenjo kumae, Ing’eyo gin m’isomo no? ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.8.30",
            "verseOrgIds": [
              "ACT.8.30"
            ]
          }
        },
        {
