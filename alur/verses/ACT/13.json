                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "E ka gidaru timo gin ceke ma jugoro pire kakare, e gifudhe piny ku kor yen, man gikethe i bel m’aroka i cana. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.29",
            "verseOrgIds": [
              "ACT.13.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento Mungu ketho ecer ku kind ju m’utho: ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.30",
            "verseOrgIds": [
              "ACT.13.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.1.3"
              },
              "items": [
                {
                  "text": "Tic 1:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ju ma giai kugi Galilaya ma giidho gikugi Yerusalem de ginene wang’ udul, ma kawono gi jumulembe pare ni dhanu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.31",
            "verseOrgIds": [
              "ACT.13.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 13:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.2.7"
              },
              "items": [
                {
                  "text": "Zab 2:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "E wakelo iwu rwonglembe ma ber mi lembang’ola ma jumio ni kwaru, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.32",
            "verseOrgIds": [
              "ACT.13.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ACT 13:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "nia Mungu ketho lembene timbre kakare ni nyithindho mwa, kum eketho Yesu cer; calu egore i zaburi mir arionde kumae, In i Woda, tin anyoli. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.33",
            "verseOrgIds": [
              "ACT.13.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 13:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.55.3"
              },
              "items": [
                {
                  "text": "Isa 55:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man pi lembe m’eketho ecer ko ku kind ju m’utho, ma kawono dong’ edwogo kendo ngo ba top, eyero kumae, Abimio iri mugisa pa Daudi ma leng’ mandha de. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.34",
            "verseOrgIds": [
              "ACT.13.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ACT 13:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.16.10"
              },
              "items": [
                {
                  "text": "Zab 16:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kum ewacu i zaburi mange bende kumae, Ibimio Ng’atu Maleng’ peri ngo nineno top. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.35",
            "verseOrgIds": [
              "ACT.13.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "ACT 13:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kum ka Daudi daru timo porolembe pa Mungu i kind dhanu m’i kume, enindo, jukethe ba kwaru mire de, man eneno top: ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.36",
            "verseOrgIds": [
              "ACT.13.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ACT 13:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "ento ng’atu ma Mungu ketho ecer re k’eneno top ungo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.37",
            "verseOrgIds": [
              "ACT.13.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "ACT 13:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka kumeno dong’ wung’ei, umego, nia ni kum ng’atuni jubeyero iwu pi ruc mi dubo: ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.38",
            "verseOrgIds": [
              "ACT.13.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "ACT 13:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "man ku ba dhanu ceke ma giyio, lembe m’i wigi gonjre ni gin ceke, ma jucopo gonyo kowu ngo ku cik pa Musa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.39",
            "verseOrgIds": [
              "ACT.13.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "ACT 13:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka kumeno, wubed ku weng’wu, kara maeni m’uyere i kitabu mi jubila kud uwok i kumwu ma kumae:",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.40",
            "verseOrgIds": [
              "ACT.13.40"
            ]
          }
        }
      ]
    },
    {
