            "number": "26",
            "style": "v",
            "sid": "ACT 13:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umego, nyikwai kodhi Ibrahim, ku ju m’i kindwu ma lworo Mungu bende, lembe mi both maeni juoro iwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.26",
            "verseOrgIds": [
              "ACT.13.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 13:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kum ju ma gibedo Yerusalem, ku jubim migi de, kum ging’eye ngo, kadok dwand jubila ma jusomo ku ba ceng’ sabatu, giketho etimbre kakare ku gonje. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.27",
            "verseOrgIds": [
              "ACT.13.27"
            ]
          }
        },
