              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.41",
            "verseOrgIds": [
              "ACT.13.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "ACT 13:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man ka giwok woko, gikwayu ya juyer igi lembe maeni i ceng’ sabatu ma cen. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.42",
            "verseOrgIds": [
              "ACT.13.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "ACT 13:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nie ka cokri lal, Juyahudi dupa ku ju ma juloko wang’gi ma lworo Mungu gilubo ng’ei Paolo giku Barnaba; gin, ma giweco gikugi, gipiko lembe i igi de ya gibed asu i bero pa Mungu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.43",
            "verseOrgIds": [
              "ACT.13.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "ACT 13:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.43",
            "verseOrgIds": [
              "ACT.13.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "ACT 13:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ceng’ sabatu ma cen adhura ceke coko dhoge kpr kpr ni winjo lem pa Mungu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.44",
            "verseOrgIds": [
              "ACT.13.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "ACT 13:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento ka Juyahudi neno udul dhanu, ngiri negogi dwanya, e gipiemo lembe ma Paolo yero, giyanyu ayany de. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.45",
            "verseOrgIds": [
              "ACT.13.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "ACT 13:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man Paolo giku Barnaba giyero ku fcegocwinygi, giwacu kumae, Maku wakowalar wayer iwu lembe pa Mungu be. Kum wucwale cen kud i kumwu, wupoko giwu ya wuromo ku kwo ma rondo ku rondo ngo, nen, walokra ba Thekdhanumange. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.46",
            "verseOrgIds": [
              "ACT.13.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "ACT 13:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.42.6"
              },
              "items": [
                {
                  "text": "Isa 42:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.49.6"
              },
              "items": [
                {
                  "text": "49:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kum Rwoth ung’olo iwa kumeno, ewacu kumae,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.47",
            "verseOrgIds": [
