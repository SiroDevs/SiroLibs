              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kawono ibicokri giri ni njuru, E nya njuru: etiekowa kud ali; gibigoyo japoklembe mir Israel ku dul i limbe.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.1",
            "verseOrgIds": [
              "MIC.5.1"
            ]
          }
        }
      ]
