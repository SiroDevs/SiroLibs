              "ISA.47.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n        Isa 13:1-14:23; Yer 50:1-51:64",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lor piny, man ibed i utur, i Nyababeli ma sumba; bed i ng’om m’umbe komker, E nya Jukaldayo: kum jubilwong’i yom man nwenwe kendo ngo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.1",
            "verseOrgIds": [
              "ISA.47.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 47:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gam kidi rego, man ireg mogo; kab bongu mi wang’ peri woko, wany bongu m’aywaya, yab wi tiendi, kadh kud i kulo ma dit. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.2",
            "verseOrgIds": [
              "ISA.47.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 47:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muneru peri jubiyabu, eyo, lewic peri binen: abiculo kwor, man abiweko ng’atu moko ngo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.3",
            "verseOrgIds": [
              "ISA.47.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 47:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jawar mwa, nyinge Yehova mir udul, Ng’atu Maleng’ mir Israel. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.4",
            "verseOrgIds": [
              "ISA.47.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 47:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bed ling’, man imond i mudho, E nya Jukaldayo; kum jubilwong’i mugole mi ker kendo ngo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.5",
            "verseOrgIds": [
              "ISA.47.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 47:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwinyo nega kum dhanu para, acido aba para, man amiogi i cingi: kisa negi ngo i kumgi; iketho mberembere peri pek hai wi ju m’uti. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.6",
            "verseOrgIds": [
              "ISA.47.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 47:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man iwacu kumae, Abibedo mugole nja; ketho nia iketho cwinyi ngo kum gin maeni kadok kajik ma cenne de ipoi pire ngo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.7",
            "verseOrgIds": [
              "ISA.47.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
