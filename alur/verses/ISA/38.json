          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.8",
            "verseOrgIds": [
              "ISA.38.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 38:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lembagora pa Hezekia m’ubimo mi Yuda, nwang’u kume lith, man eboth ni tho pare.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.9",
            "verseOrgIds": [
              "ISA.38.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 38:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.20",
            "verseOrgIds": [
              "ISA.38.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 38:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwang’u Isaya wacu kumae, Wek gigam kwen m’ang’ina mir ubolo, man gimwone ni jamcang wi vur, e ebicangu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.21",
            "verseOrgIds": [
              "ISA.38.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 38:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwang’u Hezekia bende wacu kumae, Giranyutha ang’o ma nia abiidho ba ot pa Yehova?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.22",
            "verseOrgIds": [
              "ISA.38.22"
            ]
          }
        }
      ]
    }
