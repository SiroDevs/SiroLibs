          "type": "text",
          "attrs": {
            "verseId": "ISA.66.6",
            "verseOrgIds": [
              "ISA.66.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 66:7"
          },
          "items": [
            {
              "text": "7",
