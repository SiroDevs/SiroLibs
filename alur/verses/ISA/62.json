            "style": "v",
            "sid": "ISA 62:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.9",
            "verseOrgIds": [
              "ISA.62.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 62:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wukadhi, wukadh ku dhugang’; wuyik yo mi dhanu; wudhur, wudhur gengi ma malu; wuwodh kidi; wuting’ abera malu mi kodhidhanu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.10",
            "verseOrgIds": [
              "ISA.62.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 62:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.40.10"
              },
              "items": [
                {
                  "text": "Isa 40:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.22.12"
              },
              "items": [
                {
                  "text": "Nyu 22:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nen, Yehova yero ni kajik mi ng’om kumae, Wuwac ni Nyasayuni kumae, Nen, both peri bino; nen, sukulia pare ni kude, man sukulia pare ni i wang’e. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.11",
            "verseOrgIds": [
              "ISA.62.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 62:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man gibilwong’ogi kumae, Dhanu ma leng’, man, Ju ma juwaru pa Yehova: e jubilwong’i kumae, Ng’atu ma juyenyo, man, Adhura ma juweko ngo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.12",
            "verseOrgIds": [
              "ISA.62.12"
            ]
          }
        }
      ]
    }
