          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nen, Rwoth, Yehova mir udul, binuro jang ku ndiri: e jubing’olo ju ma boco piny, e jubijwigo ju m’utingri piny. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.33",
            "verseOrgIds": [
              "ISA.10.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ISA 10:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man ebitong’o susu mi luli ku nyunyu, man Lebanon bipodho ku ng’atu ma jatego.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.34",
            "verseOrgIds": [
              "ISA.10.34"
