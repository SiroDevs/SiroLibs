          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ewok Aiath, ekadhu kud i Migron; eketho jambwoth pare malu i Mikmac; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.28",
            "verseOrgIds": [
              "ISA.10.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ISA 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "gikadhu ku wi girakadha; gigonjo i Geba; kum Rama bemiel; Gibeya pa Saul uringo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.29",
            "verseOrgIds": [
              "ISA.10.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ISA 10:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kok ma tek ku dwendi, E nyar Galim! winji, E Laica! E in i Anathoth ma jacan! ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.30",
            "verseOrgIds": [
              "ISA.10.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ISA 10:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Madmena e jawoth; ju m’ubedo i Gebim giringo mi both. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.31",
            "verseOrgIds": [
              "ISA.10.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ISA 10:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ceng’ maeni nini ebigalu i Nob: eyengo cinge wi got pa nya Sayuni, ungulu got mi Yerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.32",
            "verseOrgIds": [
              "ISA.10.32"
            ]
          }
        }
      ]
    },
