                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.12.1"
              },
              "items": [
                {
                  "text": "Mk 12:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.20.9"
              },
              "items": [
                {
                  "text": "Lk 20:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wek awer wer pa jamerna ni jamerna pi podho mir ulok pare. Jamerna bedo ku podho mir ulok wi ungulu got ma ber hai: ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.1",
            "verseOrgIds": [
              "ISA.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "man efure, ecoko kidi de kud i ie, man epidhe ku yendulok ma cu, e egomo odtra i diere, e eroko kabipigulok bende i ie: man egeno nia ebiwodho nyingulok, e ecego nyingulok m’i thim.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.2",
            "verseOrgIds": [
              "ISA.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.2",
            "verseOrgIds": [
              "ISA.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "E kawono, e ju m’ubedo i Yerusalem man dhanu mi Yuda, akwayuwu, wupok lembe i kindwa waku podho mir ulok para. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.3",
            "verseOrgIds": [
              "ISA.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jucopo timo ang’o mange i podho mir ulok para, m’akatimo an ungo i ie? pirang’o, kinde m’ageno nia ebicego nyingulok, ecego nyingulok m’i thimi? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.4",
            "verseOrgIds": [
              "ISA.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "E kawono abiyero iwu maram abitimo ko kum podho mir ulok para: abikabu ararane, e jubicame; abirwombo gange piny, e jubinyone: ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.5",
            "verseOrgIds": [
              "ISA.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "e abidwoke ni uvuru; jubilwere ngo kadi afura de ngo; ento ucok kud ukudho bitwi: abing’olo ni afuru bende kara ku gikonj koth moko i wie. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.6",
            "verseOrgIds": [
              "ISA.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kum podho mir ulok pa Yehova mir udul en e ot mir Israel, man dhanu mi Yuda gi yen m’apidha pare ma ber: man egeno pokolembe, ento, nen, dim; egeno bedopwe, ento, nen, ywak.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.7",
            "verseOrgIds": [
              "ISA.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.7",
            "verseOrgIds": [
              "ISA.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Can ni ju ma eoro ot kum ot wadi, ma ketho podho kum podho wadi, maram kinde moko mbe ma dong’, e juketho wubed kendwu i die ng’om! ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.8",
            "verseOrgIds": [
              "ISA.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "I itha Yehova mir udul uwacu kumae, Andha udi dupa jubidwoko ni uvuru, udi ma dongo ma beco de, gibibedo ma dhanu mbe i ie. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.9",
            "verseOrgIds": [
              "ISA.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kum podho mir ulok mi dakutielo dak ang’wen bicego pigulok ma pong’o dhwong’o acel, man kodhicam ma dero acel bieek katoko acel. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.10",
            "verseOrgIds": [
              "ISA.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Can ni ju ma ai pir kugweno, kara gilub tok giramadha ma lake tek; ma gigalu hai ku diewor, maram pigulok mero kogi! ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.11",
            "verseOrgIds": [
              "ISA.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man adungu ku dongo, man umbukulumbu kud usegu, man pigulok, gini i agba migi; ento giparu pi tic pa Yehova ngo, kadok giratima mi cinge de giparu pire ngo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.12",
            "verseOrgIds": [
              "ISA.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.12",
            "verseOrgIds": [
              "ISA.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka kumeno dhanu para gicrdho i ng’eca kum ng’eyong’ec m’umbe; man dhanu migi mi yung givoc ku kec, man udul migi gisendri ku rieu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.13",
            "verseOrgIds": [
              "ISA.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka kumeno liel yabu avane, man eng’amu dhoge ma porne mbe; e dwong’ migi, kud udul migi, man yakni migi, ku ng’atu m’anyong’a nege i kindgi, giloro piny i ie. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.14",
            "verseOrgIds": [
              "ISA.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "E ng’atu ma sai junyono piny, man ng’atu ma dwong’ jujwigo, man wang’ ju m’utingri jujwigo: ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.15",
            "verseOrgIds": [
              "ISA.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ento Yehova mir udul judodo i pokolembe, man Mungu ma Ng’atu Maleng’ udwokre leng’ i bedopwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.16",
            "verseOrgIds": [
              "ISA.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "E nyithi rombe bilund camu calu i kakwae migi, man kar uvuru mi ju m’ucwe juwoth bicamu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.17",
            "verseOrgIds": [
              "ISA.5.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.17",
            "verseOrgIds": [
              "ISA.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Can wi ju m’upeyo kier ku thondh ndra, man dubo calu ku uno mi magali; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.18",
            "verseOrgIds": [
              "ISA.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "m’uwacu kumae, Wek etim pio, wek edhul tic pare, kara wanene; man wek lembapora pa Ng’atu Maleng’ mir Israel ucor ceng’ni man ebin, kara wang’ei maeni! ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.19",
            "verseOrgIds": [
              "ISA.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Can ni ju ma lwong’o dubo ya ber, man gin ma ber ya dubo; ma ketho mudho ni der, man der ni mudho; ma ketho gin ma kec ni gin ma mit, man gin ma mit ni gin ma kec! ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.20",
            "verseOrgIds": [
              "ISA.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Can ni ju ma riek i wang’gi gigi, man riu i wang’gi gigi! ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.21",
            "verseOrgIds": [
              "ISA.5.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Can ni ju ma gi jutego mi madhu pigulok, man dhanu ma jutego mi jebo giramadha ma lake tek; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.22",
            "verseOrgIds": [
              "ISA.5.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ISA 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "man ni ju ma gonyo lembe ma wi judubo ni kum jamblembe, man ma kabu bedopwe pa won bedopwe woko kud i bang’e!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.23",
            "verseOrgIds": [
              "ISA.5.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ISA 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.23",
            "verseOrgIds": [
              "ISA.5.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ISA 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka kumeno calu lebmac wang’u soka, man calu lum m’uthwo rungre i lebmac, e ulaggi bibedo kumeca calu gin m’utop, man thiugi biduny calu utur; kum gikwero cik pa Yehova mir udul, man gicayu lembe pa Ng’atu Maleng’ mir Israel. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.24",
            "verseOrgIds": [
              "ISA.5.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ISA 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka kumeno ng’ecwiny pa Yehova opo kum dhanu pare, man erieyo cinge i kumgi, man egoyogi; e gudi yengre, man avujgi bedo calu susu i die gengi. Kadok maeni ceke timbre ng’ecwiny pare lokre cen ungo, ento cinge bedo arieya asu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.25",
            "verseOrgIds": [
              "ISA.5.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ISA 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.25",
            "verseOrgIds": [
              "ISA.5.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ISA 5:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man ebiting’o abera ni thek ma ni bor, man ebilwong’ogi ku lwio kud i tung’ ng’om; man, nen, gibibino pio ku ng’wec. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.26",
            "verseOrgIds": [
              "ISA.5.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ISA 5:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng’atu moko mbe i kindgi ma biol kadi ma bikier; ng’atu moko mbe ma binuro kadi ma binindo; kadok thondhpiergi de bigony ungo, kadok ramak mi wara migi de bitur ungo: ",
          "type": "text",
