              "ISA.65.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.66.22"
              },
              "items": [
                {
                  "text": "Isa 66:22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2PE.3.13"
              },
              "items": [
                {
                  "text": "2 Pet 3:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.21.1"
              },
              "items": [
                {
                  "text": "Nyu 21:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kum, nen, acwio polo ma nyen ku ng’om ma nyen; e jubipoi pi gin ma kwong’a ngo, kadi ebiwok i pidoic de ngo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.17",
            "verseOrgIds": [
              "ISA.65.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 65:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento mutoro kud anyong’a negwu thiri thiri i gin m’acwio; kum, nen, acwio Yerusalem ni anyong’a, man dhanu pare ni mutoro. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.18",
            "verseOrgIds": [
              "ISA.65.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 65:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.21.4"
              },
              "items": [
                {
                  "text": "Nyu 21:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man anyong’a binega ni kum Yerusalem, man mutoro ni kum dhanu para; man jubiwinjo dwal mi ywak man dwal mi goyo nduru kendo ngo i ie. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.19",
            "verseOrgIds": [
              "ISA.65.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 65:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukere bibedo mbe kendo ma nindo pare nok, kadi dhanu m’uti de bibedo mbe ma fodi nindo pare kuromo ngo; kum nyathin bitho nwang’u rundi pare doko dak, man jadubo ma rundi pare dak kwong’ bibedo i wie. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.20",
            "verseOrgIds": [
              "ISA.65.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 65:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "E gibigomo udi, man gibibedo i igi; man gibipidho podho mir ulok, man gibicamu nyinge. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.21",
            "verseOrgIds": [
              "ISA.65.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 65:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gibigomo ngo, ma nia ng’atu mange bed i ie en; gibipidho ngo, ma nia ng’atu mange cam en; kum calu nindo mi yen ubedo e nindo mi dhanu para kumeno, man anyong’a binego ju m’afoyo hai kum tic m’i cing’gi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.22",
            "verseOrgIds": [
              "ISA.65.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ISA 65:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gibimuli ku tic mananu ngo, kadi gibinyol ungo mi ruvwa; kum gi kodhi mi ju ma Yehova mio mugisa i wigi, man nyikwaigi karacelo kugi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.23",
            "verseOrgIds": [
              "ISA.65.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ISA 65:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man ebitimbre nia, ma fodi gilwong’o ngo, abiloko lembe; man kinde ma fodi gibeweco, abiwinjo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.24",
            "verseOrgIds": [
              "ISA.65.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ISA 65:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.11.6+ISA.11.7+ISA.11.8+ISA.11.9"
              },
              "items": [
                {
                  "text": "Isa 11:6-9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Urudi ku nyathi rombo bicamu karacelo, man umvor bicamu soka calu koni dhiang’; e utur bibedo cemo mi thwol. Gibitimo rac ungo kadi nyotho de ngo wi got ma leng’ para ceke, Yehova wacu.",
          "type": "text",
