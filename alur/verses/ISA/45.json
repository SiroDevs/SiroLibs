          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.7",
            "verseOrgIds": [
              "ISA.45.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 45:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wucwi, wu polo, ku malu, man wek polo konj bedopwe piny: wek ng’om uyabi, kara eceg both, man wek eketh bedopwe loth karacelo; an a Yehova, acwio maeni.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.45.8",
            "verseOrgIds": [
              "ISA.45.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 45:8"
          },
          "items": [
            {
              "text": "8",
