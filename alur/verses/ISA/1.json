            {
              "text": "\n        2 Ub 18:1-20:21; 2 Kei 29:1-32:33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ginmawokiwang’ pa Isaya ma wod Amoz, m’eneno pi Yuda ku Yerusalem, i nindo pa Uzia, ku Yotham, man Ahaz, ku Hezekia, ma gin ubimo mi Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.1",
            "verseOrgIds": [
              "ISA.1.1"
            ]
          }
        }
      ]
