                  "text": "14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man udul ceke m’i polo biloi, e polo bidole calu mukeka; man udul migi ceke birwinyo woko, calu ith yendulok ner, man calu ith yendubolo ner. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.4",
            "verseOrgIds": [
              "ISA.34.4"
            ]
          }
        },
