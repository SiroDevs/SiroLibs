          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man hema bibedo nuti ni tipo ma ku dieceng’ ni lietho, man ni kapondo man ni jambum ni wavuvu man ni koth.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.6",
            "verseOrgIds": [
              "ISA.4.6"
