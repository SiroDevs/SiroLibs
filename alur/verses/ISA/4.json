                  "text": "24:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man Yehova biewio afuru ku yiro ma ku dieceng’, man rieny mi lebmac ma ku diewor; wi kabedo dho mi got Sayuni, man wi cokri pare; kum jubipedho girauma wi dwong’ne ceke. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.5",
            "verseOrgIds": [
              "ISA.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
