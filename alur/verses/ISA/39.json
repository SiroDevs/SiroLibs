              "items": [
                {
                  "text": "2 Ub 24:10-16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.10"
              },
              "items": [
                {
                  "text": "2 Kei 36:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man kind woti ma biai i ii, m’ibinyolo gibitero cen; e gibibedo jumugumba i odker mir ubimo mi Babeli. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.7",
            "verseOrgIds": [
              "ISA.39.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 39:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekia lund uwacu ni Isaya kumae, Lembe pa Yehova m’iyero e ber. Man ke ewacu kumae, Kum kwiocwiny ku lemandha bibedo nuti i nindo para.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.8",
            "verseOrgIds": [
              "ISA.39.8"
            ]
          }
        }
      ]
    }
  ],
