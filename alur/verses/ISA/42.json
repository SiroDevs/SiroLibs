              "type": "text"
            }
          ]
        },
        {
          "text": "Ng’a m’i kindwu ma biciko ithe ewinj ko maeni? ma biciko ithe man ma biwinjo mi nindo ma bibino? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.23",
            "verseOrgIds": [
              "ISA.42.23"
            ]
          }
        },
        {
