              "items": [
                {
                  "text": "Kol 3:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wu mon bende, kumeno, wubed wor ni cogwu ma dhe; kara, tek jumoko woro lembe ngo, ma gibedo umbe lembe gilok cwinygi kum koth mondgi; ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.1",
            "verseOrgIds": [
              "1PE.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1PE 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ma gineno ko kothwu ma leng’ ma mi lworo. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.2",
            "verseOrgIds": [
              "1PE.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1PE 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.2.9"
              },
              "items": [
                {
                  "text": "1 Tim 2:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ma ruko kud ubed ruko ma yo woko mi kiedo yukwie, ku kendo mola ma kwar ma ie ju kidi ma pire tek, kadi ronyo girakenda bende; ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.3",
            "verseOrgIds": [
              "1PE.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1PE 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "endre dong’ ebed ng’atu m’ukandre mir adunde, i kendi ma nyothre ngo mi cwiny ma mol ku ma yo de, ma wel pinje dit i wang’ Mungu. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.4",
            "verseOrgIds": [
              "1PE.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1PE 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kum con mon ma leng’ bende, ma gigeno Mungu, girukri kumeca, ma giworo ko coggi ma dhe: ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.5",
            "verseOrgIds": [
              "1PE.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1PE 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.18.12"
              },
              "items": [
                {
                  "text": "Tha 18:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "calu Sara woro Ibrahim, m’elwong’e ko rwoth: ma wun wu nyithindhe kawono tek wutimo dre, ma ndiri moko kuketho wulworo en ungo.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.6",
            "verseOrgIds": [
              "1PE.3.6"
            ]
          }
        }
      ]
    },
