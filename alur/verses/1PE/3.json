                "loc": "COL.3.19"
              },
              "items": [
                {
                  "text": "Kol 3:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wu cogmon de, kumeno, wubed ku mon mu calku ng’eyong’ec, ma wumio ko yung ni dhaku, calu ni agulu ma ng’ic ma sagu wu, calu wubedo jucampacu mi bero mi kwo karacelo; kara rwo mu kud ucere.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.7",
            "verseOrgIds": [
              "1PE.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
