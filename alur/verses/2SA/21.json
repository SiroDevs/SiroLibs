              "2SA.21.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.31.8+1SA.31.9+1SA.31.10+1SA.31.11+1SA.31.12+1SA.31.13"
              },
              "items": [
                {
                  "text": "1 Sam 31:8-13",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "E Daudi cidho, man egamu cogo Saul ku cogo Yonathan ma wode ku ba dhanu mi Yabec-gilead, m’ukwalugi kud i gengi mi Beth-can, ka ma Jufilisti gilierogi i ie, i ceng’ ma Jufilisti ginego ie Saul i Gilboa; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.12",
            "verseOrgIds": [
              "2SA.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "e egamu cogo Saul ku kuca ku cogo Yonathan ma wode: man gicoko cogo ju ma julierogi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.13",
            "verseOrgIds": [
              "2SA.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "E giyiko cogo Saul ku pa Yonathan ma wode i ng’om Benyamin i Zela, i odliel pa Kic ma won: e gitimo gin ceke m’ubimo ng’olo. Man yo ku ng’ei maeno Mungu winjo kwac ma pi ng’om.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.14",
            "verseOrgIds": [
              "2SA.21.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.14",
            "verseOrgIds": [
              "2SA.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "E Jufilisti bedo kud ali kendo kud Israel; man Daudi loro piny, giku jutic pare, e gikiedo ku Jufilistine. Man Daudi voc; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.15",
            "verseOrgIds": [
              "2SA.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "man Icbi-benob, ma en e kind wot ng’atu ma bor, ma pek mi tong’ pare en e cekel dak adek mi mola ma ku mukero en m’etwire ku palamularu ma nyen, ie pido ya eneg Daudi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.16",
            "verseOrgIds": [
              "2SA.21.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.11.36"
              },
              "items": [
                {
                  "text": "1 Ub 11:36",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.132.17"
              },
              "items": [
                {
                  "text": "Zab 132:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ento Abicai ma wod Zeruia bodhe, e egoyo Jafilistine, enege de. Dhanu pa Daudi gilund gikwong’o ire, giwacu kumae, Wabicidho kudu kendo ngo i lwiny, kara kud ineg thala mir Israel.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.17",
            "verseOrgIds": [
              "2SA.21.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.17",
            "verseOrgIds": [
              "2SA.21.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man etimbre yo ng’ei maeni, nia ali nuti kendo ku Jufilisti i Gob: Sibecai ma Jahucathi ulund unego Saf, ma en e kind wot ng’atu ma bor. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.18",
            "verseOrgIds": [
              "2SA.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man ali moc kendo ku Jufilisti i Gob; man Elhanan ma wod Jayareoregi ma Jabeth-lehemi nego umin Goliath ma Jagiti, ma ruvangu tong’ pare calu yen pa jacwibongu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.19",
            "verseOrgIds": [
              "2SA.21.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man ali moc kendo i Gath, ma ng’atu ma bor dit ni i ie, ma nyig lwet cinge abusiel ku ba cinge ku ba cinge, man lwet tiende de abusiel ku ba tiende ku ba tiende, welne pier ario wi ang’wen; e en bende junyole ni ng’atu ma bor. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.20",
            "verseOrgIds": [
              "2SA.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man kinde m’ecayu Israel, Yonathan ma wod Cimei, m’umin Daudi, unege. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.21",
            "verseOrgIds": [
              "2SA.21.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gin ang’wen maeni junyolo ni ng’atu ma bor i Gath; e gipodho ku cing’ Daudi, man ku cing’ jutic pare.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.22",
            "verseOrgIds": [
              "2SA.21.22"
            ]
          }
        }
      ]
    }
  ],
