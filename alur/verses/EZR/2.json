          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZR 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhanu pa Netofa, pier abic wi abusiel. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.22",
            "verseOrgIds": [
              "EZR.2.22"
            ]
          }
