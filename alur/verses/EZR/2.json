          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyithindho pa Hacum, dak ario ku pier ario wi adek. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.19",
            "verseOrgIds": [
              "EZR.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZR 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyithindho pa Gibar, pier abung’wen wi abic. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.20",
            "verseOrgIds": [
              "EZR.2.20"
            ]
          }
        },
