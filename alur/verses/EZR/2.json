        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZR 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhanu mir Anathoth, dak acel ku pier ario wi abora. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.23",
            "verseOrgIds": [
              "EZR.2.23"
            ]
          }
