          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyithindho pa Ater, pa Hezekia, pier abung’wen wi abora. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.16",
            "verseOrgIds": [
              "EZR.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZR 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyithindho pa Bezai, dak adek ku pier ario wi adek. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.17",
            "verseOrgIds": [
              "EZR.2.17"
            ]
          }
        },
