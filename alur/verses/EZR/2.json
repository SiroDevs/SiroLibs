          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZR 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyithindho pa Rama man Geba, dak abusiel ku pier ario wi acel. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.26",
            "verseOrgIds": [
