          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "nyithindho pa Yala, nyithindho pa Darkon, nyithindho pa Gidel, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.56",
            "verseOrgIds": [
