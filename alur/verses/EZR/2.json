              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nie maeni gi nyithindho mi ng’etker, m’uidho malu kud i ng’eca kind ju ma juyaku, ma Nebukadnezar m’ubimo mi Babeli terogi i Babeli, man m’udok Yerusalem man Yuda, kubang’gi kubang’gi ng’atuman i adhura pare man i adhura pare; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.1",
            "verseOrgIds": [
              "EZR.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZR 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "m’ubino ku Zerubabel, man Yecuwa, man Nehemia, man Seraya, man Relaya, man Mordekai, man Bilcan, man Mispar, man Bigvai, man Rehum, ku Bana.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.2",
            "verseOrgIds": [
              "EZR.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
