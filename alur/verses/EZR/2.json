          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyithindho pa Yora, dak acel kud apar wi ario. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.18",
            "verseOrgIds": [
              "EZR.2.18"
            ]
          }
        },
