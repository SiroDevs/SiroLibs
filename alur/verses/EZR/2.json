          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyithindho pa Imer, rubanga acel ku pier abic wi ario. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.37",
            "verseOrgIds": [
