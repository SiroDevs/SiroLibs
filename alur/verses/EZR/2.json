          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhanu pa Mikmas, dak acel ku pier ario wi ario. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.27",
            "verseOrgIds": [
              "EZR.2.27"
            ]
          }
