            "sid": "EZR 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhanu mi Beth-el ku Ai, dak ario ku pier ario wi adek. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.28",
            "verseOrgIds": [
