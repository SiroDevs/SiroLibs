          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyithindho pa Adin, dak ang’wen ku pier abic wi ang’wen. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.15",
            "verseOrgIds": [
              "EZR.2.15"
            ]
          }
        },
        {
