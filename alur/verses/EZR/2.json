          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyithindho pa Azmaveth, pier ang’wen wi ario. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.24",
            "verseOrgIds": [
              "EZR.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZR 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyithindho pa Kiraith-arim, man Kefira, man Beroth, dak abiro ku pier ang’wen wi adek. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.25",
            "verseOrgIds": [
              "EZR.2.25"
            ]
