          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZR 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyithindho pa Beth-lehem, dak acel ku pier ario wi adek. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.21",
            "verseOrgIds": [
              "EZR.2.21"
            ]
