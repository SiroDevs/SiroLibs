          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyithindho mi jutic pa Suleman ke gi eni: nyithindho pa Sotai, nyithindho pa Hasofereth, nyithindho pa Peruda, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.55",
