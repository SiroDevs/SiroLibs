            "sid": "EZR 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wel co mi dhanu mir Israel gi eni: ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.2",
            "verseOrgIds": [
              "EZR.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZR 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyithindho pa Paroc, rubanga ario ku dak acel ku pier abiro wi ario. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.3",
            "verseOrgIds": [
              "EZR.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZR 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyithindho pa Cefatia, dak adek ku pier abiro wi ario. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.4",
            "verseOrgIds": [
              "EZR.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZR 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyithindho pa Ara, dak abiro ku pier abiro wi abic. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.5",
            "verseOrgIds": [
              "EZR.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZR 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyithindho pa Pahath-moab, mi nyithindho pa Yecuwa ku Yoab, rubanga ario ku dak abora kud apar wi ario. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.6",
            "verseOrgIds": [
              "EZR.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZR 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyithindho pa Elam, rubanga acel ku dak ario ku pier abic wi ang’wen. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.7",
            "verseOrgIds": [
              "EZR.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZR 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyithindho pa Zatu, dak abung’wen ku pier ang’wen wi abic. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.8",
            "verseOrgIds": [
              "EZR.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZR 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyithindho pa Zakai, dak abiro ku pier abusiel. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.9",
            "verseOrgIds": [
              "EZR.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZR 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyithindho pa Bani, dak abusiel ku pier ang’wen wi ario. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.10",
            "verseOrgIds": [
              "EZR.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZR 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyithindho pa Bebai, dak abusiel ku pier ario wi adek. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.11",
            "verseOrgIds": [
              "EZR.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZR 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyithindho pa Azgad, rubanga acel ku dak ario ku pier ario wi ario. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.12",
            "verseOrgIds": [
              "EZR.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZR 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyithindho pa Adonikam, dak abusiel ku pier abusiel wi abusiel. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.13",
            "verseOrgIds": [
              "EZR.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZR 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyithindho pa Bigvai, rubanga ario ku pier abic wi abusiel. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.14",
            "verseOrgIds": [
              "EZR.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
