          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyithindho pa Pachur, rubanga acel ku dak ario ku pier ang’wen wi abiro. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.38",
            "verseOrgIds": [
              "EZR.2.38"
            ]
          }
