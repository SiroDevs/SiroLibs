              "type": "text"
            }
          ]
        },
        {
          "text": "Walund waweko kulo Ahava i ceng’ apar wi arionde mi dwi ma kwong’ane, kara wacidh Yerusalem: e cing’ Mungu mwa ni wiwa, man ebodhowa ni cing’ jukwor ku jakanadhi dhu yo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.31",
            "verseOrgIds": [
              "EZR.8.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EZR 8:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "E wabino Yerusalem, man wabedo keca ceng’ adek. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.32",
            "verseOrgIds": [
              "EZR.8.32"
            ]
          }
        },
        {
