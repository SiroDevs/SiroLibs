            "number": "33",
            "style": "v",
            "sid": "EZR 8:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man i ceng’ mir ang’wende juporo mola ma tar ku mola ma kwar kud agulu i jampor i ot pa Mungu mwa i cing’ Meremoth ma wod Uria ma jalam (man Eleazar ma wod Finehas ubedo karacelo kugi: giku Yozabadgi ma wod Yecuwa man Noadia ma wod Binui, ma Julawi), ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.33",
            "verseOrgIds": [
              "EZR.8.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EZR 8:34"
          },
          "items": [
