              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "kum Rwoth bitimo lembe pare kakare wi ng’om, m’ebidare ko ku jwige bende. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.28",
