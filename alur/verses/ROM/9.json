        },
        {
          "text": "Isaya bende ekok pir Israel kumae, Tek wel mi nyithindho p a Israel ubedo calu kwio ma dhu nam, donge e ma biboth: ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.27",
            "verseOrgIds": [
              "ROM.9.27"
