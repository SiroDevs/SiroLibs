              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pirang’o’ Kum giyenye ku yioyic ungo, endre calu eyenjre ku tic. Gikier kum kidi ma redhojo; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.32",
