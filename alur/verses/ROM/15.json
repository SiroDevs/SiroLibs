            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.21",
            "verseOrgIds": [
              "ROM.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ROM 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.22",
            "verseOrgIds": [
              "ROM.15.22"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.1.13"
              },
              "items": [
                {
                  "text": "Rum 1:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kum kumeno bende yo cere ira wang’ udul ma kud abin ko i beng’wu: ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.22",
            "verseOrgIds": [
              "ROM.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ROM 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "ento kawono, ma kakara dong’ umbe kendo i ng’ombuni, man ava bino i beng’wu nega rundi maeni dupa, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.23",
            "verseOrgIds": [
              "ROM.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ROM 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "kinde ma tek acidho i Spania (kum ageno ya abinenowu i woth para, man wubitera de i yo para ma kuca, tek walar wabedo wakudu ma cwinya kwio ko moko), ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.24",
            "verseOrgIds": [
              "ROM.15.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ROM 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.16.1+1CO.16.2+1CO.16.3+1CO.16.4"
              },
              "items": [
                {
                  "text": "1 Kor 16:1-4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ento kawono awacu, acidho Yerusalem, m’atimo ko ni jumaleng’. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.25",
            "verseOrgIds": [
              "ROM.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ROM 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kum ebedo ber ni Makedoni kud Akaya ya gijok ajok moko pi ju ma canpiny unegogi kind jumaleng’ ma i Yerusalem. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.26",
            "verseOrgIds": [
              "ROM.15.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ROM 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.9.11"
              },
              "items": [
                {
                  "text": "1 Kor 9:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eyo, ebedo igi ni mutoro; man gi jubanja migi. Kum tek juketho Thekdhanumange gidok jurib gin migi mi tipo, banja mi joca ni i bang’gi ya gitim igi bende i gin mi kum. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.27",
            "verseOrgIds": [
              "ROM.15.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ROM 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka kumeno kan adaru maeni, man adaru mwono ayi kum nying’ maeni, abikadhu kud i beng’wu cik i Spania. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.28",
            "verseOrgIds": [
              "ROM.15.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ROM 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man ang’eyo nia, kan abino i beng’wu, abibino i pong’ mi mugisa pa Kristu.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.29",
            "verseOrgIds": [
              "ROM.15.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ROM 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.29",
            "verseOrgIds": [
              "ROM.15.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ROM 15:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nie akwayuwu, umego, ni kum Rwoth mwa Yesu Kristu, man ni kum mer mi Tipo, ya wuii karacelo wakudu i rwo mu ni Mungu pira; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.30",
            "verseOrgIds": [
              "ROM.15.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ROM 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
