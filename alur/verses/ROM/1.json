          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "juyer nying’ ma rac, weg adegi ni Mungu, jucac, ju ma tingri, ku jukulula, ku jutheb dubo, ku ju ma juco ni junyodo migi, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.30",
            "verseOrgIds": [
              "ROM.1.30"
            ]
          }
        },
