          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "ma ng’eyong’ec umbe kugi, ku jung’eny lembariba, ma mer mi wat umbe kugi, ma kisa mbe kugi: ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.31",
            "verseOrgIds": [
              "ROM.1.31"
            ]
