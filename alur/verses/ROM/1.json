              "ROM.1.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.8.38"
              },
              "items": [
                {
                  "text": "Mk 8:38",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kum lewic unega ngo kum lembanyong’a ma juboth ko: kum en e tego pa Mungu mi both ni dhanu ceke kubang’gi kubang’gi m’uyio; ku kwong’a ni Jayahudi, man ni Jayunani bende. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.16",
            "verseOrgIds": [
              "ROM.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HAB.2.4"
              },
              "items": [
                {
                  "text": "Hab 2:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kum bedopwe pa Mungu nyuthre i ie uai ba yioyic utundo kum yioyic; calu egore kumae, Ento weg bedopwe bikwo ni kum yioyic.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.17",
            "verseOrgIds": [
              "ROM.1.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.17",
            "verseOrgIds": [
              "ROM.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ROM 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kum kwinyo pa Mungu ai kud i polo unyuthre kum gin ceke ma ayi Mungu mbe i kume man gondri ceke de mi dhanu, m’ucero lemandha i gondri; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.18",
            "verseOrgIds": [
              "ROM.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ROM 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "kum gin pa Mungu ma jung’eyo enyuthre i igi; kum Mungu nyuthe igi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.19",
            "verseOrgIds": [
              "ROM.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ROM 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kum gin pare ma nen ungo ugambre i kacwic mi ng’om dong’ nen terere, m’eng’eire ni kum gin m’ucwire, cil tego pare mi nja man rucwic; kara kalokolembe m’i wigi bed umbe igi: ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.20",
            "verseOrgIds": [
              "ROM.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ROM 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.4.17"
              },
              "items": [
                {
                  "text": "Ef 4:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.4.18"
              },
              "items": [
                {
                  "text": "18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "kum, gin ma ging’eyo Mungu, giyunge ngo calu en e Mungu, kadok afoya de gifoye ngo; ento gidoko jukuhaya i lembapora migi, man adundegi ma kite mbe yutho. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.21",
            "verseOrgIds": [
              "ROM.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ROM 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "I tuco ma gituco ko gigi ya gi riek, gidoko jukusegu, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.22",
            "verseOrgIds": [
              "ROM.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ROM 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.4.16+DEU.4.17+DEU.4.18"
              },
              "items": [
                {
                  "text": "Poi 4:16-18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "man giweko dwong’ pa Mungu ma nyothre ngo pi giracwia mir ayi dhanu ma nyothre, ku mi winyo, ku mi yedi ma tiendgi ang’wen ang’wen, ku mi gin ma lak i ng’om de.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.23",
            "verseOrgIds": [
              "ROM.1.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
