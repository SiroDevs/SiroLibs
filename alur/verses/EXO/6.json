            "sid": "EXO 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man Yehova wacu ni Musa kumae, Kawono ibineno gin m’abitimo kum Farao; kum ebiweko gicidho ni kum cing’ ma tek, man ebixiemogi woko kud i ng’om pare ni kum cing’ ma tek.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.1",
            "verseOrgIds": [
              "EXO.6.1"
            ]
          }
        }
      ]
    },
