          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "E Yehova timo calku lembe pa Musa; man ekabu ulwang’ni ku ba Farao, ku ba jutic pare, man ku ba dhanu pare; acel de mbe m’udong’. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.31",
            "verseOrgIds": [
