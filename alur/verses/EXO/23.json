            }
          ]
        },
        {
          "text": "Coi ng’om peri rundi abusiel, man icok nyaine: ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.10",
            "verseOrgIds": [
              "EXO.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "ento rundi mir abirone wek eyom man evut lwe, kara jucan mi dhanu peri gicam: man gin ma giweko yedi m’i thim bicamu. Tim kumeno kum podho mir ulok peri, man kum podho mir ulam peri. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.11",
            "verseOrgIds": [
              "EXO.23.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
