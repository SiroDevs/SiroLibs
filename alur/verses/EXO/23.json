                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kud irwei lembe mi ndra: kud iketh cingi karacelo ku judubo ma nia ibed jamulembe mir abombi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.1",
            "verseOrgIds": [
