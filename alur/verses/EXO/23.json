              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tek irombo ku koni dhiang’ kadi kana pa jadegi peri m’uberwinyo, dwoke kendo i bang’e andha. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.4",
            "verseOrgIds": [
              "EXO.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tek ineno kana pa ng’atu m’udegi podho the ter pare, man iceri ya kud ikonye, ibigonye andha karacelo kude.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.5",
            "verseOrgIds": [
              "EXO.23.5"
            ]
          }
        }
      ]
    },
