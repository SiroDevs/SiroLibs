                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kud inyoth lembapoka ma pwe pa jacan i lembe pare. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.6",
            "verseOrgIds": [
              "EXO.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bed bor ku lem ndra; man ju ma lembe mbe i wigi ku ju ma pwe kud ineggi: kum abigonyo lembe ma wi judubo ngo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.7",
            "verseOrgIds": [
              "EXO.23.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man kud igam jamblembe: kum jamblembe eoro wang’ ju ma neno piny, man enyotho lembe mi ju ma pwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.8",
            "verseOrgIds": [
              "EXO.23.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
