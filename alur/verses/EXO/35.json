              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "E Musa wacu ni nyithindho mir Israel kumae, Nen, Yehova lwong’o Bezalel ku nyinge, ma wod Uri, ma wod Hur, mi suru pa Yuda; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.30",
            "verseOrgIds": [
              "EXO.35.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 35:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "man epong’e ku Tipo pa Mungu, ku rieko, ku ng’eyothelembe, ku ng’eyong’ec, man tic mi bodho ma kwonde tung’ tung’ ceke; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.31",
            "verseOrgIds": [
              "EXO.35.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
