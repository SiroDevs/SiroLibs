              "type": "text"
            }
          ]
        },
        {
          "text": "E Musa coko udul nyithindho mir Israel ceke, man ewacu igi kumae, Maeni lembe ma Yehova ng’olo, nia wutimgi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.1",
            "verseOrgIds": [
              "EXO.35.1"
            ]
          }
        },
        {
