              "items": [
                {
                  "text": "29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man tek ng’ atu moko bibidho nyaku ma sumba ma junyomo ngo, man evuto kude, ebimio keny pire andha kara edok dhaku pare. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.16",
            "verseOrgIds": [
              "EXO.22.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tek won ukwero mie ire ma gwei, ebiculo sente calku keny mi nyir.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.17",
            "verseOrgIds": [
              "EXO.22.17"
            ]
          }
        }
      ]
    },
