                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man juot mir Israel ulwong’o nyinge Mana: man e calu nying’ cam moko, e tar; man midone calu kwen ma jung’ino ku kic. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.31",
            "verseOrgIds": [
              "EXO.16.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 16:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man Musa wacu kumae, Maepi gin ma Yehova ng’olo, Wek jukan maeni asisa acel cil i dhanum’utuk mu, kara ginen kwen m’akaku kowu i langa kinde m’awodhowu woko kud i ng’om Misiri. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.32",
            "verseOrgIds": [
              "EXO.16.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 16:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.9.4"
              },
              "items": [
                {
                  "text": "Ebr 9:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "E Musa wacu ni Harun kumae, Gam tabu, man iketh mana asisa acel i ie, man ikane i wang’ Yehova, kara jugwoke cil kum dhanum’utuk mu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.33",
            "verseOrgIds": [
              "EXO.16.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 16:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "E Harun ukane kumeca i wang’ Lembatuca, calu Yehova ng’olo ni Musa, kara jugwoke. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.34",
            "verseOrgIds": [
              "EXO.16.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 16:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
