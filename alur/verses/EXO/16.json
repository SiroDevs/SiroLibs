                "loc": "JOS.5.12"
              },
              "items": [
                {
                  "text": "Yoc 5:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "E nyithindho mir Israel ucamu mana rundi pier ang’wen, cil ma gitundo ko i ng’om ma dhanu ni i ie; gicamu mana, cil ma gibino ko ba kieu mi ng’om Kanan. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.35",
            "verseOrgIds": [
              "EXO.16.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
