          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man abiguro hema ng’et ot para kum njuru asikari, kara ng’atu moko kud ukadh kud i ie kadi udwog de; man ng’atu moko mbe ma lem pare ie tek ma bikadhu kud i kindgi kendo: kum kawono aneno ku wang’a.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.8",
            "verseOrgIds": [
              "ZEC.9.8"
            ]
          }
        }
      ]
    },
