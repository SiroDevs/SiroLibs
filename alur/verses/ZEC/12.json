                "loc": "REV.1.7"
              },
              "items": [
                {
                  "text": "Nyu 1:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man abikonjo tipo mi bero ku kwac wi ot pa Daudi, man wi ju m’ubedo i Yerusalem; man gibineno i bang’a ma gicobo; e gibiywak pire, calu ng’atu ma ywak pi wode ma kulong’, man can binegogi pire, calu ng’atu ma can nego pi kayu pare. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.10",
            "verseOrgIds": [
              "ZEC.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEC 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "I ceng’ maeca ywak ma dit bibedo i Yerusalem, calu ywak mi Hadadrimon i poga mi Megidon. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.11",
            "verseOrgIds": [
              "ZEC.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ZEC 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "E ng’om biywak, ku ba juot tung’ tung’; juot mi ot pa Daudi tung’, mon migi de tung’; juot mi ot pa Nathan de tung’, mon migi de tung’; ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.12",
            "verseOrgIds": [
              "ZEC.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ZEC 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "juot mi ot pa Lawi de tung’, mon migi de tung’; juot mi Jucimei tung’, mon migi de tung’; ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.13",
            "verseOrgIds": [
              "ZEC.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ZEC 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "juot ceke m’udong’, juot kubang’gi nzu tung’, mon migi de tung’.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.14",
            "verseOrgIds": [
              "ZEC.12.14"
            ]
          }
        }
