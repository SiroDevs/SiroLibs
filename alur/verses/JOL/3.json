            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.19.15"
              },
              "items": [
                {
                  "text": "19:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wuketh pala i ie; kum mwoka cek: wubin, wuyok; kum pany mir ulok upong’, jambic ubethakni; kum dubo migi dit.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.13",
            "verseOrgIds": [
              "JOL.3.13"
            ]
          }
        }
      ]
    },
    {
