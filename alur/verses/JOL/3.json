        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.13",
            "verseOrgIds": [
              "JOL.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOL 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Udul dhanu, udul dhanu i poga mi kethocwiny! kum ceng’ pa Yehova ni ceng’ni i poga mi kethocwiny. ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.14",
            "verseOrgIds": [
              "JOL.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOL 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ceng’ ku dwi giyutho, man cero gong’o rieny migi.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.15",
            "verseOrgIds": [
              "JOL.3.15"
            ]
          }
        }
      ]
    },
