            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man Yeftha poko lembe mir Israel rundi abusiel. Yeftha ma Jagileadi ulund utho, man juyike i adhura acel mi Gilead.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.7",
            "verseOrgIds": [
              "JDG.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.7",
            "verseOrgIds": [
              "JDG.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man yo ng’eye Ibzan mi Beth-lehem upoko lembe i Israel. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.8",
            "verseOrgIds": [
              "JDG.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man ebedo ku wot pier adek; man nyir pier adek m’eoro kamange, man egamu nyir ma kamange pier adek ni wote. E epoko lembe i Israel oro abiro. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.9",
            "verseOrgIds": [
              "JDG.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man Ibzan utho, man juyike i Beth-lehem.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.12.10",
            "verseOrgIds": [
              "JDG.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
