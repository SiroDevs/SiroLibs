            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.17.6"
              },
              "items": [
                {
                  "text": "Pok 17:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "I nindo maeca ubimo mbe i Israel: ku ba dhanu nzu ng’atuman timo gin m’ubedo ber i wang’e gire.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.25",
            "verseOrgIds": [
              "JDG.21.25"
            ]
          }
        }
