          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kawono, E Mungu para, wek, akwei, weng’i bed ayaba, man wek ithi bed acika, ba rwo ma jutimo i ka maeni. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.40",
            "verseOrgIds": [
              "2CH.6.40"
            ]
          }
        },
