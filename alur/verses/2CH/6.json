            "style": "v",
            "sid": "2CH 6:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.31",
            "verseOrgIds": [
              "2CH.6.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2CH 6:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mange ke pi jawirok, ma en e mi dhanu peri Israel ungo, kinde m’ebiai kud i ng’om ma bor ni kum nyingi ma dwong’, ku cingi ma tek, ku boti m’arieya; kinde ma gibibino gibirwo de yo ba ot maeni: ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.32",
            "verseOrgIds": [
              "2CH.6.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2CH 6:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "dong’ ilund iwinj kud i polo, kud i kabedo peri, man ilund itim calku grin ceke ma jawirok ulwong’i pire; kara kodhidhanu ceke m’i ng’om ung’ei nyingi, man gilwori, calu dhanu peri Israel, man kara ging’ei nia ot maeni m’agomo lwongre ku nyingi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.33",
            "verseOrgIds": [
              "2CH.6.33"
            ]
          }
        }
      ]
    },
    {
