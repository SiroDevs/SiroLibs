              "type": "text"
            }
          ]
        },
        {
          "text": "Lembe pa Yehova bende bino i bang’a, m’uwacu kumae, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.1",
            "verseOrgIds": [
              "EZK.12.1"
            ]
          }
        },
        {
