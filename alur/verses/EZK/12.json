                "loc": "ISA.6.9"
              },
              "items": [
                {
                  "text": "Isa 6:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.6.10"
              },
              "items": [
                {
                  "text": "10",
