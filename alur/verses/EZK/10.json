                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.4.2"
              },
              "items": [
                {
                  "text": "Nyu 4:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alund aneno, man, nen, i afuru ma ni i wi kerubi gin moko wok i wigi calu en e kidi ma tek ma nen uluga, calu giranena mir ayi komker. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.1",
            "verseOrgIds": [
              "EZK.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.8.5"
              },
              "items": [
                {
                  "text": "Nyu 8:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man eyero ni dhanu m’uronjre ku bongu ma nwang’, e ewacu kumae, Mond i kind ukobre m’uwire, en e the kerubi acel, man ipong’ cingi ario ku cukmac kud i kind kerubi, man ikir wi adhurane. Man emondo i wang’a. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.2",
            "verseOrgIds": [
              "EZK.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nie kerubi cungo i ng’et ot ma yor acwic, kinde ma dhanune mondo; man afuru pong’o lelagang’ ma yor i ie. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.3",
            "verseOrgIds": [
              "EZK.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man dwong’ pa Yehova idho malu ku ba kerubine, man ecungo wi riu mi dhugola mi ot; e ode pong’ kud afuru, man lelagang’ de pong’ ku rieny mi dwong’ pa Yehova. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.4",
            "verseOrgIds": [
              "EZK.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man badwand bomb kerubi winjre cil ba lelagang’ ma yo woko, calu dwand Mungu ma Jategokpo kinde m’eweco. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.5",
            "verseOrgIds": [
              "EZK.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man etimbre, kinde m’eng’olo ni ng’atu m’uronjre ku bongu ma nwang’, m’ewacu kumae, Gam mac kud i kind ukobre m’ubewire, kud i kind kerubi, nia emondo, man ecungo i ng’et ukobre acel. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.6",
            "verseOrgIds": [
              "EZK.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man kerubi acel urieyo cinge kud i kind kerubi ba mac ma ni i kind kerubi, man egamu kume moko, man ekethe i cing’ ng’atu m’uronyo bongu ma nwang’, m’ugame man ewok woko. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.7",
            "verseOrgIds": [
              "EZK.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man ayi cing’ dhanu wok ba kerubi the bombgi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.8",
            "verseOrgIds": [
              "EZK.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
