              "items": [
                {
                  "text": "Law 21:1-4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man gibimondo bang’ avu dhanu ngo kara ucidgi gigi: ento gicopo cidri pi weggi, kadi pi meggi, kadi pi wodgi, kadi pi nyiggi, pir umeggi, kadi pi nyameggi ma fodi cware mbe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.25",
            "verseOrgIds": [
              "EZK.44.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 44:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man yo ng’ei dwokrileng’ pare, gibikwanu ire ceng’ abiro, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.26",
            "verseOrgIds": [
              "EZK.44.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 44:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man i ceng’ m’emondo i ie i kamaleng’, i lelagang’ ma yor i ie, kara etim i kamaleng’, ebithiero lam mi dubo pare, Rwoth Yehova wacu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.27",
            "verseOrgIds": [
              "EZK.44.27"
            ]
          }
        }
      ]
