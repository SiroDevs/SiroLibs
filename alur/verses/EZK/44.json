                "loc": "NUM.18.8+NUM.18.9+NUM.18.10+NUM.18.11+NUM.18.12+NUM.18.13+NUM.18.14+NUM.18.15+NUM.18.16+NUM.18.17+NUM.18.18+NUM.18.19"
              },
              "items": [
                {
                  "text": "Wel 18:8-19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Gibicamu lam mi mogo, ku lam mi dubo, man lam mi kier; man gin ma jukoyo i Israel kubang’e kubang’e bibedo migi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.29",
            "verseOrgIds": [
