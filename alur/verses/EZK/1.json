                "loc": "REV.19.11"
              },
              "items": [
                {
                  "text": "Nyu 19:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nie etimbre i rundi pier adege, i dwi mir ang’wende, i ceng’ mir abije mi dwije, kinde m’ani i kind ng’eca dhu kulo Kebar, nia polo yabre, man aneno ginmawokiwang’ pa Mungu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.1",
            "verseOrgIds": [
              "EZK.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.24.10+2KI.24.11+2KI.24.12+2KI.24.13+2KI.24.14+2KI.24.15+2KI.24.16"
              },
              "items": [
                {
                  "text": "2 Ub 24:10-16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.9"
              },
              "items": [
                {
                  "text": "2 Kei 36:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.10"
              },
              "items": [
                {
                  "text": "10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "I ceng’ mir abije mi dwije, ma en e rundi mir abije mi ng’eca p’ubimo ma Yehoiakin, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.2",
            "verseOrgIds": [
              "EZK.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "lembe pa Yehova bino ng’beng’ ba Ezekiel ma jalam, ma wod Buzi, i ng’om mi Jukaldayo dhu kulo Kebar; e cing’ Yehova ni i wie kuca.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.3",
            "verseOrgIds": [
              "EZK.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.3",
            "verseOrgIds": [
              "EZK.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man aneno, man, nen, yamu ma wavuvu ai yor ariwa ma malu, afuru ma dit, ku mac ra’uwinjre gire i ie, man rieny m’utieke gbur, man umbu m’urieny ni i kinde, kud i die mac. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.4",
            "verseOrgIds": [
              "EZK.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.4.6"
              },
              "items": [
                {
                  "text": "Nyu 4:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man avi gin ma kwo ang’wen uwok Jcud i kinde. Man maeni en e nen migi: Gibedo kud ayi dhanu; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.5",
            "verseOrgIds": [
              "EZK.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "man kubang’gi kubang’gi wang’gi ang’wen ang’wen, man kubang’gi kubang’gi bombgi ang’wen ang’wen. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.6",
            "verseOrgIds": [
              "EZK.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man tiendgi en e tielo m’atira; man tiendgi ma nyono ng’om e calu tiend nyathi dhiang’; man girieny calu mola ma jurudo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.7",
            "verseOrgIds": [
              "EZK.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man gibedo ku cing’ dhanu the bombgi i ng’etgi ang’wen; man gin ang’wen gibedo kubombgiku wang’gi de kumeni: ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.8",
            "verseOrgIds": [
              "EZK.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "bombgi ribre kum wadi; gilokri ngo kinde ma gicidho; kubang’gi kubang’gi man ucidho atira i wang’e. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.9",
            "verseOrgIds": [
              "EZK.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.10.14"
              },
              "items": [
                {
                  "text": "Eze 10:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.4.7"
              },
              "items": [
                {
                  "text": "Nyu 4:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pir ayi wang’gi, gibedo ku wang’gi pa wang’ dhanu; man gin ang’wen wang’gi pa wang’ umvor i ng’etgi ma yor acwic; man gin ang’wen wang’gi pa wang’ koni dhiang’ i ng’etgi ma yor acam; man gin ang’wen wang’gi pa wang’ acur bende. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.10",
            "verseOrgIds": [
              "EZK.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man wang’gi ku bombgi tung’ tung’ ku malu; bombgi ario kubang’gi kubang’gi uribri kum wadi, man ario umo kumgi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.11",
            "verseOrgIds": [
              "EZK.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man kubang’gi kubang’gi man ucidho atira i wang’e: ka ma tipo cidho i ie, gicidho; gilokri ngo kinde ma gicidho. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.12",
            "verseOrgIds": [
              "EZK.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.4.5"
              },
              "items": [
                {
                  "text": "Nyu 4:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pir ayi gin ma kwone, nen migi calu cukmac m’uwang’, calu nen mi dhumac: mac cidho malu ku piny i kind gin ma kwo; man mac urieny, man lukoth wok woko kud i macne. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.13",
            "verseOrgIds": [
              "EZK.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man gin ma kwone giringo gi dwogo de calu nen mi lukoth.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.14",
            "verseOrgIds": [
              "EZK.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
