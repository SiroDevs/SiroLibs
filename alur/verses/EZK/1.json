            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man gin moko nuti wi gin ma kwo ma calu apokapiny, ma nen calu pei m’uriang’ni m’ubedo arieya ka wigi ku malu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.22",
            "verseOrgIds": [
              "EZK.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
