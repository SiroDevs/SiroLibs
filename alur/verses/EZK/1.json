              "items": [
                {
                  "text": "19:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man kinde ma gicidho, awinjo badwand bombgi calu badwand pi ma dit, calu dwand Ng’atu ma Jategokpo, badwal mi yakni calu badwal mir udul: kinde ma gicungo, gikonjo bombgi piny. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.24",
            "verseOrgIds": [
              "EZK.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man dwal nuti wi apokapiny ma ni wi wigi: kinde ma gicungo, gikonjo bombgi piny. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.25",
            "verseOrgIds": [
              "EZK.1.25"
            ]
          }
