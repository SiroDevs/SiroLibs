            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZK 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Calu nen mi danyu ma ni i afuru i ceng’ mi koth, e nen mi rieny ma gbur ubedo kumeca. Maeni en e nen mir ayi mi dwong’ pa Yehova. Man kinde m’aneno maeni, apodho arieba wang’a, man awinjo dwand ng’atu m’uyero.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.28",
