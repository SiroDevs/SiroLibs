          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man ewacu ira kumae, Kusika maeni, ma neno yor ariwa ma piny, en e mi julam, jugwok mi kur mi ot, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.45",
