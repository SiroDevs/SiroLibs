          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mesa ang’wen ni i ng’ete kucel, man mesa ang’wen ni i ng’ete mucelo, i ng’et dhugang’; mesa abora, ma githumo lam i wie. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.41",
            "verseOrgIds": [
