          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man mesa ang’wen nuti mi lam m’awang’a, mi kidi m’apaya, kaborne bot acel ku katumbla, man kalacne bot acel ku katumbla, man kadongone bot acel; ka ma giketho i wie jamthum mi lam m’awang’a ku lam, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.42",
            "verseOrgIds": [
