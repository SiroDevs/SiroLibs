            "verseId": "1KI.10.26",
            "verseOrgIds": [
              "1KI.10.26"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.4.26"
              },
              "items": [
                {
                  "text": "1 Ub 4:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man Suleman ucoko magali ku weg riuni karacelo: man ebedo ku magali rubanga acel ku dak ang’wen, man weg riuni rubanga apar wi ario, m’ekethogi i adhura mi magali, man kud ubimo i Yerusalem. ",
          "type": "text",
