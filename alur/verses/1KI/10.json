                  "text": "Poi 17:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man ubimo ketho mola ma tar ubedo pami kidi i Yerusalem, man eketho yendmusonge bedo calu yenduduk ma ni i poga, ni ditne. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.27",
