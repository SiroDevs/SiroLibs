        },
        {
          "text": "Man etimbre i rundi mir abije p’ubimo ma Rehoboam, nia Cicak m’ubimo mi Misiri uidho malu kum Yerusalem; ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.25",
