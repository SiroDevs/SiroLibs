              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nie dong’ tic pa Rehoboam, ku gin ceke m’etimo, gigore i kitabu mi lemkei mir ubimo mi Yuda ngo? ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.29",
            "verseOrgIds": [
              "1KI.14.29"
            ]
          }
        },
