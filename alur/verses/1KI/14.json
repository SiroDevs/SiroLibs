          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man ebedo kumeno, nia, ku ba mondo m’ubimo mondo ko i ot pa Yehova, jukur giyeyogi, man gidwokogi kendo i kusika mi gwok.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.28",
            "verseOrgIds": [
              "1KI.14.28"
            ]
          }
        }
