            }
          ]
        },
        {
          "text": "Wang’ adek i rundi acel Suleman uthiero lam m’awang’a ku lam mi kwiocwiny wi pemblam m’egomo ni Yehova, m’ewang’u ko udok ma ng’wice ng’ar karacelo kudo, wi pemblam ma ni i wang’ Yehova. Kum kumeno edaru ode.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.25",
            "verseOrgIds": [
              "1KI.9.25"
            ]
          }
        }
