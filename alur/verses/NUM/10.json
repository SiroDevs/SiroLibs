              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man afuru pa Yehova ni i wigi ku dieceng’, kinde ma gitugo woth ma giai ko ku i kagonjo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.34",
