          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.17",
            "verseOrgIds": [
              "GEN.33.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 33:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "E Yakobo bino i kwiocwiny bang’ adhura mi Cekem, ma ni i ng’om Kanan, kinde m’eai Padan-aram; man egonjo i wang’ adhurane. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.18",
            "verseOrgIds": [
              "GEN.33.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 33:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.24.32"
              },
              "items": [
                {
                  "text": "Yoc 24:32",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.4.5"
              },
              "items": [
                {
                  "text": "Yoh 4:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man eng’iewo ng’et ng’om, ka m’eguro ie hema pare, i cing’ nyithindho pa Hamor, ma won Cekem, ku ng’et mola ma tar dak acel. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.19",
            "verseOrgIds": [
              "GEN.33.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 33:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man eguro pemblam keca, man elwong’e El-Elohe-Israel.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.20",
            "verseOrgIds": [
              "GEN.33.20"
            ]
          }
        }
      ]
    }
  ],
