              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man Adamu camu ng’om rundi dak acel ku pier adek, man enyolo nyathin ma nico ma calu en gire, m’ulubo ayine; e ecaku nyinge Seth: ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.3",
            "verseOrgIds": [
              "GEN.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "man ceng’ pa Adamu yo ng’ei nyolo Seth en e rundi dak abora: man enyolo nyithindho ma co ku nyithindho ma nyir. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.4",
            "verseOrgIds": [
              "GEN.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man ceng’ ma Adamu camu ie ng’om en e rundi dak abung’wen ku pier adek: e etho.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.5",
            "verseOrgIds": [
              "GEN.5.5"
            ]
          }
        }
