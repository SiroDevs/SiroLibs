        },
        {
          "text": "nico ku dhaku de ecwiogi, man emio mugisa igi, man elwong’o nying’gi Dhanu, i ceng’ m’ecwiogi i ie. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.2",
            "verseOrgIds": [
              "GEN.5.2"
