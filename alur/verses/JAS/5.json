        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.18",
            "verseOrgIds": [
              "JAS.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JAS 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Juwada, tek ng’atu moko m’i kindwu wingre kum lemandha, e ng’atu moko dwoke; ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.19",
            "verseOrgIds": [
              "JAS.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JAS 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.10.12"
              },
              "items": [
                {
                  "text": "Lem 10:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.4.8"
              },
              "items": [
                {
                  "text": "1 Pet 4:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "wek eng’ei, nia ng’atu m’uloko jadubo kud i yo ma nwang’u ekier i ie, ebibodho kwo acel kud i tho, man ebiumo udul dubo dupa.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.20",
            "verseOrgIds": [
              "JAS.5.20"
            ]
          }
        }
      ]
