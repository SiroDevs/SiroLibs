                "loc": "ISA.40.3"
              },
              "items": [
                {
                  "text": "Isa 40:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kum maeni en e ng’atu ma Isaya ma jabila yero pire ewacu kumae,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.3",
            "verseOrgIds": [
              "MAT.3.3"
            ]
          }
        }
      ]
    },
    {
