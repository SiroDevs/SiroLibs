            }
          ]
        },
        {
          "text": "Man ceng’ maeno Yohana ma Jabaputisi bino, ku yero i yamba mi Yahudi, ewacu kumae, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.1",
            "verseOrgIds": [
              "MAT.3.1"
            ]
          }
