                {
                  "text": "Mt 4:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.1.15"
              },
              "items": [
                {
                  "text": "Mk 1:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wulok cwinywu; kum ker mi polo ni ceng’ni. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.2",
            "verseOrgIds": [
              "MAT.3.2"
            ]
          }
        },
        {
