              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "E wang’gi yabre. Man Yesu ng’olo igi ma tek, ewacu kumae, Wunen ng’atu moko kud ung’ei maeni. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.30",
            "verseOrgIds": [
