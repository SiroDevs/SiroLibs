              },
              "items": [
                {
                  "text": "20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nwang’u kan ewinjo nia jumaku Yohana, eai ecidho Galilaya; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.12",
            "verseOrgIds": [
              "MAT.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.2.12"
              },
              "items": [
                {
                  "text": "Yoh 2:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "e kan eai Nazareti, ebino ebedo de Kapernaum, ma ni dhu nam, i kieu Zabulon ku Naftalim: ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.13",
            "verseOrgIds": [
              "MAT.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "kara lembe ma yang’ Isaya ma jabila yero timbre kakare, m’ewacu kumae,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.14",
            "verseOrgIds": [
              "MAT.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
