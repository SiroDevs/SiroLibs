                  "text": "21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "kara rimo ceke ma pwe m’uthwogre wi ng’om, ubed i wiwu ugambre kum rimb Habil ma pwe cil ku rimb Zakaria ma wod Barakia, ma wunego i kind hekalu ku pemblam. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.35",
            "verseOrgIds": [
              "MAT.23.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
