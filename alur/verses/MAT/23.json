              "items": [
                {
                  "text": "Lk 3:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wu thwol, wu nyikwai urobi, wucopo piei ni lembapoka mi gehena nenedi? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.33",
            "verseOrgIds": [
              "MAT.23.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 23:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka kumeno, nen, aoro jubila i beng’wu, ku jurieko, man jugorcik: jumoko m’i kindgi de wubinego wubigurogi de; jumoko de m’i kindgi wubifodogi i kacokri mu, man wubinyayu ragedo i kumgi ku bang’ adhura ku bang’ adhura: ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.34",
            "verseOrgIds": [
              "MAT.23.34"
            ]
          }
        },
        {
