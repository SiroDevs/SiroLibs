          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Can i wiwu, jugorcik ku Jufarisayo, weg ambili! kum wulonyo yo ng’ei kikombe ku yo ng’ei atangla, ento kuvuga kud awanya ma rac upong’ yor i igi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.25",
            "verseOrgIds": [
              "MAT.23.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 23:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "In i Jafarisayo ma abinga, ilar ilony yo i kikombe kud atangla de, kara yo ng’eigi bende dok leng’.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.26",
            "verseOrgIds": [
              "MAT.23.26"
            ]
          }
        }
      ]
    },
