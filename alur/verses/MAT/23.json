            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Can i wiwu, jugorcik ku Jufarisayo, weg ambili! kum wu calu odliel ma jufuyo ku vulo, ma nen ber ku yo woko, ento cogo dhanu m’utho pong’ yor i igi, ku sasa ceke. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.27",
            "verseOrgIds": [
              "MAT.23.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cil kumeno wun bende dhanu nenowu pwe ku yo woko, ento ku yor i iwu wupong’ kud ambili man camuco.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.28",
            "verseOrgIds": [
              "MAT.23.28"
            ]
          }
        }
      ]
    },
    {
