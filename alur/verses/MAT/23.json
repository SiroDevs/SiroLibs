            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.27.30"
              },
              "items": [
                {
                  "text": "Law 27:30",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Can i wiwu, jugorcik ku Jufarisayo, weg ambili! kum wumio apaje mir ukuju, ku thoki, man atingli, man wuweko gin ma pek mi cik, ku pokolembe ma pwe, man kisa, ku yioyic: ento emaku wutim gin maeni, man kud wuwek timo gin maeni de. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.23",
            "verseOrgIds": [
              "MAT.23.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wu jutelwijo ma wun abinga, wuluro jur woko, man wumwonyo ngamia!",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.24",
            "verseOrgIds": [
              "MAT.23.24"
            ]
          }
        }
      ]
