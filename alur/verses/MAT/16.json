              "items": [
                {
                  "text": "Rum 2:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kum Wod dhanu bibino i dwong’ pa Won karacelo ku malaika pare; e ebilund mio ni dhanu ceke kubang’gi calku tic pare. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.27",
            "verseOrgIds": [
              "MAT.16.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 16:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awacu iwu andha kumae, Jumoko ma kind ju m’ucungo kakeni bibilo tho ki ngo, ma fodi gikuneno Wod dhanu ngo m’ubebino i ker pare.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.28",
            "verseOrgIds": [
