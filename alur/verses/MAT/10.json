              "items": [
                {
                  "text": "2 Tim 2:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ento ng’atu ma tek bikwera i wang’ dhanu, an bende abikwere i wang’ Vwa ma ni i polo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.33",
