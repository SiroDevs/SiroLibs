                "loc": "MAT.24.9"
              },
              "items": [
                {
                  "text": "Mt 24:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.13.13"
              },
              "items": [
                {
                  "text": "Mk 13:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.21.17"
              },
              "items": [
                {
                  "text": "Lk 21:17",
