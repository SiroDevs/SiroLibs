              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka kumeno ku ba dhanu nzu ma bituca i wang’ dhanu, an bende abituce i wang’, Vwa ma ni i polo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.32",
            "verseOrgIds": [
              "MAT.10.32"
            ]
