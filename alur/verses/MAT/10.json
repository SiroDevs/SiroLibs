                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.24.13"
              },
              "items": [
                {
                  "text": "Mt 24:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.13.13"
              },
              "items": [
                {
                  "text": "Mk 13:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man dhanu ceke gibidaguwu kum nyinga: ento ng’atu m’uciro cil i kajikne, ng’atuni e ma biboth. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.22",
            "verseOrgIds": [
              "MAT.10.22"
            ]
