                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man wubai jamiru ma kuloka pare mbe i mudho ma woko: ywak ku kayu lak de bibedo nuti.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.30",
