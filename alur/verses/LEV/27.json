              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.28",
            "verseOrgIds": [
              "LEV.27.28"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.18.14"
              },
              "items": [
                {
                  "text": "Wel 18:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento, gin ma jukwong’o, ma dhanu bikwong’o ni Yehova i kind gin ceke m’ebedo ko, kadok en e kind dhanu kadi kind lim, kadi mi podho mi piny pare, jubiloko kadi jubiwaru de ngo: gin ma jukwong’o kubang’e kubang’e en e leng’ m’usagu ni Yehova. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.28",
            "verseOrgIds": [
              "LEV.27.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 27:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng’atu moko mbe ma jukwong’o, ma jukwong’o ku kind dhanu, ma jubiwaru; jubinege andha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.29",
