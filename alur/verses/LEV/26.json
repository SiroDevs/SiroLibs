                  "text": "27:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kud wutim mungu m’araga iwu, kadi kud wuting’ ayi m’ang’ika malu, kadi mbegi, kadok kidi m’ang’ika de ku juketh i ng’om mu, kara wurum i bang’e: kum an a Yehova Mungu mu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.1",
            "verseOrgIds": [
              "LEV.26.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wugwok ceng’ sabatu para, man wuyung kamaleng’ para; an a Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.2",
            "verseOrgIds": [
              "LEV.26.2"
            ]
          }
        }
      ]
    },
    {
