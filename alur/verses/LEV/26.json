          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.45",
            "verseOrgIds": [
              "LEV.26.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LEV 26:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maeni lembang’ola ku lembapoka man cik, ma Yehova timo i kindgi giku nyithindho mir Israel kum got Sinai ni kum Musa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.46",
            "verseOrgIds": [
              "LEV.26.46"
            ]
          }
        }
