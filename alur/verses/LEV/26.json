            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.17.7"
              },
              "items": [
                {
                  "text": "Tha 17:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
