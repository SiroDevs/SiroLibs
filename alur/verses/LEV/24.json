        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.22",
            "verseOrgIds": [
              "LEV.24.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 24:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "E Musa yero ni nyithindho mir Israel; man giwodho ng’atuno woko m’ukwong’o kwong’ i ng’ei kagonjo, e gicanye ku kidi. E nyithindho mir Israel gitimo calu Yehova ng’olo ni Musa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.23",
            "verseOrgIds": [
              "LEV.24.23"
            ]
          }
        }
      ]
