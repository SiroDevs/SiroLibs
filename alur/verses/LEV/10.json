              "LEV.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.12",
            "verseOrgIds": [
              "LEV.10.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.6.14+LEV.6.15+LEV.6.16+LEV.6.17+LEV.6.18"
              },
              "items": [
                {
                  "text": "Law 6:14-18",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "E Musa yero ni Harun, man ni Eleazar man ni Ithamar, ma wote m’udong’ kumae, Wugam lam mi mogo m’udong’ ma kind lam pa Yehova ma jutimo ku mac, man wucame ma thobi mbe i ie i ng’et pemblam; kum en e leng’ m’usagu; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.12",
            "verseOrgIds": [
              "LEV.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "man wucame i kamaleng’, kum en e makapiny peri, man makapiny mi woti, ma kind lam pa Yehova ma jutimo ku mac: kum jung’olo ira kumeno. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.13",
            "verseOrgIds": [
              "LEV.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.7.30+LEV.7.31+LEV.7.32+LEV.7.33+LEV.7.34"
              },
              "items": [
                {
                  "text": "Law 7:30-34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man wucam kor m’awira ku bamb m’ating’a i ka ma leng’, in, ku woti, ku nyigi wukugi: kum jumiogi calu makapiny peri, man makapiny mi woti, ku kind lam mi girathiera mi kwiocwiny mi nyithindho mir Israel. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.14",
            "verseOrgIds": [
              "LEV.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gibikelo bam m’ating’a ku kor m’awira karacelo ku lam ma jutimo ku mac mi mio, kara juwire ni lam m’awira i wang’ Yehova: e ebibedo peri, ku mi woti wukugi, ni makapiny mi nja; calu Yehova ng’olo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.15",
            "verseOrgIds": [
              "LEV.10.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.15",
            "verseOrgIds": [
              "LEV.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "E Musa yenyo diel mi lam mi dubo kle kle, man, nen, juwang’e: e ng’ecwiny unege kum Eleazar man kum Ithamar, ma wot Harun m’udong’, ewacu kumae, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.16",
            "verseOrgIds": [
              "LEV.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.6.24+LEV.6.25+LEV.6.26"
              },
              "items": [
                {
                  "text": "Law 6:24-26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Pirang’o wukwero camu lam mi dubo i ka mi kamaleng’, kum en e leng’ m’usagu, man emie iwu kara ukab dubo mir udul woko, kara utim adunya pigi i wang’ Yehova? ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.17",
            "verseOrgIds": [
              "LEV.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nen, jukelo rimbe ngo yor i kamaleng’: maku wucame andha i kamaleng’, calu ang’olo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.18",
            "verseOrgIds": [
              "LEV.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "E Harun uwacu ni Musa kumae, Nen, githiero lam mi dubo migi ku lam m’awang’a migi tin i wang’ Yehova; e wadi gin maeni wok i kuma: man tek acamu lam mi dubo tin, ebiyire i wang’ Yehova? ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.19",
            "verseOrgIds": [
              "LEV.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "E kinde ma Musa winjo maeni, eyire i wang’e.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.20",
            "verseOrgIds": [
              "LEV.10.20"
            ]
          }
        }
      ]
    }
