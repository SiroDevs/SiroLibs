                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man Yehova yero ni Musa, ewacu kumae, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.1",
            "verseOrgIds": [
              "LEV.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tek ng’atu moko dubo, man ekadhu ku wi cik pa Yehova, man etimo wadi ku ndra i lembe mi sumba, kadi mi lokopiny, kadi mir ayeki, kadi mi sendo wadi, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.2",
            "verseOrgIds": [
              "LEV.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kadi enwang’u gin m’urwinyo, man etimo ku ndra i lembene, man ekwong’o kwong’ ku ndra; i gin moko i kind maeni ceke ma dhanu timo, m’edubo i ie; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.3",
            "verseOrgIds": [
              "LEV.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ebilund bedo, tek edubo, man lembe ni i wie, nia ebidwoko gin m’egamu kud ayeki kadi gin m’egamu ku kuvuga, kadi sumba ma jukanu i bang’e, kadi gin m’urwinyo m’enwang’u, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.4",
            "verseOrgIds": [
              "LEV.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "kadi gin moko m’ekwong’o pire ku ndra; ebidwoke andha bo, man ebimedo ng’ete mir abije mange i kume: ebimio ni ng’atu ma lembe ni i kindgi gikude, i ceng’ ma junwang’u ie lembe i wie. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.5",
            "verseOrgIds": [
              "LEV.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man ebikelo lam mi kadhukuwicik pare ni Yehova, nyog rombo ma mulima mbe i kume ku kind udul rombe, calku kwanuwel peri, ni lam mi kadhukuwicik, ba jalam: ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.6",
            "verseOrgIds": [
              "LEV.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "e jalam bitimo adunya pire i wang’ Yehova; man jubiweko pire ire pi gin ma tek etimo ketho lembe bedo i wie pire.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.7",
            "verseOrgIds": [
              "LEV.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.7",
            "verseOrgIds": [
              "LEV.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man Yehova yero ni Musa, ewacu kumae, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.8",
            "verseOrgIds": [
              "LEV.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng’ol ni Harun ku wote, wac kumae, Maeni cik mi lam m’awang’a: lam m’awang’a bibedo wi yen mi mac wi pemblam diewor soro cil kugweno; man jubiketho mac mi pemblam liel asu i wie. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.9",
            "verseOrgIds": [
              "LEV.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "E jalam bironyo kendi pare ma nwang’, man ebiroyo bombo pare mi bongu ma nwang’ i kume; man ebijobo vuru mac m’uwang’u lam m’awang’a wi pemblam, man ebikethogi i ng’et pemblam. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.10",
            "verseOrgIds": [
              "LEV.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man ebiwodho kendi pare, man ebironyo kendi mange, e ebitero vurune woko ng’ei kagonjo i ka ma leng’. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.11",
            "verseOrgIds": [
              "LEV.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "E jubiketho mac ma wi pemblam liel asu i wie, ebitho ngo; e jalam biwang’u yen i wie ku ba kugweno ku ba kugweno: man ebiketho lam m’awang’a i wie kakare, e ebiwang’u mio mi lam mi kwiocwiny i wie. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.12",
            "verseOrgIds": [
              "LEV.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jubiketho mac liel wi pemblam thiri thiri; ebitho ngo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.13",
            "verseOrgIds": [
              "LEV.6.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.13",
            "verseOrgIds": [
              "LEV.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man maeni cik mi lam mi mogo: wot Harun bithiere i wang’ Yehova, i wang’ pemblam. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.14",
            "verseOrgIds": [
              "LEV.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man ebigamu kume pong’ cing’, kum mogo ma yom mi lam mi mogo, man kum moje, kud udok ma ng’wice ng’ar ceke ma ni wi lam mi mogo, man ebiwang’e wi pemblam ni ng’wic mido ma ng’ar, calu lempoine, ni Yehova. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.15",
            "verseOrgIds": [
              "LEV.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man donge m’udong’ Harun ku wote bicamu: jubicame ma thobi mbe i ie i kamaleng’; gibicame i lelagang’ mi hema mi cokri. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.16",
            "verseOrgIds": [
              "LEV.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jubitede ku thobi ngo. Amie calu makapiny migi i kind girathiera para ma jutimo ku mac; en e leng’ m’usagu, calu lam mi dubo, man calu lam mi kadhukuwicik. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.17",
            "verseOrgIds": [
              "LEV.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku ba co ceke ma kind nyithindho pa Harun bicamu kume moko, calu makapiny pare mi nja cu kum dhanum’utuk mu, i kind girathiera pa Yehova ma jutimo ku mac: ng’atu ma tek umulo kumgi bibedo leng’.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.18",
            "verseOrgIds": [
              "LEV.6.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.18",
            "verseOrgIds": [
              "LEV.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man Yehova yero ni Musa, ewacu kumae, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.19",
            "verseOrgIds": [
              "LEV.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maeni en e girathiera pa Harun ku wote, ma gibithiero ni Yehova i ceng’ ma juwire: ng’ete mir apaje ini mogo ma yom ma i katoko ni lam mi mogo ma thiri thiri, ng’ete moko mi kugweno, man ng’ete mucelo uthieno. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.20",
            "verseOrgIds": [
              "LEV.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jubitime ku i atangla i kendo karacelo ku mo; kinde m’eyomni, ibikele i ie: ibithiero mukaru m’utal ni lam mi mogo ni ng’wic mido ma ng’ar ni Yehova. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.21",
            "verseOrgIds": [
              "LEV.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man jalam ma juwiro ma bibedo kakare i kind wote bithiere: jubiwang’e dho ni Yehova ku cik mi nja. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.22",
            "verseOrgIds": [
              "LEV.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man ku ba lam mi mogo pa jalam jubiwang’e dho: jubicame ngo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.23",
            "verseOrgIds": [
              "LEV.6.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.23",
            "verseOrgIds": [
              "LEV.6.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "E Yehova yero ni Musa, ewacu kumae, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.24",
            "verseOrgIds": [
              "LEV.6.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yer ni Harun man ni wote, wac kumae, Maeni cik mi lam mi dubo: jubinego lam mi dubo i wang’ Yehova i ka ma junego ie lam m’awang’a: en e leng’ m’usagu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.25",
            "verseOrgIds": [
              "LEV.6.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jalam m’ulame pi dubo bicame: jubicame i kamaleng’, i lelagang’ mi hema mi cokri. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.26",
            "verseOrgIds": [
              "LEV.6.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gin ceke ma tek umulo ringe bibedo leng’; man kinde ma jukiro rimone wi kendi moko, lwok gin ma jukiro i wie i kamaleng’. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.27",
            "verseOrgIds": [
              "LEV.6.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 6:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento agulu mir ulobo ma jutede i ie jubinego; man tek jutede i agulu mir umbu, jubirude, man jubilau ie ku pi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.28",
            "verseOrgIds": [
              "LEV.6.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 6:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku ba co ceke ma kind julam bicamu kume moko: en e leng’ m’usagu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.29",
            "verseOrgIds": [
              "LEV.6.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 6:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
