          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.13",
            "verseOrgIds": [
              "2CO.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CO 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bero pa Rwoth Yesu Kristu, ku mer pa Mungu, man ribri pa Tipo Maleng’, ubed i beng’wu kpo.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.14",
            "verseOrgIds": [
              "2CO.13.14"
            ]
          }
        }
      ]
    }
