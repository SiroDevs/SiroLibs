              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo ng’ei gin maeni aneno, man nen, dhugola yabre i polo, e dwal ma kwong’a m’awinjo, dwalne calu mir agwara m’ubeweco kuda, acel m’ubewacu kumae, Idh malu kue, man abinyutho iri gin ma bikotimbre be macen. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.1",
            "verseOrgIds": [
              "REV.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 4:2"
          },
          "items": [
