                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man lukoth ku dwal ku morpolo giai ba komker. Man thala abiro mi mac ubeliel i wang’ komker, ma gi Tipo abiro pa Mungu; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.5",
            "verseOrgIds": [
              "REV.4.5"
            ]
          }
        },
        {
