        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.23.17"
              },
              "items": [
                {
                  "text": "Isa 23:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.51.7"
              },
              "items": [
                {
                  "text": "Yer 51:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kum ni kum pigulok mi kwinyo mi tarwang’ pare thek ceke gipodho; man ju m’ubimo m’i ng’om gitimo tarwang’ kude, man jukuloka m’i ng’om gidoko julonyo ni kum tego mi jambayunga pare.",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.3",
            "verseOrgIds": [
              "REV.18.3"
            ]
          }
        }
      ]
    },
