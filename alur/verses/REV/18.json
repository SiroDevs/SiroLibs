                  "text": "45",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man awinjo dwal mange ai i polo, wacu kumae, Wuwoki, dhanu para, wuwok kud i ie, kara kud wuribru ki ku dubo pare, man kara kud wujol kum masendi pare: ",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.4",
            "verseOrgIds": [
              "REV.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.18.20"
              },
              "items": [
                {
                  "text": "Tha 18:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.18.21"
              },
              "items": [
                {
                  "text": "21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.51.9"
              },
              "items": [
                {
                  "text": "Yer 51:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "kum dubo pare tundo cil i polo, man Mungu poi pi camuco pare. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.5",
            "verseOrgIds": [
              "REV.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.137.8"
              },
              "items": [
                {
                  "text": "Zab 137:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.50.29"
              },
              "items": [
                {
                  "text": "Yer 50:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wumi ire cil calu emio, man wumi ire wang’ ario calku tic pare: i kikombe m’ejebo i ie, jeb ire wang’ ario. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.6",
            "verseOrgIds": [
              "REV.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.47.7+ISA.47.8+ISA.47.9"
              },
              "items": [
                {
                  "text": "Isa 47:7-9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wumi ire ndiba ku can kumeni ma rom ku yung m’eyungre ko, man dhetho mi yeny ma ie yenyo: kum ewacu yo i adundene kumae, Abedo ubimo ma dhaku, man an a dhaku ma cwara tho ngo, man abineno can ki ngo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.7",
            "verseOrgIds": [
              "REV.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka kumeno i ceng’ acel masendi pare biwok, tho, ku can, man ndru; man ebiwang’ kot ku mac; kum Rwoth Mungu m’upoko lembe pare e tek. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.8",
            "verseOrgIds": [
              "REV.18.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.26.16"
              },
              "items": [
                {
                  "text": "Eze 26:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.26.17"
              },
              "items": [
                {
                  "text": "17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man ju m’ubimo m’i ng’om, m’utimo tarwang’ kude m’ubedo i ayunga ceke de gikugi, gibiywak ku goyo nduru i wie, ka gineno yiro mi wang’ m’ewang’ ko, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.9",
            "verseOrgIds": [
              "REV.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ma gicungo ko ku bor ni lworo mi ndiba pare, ma giwacu ko kumae, Can, can, adhura ma dwong’, Babeli, adhura ma tek! kum i saa acel pokolembe peri wok. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.10",
            "verseOrgIds": [
              "REV.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.27.31"
              },
              "items": [
                {
                  "text": "Eze 27:31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.27.36"
              },
              "items": [
                {
                  "text": "36",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man jukuloka m’i ng’om giywak man can unegogi i kume, kum ng’atu moko mbe m’ung’iewo jambkuloka migi kendo; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.11",
            "verseOrgIds": [
              "REV.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.27.12"
              },
              "items": [
                {
                  "text": "Eze 27:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.27.13"
              },
              "items": [
                {
                  "text": "13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.27.22"
              },
              "items": [
                {
                  "text": "22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "jambkuloka mi mola ma kwar, ku mi mola ma tar, man kidi ma pire tek, man kidi ma i upal, ku bongu ma nwang’ ma nwe nwe, man uluga, man bongu mir ukoko, man kwar ngbo; ku yen ceke ma ng’wice ng’ar, man agulu ceke kubang’gi mi lakliec, man agulu ceke kubang’gi ma jutimo ku yen ma pire tek, man mi mola, ku nyunyu man kidi ma tar de; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.12",
            "verseOrgIds": [
              "REV.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "kud apoka yen ma lim lim, ku gin ma jwa jwa, kud udok ma ng’wice ng’ar ma juwang’u, ku mo mir awira, ku mo ma ng’wice ng’ar, ku pigulok, man mo ma acama, ku mogo ma yom, ku nganu, ku dhiang’, man rombe; man ku kuloka mi riuni ku magali ma tiende ario ku dhanu ma ang’iewa; ku kwo mi dhanu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.13",
            "verseOrgIds": [
              "REV.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man nying’ ma pidoic peri yenyo dit gipiei iri, man gin ceke ma naka gi jambruko ku jambayunga de girwinyo iri, e jubinwang’ugi kendo ki ngo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.14",
            "verseOrgIds": [
              "REV.18.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.27.31"
              },
              "items": [
                {
                  "text": "Eze 27:31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.27.36"
              },
              "items": [
                {
                  "text": "36",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Jukuloka mi ginduni, ma gilony ni kume, gibicungo ku bor ni lworo mi ndiba pare, ma giywak can de negogi; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.15",
            "verseOrgIds": [
              "REV.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ma giwacu ko kumae, Can, can, adhura ma dwong’, en m’eronjre ku bongu ma nwang’ ma nwe nwe kud uluga man kwar ngbo, man m’erukre ku mola ma kwar ku kidi ma pire tek ku kidi ma i upal! ",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.16",
            "verseOrgIds": [
              "REV.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "REV 18:17"
          },
          "items": [
