              "items": [
                {
                  "text": "Yer 50:39",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man ekok ku dwande ma tek, ewacu kumae, Babeli ma dit, upodho, upodho, man edoko ni kabedo mi pajogi, man kol mi tipo m’ucido kubang’gi nzu, man kol mi winyo m’ucido ma judagu kubang’gi nzu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.2",
            "verseOrgIds": [
              "REV.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
