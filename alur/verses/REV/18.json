        {
          "text": "Yo ng’ei gin maeni malaika mange ai i polo loro piny, m’e won ng’ol ma dit; man ng’om ucare ku der mi dwong’ pare. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.1",
            "verseOrgIds": [
              "REV.18.1"
            ]
