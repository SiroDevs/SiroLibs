                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.2.1"
              },
              "items": [
                {
                  "text": "Zek 2:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.2.2"
              },
              "items": [
                {
                  "text": "2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man jumio ira undodi ma va uluth: man acel uwacu kumae, Ai, ipor hekalu pa Mungu, ku pemblam, ku ju m’urwo i ie. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.1",
            "verseOrgIds": [
              "REV.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.21.24"
              },
              "items": [
                {
                  "text": "Lk 21:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man ponde ma yo woko kum hekalu weke woko, kud ipore; kum jumie ni thek: man gibinyono adhura ma leng’ dwi pier ang’wen wi ario. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.2",
            "verseOrgIds": [
              "REV.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man abimio ni jumulembe para ario, man gibiewo ceng’ rubanga acel ku dak ario ku pier abusiel, ma gikendo gonia. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.3",
            "verseOrgIds": [
              "REV.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.4.3"
              },
              "items": [
                {
                  "text": "Zek 4:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.4.11+ZEC.4.12+ZEC.4.13+ZEC.4.14"
              },
              "items": [
                {
                  "text": "11-14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Maeni gi yen mir ulemo ario ku thethala ario, m’ucungo wang’ Rwoth mi ng’om. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.4",
            "verseOrgIds": [
              "REV.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man tek ng’atu moko yenyo etimgi rac, mac ai kud i dhoggi man ecamu jukwojgi; man tek ng’atu moko biyenyo etimgi rac, ebikonegre kumeno be. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.5",
            "verseOrgIds": [
              "REV.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.17.1"
              },
              "items": [
                {
                  "text": "1 Ub 17:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.7.17+EXO.7.18+EXO.7.19"
              },
              "items": [
                {
                  "text": "Ai 7:17-19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.4.8"
              },
              "items": [
                {
                  "text": "1 Sam 4:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Joni gi weg tego ma giciko ko polo, kara koth kud ucwi cil i ceng’ mi lembila migi: man gi weg tego wi pi ma giloko kogi ni rimo, ma gigoyo ko ng’om de ku masendi kubang’gi nzu, ku ba nindo ceke ma giyenyo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.6",
            "verseOrgIds": [
              "REV.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.7"
              },
              "items": [
                {
                  "text": "Dan 7:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.13.5+REV.13.6+REV.13.7"
              },
              "items": [
                {
                  "text": "Nyu 13:5-7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.17.8"
              },
              "items": [
                {
                  "text": "17:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.21"
              },
              "items": [
                {
                  "text": "Dan 7:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man ka gibidaru lembatuca migi, yedi m’uai i longro ma there mbe ebitimo lwiny kugi, ebiloyogi de, man ebinegogi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.7",
            "verseOrgIds": [
              "REV.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.1.9"
              },
              "items": [
                {
                  "text": "Isa 1:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.1.10"
              },
              "items": [
                {
                  "text": "10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man avujgi vuto i gengi mir adhura ma dit, ma julwong’o Sodom ma ku tipo, man Misiri, ka ma juguro ie Rwoth migi bende. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.8",
            "verseOrgIds": [
              "REV.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man dhanu m’uai i kind kodhidhanu kud i suru ku dhok man thek gineno avujgi ceng’ adek ku ng’ete, man giyio ngo nia juyik avujgi i o dliel. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.9",
            "verseOrgIds": [
              "REV.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man ju m’ubedo wi ng’om anyong’a negogi i kumgi, man giketho mutoro; man gibioro giramia man ni wadi man ni wadi; kum jubila ario maeni gimio ndiba ni ju m’ubedo wi ng’om. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.10",
            "verseOrgIds": [
              "REV.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.37.10"
              },
              "items": [
                {
                  "text": "Eze 37:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man yo ng’ei ceng’ adek ku ng’ete e lietho mi kwo m’uai ba Mungu mondo i igi, man gicungo wi tiendgi; e lworo ma dit upodho wi ju m’unenogi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.11",
            "verseOrgIds": [
              "REV.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.2.11"
              },
              "items": [
                {
                  "text": "2 Ub 2:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man giwinjo dwal ma dit m’uai i polo m’uwacu igi kumae, Wuidh kue. Man giidho i polo ku i afuru; man jukwojgi ginenogi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.12",
            "verseOrgIds": [
              "REV.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.6.12"
              },
              "items": [
                {
                  "text": "Nyu 6:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.16.18"
              },
              "items": [
                {
                  "text": "16:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man i saa maeno digidi ma dit uyengre, man theng adhura mir apaje podho; man dhanu rubanga abiro tho ku digidine: e dong’ dhanu m’udong’ lworo makugi, man gimio dwong’ ni Mungu mi polo.",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.13",
            "verseOrgIds": [
              "REV.11.13"
            ]
          }
        }
      ]
    },
