              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Can mir arionde kadhu: nen, can mir adege bino pio.",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.14",
            "verseOrgIds": [
              "REV.11.14"
            ]
