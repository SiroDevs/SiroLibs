              },
              "items": [
                {
                  "text": "27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man malaika mir abirone kudho agwara; m’ulubo maeno dwal ma dit i polo, man giwacu kumae,",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.15",
