              "items": [
                {
                  "text": "Lk 12:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ng’atu m’uloyo bironyo kendi ma tar kumeni; man abiruco nyinge woko kud i kitabu mi kwo ki ngo, man abituco nyinge i wang’ Vwa, kud i wang’ malaika pare. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.5",
            "verseOrgIds": [
              "REV.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng’atu ma ithe nuti, dong’ ewinj gin ma Tipo wacu ni kanisa.",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.6",
            "verseOrgIds": [
              "REV.3.6"
            ]
          }
        }
      ]
    },
