          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nen, acungo dhugola man adwong’o: tek ng’atu moko winjo dwanda man eyabu dhugola, abimondo i bang’e, man wabicamu wakude, en de kuda. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.20",
            "verseOrgIds": [
              "REV.3.20"
            ]
          }
        },
