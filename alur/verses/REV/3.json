          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng’atu m’uloyo, abimie ejany kuda i komker para, calu an bende aloyo, man ajany waku Vwa i komker pare. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.21",
            "verseOrgIds": [
