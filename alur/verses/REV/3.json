                {
                  "text": "Yob 12:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man ni malaika mi kanisa ma i Filadelfia kieu kumae:",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.7",
            "verseOrgIds": [
              "REV.3.7"
            ]
          }
        }
