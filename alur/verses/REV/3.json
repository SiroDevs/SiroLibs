                }
              ]
            }
          ]
        },
        {
          "text": "Ku ba ju m’amaru ceke, ajukogi man aponjogi: ka kumeno bed k’amora, man ilok cwinyi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.19",
