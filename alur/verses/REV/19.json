              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man aneno malaika acel m’ucungo i ceng’; man ekok ku dwande ma dit, m’ewacu ni winyo ceke m’uringo kor polo kumae, Wubin wucokru karacelo ni cemo ma dwong’ mir uthieno pa Mungu; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.17",
            "verseOrgIds": [
              "REV.19.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "REV 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "kara wucam ring ju ma gin ubimo, man ring ju ma gi jego, man ring dhanu ma dongo, man ring riuni ku mi ju m’ubedo i wigi, ku ring dhanu ceke, paker ku jumiru bende, ju ma thindho ku ju ma dongo de.",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.18",
            "verseOrgIds": [
              "REV.19.18"
            ]
          }
        }
      ]
    },
