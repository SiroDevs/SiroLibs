                  "text": "Isa 11:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man aneno polo yabre; man nen, riuni ma tar, ku ng’atu m’ubedo i wie ma julwong’e Mandha man Andha; man i bedopwe epoko lembe man etimo lwiny. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.11",
            "verseOrgIds": [
              "REV.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.10.6"
              },
              "items": [
                {
                  "text": "Dan 10:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man wang’e calu lebmac, man jamkermiwic dupa ni i wie; man ebedo ku nyinge m’ugore ma ng’atu moko mbe m’ung’eyo ndhu en gire. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.12",
            "verseOrgIds": [
              "REV.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man eronjre ku kendi ma juvong’o rimo i kume; ma nyinge julwong’o Lembe pa Mungu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.13",
            "verseOrgIds": [
              "REV.19.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man njuru asikari m’i polo gilubo ng’eye ku wi riuni ma tar, ma gironjri ku bongru ma nwang’ ma nwe nwe, ma tar ma leng’ de. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.14",
            "verseOrgIds": [
              "REV.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 19:15"
          },
          "items": [
