            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.14.20"
              },
              "items": [
                {
                  "text": "Nyu 14:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man palamularu ma bith uwok kud i dhoge, kara egoi kudo thek: man ebibimogi kud uluth mi nyunyu: man ebinyono pany mi lak kwinyo pa Mungu, ma Jategokpo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.15",
            "verseOrgIds": [
              "REV.19.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man ebedo ku nyinge m’ugore wi kendi pare man wi bambe kumae, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.16",
            "verseOrgIds": [
              "REV.19.16"
            ]
          }
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.16",
            "verseOrgIds": [
              "REV.19.16"
            ]
          }
        }
      ]
    },
