              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man malaika mir arionde kudho agwara, e calu got ma dit ma mac ubewang’u jubolo i nam: man theng nam mir adege doko ni rimo; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.8",
            "verseOrgIds": [
              "REV.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "man theng yedi mir adege m’i nam utho, cil gin ma gi weg kwo; man theng combo mir adege nyothre.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.9",
            "verseOrgIds": [
              "REV.8.9"
            ]
          }
        }
