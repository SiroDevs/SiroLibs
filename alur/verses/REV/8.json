                  "text": "16:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man malaika ting’o tabu mir udok ma ng’wice ng’ar; man epong’e ku mac mi pemblam, man ebole wi ng’om: e m’ulubo maeno morpolo, ku dwal, man lukoth, ku digidi de.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.5",
            "verseOrgIds": [
              "REV.8.5"
            ]
          }
        }
      ]
