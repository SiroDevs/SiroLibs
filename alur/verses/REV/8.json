                  "text": "3:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man malaika mir ang’wende kudho agwara, e jugoyo theng ceng’ mir adege, ku theng dwi mir adege, man theng cero mir adege; kara theng piny mir adege yuthi, man rupiny kud ubed nuti ni theng piny mir adege, man diewor de kumeca. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.12",
            "verseOrgIds": [
              "REV.8.12"
            ]
          }
        },
