            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man malaika mir adege kudho agwara, e cero ma dit uai kud i polo podho, m’ubewang’ va ridhro, man epodho wi theng kulo mir adege, man wi pi ma dhenyni; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.10",
            "verseOrgIds": [
              "REV.8.10"
            ]
          }
        },
