                  "text": "Yer 9:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "man nying’ cerone julwong’o Yendadra: man theng pi mir adege doko ni yendadra; man dhanu dupa tho ku pige, kum judwokogi kec.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.11",
