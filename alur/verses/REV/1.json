          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "man ng’atu ma Kwo; an ma nwang’u atho, man nen, abedo kwo mi rondo ku rondo, man abedo ku kifungula mi tho man mi Hadeya. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.18",
            "verseOrgIds": [
              "REV.1.18"
            ]
          }
        },
        {
