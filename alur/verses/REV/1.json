              "items": [
                {
                  "text": "Zab 89:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "m’uai de ba Yesu Kristu, ma en e jamulembe mandha, m’e kayu mi ju m’utho, man jabim mir ubimo m’i ng’om. Ire m’emaruwa, m’egonyowa kud i dubo mwa ku rimbe; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.5",
            "verseOrgIds": [
              "REV.1.5"
            ]
          }
        },
