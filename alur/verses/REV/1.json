          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man cero abiro ni i cinge ma yor acwic: man palamularu ma lake bith kun ku kun uwok kud i dhoge: wang’e de va ceng’ m’urieny i tego pare. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.16",
            "verseOrgIds": [
              "REV.1.16"
            ]
          }
        },
