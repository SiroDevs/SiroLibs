          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lembanyutha pa Yesu Kristu, ma Mungu mio ire enyuth ni jumiru pare, cil gin ma fodi nyanok bikotimbre be: man eoro enyuthe ku malaika pare ni jatic pare Yohana; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.1",
            "verseOrgIds": [
              "REV.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "m’enyutho pi lembe pa Mungu, man pi lembatuca pa Yesu Kristu, cil gin ceke m’eneno. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.2",
            "verseOrgIds": [
              "REV.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mugisa ni ng’atu m’usomo, man ni ju m’uwinjo lembila maeni man ni ju m’uworo gin m’ugore i ie de: kum nindone dhingo ceng’ni.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.3",
            "verseOrgIds": [
              "REV.1.3"
            ]
          }
        }
      ]
    },
