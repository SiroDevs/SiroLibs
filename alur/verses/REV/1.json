        },
        {
          "text": "Yohana ni kanisa abiro ma tic i Asia: Bero iwu man kwiocwiny, m’uai ba ng’atu ma tic ma yang’ de etie m’ebibino de: m’uai de ba Tipo abiro ma gini nyim komker pare; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.4",
            "verseOrgIds": [
              "REV.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 1:5"
          },
          "items": [
