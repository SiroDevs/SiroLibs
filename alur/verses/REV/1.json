                  "text": "43:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "tiende de calu mola m’urieny, calu ma tek juwang’u i uka; dwande de calu ba pi dupa. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.15",
            "verseOrgIds": [
              "REV.1.15"
            ]
          }
        },
        {
