                {
                  "text": "Nyu 5:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "man eketho wabed ni ker, julam ni Mungu pare man Won; dwong’ ku kero bed ire rondo ku rondo. Amen. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.6",
            "verseOrgIds": [
              "REV.1.6"
            ]
