                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.10"
              },
              "items": [
                {
                  "text": "10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man aneno komker ma tar m’ulwar, ku ng’atu m’ujany i wie de, man ng’om ku polo de giringo wang’e; man kakagi nwangre ngo igi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.11",
            "verseOrgIds": [
              "REV.20.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man aneno ju m’utho, ju ma dongo ku ju ma thindho, ma gicungo wang’ komker; e juyabu kitabu: man juyabu kitabu mange de, ma en e kitabu mi kwo: man jupoko lembe mi ju m’utho ku gin m’ugore i kitabune, calku tic migi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.12",
            "verseOrgIds": [
              "REV.20.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man nam uwodho ju m’utho ma ni i ie: man tho ku Hadeya de giwodho ju m’utho ma ni i igi: man jupoko lembe migi kubang’gi kubang’gi ng’atuman calku tic pare. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.13",
            "verseOrgIds": [
              "REV.20.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man tho ku Hadeya de jubayugi i nammac. Maeni en e tho mir arionde, ma en e nammac. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.14",
            "verseOrgIds": [
              "REV.20.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man tek ng’atu moko junwang’u nyinge kugore i kitabu mi kwo ngo, jubaye i nammac.",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.15",
            "verseOrgIds": [
              "REV.20.15"
            ]
          }
        }
      ]
    }
