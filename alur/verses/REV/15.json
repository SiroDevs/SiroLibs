              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man aneno giranyutha mange i polo, ma dit ku ma wang’u ijo, malaika abiro ma weg masendi abiro, m’udong’ cen, kum i igi kwinyo pa Mungu thum.",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.1",
            "verseOrgIds": [
              "REV.15.1"
            ]
          }
        }
      ]
    },
    {
