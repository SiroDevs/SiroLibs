                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "E yo ng’ei gin maeni aneno, man hekalu mi hema mi lebatuca mi polo yabre: ",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.5",
            "verseOrgIds": [
              "REV.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "e malaika abiro ma gibedo ku masendi abiro giwok kud i hekalu, ma gironyo kidi ma pire tek, ma leng’ m’uriang’ni de, ma korgi bedo atwia ku foto mi mola ma kwar. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.6",
            "verseOrgIds": [
              "REV.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man ng’atu acel ma kind yedi ang’wen ma kwo umio ni malaika abiro tabu abiro mi mola ma kwar ma kwinyo pa Mungu pong’ i igi, en m’e kwo rondo ku rondo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.7",
            "verseOrgIds": [
              "REV.15.7"
            ]
          }
        },
        {
